<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CCL.MES.Scripts.VerifyPrB</RootNamespace>
    <AssemblyName>VerifyPrB</AssemblyName>
    <!--
      Phase 8 PR-B verification harness. Exercises the 3 SpecPdfDocumentBuilder
      template paths (SILK / FLEXO / GENERIC) end-to-end against synthetic
      SpecDetailDto inputs. No DB / auth / Razor circuit needed; proves the
      PDF branch dispatch and helper composition are wired correctly and
      writes sample artifacts to /tmp/ for visual sanity. Engineer-use tool
      (run via dotnet run); NOT a CI test runner.
      Excluded from sln so accidental build at repo root does not bloat the
      standard build graph.
    -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CCL.MES.Domain\CCL.MES.Domain.csproj" />
    <ProjectReference Include="..\..\src\CCL.MES.Application\CCL.MES.Application.csproj" />
    <ProjectReference Include="..\..\src\CCL.MES.Infrastructure\CCL.MES.Infrastructure.csproj" />
  </ItemGroup>
</Project>
