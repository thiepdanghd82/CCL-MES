@page "/settings/audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.Globalization
@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.Files
@using CCL.MES.Shared.Audit
@inject ICclApiClient Api
@inject IFileSaver Saver
@inject IFileOpener Opener
@inject IJSRuntime Js

@*
  P10.6e — Admin Audit Log viewer + CSV / XLSX export.

  Admin-only at BOTH layers:
    - Page [Authorize(Roles = "Admin")] — non-admin gets the standard
      forbidden render.
    - Every API endpoint sits behind the AdminOnly policy. Server is
      defence-in-depth; both anon-401 and Engineer-403 are covered
      by RouteDiscoveryCanaryTests + AuditLogControllerTests.

  Catalyst safety: ONLY plain <input type="text" / "date" />, plain
  <select> + @bind, plain @onclick. NO <InputText>, NO <InputFile>.
  Same rule as Login / SettingsAppearance / SettingsBackup.

  Export flow mirrors P10.5g Spec exports:
    1. Stream the file from server to the sandbox download dir.
    2. Hand the sandbox path to IFileSaver → native Save dialog
       (Catalyst forExporting:).
    3. On Saved → success banner shows where the file landed; on
       Cancelled → banner reads "Đã lưu vào sandbox" with the path.
    4. Export itself emits AUDIT_EXPORT server-side — visible in the
       same list on next reload.
*@

<PageTitle>Audit Log — CCL MES</PageTitle>

<div class="settings-page-header">
    <a class="grid-btn grid-btn-link" href="/settings">‹ Settings</a>
    <h1 class="page-title">Audit Log</h1>
</div>

<section class="settings-form-card is-wide">
    <h2 class="settings-group-title">Filters</h2>
    <div class="audit-filter-grid">
        <div class="audit-filter-field">
            <label for="al-search">Search</label>
            <input id="al-search" type="text" class="modal-input"
                   placeholder="Search across all columns…"
                   @bind="_search" @bind:event="oninput" />
        </div>
        <div class="audit-filter-field">
            <label for="al-action">Action</label>
            <select id="al-action" class="modal-input" @bind="_action">
                <option value="">— All —</option>
                @foreach (var a in _actions)
                {
                    <option value="@a">@a</option>
                }
            </select>
        </div>
        <div class="audit-filter-field">
            <label for="al-actor">User</label>
            <input id="al-actor" type="text" class="modal-input"
                   placeholder="admin, supervisor, …"
                   @bind="_actor" @bind:event="oninput" />
        </div>
        <div class="audit-filter-field">
            <label for="al-from">From date (UTC)</label>
            <input id="al-from" type="date" class="modal-input"
                   @bind="_fromDate" />
        </div>
        <div class="audit-filter-field">
            <label for="al-to">To date (UTC)</label>
            <input id="al-to" type="date" class="modal-input"
                   @bind="_toDate" />
        </div>
    </div>
    <div class="audit-filter-actions">
        <button type="button" class="grid-btn grid-btn-primary"
                disabled="@_loading" @onclick="OnApply">
            @(_loading ? "Loading…" : "Apply + Reload")
        </button>
        <button type="button" class="grid-btn" @onclick="OnReset">Reset</button>
        <span class="audit-export-spacer"></span>
        <button type="button" class="grid-btn"
                disabled="@_exporting" @onclick="@(() => OnExport("csv"))">
            @(_exporting ? "Exporting…" : "Export CSV")
        </button>
        <button type="button" class="grid-btn"
                disabled="@_exporting" @onclick="@(() => OnExport("xlsx"))">
            @(_exporting ? "Exporting…" : "Export XLSX")
        </button>
    </div>
    @if (_filterError is not null)
    {
        <div class="settings-form-error">@_filterError</div>
    }
    @if (_exportInfo is not null)
    {
        <div class="settings-form-success">@_exportInfo</div>
    }
</section>

<section class="settings-form-card is-wide" style="margin-top:16px">
    <div class="audit-result-head">
        <h2 class="settings-group-title">
            Results (@_result.Total total — page @_result.Page / @TotalPages, @_result.Items.Count rows)
        </h2>
        <div class="audit-paging">
            <button type="button" class="grid-btn" disabled="@(_loading || _result.Page <= 1)"
                    @onclick="@(() => GoPage(_result.Page - 1))">‹ Previous</button>
            <span class="audit-paging-pos">Page @_result.Page</span>
            <button type="button" class="grid-btn"
                    disabled="@(_loading || _result.Page >= TotalPages)"
                    @onclick="@(() => GoPage(_result.Page + 1))">Next ›</button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="settings-form-help">Loading…</p>
    }
    else if (_result.Items.Count == 0)
    {
        <p class="settings-form-help">
            No rows match the filter. Try widening the date range or clearing the user filter.
        </p>
    }
    else
    {
        <div class="audit-table-wrap">
            <table class="audit-table">
                <colgroup>
                    <col class="audit-col-utc"     />
                    <col class="audit-col-actor"   />
                    <col class="audit-col-role"    />
                    <col class="audit-col-action"  />
                    <col class="audit-col-target"  />
                    <col class="audit-col-id"      />
                    <col class="audit-col-ip"      />
                    <col class="audit-col-source"  />
                    <col class="audit-col-detail"  />
                </colgroup>
                <thead>
                    <tr>
                        <th>UTC</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Target</th>
                        <th>ID</th>
                        <th>IP</th>
                        <th>Source</th>
                        <th>Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in _result.Items)
                    {
                        var isExpanded = _expanded.Contains(e.Id);
                        <tr>
                            <td class="audit-mono" title="@e.TimestampUtc.ToString("o", CultureInfo.InvariantCulture)">@e.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td>
                            <td title="@e.ActorUsername">@e.ActorUsername</td>
                            <td>@e.ActorRole</td>
                            <td><span class="audit-action-chip">@e.Action</span></td>
                            <td title="@(e.TargetType ?? "")">@(e.TargetType ?? "—")</td>
                            <td class="audit-mono" title="@(e.TargetId ?? "")">@(string.IsNullOrEmpty(e.TargetId) ? "—" : e.TargetId)</td>
                            <td class="audit-mono" title="@(e.IpAddress ?? "")">@(e.IpAddress ?? "—")</td>
                            <td>@e.Source</td>
                            <td class="audit-detail-cell"
                                title="@(string.IsNullOrEmpty(e.Detail) ? "(empty)" : e.Detail)"
                                @onclick="@(() => ToggleExpand(e.Id))">
                                @if (string.IsNullOrEmpty(e.Detail))
                                {
                                    <span class="audit-detail-empty">—</span>
                                }
                                else
                                {
                                    <span class="audit-detail-trunc">@e.Detail</span>
                                    <span class="audit-expand-toggle">@(isExpanded ? "▼" : "▶")</span>
                                }
                            </td>
                        </tr>
                        @if (isExpanded && !string.IsNullOrEmpty(e.Detail))
                        {
                            var pretty = _prettyCache.TryGetValue(e.Id, out var p) ? p : e.Detail;
                            <tr class="audit-expanded-row">
                                <td colspan="9">
                                    <div class="audit-expanded-head">
                                        <span>Detail (JSON) — event <code>@e.Action</code> #@e.Id</span>
                                        <button type="button" class="audit-copy-btn @(_copiedId == e.Id ? "is-ok" : "")"
                                                @onclick="@(() => CopyDetail(e.Id, e.Detail!))"
                                                @onclick:stopPropagation="true">
                                            @(_copiedId == e.Id ? "✔ Copied" : "Copy")
                                        </button>
                                    </div>
                                    <pre class="audit-expanded-pre">@pretty</pre>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private const int PageSize = 50;

    // Filter state — plain string + nullable DateTime backing fields,
    // no <InputText>. @bind / @bind:event="oninput" only.
    private string? _search;
    private string? _action;
    private string? _actor;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    private List<string> _actions = new();
    private AuditLogPagedResult _result = new();
    private bool _loading = true;
    private bool _exporting;
    private string? _filterError;
    private string? _exportInfo;

    // Per-row UI state. Detail cell stays truncated to 1 line; the
    // operator taps to expand into a JSON-pretty-printed panel below.
    private readonly HashSet<long> _expanded = new();
    private readonly Dictionary<long, string> _prettyCache = new();
    private long _copiedId;   // 0 = none; bumps for ~1.5s after a copy click.

    private int TotalPages =>
        _result.Total <= 0 ? 1 : (int)Math.Ceiling(_result.Total / (double)Math.Max(1, _result.PageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _actions = await Api.GetAuditActionsAsync();
        }
        catch
        {
            // Dropdown is best-effort — empty list still lets the
            // operator filter by search box.
            _actions = new();
        }
        await LoadPage(1);
    }

    private Task OnApply() => LoadPage(1);

    private Task OnReset()
    {
        _search = null;
        _action = null;
        _actor = null;
        _fromDate = null;
        _toDate = null;
        return LoadPage(1);
    }

    private Task GoPage(int page) => LoadPage(page);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _filterError = null;
        _exportInfo = null;
        // Reset per-row expansion state when the row set changes so
        // expanded rows don't bleed across pages with different ids.
        _expanded.Clear();
        _prettyCache.Clear();
        _copiedId = 0;
        try
        {
            _result = await Api.GetAuditLogAsync(
                _search, _action, _actor,
                _fromDate, _toDate,
                page, PageSize);
        }
        catch (ApiException ex)
        {
            _filterError = $"Failed to load: {ex.ApiError.MessageEn} ({ex.ApiError.Code}).";
        }
        catch (Exception ex)
        {
            _filterError = $"Error: {ex.GetType().Name} — {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnExport(string format)
    {
        _exporting = true;
        _exportInfo = null;
        _filterError = null;
        try
        {
            // 1. Stream to sandbox download dir.
            var ts = DateTime.UtcNow.ToString("yyyyMMdd-HHmmss", CultureInfo.InvariantCulture);
            var dir = Opener.GetSafeDownloadDirectory();
            Directory.CreateDirectory(dir);
            var sandboxPath = Path.Combine(dir, $"AuditLog_{ts}.{format}");

            var dl = await Api.ExportAuditLogAsync(
                format, _search, _action, _actor,
                _fromDate, _toDate, sandboxPath);

            // 2. Native Save dialog.
            var outcome = await Saver.SaveAsync(sandboxPath, dl.FileName);
            _exportInfo = outcome.Saved
                ? $"✔ Saved {dl.FileName} ({dl.Bytes:N0} bytes) at {outcome.DestinationPath}."
                : $"✔ Saved {dl.FileName} ({dl.Bytes:N0} bytes) to sandbox: {sandboxPath}.";

            // 3. Reload page 1 so the AUDIT_EXPORT row just emitted
            //    appears at the top.
            await LoadPage(1);
        }
        catch (ApiException ex)
        {
            _filterError = $"Export failed: {ex.ApiError.MessageEn} ({ex.ApiError.Code}).";
        }
        catch (Exception ex)
        {
            _filterError = $"Error: {ex.GetType().Name} — {ex.Message}";
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task ToggleExpand(long id)
    {
        if (_expanded.Contains(id))
        {
            _expanded.Remove(id);
            return;
        }
        _expanded.Add(id);
        // Lazily pretty-print so a 100-row page with all-collapsed
        // detail cells doesn't pay the parse cost up front.
        var row = _result.Items.FirstOrDefault(x => x.Id == id);
        if (row?.Detail is { Length: > 0 } && !_prettyCache.ContainsKey(id))
        {
            try
            {
                var pretty = await Js.InvokeAsync<string>("cclMesClipboard.prettyJson", row.Detail);
                _prettyCache[id] = pretty;
            }
            catch
            {
                _prettyCache[id] = row.Detail;
            }
        }
    }

    private async Task CopyDetail(long id, string text)
    {
        try
        {
            var ok = await Js.InvokeAsync<bool>("cclMesClipboard.copy", text);
            if (ok)
            {
                _copiedId = id;
                StateHasChanged();
                await Task.Delay(1500);
                if (_copiedId == id) _copiedId = 0;
            }
        }
        catch
        {
            // Clipboard denied — silently no-op. The JSON panel is still
            // visible so the operator can select + manual-copy.
        }
    }
}
