    // P10.10 — "Copy new Spec" chooser. Both paths land in the inline editor.
    //  · New        → independent duplicate on a fresh product (blank IFS code).
    //  · Update ver → next revision of THIS spec on the same product.
    private Task NewCopyAsync() => RunCopyAsync(() => Api.DuplicateSpecAsync(_detail!.Id));
    private Task UpdateVerAsync() => RunCopyAsync(() => Api.NewVersionSpecAsync(_detail!.Id));

    private async Task RunCopyAsync(Func<Task<SpecMutationResponse>> action)
    {
        if (_busy || _detail is null) return;
        _busy = true;
        _busyAction = "copy";
        _actionBanner = null;
        _copyChoiceOpen = false;
        try
        {
            var resp = await action();
            Nav.NavigateTo($"/npi/specs/{resp.Id}?action=edit");
        }
        catch (ApiException apiEx)
        {
            _actionBanner = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _actionBannerIsError = true;
        }
        catch (Exception ex)
        {
            _actionBanner = $"{ex.GetType().Name}: {ex.Message}";
            _actionBannerIsError = true;
        }
        finally { _busy = false; }
    }

    private Task OnRevisedAsync(SpecMutationResponse resp)
    {
        Nav.NavigateTo($"/npi/specs/{resp.Id}");
        return Task.CompletedTask;
    }

    private async Task OnSupersededAsync(SpecMutationResponse resp)
