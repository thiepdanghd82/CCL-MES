@page "/npi/specs/{RevisionId:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor,Engineer")]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@inject ICclApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CCL.MES.Hybrid.Client.Files.IFileOpener FileOpener
@inject CCL.MES.Hybrid.Client.Files.IFileSaver FileSaver
@inject CCL.MES.Hybrid.Client.Printing.IPrintService Print
@using CCL.MES.Hybrid.Client.Specs
@using CCL.MES.Hybrid.Client.Files
@using CCL.MES.Hybrid.Razor.Shared

@*
    P10.5b — Spec detail (read-only). 6-tab layout mirroring legacy
    EngineerSpecDetail.razor + SpecHub. Specification tab uses the
    compact SpecShowcardVm (full mode = 5c). Drawings / QC Plans /
    QC Capture / Artwork / Setup all render the available read data
    from existing API endpoints (zero new server endpoints needed for
    5b — gap analysis §2.7 confirmed).

    Per Lesson #27 (carry from P10.5a): every tab's data load wraps
    its own try/catch + inline error banner. A failing drawings fetch
    does NOT crash the Specification tab. Each tab fetches lazily on
    first activation.
*@

<PageTitle>@(_detail?.SpecCode ?? @T("specdetail.title.spec")) — @T("specdetail.title.details")</PageTitle>

<div class="spec-detail-header">
    <button type="button" class="grid-btn grid-btn-link" @onclick="NavigateBack">‹ @T("specdetail.back.list")</button>
    @if (_detail is not null)
    {
        <span class="spec-detail-crumb">@(_detail.SpecCode) · @T("specdetail.crumb.rev") @_detail.RevisionCode</span>

        @* P10.10 — spec action buttons moved inline onto the header row,
           before Print PDF, for a compact toolbar (was a separate card
           below). Mutations gate on NpiSpecWrite (Admin/Engineer); Approve
           only for Draft/InReview; every button disabled while a mutation
           is in-flight via the page-level _busy guard. *@
        @if (_vm is not null)
        {
            <AuthorizeView Roles="Admin,Engineer">
                <div class="spec-detail-actions spec-detail-actions-inline">
                    @if (_detail.Status == SpecRevisionStatus.Draft || _detail.Status == SpecRevisionStatus.InReview)
                    {
                        <button type="button" class="op-btn op-btn-success"
                                disabled="@_busy" @onclick="OnApproveAsync">
                            @(_busy && _busyAction == "approve" ? @T("specdetail.action.approving") : @T("specdetail.action.approve"))
                        </button>
                    }
                    @if (_detail.Status == SpecRevisionStatus.Draft)
                    {
                        <button type="button" class="op-btn op-btn-secondary"
                                disabled="@_busy" @onclick="() => OpenEditAsync()">
                            📝 @T("specdetail.action.edit")
                        </button>
                    }
                    <button type="button" class="op-btn op-btn-secondary"
                            disabled="@_busy" @onclick="@(() => _copyChoiceOpen = true)">
                        ⎘ @T("specdetail.action.copy")
                    </button>
                    @if (_detail.Status == SpecRevisionStatus.Approved || _detail.Status == SpecRevisionStatus.Released)
                    {
                        <button type="button" class="op-btn op-btn-warning"
                                disabled="@_busy" @onclick="() => OpenReviseAsync()">
                            ⟳ @T("specdetail.action.revise")
                        </button>
                        <button type="button" class="op-btn op-btn-danger"
                                disabled="@_busy" @onclick="() => OpenSupersedeAsync()">
                            ⊘ @T("specdetail.action.supersede")
                        </button>
                    }
                    <button type="button" class="op-btn op-btn-secondary"
                            disabled="@_busy" @onclick="() => OpenTrashAsync()">
                        🗑 @T("specdetail.action.trash")
                    </button>
                </div>
            </AuthorizeView>
        }

        @* Print sheet — native WebView print (WYSIWYG) on Mac Catalyst;
           falls back to the server MigraDoc PDF on other hosts. *@
        <button type="button" class="grid-btn grid-btn-secondary spec-print-pdf"
                disabled="@_exporting"
                @onclick="PrintSheetAsync">
            @(_exporting ? @T("specdetail.pdf.generating") : @T("specdetail.pdf.print"))
        </button>
    }
</div>

@* P10.5g — Sheet export banner. Same visual contract as Specs list. *@
@if (!string.IsNullOrEmpty(_exportBanner))
{
    <div class="grid-export-banner @($"is-{_exportBannerKind}")" role="status">
        <span>@_exportBanner</span>
        @if (!string.IsNullOrEmpty(_exportSandboxPath))
        {
            <button type="button" class="grid-btn grid-btn-small"
                    @onclick="OpenSandboxAsync">@T("specdetail.export.openfile")</button>
        }
        <button type="button" class="grid-btn-link" @onclick="ClearExportBanner">@T("common.close")</button>
    </div>
}

@* P10.10 — the action buttons moved into the header row (above); only the
   post-mutation status banner stays here as a standalone line. *@
@if (_detail is not null && _vm is not null && _actionBanner is not null)
{
    <div class="spec-action-banner-row">
        <span class="spec-action-banner @(_actionBannerIsError ? "is-error" : "is-success")"
              role="status">@_actionBanner</span>
    </div>
}

@if (_detailLoading && _detail is null)
{
    <p class="grid-status">@T("specdetail.loading")</p>
}
else if (_detailError is not null)
{
    <div class="grid-error" role="alert">
        <strong>@T("specdetail.load.failed")</strong>
        <div>@_detailError</div>
        <button type="button" class="grid-btn" @onclick="LoadDetailAsync">@T("specdetail.retry")</button>
    </div>
}
else if (_detail is not null && _vm is not null)
{
    <div class="spec-tabs" role="tablist">
        @foreach (var tab in _tabs)
        {
            <button type="button" role="tab"
                    aria-selected="@(IsActiveTab(tab.Key))"
                    class="spec-tab @(IsActiveTab(tab.Key) ? "is-active" : "")"
                    @onclick='() => SetActiveTabAsync(tab.Key)'>
                @T(tab.LabelKey)
            </button>
        }
    </div>

    <div class="spec-tab-panel" role="tabpanel">
        @switch (_activeTab)
        {
            case "spec":
                @* P10.5d — Mode toggle (Compact ↔ Full) + Compare-with-
                   prev toggle when lineage has ≥2 entries (current + parent).
                   The buttons live on the inside of the panel so they don't
                   get confused with the lifecycle action bar at the top. *@
                @* P10.10 — inline edit mode: the Draft spec is edited directly
                   on the showcard via SpecShowcardEdit (replaces the modal). *@
                @if (_specEditMode)
                {
                    <SpecShowcardEdit Detail="_detail"
                                      OnSaved="OnInlineEditSavedAsync"
                                      OnCancel="OnInlineEditCancel" />
                }
                else
                {
                    <div class="spec-showcard-toolbar" role="group" aria-label="@T("specdetail.display.aria")">
                        <button type="button"
                                aria-pressed="@(!_fullMode ? "true" : "false")"
                                class="spec-showcard-mode @(!_fullMode ? "is-active" : "")"
                                @onclick="() => { _fullMode = false; _compareMode = false; StateHasChanged(); }">
                            @T("specdetail.mode.summary")
                        </button>
                        <button type="button"
                                aria-pressed="@(_fullMode ? "true" : "false")"
                                class="spec-showcard-mode @(_fullMode ? "is-active" : "")"
                                @onclick="() => { _fullMode = true; _compareMode = false; StateHasChanged(); }">
                            @T("specdetail.mode.full")
                        </button>
                        @if (_vmFull?.HasParentRev == true)
                        {
                            <button type="button"
                                    aria-pressed="@(_compareMode ? "true" : "false")"
                                    class="spec-showcard-mode spec-showcard-compare @(_compareMode ? "is-active" : "")"
                                    @onclick="OnToggleCompareAsync">
                                @T("specdetail.mode.compare") @(_compareMode ? @T("specdetail.mode.compare.on") : "")
                            </button>
                        }
                    </div>

                    @if (_compareMode)
                    {
                        @if (_diffResult is null && _compareLoading)
                        {
                            <p class="grid-status">@T("specdetail.compare.loading")</p>
                        }
                        else if (_compareError is not null)
                        {
                            <div class="modal-banner modal-banner-error" role="alert">
                                <strong>@T("specdetail.compare.failed")</strong>
                                <div>@_compareError</div>
                                <button type="button" class="grid-btn" @onclick="OnToggleCompareAsync">@T("specdetail.retry")</button>
                            </div>
                        }
                        else
                        {
                            <SpecDiffViewer Result="_diffResult" />
                        }
                    }
                    else if (_fullMode)
                    {
                        <SpecShowcardFull Vm="(_vmFull ?? _vm)" />
                        <SpecDrawingShowcards Previews="_drawingPreviews" />
                    }
                    else
                    {
                        <SpecShowcardCompact Vm="_vm" />
                        <SpecDrawingShowcards Previews="_drawingPreviews" />
                    }
                }
                break;

            case "drawings":
                @RenderDrawingsTab()
                break;

            case "qc-plans":
                @RenderQcPlansTab()
                break;

            case "qc-capture":
                @RenderQcCaptureTab()
                break;

            case "artwork":
                @RenderArtworkTab()
                break;

            case "setup":
                @RenderSetupTab()
                break;
        }
    </div>
}

@* P10.5c-1 mutation modal mounts. Each owns its own _submitting guard
   via the mandated pattern (Q11). *@
<EditSpecModal Open="_editOpen" Spec="_detail"
               OnClose="CloseEditAsync"
               OnUpdated="OnUpdatedAsync" />
<Modal Open="_copyChoiceOpen" OnClose="@(() => { _copyChoiceOpen = false; return Task.CompletedTask; })"
       Size="ModalSize.Sm" Severity="ModalSeverity.Info" ClickOutsideToClose="true">
    <Header>@T("specdetail.copy.header")</Header>
    <Body>
        <p class="copy-choice-lead">@T("specdetail.copy.lead")</p>
        <div class="copy-choice-grid">
            <button type="button" class="copy-choice-card" disabled="@_busy" @onclick="UpdateVerAsync">
                <span class="copy-choice-title">🔁 @T("specdetail.copy.updatever.title")</span>
                <span class="copy-choice-sub">@T("specdetail.copy.updatever.sub")</span>
            </button>
            <button type="button" class="copy-choice-card copy-choice-card-primary" disabled="@_busy" @onclick="NewCopyAsync">
                <span class="copy-choice-title">✚ @T("specdetail.copy.new.title")</span>
                <span class="copy-choice-sub">@T("specdetail.copy.new.sub")</span>
            </button>
        </div>
    </Body>
    <Footer>
        <button type="button" class="op-btn op-btn-secondary" disabled="@_busy"
                @onclick="@(() => _copyChoiceOpen = false)">@T("specdetail.cancel")</button>
    </Footer>
</Modal>
<CopySpecModal Open="_copyOpen" SourceSpec="_detail"
               OnClose="CloseCopyAsync"
               OnCopied="OnCopiedAsync" />
<ReviseSpecModal Open="_reviseOpen" SourceSpec="_detail"
                 OnClose="CloseReviseAsync"
                 OnRevised="OnRevisedAsync" />
<SupersedeSpecModal Open="_supersedeOpen" SourceSpec="_detail"
                    OnClose="CloseSupersedeAsync"
                    OnSuperseded="OnSupersededAsync" />

<SpecConfirmActionModal Open="_trashOpen"
                        Title="@T("specdetail.trash.title", _detail?.SpecCode ?? "")"
                        Message="@T("specdetail.trash.message")"
                        ConfirmLabel="@T("specdetail.action.trash")"
                        PendingLabel="@T("specdetail.trash.pending")"
                        Severity="ModalSeverity.Danger"
                        OnConfirm="OnTrashConfirmAsync"
                        OnClose="() => { _trashOpen = false; StateHasChanged(); return Task.CompletedTask; }" />

@code {
    [Parameter] public long RevisionId { get; set; }
    [SupplyParameterFromQuery] public string? Action { get; set; }

    private SpecDetailItem? _detail;
    private SpecShowcardVm? _vm;
    private SpecShowcardVm? _vmFull;
    private bool _detailLoading;
    private string? _detailError;

    // P10.5d — Specification tab mode toggle. _fullMode swaps the
    // compact peek for the 9-section showcard; _compareMode opens the
    // diff viewer against the parent rev. Mutually exclusive — turning
    // on compare auto-disables full-mode rendering.
    private bool _fullMode;
    private bool _compareMode;
    private bool _compareLoading;
    private string? _compareError;
    private SpecDiffVm.SpecDiffResult? _diffResult;

    private string _activeTab = "spec";

    // Per-tab independent fetch state — Lesson #27 isolation.
    private List<DrawingKindSlot>? _drawings;
    private bool _drawingsLoading;
    private string? _drawingsError;
    private IReadOnlyList<SpecDrawingPreview>? _drawingPreviews;   // P10.10 — showcard image previews

    private static readonly string[] _imageExts = { ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp" };
    private readonly List<string> _previewObjectUrls = new();   // blob: URLs to revoke on reload

    private Dictionary<string, QcWindowItem?>? _qcWindows;
    private bool _qcWindowsLoading;
    private string? _qcWindowsError;

    private List<QcCaptureItem>? _qcCaptures;
    private bool _qcCapturesLoading;
    private string? _qcCapturesError;

    // P10.5f — reason codes are fetched once per tab activation so the
    // capture modal's Scrap-kind dropdown has data without each click
    // hitting the network.
    private List<QcReasonCode>? _qcReasonCodes;

    // P10.5c-1 — mutation modal state. Single _busy flag drives every
    // action button's disabled state so the operator can never have two
    // mutations in flight at once (Q11 _submitting guard mandatory).
    private bool _busy;
    private string? _busyAction;
    private string? _actionBanner;
    private bool _actionBannerIsError;
    private bool _editOpen;
    private bool _specEditMode;   // P10.10 — inline edit on the Specification tab
    private bool _copyChoiceOpen; // P10.10 — "Copy new Spec" Update-ver / New chooser
    private bool _copyOpen;
    private bool _reviseOpen;
    private bool _supersedeOpen;
    private bool _trashOpen;

    // P10.5g — sheet PDF export state. Independent of _busy so an
    // export can fire while the operator is mid-mutation review; the
    // download itself is read-only so no concurrency hazard.
    private bool _exporting;
    private string? _exportBanner;
    private string _exportBannerKind = "info";
    private string? _exportSandboxPath;

    private static readonly (string Key, string LabelKey)[] _tabs = new[]
    {
        ("spec",       "specdetail.tab.spec"),
        ("drawings",   "specdetail.tab.drawings"),
        ("qc-plans",   "specdetail.tab.qcplans"),
        ("qc-capture", "specdetail.tab.qccapture"),
        ("artwork",    "specdetail.tab.artwork"),
        ("setup",      "specdetail.tab.setup"),
    };

    private bool IsActiveTab(string key) => string.Equals(_activeTab, key, StringComparison.OrdinalIgnoreCase);

    private long _loadedRevisionId;

    // Load + apply the queued ?action on first render AND on every navigation to
    // a different spec id. The component instance is REUSED when navigating
    // spec→spec (e.g. after Copy/Revise), so OnInitializedAsync alone would not
    // re-run — which left ?action=edit unapplied and the operator stuck on the
    // read-only sheet (couldn't edit Customer / IFS code / Part No after Copy).
    protected override async Task OnParametersSetAsync()
    {
        if (RevisionId == _loadedRevisionId) return;
        _loadedRevisionId = RevisionId;
        _specEditMode = false;
        _drawingPreviews = null;
        await LoadDetailAsync();
        ApplyQueuedAction();
        await BuildDrawingPreviewsAsync();
    }

    // P10.10 — fetch image-drawing thumbnails (current version of each slot)
    // for the spec showcard. Best-effort: failures/large/non-image files just
    // render as labeled tiles. Names follow IFS_PartNo.
    private async Task BuildDrawingPreviewsAsync()
    {
        if (_detail is null) return;
        try
        {
            await RevokePreviewUrlsAsync();   // free the previous batch
            var slots = _drawings ?? await Api.GetDrawingsByRevisionAsync(RevisionId);
            _drawings ??= slots.ToList();
            var previews = new List<SpecDrawingPreview>();
            foreach (var slot in slots)
            {
                if (slot.CurrentVersionId is null) continue;
                var v = slot.Versions.FirstOrDefault(x => x.Id == slot.CurrentVersionId.Value);
                if (v is null) continue;
                var ext = System.IO.Path.GetExtension(v.FileName).ToLowerInvariant();
                var isImage = _imageExts.Contains(ext);
                var isPdf = ext == ".pdf";
                var name = DrawingPreviewName(_detail.SpecCode, _detail.ProductCode, v.FileName);
                string? objUrl = null;
                // Render images + PDFs inline via a blob: URL (reliable in
                // WKWebView); cap to keep base64 round-trips reasonable.
                if ((isImage || isPdf) && v.FileSize > 0 && v.FileSize <= 12 * 1024 * 1024)
                {
                    try
                    {
                        var bytes = await Api.DownloadDrawingBytesAsync(RevisionId, v.Id);
                        var b64 = Convert.ToBase64String(bytes);
                        objUrl = await JS.InvokeAsync<string>("cclMesDrawings.toObjectUrl", b64, MimeForExt(ext));
                        if (!string.IsNullOrEmpty(objUrl)) _previewObjectUrls.Add(objUrl);
                    }
                    catch { /* preview is best-effort */ }
                }
                previews.Add(new SpecDrawingPreview(DrawingKindLabel(slot.Kind), name, isImage, isPdf, objUrl, DrawingKindGroup(slot.Kind)));
            }
            _drawingPreviews = previews;
            StateHasChanged();
        }
        catch { /* best-effort previews */ }
    }

    private async Task RevokePreviewUrlsAsync()
    {
        if (_previewObjectUrls.Count == 0) return;
        foreach (var u in _previewObjectUrls)
        {
            try { await JS.InvokeVoidAsync("cclMesDrawings.revoke", u); } catch { /* noop */ }
        }
        _previewObjectUrls.Clear();
    }

    private static string DrawingPreviewName(string? ifs, string? part, string original)
    {
        var ext = System.IO.Path.GetExtension(original);
        var i = (ifs ?? "").Trim(); var p = (part ?? "").Trim();
        var b = i.Length > 0 && p.Length > 0 ? $"{i}_{p}"
              : p.Length > 0 ? p : i.Length > 0 ? i : System.IO.Path.GetFileNameWithoutExtension(original);
        var bad = System.IO.Path.GetInvalidFileNameChars();
        var clean = new string(b.Select(c => bad.Contains(c) || c == ' ' ? '_' : c).ToArray());
        return (string.IsNullOrWhiteSpace(clean) ? "drawing" : clean) + ext;
    }

    private static string MimeForExt(string ext) => ext.ToLowerInvariant() switch
    {
        ".png" => "image/png",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        ".bmp" => "image/bmp",
        ".pdf" => "application/pdf",
        _ => "application/octet-stream",
    };

    private string DrawingKindLabel(DrawingKindCode kind) => kind switch
    {
        DrawingKindCode.CustomerDrawing    => T("specdetail.drawingkind.customerdrawing"),
        DrawingKindCode.NpiPrintLayout     => T("specdetail.drawingkind.npiprintlayout"),
        DrawingKindCode.NpiCutLayout       => T("specdetail.drawingkind.npicutlayout"),
        DrawingKindCode.IpqcPrintReference => T("specdetail.drawingkind.ipqcprintref"),
        DrawingKindCode.IpqcCutReference   => T("specdetail.drawingkind.ipqccutref"),
        DrawingKindCode.FqcChecksheet      => T("specdetail.drawingkind.fqcchecksheet"),
        DrawingKindCode.OqcChecksheet      => T("specdetail.drawingkind.oqcchecksheet"),
        DrawingKindCode.CustomerApproval   => T("specdetail.drawingkind.customerapproval"),
        DrawingKindCode.InternalProof      => T("specdetail.drawingkind.internalproof"),
        _                                  => kind.ToString(),
    };

    /// <summary>Bucket each drawing kind into one of the three collapsible
    /// showcards below the spec sheet. Print/Cut references go with their
    /// layout; everything customer-facing falls back to the Customer card.</summary>
    private static SpecDrawingGroup DrawingKindGroup(DrawingKindCode kind) => kind switch
    {
        DrawingKindCode.NpiPrintLayout     => SpecDrawingGroup.Print,
        DrawingKindCode.IpqcPrintReference => SpecDrawingGroup.Print,
        DrawingKindCode.NpiCutLayout       => SpecDrawingGroup.Cut,
        DrawingKindCode.IpqcCutReference   => SpecDrawingGroup.Cut,
        _                                  => SpecDrawingGroup.Customer,
    };

    /// <summary>If the list page routed here with <c>?action=…</c>, pre-open
    /// the matching mutation modal. Called after LoadDetailAsync so the
    /// modal has the full <see cref="SpecDetailItem"/> available.</summary>
    private void ApplyQueuedAction()
    {
        if (_detail is null || string.IsNullOrWhiteSpace(Action)) return;
        switch (Action.ToLowerInvariant())
        {
            // P10.10 — inline edit on the Spec tab for Draft (modal fallback
            // for any non-Draft route, though Edit only surfaces for Draft).
            case "edit":
                if (_detail.Status == SpecRevisionStatus.Draft)
                { _activeTab = "spec"; _specEditMode = true; }
                else { _editOpen = true; }
                break;
            // P10.10 — right-click "Copy" in the list opens the same
            // "Copy new Spec" chooser (Update ver / New) as the detail Copy
            // button. The legacy CopySpecModal stays on ?action=copy-to.
            case "copy":      _copyChoiceOpen = true; break;
            case "copy-to":   _copyOpen = true; break;
            case "revise":    _reviseOpen = true; break;
            case "supersede": _supersedeOpen = true; break;
        }
    }

    private async Task LoadDetailAsync()
    {
        _detailLoading = true;
        _detailError = null;
        try
        {
            _detail = await Api.GetSpecDetailAsync(RevisionId);
            if (_detail is null)
            {
                _detailError = T("specdetail.error.notfound");
            }
            else
            {
                _vm = SpecShowcardVm.FromDetail(_detail);
                _vmFull = SpecShowcardVm.FromDetailFull(_detail);
            }
        }
        catch (ApiException apiEx)
        {
            _detailError = apiEx.ApiError.MessageEn;
        }
        catch (HttpRequestException ex)
        {
            _detailError = T("specdetail.error.connect", ex.Message);
        }
        catch (Exception ex)
        {
            _detailError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _detailLoading = false;
        }
    }

    /// <summary>
    /// P10.5d — Compare-with-prev toggle. When activated for the first
    /// time we fetch the parent rev (next entry in Lineage after the
    /// current rev) and run <see cref="SpecDiffVm.Compare"/>. Subsequent
    /// toggles flip the panel without re-fetching. Parent fetch is
    /// online-only — no cache or outbox per Q4.
    /// </summary>
    private async Task OnToggleCompareAsync()
    {
        if (_vmFull is null || !_vmFull.HasParentRev)
            return;

        if (_compareMode)
        {
            // Turn off — keep cached diff so re-enabling is instant.
            _compareMode = false;
            StateHasChanged();
            return;
        }

        _compareMode = true;
        _fullMode = false;  // diff implies full content; show diff only
        _compareError = null;
        if (_diffResult is not null)
        {
            // Cached from a prior toggle in this session.
            StateHasChanged();
            return;
        }

        _compareLoading = true;
        StateHasChanged();
        try
        {
            // Lineage[0] is the current rev; Lineage[1] is the parent
            // (walk DESC by ParentRevisionId).
            var parentEntry = _vmFull.Lineage[1];
            var parentDetail = await Api.GetSpecDetailAsync(parentEntry.Id);
            if (parentDetail is null)
            {
                _compareError = T("specdetail.compare.prev.missing", parentEntry.Id);
                _compareMode = false;
                return;
            }
            var parentVm = SpecShowcardVm.FromDetailFull(parentDetail);
            _diffResult = SpecDiffVm.Compare(_vmFull, parentVm);
        }
        catch (ApiException apiEx)
        {
            _compareError = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _compareMode = false;
        }
        catch (HttpRequestException ex)
        {
            _compareError = T("specdetail.error.connect", ex.Message);
            _compareMode = false;
        }
        catch (Exception ex)
        {
            _compareError = $"{ex.GetType().Name}: {ex.Message}";
            _compareMode = false;
        }
        finally
        {
            _compareLoading = false;
            StateHasChanged();
        }
    }

    private async Task SetActiveTabAsync(string key)
    {
        _activeTab = key;
        // Lazy-load per tab on first activation so we don't burn 4 round-trips
        // on a tab the operator may never open.
        switch (key)
        {
            case "drawings" when _drawings is null && _drawingsError is null:
                await LoadDrawingsAsync();
                break;
            case "qc-plans" when _qcWindows is null && _qcWindowsError is null:
                await LoadQcWindowsAsync();
                break;
            case "qc-capture":
                if (_qcWindows is null && _qcWindowsError is null) await LoadQcWindowsAsync();
                if (_qcCaptures is null && _qcCapturesError is null) await LoadQcCapturesAsync();
                break;
        }
    }

    private async Task LoadDrawingsAsync()
    {
        _drawingsLoading = true;
        _drawingsError = null;
        try
        {
            _drawings = await Api.GetDrawingsByRevisionAsync(RevisionId);
        }
        catch (ApiException apiEx) { _drawingsError = apiEx.ApiError.MessageEn; }
        catch (HttpRequestException ex) { _drawingsError = T("specdetail.error.connect", ex.Message); }
        catch (Exception ex) { _drawingsError = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _drawingsLoading = false; }
