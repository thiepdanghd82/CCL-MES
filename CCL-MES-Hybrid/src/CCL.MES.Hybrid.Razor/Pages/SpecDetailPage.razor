        if (_detail is null) return;
        await Api.TrashSpecAsync(_detail.Id);
        Nav.NavigateTo("/npi/specs");
    }

    // ── P10.5g — Per-spec sheet PDF export ───────────────────────────

    /// <summary>Q11 _exporting guard + Q4 try/catch wrap. Sandboxes
    /// the bytes via IFileOpener first, then defers the save dialog to
    /// the operator via IFileSaver. RefNo (or SpecCode fallback) + Rev
    /// shape the on-disk filename.</summary>
    private async Task ExportSheetPdfAsync()
    {
        if (_exporting || _detail is null) return;
        _exporting = true;
        _exportBanner = "Generating PDF…";
        _exportBannerKind = "info";
        _exportSandboxPath = null;
        StateHasChanged();
        try
        {
            var flow = new SpecExportFlow(Api, FileOpener, FileSaver);
            var outcome = await flow.ExportSheetPdfAsync(
                _detail.Id,
                _detail.RefNo ?? _detail.SpecCode,
                _detail.RevisionCode,
                openAfterSave: true);
            RenderExportOutcome(outcome);
        }
        catch (ApiException apiEx)
        {
            _exportBanner = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _exportBannerKind = "danger";
        }
        catch (HttpRequestException ex)
        {
            _exportBanner = $"Could not connect to the server: {ex.Message}";
            _exportBannerKind = "danger";
        }
        catch (Exception ex)
        {
            _exportBanner = $"PDF export failed: {ex.Message}";
            _exportBannerKind = "danger";
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private void RenderExportOutcome(SpecExportFlowOutcome outcome)
    {
        if (outcome.DidSave)
        {
            _exportBanner = outcome.Opened
                ? $"Saved {outcome.SuggestedFileName} ({FormatSize(outcome.DownloadedBytes)}) — opened for viewing."
                : $"Saved {outcome.SuggestedFileName} ({FormatSize(outcome.DownloadedBytes)}) at {outcome.DestinationPath}.";
            _exportBannerKind = "success";
            _exportSandboxPath = null;
        }
        else
        {
            _exportSandboxPath = outcome.SandboxPath;
            _exportBanner = outcome.Opened
                ? "You cancelled the save dialog — the file is still in the app's downloads folder and has been opened for viewing."
                : "You cancelled the save dialog — the file was saved in the app's downloads folder (click Open file to view).";
            _exportBannerKind = "warn";
        }
    }

    // NOTE: written as an if-chain rather than a relational-pattern switch
    // expression. The Razor compiler in SDK 10.0.x parses a switch arm that
    // begins with '<' (e.g. `< 1024 =>`) as the start of an HTML tag, which
    // derails brace counting for the whole @code block (RZ1006). Keeping the
    // comparison `bytes < …` (operand-first) avoids the markup mis-transition.
    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F1} MB";
    }

    private async Task OpenSandboxAsync()
    {
        if (string.IsNullOrWhiteSpace(_exportSandboxPath)) return;
        await FileOpener.TryOpenAsync(_exportSandboxPath);
    }

    private void ClearExportBanner()
    {
        _exportBanner = null;
        _exportSandboxPath = null;
        StateHasChanged();
    }
