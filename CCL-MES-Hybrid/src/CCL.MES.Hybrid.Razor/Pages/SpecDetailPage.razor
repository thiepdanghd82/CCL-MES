    // ── P10.5c-1 mutation handlers ────────────────────────────────

    private async Task OnApproveAsync()
    {
        if (_busy || _detail is null) return;
        _busy = true;
        _busyAction = "approve";
        _actionBanner = null;
        try
        {
            var resp = await Api.ApproveSpecAsync(_detail.Id);
            _actionBanner = $"✓ Đã duyệt — trạng thái mới: {resp.Status}";
            _actionBannerIsError = false;
            await LoadDetailAsync();
        }
        catch (ApiException apiEx)
        {
            _actionBanner = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _actionBannerIsError = true;
        }
        catch (Exception ex)
        {
            _actionBanner = $"{ex.GetType().Name}: {ex.Message}";
            _actionBannerIsError = true;
        }
        finally
        {
            _busy = false;
            _busyAction = null;
        }
    }

    private void OpenEditAsync() { _editOpen = true; StateHasChanged(); }
    private Task CloseEditAsync() { _editOpen = false; StateHasChanged(); return Task.CompletedTask; }

    private void OpenCopyAsync() { _copyOpen = true; StateHasChanged(); }
    private Task CloseCopyAsync() { _copyOpen = false; StateHasChanged(); return Task.CompletedTask; }

    private void OpenReviseAsync() { _reviseOpen = true; StateHasChanged(); }
    private Task CloseReviseAsync() { _reviseOpen = false; StateHasChanged(); return Task.CompletedTask; }

    private void OpenSupersedeAsync() { _supersedeOpen = true; StateHasChanged(); }
    private Task CloseSupersedeAsync() { _supersedeOpen = false; StateHasChanged(); return Task.CompletedTask; }

    private void OpenTrashAsync() { _trashOpen = true; StateHasChanged(); }

    private async Task OnUpdatedAsync(SpecMutationResponse resp)
    {
        _actionBanner = resp.NoChanges == true
            ? "Không có thay đổi để lưu."
            : "✓ Đã lưu thay đổi.";
        _actionBannerIsError = false;
        await LoadDetailAsync();
    }

    private Task OnCopiedAsync(SpecMutationResponse resp)
    {
        // Operator goes to the freshly-created Draft to keep authoring.
        Nav.NavigateTo($"/npi/specs/{resp.Id}");
        return Task.CompletedTask;
    }

    private Task OnRevisedAsync(SpecMutationResponse resp)
    {
        Nav.NavigateTo($"/npi/specs/{resp.Id}");
        return Task.CompletedTask;
    }

    private async Task OnSupersededAsync(SpecMutationResponse resp)
    {
        _actionBanner = $"✓ Đã đánh dấu Thay thế — trạng thái mới: {resp.Status}";
        _actionBannerIsError = false;
        await LoadDetailAsync();
    }

    private async Task OnTrashConfirmAsync()
    {
        if (_detail is null) return;
        await Api.TrashSpecAsync(_detail.Id);
        Nav.NavigateTo("/npi/specs");
    }
}
