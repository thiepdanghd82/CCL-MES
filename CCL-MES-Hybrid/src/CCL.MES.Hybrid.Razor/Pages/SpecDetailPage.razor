    private async Task LoadQcWindowsAsync()
    {
        _qcWindowsLoading = true;
        _qcWindowsError = null;
        try
        {
            _qcWindows = await Api.GetQcWindowsByRevisionAsync(RevisionId);
        }
        catch (ApiException apiEx) { _qcWindowsError = apiEx.ApiError.MessageEn; }
        catch (HttpRequestException ex) { _qcWindowsError = T("specdetail.error.connect", ex.Message); }
        catch (Exception ex) { _qcWindowsError = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _qcWindowsLoading = false; }
    }

    private async Task LoadQcCapturesAsync()
    {
        _qcCapturesLoading = true;
        _qcCapturesError = null;
        try
        {
            _qcCaptures = await Api.GetQcCapturesByRevisionAsync(RevisionId);
            // P10.5f — reason codes ride along on the first capture
            // tab open so the capture modal's Scrap-kind dropdown has
            // data without a second tap. Failure is non-fatal — the
            // modal degrades to an empty list (operator sees an empty
            // dropdown until reload).
            if (_qcReasonCodes is null)
            {
                try { _qcReasonCodes = await Api.GetQcReasonCodesAsync(); }
                catch { _qcReasonCodes = new(); }
            }
        }
        catch (ApiException apiEx) { _qcCapturesError = apiEx.ApiError.MessageEn; }
        catch (HttpRequestException ex) { _qcCapturesError = T("specdetail.error.connect", ex.Message); }
        catch (Exception ex) { _qcCapturesError = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _qcCapturesLoading = false; }
    }

    /// <summary>P10.5f — reload both QC datasets after a capture or
    /// upsert so the latest-pill + version chain reflect the canonical
    /// server state. Q4 source-of-truth pattern.</summary>
    private async Task ReloadQcAsync()
    {
        await LoadQcWindowsAsync();
        await LoadQcCapturesAsync();
    }

