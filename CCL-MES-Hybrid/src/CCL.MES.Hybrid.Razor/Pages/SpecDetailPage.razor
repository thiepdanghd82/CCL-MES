    private async Task OnApproveAsync()
    {
        if (_busy || _detail is null) return;
        _busy = true;
        _busyAction = "approve";
        _actionBanner = null;
        try
        {
            var resp = await Api.ApproveSpecAsync(_detail.Id);
            _actionBanner = $"✓ Approved — new status: {resp.Status}";
            _actionBannerIsError = false;
            await LoadDetailAsync();
        }
        catch (ApiException apiEx)
        {
            _actionBanner = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _actionBannerIsError = true;
        }
        catch (Exception ex)
        {
            _actionBanner = $"{ex.GetType().Name}: {ex.Message}";
            _actionBannerIsError = true;
        }
        finally
        {
            _busy = false;
            _busyAction = null;
        }
    }

