    // ── P11.x — Print sheet (native WebView print → MigraDoc fallback) ──

    /// <summary>
    /// Print the Spec Full sheet. On Mac Catalyst this drives the native
    /// OS print panel over the LIVE DOM (WYSIWYG — the operator picks
    /// A4/A3, orientation, scale, Save-as-PDF), so the print matches the
    /// on-screen sheet exactly. We first switch to Full mode + let it
    /// render so the printed DOM is the full sheet (the @media print CSS
    /// hides all chrome and expands the sheet to the page). On non-Catalyst
    /// hosts (Windows / tests) native print is unavailable → fall back to
    /// the existing server MigraDoc sheet PDF.
    /// </summary>
    private async Task PrintSheetAsync()
    {
        if (_exporting || _detail is null) return;

        // Native path only when the host supports it (Mac Catalyst).
        if (Print.IsNativePrintSupported)
        {
            // Ensure the Full sheet is the rendered surface before printing.
            if (_activeTab != "spec" || _specEditMode || _compareMode || !_fullMode)
            {
                _specEditMode = false;
                _compareMode = false;
                _fullMode = true;
                await SetActiveTabAsync("spec");
                StateHasChanged();
                // Let Blazor flush the Full-mode render before the OS
                // snapshots the DOM for printing.
                await Task.Delay(120);
            }

            var jobName = $"SpecSheet_{_detail.RefNo ?? _detail.SpecCode}_{_detail.RevisionCode}";
            var presented = await Print.PrintCurrentViewAsync(jobName);
            if (presented)
            {
                _exportBanner = T("specdetail.print.native.opened");
                _exportBannerKind = "info";
                _exportSandboxPath = null;
                StateHasChanged();
                return;
            }
            // presented == false → native unavailable at runtime; fall
            // through to the MigraDoc download path.
        }

        await ExportSheetPdfAsync();
    }

    // ── P10.5g — Per-spec sheet PDF export ───────────────────────────

    /// <summary>Q11 _exporting guard + Q4 try/catch wrap. Sandboxes
    /// the bytes via IFileOpener first, then defers the save dialog to
    /// the operator via IFileSaver. RefNo (or SpecCode fallback) + Rev
    /// shape the on-disk filename.</summary>
    private async Task ExportSheetPdfAsync()
    {
        if (_exporting || _detail is null) return;
        _exporting = true;
        _exportBanner = T("specdetail.pdf.generating");
        _exportBannerKind = "info";
        _exportSandboxPath = null;
        StateHasChanged();
        try
        {
            var flow = new SpecExportFlow(Api, FileOpener, FileSaver);
            var outcome = await flow.ExportSheetPdfAsync(
                _detail.Id,
                _detail.RefNo ?? _detail.SpecCode,
                _detail.RevisionCode,
                openAfterSave: true);
            RenderExportOutcome(outcome);
        }
        catch (ApiException apiEx)
        {
            _exportBanner = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _exportBannerKind = "danger";
        }
        catch (HttpRequestException ex)
        {
            _exportBanner = T("specdetail.error.connect", ex.Message);
            _exportBannerKind = "danger";
        }
        catch (Exception ex)
        {
            _exportBanner = T("specdetail.pdf.failed", ex.Message);
            _exportBannerKind = "danger";
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private void RenderExportOutcome(SpecExportFlowOutcome outcome)
    {
        if (outcome.DidSave)
        {
            _exportBanner = outcome.Opened
                ? T("specdetail.export.saved.opened", outcome.SuggestedFileName ?? "", FormatSize(outcome.DownloadedBytes))
                : T("specdetail.export.saved.at", outcome.SuggestedFileName ?? "", FormatSize(outcome.DownloadedBytes), outcome.DestinationPath ?? "");
            _exportBannerKind = "success";
            _exportSandboxPath = null;
        }
        else
        {
            _exportSandboxPath = outcome.SandboxPath;
            _exportBanner = outcome.Opened
                ? T("specdetail.export.cancelled.opened")
                : T("specdetail.export.cancelled.saved");
            _exportBannerKind = "warn";
        }
    }

    // NOTE: written as an if-chain rather than a relational-pattern switch
    // expression. The Razor compiler in SDK 10.0.x parses a switch arm that
    // begins with '<' (e.g. `< 1024 =>`) as the start of an HTML tag, which
    // derails brace counting for the whole @code block (RZ1006). Keeping the
    // comparison `bytes < …` (operand-first) avoids the markup mis-transition.
    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F1} MB";
    }

    private async Task OpenSandboxAsync()
    {
        if (string.IsNullOrWhiteSpace(_exportSandboxPath)) return;
        await FileOpener.TryOpenAsync(_exportSandboxPath);
    }

    private void ClearExportBanner()
    {
        _exportBanner = null;
        _exportSandboxPath = null;
        StateHasChanged();
    }
