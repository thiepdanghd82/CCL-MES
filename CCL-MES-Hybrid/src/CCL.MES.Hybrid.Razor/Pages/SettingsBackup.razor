@page "/settings/backup"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using System.Globalization
@using CCL.MES.Hybrid.Client
@using CCL.MES.Shared.Backup
@inject ICclApiClient Api
@inject IJSRuntime Js

@*
  P10.6h — Admin Backup / Restore page.

  Admin-only at BOTH layers:
    - Page [Authorize(Roles = "Admin")] — non-admin route hit returns
      Blazor's standard forbidden render.
    - Every API endpoint is gated by AdminOnly policy. Server is the
      defence-in-depth — covered by RouteDiscoveryCanaryTests
      "Backup_routes_require_admin_role" so a future PR that drops
      the controller attribute fails CI.

  Catalyst safety: plain <button> + plain <input type="file">. NO
  <InputText>, NO <select> + @bind. Confirm dialog before destructive
  Restore via Js.InvokeAsync<bool>("confirm", ...). Same pattern that
  is canary-tested in BackgroundCrashContainmentTests since P10.6a
  hotfix layer landed.

  Restore is the dangerous surface — operator picks a file, page
  shows a 2-step confirm gate:
    1. Hard confirm modal ("Sẽ ghi đè database hiện tại — chắc chắn?")
    2. Server takes a PRE-RESTORE snapshot before applying so 1-click
       rollback exists via the snapshot list.
*@

<PageTitle>@T("backup.pagetitle")</PageTitle>

<div class="settings-page-header">
    <a class="grid-btn grid-btn-link" href="/settings">@T("common.back.settings")</a>
    <PageHead TitleKey="backup.title" />
</div>

<section class="settings-form-card is-wide">
    <h2 class="settings-group-title">@T("backup.create.title")</h2>
    <p class="settings-form-help">
        @T("backup.create.help")
    </p>
    <button type="button" class="grid-btn grid-btn-primary"
            disabled="@_creating" @onclick="OnCreate">
        @(_creating ? T("backup.create.busy") : T("backup.create.button"))
    </button>
    @if (_createError is not null)
    {
        <div class="settings-form-error">@_createError</div>
    }
    @if (_createOk is not null)
    {
        <div class="settings-form-success">
            @T("backup.create.success.prefix") <code>@_createOk.FileName</code>
            (@FormatBytes(_createOk.SizeBytes)) — @T("backup.create.success.sha")
            <code class="backup-sha">@ShortSha(_createOk.Sha256)</code>
        </div>
    }
</section>

<section class="settings-form-card is-wide" style="margin-top:16px">
    <h2 class="settings-group-title">@T("backup.sched.title")</h2>
    <p class="settings-form-help">
        @T("backup.sched.help")
    </p>

    @if (_schedLoading)
    {
        <p class="settings-form-help">@T("backup.loading")</p>
    }
    else if (_sched is not null)
    {
        <dl class="backup-status-grid">
            <dt>@T("backup.sched.status")</dt>
            <dd>@(_sched.Enabled ? T("backup.sched.status.enabled") : T("backup.sched.status.disabled"))</dd>
            <dt>@T("backup.sched.nextrun")</dt>
            <dd>
                @(_sched.Enabled && _sched.NextRunAtUtc is not null
                    ? _sched.NextRunAtUtc.Value.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)
                    : "—")
            </dd>
            <dt>@T("backup.sched.lastrun")</dt>
            <dd>
                @if (_sched.LastRunAtUtc is null)
                {
                    <span>@T("backup.sched.lastrun.never")</span>
                }
                else
                {
                    <span>
                        @_sched.LastRunAtUtc.Value.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)
                        @(_sched.LastRunOk == true ? " ✔" : " ✗")
                        @if (!string.IsNullOrEmpty(_sched.LastSqliteFile)) { <text> — </text><code>@_sched.LastSqliteFile</code> }
                    </span>
                }
            </dd>
            <dt>@T("backup.sched.blobarchive")</dt>
            <dd>@(_sched.BlobsEnabled ? T("backup.on") : T("backup.off"))</dd>
            <dt>@T("backup.sched.webhook")</dt>
            <dd>@(_sched.WebhookConfigured ? T("backup.on") : T("backup.off"))</dd>
        </dl>

        <div class="backup-sched-form">
            <label class="backup-sched-check">
                <input type="checkbox" @bind="_fEnabled" disabled="@_savingSched" />
                @T("backup.sched.enable")
            </label>
            <label>
                @T("backup.sched.hour")
                <input type="number" min="0" max="23" @bind="_fHour" disabled="@_savingSched" />
            </label>
            <label>
                @T("backup.sched.retention")
                <input type="number" min="1" max="3650" @bind="_fRetention" disabled="@_savingSched" />
            </label>
            <label>
                @T("backup.sched.minkeep")
                <input type="number" min="1" max="1000" @bind="_fMinKeep" disabled="@_savingSched" />
            </label>
        </div>

        <div class="backup-restore-row" style="margin-top:12px">
            <button type="button" class="grid-btn grid-btn-primary"
                    disabled="@(_savingSched || _runningNow)" @onclick="OnSaveSchedule">
                @(_savingSched ? T("backup.sched.save.busy") : T("backup.sched.save"))
            </button>
            <button type="button" class="grid-btn"
                    disabled="@(_savingSched || _runningNow)" @onclick="OnRunNow">
                @(_runningNow ? T("backup.sched.runnow.busy") : T("backup.sched.runnow"))
            </button>
        </div>

        @if (_schedError is not null)
        {
            <div class="settings-form-error">@_schedError</div>
        }
        @if (_schedOk is not null)
        {
            <div class="settings-form-success">@_schedOk</div>
        }
    }
</section>

<section class="settings-form-card is-wide" style="margin-top:16px">
    <h2 class="settings-group-title">@T("backup.restore.title")</h2>
    <p class="settings-form-help">
        @T("backup.restore.help")
    </p>
    <div class="backup-restore-row">
        <input type="file" accept=".db,.bak,application/octet-stream"
               @ref="_fileInput" @onchange="OnFilePicked" disabled="@_restoring" />
        <button type="button" class="grid-btn grid-btn-danger"
                disabled="@(_restoring || _pickedName is null)"
                @onclick="OnRestoreClicked">
            @(_restoring ? T("backup.restore.busy") : T("backup.restore.button"))
        </button>
    </div>
    @if (_pickedName is not null && !_restoring)
    {
        <div class="settings-form-help" style="margin-top:8px">
            @T("backup.restore.selected") <code>@_pickedName</code> (@FormatBytes(_pickedSize))
        </div>
    }
    @if (_restoreError is not null)
    {
        <div class="settings-form-error">@_restoreError</div>
    }
    @if (_restoreOk is not null)
    {
        <div class="settings-form-success">
            @T("backup.restore.success.prefix")
            <code>@_restoreOk.PreRestoreSnapshot</code>. @T("backup.restore.success.suffix")
        </div>
    }
</section>

<section class="settings-form-card is-wide" style="margin-top:16px">
    <h2 class="settings-group-title">@T("backup.list.title", _snapshots.Count)</h2>
    @if (_listError is not null)
    {
        <div class="settings-form-error">@_listError</div>
    }
    else if (_loading)
    {
        <p class="settings-form-help">@T("backup.loading")</p>
    }
    else if (_snapshots.Count == 0)
    {
        <p class="settings-form-help">@T("backup.list.empty")</p>
    }
    else
    {
        <div class="backup-table-wrap">
            <table class="backup-table">
                <colgroup>
                    <col class="backup-col-file" />
                    <col class="backup-col-size" />
                    <col class="backup-col-sha"  />
                    <col class="backup-col-time" />
                    <col class="backup-col-kind" />
                </colgroup>
                <thead>
                    <tr>
                        <th>@T("backup.list.col.filename")</th>
                        <th>@T("backup.list.col.size")</th>
                        <th>@T("backup.list.col.sha")</th>
                        <th>@T("backup.list.col.created")</th>
                        <th>@T("backup.list.col.type")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _snapshots)
                    {
                        <tr>
                            <td><code class="backup-filename" title="@s.FileName">@s.FileName</code></td>
                            <td class="backup-num">@FormatBytes(s.SizeBytes)</td>
                            <td>
                                <div class="backup-sha-cell">
                                    <code class="backup-sha" title="@s.Sha256">@ShortSha(s.Sha256)</code>
                                    @if (!string.IsNullOrEmpty(s.Sha256))
                                    {
                                        <button type="button"
                                                class="audit-copy-btn @(_shaCopiedFor == s.FileName ? "is-ok" : "")"
                                                @onclick="@(() => CopySha(s.FileName, s.Sha256))">
                                            @(_shaCopiedFor == s.FileName ? "✔" : T("backup.list.copy"))
                                        </button>
                                    }
                                </div>
                            </td>
                            <td>@s.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td>
                            <td>
                                @if (s.IsPreRestore)
                                {
                                    <span class="backup-chip backup-chip-pre">@T("backup.chip.prerestore")</span>
                                }
                                else
                                {
                                    <span class="backup-chip">@T("backup.chip.snapshot")</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private bool _creating;
    private bool _restoring;
    private string? _listError;
    private string? _createError;
    private string? _restoreError;
    private BackupSnapshotDto? _createOk;
    private RestoreResultDto? _restoreOk;
    private List<BackupSnapshotDto> _snapshots = new();

    // Restore file pick state. The actual File object lives in
    // window.__cclMesBackupPick (JS side); .NET only holds the
    // metadata for UI rendering + a flag that a pick is staged.
    private ElementReference _fileInput;
    private string? _pickedName;
    private long _pickedSize;

    // P10.6e UI fix — SHA copy feedback. Empty string = no recent
    // copy; matches the source row's FileName for ~1.5s after click.
    private string _shaCopiedFor = "";

    // Scheduled-backup state.
    private bool _schedLoading = true;
    private BackupScheduleStatusDto? _sched;
    private bool _fEnabled;
    private int _fHour = 2;
    private int _fRetention = 30;
    private int _fMinKeep = 10;
    private bool _savingSched;
    private bool _runningNow;
    private string? _schedError;
    private string? _schedOk;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        await LoadSchedule();
    }

    private async Task LoadSchedule()
    {
        _schedLoading = true;
        _schedError = null;
        try
        {
            _sched = await Api.GetBackupScheduleAsync();
            _fEnabled = _sched.Enabled;
            _fHour = _sched.Hour;
            _fRetention = _sched.RetentionDays;
            _fMinKeep = _sched.MinKeep;
        }
        catch (ApiException ex)
        {
            _schedError = $"Failed to load schedule: {ex.ApiError.Code} ({ex.StatusCode}).";
        }
        catch (Exception ex)
        {
            _schedError = $"Error: {ex.GetType().Name} — {ex.Message}";
        }
        finally
        {
            _schedLoading = false;
        }
    }

    private async Task OnSaveSchedule()
    {
        _savingSched = true;
        _schedError = null;
        _schedOk = null;
        try
        {
            _sched = await Api.SetBackupScheduleAsync(new BackupScheduleUpdateRequest
            {
                Enabled = _fEnabled,
                Hour = _fHour,
                RetentionDays = _fRetention,
                MinKeep = _fMinKeep,
            });
            _schedOk = T("backup.sched.save.ok");
        }
        catch (ApiException ex)
        {
            _schedError = $"Could not save: {ex.ApiError.MessageEn} ({ex.ApiError.Code}).";
        }
        catch (Exception ex)
        {
            _schedError = $"Error: {ex.GetType().Name} — {ex.Message}";
        }
        finally
        {
            _savingSched = false;
        }
    }

    private async Task OnRunNow()
    {
        _runningNow = true;
        _schedError = null;
        _schedOk = null;
        try
        {
            var r = await Api.RunBackupNowAsync();
            _schedOk = r.Ok
                ? $"Backup completed: {r.SqliteFile} ({r.SqliteMb:F1} MB), pruned {r.Pruned}."
                : null;
            if (!r.Ok) _schedError = $"Backup failed: {r.Error ?? r.Integrity}";
            await Reload();
            await LoadSchedule();
        }
        catch (ApiException ex)
        {
            _schedError = $"Run failed: {ex.ApiError.MessageEn} ({ex.ApiError.Code}).";
        }
        catch (Exception ex)
        {
            _schedError = $"Error: {ex.GetType().Name} — {ex.Message}";
        }
        finally
        {
            _runningNow = false;
        }
    }

    private async Task Reload()
    {
        _loading = true;
        _listError = null;
        try
        {
            var rows = await Api.ListBackupsAsync();
            _snapshots = rows ?? new();
        }
        catch (ApiException ex)
        {
            _listError = $"Failed to load the list: {ex.ApiError.Code} ({ex.StatusCode}).";
        }
        catch (Exception ex)
        {
            _listError = $"Error: {ex.GetType().Name} — {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnCreate()
    {
        _creating = true;
        _createError = null;
        _createOk = null;
        try
        {
            _createOk = await Api.CreateBackupAsync();
            await Reload();
        }
        catch (ApiException ex)
        {
            _createError = $"Failed to create snapshot: {ex.ApiError.MessageEn} ({ex.ApiError.Code}).";
        }
        catch (Exception ex)
        {
            _createError = $"Error: {ex.GetType().Name} — {ex.Message}";
        }
        finally
        {
            _creating = false;
        }
    }

    /// <summary>
    /// Plain <input type="file"> change handler. Reads the file
    /// metadata (name + size) via a small JS interop helper that
    /// returns the picked File from the element + caches it in
    /// window.__cclMesBackupPick for the upload step. Keeps the Razor
    /// code free of <InputFile> / InputFileChangeEventArgs.
    /// </summary>
    private async Task OnFilePicked()
    {
        _restoreError = null;
        _restoreOk = null;
        try
        {
            var meta = await Js.InvokeAsync<FilePickMeta?>("cclMesBackup.pick", _fileInput);
            if (meta is null || string.IsNullOrEmpty(meta.Name))
            {
                _pickedName = null;
                _pickedSize = 0;
                return;
            }
            _pickedName = meta.Name;
            _pickedSize = meta.Size;
        }
        catch (Exception ex)
        {
            _restoreError = $"Could not read the file: {ex.Message}";
        }
    }

    private async Task OnRestoreClicked()
    {
        if (_pickedName is null) return;

        var confirmed = await Js.InvokeAsync<bool>("confirm",
            T("backup.restore.confirm", _pickedName));
        if (!confirmed) return;

        _restoring = true;
        _restoreError = null;
        _restoreOk = null;
        try
        {
            // Hand the file back via JS interop as a Stream — JSRuntime
            // marshals the File.stream() through a SignalR-style chunk
            // pipe. Avoids loading the entire file into managed memory.
            var streamRef = await Js.InvokeAsync<IJSStreamReference>("cclMesBackup.takeStream");
            await using var s = await streamRef.OpenReadStreamAsync(maxAllowedSize: 512L * 1024 * 1024);
            _restoreOk = await Api.RestoreBackupAsync(s, _pickedName);
            await Reload();
        }
        catch (ApiException ex)
        {
            _restoreError = $"Restore failed: {ex.ApiError.MessageEn} ({ex.ApiError.Code}).";
        }
        catch (Exception ex)
        {
            _restoreError = $"Error: {ex.GetType().Name} — {ex.Message}";
        }
        finally
        {
            _restoring = false;
        }
    }

    private async Task CopySha(string fileName, string sha)
    {
        try
        {
            var ok = await Js.InvokeAsync<bool>("cclMesClipboard.copy", sha);
            if (ok)
            {
                _shaCopiedFor = fileName;
                StateHasChanged();
                await Task.Delay(1500);
                if (_shaCopiedFor == fileName) _shaCopiedFor = "";
            }
        }
        catch { /* swallow — operator can long-press to copy manually */ }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024L * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    private static string ShortSha(string sha) =>
        string.IsNullOrEmpty(sha) ? "—" : sha.Length >= 12 ? sha[..12] + "…" : sha;

    private sealed record FilePickMeta(string Name, long Size);
}
