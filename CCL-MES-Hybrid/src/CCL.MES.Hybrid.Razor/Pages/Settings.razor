@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<CCL.MES.Hybrid.Client.Hardware.HardwareOptions> HwOptions

@*
  P10.6a — Settings landing. Cards link out to the sub-tab pages.
  Profile + Password are the two new ones this PR ships; Hardware +
  Mode link to the existing P10.3 W1 pages (no duplicate UI). The
  remaining sub-tabs (Appearance, Account Control, Audit Log,
  About, Backup) render as disabled-style placeholder cards so the
  operator can see the parity roadmap; they light up as P10.6b-h
  land.

  All cards are visible to any authenticated user. Role-gated cards
  (Hardware via ScanEnabled + Admin/Supervisor/Engineer; Mode via
  Admin/Supervisor) wrap in <AuthorizeView> so the operator only sees
  what they can actually open.
*@

<PageTitle>@T("settings.pagetitle")</PageTitle>

<PageHead TitleKey="settings.title" />
<p class="page-sub">@T("settings.subtitle")</p>

<section class="settings-group">
    <h2 class="settings-group-title">@T("settings.group.account")</h2>
    <div class="settings-cards">
        <a class="settings-card" href="/settings/profile">
            <span class="settings-card-icon"><Icon Name="user" /></span>
            <span class="settings-card-title">@T("settings.profile.title")</span>
            <span class="settings-card-sub">@T("settings.profile.sub")</span>
        </a>
        <a class="settings-card" href="/settings/password">
            <span class="settings-card-icon"><Icon Name="key" /></span>
            <span class="settings-card-title">@T("settings.password.title")</span>
            <span class="settings-card-sub">@T("settings.password.sub")</span>
        </a>
    </div>
</section>

<section class="settings-group">
    <h2 class="settings-group-title">@T("settings.group.station")</h2>
    <div class="settings-cards">
        @* P10.6d — Connection Mode summary, always visible to any
           authenticated role. Read-only view; the actual change
           controls live at /mode (P10.3) and are linked from inside. *@
        <a class="settings-card" href="/settings/connection">
            <span class="settings-card-icon"><Icon Name="plug" /></span>
            <span class="settings-card-title">@T("settings.connection.title")</span>
            <span class="settings-card-sub">@T("settings.connection.sub")</span>
        </a>
        @* P10.6d — About card replaces the prior disabled placeholder. *@
        <a class="settings-card" href="/settings/about">
            <span class="settings-card-icon">ℹ️</span>
            <span class="settings-card-title">@T("settings.about.title")</span>
            <span class="settings-card-sub">@T("settings.about.sub")</span>
        </a>
        @if (HwOptions.Value.ScanEnabled)
        {
            <AuthorizeView Roles="Admin,Supervisor,Engineer">
                <a class="settings-card" href="/hardware">
                    <span class="settings-card-icon"><Icon Name="printer" /></span>
                    <span class="settings-card-title">@T("settings.devices.title")</span>
                    <span class="settings-card-sub">@T("settings.devices.sub")</span>
                </a>
                <AuthorizeView Roles="Admin,Supervisor" Context="modeCtx">
                    <a class="settings-card" href="/mode">
                        <span class="settings-card-icon"><Icon Name="repeat" /></span>
                        <span class="settings-card-title">@T("settings.stationmode.title")</span>
                        <span class="settings-card-sub">@T("settings.stationmode.sub")</span>
                    </a>
                </AuthorizeView>
            </AuthorizeView>
        }
    </div>
</section>

<section class="settings-group">
    <h2 class="settings-group-title">@T("settings.group.appearance")</h2>
    <div class="settings-cards">
        @* P10.6b — Appearance landing card. Language picker today;
           theme switcher ships in P10.6g. *@
        <a class="settings-card" href="/settings/appearance">
            <span class="settings-card-icon"><Icon Name="globe" /></span>
            <span class="settings-card-title">@T("settings.appearance.title")</span>
            <span class="settings-card-sub">@T("settings.appearance.sub")</span>
        </a>
    </div>
</section>

@* P10.6c — wrap the entire "Quản trị viên" section in AuthorizeView
   so the header itself hides for non-admin (Engineer / Supervisor /
   Operator / QC). Previously the cards were each gated but the section
   <h2> rendered unconditionally, leaving non-admin with an empty group
   header. Carry-over from P10.6h landing-card placement + extended in
   P10.6e — bug now closed at the section scope. *@
<AuthorizeView Roles="Admin">
    <Authorized>
        <section class="settings-group">
            <h2 class="settings-group-title">@T("settings.group.administrator")</h2>
            <div class="settings-cards">
                @* P10.6h shipped — Backup & Restore admin landing. *@
                <a class="settings-card" href="/settings/backup">
                    <span class="settings-card-icon"><Icon Name="save" /></span>
                    <span class="settings-card-title">@T("settings.backup.title")</span>
                    <span class="settings-card-sub">@T("settings.backup.sub")</span>
                </a>
                @* P10.6e shipped — Audit Log viewer + CSV/XLSX export. *@
                <a class="settings-card" href="/settings/audit">
                    <span class="settings-card-icon"><Icon Name="log" /></span>
                    <span class="settings-card-title">@T("settings.audit.title")</span>
                    <span class="settings-card-sub">@T("settings.audit.sub")</span>
                </a>
                @* P10.6c shipped — Account Control. *@
                <a class="settings-card" href="/settings/accounts">
                    <span class="settings-card-icon"><Icon Name="users" /></span>
                    <span class="settings-card-title">@T("settings.accounts.title")</span>
                    <span class="settings-card-sub">@T("settings.accounts.sub")</span>
                </a>
            </div>
        </section>
    </Authorized>
</AuthorizeView>
