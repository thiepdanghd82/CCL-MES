@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<CCL.MES.Hybrid.Client.Hardware.HardwareOptions> HwOptions

@*
  P10.6a — Settings landing. Cards link out to the sub-tab pages.
  Profile + Password are the two new ones this PR ships; Hardware +
  Mode link to the existing P10.3 W1 pages (no duplicate UI). The
  remaining sub-tabs (Appearance, Account Control, Audit Log,
  About, Backup) render as disabled-style placeholder cards so the
  operator can see the parity roadmap; they light up as P10.6b-h
  land.

  All cards are visible to any authenticated user. Role-gated cards
  (Hardware via ScanEnabled + Admin/Supervisor/Engineer; Mode via
  Admin/Supervisor) wrap in <AuthorizeView> so the operator only sees
  what they can actually open.
*@

<PageTitle>Cài đặt — CCL MES</PageTitle>

<h1 class="page-title">Cài đặt</h1>
<p class="page-sub">Quản lý hồ sơ, mật khẩu và cấu hình trạm.</p>

<section class="settings-group">
    <h2 class="settings-group-title">Tài khoản</h2>
    <div class="settings-cards">
        <a class="settings-card" href="/settings/profile">
            <span class="settings-card-icon">👤</span>
            <span class="settings-card-title">Hồ sơ của tôi</span>
            <span class="settings-card-sub">Tên hiển thị, vai trò, phòng ban.</span>
        </a>
        <a class="settings-card" href="/settings/password">
            <span class="settings-card-icon">🔑</span>
            <span class="settings-card-title">Đổi mật khẩu</span>
            <span class="settings-card-sub">Đặt mật khẩu mới cho tài khoản hiện tại.</span>
        </a>
    </div>
</section>

<section class="settings-group">
    <h2 class="settings-group-title">Trạm</h2>
    <div class="settings-cards">
        @* P10.6d — Connection Mode summary, always visible to any
           authenticated role. Read-only view; the actual change
           controls live at /mode (P10.3) and are linked from inside. *@
        <a class="settings-card" href="/settings/connection">
            <span class="settings-card-icon">🔌</span>
            <span class="settings-card-title">Chế độ kết nối</span>
            <span class="settings-card-sub">Máy chủ, mạng, chế độ trạm — xem nhanh.</span>
        </a>
        @* P10.6d — About card replaces the prior disabled placeholder. *@
        <a class="settings-card" href="/settings/about">
            <span class="settings-card-icon">ℹ️</span>
            <span class="settings-card-title">Về ứng dụng</span>
            <span class="settings-card-sub">Phiên bản, dữ liệu, dung lượng.</span>
        </a>
        @if (HwOptions.Value.ScanEnabled)
        {
            <AuthorizeView Roles="Admin,Supervisor,Engineer">
                <a class="settings-card" href="/hardware">
                    <span class="settings-card-icon">🖨️</span>
                    <span class="settings-card-title">Thiết bị</span>
                    <span class="settings-card-sub">Máy quét, máy in, cân — đã cài đặt ở P10.3.</span>
                </a>
                <AuthorizeView Roles="Admin,Supervisor" Context="modeCtx">
                    <a class="settings-card" href="/mode">
                        <span class="settings-card-icon">🔁</span>
                        <span class="settings-card-title">Chế độ trạm</span>
                        <span class="settings-card-sub">Tương tác / Kiosk + mật mã khoá.</span>
                    </a>
                </AuthorizeView>
            </AuthorizeView>
        }
    </div>
</section>

<section class="settings-group">
    <h2 class="settings-group-title">Giao diện</h2>
    <div class="settings-cards">
        @* P10.6b — Appearance landing card. Language picker today;
           theme switcher ships in P10.6g. *@
        <a class="settings-card" href="/settings/appearance">
            <span class="settings-card-icon">🌐</span>
            <span class="settings-card-title">Giao diện</span>
            <span class="settings-card-sub">Ngôn ngữ Tiếng Việt / English; chủ đề sẽ ra mắt ở P10.6g.</span>
        </a>
    </div>
</section>

<section class="settings-group">
    <h2 class="settings-group-title">Quản trị viên</h2>
    <div class="settings-cards">
        @* P10.6h shipped — Backup & Restore admin landing. *@
        <AuthorizeView Roles="Admin">
            <a class="settings-card" href="/settings/backup">
                <span class="settings-card-icon">💾</span>
                <span class="settings-card-title">Sao lưu &amp; Khôi phục</span>
                <span class="settings-card-sub">Snapshot SQLite + khôi phục từ file (admin).</span>
            </a>
        </AuthorizeView>
        @* P10.6e shipped — Audit Log viewer + CSV/XLSX export. *@
        <AuthorizeView Roles="Admin" Context="audCtx">
            <a class="settings-card" href="/settings/audit">
                <span class="settings-card-icon">📜</span>
                <span class="settings-card-title">Nhật ký kiểm tra</span>
                <span class="settings-card-sub">Tra cứu + xuất CSV/XLSX (admin).</span>
            </a>
        </AuthorizeView>
    </div>
</section>

<section class="settings-group">
    <h2 class="settings-group-title">Sẽ có (P10.6c)</h2>
    <div class="settings-cards">
        @* P10.6f shipped — Recent Scans lives in the sidebar widget. *@
        <AuthorizeView Roles="Admin">
            <div class="settings-card is-disabled" aria-disabled="true">
                <span class="settings-card-icon">👥</span>
                <span class="settings-card-title">Quản lý tài khoản</span>
                <span class="settings-card-sub">P10.6c — Tạo / sửa / vô hiệu hoá tài khoản.</span>
            </div>
        </AuthorizeView>
    </div>
</section>
