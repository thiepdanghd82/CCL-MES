@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<CCL.MES.Hybrid.Client.Hardware.HardwareOptions> HwOptions

@*
  P10.6a — Settings landing. Cards link out to the sub-tab pages.
  Profile + Password are the two new ones this PR ships; Hardware +
  Mode link to the existing P10.3 W1 pages (no duplicate UI). The
  remaining sub-tabs (Appearance, Account Control, Audit Log,
  About, Backup) render as disabled-style placeholder cards so the
  operator can see the parity roadmap; they light up as P10.6b-h
  land.

  All cards are visible to any authenticated user. Role-gated cards
  (Hardware via ScanEnabled + Admin/Supervisor/Engineer; Mode via
  Admin/Supervisor) wrap in <AuthorizeView> so the operator only sees
  what they can actually open.
*@

<PageTitle>Settings — CCL MES</PageTitle>

<h1 class="page-title">Settings</h1>
<p class="page-sub">Manage your profile, password, and station configuration.</p>

<section class="settings-group">
    <h2 class="settings-group-title">Account</h2>
    <div class="settings-cards">
        <a class="settings-card" href="/settings/profile">
            <span class="settings-card-icon">👤</span>
            <span class="settings-card-title">My Profile</span>
            <span class="settings-card-sub">Display name, role, department.</span>
        </a>
        <a class="settings-card" href="/settings/password">
            <span class="settings-card-icon">🔑</span>
            <span class="settings-card-title">Change Password</span>
            <span class="settings-card-sub">Set a new password for the current account.</span>
        </a>
    </div>
</section>

<section class="settings-group">
    <h2 class="settings-group-title">Station</h2>
    <div class="settings-cards">
        @* P10.6d — Connection Mode summary, always visible to any
           authenticated role. Read-only view; the actual change
           controls live at /mode (P10.3) and are linked from inside. *@
        <a class="settings-card" href="/settings/connection">
            <span class="settings-card-icon">🔌</span>
            <span class="settings-card-title">Connection</span>
            <span class="settings-card-sub">Server, network, station mode — quick view.</span>
        </a>
        @* P10.6d — About card replaces the prior disabled placeholder. *@
        <a class="settings-card" href="/settings/about">
            <span class="settings-card-icon">ℹ️</span>
            <span class="settings-card-title">About</span>
            <span class="settings-card-sub">Version, data, storage.</span>
        </a>
        @if (HwOptions.Value.ScanEnabled)
        {
            <AuthorizeView Roles="Admin,Supervisor,Engineer">
                <a class="settings-card" href="/hardware">
                    <span class="settings-card-icon">🖨️</span>
                    <span class="settings-card-title">Devices</span>
                    <span class="settings-card-sub">Scanner, printer, scale — configured in P10.3.</span>
                </a>
                <AuthorizeView Roles="Admin,Supervisor" Context="modeCtx">
                    <a class="settings-card" href="/mode">
                        <span class="settings-card-icon">🔁</span>
                        <span class="settings-card-title">Station Mode</span>
                        <span class="settings-card-sub">Interactive / Kiosk + lock passcode.</span>
                    </a>
                </AuthorizeView>
            </AuthorizeView>
        }
    </div>
</section>

<section class="settings-group">
    <h2 class="settings-group-title">Appearance</h2>
    <div class="settings-cards">
        @* P10.6b — Appearance landing card. Language picker today;
           theme switcher ships in P10.6g. *@
        <a class="settings-card" href="/settings/appearance">
            <span class="settings-card-icon">🌐</span>
            <span class="settings-card-title">Appearance</span>
            <span class="settings-card-sub">Vietnamese / English language; themes arriving in P10.6g.</span>
        </a>
    </div>
</section>

@* P10.6c — wrap the entire "Quản trị viên" section in AuthorizeView
   so the header itself hides for non-admin (Engineer / Supervisor /
   Operator / QC). Previously the cards were each gated but the section
   <h2> rendered unconditionally, leaving non-admin with an empty group
   header. Carry-over from P10.6h landing-card placement + extended in
   P10.6e — bug now closed at the section scope. *@
<AuthorizeView Roles="Admin">
    <Authorized>
        <section class="settings-group">
            <h2 class="settings-group-title">Administrator</h2>
            <div class="settings-cards">
                @* P10.6h shipped — Backup & Restore admin landing. *@
                <a class="settings-card" href="/settings/backup">
                    <span class="settings-card-icon">💾</span>
                    <span class="settings-card-title">Backup &amp; Restore</span>
                    <span class="settings-card-sub">SQLite snapshot + restore from file.</span>
                </a>
                @* P10.6e shipped — Audit Log viewer + CSV/XLSX export. *@
                <a class="settings-card" href="/settings/audit">
                    <span class="settings-card-icon">📜</span>
                    <span class="settings-card-title">Audit Log</span>
                    <span class="settings-card-sub">Search + export CSV/XLSX.</span>
                </a>
                @* P10.6c shipped — Account Control. *@
                <a class="settings-card" href="/settings/accounts">
                    <span class="settings-card-icon">👥</span>
                    <span class="settings-card-title">Account Control</span>
                    <span class="settings-card-sub">Create / edit / disable / reset password.</span>
                </a>
            </div>
        </section>
    </Authorized>
</AuthorizeView>
