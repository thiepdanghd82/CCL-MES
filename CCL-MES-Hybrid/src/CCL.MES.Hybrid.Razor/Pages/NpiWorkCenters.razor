@page "/npi/workcenters"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor,Engineer,QC")]
@inject ICclApiClient Api
@inject IGridPreferenceStore PrefStore

@*
    P10.5a — Work Centers grid. Standardised pattern shared with
    /npi/structure, /npi/routine, /npi/rawmaterials:
        - Toolbar: search + Tải lại + GridColumnsMenu
        - Sticky/freeze table header inside a scroll container
        - Server-side pagination (default 20/page)
        - Lesson #27 (try/catch + inline error banner) — never crash the
          page on a partial/transient failure
*@

<PageTitle>Work Centers — NPI</PageTitle>

<h1 class="page-title">Work Centers</h1>

<div class="grid-toolbar">
    <input type="search" class="grid-search" placeholder="Search by code or description…"
           @bind="_search" @bind:event="oninput" @onkeyup="HandleSearchKey" />
    <button type="button" class="grid-btn" @onclick="OnSearchClickAsync" disabled="@_loading">Search</button>
    <button type="button" class="grid-btn" @onclick="ReloadAsync" disabled="@_loading">Reload</button>
    <div class="grid-toolbar-spacer"></div>
    <GridColumnsMenu Columns="_columns" OnChanged="StateHasChanged" />
</div>

@if (_loading && _data is null)
{
    <p class="grid-status">Loading…</p>
}
else if (_error is not null)
{
    <div class="grid-error" role="alert">
        <strong>Failed to load data.</strong>
        <div>@_error</div>
        <button type="button" class="grid-btn" @onclick="ReloadAsync">Retry</button>
    </div>
}
else if (_data is not null)
{
    <div class="grid-scroll">
        <table class="grid grid-sticky">
            <thead>
                <tr>
                    @foreach (var col in _columns.Visible)
                    {
                        <th class="grid-h @ColClass(col.Id)">@col.Label</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _data.Items)
                {
                    <tr>
                        @foreach (var col in _columns.Visible)
                        {
                            <td>@RenderCell(row, col.Id)</td>
                        }
                    </tr>
                }
                @if (_data.Items.Count == 0)
                {
                    <tr>
                        <td colspan="@_columns.Visible.Count" class="grid-empty">
                            No matching data.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="grid-pager">
        <button type="button" class="grid-btn"
                disabled="@(GridPagination.IsFirstPage(_page) || _loading)"
                @onclick="() => GoToPageAsync(_page - 1)">‹ Previous</button>
        <span class="grid-pager-text">
            Page @_page / @TotalPages — @_data.Total rows
        </span>
        <button type="button" class="grid-btn"
                disabled="@(GridPagination.IsLastPage(_page, TotalPages) || _loading)"
                @onclick="() => GoToPageAsync(_page + 1)">Next ›</button>
    </div>
}

@code {
    private NpiPagedRaw<NpiWorkCenter>? _data;
    private bool _loading;
    private string? _error;
    private string _search = "";
    private int _page = 1;
    private const int PageSize = 20;
    private GridColumns _columns = default!;

    private int TotalPages => GridPagination.TotalPages(_data?.Total ?? 0, PageSize);

    protected override async Task OnInitializedAsync()
    {
        _columns = new GridColumns("workcenters", new[]
        {
            new ColumnDef("id",          "ID"),
            new ColumnDef("code",        "Work Center Code"),
            new ColumnDef("description", "Description"),
            new ColumnDef("area",        "Area"),
            new ColumnDef("ideal_speed", "Ideal Speed (pcs/h)"),
            new ColumnDef("shift",       "Shift Pattern"),
            new ColumnDef("active",      "Status"),
        }, PrefStore);
        await LoadAsync();
    }

    private Task HandleSearchKey(KeyboardEventArgs e)
        => e.Key == "Enter" ? OnSearchClickAsync() : Task.CompletedTask;

    private Task OnSearchClickAsync()
    {
        // Reset page on new search — operator expects to see the first
        // match, not page 5 of the previous filter.
        _page = 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await Api.GetWorkCentersAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                _page, PageSize);
        }
        catch (ApiException apiEx)
        {
            _error = apiEx.ApiError.MessageEn;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ReloadAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = GridPagination.Clamp(page, TotalPages);
        return LoadAsync();
    }

    private static string ColClass(string columnId) => columnId switch
    {
        "id"          => "grid-col-narrow",
        "code"        => "grid-col-mono",
        "active"      => "grid-col-narrow",
        "ideal_speed" => "grid-col-num",
        _              => "",
    };

    private static RenderFragment RenderCell(NpiWorkCenter row, string columnId) => __builder =>
    {
        switch (columnId)
        {
            case "id":          __builder.AddContent(0, row.Id); break;
            case "code":        __builder.OpenElement(0, "code"); __builder.AddContent(1, row.Code); __builder.CloseElement(); break;
            case "description": __builder.AddContent(0, row.Description); break;
            case "area":        __builder.AddContent(0, row.Area); break;
            case "ideal_speed": __builder.AddContent(0, row.IdealSpeedPcsH?.ToString("0.##") ?? "—"); break;
            case "shift":       __builder.AddContent(0, row.ShiftPattern ?? "—"); break;
            case "active":
                __builder.AddContent(0, row.Active switch
                {
                    true  => "✓ Active",
                    false => "× Inactive",
                    _      => "—",
                });
                break;
        }
    };
}
