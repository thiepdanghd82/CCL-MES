@page "/login"
@layout EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject ICclApiClient Api
@inject IAuthSession Session
@inject NavigationManager Nav

<PageTitle>Đăng nhập — CCL MES</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <h1 class="login-title">CCL · MES</h1>
        <p class="login-sub">Đăng nhập với tài khoản hệ thống</p>

        @*
            Wiring notes (P10.6a hotfix — repeat of 3fff2d0):
              - Pre-hotfix the page used EditForm + InputText with
                bind-Value + bind-Value:event=oninput + onkeydown.
                That triple combo throws ArgumentException
                ("ChangeEventArgs cannot be converted to System.String")
                on every keystroke under net10 MAUI Blazor Hybrid. The
                throw silently corrupted the renderer dispatcher → the
                "click does nothing" symptom Henry filed twice.
              - Fix: plain HTML input + @bind + @bind:event="oninput" +
                @onkeydown (same pattern Lock.razor has been using
                cleanly).
              - Validation: field-level [Required] enforcement via
                DataAnnotationsValidator dropped; HandleSubmitAsync
                already does the same IsNullOrWhiteSpace check inline.
                The [Required] attribute on LoginForm is left in place
                so a future re-introduction (when the upstream Blazor
                binder is fixed) is one EditForm wrap.
              - Submit button keeps BOTH type="submit" AND @onclick so
                Enter-in-input AND direct click both fire — the WebView
                occasionally drops the synthetic form-submit, and the
                explicit @onclick guarantees the handler runs.
                _submitting flag is the idempotency guard.
              - tabindex 1/2/3 sequence + the always-on
                MacCatalystKeyboardFix component still handle Tab +
                Enter (dotnet/maui#13934).
              - autocomplete off / new-password so macOS Keychain
                doesn't inject the saved-credential pair on focus.
        *@
        <form @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault="true" name="login">
            <div class="login-field">
                <label for="login-username">Tên đăng nhập</label>
                <input id="login-username" type="text" class="login-input"
                       tabindex="1"
                       @bind="_form.Username" @bind:event="oninput"
                       @onkeydown="OnFieldKeyDown"
                       autocomplete="off" autofocus />
            </div>
            <div class="login-field">
                <label for="login-password">Mật khẩu</label>
                <input id="login-password" type="password" class="login-input"
                       tabindex="2"
                       @bind="_form.Password" @bind:event="oninput"
                       @onkeydown="OnFieldKeyDown"
                       autocomplete="new-password" />
            </div>

            @if (_errorKey is not null)
            {
                <div class="login-error" role="alert">
                    <strong>@LocaliseError(_errorKey)</strong>
                    @if (!string.IsNullOrWhiteSpace(_errorDetail))
                    {
                        <div class="login-error-detail">@_errorDetail</div>
                    }
                </div>
            }

            <button type="submit" class="login-submit" tabindex="3"
                    disabled="@_submitting" @onclick="HandleSubmitAsync">
                @(_submitting ? "Đang đăng nhập…" : "Đăng nhập")
            </button>
        </form>
    </div>
</div>

@code {
    private LoginForm _form = new();
    private string? _errorKey;
    private string? _errorDetail;
    private bool _submitting;
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }


    private async Task HandleSubmitAsync()
    {
        // Idempotency guard — EditForm OnValidSubmit + button @onclick may
        // both fire on the same user action depending on the WebView host;
        // _submitting ensures the LoginAsync round-trip happens once.
        if (_submitting) return;

        _errorKey = null;
        _errorDetail = null;

        if (string.IsNullOrWhiteSpace(_form.Username) || string.IsNullOrWhiteSpace(_form.Password))
        {
            _errorKey = "auth.missing_fields";
            return;
        }

        _submitting = true;
        try
        {
            var response = await Api.LoginAsync(_form.Username.Trim(), _form.Password);
            await Session.SetLoginAsync(response);
            var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl!;
            Nav.NavigateTo(target, forceLoad: false, replace: true);
        }
        catch (ApiException apiEx) when (apiEx.StatusCode == 401)
        {
            _errorKey = apiEx.ApiError.Code;
            _errorDetail = $"HTTP {apiEx.StatusCode} · {apiEx.ApiError.Code}";
        }
        catch (ApiException apiEx)
        {
            _errorKey = "auth.unknown_error";
            _errorDetail = $"HTTP {apiEx.StatusCode} · {apiEx.ApiError.Code} · {apiEx.ApiError.MessageEn}";
        }
        catch (HttpRequestException ex)
        {
            // Mac Catalyst ATS blocks cleartext http://localhost without
            // the Info.plist exception — that path surfaces as
            // HttpRequestException + "The resource could not be loaded
            // because the App Transport Security policy requires the use
            // of a secure connection." We expose the inner message so
            // operators see the actual cause instead of a generic banner.
            _errorKey = "auth.network_error";
            _errorDetail = TrimDetail(ex.Message);
        }
        catch (TaskCanceledException ex)
        {
            _errorKey = "auth.timeout";
            _errorDetail = TrimDetail(ex.Message);
        }
        catch (Exception ex)
        {
            _errorKey = "auth.unknown_error";
            _errorDetail = $"{ex.GetType().Name}: {TrimDetail(ex.Message)}";
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>
    /// Enter inside an input fires submit. Tab navigation is handled by
    /// the platform-gated MacCatalystKeyboardFix component (see
    /// dotnet/maui#13934 — Catalyst WKWebView traps focus inside inputs
    /// so the default Tab handling is broken).
    /// </summary>
    private async Task OnFieldKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmitAsync();
        }
    }

    private static string LocaliseError(string code) => code switch
    {
        "auth.invalid_credentials" => "Sai tên đăng nhập hoặc mật khẩu.",
        "auth.missing_fields"      => "Vui lòng nhập đủ thông tin.",
        "auth.network_error"       => "Không thể kết nối máy chủ. Kiểm tra mạng rồi thử lại.",
        "auth.timeout"             => "Máy chủ phản hồi quá lâu. Thử lại.",
        _                          => "Đăng nhập thất bại. Vui lòng thử lại.",
    };

    /// <summary>Cap the error-detail text so a multi-line exception
    /// message doesn't blow the card height. 240 chars is enough for
    /// "HTTP 401 · auth.invalid_credentials · Invalid username or
    /// password." plus the ATS / DNS / timeout variants.</summary>
    private static string TrimDetail(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw;
        var oneLine = raw.Replace('\n', ' ').Replace('\r', ' ').Trim();
        return oneLine.Length <= 240 ? oneLine : oneLine[..240] + "…";
    }

    private sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Bắt buộc")]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Bắt buộc")]
        public string Password { get; set; } = "";
    }
}
