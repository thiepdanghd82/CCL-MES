@page "/settings/appearance"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Localization
@inject Microsoft.JSInterop.IJSRuntime JS

@*
  P10.6b — Appearance / Language picker page.
  i18n Phase-2: the picker now takes effect LIVE. Selecting a language
  calls ILanguageService.Set → every LocalizedComponentBase re-renders,
  including this page. The old "will apply after the app is updated"
  disclaimer is gone — the swap is real now.

  Catalyst safety: NO <InputText>. Picker is a button-card group with
  plain @onclick (avoids the ChangeEventArgs→string trap).
  Theme switcher stays deferred to P10.6g.
*@

<PageTitle>@T("appearance.pagetitle")</PageTitle>

<div class="settings-page-header">
    <a class="grid-btn grid-btn-link" href="/settings">@T("common.back.settings")</a>
    <PageHead TitleKey="appearance.title" />
</div>

<section class="settings-form-card">
    <h2 class="settings-group-title">@T("common.language")</h2>
    <p class="settings-form-help">@T("appearance.language.help")</p>

    <div class="appearance-picker" role="radiogroup" aria-label="@T("appearance.aria.language")">
        @foreach (var opt in Options)
        {
            var isActive = opt.Code == LanguageService.Current;
            <button type="button"
                    role="radio"
                    aria-checked="@(isActive ? "true" : "false")"
                    class="@(isActive ? "appearance-card is-active" : "appearance-card")"
                    @onclick="@(() => OnSelect(opt.Code))">
                <span class="appearance-card-flag">@opt.Flag</span>
                <span class="appearance-card-title">@opt.Native</span>
                <span class="appearance-card-sub">@T(opt.HintKey)</span>
                @if (isActive)
                {
                    <span class="appearance-card-check" aria-hidden="true">✓</span>
                }
            </button>
        }
    </div>
</section>

<section class="settings-form-card" style="margin-top:16px">
    <h2 class="settings-group-title">@T("appearance.density.title")</h2>
    <p class="settings-form-help">@T("appearance.density.help")</p>

    @* CCL iX — cùng markup, hai bộ số (ix.css §9). Nút dùng đúng pattern
       appearance-card như picker ngôn ngữ: KHÔNG <InputText> (bẫy
       ChangeEventArgs→string trên Catalyst, L2). *@
    <div class="appearance-picker" role="radiogroup" aria-label="@T("appearance.aria.density")">
        @foreach (var opt in DensityOptions)
        {
            var isActive = opt.Value == _density;
            <button type="button"
                    role="radio"
                    aria-checked="@(isActive ? "true" : "false")"
                    class="@(isActive ? "appearance-card is-active" : "appearance-card")"
                    data-testid="@($"density-{opt.Value}")"
                    @onclick="@(() => SetDensityAsync(opt.Value))">
                <span class="appearance-card-flag">@opt.Icon</span>
                <span class="appearance-card-title">@T(opt.TitleKey)</span>
                <span class="appearance-card-sub">@T(opt.SubKey)</span>
                @if (isActive)
                {
                    <span class="appearance-card-check" aria-hidden="true">✓</span>
                }
            </button>
        }
    </div>
</section>

<section class="settings-form-card" style="margin-top:16px">
    <h2 class="settings-group-title">@T("appearance.scale.title")</h2>
    <p class="settings-form-help">@T("appearance.scale.help")</p>

    @* L42 — công cụ chỉnh cỡ chữ / UI. Cùng pattern appearance-card như
       Density/Language: button-card role=radio, KHÔNG <InputText>. Giá trị =
       hệ số thập phân ('0.9'…'1.5') áp thẳng vào --ui-scale qua scaleSet. *@
    <div class="appearance-picker" role="radiogroup" aria-label="@T("appearance.aria.scale")">
        @foreach (var opt in ScaleOptions)
        {
            var isActive = opt.Value == _scale;
            <button type="button"
                    role="radio"
                    aria-checked="@(isActive ? "true" : "false")"
                    class="@(isActive ? "appearance-card is-active" : "appearance-card")"
                    data-testid="@($"uiscale-{opt.Value}")"
                    @onclick="@(() => SetScaleAsync(opt.Value))">
                <span class="appearance-card-title">@T(opt.TitleKey)</span>
                <span class="appearance-card-sub">@T(opt.SubKey)</span>
                @if (isActive)
                {
                    <span class="appearance-card-check" aria-hidden="true">✓</span>
                }
            </button>
        }
    </div>
    <div class="appearance-actions">
        <button type="button"
                class="grid-btn grid-btn-link"
                data-testid="uiscale-reset"
                disabled="@(_scale == ScaleDefault)"
                @onclick="@(() => SetScaleAsync(ScaleDefault))">
            @T("appearance.scale.reset")
        </button>
    </div>
</section>

<section class="settings-form-card" style="margin-top:16px">
    <h2 class="settings-group-title">@T("appearance.theme.title")</h2>
    <p class="settings-form-help">@T("appearance.theme.help")</p>
    <div class="appearance-picker is-locked">
        <div class="appearance-card is-disabled" aria-disabled="true">
            <span class="appearance-card-flag">☀️</span>
            <span class="appearance-card-title">@T("appearance.theme.light")</span>
            <span class="appearance-card-sub">@T("appearance.theme.light.sub")</span>
        </div>
        <div class="appearance-card is-disabled" aria-disabled="true">
            <span class="appearance-card-flag"><Icon Name="moon" /></span>
            <span class="appearance-card-title">@T("appearance.theme.dark")</span>
            <span class="appearance-card-sub">@T("appearance.theme.dark.sub")</span>
        </div>
        <div class="appearance-card is-disabled" aria-disabled="true">
            <span class="appearance-card-flag"><Icon Name="monitor" /></span>
            <span class="appearance-card-title">@T("appearance.theme.system")</span>
            <span class="appearance-card-sub">@T("appearance.theme.system.sub")</span>
        </div>
    </div>
</section>

@code {
    // Mật độ đọc/ghi qua window.cclMesDensity (js/density.js) — localStorage,
    // áp lên <html data-density>. Boot script trong index.html đã áp trước khi
    // Blazor render nên không chớp giao diện; ở đây chỉ ĐỒNG BỘ trạng thái nút.
    private string _density = "office";

    // L42 — hệ số UI scale (chuỗi thập phân). Mặc định "1" = 100%. Đọc/ghi qua
    // window.cclMesDensity.scaleGet/scaleSet (localStorage, áp lên --ui-scale).
    // Boot script trong index.html đã áp trước Blazor nên không chớp; ở đây chỉ
    // ĐỒNG BỘ trạng thái nút (giống Density).
    private const string ScaleDefault = "1";
    private string _scale = ScaleDefault;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var changed = false;
        try
        {
            var v = await JS.InvokeAsync<string>("cclMesDensity.get");
            if (!string.IsNullOrWhiteSpace(v) && v != _density)
            {
                _density = v;
                changed = true;
            }
        }
        catch
        {
            // JS chưa sẵn sàng / bị chặn → giữ mặc định office. Không bao giờ
            // để lỗi interop nổi lên renderer (L1).
        }

        try
        {
            var s = await JS.InvokeAsync<string>("cclMesDensity.scaleGet");
            if (!string.IsNullOrWhiteSpace(s) && s != _scale)
            {
                _scale = s;
                changed = true;
            }
        }
        catch
        {
            // Như trên — giữ mặc định 100%.
        }

        if (changed) StateHasChanged();
    }

    private async Task SetDensityAsync(string value)
    {
        if (value == _density) return;          // idempotent
        _density = value;
        try { await JS.InvokeVoidAsync("cclMesDensity.set", value); } catch { }
    }

    private async Task SetScaleAsync(string value)
    {
        if (value == _scale) return;            // idempotent — không ghi lại giá trị đang có
        _scale = value;
        try { await JS.InvokeVoidAsync("cclMesDensity.scaleSet", value); } catch { }
    }

    private static readonly DensityOption[] DensityOptions = new[]
    {
        new DensityOption("office",    "▤", "appearance.density.office",    "appearance.density.office.sub"),
        new DensityOption("shopfloor", "▥", "appearance.density.shopfloor", "appearance.density.shopfloor.sub"),
    };

    private sealed record DensityOption(string Value, string Icon, string TitleKey, string SubKey);

    // Bậc rời (GOV.UK/Carbon text-zoom): 90 · 100 (mặc định) · 110 · 125 · 150.
    // Value = hệ số thập phân áp thẳng vào --ui-scale.
    private static readonly ScaleOption[] ScaleOptions = new[]
    {
        new ScaleOption("0.9",  "appearance.scale.90",  "appearance.scale.90.sub"),
        new ScaleOption("1",    "appearance.scale.100", "appearance.scale.100.sub"),
        new ScaleOption("1.1",  "appearance.scale.110", "appearance.scale.110.sub"),
        new ScaleOption("1.25", "appearance.scale.125", "appearance.scale.125.sub"),
        new ScaleOption("1.5",  "appearance.scale.150", "appearance.scale.150.sub"),
    };

    private sealed record ScaleOption(string Value, string TitleKey, string SubKey);

    private static readonly LanguageOption[] Options = new[]
    {
        new LanguageOption(LanguageCode.Vietnamese, "🇻🇳", "Tiếng Việt", "appearance.lang.vi.hint"),
        new LanguageOption(LanguageCode.English, "🇬🇧", "English", "appearance.lang.en.hint"),
    };

    private void OnSelect(LanguageCode code)
    {
        // Idempotent — the service swallows no-op writes. LocalizedComponentBase
        // re-renders this page (and the rest of the app) on the Changed event.
        LanguageService.Set(code);
    }

    private sealed record LanguageOption(LanguageCode Code, string Flag, string Native, string HintKey);
}
