@page "/settings/accounts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using System.Globalization
@using CCL.MES.Hybrid.Client
@using CCL.MES.Shared.Accounts
@inject ICclApiClient Api
@inject IJSRuntime Js

@*
  P10.6c — Admin Account Control.

  Admin-only at BOTH layers:
    - Page [Authorize(Roles = "Admin")] — non-admin renders the
      standard forbidden screen.
    - Every API endpoint sits behind AdminOnly policy. Server is
      defence-in-depth — anon-401 + Engineer-403 covered by
      RouteDiscoveryCanaryTests + AccountControlControllerTests.

  Catalyst safety: plain <input type="text" / "password"> +
  plain <select> + plain @onclick. NO <InputText>, NO <InputFile>.
  Confirm modals via Js.InvokeAsync<bool>("confirm", …) — proven
  Catalyst-safe since P10.6h Backup restore.

  Mutations:
    - Create user: opens an inline modal with username / display
      name / role / department / temp password.
    - Reset password: prompt for the new temp pwd → confirm gate →
      USER_RESET_PASSWORD emit; server sets MustChangePassword=true.
    - Toggle Active: confirm gate → USER_SET_ACTIVE emit; server
      revokes all refresh tokens when flipping to inactive (effective
      logout ≤ 15 min — access token TTL).
    - Role + Department + DisplayName change: inline <select> /
      <input> + Lưu button.
*@

<PageTitle>@T("accounts.pagetitle")</PageTitle>

<div class="settings-page-header">
    <a class="grid-btn grid-btn-link" href="/settings">@T("common.back.settings")</a>
    <PageHead TitleKey="accounts.title" />
</div>

<section class="settings-form-card is-wide">
    <div class="audit-result-head">
        <h2 class="settings-group-title">@T("accounts.users.count", _result.Total)</h2>
        <div class="audit-filter-actions" style="margin-top:0">
            <input id="ac-search" type="text" class="modal-input"
                   placeholder="@T("accounts.search.placeholder")"
                   style="width:280px"
                   @bind="_search" @bind:event="oninput"
                   @bind:after="OnApplySearch" />
            <button type="button" class="grid-btn grid-btn-primary"
                    @onclick="OpenCreateModal">@T("accounts.create.button")</button>
        </div>
    </div>

    @if (_listError is not null)
    {
        <div class="settings-form-error">@_listError</div>
    }
    @if (_actionInfo is not null)
    {
        <div class="settings-form-success">@_actionInfo</div>
    }
    @if (_actionError is not null)
    {
        <div class="settings-form-error">@_actionError</div>
    }

@* ── Khối phân quyền: ai đang mở máy, và bảng có đang KHOÁ không ──
       Mặc định KHOÁ. Mở khoá phải gõ lại mật khẩu CỦA CHÍNH ADMIN — không dùng
       "mã xác thực" dùng chung, vì mã dùng chung là bí mật ai cũng biết, và
       không truy được ai đã mở. Dùng lại đúng đường ký của IPQC: cùng hãm
       thử-sai, cùng mã lỗi chung, mật khẩu không bao giờ vào audit. *@
    @if (_matrix is not null)
    {
        <div class="acc-permbar" data-testid="acc-permbar">
            <div class="acc-permbar-facts">
                <span><b>@T("accounts.perm.currentuser"):</b> <span class="acc-permbar-user">@_matrix.CurrentUsername</span></span>
                <span><b>@T("accounts.perm.currentrole"):</b> @AccountRoleOptions.Label(_matrix.CurrentRole)</span>
            </div>
            @if (!_matrix.CanEdit)
            {
                <div class="acc-permbar-locked" data-testid="acc-permbar-norole">@T("accounts.perm.adminonly")</div>
            }
            else if (_permUnlocked)
            {
                <div class="acc-permbar-open" data-testid="acc-permbar-open">
                    @T("accounts.perm.unlocked")
                    <button type="button" class="audit-copy-btn" @onclick="LockPerms"
                            data-testid="acc-perm-lock">@T("accounts.perm.lock")</button>
                </div>
            }
            else
            {
                <div class="acc-permbar-lockrow">
                    <span class="acc-permbar-locked" data-testid="acc-permbar-locked">@T("accounts.perm.locked")</span>
                    <input type="password" class="modal-input acc-permbar-pwd"
                           value="@_permPwd" autocomplete="off"
                           placeholder="@T("accounts.perm.authcode.ph")"
                           aria-label="@T("accounts.perm.authcode.ph")"
                           data-testid="acc-perm-pwd"
                           @oninput="(e) => _permPwd = e.Value?.ToString()" />
                    <button type="button" class="audit-copy-btn"
                            disabled="@(string.IsNullOrEmpty(_permPwd) || _busyPerm)"
                            @onclick="UnlockPermsAsync"
                            data-testid="acc-perm-unlock">@T("accounts.perm.unlock")</button>
                </div>
            }
        </div>
        @if (_permError is not null)
        {
            <div class="settings-form-error" data-testid="acc-perm-error">@_permError</div>
        }
    }

    @if (_loading)
    {
        <p class="settings-form-help">@T("accounts.loading")</p>
    }
    else if (_result.Items.Count == 0)
    {
        <p class="settings-form-help">@T("accounts.empty")</p>
    }
    else
    {
        <div class="audit-table-wrap">
            <table class="audit-table accounts-table">
                <colgroup>
                    <col class="acc-col-username" />
                    <col class="acc-col-display"  />
                    <col class="acc-col-role"     />
                    <col class="acc-col-dept"     />
                    <col class="acc-col-active"   />
                    <col class="acc-col-must"     />
                    <col class="acc-col-last"     />
@foreach (var perm in PermKeys)
                    {
                        <col class="acc-col-perm" />
                    }
                    <col class="acc-col-permcount" />
                    <col class="acc-col-actions"  />
                </colgroup>
                <thead>
                    <tr>
                        <th>@T("accounts.col.username")</th>
                        <th>@T("accounts.col.display")</th>
                        <th>@T("accounts.col.role")</th>
                        <th>@T("accounts.col.department")</th>
                        <th>@T("accounts.col.status")</th>
                        <th>@T("accounts.col.changepw")</th>
                        <th>@T("accounts.col.lastlogin")</th>
@foreach (var perm in PermKeys)
                        {
                            <th class="acc-perm-th">@T($"accounts.perm.{perm.ToLowerInvariant()}")</th>
                        }
                        <th class="acc-perm-th">@T("accounts.perm.count")</th>
                        <th>@T("accounts.col.actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in _result.Items)
                    {
                        var isSelf = u.Id == _selfId;
                        <tr>
                            <td class="audit-mono" title="@u.Username">@u.Username @if (isSelf) { <span class="acc-self">@T("accounts.self")</span> }</td>
                            <td>
                                <input type="text" class="modal-input acc-inline"
                                       value="@(u.DisplayName ?? "")"
                                       @onchange="@(e => OnEditDisplay(u.Id, e.Value?.ToString()))" />
                            </td>
                            <td>
                                <select class="modal-input acc-inline"
                                        value="@u.Role"
                                        disabled="@isSelf"
                                        @onchange="@(e => OnEditRole(u.Id, e.Value?.ToString() ?? u.Role))">
                                    @foreach (var r in Roles)
                                    {
                                        <option value="@r">@AccountRoleOptions.Label(r)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="text" class="modal-input acc-inline"
                                       value="@(u.Department ?? "")"
                                       @onchange="@(e => OnEditDept(u.Id, e.Value?.ToString()))" />
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="backup-chip">@T("accounts.status.active")</span>
                                }
                                else
                                {
                                    <span class="backup-chip backup-chip-pre">@T("accounts.status.disabled")</span>
                                }
                            </td>
                            <td>@(u.MustChangePassword ? "✓" : "—")</td>
                            <td class="audit-mono">@(u.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) ?? "—")</td>
@foreach (var perm in PermKeys)
                            {
                                var on   = Eff(u.Id, perm);
                                var over = IsOverridden(u.Id, perm);
                                <td class="acc-perm-td">
                                    <input type="checkbox" class="acc-perm-box @(over ? "is-override" : "")"
                                           checked="@on"
                                           disabled="@(!_permUnlocked || _busyPerm)"
                                           title="@(over ? T("accounts.perm.overridden") : T("accounts.perm.byrole"))"
                                           data-testid="@($"acc-perm-{u.Username}-{perm}")"
                                           @onchange="@(e => OnTogglePermAsync(u.Id, perm, (bool?)e.Value == true))" />
                                </td>
                            }
                            <td class="acc-perm-count" data-testid="@($"acc-permcount-{u.Username}")">@PermCount(u.Id)</td>
                            <td>
                                <div class="acc-actions">
                                    <button type="button" class="audit-copy-btn"
                                            disabled="@isSelf"
                                            title="@T("accounts.action.reset.title")"
                                            @onclick="@(() => OpenResetModal(u))">@T("accounts.action.reset")</button>
                                    @if (u.IsActive)
                                    {
                                        <button type="button" class="audit-copy-btn"
                                                disabled="@isSelf"
                                                title="@T("accounts.action.disable.title")"
                                                @onclick="@(() => OnToggleActive(u, false))">@T("accounts.action.disable")</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="audit-copy-btn"
                                                title="@T("accounts.action.enable.title")"
                                                @onclick="@(() => OnToggleActive(u, true))">@T("accounts.action.enable")</button>
                                    }
                                    <button type="button" class="audit-copy-btn acc-danger"
                                            disabled="@(isSelf || u.Role == "Sys")"
                                            title="@T("accounts.action.delete.title")"
                                            @onclick="@(() => OnDeleteAccount(u))">@T("accounts.action.delete")</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                @if (_matrix is not null)
                {
                    <tfoot>
                        <tr class="acc-perm-total">
                            <td colspan="8">@T("accounts.perm.total")</td>
                            @foreach (var perm in PermKeys)
                            {
                                <td class="acc-perm-td" data-testid="@($"acc-permtotal-{perm}")">@Total(perm)</td>
                            }
                            <td></td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        <div class="audit-paging" style="margin-top:10px">
            <button type="button" class="grid-btn" disabled="@(_loading || _result.Page <= 1)"
                    @onclick="@(() => LoadPage(_result.Page - 1))">@T("accounts.paging.prev")</button>
            <span class="audit-paging-pos">@T("accounts.paging.pos", _result.Page, TotalPages)</span>
            <button type="button" class="grid-btn"
                    disabled="@(_loading || _result.Page >= TotalPages)"
                    @onclick="@(() => LoadPage(_result.Page + 1))">@T("accounts.paging.next")</button>
        </div>
    }
</section>

@* ── Create modal ─────────────────────────────────────────────── *@
@if (_createOpen)
{
    <div class="acc-modal-scrim" @onclick="CloseCreateModal">
        <div class="acc-modal" @onclick:stopPropagation="true">
            <h3 class="acc-modal-title">@T("accounts.create.title")</h3>
            <div class="acc-modal-grid">
                <div>
                    <label>@T("accounts.field.username")</label>
                    <input type="text" class="modal-input"
                           @bind="_newUsername" @bind:event="oninput"
                           autocomplete="off" />
                </div>
                <div>
                    <label>@T("accounts.field.display")</label>
                    <input type="text" class="modal-input"
                           @bind="_newDisplay" @bind:event="oninput" />
                </div>
                <div>
                    <label>@T("accounts.field.role")</label>
                    <select class="modal-input" @bind="_newRole">
                        @foreach (var r in Roles)
                        {
                            <option value="@r">@AccountRoleOptions.Label(r)</option>
                        }
                    </select>
                </div>
                <div>
                    <label>@T("accounts.field.department")</label>
                    <input type="text" class="modal-input"
                           @bind="_newDept" @bind:event="oninput" />
                </div>
                <div style="grid-column: span 2">
                    <label>@T("accounts.field.temppassword")</label>
                    <input type="password" class="modal-input"
                           @bind="_newPassword" @bind:event="oninput"
                           autocomplete="new-password" />
                </div>
            </div>
            @if (_createError is not null)
            {
                <div class="settings-form-error">@_createError</div>
            }
            <div class="acc-modal-actions">
                <button type="button" class="grid-btn" @onclick="CloseCreateModal" disabled="@_creating">@T("accounts.button.cancel")</button>
                <button type="button" class="grid-btn grid-btn-primary"
                        @onclick="OnCreateSubmit" disabled="@_creating">
                    @(_creating ? T("accounts.button.creating") : T("accounts.button.create"))
                </button>
            </div>
        </div>
    </div>
}

@* ── Reset modal ──────────────────────────────────────────────── *@
@if (_resetTarget is not null)
{
    <div class="acc-modal-scrim" @onclick="CloseResetModal">
        <div class="acc-modal acc-modal-narrow" @onclick:stopPropagation="true">
            <h3 class="acc-modal-title">@T("accounts.reset.title", _resetTarget.Username)</h3>
            <p class="settings-form-help">
                @T("accounts.reset.help")
            </p>
            <div>
                <label>@T("accounts.field.newpassword")</label>
                <input type="password" class="modal-input"
                       @bind="_resetPassword" @bind:event="oninput"
                       autocomplete="new-password" />
            </div>
            @if (_resetError is not null)
            {
                <div class="settings-form-error">@_resetError</div>
            }
            <div class="acc-modal-actions">
                <button type="button" class="grid-btn" @onclick="CloseResetModal" disabled="@_resetting">@T("accounts.button.cancel")</button>
                <button type="button" class="grid-btn grid-btn-danger"
                        @onclick="OnResetSubmit" disabled="@_resetting">
                    @(_resetting ? T("accounts.button.resetting") : T("accounts.button.reset"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const int PageSize = 50;
    // 2026-09-15 — mảng gõ tay cũ ghi "Qc" trong khi DB lưu "QC" ⇒ <select>
    // không khớp option nào và hiện TRẮNG (user `qc` trông như chưa gán vai).
    // Dùng danh sách chuẩn ở Shared, có test khoá với UserRole.All.
    private static IReadOnlyList<string> Roles => AccountRoleOptions.All;

    // ── Bảng phân quyền (2026-09-15) ────────────────────────────────
    private PermissionMatrixView? _matrix;
    private bool _permUnlocked;          // mặc định KHOÁ
    private string? _permPwd;            // mật khẩu admin, xoá ngay sau khi dùng
    private string? _permError;
    private bool _busyPerm;

    private static IReadOnlyList<string> PermKeys => PermissionKeys;
    private static readonly string[] PermissionKeys =
    {
        "ViewData", "EditData", "ApproveQc", "ApproveProduction",
        "SpecialAccept", "ExportReport", "ManageUsers", "SystemConfig",
    };

    private PermissionMatrixRow? Row(long id) =>
        _matrix?.Rows.FirstOrDefault(r => r.UserId == id);

    private bool Eff(long id, string perm) =>
        Row(id)?.Effective.TryGetValue(perm, out var v) == true && v;

    /// <summary>Quyền này đã bị admin tick tường minh (khác mặc định của vai).
    /// Giao diện tô khác để phân biệt "đang theo vai" với "đã chỉnh riêng" —
    /// hai thứ trông giống nhau nhưng khác hẳn khi truy trách nhiệm.</summary>
    private bool IsOverridden(long id, string perm) =>
        Row(id)?.Explicit.ContainsKey(perm) == true;

    private int PermCount(long id) => Row(id)?.GrantedCount ?? 0;
    private int Total(string perm) =>
        _matrix?.Totals.TryGetValue(perm, out var t) == true ? t : 0;

    private void LockPerms()
    {
        _permUnlocked = false;
        _permPwd = null;     // máy dùng chung: không để mật khẩu nằm lại
        _permError = null;
    }

    /// <summary>Mở khoá = thử ký một lần với danh sách quyền RỖNG. Không ghi gì,
    /// nhưng đi đúng đường xác thực thật — nên hãm thử-sai và audit từ chối đều
    /// áp dụng y như lúc sửa thật.</summary>
    private async Task UnlockPermsAsync()
    {
        if (string.IsNullOrEmpty(_permPwd) || _matrix is null) return;
        _busyPerm = true; _permError = null;
        try
        {
            var me = _matrix.Rows.FirstOrDefault(r =>
                string.Equals(r.Username, _matrix.CurrentUsername, StringComparison.OrdinalIgnoreCase));
            if (me is null) { _permError = T("accounts.perm.err.noself"); return; }

            var resp = await Api.SetUserPermissionsAsync(me.UserId, new UpdateUserPermissionsRequest
            {
                Permissions = new Dictionary<string, bool?>(),   // không đổi gì
                SignerUsername = _matrix.CurrentUsername,
                SignerPassword = _permPwd,
            });
            _permUnlocked = resp.Ok;
            if (!resp.Ok) _permError = resp.Message;
        }
        catch (Exception ex) { _permError = ex.Message; }
        finally { _permPwd = null; _busyPerm = false; }   // xoá mật khẩu LUÔN
    }

    private async Task OnTogglePermAsync(long userId, string perm, bool value)
    {
        if (!_permUnlocked || _matrix is null) return;
        _busyPerm = true; _permError = null;
        try
        {
            var resp = await Api.SetUserPermissionsAsync(userId, new UpdateUserPermissionsRequest
            {
                Permissions = new Dictionary<string, bool?> { [perm] = value },
                SignerUsername = _matrix.CurrentUsername,
                SignerPassword = null,     // đã mở khoá trong phiên này
            });
            if (!resp.Ok) { _permError = resp.Message; _permUnlocked = false; }
            await LoadMatrixAsync();
        }
        catch (Exception ex) { _permError = ex.Message; }
        finally { _busyPerm = false; }
    }

    private async Task LoadMatrixAsync()
    {
        try { _matrix = await Api.GetPermissionMatrixAsync(); }
        catch (Exception) { _matrix = null; }
    }

    private string? _search;
    private bool _loading = true;
    private string? _listError;
    private string? _actionInfo;
    private string? _actionError;
    private AccountPagedResult _result = new();
    private long _selfId;

    // Create modal state.
    private bool _createOpen;
    private bool _creating;
    private string _newUsername = "";
    private string _newDisplay = "";
    private string _newRole = "Operator";
    private string _newDept = "";
    private string _newPassword = "";
    private string? _createError;

    // Reset modal state.
    private AccountDto? _resetTarget;
    private bool _resetting;
    private string _resetPassword = "";
    private string? _resetError;

    private int TotalPages =>
        _result.Total <= 0 ? 1 : (int)Math.Ceiling(_result.Total / (double)Math.Max(1, _result.PageSize));

    [CascadingParameter]
    public Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadMatrixAsync();
        if (AuthStateTask is not null)
        {
            var auth = await AuthStateTask;
            var idStr = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            long.TryParse(idStr, out _selfId);
        }
        await LoadPage(1);
    }

    private async Task OnApplySearch() => await LoadPage(1);

    private async Task LoadPage(int page)
    {
        _loading = true;
        _listError = null;
        try
        {
            _result = await Api.ListAccountsAsync(_search, page, PageSize);
        }
        catch (ApiException ex)
        {
            _listError = T("accounts.error.load", ex.ApiError.Code, ex.StatusCode);
        }
        catch (Exception ex)
        {
            _listError = T("accounts.error.generic", ex.GetType().Name, ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Inline edits ────────────────────────────────────────────────

    private Task OnEditDisplay(long userId, string? newName) =>
        Patch(userId, new UpdateAccountRequest { DisplayName = newName ?? "" });

    private Task OnEditRole(long userId, string newRole) =>
        Patch(userId, new UpdateAccountRequest { Role = newRole });

    private Task OnEditDept(long userId, string? newDept) =>
        Patch(userId, new UpdateAccountRequest { Department = newDept ?? "" });

    private async Task OnToggleActive(AccountDto u, bool target)
    {
        var msg = target
            ? T("accounts.confirm.enable", u.Username)
            : T("accounts.confirm.disable", u.Username);
        var ok = await Js.InvokeAsync<bool>("confirm", msg);
        if (!ok) return;
        await Patch(u.Id, new UpdateAccountRequest { IsActive = target });
    }

    private async Task OnDeleteAccount(AccountDto u)
    {
        _actionError = null;
        _actionInfo = null;
        var ok = await Js.InvokeAsync<bool>("confirm",
            T("accounts.confirm.delete", u.Username, u.Role));
        if (!ok) return;
        try
        {
            var dto = await Api.DeleteAccountAsync(u.Id);
            _actionInfo = T("accounts.info.deleted", dto.Username);
            // If the deleted row was the last on this page, step back a page.
            var page = _result.Items.Count <= 1 && _result.Page > 1 ? _result.Page - 1 : _result.Page;
            await LoadPage(page);
        }
        catch (ApiException ex)
        {
            _actionError = T("accounts.error.delete", ex.ApiError.MessageEn, ex.ApiError.Code);
        }
        catch (Exception ex)
        {
            _actionError = T("accounts.error.generic", ex.GetType().Name, ex.Message);
        }
    }

    private async Task Patch(long userId, UpdateAccountRequest req)
    {
        _actionError = null;
        _actionInfo = null;
        try
        {
            var dto = await Api.UpdateAccountAsync(userId, req);
            _actionInfo = T("accounts.info.updated", dto.Username);
            await LoadPage(_result.Page);
        }
        catch (ApiException ex)
        {
            _actionError = T("accounts.error.update", ex.ApiError.MessageEn, ex.ApiError.Code);
        }
        catch (Exception ex)
        {
            _actionError = T("accounts.error.generic", ex.GetType().Name, ex.Message);
        }
    }

    // ── Create modal ────────────────────────────────────────────────

    private void OpenCreateModal()
    {
        _newUsername = "";
        _newDisplay = "";
        _newRole = "Operator";
        _newDept = "";
        _newPassword = "";
        _createError = null;
        _createOpen = true;
    }

    private void CloseCreateModal()
    {
        if (_creating) return;
        _createOpen = false;
    }

    private async Task OnCreateSubmit()
    {
        _creating = true;
        _createError = null;
        try
        {
            var dto = await Api.CreateAccountAsync(new CreateAccountRequest
            {
                Username = _newUsername,
                DisplayName = string.IsNullOrWhiteSpace(_newDisplay) ? null : _newDisplay,
                Role = _newRole,
                Department = string.IsNullOrWhiteSpace(_newDept) ? null : _newDept,
                Password = _newPassword,
            });
            _actionInfo = T("accounts.info.created", dto.Username, dto.Role);
            _createOpen = false;
            await LoadPage(1);
        }
        catch (ApiException ex)
        {
            _createError = T("accounts.error.modal", ex.ApiError.MessageEn, ex.ApiError.Code);
        }
        catch (Exception ex)
        {
            _createError = T("accounts.error.generic", ex.GetType().Name, ex.Message);
        }
        finally
        {
            _creating = false;
        }
    }

    // ── Reset modal ─────────────────────────────────────────────────

    private void OpenResetModal(AccountDto u)
    {
        _resetTarget = u;
        _resetPassword = "";
        _resetError = null;
    }

    private void CloseResetModal()
    {
        if (_resetting) return;
        _resetTarget = null;
    }

    private async Task OnResetSubmit()
    {
        if (_resetTarget is null) return;
        _resetting = true;
        _resetError = null;
        try
        {
            var dto = await Api.ResetAccountPasswordAsync(_resetTarget.Id,
                new ResetPasswordRequest { NewPassword = _resetPassword });
            _actionInfo = T("accounts.info.reset", dto.Username);
            _resetTarget = null;
            await LoadPage(_result.Page);
        }
        catch (ApiException ex)
        {
            _resetError = T("accounts.error.modal", ex.ApiError.MessageEn, ex.ApiError.Code);
        }
        catch (Exception ex)
        {
            _resetError = T("accounts.error.generic", ex.GetType().Name, ex.Message);
        }
        finally
        {
            _resetting = false;
        }
    }
}
