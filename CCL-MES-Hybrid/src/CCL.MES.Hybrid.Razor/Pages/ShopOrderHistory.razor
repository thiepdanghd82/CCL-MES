@page "/shop-orders"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using System.Globalization
@using System.Text
@using CCL.MES.Shared.Machines
@inject ICclApiClient Api
@inject IJSRuntime JS

<PageTitle>@T("shoporders.pagetitle")</PageTitle>

@* P10.8 — SpecHub Shop-Order-History parity: forensic record of closed
   WOs (SHIPPED/CANCELLED) with 5 KPI tiles + per-WO runtime/setup/pause/OEE
   + Export CSV + period/status/customer/machine/search filters (server-side
   requery; KPIs + sidebar roll-ups reflect the filtered set) + sidebar
   (top customers/machines/downtime) + detail drawer. OEE is the honest
   A×P×Q (blank when not computable). *@
<div class="md-head">
    <div>
        <h1 class="page-title">📦 @T("shoporders.title")</h1>
        <div class="md-subtitle">@T("shoporders.subtitle", _data?.TotalWos ?? 0)</div>
    </div>
    <button type="button" class="md-refresh" @onclick="ExportCsvAsync" disabled="@(_data is null || _data.Rows.Count == 0)">📥 @T("shoporders.export.csv")</button>
</div>

<div class="md-kpi-grid soh-kpi-grid">
    <div class="md-kpi md-kpi-maint">
        <div class="md-kpi-label">@T("shoporders.kpi.totalwos")</div>
        <div class="md-kpi-num">@(_data?.TotalWos ?? 0)</div>
        <div class="md-kpi-oee-sub">@T("shoporders.kpi.totalwos.sub", _data?.StoppedCount ?? 0, _data?.DoneCount ?? 0)</div>
    </div>
    <div class="md-kpi md-kpi-running">
        <div class="md-kpi-label">@T("shoporders.kpi.output")</div>
        <div class="md-kpi-num">@((_data?.Output ?? 0).ToString("N0"))</div>
        <div class="md-kpi-oee-sub">@T("shoporders.kpi.output.sub", _data?.TotalWos ?? 0)</div>
    </div>
    <div class="md-kpi @YieldKpiClass">
        <div class="md-kpi-label">@T("shoporders.kpi.yield")</div>
        <div class="md-kpi-num">@(_data?.YieldPct ?? 0)%</div>
        <div class="md-kpi-oee-sub">@T("shoporders.kpi.yield.sub")</div>
    </div>
    <div class="md-kpi @OeeKpiClass">
        <div class="md-kpi-label">@T("shoporders.kpi.oee")</div>
        <div class="md-kpi-num">@(_data?.AvgOeePct is { } o ? $"{o}%" : "—")</div>
        <div class="md-kpi-oee-sub">@T("shoporders.kpi.oee.sub")</div>
    </div>
    <div class="md-kpi md-kpi-setup">
        <div class="md-kpi-label">@T("shoporders.kpi.reject")</div>
        <div class="md-kpi-num">@((_data?.Reject ?? 0).ToString("N0"))</div>
        <div class="md-kpi-oee-sub">@T("shoporders.kpi.reject.sub", DefectRate.ToString("0.00", CultureInfo.InvariantCulture))</div>
    </div>
</div>

<div class="md-filters soh-filters">
    <input class="md-search" type="text" placeholder="@T("shoporders.search.placeholder")"
           value="@_search" @onchange="OnSearchChanged" />
    <span class="md-filter-count">@T("shoporders.records", _data?.Rows.Count ?? 0)</span>
</div>
<div class="md-filters soh-filters-row">
    <span class="soh-filter-label">@T("shoporders.filter.period")</span>
    <div class="md-chips">
        @foreach (var p in PeriodChips)
        {
            <button type="button" class="md-chip @(_period == p.Key ? "md-chip-on" : "")"
                    @onclick="@(() => SetFilterAsync(() => _period = p.Key))">@p.Label</button>
        }
    </div>
    <span class="soh-filter-label">@T("shoporders.filter.status")</span>
    <div class="md-chips">
        @foreach (var s in StatusChips)
        {
            <button type="button" class="md-chip @(_status == s.Key ? "md-chip-on" : "")"
                    @onclick="@(() => SetFilterAsync(() => _status = s.Key))">@s.Label</button>
        }
    </div>
    <span class="soh-filter-label">@T("shoporders.filter.customer")</span>
    <select class="soh-select" value="@_customer" @onchange="OnCustomerChanged">
        <option value="">@T("shoporders.filter.allcustomers")</option>
        @foreach (var c in (_data?.Customers ?? Array.Empty<string>()))
        {
            <option value="@c">@c</option>
        }
    </select>
    <span class="soh-filter-label">@T("shoporders.filter.machine")</span>
    <select class="soh-select" value="@_machine" @onchange="OnMachineChanged">
        <option value="">@T("shoporders.filter.allmachines")</option>
        @foreach (var m in (_data?.Machines ?? Array.Empty<string>()))
        {
            <option value="@m">@m</option>
        }
    </select>
</div>

@if (_loading && _data is null)
{
    <p class="md-muted">@T("shoporders.loading")</p>
}
else if (_error is not null)
{
    <p class="md-error">@T("shoporders.error.load", _error)</p>
}
else if (_data is null || _data.Rows.Count == 0)
{
    <p class="md-muted">@T("shoporders.empty")</p>
}
else
{
    <div class="md-content">
        <div class="md-main">
            <div class="md-table-wrap">
                <table class="md-table soh-tbl">
                    <thead>
                        <tr>
                            <th>@T("shoporders.th.wocustomer")</th><th>@T("shoporders.th.product")</th><th>@T("shoporders.th.machine")</th>
                            <th class="num">@T("shoporders.th.outputplan")</th><th class="num">@T("shoporders.th.yield")</th><th class="num">@T("shoporders.th.oee")</th>
                            <th>@T("shoporders.th.runtime")</th><th>@T("shoporders.th.pauses")</th><th>@T("shoporders.th.finished")</th><th>@T("shoporders.th.status")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _data.Rows)
                        {
                            <tr class="md-row soh-trow @(_selected?.WoId == r.WoId ? "is-active" : "")" @onclick="@(() => _selected = r)">
                                <td class="soh-cell-wo">@r.WoNo<small>@r.CustomerName</small></td>
                                <td>@(r.ProductCode ?? "—")<small>@r.ProductName</small></td>
                                <td>@(r.MachineCode ?? "—")<small>@(r.Process ?? "")</small></td>
                                <td class="num soh-cell-qty">
                                    <strong>@r.QtyDone.ToString("N0")</strong><small>/ @r.TargetQty.ToString("N0")</small>
                                    <div class="soh-prog"><div class="soh-prog-fill" style="width:@r.ProgressPct%; background:@ProgressColor(r.ProgressPct)"></div></div>
                                </td>
                                <td class="num soh-yield @YieldClass(r.YieldPct)">@r.YieldPct%<small>@T("shoporders.cell.ng", r.QtyNg.ToString("N0"))</small></td>
                                <td class="num soh-yield @(r.OeePct is { } op ? YieldOeeClass(op) : "")">@(r.OeePct is { } o2 ? $"{o2}%" : "—")</td>
                                <td>@FormatDuration(r.RuntimeSec)<small>@T("shoporders.cell.setup", FormatDuration(r.SetupSec))</small></td>
                                <td>@r.PauseCount<small>@(r.PauseCount > 0 ? T("shoporders.cell.events") : "—")</small></td>
                                <td>@FormatRelative(r.FinishedAt)</td>
                                <td><StatusPill Phase="@r.MesPhase"
                                                Label="@(r.MesPhase == "CANCELLED" ? T("shoporders.status.stopped") : T("shoporders.status.done"))" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <aside class="md-side">
            <div class="md-side-card">
                <div class="md-side-head">🏢 @T("shoporders.side.topcustomers")</div>
                <div class="md-side-body">@RenderAgg(_data.TopCustomers, _data.TotalWos, "#2563eb", false)</div>
            </div>
            <div class="md-side-card">
                <div class="md-side-head">🏭 @T("shoporders.side.topmachines")</div>
                <div class="md-side-body">@RenderAgg(_data.TopMachines, _data.TotalWos, "#16a34a", true)</div>
            </div>
            <div class="md-side-card">
                <div class="md-side-head">⏸ @T("shoporders.side.topdowntime")</div>
                <div class="md-side-body">@RenderAgg(_data.TopDowntimeReasons, DowntimeTotal, "#f59e0b", false, label: true, pct: true)</div>
            </div>
            <div class="md-side-card soh-tip">
                <div class="md-side-head">💡 @T("shoporders.side.tip")</div>
                <div class="md-side-body soh-tip-body">
                    @T("shoporders.tip.row")<br />
                    @T("shoporders.tip.export")<br />
                    @T("shoporders.tip.filter")
                </div>
            </div>
        </aside>
    </div>
}

@* Row detail drawer (from the loaded row — no extra round-trip). *@
@if (_selected is not null)
{
    <div class="md-drawer-overlay" @onclick="@(() => _selected = null)"></div>
    <aside class="md-drawer soh-drawer">
        @* Hex thô trong inline style của .razor không lọt qua mắt gate-no-hardcoded-hex
           (gate chỉ quét app.css) — chuyển sang class có token. *@
        <div class="md-drawer-head soh-drawer-head" data-tone="@(_selected.MesPhase == "CANCELLED" ? "alarm" : "ok")">
            <div>
                <h2 class="md-drawer-title">@_selected.WoNo</h2>
                <div class="soh-drawer-sub">@_selected.CustomerName · @(_selected.ProductCode ?? "—") · @(_selected.MachineCode ?? "—")</div>
            </div>
            <button type="button" class="md-drawer-close" @onclick="@(() => _selected = null)">✕</button>
        </div>
        <div class="md-drawer-body">
            <h3 class="md-drawer-sub">@T("shoporders.drawer.finalsummary")</h3>
            <div class="md-kv"><span>@T("shoporders.drawer.status")</span><strong><span class="soh-status @(_selected.MesPhase == "CANCELLED" ? "stopped" : "done")">@(_selected.MesPhase == "CANCELLED" ? T("shoporders.status.stopped") : T("shoporders.status.done"))</span></strong></div>
            <div class="md-kv"><span>@T("shoporders.drawer.finished")</span><strong>@(_selected.FinishedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</strong></div>
            <div class="md-kv"><span>@T("shoporders.drawer.targetqty")</span><strong>@_selected.TargetQty.ToString("N0")</strong></div>
            <div class="md-kv"><span>@T("shoporders.drawer.actualoutput")</span><strong>@_selected.QtyDone.ToString("N0")</strong></div>
            <div class="md-kv"><span>@T("shoporders.drawer.reject")</span><strong>@_selected.QtyNg.ToString("N0")</strong></div>

            <h3 class="md-drawer-sub">@T("shoporders.drawer.perfmetrics")</h3>
            <div class="md-kv"><span>@T("shoporders.drawer.yield")</span><strong>@_selected.YieldPct%</strong></div>
            <div class="md-kv"><span>@T("shoporders.drawer.oee")</span><strong>@(_selected.OeePct is { } oeeV ? $"{oeeV}%" : T("shoporders.drawer.oee.none"))</strong></div>
            <div class="md-kv"><span>@T("shoporders.drawer.setuptime")</span><strong>@FormatDuration(_selected.SetupSec)</strong></div>
            <div class="md-kv"><span>@T("shoporders.drawer.totalruntime")</span><strong>@FormatDuration(_selected.RuntimeSec)</strong></div>
            <div class="md-kv"><span>@T("shoporders.drawer.pauses")</span><strong>@_selected.PauseCount</strong></div>

            @if (_selected.PauseReasons.Count > 0)
            {
                <h3 class="md-drawer-sub">⏸ @T("shoporders.drawer.downtimeevents", _selected.PauseCount)</h3>
                @foreach (var p in _selected.PauseReasons)
                {
                    <div class="md-kv"><span>@(p.Label ?? p.Key)</span><strong>@T("shoporders.drawer.eventcount", p.Count)</strong></div>
                }
            }
        </div>
    </aside>
}

@code {
    private ShopOrderHistoryDto? _data;
    private bool _loading = true;
    private string? _error;

    private string? _period;     // null = all
    private string? _status;     // null = all | "DONE" | "STOPPED"
    private string _customer = "";
    private string _machine = "";
    private string _search = "";

    private ShopOrderHistoryRow? _selected;

    private (string? Key, string Label)[] PeriodChips =>
    new (string? Key, string Label)[]
    {
        (null, T("shoporders.period.all")), ("today", T("shoporders.period.today")),
        ("7d", T("shoporders.period.7d")), ("30d", T("shoporders.period.30d")),
    };

    private (string? Key, string Label)[] StatusChips =>
    new (string? Key, string Label)[]
    {
        (null, T("shoporders.statuschip.all")), ("DONE", T("shoporders.status.done")),
        ("STOPPED", T("shoporders.status.stopped")),
    };

    private double DefectRate => _data is { Output: > 0 } ? 100.0 * _data.Reject / _data.Output : 0;
    private int DowntimeTotal => _data?.TopDowntimeReasons.Sum(r => r.Count) ?? 0;

    private string YieldKpiClass => (_data?.YieldPct ?? 0) >= 98 ? "md-kpi-running" : (_data?.YieldPct ?? 0) >= 95 ? "md-kpi-setup" : "md-kpi-down";
    private string OeeKpiClass => (_data?.AvgOeePct ?? 0) >= 75 ? "md-kpi-running" : (_data?.AvgOeePct ?? 0) >= 60 ? "md-kpi-setup" : "md-kpi-down";

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task SetFilterAsync(Action mutate)
    {
        mutate();
        await ReloadAsync();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        await ReloadAsync();
    }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        _customer = e.Value?.ToString() ?? "";
        await ReloadAsync();
    }

    private async Task OnMachineChanged(ChangeEventArgs e)
    {
        _machine = e.Value?.ToString() ?? "";
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await Api.GetShopOrderHistoryAsync(
                _period,
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                _status,
                string.IsNullOrWhiteSpace(_customer) ? null : _customer,
                string.IsNullOrWhiteSpace(_machine) ? null : _machine);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task ExportCsvAsync()
    {
        if (_data is null || _data.Rows.Count == 0) return;
        var sb = new StringBuilder();
        sb.AppendLine("wo,customer,product_code,product,machine,process,plan,output,ng,yield_pct,oee_pct,setup_sec,runtime_sec,pauses,status,finished");
        foreach (var r in _data.Rows)
        {
            string C(string? v) => v is null ? "" : (v.Contains(',') || v.Contains('"') || v.Contains('\n') ? $"\"{v.Replace("\"", "\"\"")}\"" : v);
            sb.Append(C(r.WoNo)).Append(',').Append(C(r.CustomerName)).Append(',').Append(C(r.ProductCode)).Append(',')
              .Append(C(r.ProductName)).Append(',').Append(C(r.MachineCode)).Append(',').Append(C(r.Process)).Append(',')
              .Append(r.TargetQty).Append(',').Append(r.QtyDone).Append(',').Append(r.QtyNg).Append(',')
              .Append(r.YieldPct).Append(',').Append(r.OeePct?.ToString() ?? "").Append(',')
              .Append(r.SetupSec).Append(',').Append(r.RuntimeSec).Append(',').Append(r.PauseCount).Append(',')
              .Append(r.MesPhase == "CANCELLED" ? "STOPPED" : "DONE").Append(',')
              .Append(r.FinishedAt?.ToString("yyyy-MM-dd HH:mm") ?? "").Append('\n');
        }
        var name = $"shop-order-history-{DateTime.Now:yyyy-MM-dd}.csv";
        try { await JS.InvokeVoidAsync("cclMesClipboard.download", name, sb.ToString(), "text/csv;charset=utf-8"); }
        catch { /* renderer-safe: a blocked download never bubbles */ }
    }

    private static string FormatDuration(long sec)
    {
        if (sec <= 0) return "—";
        var h = sec / 3600;
        var m = (sec % 3600) / 60;
        return h > 0 ? $"{h}h{m:D2}m" : $"{m}m";
    }

    private static string FormatRelative(DateTime? at)
    {
        if (at is null) return "—";
        var diff = DateTime.UtcNow - at.Value.ToUniversalTime();
        if (diff.TotalHours < 1) return "just now";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return at.Value.ToLocalTime().ToString("dd/MM/yy");
    }

    private static string ProgressColor(int pct) => pct >= 95 ? "#16a34a" : pct >= 80 ? "#f59e0b" : "#dc2626";
    private static string YieldClass(int pct) => pct >= 98 ? "soh-good" : pct >= 95 ? "soh-warn" : "soh-bad";
    private static string YieldOeeClass(int pct) => pct >= 75 ? "soh-good" : pct >= 60 ? "soh-warn" : "soh-bad";

    private RenderFragment RenderAgg(IReadOnlyList<ShopOrderAggRow> rows, int total, string color, bool mono,
        bool label = false, bool pct = false) => builder =>
    {
        if (rows.Count == 0)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "md-side-empty");
            builder.AddContent(2, pct ? T("shoporders.side.nopauses") : T("shoporders.side.nodata"));
            builder.CloseElement();
            return;
        }
        var denom = total <= 0 ? 1 : total;
        var seq = 0;
        foreach (var r in rows)
        {
            var width = Math.Min(100, 100.0 * r.Count / denom);
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "soh-side-row");

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", mono ? "soh-side-key mono" : "soh-side-key");
            builder.AddContent(seq++, label ? (r.Label ?? r.Key) : r.Key);
            builder.CloseElement();

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "soh-side-bar");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "soh-side-bar-fill");
            builder.AddAttribute(seq++, "style", $"width:{width.ToString("0.#", CultureInfo.InvariantCulture)}%; background:{color}");
            builder.CloseElement();
            builder.CloseElement();

            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, pct ? $"{r.Count} ({(100.0 * r.Count / denom).ToString("0", CultureInfo.InvariantCulture)}%)" : r.Count.ToString());
            builder.CloseElement();

            builder.CloseElement();
        }
    };
}
