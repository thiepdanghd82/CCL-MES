@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@using System.Security.Claims
@using CCL.MES.Shared.Home
@inject IAuthSession Session
@inject ICclApiClient Api

<PageTitle>Trang chủ — CCL MES</PageTitle>

@* P10.10 — Home dashboard, SpecHub-style: greeting + live clock + 4 KPI
   cards (accent border + subtitle) + Today's Focus + Modules grid +
   Quick Actions. *@
<div class="hp-header">
    <div>
        <h1 class="page-title">@_greeting, @(_displayName)</h1>
        <div class="hp-sub">
            @_now.ToString("dddd, dd/MM/yyyy") · CCL Design Vietnam
            <span class="hp-badge">@_role</span>
        </div>
    </div>
    <div class="home-clock" aria-label="Đồng hồ hệ thống">
        <div class="home-clock-time">@_now.ToString("h:mm")</div>
        <div class="home-clock-date">@_now.ToString("tt") · @_now.ToString("HH:mm:ss")</div>
    </div>
</div>

<div class="kpi-row">
    <div class="kpi-card kpi-blue">
        <div class="kpi-label">Spec trong thư viện</div>
        <div class="home-kpi-num">@KpiText(_summary?.SpecsTotal)</div>
        <div class="kpi-sub">tổng số revision đang lưu</div>
    </div>
    <div class="kpi-card kpi-amber">
        <div class="kpi-label">Chờ duyệt</div>
        <div class="home-kpi-num">@KpiText(_summary?.PendingApprovals)</div>
        <div class="kpi-sub">@PendingSub</div>
    </div>
    <div class="kpi-card kpi-red">
        <div class="kpi-label">Bản nháp</div>
        <div class="home-kpi-num">@KpiText(_summary?.Drafts)</div>
        <div class="kpi-sub">@DraftsSub</div>
    </div>
    <div class="kpi-card kpi-green">
        <div class="kpi-label">Hoạt động hôm nay</div>
        <div class="home-kpi-num">@KpiText(_summary?.TodayActivity)</div>
        <div class="kpi-sub">@TodaySub</div>
    </div>
</div>

<div class="hp-grid">
    <section class="panel">
        <div class="panel-head">
            <span>Hôm nay cần chú ý</span>
            @if (_canNpi)
            {
                <a class="panel-link" href="/npi/specs">Xem tất cả →</a>
            }
        </div>
        <div class="panel-body hp-focus-empty">
            @if (_canNpi)
            {
                <text>Thư viện đang trống. Mở phân hệ NPI để nạp mẫu hoặc import xlsx ☕</text>
            }
            else
            {
                <text>Chưa có mục nào cần chú ý hôm nay ☕</text>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-head"><span>Phân hệ</span></div>
        <div class="module-grid">
            @if (_canNpi)
            {
                <a class="module-cell" href="/npi/specs">
                    <div class="module-ico">📋</div>
                    <div class="module-name">Engineer Spec</div>
                    <div class="module-desc">Thư viện NPI Spec</div>
                </a>
                <a class="module-cell" href="/npi/workcenters">
                    <div class="module-ico">🗂️</div>
                    <div class="module-name">NPI Data</div>
                    <div class="module-desc">BOM / Routing / Vật liệu / WC</div>
                </a>
            }
            @if (_canRun)
            {
                <a class="module-cell" href="/workorders">
                    <div class="module-ico">🏭</div>
                    <div class="module-name">Sản xuất</div>
                    <div class="module-desc">Quét WO · luồng MES 5 GĐ</div>
                </a>
            }
            <a class="module-cell" href="/machines">
                <div class="module-ico">🖥️</div>
                <div class="module-name">Bảng máy</div>
                <div class="module-desc">Giám sát 43 trung tâm SX</div>
            </a>
            <a class="module-cell" href="/settings">
                <div class="module-ico">⚙️</div>
                <div class="module-name">Cài đặt</div>
                <div class="module-desc">Hồ sơ / tài khoản / nhật ký</div>
            </a>
        </div>
    </section>
</div>

<section class="panel">
    <div class="panel-head"><span>Thao tác nhanh</span></div>
    <div class="qa-row">
        @if (_canNpi)
        {
            <a class="qa-cell" href="/npi/specs"><div class="qa-ico">＋</div><div class="qa-lbl">Spec mới</div></a>
            <a class="qa-cell" href="/npi/specs"><div class="qa-ico">⭱</div><div class="qa-lbl">Import xlsx</div></a>
        }
        <a class="qa-cell" href="/machines"><div class="qa-ico">🖥️</div><div class="qa-lbl">Bảng máy</div></a>
        <a class="qa-cell" href="/qms"><div class="qa-ico">✓</div><div class="qa-lbl">Hàng đợi QC</div></a>
        <a class="qa-cell" href="/shop-orders"><div class="qa-ico">🗂️</div><div class="qa-lbl">Lịch sử SX</div></a>
        @if (_isAdmin)
        {
            <a class="qa-cell" href="/settings/accounts"><div class="qa-ico">👥</div><div class="qa-lbl">Tài khoản</div></a>
        }
        <a class="qa-cell" href="/settings/about"><div class="qa-ico">?</div><div class="qa-lbl">Trợ giúp</div></a>
    </div>
</section>

@code {
    private string _displayName = "";
    private string _greeting = "Xin chào";
    private string _role = "";
    private DateTime _now = DateTime.Now;
    private System.Threading.Timer? _clock;

    private bool _canNpi;
    private bool _canRun;
    private bool _isAdmin;
    private HomeSummaryDto? _summary;

    private static string KpiText(int? n) => n?.ToString() ?? "—";
    private string PendingSub => (_summary?.PendingApprovals ?? 0) == 0 ? "— không có chờ duyệt" : "cần duyệt";
    private string DraftsSub => (_summary?.Drafts ?? 0) == 0 ? "— chưa có bản nháp" : "đang soạn";
    private string TodaySub => (_summary?.TodayActivity ?? 0) == 0 ? "— ngày yên ắng" : "WO chạm hôm nay";

    protected override async Task OnInitializedAsync()
    {
        try { _summary = await Api.GetHomeSummaryAsync(); }
        catch { _summary = null; }
    }

    protected override void OnInitialized()
    {
        var u = Session.CurrentUser;
        _displayName = u.FindFirst("display_name")?.Value
            ?? u.Identity?.Name
            ?? "operator";
        _role = u.FindFirst(ClaimTypes.Role)?.Value ?? "";

        // NOTE: if-chain, not a relational-pattern switch — a switch arm
        // beginning with '<' breaks the Razor compiler (SDK 10.0.x, RZ1006).
        var hour = _now.Hour;
        if (hour < 12) _greeting = "Chào buổi sáng";
        else if (hour < 18) _greeting = "Chào buổi chiều";
        else _greeting = "Chào buổi tối";

        _isAdmin = u.IsInRole("Admin");
        _canNpi = _isAdmin || u.IsInRole("Supervisor") || u.IsInRole("Engineer") || u.IsInRole("QC");
        _canRun = _isAdmin || u.IsInRole("Supervisor") || u.IsInRole("Operator") || u.IsInRole("QC");

        _clock = new System.Threading.Timer(_ =>
        {
            _now = DateTime.Now;
            _ = InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    public void Dispose() => _clock?.Dispose();
}
