@page "/qms"
@page "/qms/fqc"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Qms
@inject ICclApiClient Api
@inject NavigationManager Nav

<PageTitle>@T("qms.pagetitle") — CCL MES</PageTitle>

<div class="md-head">
    <h1 class="page-title">@TitleText</h1>
    <button type="button" class="md-refresh" @onclick="ReloadAsync" disabled="@_loading">
        @(_loading ? T("qms.loading") : "↻ " + T("qms.refresh"))
    </button>
</div>

@* P10.9 — Inspection Queue: WOs due for each QC stage, auto-built from
   MesPhase (IPQC_WAIT / FQC_PENDING / OQC_PENDING). The actual capture
   happens on the per-WO QC dashboards. QC History lands in slice 2. *@
@if (_loading && _data is null)
{
    <p class="md-muted">@T("qms.loading.queue")</p>
}
else if (_error is not null)
{
    <p class="md-error">@T("qms.load.failed", _error)</p>
}
else if (_data is not null)
{
    @* /qms shows all three stage tabs; the stage-scoped routes
       (/qms/ipqc · /qms/fqc · /qms/oqc) lock to a single stage and hide the
       switcher so each acts as a standalone per-stage worklist. *@
    @if (_lockedStage is null)
    {
        <div class="md-chips qms-tabs">
            <button type="button" class="md-chip @(_stage == "ipqc" ? "md-chip-on" : "")"
                    @onclick="@(() => _stage = "ipqc")">IPQC (@_data.IpqcCount)</button>
            <button type="button" class="md-chip @(_stage == "fqc" ? "md-chip-on" : "")"
                    @onclick="@(() => _stage = "fqc")">FQC (@_data.FqcCount)</button>
            <button type="button" class="md-chip @(_stage == "oqc" ? "md-chip-on" : "")"
                    @onclick="@(() => _stage = "oqc")">OQC (@_data.OqcCount)</button>
        </div>
    }
    else
    {
        <div class="md-chips qms-tabs">
            <span class="md-chip md-chip-on">@StageLabel (@CurrentRows.Count)</span>
        </div>
    }

    @if (CurrentRows.Count == 0)
    {
        <p class="md-muted">@T("qms.empty", StageLabel)</p>
    }
    else
    {
        <div class="md-table-wrap">
            <table class="md-table">
                <thead>
                    <tr><th>WO</th><th>@T("qms.col.product")</th><th>@T("qms.col.machine")</th><th>@T("qms.col.plandone")</th><th>@T("qms.col.waitingsince")</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in CurrentRows)
                    {
                        <tr>
                            <td class="md-code">@r.WoNo</td>
                            <td>@r.ProductName</td>
                            <td>@(r.MachineCode ?? "—")</td>
                            <td>@r.TargetQty / @r.QtyDone</td>
                            <td>@(r.UpdatedAt?.ToString("dd/MM HH:mm") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private QmsQueueDto? _data;
    private bool _loading = true;
    private string? _error;
    private string _stage = "ipqc";   // ipqc | fqc | oqc

    // Non-null when the active route is a stage-scoped queue
    // (/qms/ipqc · /qms/fqc · /qms/oqc). Null on the plain /qms hub.
    private string? _lockedStage;

    // Re-evaluated on every navigation (Blazor reuses the instance across the
    // sibling routes), so switching /qms/ipqc ↔ /qms/fqc re-locks correctly
    // without a data reload.
    protected override void OnParametersSet()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        _lockedStage = path switch
        {
            "qms/fqc" => "fqc",
            _ => null,   // "qms" → hub with all tabs
        };
        if (_lockedStage is not null)
            _stage = _lockedStage;
    }

    private IReadOnlyList<QmsQueueRow> CurrentRows => _stage switch
    {
        "fqc" => _data?.Fqc ?? Array.Empty<QmsQueueRow>(),
        "oqc" => _data?.Oqc ?? Array.Empty<QmsQueueRow>(),
        _ => _data?.Ipqc ?? Array.Empty<QmsQueueRow>(),
    };

    // Route /qms/fqc dùng CHUNG component với hub /qms, nhưng trước đây tiêu đề
    // hardcode một chuỗi ⇒ bấm "FQC — Final" ở rail vẫn hiện "Hàng chờ kiểm
    // (QMS)". Người dùng không có cách nào biết mình đang ở danh sách nào.
    private string TitleText =>
        _lockedStage is null ? T("qms.title") : $"{T("qms.title")} · {StageLabel}";

    private string StageLabel => _stage switch
    {
        "fqc" => "FQC",
        "oqc" => "OQC",
        _ => "IPQC",
    };

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try { _data = await Api.GetQmsQueueAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
