@page "/settings/about"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ICclApiClient Api
@using CCL.MES.Hybrid.Client.Specs

@*
  P10.6d — About page. Server build / runtime / DB inventory + storage
  snapshot. Read-only; no form fields, no mutation. Self-service for
  every authenticated role.
*@

<PageTitle>Về ứng dụng — CCL MES</PageTitle>

<div class="settings-page-header">
    <a class="grid-btn grid-btn-link" href="/settings">‹ Cài đặt</a>
    <h1 class="page-title">Về ứng dụng</h1>
</div>

@if (_loading)
{
    <p class="grid-status">Đang tải thông tin máy chủ…</p>
}
else if (_loadError is not null)
{
    <div class="grid-error" role="alert">
        <strong>Không tải được About.</strong>
        <div>@_loadError</div>
        <button type="button" class="grid-btn" @onclick="LoadAsync">Thử lại</button>
    </div>
}
else if (_about is not null)
{
    <section class="settings-form-card">
        <h2 class="settings-group-title">Máy chủ</h2>
        <dl class="settings-meta">
            <div><dt>Phiên bản</dt><dd>@_about.ServerVersion</dd></div>
            @if (!string.IsNullOrWhiteSpace(_about.InformationalVersion))
            {
                <div><dt>Build</dt><dd>@_about.InformationalVersion</dd></div>
            }
            <div><dt>Môi trường</dt><dd>@_about.EnvironmentName</dd></div>
            <div><dt>Máy chủ</dt><dd>@_about.MachineName</dd></div>
            <div><dt>Giờ máy chủ (UTC)</dt><dd>@_about.ServerTimeUtc.ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
        </dl>
    </section>

    <section class="settings-form-card" style="margin-top:16px">
        <h2 class="settings-group-title">Dữ liệu</h2>
        <dl class="settings-meta">
            <div><dt>Người dùng</dt><dd>@_about.UserCount</dd></div>
            <div><dt>Khách hàng</dt><dd>@_about.CustomerCount</dd></div>
            <div><dt>Sản phẩm</dt><dd>@_about.ProductCount</dd></div>
            <div><dt>Phiên bản Spec</dt><dd>@_about.SpecRevisionCount</dd></div>
            <div><dt>Phiên bản bản vẽ</dt><dd>@_about.DrawingVersionCount</dd></div>
            <div><dt>Bản ghi nhật ký</dt><dd>@_about.AuditEntryCount</dd></div>
        </dl>
    </section>

    <section class="settings-form-card" style="margin-top:16px">
        <h2 class="settings-group-title">Bộ nhớ trên ổ đĩa</h2>
        <dl class="settings-meta">
            <div><dt>Cơ sở dữ liệu</dt><dd>@FormatBytes(_about.DbFileBytes)</dd></div>
            <div><dt>Kho bản vẽ</dt><dd>@FormatBytes(_about.BlobStoreBytes)</dd></div>
            @if (!string.IsNullOrWhiteSpace(_about.DataDir))
            {
                <div><dt>Thư mục dữ liệu</dt><dd><code>@_about.DataDir</code></dd></div>
            }
        </dl>
    </section>

    <p class="settings-hint" style="margin-top:14px">
        Phiên bản ứng dụng Catalyst hiển thị trong Cài đặt → Chế độ
        kết nối.
    </p>
}

@code {
    private CCL.MES.Shared.Settings.AboutDto? _about;
    private bool _loading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _about = await Api.GetAboutAsync();
        }
        catch (ApiException apiEx)
        {
            _loadError = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
        }
        catch (HttpRequestException ex)
        {
            _loadError = $"Không kết nối được máy chủ: {ex.Message}";
        }
        catch (Exception ex)
        {
            _loadError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatBytes(long? bytes) => bytes switch
    {
        null => "—",
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        < 1024L * 1024 * 1024 => $"{bytes / 1024.0 / 1024.0:F1} MB",
        _ => $"{bytes / 1024.0 / 1024.0 / 1024.0:F2} GB",
    };
}
