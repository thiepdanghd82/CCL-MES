@page "/settings/about"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ICclApiClient Api
@using CCL.MES.Hybrid.Client.Specs

@*
  P10.6d — About page. Server build / runtime / DB inventory + storage
  snapshot. Read-only; no form fields, no mutation. Self-service for
  every authenticated role.
*@

<PageTitle>About — CCL MES</PageTitle>

<div class="settings-page-header">
    <a class="grid-btn grid-btn-link" href="/settings">‹ Settings</a>
    <h1 class="page-title">About</h1>
</div>

@if (_loading)
{
    <p class="grid-status">Loading server information…</p>
}
else if (_loadError is not null)
{
    <div class="grid-error" role="alert">
        <strong>Failed to load About.</strong>
        <div>@_loadError</div>
        <button type="button" class="grid-btn" @onclick="LoadAsync">Try again</button>
    </div>
}
else if (_about is not null)
{
    <section class="settings-form-card">
        <h2 class="settings-group-title">Server</h2>
        <dl class="settings-meta">
            <div><dt>Version</dt><dd>@_about.ServerVersion</dd></div>
            @if (!string.IsNullOrWhiteSpace(_about.InformationalVersion))
            {
                <div><dt>Build</dt><dd>@_about.InformationalVersion</dd></div>
            }
            <div><dt>Environment</dt><dd>@_about.EnvironmentName</dd></div>
            <div><dt>Server</dt><dd>@_about.MachineName</dd></div>
            <div><dt>Server time (UTC)</dt><dd>@_about.ServerTimeUtc.ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
        </dl>
    </section>

    <section class="settings-form-card" style="margin-top:16px">
        <h2 class="settings-group-title">Data</h2>
        <dl class="settings-meta">
            <div><dt>Users</dt><dd>@_about.UserCount</dd></div>
            <div><dt>Customers</dt><dd>@_about.CustomerCount</dd></div>
            <div><dt>Products</dt><dd>@_about.ProductCount</dd></div>
            <div><dt>Spec revisions</dt><dd>@_about.SpecRevisionCount</dd></div>
            <div><dt>Drawing versions</dt><dd>@_about.DrawingVersionCount</dd></div>
            <div><dt>Audit entries</dt><dd>@_about.AuditEntryCount</dd></div>
        </dl>
    </section>

    <section class="settings-form-card" style="margin-top:16px">
        <h2 class="settings-group-title">On-disk storage</h2>
        <dl class="settings-meta">
            <div><dt>Database</dt><dd>@FormatBytes(_about.DbFileBytes)</dd></div>
            <div><dt>Drawing store</dt><dd>@FormatBytes(_about.BlobStoreBytes)</dd></div>
            @if (!string.IsNullOrWhiteSpace(_about.DataDir))
            {
                <div><dt>Data directory</dt><dd><code>@_about.DataDir</code></dd></div>
            }
        </dl>
    </section>

    <p class="settings-hint" style="margin-top:14px">
        The Catalyst app version is shown in Settings → Connection.
    </p>
}

@code {
    private CCL.MES.Shared.Settings.AboutDto? _about;
    private bool _loading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _about = await Api.GetAboutAsync();
        }
        catch (ApiException apiEx)
        {
            _loadError = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
        }
        catch (HttpRequestException ex)
        {
            _loadError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _loadError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatBytes(long? bytes) => bytes switch
    {
        null => "—",
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        < 1024L * 1024 * 1024 => $"{bytes / 1024.0 / 1024.0:F1} MB",
        _ => $"{bytes / 1024.0 / 1024.0 / 1024.0:F2} GB",
    };
}
