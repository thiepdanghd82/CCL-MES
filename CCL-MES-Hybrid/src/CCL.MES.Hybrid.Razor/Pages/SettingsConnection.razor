@page "/settings/connection"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Microsoft.Extensions.Options.IOptions<CCL.MES.Hybrid.Client.ApiClientOptions> Opts
@inject CCL.MES.Hybrid.Client.Hardware.IDeviceModeService Device
@inject CCL.MES.Hybrid.Client.Connectivity.IConnectivityMonitor Monitor
@inject Microsoft.Extensions.Options.IOptions<CCL.MES.Hybrid.Client.Hardware.HardwareOptions> HwOptions
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase

@*
  P10.6d — Connection Mode page. READ-ONLY summary card pointing at
  /mode (P10.3 W1) for actual change. Per Henry's "tái dùng /mode +
  /hardware — không build trùng" instruction: this page does NOT host
  the kiosk toggle or passcode setup; it just surfaces current state
  + sends the operator over to the existing pages.

  Surfaces 4 things:
    1. Base URL of the API the client talks to (from ApiClientOptions).
    2. Current connectivity state (online / offline) via
       IConnectivityMonitor.
    3. Current device mode (Interactive / Kiosk) + DeviceId.
    4. Action link to /mode for change (Admin/Supervisor only).
*@

<PageTitle>@T("connection.pagetitle")</PageTitle>

<div class="settings-page-header">
    <a class="grid-btn grid-btn-link" href="/settings">@T("common.back.settings")</a>
    <h1 class="page-title">@T("connection.title")</h1>
</div>

<section class="settings-form-card">
    <h2 class="settings-group-title">@T("connection.server.title")</h2>
    <dl class="settings-meta">
        <div><dt>@T("connection.server.apiaddress")</dt><dd><code>@Opts.Value.BaseUrl</code></dd></div>
        <div>
            <dt>@T("connection.server.status")</dt>
            <dd>
                <span class="conn-dot @(_isConnected ? "is-up" : "is-down")"></span>
                @(_isConnected ? T("connection.server.connected") : T("connection.server.disconnected"))
            </dd>
        </div>
    </dl>
</section>

<section class="settings-form-card" style="margin-top:16px">
    <h2 class="settings-group-title">@T("connection.station.title")</h2>
    <dl class="settings-meta">
        <div>
            <dt>@T("connection.station.mode")</dt>
            <dd>
                @if (Device.CurrentMode == CCL.MES.Shared.Hardware.DeviceMode.Kiosk)
                {
                    <span>@T("connection.station.mode.kiosk")</span>
                }
                else
                {
                    <span>@T("connection.station.mode.interactive")</span>
                }
            </dd>
        </div>
        <div><dt>@T("connection.station.deviceid")</dt><dd><code>@Device.DeviceId</code></dd></div>
        <div>
            <dt>@T("connection.station.hardware")</dt>
            <dd>@(HwOptions.Value.ScanEnabled ? T("connection.station.hardware.on") : T("connection.station.hardware.off"))</dd>
        </div>
    </dl>

    <AuthorizeView Roles="Admin,Supervisor">
        <div class="settings-actions">
            <a class="grid-btn grid-btn-secondary" href="/mode">@T("connection.action.changemode")</a>
            <a class="grid-btn" href="/hardware" style="margin-left:8px">@T("connection.action.configuredevices")</a>
        </div>
    </AuthorizeView>
</section>

@code {
    private bool _isConnected;

    protected override void OnInitialized()
    {
        base.OnInitialized(); // subscribe to language changes (LocalizedComponentBase)
        _isConnected = Monitor.IsConnected;
        Monitor.ConnectivityChanged += Handle;
    }

    private void Handle(bool isConnected)
    {
        _isConnected = isConnected;
        InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        Monitor.ConnectivityChanged -= Handle;
        base.Dispose(); // unsubscribe
    }
}
