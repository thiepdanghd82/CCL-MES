@page "/settings/connection"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Microsoft.Extensions.Options.IOptions<CCL.MES.Hybrid.Client.ApiClientOptions> Opts
@inject CCL.MES.Hybrid.Client.Hardware.IDeviceModeService Device
@inject CCL.MES.Hybrid.Client.Connectivity.IConnectivityMonitor Monitor
@inject Microsoft.Extensions.Options.IOptions<CCL.MES.Hybrid.Client.Hardware.HardwareOptions> HwOptions
@implements IDisposable

@*
  P10.6d — Connection Mode page. READ-ONLY summary card pointing at
  /mode (P10.3 W1) for actual change. Per Henry's "tái dùng /mode +
  /hardware — không build trùng" instruction: this page does NOT host
  the kiosk toggle or passcode setup; it just surfaces current state
  + sends the operator over to the existing pages.

  Surfaces 4 things:
    1. Base URL of the API the client talks to (from ApiClientOptions).
    2. Current connectivity state (online / offline) via
       IConnectivityMonitor.
    3. Current device mode (Interactive / Kiosk) + DeviceId.
    4. Action link to /mode for change (Admin/Supervisor only).
*@

<PageTitle>Connection — CCL MES</PageTitle>

<div class="settings-page-header">
    <a class="grid-btn grid-btn-link" href="/settings">‹ Settings</a>
    <h1 class="page-title">Connection</h1>
</div>

<section class="settings-form-card">
    <h2 class="settings-group-title">Server</h2>
    <dl class="settings-meta">
        <div><dt>API address</dt><dd><code>@Opts.Value.BaseUrl</code></dd></div>
        <div>
            <dt>Connection status</dt>
            <dd>
                <span class="conn-dot @(_isConnected ? "is-up" : "is-down")"></span>
                @(_isConnected ? "Connected — ready to sign in and read data." : "Disconnected — the UI will wait for the network to load data.")
            </dd>
        </div>
    </dl>
</section>

<section class="settings-form-card" style="margin-top:16px">
    <h2 class="settings-group-title">Station</h2>
    <dl class="settings-meta">
        <div>
            <dt>Station mode</dt>
            <dd>
                @if (Device.CurrentMode == CCL.MES.Shared.Hardware.DeviceMode.Kiosk)
                {
                    <span>Kiosk — locked to the Work Orders screen.</span>
                }
                else
                {
                    <span>Interactive — full menu for operator + admin.</span>
                }
            </dd>
        </div>
        <div><dt>Device ID</dt><dd><code>@Device.DeviceId</code></dd></div>
        <div>
            <dt>Hardware features</dt>
            <dd>@(HwOptions.Value.ScanEnabled ? "On (P10.3 W1)" : "Off")</dd>
        </div>
    </dl>

    <AuthorizeView Roles="Admin,Supervisor">
        <div class="settings-actions">
            <a class="grid-btn grid-btn-secondary" href="/mode">Change station mode</a>
            <a class="grid-btn" href="/hardware" style="margin-left:8px">Configure devices</a>
        </div>
    </AuthorizeView>
</section>

@code {
    private bool _isConnected;

    protected override void OnInitialized()
    {
        _isConnected = Monitor.IsConnected;
        Monitor.ConnectivityChanged += Handle;
    }

    private void Handle(bool isConnected)
    {
        _isConnected = isConnected;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Monitor.ConnectivityChanged -= Handle;
    }
}
