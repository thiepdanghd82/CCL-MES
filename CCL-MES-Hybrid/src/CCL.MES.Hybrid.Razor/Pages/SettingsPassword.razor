@page "/settings/password"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ICclApiClient Api
@inject NavigationManager Nav
@using CCL.MES.Hybrid.Client.Specs

@*
  P10.6a — My Password change. Three fields (current / new / confirm)
  with client-side pre-check (matches confirm, min 4 chars) before
  POSTing /settings/password. Server enforces the same rules — if the
  client check is bypassed via the API directly, the auth.new_too_short
  / auth.missing_fields codes still surface here via the VN mapper.

  Confirm field is client-side ONLY (never posted) so the server
  contract stays minimal.
*@

<PageTitle>Change Password — CCL MES</PageTitle>

<div class="settings-page-header">
    <a class="grid-btn grid-btn-link" href="/settings">‹ Settings</a>
    <h1 class="page-title">Change Password</h1>
</div>

<section class="settings-form-card">
    @* P10.6a hotfix — see SettingsProfile.razor comment for the
       InputText  bind-Value-event-oninput  regression that forced
       the switch to plain HTML input. *@
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true" name="password">
        <div class="settings-field">
            <label for="pwd-current">Current password</label>
            <input id="pwd-current" type="password" class="settings-input"
                   tabindex="1"
                   @bind="_form.CurrentPassword" @bind:event="oninput"
                   @onkeydown="OnFieldKeyDown"
                   autocomplete="current-password" />
        </div>
        <div class="settings-field">
            <label for="pwd-new">New password</label>
            <input id="pwd-new" type="password" class="settings-input"
                   tabindex="2"
                   @bind="_form.NewPassword" @bind:event="oninput"
                   @onkeydown="OnFieldKeyDown"
                   autocomplete="new-password" />
            <span class="settings-hint">At least 4 characters.</span>
        </div>
        <div class="settings-field">
            <label for="pwd-confirm">Confirm new password</label>
            <input id="pwd-confirm" type="password" class="settings-input"
                   tabindex="3"
                   @bind="_form.ConfirmPassword" @bind:event="oninput"
                   @onkeydown="OnFieldKeyDown"
                   autocomplete="new-password" />
        </div>

        @if (_banner is not null)
        {
            <div class="settings-banner @($"is-{_bannerKind}")" role="status">@_banner</div>
        }

        <div class="settings-actions">
            <button type="submit" class="grid-btn grid-btn-primary"
                    tabindex="4"
                    disabled="@_submitting" @onclick="SubmitAsync">
                @(_submitting ? "Changing…" : "Change Password")
            </button>
        </div>
    </form>
</section>

@code {
    private bool _submitting;
    private string? _banner;
    private string _bannerKind = "info";
    private PasswordForm _form = new();

    private async Task SubmitAsync()
    {
        if (_submitting) return;
        _banner = null;

        // Client-side pre-checks. Server enforces these too; surfacing
        // here saves a round-trip + the operator gets a faster signal.
        if (string.IsNullOrWhiteSpace(_form.CurrentPassword)
            || string.IsNullOrWhiteSpace(_form.NewPassword)
            || string.IsNullOrWhiteSpace(_form.ConfirmPassword))
        {
            _banner = "Please fill in all fields.";
            _bannerKind = "danger";
            return;
        }
        if (_form.NewPassword.Length < 4)
        {
            _banner = "The new password must be at least 4 characters.";
            _bannerKind = "danger";
            return;
        }
        if (!string.Equals(_form.NewPassword, _form.ConfirmPassword, StringComparison.Ordinal))
        {
            _banner = "The new password and confirmation do not match.";
            _bannerKind = "danger";
            return;
        }

        _submitting = true;
        try
        {
            var req = new CCL.MES.Shared.Settings.ChangePasswordRequest
            {
                CurrentPassword = _form.CurrentPassword,
                NewPassword = _form.NewPassword,
            };
            await Api.ChangeMyPasswordAsync(req);
            _banner = "✓ Password changed. Use the new password the next time you sign in.";
            _bannerKind = "success";
            // Clear the form so the cleartext doesn't sit in memory
            // longer than needed. The operator stays on the page.
            _form = new PasswordForm();
        }
        catch (ApiException apiEx)
        {
            _banner = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _bannerKind = "danger";
        }
        catch (HttpRequestException ex)
        {
            _banner = $"Could not connect to the server: {ex.Message}";
            _bannerKind = "danger";
        }
        catch (Exception ex)
        {
            _banner = $"Password change failed: {ex.Message}";
            _bannerKind = "danger";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task OnFieldKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitAsync();
        }
    }

    private sealed class PasswordForm
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
