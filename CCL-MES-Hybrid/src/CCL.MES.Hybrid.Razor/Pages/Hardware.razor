@page "/hardware"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor,Engineer")]
@using CCL.MES.Hybrid.Client.Hardware
@using CCL.MES.Shared.Hardware
@inject Microsoft.Extensions.Options.IOptions<HardwareOptions> HwOptions
@inject IBarcodeScannerService Scanner
@inject ILabelPrinterService Printer
@inject IWeighScaleService Scale
@inject IDeviceModeService Device

<PageTitle>Hardware — CCL MES</PageTitle>

@*
    W1 page skeleton. The three hardware blocks render their availability
    status driven by IsAvailableAsync() so the page is correct whether
    the feature flag is off (everything says "feature_disabled"), the
    real impl isn't shipped yet (printer + scale say "not_implemented"),
    or a real impl is registered (W2/W3 Catalyst+Windows scanner).
    Test-connection buttons + actual scan modal land in W2/W3. The
    layout is final; only the wiring is incomplete.
*@

<h1 class="page-title">Device Configuration</h1>

@if (!HwOptions.Value.ScanEnabled)
{
    <div class="hw-gate" role="status">
        <strong>Hardware features are turned off.</strong>
        <p>
            P10.3 (Hardware native) is at phase W1 — interface + stub are ready,
            but the real device interface turns on in later phases (W2 = camera
            Mac Catalyst, W3 = camera Windows + USB-HID, W4 = wire into WO Accept
            + /mode kiosk). Turn it on by setting
            <code>Hardware:ScanEnabled = true</code> in
            <code>appsettings.json</code> or an env override.
        </p>
        <p>Device id of this station: <code>@Device.DeviceId</code></p>
    </div>
}
else
{
    <p>Station: <code>@Device.DeviceId</code></p>

    <section class="hw-section">
        <h2>Scanner</h2>
        <ScannerTestPanel />
    </section>

    <section class="hw-section">
        <h2>Label Printer</h2>
        <HardwareAvailabilityRow Probe="@(() => Printer.IsAvailableAsync())"
                                 Title="Label Printer (ZPL)"
                                 EnabledAction="(Stub — available once the label printing workflow is approved)" />
    </section>

    <section class="hw-section">
        <h2>Scale</h2>
        <HardwareAvailabilityRow Probe="@(() => Scale.IsAvailableAsync())"
                                 Title="Electronic Scale"
                                 EnabledAction="(Stub — available once the weighing workflow is approved)" />
    </section>
}

@code {
    // W4 will add: TEST SCAN button (opens scanner modal), heartbeat call
    // to /api/v2/devices/{id}/heartbeat, and the per-station scanner-
    // source picker (camera | usb-hid | wedge). Page reacts to OnChange
    // on IDeviceModeService for live updates when /mode is open in a
    // companion window.
}
