@page "/qms/iqc"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Quality
@inject ICclApiClient Api
@inject CCL.MES.Hybrid.Client.Auth.IAuthSession Session

@* IQC — incoming raw-material inspection. Header shows the 9 real ticket
   fields (feat/iqc-ticket); "Add ticket" opens a transactional <Modal> form
   that creates a ticket + opens a Quarantine lot via POST /api/v2/iqc. The HSF
   document table below stays on static mock (out of scope). *@
<PageTitle>@T("qms.mod.iqc.title") — CCL MES</PageTitle>

<div class="qms-page" data-testid="qms-iqc">
    <QmsModuleTopBar Vm="QmsMock.IqcTop" />

    <div class="qms-iqc-head">
        <div class="qms-fieldgrid" data-testid="iqc-header">
            <div class="qms-field" data-testid="iqc-h-receipt">
                <span class="qms-field-label">@T("iqc.f.receipt")</span>
                <span class="qms-field-val">@Show(_header.ReceiptNo)</span>
            </div>
            <div class="qms-field" data-testid="iqc-h-codeifs">
                <span class="qms-field-label">@T("iqc.f.codeifs")</span>
                <span class="qms-field-val">@Show(_header.CodeIfs)</span>
            </div>
            <div class="qms-field" data-testid="iqc-h-matdesc">
                <span class="qms-field-label">@T("iqc.f.matdesc")</span>
                <span class="qms-field-val">@Show(_header.MaterialDescription)</span>
            </div>
            <div class="qms-field" data-testid="iqc-h-ifsdesc">
                <span class="qms-field-label">@T("iqc.f.ifsdesc")</span>
                <span class="qms-field-val">@Show(_header.IfsDescription)</span>
            </div>
            <div class="qms-field" data-testid="iqc-h-lotbatch">
                <span class="qms-field-label">@T("iqc.f.lotbatch")</span>
                <span class="qms-field-val">@Show(_header.LotBatchNo)</span>
            </div>
            <div class="qms-field" data-testid="iqc-h-manfdate">
                <span class="qms-field-label">@T("iqc.f.manfdate")</span>
                <span class="qms-field-val">@Show(_header.ManufactureDate?.ToString("dd/MM/yyyy"))</span>
            </div>
            <div class="qms-field" data-testid="iqc-h-maker">
                <span class="qms-field-label">@T("iqc.f.maker")</span>
                <span class="qms-field-val">@Show(_header.MakerName)</span>
            </div>
            <div class="qms-field" data-testid="iqc-h-supplier">
                <span class="qms-field-label">@T("iqc.f.supplier")</span>
                <span class="qms-field-val">@Show(_header.SupplierName)</span>
            </div>
            <div class="qms-field" data-testid="iqc-h-inspector">
                <span class="qms-field-label">@T("iqc.f.inspector")</span>
                <span class="qms-field-val">@Show(_header.Inspector)</span>
            </div>
        </div>
        <div class="qms-actionbar">
            <button type="button" class="qms-btn qms-btn-primary"
                    data-testid="iqc-add-ticket" @onclick="OpenForm">
                @T("iqc.add.button")
            </button>
        </div>
    </div>

    <QmsStepper Steps="QmsMock.IqcSteps" ActiveIndex="_active"
                OnStepClick="i => _active = i" />

    @if (_active == 0)
    {
        <section class="qms-section">
            <div class="qms-section-head">
                <h2 class="qms-section-title">@T("qms.iqc.section")</h2>
                <button type="button" class="qms-btn qms-btn-secondary">@T("qms.act.adddoc")</button>
            </div>
            <p class="qms-section-desc">@T("qms.iqc.section.desc")</p>

            <div class="qms-table-wrap">
                <table class="qms-table" data-testid="qms-iqc-hsf-table">
                    <thead>
                        <tr>
                            <th>@T("qms.iqc.col.doc")</th>
                            <th>@T("qms.iqc.col.no")</th>
                            <th>@T("qms.iqc.col.issue")</th>
                            <th>@T("qms.iqc.col.expiry")</th>
                            <th>@T("qms.iqc.col.modified")</th>
                            <th>@T("qms.iqc.col.status")</th>
                            <th class="qms-col-tight">@T("qms.iqc.col.action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in QmsMock.Hsf)
                        {
                            <tr>
                                <td class="qms-td-strong">@d.Name</td>
                                <td>@d.No</td>
                                <td>@d.Issue</td>
                                <td class="@(d.Valid ? "" : "qms-td-ng")">@d.Expiry</td>
                                <td>@d.ModifiedBy<div class="qms-cell-sub">@d.ModifiedAt</div></td>
                                <td>
                                    <span class="qms-status @(d.Valid ? "qms-status-valid" : "qms-status-expired")">
                                        @(d.Valid ? T("qms.status.valid") : T("qms.status.expired"))
                                    </span>
                                </td>
                                <td class="qms-col-tight"><button type="button" class="qms-remove">@T("qms.act.remove")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <p class="qms-section-desc" data-testid="qms-iqc-step-placeholder">@T(QmsMock.IqcSteps[_active].LabelKey) — @T("qms.icra.state.open")…</p>
    }
</div>

<Modal Open="_formOpen" OnClose="CloseForm" Size="ModalSize.Md"
       ClickOutsideToClose="false">
    <Header>@T("iqc.form.title")</Header>
    <Body>
        <div class="iqc-form" data-testid="iqc-form">
            <p class="iqc-form-desc">@T("iqc.form.desc")</p>

            <div class="iqc-form-grid">
                @* Đảo chiều (feat/iqc-search-by-desc): mô tả là ô TÌM chính. *@
                <label class="iqc-fld iqc-fld-wide">
                    <span class="iqc-fld-label">@T("iqc.f.matdesc.search")</span>
                    <input class="op-input" data-testid="iqc-search-input"
                           placeholder="@T("iqc.search.ph")"
                           value="@_searchText"
                           @oninput="OnSearchInput" />
                </label>

                @* Code IFS = droplist multi-select tick (chip-buttons, KHÔNG
                   native <select> — WKWebView freeze trên maccatalyst). *@
                <div class="iqc-fld iqc-fld-wide">
                    <span class="iqc-fld-label">@T("iqc.multi.codeifs.pick")</span>
                    @if (_searchTooShort)
                    {
                        <p class="iqc-hint" data-testid="iqc-search-tooshort">@T("iqc.search.tooshort")</p>
                    }
                    else
                    {
                        <div class="iqc-picker" data-testid="iqc-codeifs-list">
                            <div class="iqc-picker-bar">
                                <input class="op-input iqc-picker-filter" data-testid="iqc-codeifs-filter"
                                       placeholder="@T("iqc.search.filter.ph")"
                                       value="@_listFilter" @oninput="OnListFilterInput" />
                                <span class="iqc-picker-count" data-testid="iqc-codeifs-count">
                                    @T("iqc.search.results", _selectedCodes.Count, _searchTotal)
                                </span>
                            </div>
                            @if (FilteredResults.Count == 0)
                            {
                                <p class="iqc-hint" data-testid="iqc-codeifs-none">@T("iqc.search.none")</p>
                            }
                            else
                            {
                                <div class="iqc-picker-scroll">
                                    @foreach (var row in FilteredResults)
                                    {
                                        var on = _selectedCodes.Contains(row.CodeIfs);
                                        <button type="button"
                                                class="iqc-pick-row @(on ? "iqc-pick-on" : "")"
                                                data-testid="iqc-codeifs-tick"
                                                data-code="@row.CodeIfs"
                                                @onclick="() => ToggleCode(row.CodeIfs)">
                                            <span class="iqc-pick-mark">@(on ? "☑" : "☐")</span>
                                            <span class="iqc-pick-code">@row.CodeIfs</span>
                                            <span class="iqc-pick-desc">@row.IfsDescription</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <label class="iqc-fld">
                    <span class="iqc-fld-label">@T("iqc.f.lotbatch")</span>
                    <input class="op-input" data-testid="iqc-f-lotbatch"
                           placeholder="@T("iqc.form.lotbatch.ph")"
                           @bind="_lotBatchNo" />
                    @if (_selectedCodes.Count > 1)
                    {
                        <span class="iqc-hint" data-testid="iqc-lot-suffix-hint">@T("iqc.multi.lotbatch.hint")</span>
                    }
                </label>

                <label class="iqc-fld">
                    <span class="iqc-fld-label">@T("iqc.f.manfdate")</span>
                    <input type="date" class="op-input" data-testid="iqc-f-manfdate"
                           @bind="_manufactureDate" />
                </label>

                <label class="iqc-fld">
                    <span class="iqc-fld-label">@T("iqc.f.maker")</span>
                    <input class="op-input" list="iqc-makers" data-testid="iqc-f-maker"
                           placeholder="@T("iqc.form.maker.ph")"
                           value="@_makerName"
                           @onchange="OnMakerChanged" />
                    <datalist id="iqc-makers">
                        @foreach (var m in _makerOptions)
                        {
                            <option value="@m" />
                        }
                    </datalist>
                </label>

                <label class="iqc-fld">
                    <span class="iqc-fld-label">@T("iqc.f.supplier")</span>
                    <input class="op-input" data-testid="iqc-f-supplier"
                           placeholder="@T("iqc.form.supplier.ph")"
                           @bind="_supplierName" />
                </label>

                <label class="iqc-fld">
                    <span class="iqc-fld-label">@T("iqc.f.qty")</span>
                    <input type="number" min="0" step="any" class="op-input" data-testid="iqc-f-qty"
                           placeholder="@T("iqc.form.qty.ph")"
                           @bind="_quantity" />
                </label>

                <label class="iqc-fld">
                    <span class="iqc-fld-label">@T("iqc.f.uom")</span>
                    <input class="op-input" data-testid="iqc-f-uom"
                           placeholder="@T("iqc.form.uom.ph")"
                           @bind="_uom" />
                </label>
            </div>

            @if (_error is not null)
            {
                <p class="iqc-warn iqc-warn-error" data-testid="iqc-form-error">@_error</p>
            }
        </div>
    </Body>
    <Footer>
        <button type="button" class="op-btn op-btn-secondary" data-testid="iqc-form-cancel"
                @onclick="CloseForm" disabled="@_saving">@T("iqc.form.cancel")</button>
        <button type="button" class="op-btn op-btn-primary" data-testid="iqc-form-save"
                @onclick="SaveAsync" disabled="@(_saving || !CanSave)">
            @(_saving ? T("iqc.form.saving") : T("iqc.form.save"))
        </button>
    </Footer>
</Modal>

@code {
    private int _active;

    // Header state — populated after a successful create (server = source).
    private HeaderVm _header = HeaderVm.Empty;

    // Form state.
    private bool _formOpen;
    private bool _saving;
    private string? _error;
    private string _lotBatchNo = "";
    private string? _makerName;
    private string? _supplierName;
    private DateTime? _manufactureDate;
    private double? _quantity;
    private string? _uom;
    private List<string> _makerOptions = new();

    // feat/iqc-search-by-desc — search-by-description + multi-select.
    private string _searchText = "";
    private string _listFilter = "";
    private bool _searchTooShort;
    private int _searchTotal;
    private List<IqcMaterialSearchItem> _searchResults = new();
    private readonly HashSet<string> _selectedCodes = new(StringComparer.OrdinalIgnoreCase);
    private System.Threading.Timer? _debounce;

    /// <summary>Debounce window for the description search. Default 300ms in
    /// production; tests set 0 to fire synchronously (deterministic, no timer
    /// thread racing under parallel xUnit collections).</summary>
    [Parameter] public int DebounceMs { get; set; } = 300;

    // Client-side filter over the loaded page (server also paginates). Ticked
    // rows stay visible so the operator never loses a selection while filtering.
    private List<IqcMaterialSearchItem> FilteredResults =>
        string.IsNullOrWhiteSpace(_listFilter)
            ? _searchResults
            : _searchResults.Where(r =>
                _selectedCodes.Contains(r.CodeIfs)
                || r.CodeIfs.Contains(_listFilter, StringComparison.OrdinalIgnoreCase)
                || (r.IfsDescription ?? "").Contains(_listFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private bool CanSave =>
        _selectedCodes.Count > 0
        && !string.IsNullOrWhiteSpace(_lotBatchNo)
        && _quantity is > 0;

    private string Show(string? v) => string.IsNullOrWhiteSpace(v) ? T("iqc.f.empty") : v!;

    private void OpenForm()
    {
        _error = null;
        _searchText = ""; _listFilter = ""; _searchTooShort = false; _searchTotal = 0;
        _searchResults = new(); _selectedCodes.Clear();
        _lotBatchNo = ""; _makerName = null; _supplierName = null;
        _manufactureDate = null; _quantity = null; _uom = null;
        _formOpen = true;
    }

    private void CloseForm()
    {
        if (_saving) return;
        _formOpen = false;
    }

    // Debounced search: mirror OnMakerChanged's cadence but with a 300ms timer
    // so a fast typist doesn't fan a query per keystroke.
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _error = null;
        _debounce?.Dispose();
        if (DebounceMs <= 0)
        {
            // Synchronous path (tests): no timer thread, deterministic.
            await RunSearchAsync();
            return;
        }
        _debounce = new System.Threading.Timer(async _ =>
            await InvokeAsync(RunSearchAsync), null, DebounceMs, System.Threading.Timeout.Infinite);
    }

    private async Task RunSearchAsync()
    {
        var term = _searchText;
        try
        {
            var r = await Api.SearchIqcMaterialAsync(term, 1, 20);
            _searchTooShort = r.TooShort;
            _searchTotal = r.Total;
            _searchResults = r.Items ?? new();
        }
        catch
        {
            // Best-effort; leave last-known list. Save still re-resolves server-side.
            _searchTooShort = false;
        }
        StateHasChanged();
    }

    private void OnListFilterInput(ChangeEventArgs e) => _listFilter = e.Value?.ToString() ?? "";

    private void ToggleCode(string code)
    {
        if (!_selectedCodes.Remove(code)) _selectedCodes.Add(code);
    }

    private async Task OnMakerChanged(ChangeEventArgs e)
    {
        _makerName = e.Value?.ToString();
        var q = (_makerName ?? "").Trim();
        try { _makerOptions = await Api.GetIqcMakersAsync(q); }
        catch { /* suggestions are optional */ }
    }

    // A2a multi-create: tick N Code IFS → N POST /api/v2/iqc, each a fresh
    // ticket + MaterialLot with the SAME server-side freeze (PA-A) path. Lot
    // numbers are distinct via -01…-0N suffix when >1 code is picked (single
    // code keeps the base lot as-is). Loop is sequential + collects a per-row
    // outcome so one 409 (dup lot) fails only that row, not the whole batch.
    private async Task SaveAsync()
    {
        if (!CanSave || _saving) return;
        _saving = true;
        _error = null;

        var codes = _selectedCodes.ToList();
        var baseLot = _lotBatchNo.Trim();
        var multi = codes.Count > 1;
        var maker = string.IsNullOrWhiteSpace(_makerName) ? null : _makerName!.Trim();
        var supplier = string.IsNullOrWhiteSpace(_supplierName) ? null : _supplierName!.Trim();
        var uom = string.IsNullOrWhiteSpace(_uom) ? null : _uom!.Trim();

        var okCount = 0;
        var failCount = 0;
        string? firstError = null;
        CreateIqcTicketResponse? lastOk = null;
        string lastOkCode = "";
        string lastOkLot = "";

        try
        {
            for (var i = 0; i < codes.Count; i++)
            {
                var code = codes[i];
                var lot = multi ? $"{baseLot}-{(i + 1):D2}" : baseLot;
                try
                {
                    var resp = await Api.CreateIqcTicketAsync(new CreateIqcTicketBody
                    {
                        CodeIfs = code,
                        LotBatchNo = lot,
                        ManufactureDate = _manufactureDate,
                        MakerName = maker,
                        SupplierName = supplier,
                        Quantity = _quantity ?? 0,
                        Uom = uom,
                    });
                    okCount++;
                    lastOk = resp; lastOkCode = code; lastOkLot = lot;
                }
                catch (ApiException ex)
                {
                    failCount++;
                    firstError ??= LocaliseError(ex.ApiError.Code);
                }
                catch
                {
                    failCount++;
                    firstError ??= T("iqc.err.generic");
                }
            }

            if (lastOk is not null)
            {
                // Header shows the last successfully created ticket (server-auth).
                _header = new HeaderVm
                {
                    ReceiptNo = lastOk.ReceiptNo,
                    CodeIfs = lastOkCode,
                    MaterialDescription = lastOk.MaterialDescription,
                    IfsDescription = lastOk.IfsDescription,
                    LotBatchNo = lastOkLot,
                    ManufactureDate = _manufactureDate,
                    MakerName = maker,
                    SupplierName = supplier,
                    Inspector = Session.CurrentUserInfo?.Username,
                };
            }

            if (failCount == 0)
            {
                _formOpen = false;   // all created → close + refreshed header
            }
            else
            {
                // Partial: keep the form open, surface N ok / M failed banner.
                _error = okCount > 0
                    ? T("iqc.multi.partial", okCount, failCount)
                    : (firstError ?? T("iqc.err.generic"));
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private string LocaliseError(string code) => code switch
    {
        "iqc.invalid_code_ifs"       => T("iqc.err.invalid_code_ifs"),
        "iqc.invalid_lot_batch_no"   => T("iqc.err.invalid_lot_batch_no"),
        "iqc.invalid_quantity"       => T("iqc.err.invalid_quantity"),
        "iqc.receipt_no_conflict"    => T("iqc.err.receipt_no_conflict"),
        "lot.duplicate"              => T("iqc.err.lot_duplicate"),
        _                            => T("iqc.err.generic"),
    };

    public void Dispose() => _debounce?.Dispose();

    private sealed class HeaderVm
    {
        public string? ReceiptNo { get; init; }
        public string? CodeIfs { get; init; }
        public string? MaterialDescription { get; init; }
        public string? IfsDescription { get; init; }
        public string? LotBatchNo { get; init; }
        public DateTime? ManufactureDate { get; init; }
        public string? MakerName { get; init; }
        public string? SupplierName { get; init; }
        public string? Inspector { get; init; }
        public static HeaderVm Empty => new();
    }
}
