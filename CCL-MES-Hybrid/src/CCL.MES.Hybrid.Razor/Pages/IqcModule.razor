@page "/qms/iqc"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Quality
@using CCL.MES.Hybrid.Razor.Shared
@using CCL.MES.Hybrid.Razor.Shared.Iqc
@inject ICclApiClient Api
@inject CCL.MES.Hybrid.Client.Auth.IAuthSession Session
@inject CCL.MES.Hybrid.Client.Windows.IWindowManager WM
@inject CCL.MES.Hybrid.Client.Qms.IIqcChangeNotifier IqcChanged

@* feat/iqc-module-tabs — IQC module với 3 SUB-TAB:
     • Dashboard  : KPI đếm thật (placeholder có cấu trúc, enrich sau).
     • IQC Data   : list phiếu đã lưu + lọc theo nhóm + RowContextMenu (L35)
                    + chuột-phải "Mở"/double-click → mở FORM thanh tra đầy đủ.
     • New Ticket : picker 4 nhóm → Materials mở FORM thanh tra đầy đủ
                    (MaterialsInspectionForm showcard); Chemical/Tools/Other
                    mở FORM RIÊNG placeholder (transactional Modal).
   Group ADDITIVE trên IqcInspection; phiếu Materials cũ chạy nguyên. *@
<PageTitle>@T("qms.mod.iqc.title") — CCL MES</PageTitle>

<div class="qms-page" data-testid="qms-iqc">
    @* Module identity moved to the main topbar breadcrumb (feat/qms-topbar-breadcrumb);
       the per-module strip + its duplicate user badge is gone. Sub-tabs sit
       directly under the main topbar. *@
    @* ── Sub-tab strip (tái dùng pattern QcLibrary, KHÔNG tự vẽ mới) ── *@
    <div class="iqc-subtabs" role="tablist" data-testid="iqc-subtabs">
        <button type="button" role="tab" class="iqc-subtab @(_tab == IqcTab.Dashboard ? "iqc-subtab-on" : "")"
                data-testid="iqc-subtab-dashboard" aria-selected="@(_tab == IqcTab.Dashboard)"
                @onclick="() => SelectTab(IqcTab.Dashboard)">@T("iqc.tab.dashboard")</button>
        <button type="button" role="tab" class="iqc-subtab @(_tab == IqcTab.Data ? "iqc-subtab-on" : "")"
                data-testid="iqc-subtab-data" aria-selected="@(_tab == IqcTab.Data)"
                @onclick="() => SelectTab(IqcTab.Data)">@T("iqc.tab.data")</button>
        <button type="button" role="tab" class="iqc-subtab @(_tab == IqcTab.NewTicket ? "iqc-subtab-on" : "")"
                data-testid="iqc-subtab-newticket" aria-selected="@(_tab == IqcTab.NewTicket)"
                @onclick="() => SelectTab(IqcTab.NewTicket)">@T("iqc.tab.newticket")</button>
        @* P12 bước 2b — soạn tiêu chuẩn theo mã nguyên liệu. *@
        <button type="button" role="tab" class="iqc-subtab @(_tab == IqcTab.Spec ? "iqc-subtab-on" : "")"
                data-testid="iqc-subtab-spec" aria-selected="@(_tab == IqcTab.Spec)"
                @onclick="() => SelectTab(IqcTab.Spec)">@T("iqc.tab.spec")</button>
        <button type="button" role="tab" class="iqc-subtab @(_tab == IqcTab.Ng ? "iqc-subtab-on" : "")"
                data-testid="iqc-subtab-ng" aria-selected="@(_tab == IqcTab.Ng)"
                @onclick="() => SelectTab(IqcTab.Ng)">@T("iqc.tab.ng")</button>
        <button type="button" role="tab" class="iqc-subtab @(_tab == IqcTab.History ? "iqc-subtab-on" : "")"
                data-testid="iqc-subtab-history" aria-selected="@(_tab == IqcTab.History)"
                @onclick="() => SelectTab(IqcTab.History)">@T("iqc.tab.history")</button>
    </div>

    @* ══════════════ DASHBOARD ══════════════ *@
    @if (_tab == IqcTab.Dashboard)
    {
        <section class="qms-section" data-testid="iqc-dash">
            <div class="qms-section-head">
                <h2 class="qms-section-title">@T("iqc.dash.title")</h2>
            </div>
            <p class="qms-section-desc">@T("iqc.dash.desc")</p>

            <div class="iqc-kpi-row">
                <div class="iqc-kpi iqc-kpi-total" data-testid="iqc-kpi-total">
                    <span class="iqc-kpi-num">@_dash.Total</span>
                    <span class="iqc-kpi-lbl">@T("iqc.dash.total")</span>
                </div>
            </div>

            <h3 class="iqc-kpi-group-title">@T("iqc.dash.bygroup")</h3>
            <div class="iqc-kpi-row">
                <div class="iqc-kpi" data-testid="iqc-kpi-materials">
                    <span class="iqc-kpi-num">@_dash.Materials</span>
                    <span class="iqc-kpi-lbl">@T("iqc.group.materials")</span>
                </div>
                <div class="iqc-kpi" data-testid="iqc-kpi-chemical">
                    <span class="iqc-kpi-num">@_dash.Chemical</span>
                    <span class="iqc-kpi-lbl">@T("iqc.group.chemical")</span>
                </div>
                <div class="iqc-kpi" data-testid="iqc-kpi-tools">
                    <span class="iqc-kpi-num">@_dash.Tools</span>
                    <span class="iqc-kpi-lbl">@T("iqc.group.tools")</span>
                </div>
                <div class="iqc-kpi" data-testid="iqc-kpi-other">
                    <span class="iqc-kpi-num">@_dash.Other</span>
                    <span class="iqc-kpi-lbl">@T("iqc.group.other")</span>
                </div>
            </div>

            <h3 class="iqc-kpi-group-title">@T("iqc.dash.bystatus")</h3>
            <div class="iqc-kpi-row">
                <div class="iqc-kpi iqc-kpi-pending" data-testid="iqc-kpi-pending">
                    <span class="iqc-kpi-num">@_dash.Pending</span>
                    <span class="iqc-kpi-lbl">@T("iqc.dash.pending")</span>
                </div>
                <div class="iqc-kpi iqc-kpi-pass" data-testid="iqc-kpi-pass">
                    <span class="iqc-kpi-num">@_dash.Pass</span>
                    <span class="iqc-kpi-lbl">@T("iqc.dash.pass")</span>
                </div>
                <div class="iqc-kpi iqc-kpi-fail" data-testid="iqc-kpi-fail">
                    <span class="iqc-kpi-num">@_dash.Fail</span>
                    <span class="iqc-kpi-lbl">@T("iqc.dash.fail")</span>
                </div>
            </div>

            <p class="iqc-ph-note" data-testid="iqc-dash-placeholder">@T("iqc.dash.placeholder.note")</p>
        </section>
    }

    @* ══════════════ IQC DATA (list) ══════════════ *@
    else if (_tab == IqcTab.Data)
    {
        <section class="qms-section" data-testid="iqc-data">
            <div class="qms-section-head">
                <h2 class="qms-section-title">@T("iqc.data.title")</h2>
            </div>

            <div class="iqc-data-toolbar">
                <div class="iqc-data-groupfilter" role="group" aria-label="@T("iqc.data.filter.group")">
                    <button type="button" class="iqc-chip @( _groupFilter is null ? "iqc-chip-on" : "")"
                            data-testid="iqc-data-group-all" @onclick="() => SetGroupFilter(null)">@T("iqc.group.all")</button>
                    @foreach (var g in Groups)
                    {
                        var gg = g;
                        <button type="button" class="iqc-chip @(_groupFilter == gg ? "iqc-chip-on" : "")"
                                data-testid="@($"iqc-data-group-{gg.ToLowerInvariant()}")"
                                @onclick="() => SetGroupFilter(gg)">@GroupLabel(gg)</button>
                    }
                </div>
                <input type="search" class="op-input iqc-data-search" data-testid="iqc-data-search"
                       placeholder="@T("iqc.data.search.ph")"
                       value="@_search" @oninput="OnDataSearchInput" />
            </div>

            @if (_dataLoading && _data is null)
            {
                <p class="qms-section-desc">@T("iqc.data.loading")</p>
            }
            else
            {
                <div class="qms-table-wrap qms-fill">
                    <table class="qms-table iqc-data-table" data-testid="iqc-data-table">
                        <thead>
                            <tr>
                                <th>@T("iqc.data.col.receipt")</th>
                                <th>@T("iqc.data.col.group")</th>
                                <th>@T("iqc.data.col.codeifs")</th>
                                <th>@T("iqc.data.col.matdesc")</th>
                                <th>@T("iqc.data.col.lot")</th>
                                <th>@T("iqc.data.col.manfdate")</th>
                                <th>@T("iqc.data.col.maker")</th>
                                <th>@T("iqc.data.col.supplier")</th>
                                <th>@T("iqc.data.col.inspector")</th>
                                <th>@T("iqc.data.col.received")</th>
                                <th class="num">@T("iqc.data.col.qty")</th>
                                <th>@T("iqc.data.col.status")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in (_data?.Items ?? new()))
                            {
                                var r = row;
                                <tr class="iqc-data-row"
                                    @oncontextmenu="e => OpenMenuAt(r, e.ClientX, e.ClientY)" @oncontextmenu:preventDefault="true"
                                    @ondblclick="() => OpenInspection(r)"
                                    @onpointerdown="e => LongPressStart(r, e)" @onpointerup="LongPressCancel"
                                    @onpointerleave="LongPressCancel" @onpointermove="LongPressCancel">
                                    <td class="qms-td-strong" data-testid="iqc-data-receipt">@Show(r.ReceiptNo)</td>
                                    <td><span class="iqc-group-tag" data-group="@r.Group">@GroupLabel(r.Group)</span></td>
                                    <td>@Show(r.CodeIfs)</td>
                                    <td>@Show(r.MaterialDescription)</td>
                                    <td>@Show(r.LotBatchNo)</td>
                                    <td>@Show(r.ManufactureDate?.ToString("dd/MM/yyyy"))</td>
                                    <td>@Show(r.MakerName)</td>
                                    <td>@Show(r.SupplierName)</td>
                                    <td>@Show(r.Inspector)</td>
                                    <td>@r.ReceivedDate.ToString("dd/MM/yyyy")</td>
                                    <td class="num">@r.Quantity@(string.IsNullOrWhiteSpace(r.Uom) ? "" : $" {r.Uom}")</td>
                                    <td><span class="iqc-status iqc-status-@r.Result.ToLowerInvariant()">@StatusLabel(r.Result)</span></td>
                                </tr>
                            }
                            @if ((_data?.Items.Count ?? 0) == 0)
                            {
                                <tr><td colspan="12" class="grid-empty" data-testid="iqc-data-empty">@T("iqc.data.empty")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="grid-pager">
                    <button type="button" class="op-btn op-btn-secondary" data-testid="iqc-data-prev"
                            disabled="@(_page <= 1 || _dataLoading)" @onclick="() => GoToPageAsync(_page - 1)">@T("iqc.data.pager.prev")</button>
                    <span class="grid-pager-text">@T("iqc.data.pager.status", _page, DataTotalPages, _data?.Total ?? 0)</span>
                    <button type="button" class="op-btn op-btn-secondary" data-testid="iqc-data-next"
                            disabled="@(_page >= DataTotalPages || _dataLoading)" @onclick="() => GoToPageAsync(_page + 1)">@T("iqc.data.pager.next")</button>
                </div>

                <GridAutoFit OnFit="SetPageSizeAsync" ScrollSelector=".qms-fill" />
            }
        </section>

        @* Row-action menu: right-click / long-press / kebab share ONE state (L35). *@
        <RowContextMenu Open="_menuRow is not null" Anchor="_menuAnchor" Items="_menuItems"
                        AriaLabel="@T("iqc.data.menu.aria", _menuRow?.ReceiptNo ?? "")" OnClose="CloseMenu" />
    }

    @* ══════════════ TIÊU CHUẨN (P12 bước 2b) ══════════════ *@
    else if (_tab == IqcTab.Spec)
    {
        <IqcSpecEditor DebounceMs="DebounceMs" />
    }

    @* ══════════════ NG / CLAIM (P13 bước 6) — else if TRƯỚC nhánh New Ticket *@
    else if (_tab == IqcTab.Ng)
    {
        <IqcNgBoard DebounceMs="DebounceMs" />
    }

    @* ══════════════ HISTORY — sổ Pass/Fail map sheet Excel Roll/PCS/Chem/Tool *@
    else if (_tab == IqcTab.History)
    {
        <IqcHistoryBoard DebounceMs="DebounceMs" OnOpenTicket="OpenHistoryTicket" />
    }

    @* ══════════════ NEW TICKET ══════════════ *@
    else
    {
        <section class="qms-section" data-testid="iqc-newticket">
            <div class="qms-section-head">
                <h2 class="qms-section-title">@T("iqc.newticket.pick")</h2>
            </div>
            <p class="qms-section-desc">@T("iqc.newticket.pick.desc")</p>

            <div class="iqc-grouppick" data-testid="iqc-grouppick">
                <button type="button" class="iqc-groupcard" data-testid="iqc-groupcard-materials"
                        @onclick="() => PickGroup(IqcGroupKind.Materials)">
                    <span class="iqc-groupcard-name">@T("iqc.group.materials")</span>
                    <span class="iqc-groupcard-hint">@T("iqc.group.materials.hint")</span>
                </button>
                <button type="button" class="iqc-groupcard" data-testid="iqc-groupcard-chemical"
                        @onclick="() => PickGroup(IqcGroupKind.Chemical)">
                    <span class="iqc-groupcard-name">@T("iqc.group.chemical")</span>
                    <span class="iqc-groupcard-hint">@T("iqc.group.chemical.hint")</span>
                </button>
                <button type="button" class="iqc-groupcard" data-testid="iqc-groupcard-tools"
                        @onclick="() => PickGroup(IqcGroupKind.Tools)">
                    <span class="iqc-groupcard-name">@T("iqc.group.tools")</span>
                    <span class="iqc-groupcard-hint">@T("iqc.group.tools.hint")</span>
                </button>
                <button type="button" class="iqc-groupcard" data-testid="iqc-groupcard-other"
                        @onclick="() => PickGroup(IqcGroupKind.Other)">
                    <span class="iqc-groupcard-name">@T("iqc.group.other")</span>
                    <span class="iqc-groupcard-hint">@T("iqc.group.other.hint")</span>
                </button>
            </div>

            @if (_lastCreatedReceipt is not null)
            {
                <p class="iqc-ph-saved" data-testid="iqc-newticket-saved">@T("iqc.ph.saved", _lastCreatedReceipt)</p>
            }
        </section>
    }
</div>

@* ══════════════ FORM thanh tra Materials — SHOWCARD keep-open (L34) ══════════════
     W5 showcard-migration — không còn tự-host @foreach ở đây. Cửa sổ thanh tra
     là window WindowManager thật (do MainLayout .window-layer host), mở qua
     WM.Open(key, …, typeof(MaterialsInspectionWindow)) trong OpenInspection.
     WM sở hữu chrome + rect (per key) + focus + dedupe + soft-cap. *@

@* ══════════════ Placeholder forms (Chemical / Tools / Other) — transactional Modal ══════════════ *@
<Modal Open="_phOpen" OnClose="ClosePlaceholder" Size="ModalSize.Md" ClickOutsideToClose="false">
    <Header>@GroupLabel(GroupKindToString(_phGroup)) — @T("iqc.newticket.title")</Header>
    <Body>
        @if (_phGroup == IqcGroupKind.Chemical)
        {
            <ChemicalTicketForm OnCancel="ClosePlaceholder" OnSaved="OnPlaceholderSaved" />
        }
        else if (_phGroup == IqcGroupKind.Tools)
        {
            <ToolsTicketForm OnCancel="ClosePlaceholder" OnSaved="OnPlaceholderSaved" />
        }
        else if (_phGroup == IqcGroupKind.Other)
        {
            <OtherTicketForm OnCancel="ClosePlaceholder" OnSaved="OnPlaceholderSaved" />
        }
    </Body>
</Modal>

@if (_toast is not null)
{
    <div class="grid-status" role="status" data-testid="iqc-toast">@_toast</div>
}

@code {
    private enum IqcTab { Dashboard, Data, NewTicket, Spec, Ng, History }
    private enum IqcGroupKind { Materials, Chemical, Tools, Other }

    private IqcTab _tab = IqcTab.Dashboard;

    private static readonly string[] Groups = { "Materials", "Chemical", "Tools", "Other" };
    private string GroupLabel(string g) => T($"iqc.group.{(g ?? "materials").ToLowerInvariant()}");
    private string StatusLabel(string r) => T($"iqc.data.status.{(r ?? "pending").ToLowerInvariant()}");
    private static string GroupKindToString(IqcGroupKind k) => k.ToString();

    // ── Dashboard state ──
    private IqcDashboardResponse _dash = new();

    // ── IQC Data state ──
    private IqcTicketListResponse? _data;
    private bool _dataLoading;
    private string? _groupFilter;
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 20;
    private System.Threading.Timer? _dataDebounce;
    private int DataTotalPages => Math.Max(1, (int)Math.Ceiling((_data?.Total ?? 0) / (double)_pageSize));

    // P1 — GridAutoFit reports how many rows fit the viewport; resize the page
    // to fill it (kill the dead space below a short page), then clamp the
    // current page into the new range. Mirrors NpiRawMaterials.SetPageSizeAsync.
    private async Task SetPageSizeAsync(int rows)
    {
        if (rows <= 0 || rows == _pageSize) return;
        _pageSize = rows;
        var pages = Math.Max(1, (int)Math.Ceiling((_data?.Total ?? 0) / (double)rows));
        _page = Math.Clamp(_page, 1, pages);
        await LoadDataAsync();
        StateHasChanged();
    }

    // Row-action menu (right-click / long-press / kebab → one menu, L35).
    private IqcTicketListItem? _menuRow;
    private (double X, double Y) _menuAnchor;
    private IReadOnlyList<ContextMenuItem> _menuItems = System.Array.Empty<ContextMenuItem>();
    private System.Threading.Timer? _longPress;
    private (double X, double Y) _pressAt;
    private string? _toast;

    // ── New Ticket / placeholder state ──
    private bool _phOpen;
    private IqcGroupKind _phGroup = IqcGroupKind.Chemical;
    private string? _lastCreatedReceipt;

    // ── Materials inspection showcards (WindowManager windows, L34) ──
    // W5 showcard-migration — the module no longer owns an open-list. Each
    // inspection is a real WM window hosted by MainLayout; OpenInspection calls
    // WM.Open(key, …) so the manager owns chrome + rect (per key) + focus +
    // dedupe + soft-cap. Key = "ticket:{ReceiptNo}" for a saved ticket (dedupe),
    // "iqc-new:{Guid}" for a create window (unique — open several in parallel).

    /// <summary>Debounce window for the description search. Default 300ms in
    /// production; tests set 0 to fire synchronously (deterministic).</summary>
    [Parameter] public int DebounceMs { get; set; } = 300;

    private string Show(string? v) => string.IsNullOrWhiteSpace(v) ? T("iqc.f.empty") : v!;

    protected override async Task OnInitializedAsync()
    {
        // A ticket saved in any WM-hosted inspection window pokes the notifier →
        // refresh KPI + (if visible) the Data list without a page re-mount.
        IqcChanged.Changed += HandleIqcChanged;
        await LoadDashboardAsync();
    }

    private async Task SelectTab(IqcTab tab)
    {
        _tab = tab;
        _toast = null;
        if (tab == IqcTab.Dashboard) await LoadDashboardAsync();
        else if (tab == IqcTab.Data) await LoadDataAsync();
    }

    // ── Dashboard ──
    private async Task LoadDashboardAsync()
    {
        try { _dash = await Api.GetIqcDashboardAsync(); }
        catch { /* best-effort KPI */ }
    }

    // ── IQC Data ──
    private async Task LoadDataAsync()
    {
        _dataLoading = true;
        try { _data = await Api.ListIqcTicketsAsync(_groupFilter, string.IsNullOrWhiteSpace(_search) ? null : _search, _page, _pageSize); }
        catch { /* leave last-known */ }
        finally { _dataLoading = false; StateHasChanged(); }
    }

    private async Task SetGroupFilter(string? g)
    {
        _groupFilter = g; _page = 1;
        await LoadDataAsync();
    }

    private void OnDataSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
        _dataDebounce?.Dispose();
        if (DebounceMs <= 0) { _ = LoadDataAsync(); return; }
        _dataDebounce = new System.Threading.Timer(async _ =>
            await InvokeAsync(LoadDataAsync), null, DebounceMs, System.Threading.Timeout.Infinite);
    }

    private async Task GoToPageAsync(int page)
    {
        _page = Math.Clamp(page, 1, DataTotalPages);
        await LoadDataAsync();
    }

    // ── Row-action menu (RowContextMenu, L35). Server re-checks 403. ──
    private void OpenMenuAt(IqcTicketListItem row, double x, double y)
    {
        _menuRow = row;
        _menuAnchor = (x, y);
        _menuItems = new[]
        {
            new ContextMenuItem { Label = T("iqc.data.menu.open"), Icon = "🗂", OnClick = EventCallback.Factory.Create(this, () => MenuOpenInspection(row)) },
            new ContextMenuItem { Label = T("iqc.data.menu.copy"), Icon = "⎘", OnClick = EventCallback.Factory.Create(this, NotYet) },
            new ContextMenuItem { Label = T("iqc.data.menu.edit"), Icon = "✎", OnClick = EventCallback.Factory.Create(this, NotYet) },
            ContextMenuItem.Divider,
            new ContextMenuItem { Label = T("iqc.data.menu.delete"), Icon = "✕", Danger = true, OnClick = EventCallback.Factory.Create(this, NotYet) },
        };
    }

    private void CloseMenu() => _menuRow = null;
    private void MenuOpenInspection(IqcTicketListItem row) { _menuRow = null; OpenInspection(row); }
    private void NotYet() { _toast = T("iqc.data.action.notyet"); _menuRow = null; }

    private void LongPressStart(IqcTicketListItem row, PointerEventArgs e)
    {
        if (e.Button != 0) return;
        _pressAt = (e.ClientX, e.ClientY);
        _longPress?.Dispose();
        _longPress = new System.Threading.Timer(
            _ => InvokeAsync(() => { OpenMenuAt(row, _pressAt.X, _pressAt.Y); StateHasChanged(); }),
            null, 500, System.Threading.Timeout.Infinite);
    }
    private void LongPressCancel() { _longPress?.Dispose(); _longPress = null; }

    // ── New Ticket picker ──
    private void PickGroup(IqcGroupKind kind)
    {
        _lastCreatedReceipt = null;
        if (kind == IqcGroupKind.Materials)
        {
            // Materials → mở FORM thanh tra đầy đủ (showcard, tạo mới). Mỗi lần
            // = 1 cửa sổ độc lập (key "new:<guid>") để mở song song nhiều phiếu.
            OpenInspection(null);
        }
        else
        {
            _phGroup = kind;
            _phOpen = true;
        }
    }

    private void ClosePlaceholder() => _phOpen = false;

    private async Task OnPlaceholderSaved(CreateIqcTicketResponse resp)
    {
        _phOpen = false;
        _lastCreatedReceipt = resp.ReceiptNo;
        await LoadDashboardAsync();   // KPI reflects the new ticket
    }

    // ── Materials inspection showcard host (WindowManager, L34) ───────────
    // Mở form thanh tra đầy đủ qua WM. ticket == null → tạo mới (key duy nhất
    // "iqc-new:{Guid}", mỗi lần 1 cửa sổ độc lập); có → phiếu đã lưu (key
    // "ticket:{ReceiptNo}", dedupe → focus lại thay vì mở trùng). WM sở hữu
    // chrome + rect + focus + soft-cap. Freeze PA-A giữ trong form qua CÙNG
    // POST /api/v2/iqc. Ticket null → KHÔNG đưa vào Parameters dict (Dictionary
    // không giữ null); wrapper param nullable mặc định null = chế độ tạo mới.
    private void OpenHistoryTicket(IqcTicketListItem ticket) => OpenInspection(ticket);

    private void OpenInspection(IqcTicketListItem? ticket)
    {
        var key = ticket?.ReceiptNo is { Length: > 0 } rn
            ? CCL.MES.Hybrid.Client.Windows.WindowRegistryKeys.IqcTicketKeyPrefix + rn
            : CCL.MES.Hybrid.Client.Windows.WindowRegistryKeys.IqcNewKeyPrefix + Guid.NewGuid().ToString("N");

        var title = ticket?.ReceiptNo is { Length: > 0 } rn2 ? rn2 : T("iqc.insp.title.new");

        var pars = new Dictionary<string, object> { ["DebounceMs"] = DebounceMs };
        if (ticket is not null) pars["Ticket"] = ticket;

        var win = WM.Open(key, title, "🔬",
            typeof(CCL.MES.Hybrid.Razor.Shared.Iqc.MaterialsInspectionWindow), pars);

        // Soft-cap block (Open → null) surfaces the same "max windows" notice.
        _toast = win is null ? T("iqc.insp.maxwins", WM.SoftCap) : null;
    }

    // W5 — a ticket saved in a WM-hosted inspection window fired the notifier.
    // Refresh KPI + (when visible) the Data list. Runs on the render thread via
    // InvokeAsync since the notify may arrive from another component's callback.
    private void HandleIqcChanged()
        => InvokeAsync(async () =>
        {
            await LoadDashboardAsync();
            if (_tab == IqcTab.Data) await LoadDataAsync();
            StateHasChanged();
        });

    public override void Dispose()
    {
        IqcChanged.Changed -= HandleIqcChanged;
        _dataDebounce?.Dispose();
        _longPress?.Dispose();
        base.Dispose();
    }
}
