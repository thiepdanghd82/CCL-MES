@page "/npi/rawmaterials"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor,Engineer,QC")]
@inject ICclApiClient Api
@inject IGridPreferenceStore PrefStore
@implements IDisposable

<PageTitle>Raw Materials — NPI</PageTitle>

<h1 class="page-title">Raw Materials</h1>

<div class="grid-toolbar">
    <input type="search" class="grid-search" placeholder="Search by part / supplier / site…"
           value="@_search" @oninput="OnSearchInput" @onkeyup="HandleSearchKey" />
    <button type="button" class="grid-btn" @onclick="OnSearchClickAsync" disabled="@_loading">Search</button>
    <button type="button" class="grid-btn" @onclick="ReloadAsync" disabled="@_loading">Reload</button>
    <div class="grid-toolbar-spacer"></div>
    <GridColumnsMenu Columns="_columns" OnChanged="StateHasChanged" />
</div>

@if (_loading && _data is null)
{
    <p class="grid-status">Loading…</p>
}
else if (_error is not null)
{
    <div class="grid-error" role="alert">
        <strong>Failed to load data.</strong>
        <div>@_error</div>
        <button type="button" class="grid-btn" @onclick="ReloadAsync">Retry</button>
    </div>
}
else if (_data is not null)
{
    <div class="grid-scroll">
        <table class="grid grid-sticky">
            <thead>
                <tr>
                    @foreach (var col in _columns.Visible)
                    {
                        <th class="grid-h @ColClass(col.Id)">@col.Label</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _data.Items)
                {
                    <tr>
                        @foreach (var col in _columns.Visible)
                        {
                            <td>@RenderCell(row, col.Id)</td>
                        }
                    </tr>
                }
                @if (_data.Items.Count == 0)
                {
                    <tr>
                        <td colspan="@_columns.Visible.Count" class="grid-empty">
                            No matching data.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="grid-pager">
        <button type="button" class="grid-btn"
                disabled="@(GridPagination.IsFirstPage(_page) || _loading)"
                @onclick="() => GoToPageAsync(_page - 1)">‹ Previous</button>
        <span class="grid-pager-text">
            Page @_page / @TotalPages — @_data.Total rows
        </span>
        <button type="button" class="grid-btn"
                disabled="@(GridPagination.IsLastPage(_page, TotalPages) || _loading)"
                @onclick="() => GoToPageAsync(_page + 1)">Next ›</button>
    </div>
}

@code {
    private NpiPagedRaw<NpiRawMaterial>? _data;
    private bool _loading;
    private string? _error;
    private string _search = "";
    private System.Threading.Timer? _searchDebounce;
    private int _page = 1;
    private const int PageSize = 50;
    private GridColumns _columns = default!;

    private int TotalPages => GridPagination.TotalPages(_data?.Total ?? 0, PageSize);

    protected override async Task OnInitializedAsync()
    {
        // 28 columns from Phase 7 hạng mục 3 IFS expansion. 12 default
        // visible (the everyday subset operators reach for); the remaining
        // 16 are operator-toggle. Inversion (hide-by-default) is encoded
        // via DefaultVisible=false in ColumnDef; GridColumns flips them
        // on with a "+" override sentinel.
        _columns = new GridColumns("rawmaterials", new[]
        {
            new ColumnDef("part_no",            "Part No"),
            new ColumnDef("part_desc",          "Description"),
            new ColumnDef("supplier_id",        "Supplier ID"),
            new ColumnDef("supplier_name",      "Supplier"),
            new ColumnDef("price",              "Price"),
            new ColumnDef("currency",           "Currency"),
            new ColumnDef("purch_uom",          "Purchase UOM"),
            new ColumnDef("inv_uom",            "Inventory UOM"),
            new ColumnDef("site",               "Site"),
            new ColumnDef("status",             "Status"),
            new ColumnDef("min_qty",            "Min Qty"),
            new ColumnDef("leadtime",           "Leadtime (days)"),
            // 16 default-hidden — operator opens via column menu.
            new ColumnDef("price_incl_tax",     "Price incl. Tax", DefaultVisible: false),
            new ColumnDef("price_uom",          "Price UOM", DefaultVisible: false),
            new ColumnDef("site_desc",          "Site Description", DefaultVisible: false),
            new ColumnDef("std_multiple",       "Std multiple", DefaultVisible: false),
            new ColumnDef("std_pack",           "Std pack", DefaultVisible: false),
            new ColumnDef("conversion",         "Conversion Factor", DefaultVisible: false),
            new ColumnDef("tax_code",           "Tax Code", DefaultVisible: false),
            new ColumnDef("tax_code_desc",      "Tax Description", DefaultVisible: false),
            new ColumnDef("country_origin",     "Country of Origin", DefaultVisible: false),
            new ColumnDef("acquisition_type",   "Acquisition", DefaultVisible: false),
            new ColumnDef("supplier_part_no",   "Supplier Part", DefaultVisible: false),
            new ColumnDef("supplier_part_desc", "Supplier Part Description", DefaultVisible: false),
            new ColumnDef("net_weight",         "Weight", DefaultVisible: false),
            new ColumnDef("net_weight_uom",     "Weight UOM", DefaultVisible: false),
            new ColumnDef("next_order_date",    "Next Order Date", DefaultVisible: false),
            new ColumnDef("notes",              "Notes", DefaultVisible: false),
        }, PrefStore);
        await LoadAsync();
    }

    private Task HandleSearchKey(KeyboardEventArgs e)
        => e.Key == "Enter" ? OnSearchClickAsync() : Task.CompletedTask;

    // SpecHub-style live search — debounce 300ms then reload from page 1.
    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Threading.Timer(
            _ => InvokeAsync(() => { _page = 1; return LoadAsync(); }),
            null, 300, System.Threading.Timeout.Infinite);
    }

    public void Dispose() => _searchDebounce?.Dispose();

    private Task OnSearchClickAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await Api.GetRawMaterialsAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                _page, PageSize);
        }
        catch (ApiException apiEx)
        {
            _error = apiEx.ApiError.MessageEn;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ReloadAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = GridPagination.Clamp(page, TotalPages);
        return LoadAsync();
    }

    private static string ColClass(string columnId) => columnId switch
    {
        "part_no" or "supplier_id" or "supplier_part_no" => "grid-col-mono",
        "price" or "price_incl_tax" or "min_qty"
            or "std_multiple" or "std_pack" or "conversion"
            or "leadtime" or "net_weight"                 => "grid-col-num",
        _                                                  => "",
    };

    private static RenderFragment RenderCell(NpiRawMaterial row, string columnId) => __builder =>
    {
        switch (columnId)
        {
            case "part_no":             __builder.OpenElement(0, "code"); __builder.AddContent(1, row.PartNo); __builder.CloseElement(); break;
            case "part_desc":           __builder.AddContent(0, row.PartDescription ?? "—"); break;
            case "supplier_id":         __builder.AddContent(0, row.SupplierId ?? "—"); break;
            case "supplier_name":       __builder.AddContent(0, row.SupplierName ?? "—"); break;
            case "price":               __builder.AddContent(0, row.Price?.ToString("0.####") ?? "—"); break;
            case "currency":            __builder.AddContent(0, row.Currency ?? "—"); break;
            case "purch_uom":           __builder.AddContent(0, row.PurchUom ?? "—"); break;
            case "inv_uom":             __builder.AddContent(0, row.InventoryUom ?? "—"); break;
            case "site":                __builder.AddContent(0, row.Site ?? "—"); break;
            case "status":              __builder.AddContent(0, row.StatusCode ?? "—"); break;
            case "min_qty":             __builder.AddContent(0, row.MinimumQuantity?.ToString("0.##") ?? "—"); break;
            case "leadtime":            __builder.AddContent(0, row.SupplierLeadtimeDays?.ToString("0.##") ?? "—"); break;
            case "price_incl_tax":      __builder.AddContent(0, row.PriceInclTax?.ToString("0.####") ?? "—"); break;
            case "price_uom":           __builder.AddContent(0, row.PriceUom ?? "—"); break;
            case "site_desc":           __builder.AddContent(0, row.SiteDescription ?? "—"); break;
            case "std_multiple":        __builder.AddContent(0, row.StdMultipleQty?.ToString("0.##") ?? "—"); break;
            case "std_pack":            __builder.AddContent(0, row.StandardPackSize?.ToString("0.##") ?? "—"); break;
            case "conversion":          __builder.AddContent(0, row.ConversionFactor?.ToString("0.####") ?? "—"); break;
            case "tax_code":            __builder.AddContent(0, row.TaxCode ?? "—"); break;
            case "tax_code_desc":       __builder.AddContent(0, row.TaxCodeDescription ?? "—"); break;
            case "country_origin":      __builder.AddContent(0, row.CountryOfOrigin ?? "—"); break;
            case "acquisition_type":    __builder.AddContent(0, row.AcquisitionType ?? "—"); break;
            case "supplier_part_no":    __builder.OpenElement(0, "code"); __builder.AddContent(1, row.SupplierPartNo ?? ""); __builder.CloseElement(); break;
            case "supplier_part_desc":  __builder.AddContent(0, row.SupplierPartDescription ?? "—"); break;
            case "net_weight":          __builder.AddContent(0, row.NetWeight?.ToString("0.##") ?? "—"); break;
            case "net_weight_uom":      __builder.AddContent(0, row.NetWeightUom ?? "—"); break;
            case "next_order_date":     __builder.AddContent(0, row.NextOrderDate ?? "—"); break;
            case "notes":               __builder.AddContent(0, row.Notes ?? "—"); break;
        }
    };
}
