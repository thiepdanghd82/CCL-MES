@page "/npi/rawmaterials"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor,Engineer,QC")]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@inject ICclApiClient Api
@inject IGridPreferenceStore PrefStore

<PageTitle>@T("npiraw.pagetitle")</PageTitle>

<PageHead TitleKey="npiraw.title" />

<div class="grid-toolbar">
    <GridSearchBox @bind-Value="_search" OnSearch="OnSearchClickAsync"
                   Placeholder="@T("npiraw.search.placeholder")" />
    <button type="button" class="grid-btn" @onclick="OnSearchClickAsync" disabled="@_loading">@T("npiraw.search")</button>
    <button type="button" class="grid-btn" @onclick="ReloadAsync" disabled="@_loading">@T("npiraw.reload")</button>
    <AuthorizeView Roles="Admin,Supervisor,Engineer" Context="impCtx">
        <button type="button" class="grid-btn grid-btn-primary" @onclick="() => _importOpen = true" disabled="@_loading">⤓ @T("npiraw.import")</button>
    </AuthorizeView>
    <div class="grid-toolbar-spacer"></div>
    <GridColumnsMenu Columns="_columns" OnChanged="StateHasChanged" />
</div>

@if (_loading && _data is null)
{
    <p class="grid-status">@T("npiraw.loading")</p>
}
else if (_error is not null)
{
    <div class="grid-error" role="alert">
        <strong>@T("npiraw.error.load")</strong>
        <div>@_error</div>
        <button type="button" class="grid-btn" @onclick="ReloadAsync">@T("npiraw.retry")</button>
    </div>
}
else if (_data is not null)
{
    <div class="grid-scroll">
        <table class="grid grid-sticky">
            <thead>
                <tr>
                    @foreach (var col in _columns.Visible)
                    {
                        <th class="grid-h @ColClass(col.Id)">@col.Label</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _data.Items)
                {
                    <tr>
                        @foreach (var col in _columns.Visible)
                        {
                            <td class="@ColClass(col.Id)">@RenderCell(row, col.Id)</td>
                        }
                    </tr>
                }
                @if (_data.Items.Count == 0)
                {
                    <tr>
                        <td colspan="@_columns.Visible.Count" class="grid-empty">
                            @T("npiraw.empty")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="grid-pager">
        <button type="button" class="grid-btn"
                disabled="@(GridPagination.IsFirstPage(_page) || _loading)"
                @onclick="() => GoToPageAsync(_page - 1)">‹ @T("npiraw.pager.prev")</button>
        <span class="grid-pager-text">
            @T("npiraw.pager.status", _page, TotalPages, _data.Total)
        </span>
        <button type="button" class="grid-btn"
                disabled="@(GridPagination.IsLastPage(_page, TotalPages) || _loading)"
                @onclick="() => GoToPageAsync(_page + 1)">@T("npiraw.pager.next") ›</button>
    </div>

    <GridAutoFit OnFit="SetPageSizeAsync" />
}

<NpiImportModal Kind="rawmaterials" Open="_importOpen"
                OnClose="CloseImport" OnImported="OnImportedAsync" />

@code {
    private NpiPagedRaw<NpiRawMaterial>? _data;
    private bool _loading;
    private string? _error;
    private string _search = "";
    private bool _importOpen;
    private int _page = 1;
    private int _pageSize = 50;
    private GridColumns _columns = default!;

    private int TotalPages => GridPagination.TotalPages(_data?.Total ?? 0, _pageSize);

    // P10.10 — GridAutoFit reports how many rows fit the viewport; resize the
    // page to fill it, then clamp the current page into the new range.
    private async Task SetPageSizeAsync(int rows)
    {
        if (rows <= 0 || rows == _pageSize) return;
        _pageSize = rows;
        _page = GridPagination.Clamp(_page, GridPagination.TotalPages(_data?.Total ?? 0, rows));
        await LoadAsync();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // 28 columns from Phase 7 hạng mục 3 IFS expansion. 12 default
        // visible (the everyday subset operators reach for); the remaining
        // 16 are operator-toggle. Inversion (hide-by-default) is encoded
        // via DefaultVisible=false in ColumnDef; GridColumns flips them
        // on with a "+" override sentinel.
        _columns = new GridColumns("rawmaterials", new[]
        {
            new ColumnDef("part_no",            T("npiraw.col.part_no")),
            new ColumnDef("part_desc",          T("npiraw.col.part_desc")),
            new ColumnDef("supplier_id",        T("npiraw.col.supplier_id")),
            new ColumnDef("supplier_name",      T("npiraw.col.supplier_name")),
            new ColumnDef("price",              T("npiraw.col.price")),
            new ColumnDef("currency",           T("npiraw.col.currency")),
            new ColumnDef("purch_uom",          T("npiraw.col.purch_uom")),
            new ColumnDef("inv_uom",            T("npiraw.col.inv_uom")),
            new ColumnDef("site",               T("npiraw.col.site")),
            new ColumnDef("status",             T("npiraw.col.status")),
            new ColumnDef("min_qty",            T("npiraw.col.min_qty")),
            new ColumnDef("leadtime",           T("npiraw.col.leadtime")),
            // 16 default-hidden — operator opens via column menu.
            new ColumnDef("price_incl_tax",     T("npiraw.col.price_incl_tax"), DefaultVisible: false),
            new ColumnDef("price_uom",          T("npiraw.col.price_uom"), DefaultVisible: false),
            new ColumnDef("site_desc",          T("npiraw.col.site_desc"), DefaultVisible: false),
            new ColumnDef("std_multiple",       T("npiraw.col.std_multiple"), DefaultVisible: false),
            new ColumnDef("std_pack",           T("npiraw.col.std_pack"), DefaultVisible: false),
            new ColumnDef("conversion",         T("npiraw.col.conversion"), DefaultVisible: false),
            new ColumnDef("tax_code",           T("npiraw.col.tax_code"), DefaultVisible: false),
            new ColumnDef("tax_code_desc",      T("npiraw.col.tax_code_desc"), DefaultVisible: false),
            new ColumnDef("country_origin",     T("npiraw.col.country_origin"), DefaultVisible: false),
            new ColumnDef("acquisition_type",   T("npiraw.col.acquisition_type"), DefaultVisible: false),
            new ColumnDef("supplier_part_no",   T("npiraw.col.supplier_part_no"), DefaultVisible: false),
            new ColumnDef("supplier_part_desc", T("npiraw.col.supplier_part_desc"), DefaultVisible: false),
            new ColumnDef("net_weight",         T("npiraw.col.net_weight"), DefaultVisible: false),
            new ColumnDef("net_weight_uom",     T("npiraw.col.net_weight_uom"), DefaultVisible: false),
            new ColumnDef("next_order_date",    T("npiraw.col.next_order_date"), DefaultVisible: false),
            new ColumnDef("notes",              T("npiraw.col.notes"), DefaultVisible: false),
            // rawmaterials-bom-xlsx-import — 11 "Materials BOM" columns.
            new ColumnDef("mother_code",        T("npiraw.col.mother_code"), DefaultVisible: false),
            new ColumnDef("dimension_quality",  T("npiraw.col.dimension_quality"), DefaultVisible: false),
            new ColumnDef("width_mm",           T("npiraw.col.width_mm"), DefaultVisible: false),
            new ColumnDef("part_type",          T("npiraw.col.part_type"), DefaultVisible: false),
            new ColumnDef("planner",            T("npiraw.col.planner"), DefaultVisible: false),
            new ColumnDef("acct_group_desc",    T("npiraw.col.acct_group_desc"), DefaultVisible: false),
            new ColumnDef("product_family",     T("npiraw.col.product_family"), DefaultVisible: false),
            new ColumnDef("product_family_desc",T("npiraw.col.product_family_desc"), DefaultVisible: false),
            new ColumnDef("type_designation",   T("npiraw.col.type_designation"), DefaultVisible: false),
            new ColumnDef("thickness",          T("npiraw.col.thickness"), DefaultVisible: false),
            new ColumnDef("leadtime_code",      T("npiraw.col.leadtime_code"), DefaultVisible: false),
        }, PrefStore);
        await LoadAsync();
    }

    private void CloseImport() => _importOpen = false;

    private Task OnImportedAsync()
    {
        _page = 1;
        return LoadAsync();   // refresh the grid; modal stays open to show the result
    }

    private Task OnSearchClickAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await Api.GetRawMaterialsAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                _page, _pageSize);
        }
        catch (ApiException apiEx)
        {
            _error = apiEx.ApiError.MessageEn;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ReloadAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = GridPagination.Clamp(page, TotalPages);
        return LoadAsync();
    }

    private static string ColClass(string columnId) => columnId switch
    {
        "part_no" or "supplier_id" or "supplier_part_no" => "grid-col-mono",
        "price" or "price_incl_tax" or "min_qty"
            or "std_multiple" or "std_pack" or "conversion"
            or "leadtime" or "net_weight"
            or "width_mm" or "thickness"                   => "grid-col-num",
        "mother_code"                                      => "grid-col-mono",
        _                                                  => "",
    };

    private static RenderFragment RenderCell(NpiRawMaterial row, string columnId) => __builder =>
    {
        switch (columnId)
        {
            case "part_no":             __builder.OpenElement(0, "code"); __builder.AddContent(1, row.PartNo); __builder.CloseElement(); break;
            case "part_desc":           __builder.AddContent(0, row.PartDescription ?? "—"); break;
            case "supplier_id":         __builder.AddContent(0, row.SupplierId ?? "—"); break;
            case "supplier_name":       __builder.AddContent(0, row.SupplierName ?? "—"); break;
            case "price":               __builder.AddContent(0, row.Price?.ToString("0.####") ?? "—"); break;
            case "currency":            __builder.AddContent(0, row.Currency ?? "—"); break;
            case "purch_uom":           __builder.AddContent(0, row.PurchUom ?? "—"); break;
            case "inv_uom":             __builder.AddContent(0, row.InventoryUom ?? "—"); break;
            case "site":                __builder.AddContent(0, row.Site ?? "—"); break;
            case "status":              __builder.AddContent(0, row.StatusCode ?? "—"); break;
            case "min_qty":             __builder.AddContent(0, row.MinimumQuantity?.ToString("0.##") ?? "—"); break;
            case "leadtime":            __builder.AddContent(0, row.SupplierLeadtimeDays?.ToString("0.##") ?? "—"); break;
            case "price_incl_tax":      __builder.AddContent(0, row.PriceInclTax?.ToString("0.####") ?? "—"); break;
            case "price_uom":           __builder.AddContent(0, row.PriceUom ?? "—"); break;
            case "site_desc":           __builder.AddContent(0, row.SiteDescription ?? "—"); break;
            case "std_multiple":        __builder.AddContent(0, row.StdMultipleQty?.ToString("0.##") ?? "—"); break;
            case "std_pack":            __builder.AddContent(0, row.StandardPackSize?.ToString("0.##") ?? "—"); break;
            case "conversion":          __builder.AddContent(0, row.ConversionFactor?.ToString("0.####") ?? "—"); break;
            case "tax_code":            __builder.AddContent(0, row.TaxCode ?? "—"); break;
            case "tax_code_desc":       __builder.AddContent(0, row.TaxCodeDescription ?? "—"); break;
            case "country_origin":      __builder.AddContent(0, row.CountryOfOrigin ?? "—"); break;
            case "acquisition_type":    __builder.AddContent(0, row.AcquisitionType ?? "—"); break;
            case "supplier_part_no":    __builder.OpenElement(0, "code"); __builder.AddContent(1, row.SupplierPartNo ?? ""); __builder.CloseElement(); break;
            case "supplier_part_desc":  __builder.AddContent(0, row.SupplierPartDescription ?? "—"); break;
            case "net_weight":          __builder.AddContent(0, row.NetWeight?.ToString("0.##") ?? "—"); break;
            case "net_weight_uom":      __builder.AddContent(0, row.NetWeightUom ?? "—"); break;
            case "next_order_date":     __builder.AddContent(0, row.NextOrderDate ?? "—"); break;
            case "notes":               __builder.AddContent(0, row.Notes ?? "—"); break;
            case "mother_code":         __builder.OpenElement(0, "code"); __builder.AddContent(1, row.MotherCode ?? ""); __builder.CloseElement(); break;
            case "dimension_quality":   __builder.AddContent(0, row.DimensionQuality ?? "—"); break;
            case "width_mm":            __builder.AddContent(0, row.WidthMm?.ToString("0.##") ?? "—"); break;
            case "part_type":           __builder.AddContent(0, row.PartType ?? "—"); break;
            case "planner":             __builder.AddContent(0, row.Planner ?? "—"); break;
            case "acct_group_desc":     __builder.AddContent(0, row.AccountingGroupDescription ?? "—"); break;
            case "product_family":      __builder.AddContent(0, row.ProductFamily ?? "—"); break;
            case "product_family_desc": __builder.AddContent(0, row.ProductFamilyDescription ?? "—"); break;
            case "type_designation":    __builder.AddContent(0, row.TypeDesignation ?? "—"); break;
            case "thickness":           __builder.AddContent(0, row.Thickness?.ToString("0.#####") ?? "—"); break;
            case "leadtime_code":       __builder.AddContent(0, row.LeadTimeCode ?? "—"); break;
        }
    };
}
