@page "/mode"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor")]
@using CCL.MES.Hybrid.Client.Hardware
@using CCL.MES.Shared.Hardware
@implements IDisposable
@inject Microsoft.Extensions.Options.IOptions<HardwareOptions> HwOptions
@inject IDeviceModeService Device

<PageTitle>Mode — CCL MES</PageTitle>

<h1 class="page-title">Station Mode</h1>

@if (!HwOptions.Value.ScanEnabled)
{
    <div class="hw-gate" role="status">
        <strong>Hardware features are turned off.</strong>
        <p>
            The /mode page turns on together with /hardware when the
            <code>Hardware:ScanEnabled = true</code> flag is set. W1 only renders
            the frame; the kiosk + lock-screen logic ships in W4.
        </p>
    </div>
}
else
{
    <p>Station: <code>@Device.DeviceId</code></p>

    <section class="mode-section">
        <h2>Mode</h2>
        <p class="mode-help">
            <strong>Interactive</strong> mode — full screen, no auto
            lock. Used at the office desk / NPI / supervisor.<br />
            <strong>Kiosk</strong> mode — hides the sidebar after the first navigation;
            after N minutes of inactivity → locks the screen (enter the passcode to unlock).
            The JWT is not revoked — only UI access is blocked. Default N=10 minutes.<br />
            <strong>Headless</strong> mode — scanner only, no UI.
            Reserved for P10.4+.
        </p>

        <fieldset class="mode-picker" disabled="@_saving">
            <label>
                <input type="radio" name="mode" value="@((int)DeviceMode.Interactive)"
                       checked="@(Device.CurrentMode == DeviceMode.Interactive)"
                       @onchange="() => OnPickMode(DeviceMode.Interactive)" />
                Interactive
            </label>
            <label>
                <input type="radio" name="mode" value="@((int)DeviceMode.Kiosk)"
                       checked="@(Device.CurrentMode == DeviceMode.Kiosk)"
                       @onchange="() => OnPickMode(DeviceMode.Kiosk)" />
                Kiosk
            </label>
            <label class="mode-disabled">
                <input type="radio" name="mode" value="@((int)DeviceMode.Headless)"
                       disabled />
                Headless (P10.4+)
            </label>
        </fieldset>
    </section>

    <section class="mode-section">
        <h2>Idle threshold (minutes)</h2>
        <p class="mode-help">
            Applies to Kiosk. Range 1..120. Default 10. After a change,
            auto lock on this station uses the new value immediately (no
            need to restart the app).
        </p>
        <input type="number" min="1" max="120" step="1"
               value="@Device.IdleMinutes"
               disabled="@_saving"
               @onchange="OnPickIdleMinutes"
               class="mode-input" />
    </section>

    <section class="mode-section">
        <h2>Device passcode</h2>
        <p class="mode-help">
            Used to unlock the lock-screen in Kiosk mode. This is NOT the
            account password. Stored on this device (not synced to the server).
            Leave blank to clear.
        </p>
        <input type="password"
               placeholder="Enter a new passcode then click Save"
               autocomplete="off"
               disabled="@_saving"
               @bind="_passcodeInput"
               class="mode-input" />
        <button type="button" class="mode-btn"
                disabled="@_saving"
                @onclick="OnSavePasscode">Save passcode</button>
        @if (_passcodeFeedback is not null)
        {
            <div class="mode-feedback">@_passcodeFeedback</div>
        }
    </section>
}

@code {
    private bool _saving;
    private string _passcodeInput = "";
    private string? _passcodeFeedback;

    protected override void OnInitialized()
    {
        Device.OnChange += OnDeviceChanged;
    }

    public void Dispose()
    {
        Device.OnChange -= OnDeviceChanged;
    }

    private void OnDeviceChanged() => InvokeAsync(StateHasChanged);

    private async Task OnPickMode(DeviceMode mode)
    {
        _saving = true;
        try { await Device.SetModeAsync(mode); }
        finally { _saving = false; }
    }

    private async Task OnPickIdleMinutes(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var minutes)) return;
        _saving = true;
        try { await Device.SetIdleMinutesAsync(minutes); }
        finally { _saving = false; }
    }

    private async Task OnSavePasscode()
    {
        _saving = true;
        _passcodeFeedback = null;
        try
        {
            await Device.SetPasscodeAsync(string.IsNullOrEmpty(_passcodeInput) ? null : _passcodeInput);
            _passcodeFeedback = string.IsNullOrEmpty(_passcodeInput)
                ? "Passcode cleared."
                : "Passcode saved.";
            _passcodeInput = "";
        }
        finally { _saving = false; }
    }
}
