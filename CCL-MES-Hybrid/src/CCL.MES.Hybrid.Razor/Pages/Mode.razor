@page "/mode"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor")]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Hybrid.Client.Hardware
@using CCL.MES.Shared.Hardware
@inject Microsoft.Extensions.Options.IOptions<HardwareOptions> HwOptions
@inject IDeviceModeService Device

<PageTitle>@T("mode.page.title")</PageTitle>

<h1 class="page-title">@T("mode.heading")</h1>

@if (!HwOptions.Value.ScanEnabled)
{
    <div class="hw-gate" role="status">
        <strong>@T("mode.gate.title")</strong>
        <p>
            @T("mode.gate.body")
        </p>
    </div>
}
else
{
    <p>@T("mode.station.label") <code>@Device.DeviceId</code></p>

    <section class="mode-section">
        <h2>@T("mode.section.mode")</h2>
        <p class="mode-help">
            <strong>@T("mode.interactive")</strong> @T("mode.help.interactive")<br />
            <strong>@T("mode.kiosk")</strong> @T("mode.help.kiosk")<br />
            <strong>@T("mode.headless")</strong> @T("mode.help.headless")
        </p>

        <fieldset class="mode-picker" disabled="@_saving">
            <label>
                <input type="radio" name="mode" value="@((int)DeviceMode.Interactive)"
                       checked="@(Device.CurrentMode == DeviceMode.Interactive)"
                       @onchange="() => OnPickMode(DeviceMode.Interactive)" />
                @T("mode.interactive")
            </label>
            <label>
                <input type="radio" name="mode" value="@((int)DeviceMode.Kiosk)"
                       checked="@(Device.CurrentMode == DeviceMode.Kiosk)"
                       @onchange="() => OnPickMode(DeviceMode.Kiosk)" />
                @T("mode.kiosk")
            </label>
            <label class="mode-disabled">
                <input type="radio" name="mode" value="@((int)DeviceMode.Headless)"
                       disabled />
                @T("mode.headless.reserved")
            </label>
        </fieldset>
    </section>

    <section class="mode-section">
        <h2>@T("mode.section.idle")</h2>
        <p class="mode-help">
            @T("mode.help.idle")
        </p>
        <input type="number" min="1" max="120" step="1"
               value="@Device.IdleMinutes"
               disabled="@_saving"
               @onchange="OnPickIdleMinutes"
               class="mode-input" />
    </section>

    <section class="mode-section">
        <h2>@T("mode.section.passcode")</h2>
        <p class="mode-help">
            @T("mode.help.passcode")
        </p>
        <input type="password"
               placeholder="@T("mode.passcode.placeholder")"
               autocomplete="off"
               disabled="@_saving"
               @bind="_passcodeInput"
               class="mode-input" />
        <button type="button" class="mode-btn"
                disabled="@_saving"
                @onclick="OnSavePasscode">@T("mode.passcode.save")</button>
        @if (_passcodeFeedback is not null)
        {
            <div class="mode-feedback">@_passcodeFeedback</div>
        }
    </section>
}

@code {
    private bool _saving;
    private string _passcodeInput = "";
    private string? _passcodeFeedback;

    protected override void OnInitialized()
    {
        base.OnInitialized(); // subscribe to language changes (LocalizedComponentBase)
        Device.OnChange += OnDeviceChanged;
    }

    public override void Dispose()
    {
        Device.OnChange -= OnDeviceChanged;
        base.Dispose(); // unsubscribe from language changes
    }

    private void OnDeviceChanged() => InvokeAsync(StateHasChanged);

    private async Task OnPickMode(DeviceMode mode)
    {
        _saving = true;
        try { await Device.SetModeAsync(mode); }
        finally { _saving = false; }
    }

    private async Task OnPickIdleMinutes(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var minutes)) return;
        _saving = true;
        try { await Device.SetIdleMinutesAsync(minutes); }
        finally { _saving = false; }
    }

    private async Task OnSavePasscode()
    {
        _saving = true;
        _passcodeFeedback = null;
        try
        {
            await Device.SetPasscodeAsync(string.IsNullOrEmpty(_passcodeInput) ? null : _passcodeInput);
            _passcodeFeedback = string.IsNullOrEmpty(_passcodeInput)
                ? T("mode.passcode.cleared")
                : T("mode.passcode.saved");
            _passcodeInput = "";
        }
        finally { _saving = false; }
    }
}
