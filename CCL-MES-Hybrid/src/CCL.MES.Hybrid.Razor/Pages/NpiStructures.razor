@page "/npi/structure"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor,Engineer,QC")]
@inject ICclApiClient Api
@inject IGridPreferenceStore PrefStore

<PageTitle>Structure (BOM) — NPI</PageTitle>

<h1 class="page-title">Structure (BOM)</h1>

<div class="grid-toolbar">
    <GridSearchBox @bind-Value="_search" OnSearch="OnSearchClickAsync"
                   Placeholder="Search by part / description…" />
    <button type="button" class="grid-btn" @onclick="OnSearchClickAsync" disabled="@_loading">Search</button>
    <button type="button" class="grid-btn" @onclick="ReloadAsync" disabled="@_loading">Reload</button>
    <AuthorizeView Roles="Admin,Supervisor,Engineer" Context="impCtx">
        <button type="button" class="grid-btn grid-btn-primary" @onclick="() => _importOpen = true" disabled="@_loading">⤓ Import…</button>
    </AuthorizeView>
    <div class="grid-toolbar-spacer"></div>
    <GridColumnsMenu Columns="_columns" OnChanged="StateHasChanged" />
</div>

@if (_loading && _data is null)
{
    <p class="grid-status">Loading…</p>
}
else if (_error is not null)
{
    <div class="grid-error" role="alert">
        <strong>Failed to load data.</strong>
        <div>@_error</div>
        <button type="button" class="grid-btn" @onclick="ReloadAsync">Retry</button>
    </div>
}
else if (_data is not null)
{
    <div class="grid-scroll">
        <table class="grid grid-sticky">
            <thead>
                <tr>
                    @foreach (var col in _columns.Visible)
                    {
                        <th class="grid-h @ColClass(col.Id)">@col.Label</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _data.Items)
                {
                    <tr>
                        @foreach (var col in _columns.Visible)
                        {
                            <td>@RenderCell(row, col.Id)</td>
                        }
                    </tr>
                }
                @if (_data.Items.Count == 0)
                {
                    <tr>
                        <td colspan="@_columns.Visible.Count" class="grid-empty">
                            No matching data.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="grid-pager">
        <button type="button" class="grid-btn"
                disabled="@(GridPagination.IsFirstPage(_page) || _loading)"
                @onclick="() => GoToPageAsync(_page - 1)">‹ Previous</button>
        <span class="grid-pager-text">
            Page @_page / @TotalPages — @_data.Total rows
        </span>
        <button type="button" class="grid-btn"
                disabled="@(GridPagination.IsLastPage(_page, TotalPages) || _loading)"
                @onclick="() => GoToPageAsync(_page + 1)">Next ›</button>
    </div>

    <GridAutoFit OnFit="SetPageSizeAsync" />
}

<NpiImportModal Kind="structures" Open="_importOpen"
                OnClose="CloseImport" OnImported="OnImportedAsync" />

@code {
    private NpiPagedRaw<NpiStructure>? _data;
    private bool _loading;
    private string? _error;
    private string _search = "";
    private bool _importOpen;
    private int _page = 1;
    private int _pageSize = 50;
    private GridColumns _columns = default!;

    private int TotalPages => GridPagination.TotalPages(_data?.Total ?? 0, _pageSize);

    // P10.10 — GridAutoFit reports how many rows fit the viewport; resize the
    // page to fill it, then clamp the current page into the new range.
    private async Task SetPageSizeAsync(int rows)
    {
        if (rows <= 0 || rows == _pageSize) return;
        _pageSize = rows;
        _page = GridPagination.Clamp(_page, GridPagination.TotalPages(_data?.Total ?? 0, rows));
        await LoadAsync();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // 16 columns from Phase 7 hạng mục 1. All default visible — the
        // grid is wide but operators benefit from full BOM context.
        _columns = new GridColumns("structure", new[]
        {
            new ColumnDef("parent_part",          "Parent Part"),
            new ColumnDef("parent_desc",          "Parent Part Description"),
            new ColumnDef("component_part",       "Component Part"),
            new ColumnDef("component_desc",       "Component Part Description"),
            new ColumnDef("qty_assembly",         "Quantity"),
            new ColumnDef("uom",                  "UOM"),
            new ColumnDef("scrap_factor",         "Scrap Factor"),
            new ColumnDef("scrap_pct",            "Scrap %", DefaultVisible: false),
            new ColumnDef("pitch",                "Pitch", DefaultVisible: false),
            new ColumnDef("cavity",               "Cavity", DefaultVisible: false),
            new ColumnDef("color",                "Color", DefaultVisible: false),
            new ColumnDef("structure_type",       "Structure Type", DefaultVisible: false),
            new ColumnDef("alt",                  "Alt", DefaultVisible: false),
            new ColumnDef("effectivity",          "Effectivity", DefaultVisible: false),
            new ColumnDef("effectivity_date",     "Effectivity Date", DefaultVisible: false),
            new ColumnDef("planner",              "Planner", DefaultVisible: false),
        }, PrefStore);
        await LoadAsync();
    }

    private void CloseImport() => _importOpen = false;

    private Task OnImportedAsync()
    {
        _page = 1;
        return LoadAsync();   // refresh the grid; modal stays open to show the result
    }

    private Task OnSearchClickAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await Api.GetStructuresAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                _page, _pageSize);
        }
        catch (ApiException apiEx)
        {
            _error = apiEx.ApiError.MessageEn;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ReloadAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = GridPagination.Clamp(page, TotalPages);
        return LoadAsync();
    }

    private static string ColClass(string columnId) => columnId switch
    {
        "parent_part" or "component_part"               => "grid-col-mono",
        "qty_assembly" or "scrap_factor" or "scrap_pct"
            or "pitch" or "cavity"                       => "grid-col-num",
        _                                                => "",
    };

    private static RenderFragment RenderCell(NpiStructure row, string columnId) => __builder =>
    {
        switch (columnId)
        {
            case "parent_part":     __builder.OpenElement(0, "code"); __builder.AddContent(1, row.ParentPart); __builder.CloseElement(); break;
            case "parent_desc":     __builder.AddContent(0, row.ParentDescription ?? "—"); break;
            case "component_part":  __builder.OpenElement(0, "code"); __builder.AddContent(1, row.ComponentPart); __builder.CloseElement(); break;
            case "component_desc":  __builder.AddContent(0, row.ComponentDescription ?? "—"); break;
            case "qty_assembly":    __builder.AddContent(0, row.QtyAssembly.ToString("0.######")); break;
            case "uom":             __builder.AddContent(0, row.Uom ?? "—"); break;
            case "scrap_factor":    __builder.AddContent(0, row.ScrapFactor.ToString("0.######")); break;
            case "scrap_pct":       __builder.AddContent(0, row.ScrapPct?.ToString("0.##") ?? "—"); break;
            case "pitch":           __builder.AddContent(0, row.Pitch?.ToString("0.##") ?? "—"); break;
            case "cavity":          __builder.AddContent(0, row.Cavity?.ToString("0.##") ?? "—"); break;
            case "color":           __builder.AddContent(0, row.Color ?? "—"); break;
            case "structure_type":  __builder.AddContent(0, row.StructureType ?? "—"); break;
            case "alt":             __builder.AddContent(0, row.Alt ?? "—"); break;
            case "effectivity":     __builder.AddContent(0, row.Effectivity ?? "—"); break;
            case "effectivity_date":__builder.AddContent(0, row.EffectivityDate ?? "—"); break;
            case "planner":         __builder.AddContent(0, row.Planner ?? "—"); break;
        }
    };
}
