@page "/quality/traceability"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor,QC")]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Quality
@using CCL.MES.Hybrid.Client.Hardware
@using CCL.MES.Hybrid.Client.Realtime
@inject ICclApiClient Api
@inject IBarcodeScannerService Scanner
@inject IShopfloorLiveService Live
@inject Microsoft.Extensions.Options.IOptions<HardwareOptions> HwOptions
@inject IJSRuntime JS
@inject CCL.MES.Hybrid.Client.Windows.IFloatingWindowStore WinStore

@*
    Quality → Traceability. Lists Work Orders that have ≥1 FROZEN snapshot
    (append-only WoTraceSnapshots). Search by scan or typing (WoNo,
    case-insensitive). Double-click a row → TraceabilityDetailDialog with 4
    sub-tabs [Product|IPQC|FQC|OQC], each rendered from the DEAD PayloadJson
    (no live source read). A phase not yet frozen shows an empty-state tab.
*@

<PageTitle>@T("qualtrace.page.title")</PageTitle>
<PageHead TitleKey="qualtrace.heading" />

<div class="grid-toolbar">
    <GridSearchBox @bind-Value="_search" OnSearch="OnSearchAsync"
                   Placeholder="@T("qualtrace.search.placeholder")" />
    @if (HwOptions.Value.ScanEnabled)
    {
        <button type="button" class="grid-btn" @onclick="OnScanAsync" disabled="@(_scanning || _loading)">
            @(_scanning ? T("qualtrace.scanning") : $"⧉ {T("qualtrace.scan")}")
        </button>
    }
    <button type="button" class="grid-btn" @onclick="OnSearchAsync" disabled="@_loading">@T("qualtrace.search")</button>
    @if (_wins.Count > 0)
    {
        <button type="button" class="grid-btn" @onclick="ResetWindowsAsync"
                title="@T("qualtrace.reset.title")">⤢ @T("qualtrace.reset")</button>
    }
    <div class="grid-toolbar-spacer"></div>
    <span class="trace-live @(Live.IsConnected ? "trace-live-on" : "trace-live-off")"
          title="@(Live.IsConnected ? T("qualtrace.live.on.title") : T("qualtrace.live.off.title"))">
        @(Live.IsConnected ? $"● {T("qualtrace.live.on")}" : $"○ {T("qualtrace.live.off")}")
    </span>
</div>

@if (_scanStatus is not null) { <div class="trace-scan-status">@_scanStatus</div> }

@if (_loading && _data is null)
{
    <p class="grid-status">@T("qualtrace.loading")</p>
}
else if (_error is not null)
{
    <div class="grid-error" role="alert">
        <strong>@T("qualtrace.load.failed")</strong>
        <div>@_error</div>
        <button type="button" class="grid-btn" @onclick="OnSearchAsync">@T("qualtrace.retry")</button>
    </div>
}
else if (_data is not null)
{
    <div class="grid-scroll">
        <table class="grid grid-sticky trace-grid">
            <thead>
                <tr>
                    <th class="grid-h">@T("qualtrace.col.workorder")</th>
                    <th class="grid-h">@T("qualtrace.col.product")</th>
                    <th class="grid-h">@T("qualtrace.col.mesphase")</th>
                    <th class="grid-h">@T("qualtrace.col.frozenphases")</th>
                    <th class="grid-h">@T("qualtrace.col.lastscan")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _data.Items)
                {
                    <tr class="trace-row" @ondblclick="() => OpenDetail(r.WoNo)" title="@T("qualtrace.row.dblclick")">
                        <td>
                            <div><code>@r.WoNo</code></div>
                            @if (!string.IsNullOrEmpty(r.Customer)) { <div class="trace-sub">@r.Customer</div> }
                        </td>
                        <td>
                            <div>@r.ProductName</div>
                            @if (!string.IsNullOrEmpty(r.ProductCode)) { <div class="trace-sub">@r.ProductCode</div> }
                        </td>
                        <td><span class="trace-chip trace-chip-pending">@r.CurrentMesPhase</span></td>
                        <td>
                            @foreach (var ph in TracePhase.All)
                            {
                                <span class="trace-chip @(r.FrozenPhases.Contains(ph) ? "trace-chip-ok" : "trace-chip-none")">@PhaseLabel(ph)</span>
                            }
                        </td>
                        <td class="trace-mono">@r.LastScannedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                @if (_data.Items.Count == 0)
                {
                    <tr><td colspan="5" class="grid-empty">@T("qualtrace.empty")</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="grid-pager">
        <button type="button" class="grid-btn" disabled="@(_page <= 1 || _loading)" @onclick="() => GoToPageAsync(_page - 1)">‹ @T("qualtrace.pager.previous")</button>
        <span class="grid-pager-text">@T("qualtrace.pager.status", _page, TotalPages, _data.Total)</span>
        <button type="button" class="grid-btn" disabled="@(_page >= TotalPages || _loading)" @onclick="() => GoToPageAsync(_page + 1)">@T("qualtrace.pager.next") ›</button>
    </div>

    <GridAutoFit OnFit="SetPageSizeAsync" />
}

@* Floating showcards — several open at once, each independent, non-modal
   so the list underneath stays usable while a card is open/dragged. *@
@foreach (var w in _wins)
{
    <TraceabilityDetailDialog @key="w.Id" WoNo="@w.WoNo" WindowId="@w.Id"
                              Rect="w.Rect" CascadeIndex="w.Cascade"
                              OnRectChanged="r => OnWinRectChanged(w.WoNo, r)"
                              OnClose="() => CloseDetail(w.Id)" />
}

@code {
    private NpiPagedRaw<TraceListRow>? _data;
    private bool _loading;
    private string? _error;
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 50;
    private bool _scanning;
    private string? _scanStatus;

    // Open floating showcards (max MaxWindows concurrently). Each carries a
    // stable Id shared with floating-window.js + its restored/session rect.
    private sealed record OpenWin(string WoNo, string Id, CCL.MES.Hybrid.Client.Windows.WindowRect? Rect, int Cascade);
    private readonly List<OpenWin> _wins = new();
    private const int MaxWindows = 6;

    private System.Threading.Timer? _debounce;
    private System.Threading.Timer? _poll;

    private int TotalPages => _data is null || _data.Total <= 0 ? 1 : (int)Math.Ceiling(_data.Total / (double)_pageSize);

    // P1 — GridAutoFit reports how many rows fit the viewport; resize the page
    // to fill it (kill the dead space below a short page), then clamp the
    // current page into the new range. Mirrors NpiRawMaterials.SetPageSizeAsync.
    private async Task SetPageSizeAsync(int rows)
    {
        if (rows <= 0 || rows == _pageSize) return;
        _pageSize = rows;
        var total = _data?.Total ?? 0;
        var pages = total <= 0 ? 1 : (int)Math.Ceiling(total / (double)rows);
        _page = _page < 1 ? 1 : (_page > pages ? pages : _page);
        await LoadAsync();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        Live.Changed += OnLiveChanged;
        Live.StateChanged += OnLiveStateChanged;
        await Live.EnsureStartedAsync();
        UpdatePolling();
        await LoadAsync();
    }

    // notify-then-pull: any change reason re-pulls the list; debounce a burst
    // of scans into a single reload (~400ms).
    private void OnLiveChanged(string reason)
    {
        _debounce?.Dispose();
        _debounce = new System.Threading.Timer(
            _ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }),
            null, 400, System.Threading.Timeout.Infinite);
    }

    private void OnLiveStateChanged()
        => InvokeAsync(() => { UpdatePolling(); StateHasChanged(); });

    // Fallback: when the hub is down, poll every 20s; stop once it reconnects.
    private void UpdatePolling()
    {
        if (Live.IsConnected)
        {
            _poll?.Dispose(); _poll = null;
        }
        else if (_poll is null)
        {
            _poll = new System.Threading.Timer(
                _ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }),
                null, 20000, 20000);
        }
    }

    private Task OnSearchAsync() { _page = 1; return LoadAsync(); }
    private Task GoToPageAsync(int page) { _page = page < 1 ? 1 : (page > TotalPages ? TotalPages : page); return LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try { _data = await Api.GetTraceabilityAsync(string.IsNullOrWhiteSpace(_search) ? null : _search, _page, _pageSize); }
        catch (ApiException apiEx) { _error = apiEx.ApiError.MessageEn; }
        catch (HttpRequestException ex) { _error = T("qualtrace.error.connect", ex.Message); }
        catch (Exception ex) { _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task OnScanAsync()
    {
        _scanning = true; _scanStatus = null;
        try
        {
            var result = await Scanner.ScanOnceAsync();
            if (result is null) { _scanStatus = T("qualtrace.scan.cancelled"); return; }
            _search = result.Code.Trim();
            _scanStatus = T("qualtrace.scan.scanned", _search);
            _page = 1;
            await LoadAsync();
        }
        catch (Exception ex) { _scanStatus = T("qualtrace.scan.error", $"{ex.GetType().Name}: {ex.Message}"); }
        finally { _scanning = false; }
    }

    // Double-click a row → open (or focus) its floating showcard.
    private async Task OpenDetail(string woNo)
    {
        var existing = _wins.FirstOrDefault(w => string.Equals(w.WoNo, woNo, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            // Already open — just bring it to the front instead of duplicating.
            try { await JS.InvokeVoidAsync("cclMesFloat.bringToFront", existing.Id); } catch { /* JS absent */ }
            return;
        }
        if (_wins.Count >= MaxWindows)
        {
            _scanStatus = T("qualtrace.win.max", MaxWindows);
            return;
        }
        _scanStatus = null;
        _wins.Add(new OpenWin(woNo, Guid.NewGuid().ToString("N"), WinStore.Get(woNo), _wins.Count));
    }

    private void CloseDetail(string id)
        => _wins.RemoveAll(w => w.Id == id);

    // Persist a card's final rect so re-opening the same WO restores it.
    private void OnWinRectChanged(string woNo, CCL.MES.Hybrid.Client.Windows.WindowRect rect)
        => WinStore.Save(woNo, rect);

    // Toolbar "reset" — recenter every open card + forget saved positions.
    private async Task ResetWindowsAsync()
    {
        WinStore.Clear();
        for (var i = 0; i < _wins.Count; i++)
        {
            try { await JS.InvokeVoidAsync("cclMesFloat.recenter", _wins[i].Id, i); } catch { /* JS absent */ }
        }
    }

    public override void Dispose()
    {
        Live.Changed -= OnLiveChanged;
        Live.StateChanged -= OnLiveStateChanged;
        _debounce?.Dispose();
        _poll?.Dispose();
        base.Dispose(); // unsubscribe from language changes (LocalizedComponentBase)
    }

    private static string PhaseLabel(string phase) => phase switch
    {
        TracePhase.Product => "Product",
        TracePhase.Ipqc => "IPQC",
        TracePhase.Fqc => "FQC",
        TracePhase.Oqc => "OQC",
        _ => phase,
    };
}
