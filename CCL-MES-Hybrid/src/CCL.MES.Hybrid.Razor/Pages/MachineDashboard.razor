@page "/machines"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Globalization
@using System.Linq
@using CCL.MES.Shared.Machines
@inject ICclApiClient Api

<PageTitle>Machine Dashboard — CCL MES</PageTitle>

<div class="md-head">
    <div>
        <h1 class="page-title">Machine Monitoring · Plant Floor</h1>
        <div class="md-subtitle">Live status across all work centers · grouped by area</div>
    </div>
    <div class="md-head-actions">
        <div class="md-viewtoggle" role="group" aria-label="View mode">
            <button type="button" class="md-vt-btn @(_viewMode == MdView.Grid ? "is-on" : "")"
                    title="Grid view" aria-pressed="@(_viewMode == MdView.Grid)"
                    @onclick="@(() => _viewMode = MdView.Grid)">
                <span class="md-vt-ico">▦</span><span class="md-vt-lbl">Grid</span>
            </button>
            <button type="button" class="md-vt-btn @(_viewMode == MdView.List ? "is-on" : "")"
                    title="List view" aria-pressed="@(_viewMode == MdView.List)"
                    @onclick="@(() => _viewMode = MdView.List)">
                <span class="md-vt-ico">☰</span><span class="md-vt-lbl">List</span>
            </button>
        </div>
        <button type="button" class="md-refresh" @onclick="ReloadAsync" disabled="@_loading">
            @(_loading ? "Loading…" : "↻ Refresh")
        </button>
    </div>
</div>

@* SpecHub Machine-Monitoring parity — plant KPI tiles (Running / Idle /
   Setup / Down / Maintenance + Plant Quality), status/area/search filters,
   area-grouped machine CARDS, real-data detail drawer. Status derives from
   the active WO's MesPhase; Quality% = good /(good+reject) from the cached
   qty ledger (honest — no fabricated OEE/speed). Down/Maintenance tiles are
   shown for SpecHub parity and light up when the ProductionLog feed lands. *@
<div class="md-kpi-grid">
    <div class="md-kpi md-kpi-running"><div class="md-kpi-num">@CountStatus("Running")</div><div class="md-kpi-label">Running</div></div>
    <div class="md-kpi md-kpi-idle"><div class="md-kpi-num">@CountStatus("Idle")</div><div class="md-kpi-label">Idle</div></div>
    <div class="md-kpi md-kpi-setup"><div class="md-kpi-num">@CountStatus("Setup")</div><div class="md-kpi-label">Setup</div></div>
    <div class="md-kpi md-kpi-down"><div class="md-kpi-num">@CountStatus("Down")</div><div class="md-kpi-label">Down</div></div>
    <div class="md-kpi md-kpi-maint"><div class="md-kpi-num">@CountStatus("Maintenance")</div><div class="md-kpi-label">Maintenance</div></div>
    <div class="md-kpi md-kpi-wide md-kpi-oee">
        <div class="md-kpi-label">Plant Quality</div>
        <div class="md-kpi-num md-kpi-oee-num">@(PlantQuality is { } q ? $"{q:0}%" : "—")</div>
        <div class="md-kpi-bar"><div class="md-kpi-bar-fill" style="width:@((PlantQuality ?? 0).ToString("0", CultureInfo.InvariantCulture))%"></div></div>
        <div class="md-kpi-oee-sub">@TodayOutput.ToString("N0") pcs produced · @CountStatus("Running") active</div>
    </div>
</div>

@if (_loading && _data is null)
{
    <p class="md-muted">Loading machines…</p>
}
else if (_error is not null)
{
    <p class="md-error">Failed to load machines: @_error</p>
}
else if (_data is null || _data.Machines.Count == 0)
{
    <p class="md-muted">No work centers.</p>
}
else
{
    <div class="md-filters">
        <input class="md-search" type="text" placeholder="🔍 Search WC code, WO, product, customer…"
               value="@_search" @oninput="OnSearch" />
        <span class="md-filter-count">@Filtered.Count / @AllMachines.Count machines</span>
        <div class="md-chips">
            @foreach (var s in StatusChips)
            {
                <button type="button" class="md-chip @(_statusFilter == s.Key ? "md-chip-on" : "")"
                        @onclick="@(() => _statusFilter = s.Key)">@s.Label</button>
            }
        </div>
        <div class="md-chips">
            <button type="button" class="md-chip @(_areaFilter is null ? "md-chip-on" : "")"
                    @onclick="@(() => _areaFilter = null)">All areas</button>
            @foreach (var area in Areas)
            {
                <button type="button" class="md-chip @(_areaFilter == area ? "md-chip-on" : "")"
                        @onclick="@(() => _areaFilter = area)">@area</button>
            }
        </div>
    </div>

    <div class="md-content">
        <div class="md-main">
            @if (Filtered.Count == 0)
            {
                <p class="md-muted">No machines match the filter.</p>
            }
            else if (_viewMode == MdView.List)
            {
                <div class="md-list-scroll">
                <table class="md-list-tbl">
                    <thead>
                        <tr>
                            <th>Work center</th>
                            <th>Area</th>
                            <th>Status</th>
                            <th>WO</th>
                            <th>Customer</th>
                            <th>Product</th>
                            <th>Progress</th>
                            <th class="num">Good</th>
                            <th class="num">Reject</th>
                            <th class="num">Quality</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Grouped)
                        {
                            @foreach (var m in group.ToList())
                            {
                                <tr class="md-list-row md-list-@m.Status.ToLowerInvariant()"
                                    @onclick="@(() => OpenDetailAsync(m.WorkCenterId))">
                                    <td><strong>@m.Code</strong><div class="md-list-sub">@m.Description</div></td>
                                    <td>@group.Key</td>
                                    <td><span class="md-pill @PillClass(m.Status)">@StatusLabel(m.Status)</span></td>
                                    <td>@(m.ActiveWoNo is { } wo ? wo : "—")</td>
                                    <td>@(m.CustomerName ?? "—")</td>
                                    <td>@(m.ProductName ?? m.ActiveMesPhase ?? "—")</td>
                                    <td>
                                        @if (m.ActiveWoNo is not null)
                                        {
                                            <div class="md-list-prog">
                                                <span>@((m.QtyDone ?? 0).ToString("N0")) / @((m.TargetQty ?? 0).ToString("N0")) @(m.Uom ?? "pcs")</span>
                                                <span class="md-list-pct">@(Pct(m) is { } p ? $"{p}%" : "—")</span>
                                            </div>
                                            <div class="md-mc-prog-bar"><div class="md-mc-prog-fill" style="width:@((Pct(m) ?? 0))%"></div></div>
                                        }
                                        else
                                        {
                                            <span class="md-muted">— idle —</span>
                                        }
                                    </td>
                                    <td class="num">@(m.ActiveWoNo is not null ? (m.QtyDone ?? 0).ToString("N0") : "—")</td>
                                    <td class="num">@(m.ActiveWoNo is not null ? (m.QtyNg ?? 0).ToString("N0") : "—")</td>
                                    <td class="num">@(Yield(m) is { } y ? $"{y.ToString("0.0", CultureInfo.InvariantCulture)}%" : "—")</td>
                                    <td class="md-list-upd">@(Elapsed(m.LastUpdatedAt) is { Length: > 0 } el ? el : "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                </div>
            }
            else
            {
                @foreach (var group in Grouped)
                {
                    var list = group.ToList();
                    <section class="md-area">
                        <div class="md-area-head">
                            <span class="md-area-name">@group.Key</span>
                            <span class="md-area-count">· @list.Count machines · Quality @(GroupQuality(list) is { } gq ? $"{gq:0}%" : "—")</span>
                            <span class="md-area-stats">
                                @foreach (var s in StatusChips.Skip(1))
                                {
                                    var n = list.Count(m => m.Status == s.Key);
                                    if (n > 0)
                                    {
                                        <span class="md-area-stat md-area-stat-@s.Key.ToLowerInvariant()">@StatusGlyph(s.Key) @n</span>
                                    }
                                }
                            </span>
                        </div>
                        <div class="md-card-grid">
                            @foreach (var m in list)
                            {
                                <article class="md-mc-card md-mc-@m.Status.ToLowerInvariant() md-row"
                                         @onclick="@(() => OpenDetailAsync(m.WorkCenterId))">
                                    <div class="md-mc-head">
                                        <div class="md-mc-head-l">
                                            <div class="md-mc-code">@m.Code</div>
                                            <div class="md-mc-desc">@m.Description</div>
                                        </div>
                                        <div class="md-mc-head-r">
                                            <span class="md-pill @PillClass(m.Status)">@StatusLabel(m.Status)</span>
                                            @if (Elapsed(m.LastUpdatedAt) is { Length: > 0 } el)
                                            {
                                                <span class="md-mc-elapsed">@el</span>
                                            }
                                        </div>
                                    </div>

                                    @if (m.ActiveWoNo is not null)
                                    {
                                        <div class="md-mc-job">
                                            <div class="md-mc-job-head">
                                                <strong class="md-mc-wo">@m.ActiveWoNo</strong>
                                                <span class="md-mc-cust">@(m.CustomerName ?? "")</span>
                                            </div>
                                            <div class="md-mc-prod">@(m.ProductName ?? m.ActiveMesPhase ?? "")</div>
                                            <div class="md-mc-prog-row">
                                                <span class="md-mc-prog-num"><strong>@((m.QtyDone ?? 0).ToString("N0"))</strong> / @((m.TargetQty ?? 0).ToString("N0")) @(m.Uom ?? "pcs")</span>
                                                <span class="md-mc-prog-pct">@(Pct(m) is { } p ? $"{p}%" : "—")</span>
                                            </div>
                                            <div class="md-mc-prog-bar"><div class="md-mc-prog-fill" style="width:@((Pct(m) ?? 0))%"></div></div>
                                        </div>

                                        <div class="md-mc-stats">
                                            <div class="md-mc-stat">
                                                <div class="md-mc-stat-lbl">Good</div>
                                                <div class="md-mc-stat-num">@((m.QtyDone ?? 0).ToString("N0"))</div>
                                                <div class="md-mc-stat-sub">@(Yield(m) is { } y ? $"Yield {y.ToString("0.0", CultureInfo.InvariantCulture)}%" : "—")</div>
                                            </div>
                                            <div class="md-mc-stat">
                                                <div class="md-mc-stat-lbl">Reject</div>
                                                <div class="md-mc-stat-num">@((m.QtyNg ?? 0).ToString("N0"))</div>
                                                <div class="md-mc-stat-sub">@(Defect(m) is { } d ? $"{d.ToString("0.0", CultureInfo.InvariantCulture)}% defect" : "—")</div>
                                            </div>
                                            <div class="md-mc-stat">
                                                <div class="md-mc-stat-lbl">Produced</div>
                                                <div class="md-mc-stat-num">@(Produced(m).ToString("N0"))</div>
                                                <div class="md-mc-stat-sub">@(m.ActiveMesPhase ?? "—")</div>
                                            </div>
                                        </div>

                                        <div class="md-mc-foot">
                                            <div class="md-mc-q-line">
                                                <span class="md-mc-q-lbl">Quality</span>
                                                <strong class="md-mc-q-val">@(Yield(m) is { } qy ? $"{qy.ToString("0.0", CultureInfo.InvariantCulture)}%" : "—")</strong>
                                            </div>
                                            <div class="md-mc-q-bar"><div class="md-mc-q-fill" style="width:@((Yield(m) ?? 0).ToString("0.#", CultureInfo.InvariantCulture))%"></div></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="md-mc-job md-mc-job-idle">
                                            <div class="md-mc-job-head">
                                                <strong class="md-mc-idle-txt">◯ Idle · waiting for WO</strong>
                                            </div>
                                            <div class="md-mc-prod">No active work order on this machine.</div>
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }
            }
        </div>

        <aside class="md-side">
            <div class="md-side-card">
                <div class="md-side-head">Recent Activity</div>
                <div class="md-side-body md-activity">
                    @if (RecentActivity.Count == 0)
                    {
                        <div class="md-side-empty">No active machines.</div>
                    }
                    else
                    {
                        @foreach (var m in RecentActivity)
                        {
                            <div class="md-activity-row">
                                <span class="md-activity-time">@(m.LastUpdatedAt?.ToLocalTime().ToString("HH:mm") ?? "—")</span>
                                <span class="md-activity-text">
                                    <strong>@m.Code</strong> · @m.ActiveWoNo · @m.ActiveMesPhase
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="md-side-card">
                <div class="md-side-head">Needs Attention</div>
                <div class="md-side-body">
                    @if (Alerts.Count == 0)
                    {
                        <div class="md-side-empty">No quality alerts.</div>
                    }
                    else
                    {
                        @foreach (var m in Alerts)
                        {
                            <div class="md-alert">
                                <strong>@m.Code</strong> — @(Defect(m)!.Value.ToString("0.0", CultureInfo.InvariantCulture))% defect on @m.ActiveWoNo
                            </div>
                        }
                    }
                </div>
            </div>
        </aside>
    </div>
}

@* Per-machine detail drawer. Opens on card click, fetches
   GET /machines/{id}/detail. *@
@if (_detailOpen)
{
    <div class="md-drawer-overlay" @onclick="CloseDetail"></div>
    <aside class="md-drawer">
        <div class="md-drawer-head">
            <h2 class="md-drawer-title">@(_detail?.Code ?? "Machine detail")</h2>
            <button type="button" class="md-drawer-close" @onclick="CloseDetail">✕</button>
        </div>
        @if (_detailLoading)
        {
            <p class="md-muted">Loading detail…</p>
        }
        else if (_detail is null)
        {
            <p class="md-muted">No machine data.</p>
        }
        else
        {
            <div class="md-drawer-body">
                <div class="md-kv"><span>Description</span><strong>@_detail.Description</strong></div>
                <div class="md-kv"><span>Area</span><strong>@(_detail.Area ?? "—")</strong></div>
                <div class="md-kv"><span>Status</span><strong><span class="md-pill @PillClass(_detail.Status)">@StatusLabel(_detail.Status)</span></strong></div>

                <h3 class="md-drawer-sub">Active WO</h3>
                @if (_detail.ActiveWo is not null)
                {
                    <div class="md-kv"><span>@_detail.ActiveWo.WoNo</span><strong>@_detail.ActiveWo.MesPhase</strong></div>
                    <div class="md-kv"><span>Progress</span><strong>@RowProgress(_detail.ActiveWo)</strong></div>
                }
                else
                {
                    <p class="md-muted">No active WO.</p>
                }

                <h3 class="md-drawer-sub">Today</h3>
                <div class="md-today">
                    <div class="md-today-cell"><div class="md-today-num">@_detail.TodayWoCount</div><div class="md-today-lbl">WO</div></div>
                    <div class="md-today-cell"><div class="md-today-num">@_detail.TodayGood</div><div class="md-today-lbl">Good</div></div>
                    <div class="md-today-cell"><div class="md-today-num">@_detail.TodayNg</div><div class="md-today-lbl">NG</div></div>
                </div>

                <h3 class="md-drawer-sub">Recent WOs</h3>
                @if (_detail.RecentWos.Count == 0)
                {
                    <p class="md-muted">No WOs.</p>
                }
                else
                {
                    <table class="md-table">
                        <thead><tr><th>WO</th><th>Phase</th><th>Progress</th></tr></thead>
                        <tbody>
                            @foreach (var w in _detail.RecentWos)
                            {
                                <tr><td>@w.WoNo</td><td>@w.MesPhase</td><td>@RowProgress(w)</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </aside>
}

@code {
    private enum MdView { Grid, List }
    private MdView _viewMode = MdView.Grid;   // card grid default; ☰ switches to a flat table

    private MachineDashboardDto? _data;
    private bool _loading = true;
    private string? _error;

    private string _search = "";
    private string _statusFilter = "All";   // All | Running | Setup | Idle | Down | Maintenance
    private string? _areaFilter;             // null = all areas

    private bool _detailOpen;
    private bool _detailLoading;
    private MachineDetailDto? _detail;

    private static readonly (string Key, string Label)[] StatusChips =
    {
        ("All", "All"), ("Running", "▶ Running"), ("Idle", "◯ Idle"), ("Setup", "⚙ Setup"),
        ("Down", "🛑 Down"), ("Maintenance", "🔧 PM"),
    };

    private const string NoArea = "Other";

    private IReadOnlyList<MachineDashboardItem> AllMachines
        => _data?.Machines ?? Array.Empty<MachineDashboardItem>();

    private int CountStatus(string status) => AllMachines.Count(m => m.Status == status);

    private double TodayOutput => AllMachines.Sum(m => (double)(m.QtyDone ?? 0));

    private double? PlantQuality
    {
        get
        {
            var ys = AllMachines.Select(Yield).Where(y => y is not null).Select(y => y!.Value).ToList();
            return ys.Count == 0 ? null : ys.Average();
        }
    }

    private List<MachineDashboardItem> RecentActivity => AllMachines
        .Where(m => m.ActiveWoNo is not null)
        .OrderByDescending(m => m.LastUpdatedAt ?? DateTime.MinValue)
        .Take(12).ToList();

    private List<MachineDashboardItem> Alerts => AllMachines
        .Where(m => Defect(m) is { } d && d >= 5.0)
        .OrderByDescending(m => Defect(m))
        .Take(8).ToList();

    private List<string> Areas => AllMachines
        .Select(m => string.IsNullOrWhiteSpace(m.Area) ? NoArea : m.Area!)
        .Distinct().OrderBy(a => a).ToList();

    private List<MachineDashboardItem> Filtered => AllMachines.Where(m =>
        (_statusFilter == "All" || m.Status == _statusFilter)
        && (_areaFilter is null || (string.IsNullOrWhiteSpace(m.Area) ? NoArea : m.Area) == _areaFilter)
        && (string.IsNullOrWhiteSpace(_search)
            || m.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || m.Description.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (m.ActiveWoNo ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (m.ProductName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (m.CustomerName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private IEnumerable<IGrouping<string, MachineDashboardItem>> Grouped => Filtered
        .GroupBy(m => string.IsNullOrWhiteSpace(m.Area) ? NoArea : m.Area!)
        .OrderBy(g => g.Key);

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private async Task OpenDetailAsync(long wcId)
    {
        _detailOpen = true;
        _detailLoading = true;
        _detail = null;
        try { _detail = await Api.GetMachineDetailAsync(wcId); }
        catch { _detail = null; }
        finally { _detailLoading = false; }
    }

    private void CloseDetail()
    {
        _detailOpen = false;
        _detail = null;
    }

    // ── per-machine derived metrics (real, from the cached qty ledger) ──
    private static int Produced(MachineDashboardItem m) => (m.QtyDone ?? 0) + (m.QtyNg ?? 0);

    private static double? Yield(MachineDashboardItem m)
    {
        var p = Produced(m);
        return p == 0 ? null : 100.0 * (m.QtyDone ?? 0) / p;
    }

    private static double? Defect(MachineDashboardItem m)
    {
        var p = Produced(m);
        return p == 0 ? null : 100.0 * (m.QtyNg ?? 0) / p;
    }

    private static double? GroupQuality(IEnumerable<MachineDashboardItem> list)
    {
        var ys = list.Select(Yield).Where(y => y is not null).Select(y => y!.Value).ToList();
        return ys.Count == 0 ? null : ys.Average();
    }

    private static int? Pct(MachineDashboardItem m)
    {
        if (m.QtyDone is null || m.TargetQty is null || m.TargetQty == 0) return null;
        return (int)Math.Min(100, Math.Round(100.0 * m.QtyDone.Value / m.TargetQty.Value));
    }

    private static string Elapsed(DateTime? at)
    {
        if (at is null) return "";
        var span = DateTime.UtcNow - at.Value;
        if (span.TotalSeconds < 0) return "";
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h{span.Minutes:D2}m";
        return $"{(int)span.TotalDays}d";
    }

    private static string StatusGlyph(string status) => status switch
    {
        "Running" => "▶",
        "Setup" => "⚙",
        "Down" => "🛑",
        "Maintenance" => "🔧",
        _ => "◯",
    };

    private static string RowProgress(MachineWoRow w)
    {
        if (w.TargetQty == 0) return w.QtyDone.ToString();
        var pct = (int)Math.Round(100.0 * w.QtyDone / w.TargetQty);
        return $"{w.QtyDone}/{w.TargetQty} ({pct}%)";
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try { _data = await Api.GetMachineDashboardAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private static string PillClass(string status) => status switch
    {
        "Running" => "md-pill-running",
        "Setup" => "md-pill-setup",
        "Down" => "md-pill-down",
        "Maintenance" => "md-pill-maint",
        _ => "md-pill-idle",
    };

    private static string StatusLabel(string status) => status switch
    {
        "Running" => "Running",
        "Setup" => "Setup",
        "Down" => "Down",
        "Maintenance" => "Maintenance",
        _ => "Idle",
    };
}
