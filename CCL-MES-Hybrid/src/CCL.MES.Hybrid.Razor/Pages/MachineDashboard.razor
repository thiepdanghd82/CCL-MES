@page "/machines"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Linq
@using CCL.MES.Shared.Machines
@inject ICclApiClient Api

<PageTitle>Bảng máy — CCL MES</PageTitle>

<div class="md-head">
    <h1 class="page-title">Bảng giám sát máy</h1>
    <button type="button" class="md-refresh" @onclick="ReloadAsync" disabled="@_loading">
        @(_loading ? "Đang tải…" : "↻ Làm mới")
    </button>
</div>

@* P10.8 slice 2 — plant KPI strip (plant-wide, unfiltered) + status/area/
   search filters + area-grouped tables. Status derives from the active
   WO's MesPhase (Running / Setup / Idle). Detail drawer + ProductionLog
   Down/Maintenance land in slice 3. *@
<div class="md-kpis">
    <div class="md-kpi"><div class="md-kpi-num">@(_data?.Total)</div><div class="md-kpi-label">Tổng máy</div></div>
    <div class="md-kpi md-kpi-running"><div class="md-kpi-num">@(_data?.Running)</div><div class="md-kpi-label">Đang chạy</div></div>
    <div class="md-kpi md-kpi-setup"><div class="md-kpi-num">@(_data?.Setup)</div><div class="md-kpi-label">Cài đặt</div></div>
    <div class="md-kpi md-kpi-idle"><div class="md-kpi-num">@(_data?.Idle)</div><div class="md-kpi-label">Rảnh</div></div>
</div>

@if (_loading && _data is null)
{
    <p class="md-muted">Đang tải bảng máy…</p>
}
else if (_error is not null)
{
    <p class="md-error">Không tải được bảng máy: @_error</p>
}
else if (_data is null || _data.Machines.Count == 0)
{
    <p class="md-muted">Chưa có trung tâm sản xuất nào.</p>
}
else
{
    <div class="md-filters">
        <input class="md-search" type="text" placeholder="Tìm mã / mô tả…"
               value="@_search" @oninput="OnSearch" />
        <div class="md-chips">
            @foreach (var s in StatusChips)
            {
                <button type="button" class="md-chip @(_statusFilter == s.Key ? "md-chip-on" : "")"
                        @onclick="@(() => _statusFilter = s.Key)">@s.Label</button>
            }
        </div>
        <div class="md-chips">
            <button type="button" class="md-chip @(_areaFilter is null ? "md-chip-on" : "")"
                    @onclick="@(() => _areaFilter = null)">Tất cả khu vực</button>
            @foreach (var area in Areas)
            {
                <button type="button" class="md-chip @(_areaFilter == area ? "md-chip-on" : "")"
                        @onclick="@(() => _areaFilter = area)">@area</button>
            }
        </div>
    </div>

    @if (Filtered.Count == 0)
    {
        <p class="md-muted">Không có máy nào khớp bộ lọc.</p>
    }
    else
    {
        @foreach (var group in Grouped)
        {
            <section class="md-area">
                <div class="md-area-head">
                    <span class="md-area-name">@group.Key</span>
                    <span class="md-area-count">@group.Count() máy</span>
                </div>
                <div class="md-table-wrap">
                    <table class="md-table">
                        <thead>
                            <tr>
                                <th>Mã máy</th><th>Mô tả</th><th>Trạng thái</th>
                                <th>WO</th><th>Giai đoạn</th><th>Tiến độ</th><th>NG</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in group)
                            {
                                <tr class="md-row" @onclick="@(() => OpenDetailAsync(m.WorkCenterId))">
                                    <td class="md-code">@m.Code</td>
                                    <td>@m.Description</td>
                                    <td><span class="md-pill @PillClass(m.Status)">@StatusLabel(m.Status)</span></td>
                                    <td>@(m.ActiveWoNo ?? "—")</td>
                                    <td>@(m.ActiveMesPhase ?? "—")</td>
                                    <td>@Progress(m)</td>
                                    <td>@(m.QtyNg?.ToString() ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
}

@* P10.8 slice 3 — per-machine detail drawer. Opens on row click,
   fetches GET /machines/{id}/detail. *@
@if (_detailOpen)
{
    <div class="md-drawer-overlay" @onclick="CloseDetail"></div>
    <aside class="md-drawer">
        <div class="md-drawer-head">
            <h2 class="md-drawer-title">@(_detail?.Code ?? "Chi tiết máy")</h2>
            <button type="button" class="md-drawer-close" @onclick="CloseDetail">✕</button>
        </div>
        @if (_detailLoading)
        {
            <p class="md-muted">Đang tải chi tiết…</p>
        }
        else if (_detail is null)
        {
            <p class="md-muted">Không có dữ liệu máy.</p>
        }
        else
        {
            <div class="md-drawer-body">
                <div class="md-kv"><span>Mô tả</span><strong>@_detail.Description</strong></div>
                <div class="md-kv"><span>Khu vực</span><strong>@(_detail.Area ?? "—")</strong></div>
                <div class="md-kv"><span>Trạng thái</span><strong><span class="md-pill @PillClass(_detail.Status)">@StatusLabel(_detail.Status)</span></strong></div>

                <h3 class="md-drawer-sub">WO đang chạy</h3>
                @if (_detail.ActiveWo is not null)
                {
                    <div class="md-kv"><span>@_detail.ActiveWo.WoNo</span><strong>@_detail.ActiveWo.MesPhase</strong></div>
                    <div class="md-kv"><span>Tiến độ</span><strong>@RowProgress(_detail.ActiveWo)</strong></div>
                }
                else
                {
                    <p class="md-muted">Không có WO đang chạy.</p>
                }

                <h3 class="md-drawer-sub">Hôm nay</h3>
                <div class="md-today">
                    <div class="md-today-cell"><div class="md-today-num">@_detail.TodayWoCount</div><div class="md-today-lbl">WO</div></div>
                    <div class="md-today-cell"><div class="md-today-num">@_detail.TodayGood</div><div class="md-today-lbl">Đạt</div></div>
                    <div class="md-today-cell"><div class="md-today-num">@_detail.TodayNg</div><div class="md-today-lbl">NG</div></div>
                </div>

                <h3 class="md-drawer-sub">WO gần đây</h3>
                @if (_detail.RecentWos.Count == 0)
                {
                    <p class="md-muted">Chưa có WO.</p>
                }
                else
                {
                    <table class="md-table">
                        <thead><tr><th>WO</th><th>Giai đoạn</th><th>Tiến độ</th></tr></thead>
                        <tbody>
                            @foreach (var w in _detail.RecentWos)
                            {
                                <tr><td>@w.WoNo</td><td>@w.MesPhase</td><td>@RowProgress(w)</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </aside>
}

@code {
    private MachineDashboardDto? _data;
    private bool _loading = true;
    private string? _error;

    private string _search = "";
    private string _statusFilter = "All";   // All | Running | Setup | Idle
    private string? _areaFilter;             // null = all areas

    private bool _detailOpen;
    private bool _detailLoading;
    private MachineDetailDto? _detail;

    private static readonly (string Key, string Label)[] StatusChips =
    {
        ("All", "Tất cả"), ("Running", "Đang chạy"), ("Setup", "Cài đặt"), ("Idle", "Rảnh"),
    };

    private const string NoArea = "Khác";

    private IReadOnlyList<MachineDashboardItem> AllMachines
        => _data?.Machines ?? Array.Empty<MachineDashboardItem>();

    private List<string> Areas => AllMachines
        .Select(m => string.IsNullOrWhiteSpace(m.Area) ? NoArea : m.Area!)
        .Distinct().OrderBy(a => a).ToList();

    private List<MachineDashboardItem> Filtered => AllMachines.Where(m =>
        (_statusFilter == "All" || m.Status == _statusFilter)
        && (_areaFilter is null || (string.IsNullOrWhiteSpace(m.Area) ? NoArea : m.Area) == _areaFilter)
        && (string.IsNullOrWhiteSpace(_search)
            || m.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || m.Description.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private IEnumerable<IGrouping<string, MachineDashboardItem>> Grouped => Filtered
        .GroupBy(m => string.IsNullOrWhiteSpace(m.Area) ? NoArea : m.Area!)
        .OrderBy(g => g.Key);

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private async Task OpenDetailAsync(long wcId)
    {
        _detailOpen = true;
        _detailLoading = true;
        _detail = null;
        try { _detail = await Api.GetMachineDetailAsync(wcId); }
        catch { _detail = null; }
        finally { _detailLoading = false; }
    }

    private void CloseDetail()
    {
        _detailOpen = false;
        _detail = null;
    }

    private static string RowProgress(MachineWoRow w)
    {
        if (w.TargetQty == 0) return w.QtyDone.ToString();
        var pct = (int)Math.Round(100.0 * w.QtyDone / w.TargetQty);
        return $"{w.QtyDone}/{w.TargetQty} ({pct}%)";
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try { _data = await Api.GetMachineDashboardAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private static string PillClass(string status) => status switch
    {
        "Running" => "md-pill-running",
        "Setup" => "md-pill-setup",
        _ => "md-pill-idle",
    };

    private static string StatusLabel(string status) => status switch
    {
        "Running" => "Đang chạy",
        "Setup" => "Cài đặt",
        _ => "Rảnh",
    };

    private static string Progress(MachineDashboardItem m)
    {
        if (m.QtyDone is null || m.TargetQty is null || m.TargetQty == 0) return "—";
        var pct = (int)Math.Round(100.0 * m.QtyDone.Value / m.TargetQty.Value);
        return $"{m.QtyDone}/{m.TargetQty} ({pct}%)";
    }
}
