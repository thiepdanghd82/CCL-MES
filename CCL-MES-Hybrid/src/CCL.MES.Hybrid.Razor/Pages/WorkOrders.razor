@page "/workorders"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.Hardware
@using CCL.MES.Hybrid.Client.RecentScans
@using CCL.MES.Hybrid.Client.WorkOrders
@using CCL.MES.Shared.Devices
@using CCL.MES.Shared.Envelopes
@using CCL.MES.Shared.Hardware
@using CCL.MES.Shared.Prepress
@using CCL.MES.Shared.ReasonCodes
@using CCL.MES.Shared.RecentScans
@using CCL.MES.Shared.WorkOrders
@using Microsoft.Extensions.Logging
@inject IBarcodeScannerService Scanner
@inject IDeviceSettingsLauncher SettingsLauncher
@inject ICclApiClient Api
@inject IRecentScansService RecentScans
@inject Microsoft.Extensions.Options.IOptions<HardwareOptions> HwOptions
@inject Microsoft.Extensions.Logging.ILogger<WorkOrders> Log

<PageTitle>Work Orders — CCL MES</PageTitle>

@*
    P10.3 W4 — primary scan→Accept/Start surface. Operator flow:
      1. Page renders the "Quét WO" CTA when scanner is available; otherwise
         shows the W2 deny banner + Settings deep-link reuse.
      2. Tap CTA → open Catalyst AVFoundation modal (W2 impl). Decoded
         payload comes back as ScanResult.
      3. Page sends ScanLogRequest to server (always — even on bad codes — so
         operations has a full forensic trail of misreads).
      4. Page sends GET /work-orders/by-no/{code}/summary to look up the WO.
         404 → "không tìm thấy WO" banner with a "Quét lại" affordance.
         200 → WO card rendered with CurrentStep + status badge + the
         primary "Nhận / Bắt đầu" button.
      5. Tap Nhận/Bắt đầu → POST /work-orders/{id}/advance (server adds
         X-Device-Id from ApiClientOptions). Successful advance shows the
         new step + "Quét WO khác" CTA. Domain guard failure shows the
         legacy WoErrorCode (mapped to Vietnamese) in-card.

    All API calls go online — no outbox queue per Q4 lock. Network drop
    surfaces as a `network_error` banner; operator retries when LAN is back.
*@

<h1 class="page-title">Work Orders — Scan &amp; Accept</h1>

@if (!HwOptions.Value.ScanEnabled)
{
    <div class="hw-gate" role="status">
        <strong>Scanning is disabled.</strong>
        <p>
            Set <code>Hardware:ScanEnabled = true</code> in appsettings.json
            (or via env override) to enable the scan→WO flow. Configure it under Settings →
            Devices if this station has been approved.
        </p>
    </div>
}
else
{
    <div class="wo-shell">
        @if (_availability is null)
        {
            <div class="hw-pill hw-pill-probing">Checking camera…</div>
        }
        else if (!_availability.IsAvailable)
        {
            <div class="scan-banner">
                <strong>@(_availability.OperatorMessage ?? _availability.Reason)</strong>
            </div>
            @if (_availability.Reason == "permission_denied")
            {
                <button type="button" class="scan-btn scan-btn-secondary"
                        disabled="@_openingSettings"
                        @onclick="OnOpenSettings">
                    @(_openingSettings ? "Opening…" : "Open System Settings")
                </button>
                @if (_openSettingsFailed)
                {
                    <div class="scan-banner-help">
                        Could not open Settings automatically. Go to Apple Menu → System
                        Settings → Privacy &amp; Security → Camera to grant permission
                        for CCL MES.
                    </div>
                }
            }
        }
        else
        {
            @*  P10.7a-1.3 — manual WO entry sits inline AFTER "Scan WO" on the
                same row (compact, height-matched). Plain <input> + @bind:event
                "oninput" + Enter handler — NO <InputText> per the renderer-crash
                lesson (P10.5g / P10.6a). Find routes through the SAME
                ResolveAndShowAsync helper the scan path uses, so audit /
                RecentScans / lookup behave identically — no logic fork. *@
            <div class="wo-cta-row">
                <button type="button" class="scan-btn wo-cta-primary"
                        disabled="@(_scanning || _advancing || _lookingUp)"
                        @onclick="OnScan">
                    @(_scanning ? "Opening camera…" : "Scan WO")
                </button>
                <input type="text"
                       class="wo-manual-input scan-mono"
                       placeholder="Enter WO code (e.g. WO-26-3683)"
                       value="@_manualCode"
                       @oninput="OnManualInput"
                       @onkeydown="OnManualKeyDown"
                       disabled="@(_scanning || _advancing || _lookingUp)"
                       aria-label="Enter WO code manually"
                       autocomplete="off"
                       autocapitalize="off"
                       spellcheck="false" />
                <button type="button" class="scan-btn scan-btn-secondary wo-find-btn"
                        disabled="@(_scanning || _advancing || _lookingUp
                                    || CCL.MES.Hybrid.Client.WorkOrders.WoCodeNormalizer
                                       .NormalizeForManualEntry(_manualCode) is null)"
                        @onclick="OnManualLookup">
                    @(_lookingUp ? "Looking up…" : "Find")
                </button>
                @if (_summary is not null || _lookupError is not null)
                {
                    <button type="button" class="scan-btn scan-btn-secondary"
                            disabled="@(_scanning || _advancing)"
                            @onclick="ResetState">
                        Scan another WO
                    </button>
                }
            </div>

            @if (_lastScan is not null && _summary is null && _lookupError is null && _lookingUp)
            {
                <div class="wo-lookup">
                    <span class="hw-pill hw-pill-probing">Looking up @(_lastScan.Code)…</span>
                </div>
            }

            @if (_lookupError is not null)
            {
                <div class="scan-error">
                    @_lookupError
                </div>
            }

            @* SpecHub "Active Work Orders" parity — landing card list when
               no WO is open. Tap a card to open the WO (same path as a scan). *@
            @if (_summary is null && _lookupError is null && !_lookingUp && _activeWos is not null)
            {
                @if (_activeWos.Count > 0)
                {
                    <div class="wo-section-head">⚡ Active Work Orders (@_activeWos.Count)</div>
                    <div class="woa-grid">
                        @foreach (var w in _activeWos)
                        {
                            <button type="button" class="woa-card" @onclick="@(() => OnOpenWoCardAsync(w.WoNo))">
                                <div class="woa-head">
                                    <span class="woa-no">@w.WoNo</span>
                                    <span class="woa-badge @PhaseBadgeClass(w.MesPhase)">@PhaseLabel(w.MesPhase)</span>
                                </div>
                                <div class="woa-kv"><span>Customer</span><strong>@(w.CustomerName ?? "—")</strong></div>
                                <div class="woa-kv"><span>Product</span><strong>@w.ProductName</strong></div>
                                <div class="woa-kv"><span>Machine</span><strong>@(w.MachineCode ?? "—")</strong></div>
                                <div class="woa-kv"><span>Progress</span><strong>@w.QtyDone / @w.TargetQty pcs</strong></div>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="wo-active-empty">No active work orders. Scan or type a WO code above to begin.</div>
                }
            }

            @if (_summary is not null)
            {
                @* P10.7c-3 BUG-FIX L19 finalization (Henry RCA on WO-26-3686):
                   chip + "Trạng thái MES" MUST key on canonical MesPhase, not
                   legacy CurrentStep. CurrentStep stays "OpSetting" after
                   /setting/done while MesPhase advances through IPQC_WAIT
                   → IPQC_APPROVED → RUNNING → PAUSED → FQC_PENDING etc.,
                   making the chip + step row lie about the actual state. *@
                @* SpecHub-style 7-step phase stepper. *@
                <div class="wo-stepper">
                    @for (var i = 0; i < WoSteps.Length; i++)
                    {
                        var idx = i + 1;
                        var curStep = StepIndexOf(_summary.MesPhase);
                        <div class="wo-step @(idx < curStep ? "wo-step-done" : (idx == curStep ? "wo-step-cur" : "wo-step-todo"))">
                            <div class="wo-step-num">@(idx < curStep ? "✓" : idx.ToString())</div>
                            <div class="wo-step-label">@WoSteps[i]</div>
                        </div>
                    }
                </div>

                <div class="wo-detail-grid">
                <div class="wo-main">

                <div class="wo-card" data-mes-phase="@_summary.MesPhase" data-current-step="@_summary.CurrentStep">
                    <div class="wo-card-head">
                        <div class="wo-card-wo">@_summary.WoNo</div>
                        <div class="wo-card-step @MesPhaseCssClass(_summary)" data-testid="wo-card-phase-chip">@MesPhaseDisplay(_summary)</div>
                        <div class="wo-card-actions">
                            <button type="button" class="grid-btn" @onclick="OnRefreshWo" disabled="@(_lookingUp || _advancing)">↻ Refresh</button>
                            <button type="button" class="grid-btn" @onclick="ResetState" disabled="@_advancing">← Close WO</button>
                        </div>
                    </div>
                    <div class="wo-card-row"><span class="wo-card-label">Product code</span><span class="wo-card-value">@(_summary.ProductCode ?? "—")</span></div>
                    <div class="wo-card-row"><span class="wo-card-label">Part Desc</span><span class="wo-card-value">@(_summary.PartDescription ?? _summary.ProductName ?? "—")</span></div>
                    <div class="wo-card-row"><span class="wo-card-label">Machine</span><span class="wo-card-value">@(_summary.MachineCode ?? "—") @(_summary.MachineName is null ? "" : $"· {_summary.MachineName}")</span></div>
                    <div class="wo-card-row"><span class="wo-card-label">Target</span><span class="wo-card-value">@_summary.TargetQty @_summary.Uom</span></div>
                    <div class="wo-card-row"><span class="wo-card-label">Produced</span><span class="wo-card-value">@_summary.ProducedQty @_summary.Uom</span></div>
                    <div class="wo-card-row"><span class="wo-card-label">MES status</span><span class="wo-card-value scan-mono" data-testid="wo-card-phase-row">@MesPhaseDisplay(_summary)</span></div>
                    <div class="wo-card-row"><span class="wo-card-label">Customer</span><span class="wo-card-value">@(_summary.CustomerName ?? "—")</span></div>

                    @* P10.7a-1.4 — operator-grade success feedback. Today's
                       checkpoint surfaced that the operator tapped Accept
                       repeatedly because the previous "Bước hiện tại"
                       label updated silently — no positive feedback.
                       The green banner now shows the FROM → TO transition
                       explicitly + survives for ~4 s after the advance
                       (controlled by _showSuccessBanner, cleared by the
                       background timer in OnAdvance).

                       P10.7c-3 BUG-FIX — also hidden when a 7b/7c dashboard
                       OWNS the workflow (PREPRESS / SETTING / IPQC_* /
                       RUNNING / PAUSED). Otherwise the stale banner +
                       advance error chrome from a prior /advance attempt
                       (e.g. "RequiresSetupConfirmed") competes with the
                       dashboard for operator attention. *@
                    @if (!IsDashboardOwnedPhase(_summary))
                    {
                        @if (_advanceResult?.Ok == true && _showSuccessBanner)
                        {
                            <div class="wo-card-success" data-testid="advance-success-banner">
                                ✔ Step advanced: <strong>@(_advanceFromStep ?? "—")</strong>
                                → <strong>@_advanceResult.CurrentStep</strong>
                            </div>
                        }
                        else if (_advanceResult is { Ok: false } && !string.IsNullOrEmpty(_advanceResult.ErrorCode))
                        {
                            <div class="wo-card-error">
                                <strong>Could not advance step:</strong> @LocaliseAdvanceError(_advanceResult.ErrorCode)
                                <div class="wo-card-error-detail">Error code: <code>@_advanceResult.ErrorCode</code></div>
                            </div>
                        }
                        else if (_advanceError is not null)
                        {
                            <div class="wo-card-error"><strong>Network error:</strong> @_advanceError</div>
                        }

                        @if (_advanceResult?.Ok != true)
                        {
                            <button type="button" class="scan-btn wo-cta-accept"
                                    disabled="@_advancing"
                                    @onclick="OnAdvance">
                                @(_advancing ? "Advancing step…" : "Accept / Start (advance step)")
                            </button>
                        }
                    }
                </div>

                @* P10.7b-3 — when the WO is in PREPRESS phase, render the
                   PREPRESS row-checks dashboard. The dashboard's Advance
                   button bubbles up via OnAdvanceRequested to OnAdvance()
                   so the AdvanceOrchestrator + success-banner UX still
                   fires on the eventual advance. *@
                @if (IsPrepressPhase(_summary))
                {
                    <CCL.MES.Hybrid.Razor.Shared.PrepressDashboard
                        WorkOrderId="@_summary.Id"
                        OnAdvanceRequested="OnAdvance" />

                    @* P11-3 — fork multi-leg: nếu routing có ≥2 công đoạn (in ∥
                       cắt tape → assembly → cắt), tách thành các leg song song
                       (PREPRESS → SPLIT). WO đơn công đoạn (T1) → không fork. *@
                    <div class="wo-fork-cta" data-testid="wo-fork-cta">
                        <button type="button" class="btn btn-ghost" data-testid="wo-materialize"
                                disabled="@_forkBusy" @onclick="MaterializeLegsAsync">
                            Tách công đoạn (multi-leg)
                        </button>
                        @if (_forkMsg is not null)
                        {
                            <span class="wo-fork-msg" data-testid="wo-fork-msg">@_forkMsg</span>
                        }
                    </div>
                }

                @* P11-3 — SPLIT (đã fork ≥2 leg) routes to LegsDashboard.
                   L21: join SPLIT → FQC_PENDING → parent re-fetch → FqcDashboard. *@
                @if (IsSplitPhase(_summary))
                {
                    <CCL.MES.Hybrid.Razor.Shared.LegsDashboard
                        WorkOrderId="@_summary.Id"
                        OnPhaseChanged="HandleDashboardPhaseChangedAsync" />
                }

                @* P10.7c-3 — SETTING phase routes to SettingDashboard.
                   P10.7d-3 BUG-FIX (Henry hardware verify on PR #119):
                   OnPhaseChanged fires after /setting/done success →
                   parent re-fetches summary → dispatch picks the new
                   phase (IPQC_WAIT) → IpqcDashboard mounts automatically.
                   Operator never sees a stale dead-end card. *@
                @if (IsSettingPhase(_summary))
                {
                    <CCL.MES.Hybrid.Razor.Shared.SettingDashboard
                        WorkOrderId="@_summary.Id"
                        OnPhaseChanged="HandleDashboardPhaseChangedAsync" />
                }

                @* P10.7d-3 — IPQC_WAIT routes to IpqcDashboard. *@
                @if (IsIpqcWaitPhase(_summary))
                {
                    <CCL.MES.Hybrid.Razor.Shared.IpqcDashboard
                        WorkOrderId="@_summary.Id"
                        ScrapReasons="@_scrapReasons"
                        OnPhaseChanged="HandleDashboardPhaseChangedAsync" />
                }

                @* P10.7d-3 — QA_PENDING routes to QaApprovalDashboard. *@
                @if (IsQaPendingPhase(_summary))
                {
                    <CCL.MES.Hybrid.Razor.Shared.QaApprovalDashboard
                        WorkOrderId="@_summary.Id"
                        OnPhaseChanged="HandleDashboardPhaseChangedAsync" />
                }

                @* P10.7e-3 — FQC_PENDING routes to FqcDashboard.
                   L21 OnPhaseChanged: Pass → OQC_PENDING dispatches to
                   OqcDashboard; Reject → PREPRESS dispatches to
                   PrepressDashboard. *@
                @if (IsFqcPendingPhase(_summary))
                {
                    <CCL.MES.Hybrid.Razor.Shared.FqcDashboard
                        WorkOrderId="@_summary.Id"
                        ScrapReasons="@_scrapReasons"
                        OnPhaseChanged="HandleDashboardPhaseChangedAsync" />
                }

                @* P10.7e-3 — OQC_PENDING routes to OqcDashboard with 3-sig
                   Q5 chain. L21: Approve → SHIPPED ShippedSummaryDashboard;
                   Reject → FQC_PENDING FqcDashboard re-mounts. *@
                @if (IsOqcPendingPhase(_summary))
                {
                    <CCL.MES.Hybrid.Razor.Shared.OqcDashboard
                        WorkOrderId="@_summary.Id"
                        ScrapReasons="@_scrapReasons"
                        OnPhaseChanged="HandleDashboardPhaseChangedAsync" />
                }

                @* P10.7e-3 — SHIPPED routes to ShippedSummaryDashboard. *@
                @if (IsShippedPhase(_summary))
                {
                    <CCL.MES.Hybrid.Razor.Shared.ShippedSummaryDashboard
                        WorkOrderId="@_summary.Id" />
                }

                @* P10.7c-3 — IPQC_APPROVED + RUNNING + PAUSED + 7e-deferred
                   phases (DONE / CANCELLED). FQC_PENDING + OQC_PENDING +
                   SHIPPED dropped in 7e-3 — they have real dashboards now. *@
                @if (IsRunningSurfacePhase(_summary))
                {
                    <CCL.MES.Hybrid.Razor.Shared.RunningDashboard
                        WorkOrderId="@_summary.Id"
                        ScrapReasons="@_scrapReasons"
                        PauseReasons="@_pauseReasons"
                        OnPhaseChanged="HandleDashboardPhaseChangedAsync" />
                }

                </div>@* /wo-main *@

                <aside class="wo-side">
                    <div class="wo-side-panel">
                        <div class="wo-side-head">① Current State</div>
                        <div class="wo-side-body">
                            <div class="wo-side-phase">Phase @StepIndexOf(_summary.MesPhase) / 7 · @MesPhaseDisplay(_summary)</div>
                            <div class="wo-dots">
                                @for (var i = 1; i <= 7; i++)
                                {
                                    <span class="wo-dot @(i <= StepIndexOf(_summary.MesPhase) ? "wo-dot-on" : "")"></span>
                                }
                            </div>
                            <div class="wo-side-progress">@_summary.ProducedQty / @_summary.TargetQty @_summary.Uom</div>
                        </div>
                    </div>

                    <div class="wo-side-panel">
                        <div class="wo-side-head">▦ Spec Quick Ref</div>
                        <div class="wo-side-body">
                            <div class="wo-side-kv"><span>Customer</span><strong>@(_summary.CustomerName ?? "—")</strong></div>
                            <div class="wo-side-kv"><span>Product</span><strong>@(_summary.ProductCode ?? "—")</strong></div>
                            <div class="wo-side-kv"><span>Product name</span><strong>@(_summary.ProductName ?? "—")</strong></div>
                            <div class="wo-side-kv"><span>Machine</span><strong>@(_summary.MachineCode ?? "—")</strong></div>
                            <div class="wo-side-kv"><span>Target</span><strong>@_summary.TargetQty @_summary.Uom</strong></div>
                            @if (_prepressView?.PlateCheck?.PlateNo is { Length: > 0 } plateNo)
                            {
                                <div class="wo-side-kv"><span>Plate</span><strong class="scan-mono">@plateNo</strong></div>
                            }
                            @if (_prepressView?.CutterCheck?.CutterNo is { Length: > 0 } cutterNo)
                            {
                                <div class="wo-side-kv"><span>Cutter</span><strong class="scan-mono">@cutterNo</strong></div>
                            }
                        </div>
                    </div>

                    @if (_prepressView is not null && _prepressView.Materials.Count > 0)
                    {
                        <div class="wo-side-panel">
                            <div class="wo-side-head">
                                ▤ BOM Summary
                                <span class="wo-side-head-aside">@_prepressView.Materials.Count materials · @_prepressView.Materials.Count(m => m.Status == "Ok") OK</span>
                            </div>
                            <div class="wo-side-body">
                                @foreach (var m in _prepressView.Materials)
                                {
                                    <div class="wo-bom-row">
                                        <span class="wo-bom-dot @(m.Status == "Ok" ? "wo-bom-ok" : (m.Status == "Ng" ? "wo-bom-ng" : ""))"></span>
                                        <div class="wo-bom-main">
                                            <span class="wo-bom-code">@m.MaterialCode</span>
                                            @if (m.MaterialDescription is { Length: > 0 } desc)
                                            {
                                                <span class="wo-bom-desc">@desc</span>
                                            }
                                        </div>
                                        <div class="wo-bom-nums">
                                            <span class="wo-bom-qty">@(m.QtyLoaded?.ToString("0.###") ?? "—") / @m.QtyRequired.ToString("0.###") @m.Uom</span>
                                            @if (m.LotNo is { Length: > 0 } lot)
                                            {
                                                <span class="wo-bom-lot">Lot @lot</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (_woAudit is not null && _woAudit.Count > 0)
                    {
                        <div class="wo-side-panel">
                            <div class="wo-side-head">
                                🕘 Audit Trail
                                <span class="wo-side-head-aside">@_woAudit.Count events</span>
                            </div>
                            <div class="wo-side-body wo-audit-list">
                                @foreach (var a in _woAudit)
                                {
                                    <div class="wo-audit-row">
                                        <div class="wo-audit-top">
                                            <span class="wo-audit-action">@a.Action</span>
                                            <span class="wo-audit-time">@a.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                        </div>
                                        <div class="wo-audit-actor">@a.ActorUsername</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </aside>
                </div>@* /wo-detail-grid *@
            }
        }
    </div>
}

@code {
    private HardwareAvailability? _availability;
    private bool _scanning;
    private bool _lookingUp;
    private bool _advancing;
    private bool _openingSettings;
    private bool _openSettingsFailed;
    private ScanResult? _lastScan;
    private WorkOrderSummary? _summary;
    private IReadOnlyList<ActiveWorkOrderCard>? _activeWos;
    private PrepressView? _prepressView;
    private IReadOnlyList<WoAuditEntry>? _woAudit;
    private AdvanceWorkOrderResponse? _advanceResult;
    private string? _lookupError;
    private string? _advanceError;
    // P10.7a-1.3 — manual-entry buffer. Bound to the input via
    // @oninput; the Find button enables when WoCodeNormalizer
    // accepts the value.
    private string _manualCode = "";

    // P10.7c-3 — reason-code stores for the RunningDashboard pickers.
    // Loaded once on init; empty list survives gracefully (each modal
    // surfaces "danh mục trống — báo IT" inline).
    private IReadOnlyList<ReasonCodeOption> _scrapReasons = Array.Empty<ReasonCodeOption>();
    private IReadOnlyList<ReasonCodeOption> _pauseReasons = Array.Empty<ReasonCodeOption>();

    // P10.7a-1.4 — success-banner state. Captures the FROM step
    // before the advance fires so the green banner can render
    // "Đã chuyển bước: <old> → <new>". _showSuccessBanner gates
    // visibility; a background delay clears it after
    // SuccessBannerLifetime so the operator sees + reads it
    // without it lingering forever.
    private string? _advanceFromStep;
    private bool _showSuccessBanner;
    private CancellationTokenSource? _successBannerCts;
    private static readonly TimeSpan SuccessBannerLifetime = TimeSpan.FromSeconds(4);

    protected override async Task OnInitializedAsync()
    {
        if (HwOptions.Value.ScanEnabled)
            await Probe();
        await LoadReasonCodesAsync();
        await LoadActiveWosAsync();
    }

    private async Task LoadActiveWosAsync()
    {
        try { _activeWos = await Api.GetActiveWorkOrdersAsync(); }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "[workorders] load active WOs failed — landing list empty");
            _activeWos = System.Array.Empty<ActiveWorkOrderCard>();
        }
    }

    // SpecHub "Active Work Orders" — tap a landing card to open the WO.
    private async Task OnOpenWoCardAsync(string woNo)
    {
        ResetState();
        _manualCode = woNo;
        await ResolveAndShowAsync(woNo, "MANUAL", "card-open", DateTimeOffset.UtcNow);
    }

    // SpecHub header "Refresh" — re-fetch the open WO's summary in place.
    private async Task OnRefreshWo()
    {
        if (_summary is null) return;
        try
        {
            var fresh = await Api.GetWorkOrderByNoAsync(_summary.WoNo);
            if (fresh is not null) _summary = fresh;
        }
        catch (Exception ex) { Log.LogWarning(ex, "[workorders] refresh failed"); }
        await LoadSideDataAsync();
    }

    // SpecHub sidebar — BOM Summary + Audit Trail. Best-effort; never
    // throws (panels just hide on failure).
    private async Task LoadSideDataAsync()
    {
        if (_summary is null) { _prepressView = null; _woAudit = null; return; }
        var id = _summary.Id;
        try { _prepressView = await Api.GetPrepressViewAsync(id); }
        catch (Exception ex) { Log.LogWarning(ex, "[workorders] BOM summary load failed"); _prepressView = null; }
        try { _woAudit = await Api.GetWoAuditAsync(id); }
        catch (Exception ex) { Log.LogWarning(ex, "[workorders] audit load failed"); _woAudit = null; }
    }

    private static string PhaseLabel(string p) => p switch
    {
        "PREPRESS" => "PRE-PRESS",
        "IPQC_WAIT" => "IPQC",
        "QA_PENDING" => "QA",
        "IPQC_APPROVED" => "READY",
        "FQC_PENDING" => "FQC",
        "OQC_PENDING" => "OQC",
        _ => p,
    };

    private static string PhaseBadgeClass(string p) => p switch
    {
        "RUNNING" => "wo-badge-run",
        "PAUSED" => "wo-badge-warn",
        _ => "wo-badge-info",
    };

    // SpecHub 7-step phase stepper.
    private static readonly string[] WoSteps =
        { "Pre-press", "OP Setting", "IPQC", "Ready to Run", "Running", "FQC", "OQC" };

    private static int StepIndexOf(string p) => p switch
    {
        "PREPRESS" => 1,
        "SETTING" => 2,
        "IPQC_WAIT" or "QA_PENDING" => 3,
        "IPQC_APPROVED" => 4,
        "RUNNING" or "PAUSED" => 5,
        "FQC_PENDING" => 6,
        "OQC_PENDING" => 7,
        "SHIPPED" or "DONE" => 8,
        _ => 0,
    };

    private async Task LoadReasonCodesAsync()
    {
        // P10.7c-3 — load Scrap + Pause picker vocabularies once. Errors
        // surface as empty lists; each modal handles empty gracefully.
        try { _scrapReasons = await Api.GetReasonCodesAsync("Scrap"); }
        catch (Exception ex) { Log.LogWarning(ex, "[workorders] load scrap reasons failed — picker will be empty"); }
        try { _pauseReasons = await Api.GetReasonCodesAsync("Pause"); }
        catch (Exception ex) { Log.LogWarning(ex, "[workorders] load pause reasons failed — picker will be empty"); }
    }

    private async Task Probe()
    {
        try
        {
            _availability = await Scanner.IsAvailableAsync();
        }
        catch (Exception ex)
        {
            _availability = new HardwareAvailability(false, "probe_failed",
                $"Error during check: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task OnScan()
    {
        ResetState();
        _scanning = true;
        try
        {
            var result = await Scanner.ScanOnceAsync();
            if (result is null)
            {
                await Probe();
                return;
            }
            _lastScan = result;
            await LogScanThenLookupAsync(result);
        }
        catch (Exception ex)
        {
            _lookupError = $"Scan error: {ex.GetType().Name}: {ex.Message}";
            Log.LogWarning(ex, "[workorders] scan flow failed");
        }
        finally
        {
            _scanning = false;
        }
    }

    private async Task LogScanThenLookupAsync(ScanResult scan)
    {
        // P10.7a-1.3 — scan + manual paths converge here. Both routes
        // record the same audit + RecentScans + lookup. The only
        // difference is the ScanLogRequest.Format string, which is
        // "MANUAL" when the operator typed instead of scanning. The
        // server's device.scan-log endpoint already accepts any
        // string for Format.
        await ResolveAndShowAsync(
            woCode: scan.Code.Trim(),
            format: scan.Format ?? string.Empty,
            sourceDeviceLabel: scan.SourceDevice,
            capturedAt: scan.CapturedAt);
    }

    /// <summary>IFS shop-order QR codes encode a multi-line payload:
    /// <c>Shop Order No: 81091753 / Rel No: 4 / Seq No: 1 / Part No: 80640004
    /// / Lot Size: 2000</c>. The WO number is the Shop Order No. Pull it out
    /// so the lookup matches; a plain single value (manual entry / legacy QR)
    /// has no "Shop Order No" line and passes through unchanged.</summary>
    private static string ExtractWoCode(string payload)
    {
        if (string.IsNullOrWhiteSpace(payload)) return payload;
        var m = System.Text.RegularExpressions.Regex.Match(
            payload, @"shop\s*order\s*no\.?\s*[:#]?\s*([A-Za-z0-9\-_/]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return m.Success ? m.Groups[1].Value.Trim() : payload.Trim();
    }

    private async Task ResolveAndShowAsync(
        string woCode, string format, string? sourceDeviceLabel, DateTimeOffset capturedAt)
    {
        // Step 1 — audit-log unconditionally (good code or bad).
        // Forensic trail is the whole point of the device.scan-log endpoint.
        try
        {
            await Api.LogScanAsync(new ScanLogRequest
            {
                Payload = woCode,
                Format = format,
                Context = "wo-accept",
                SourceDeviceLabel = sourceDeviceLabel,
                ClientTimestamp = capturedAt,
            });
        }
        catch (Exception ex)
        {
            // Audit failures should NOT block lookup — the operator's
            // primary task is the WO Accept, not the audit row. Log + continue.
            Log.LogWarning(ex, "[workorders] scan-log POST failed — continuing with lookup");
        }

        // Step 2 — lookup the WO by number. IFS shop-order QR codes carry a
        // multi-line payload ("Shop Order No: 81091753\nRel No: …\nPart No:
        // 80640004\nLot Size: 2000"); extract the Shop Order No as the WO
        // number. A plain code (no "Shop Order No" line) passes through
        // unchanged so manual entry + legacy QR still work.
        var lookupCode = ExtractWoCode(woCode);
        _lookingUp = true;
        try
        {
            var summary = await Api.GetWorkOrderByNoAsync(lookupCode);
            if (summary is null)
            {
                _lookupError = $"WO number \"{lookupCode}\" not found. Check the code or scan again.";
            }
            else
            {
                _summary = summary;
                await LoadSideDataAsync();
            }
        }
        catch (ApiException apiEx)
        {
            _lookupError = LocaliseApiError(apiEx);
        }
        catch (HttpRequestException ex)
        {
            _lookupError = $"Could not connect to the server: {TrimDetail(ex.Message)}";
        }
        catch (Exception ex)
        {
            _lookupError = $"WO lookup error: {ex.GetType().Name}: {TrimDetail(ex.Message)}";
        }
        finally
        {
            _lookingUp = false;
        }

        // Step 3 — record locally for the "Quét gần đây" sidebar widget.
        try
        {
            RecentScans.Record(new RecentScanEntry
            {
                Code = lookupCode,
                Format = format,
                Context = "wo-accept",
                ScannedAt = DateTime.UtcNow,
                ResolvedDisplay = _summary?.WoNo ?? lookupCode,
                ResolvedSubtitle = _summary is null
                    ? null
                    : $"{_summary.ProductCode ?? "—"} · {_summary.CustomerName ?? "—"}",
                Resolved = _summary is not null,
            });
        }
        catch (Exception ex)
        {
            // Never let a Preferences hiccup break the flow.
            Log.LogWarning(ex, "[workorders] recent-scans record failed — ignored");
        }
    }

    // P10.7a-1.3 — manual-entry handlers. Use plain @oninput/@onkeydown
    // + Razor's value binding (no <InputText> per the renderer-crash
    // lesson from P10.5g/P10.6a).
    private void OnManualInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _manualCode = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnManualKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            await OnManualLookup();
        }
    }

    private async Task OnManualLookup()
    {
        var normalised = CCL.MES.Hybrid.Client.WorkOrders.WoCodeNormalizer
            .NormalizeForManualEntry(_manualCode);
        if (normalised is null)
        {
            _lookupError = "Invalid WO code — enter at least 3 characters.";
            return;
        }
        ResetState(); // clear previous summary/error but keep typed text
        _manualCode = normalised;
        await ResolveAndShowAsync(
            woCode: normalised,
            format: "MANUAL",
            sourceDeviceLabel: "manual-entry",
            capturedAt: DateTimeOffset.UtcNow);
    }

    /// <summary>
    /// P10.7d-3 BUG-FIX (Henry RCA on PR #119) — invoked by each child
    /// dashboard after a successful action that may have changed the
    /// WO's <see cref="WorkOrderSummary.MesPhase"/>. Re-fetches the
    /// summary so the chip + "Trạng thái MES" row + dispatch all see
    /// the canonical post-transition state without the operator having
    /// to tap "Tìm" again. The dispatch branches (IsPrepressPhase /
    /// IsSettingPhase / IsIpqcWaitPhase / IsQaPendingPhase /
    /// IsRunningSurfacePhase) re-evaluate on the next render, so the
    /// new dashboard mounts automatically + the stale one unmounts.
    ///
    /// Lesson L21 — every transition-emitting dashboard MUST expose an
    /// <c>OnPhaseChanged</c> EventCallback and the parent MUST wire it
    /// to this handler. Anything else leaves the operator staring at
    /// a stale dead-end card. Pattern reused verbatim by 7e/7f
    /// surfaces (FqcDashboard / OqcDashboard).
    /// </summary>
    private async Task HandleDashboardPhaseChangedAsync()
    {
        if (_summary is null) return;
        try
        {
            var fresh = await Api.GetWorkOrderByNoAsync(_summary.WoNo);
            if (fresh is not null)
            {
                _summary = fresh;
                await LoadSideDataAsync();
            }
        }
        catch (ApiException apiEx)
        {
            // A failed re-fetch leaves the existing dashboard in place
            // + surfaces the standard error path. Don't drop the
            // operator's WO context.
            _lookupError = LocaliseApiError(apiEx);
        }
        catch (HttpRequestException ex)
        {
            _lookupError = $"Could not connect to the server: {TrimDetail(ex.Message)}";
        }
        catch (Exception ex)
        {
            _lookupError = $"WO reload error: {ex.GetType().Name}: {TrimDetail(ex.Message)}";
        }
        StateHasChanged();
    }

    private async Task OnAdvance()
    {
        if (_summary is null) return;
        // P10.7a-1.3 — UI-side guard. The orchestrator carries an
        // Interlocked-based guard for the off-UI-thread case; this
        // flag is what the button binds to + what the test inspects
        // through the disabled attribute.
        _advancing = true;
        _advanceError = null;
        // P10.7a-1.4 — capture the FROM step BEFORE the advance fires
        // so the success banner can show the transition explicitly.
        // The summary in scope here is the pre-advance state; once
        // the orchestrator returns _summary points at the refreshed
        // post-advance state.
        var fromStepSnapshot = _summary.CurrentStep;
        try
        {
            var orchestrator = new AdvanceOrchestrator(Api);
            var outcome = await orchestrator.RunAsync(
                _summary,
                refreshSummary: (woNo, ct) => Api.GetWorkOrderByNoAsync(woNo, ct));

            if (outcome is null)
            {
                // Double-tap dropped — the previous advance is still in
                // flight. Operator sees nothing change; the in-flight
                // banner ("Đang chuyển bước…") on the button already
                // communicates this state.
                return;
            }

            _summary = outcome.Summary;
            _advanceResult = outcome.Response;

            // P10.7a-1.4 — surface the success banner on every Ok=true
            // outcome (Success or DomainGuard with Ok=true never
            // happens — DomainGuard means Ok=false). Auto-clear after
            // SuccessBannerLifetime so the banner doesn't stick around
            // when the operator moves on to the next WO.
            if (outcome.Response.Ok)
            {
                _advanceFromStep = fromStepSnapshot;
                _showSuccessBanner = true;
                ScheduleSuccessBannerHide();
            }
        }
        catch (ApiException apiEx)
        {
            _advanceError = LocaliseApiError(apiEx);
        }
        catch (HttpRequestException ex)
        {
            _advanceError = $"Could not connect to the server: {TrimDetail(ex.Message)}";
        }
        catch (Exception ex)
        {
            _advanceError = $"{ex.GetType().Name}: {TrimDetail(ex.Message)}";
        }
        finally
        {
            _advancing = false;
        }
    }

    private async Task OnOpenSettings()
    {
        _openingSettings = true;
        _openSettingsFailed = false;
        try
        {
            var opened = await SettingsLauncher.OpenCameraSettingsAsync();
            _openSettingsFailed = !opened;
        }
        finally
        {
            _openingSettings = false;
        }
    }

    private void ResetState()
    {
        _lastScan = null;
        _summary = null;
        _advanceResult = null;
        _lookupError = null;
        _advanceError = null;
        // P10.7a-1.4 — bail out of the success-banner timer + clear
        // its state so a follow-up scan/manual lookup starts fresh.
        _successBannerCts?.Cancel();
        _successBannerCts = null;
        _showSuccessBanner = false;
        _advanceFromStep = null;
    }

    /// <summary>
    /// P10.7a-1.4 — schedule the success banner to auto-hide after
    /// <see cref="SuccessBannerLifetime"/>. Cancels any prior timer
    /// so consecutive advances don't pile up. <c>Task.Delay</c> +
    /// <c>InvokeAsync(StateHasChanged)</c> is enough for the
    /// MAUI/Blazor render thread to pick up the visibility flip
    /// without a System.Timers.Timer dependency.
    /// </summary>
    private void ScheduleSuccessBannerHide()
    {
        _successBannerCts?.Cancel();
        _successBannerCts = new CancellationTokenSource();
        var token = _successBannerCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(SuccessBannerLifetime, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(() =>
                {
                    _showSuccessBanner = false;
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
                // Expected — operator advanced again before the timer fired.
            }
        });
    }

    private static string FormatBadge(string key) =>
        key.Length == 0 ? "—" : key.Split('.').Last().Replace('_', ' ').ToUpperInvariant();

    // P10.7c-3 — dispatch hooks key on MesPhase (CANONICAL), NOT legacy
    // CurrentStep. CurrentStep is a legacy projection that doesn't change
    // in lock-step with MesPhase: after /setting/done the WO is in
    // MesPhase=IPQC_WAIT but CurrentStep stays at "OpSetting", so a
    // CurrentStep-keyed dispatch routes the operator to SettingDashboard
    // which then refuses to render because /running-surface reports
    // MesPhase=IPQC_WAIT → dead-end. MesPhase routing closes the gap.
    //
    // CurrentStep fallback: pre-7c-3 summaries (cached / replayed) may
    // not carry MesPhase. We fall back to the legacy mapping so existing
    // PREPRESS work isn't blocked.

    private static bool IsPrepressPhase(WorkOrderSummary summary)
    {
        if (string.Equals(summary.MesPhase, "PREPRESS", StringComparison.OrdinalIgnoreCase)
            || string.Equals(summary.MesPhase, "NEW", StringComparison.OrdinalIgnoreCase))
            return true;
        // Fallback only when MesPhase is absent.
        if (!string.IsNullOrEmpty(summary.MesPhase)) return false;
        var step = summary.CurrentStep;
        if (string.IsNullOrEmpty(step)) return false;
        return string.Equals(step, "PrePressCheck", StringComparison.OrdinalIgnoreCase)
            || step.Contains("PrePress", StringComparison.OrdinalIgnoreCase)
            || step.Equals("PREPRESS", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsSettingPhase(WorkOrderSummary summary)
    {
        if (string.Equals(summary.MesPhase, "SETTING", StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(summary.MesPhase)) return false;
        return string.Equals(summary.CurrentStep, "OpSetting", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsRunningSurfacePhase(WorkOrderSummary summary)
    {
        var p = summary.MesPhase;
        // P10.7c-3 L19-finalization + P10.7d-3 trim: the 7e-deferred phases
        // (FQC_PENDING / OQC_PENDING / DONE / CANCELLED) still route here
        // for the read-only placeholder card. IPQC_WAIT + QA_PENDING were
        // DROPPED in 7d-3 — they have real dashboards now (IpqcDashboard +
        // QaApprovalDashboard). The dispatch order in the page deliberately
        // sits IpqcDashboard + QaApprovalDashboard BEFORE this branch so
        // they own those phases even if a stale guard slips through.
        if (IsRunningSurfacePhaseValue(p))
            return true;
        if (!string.IsNullOrEmpty(p)) return false;
        var step = summary.CurrentStep;
        if (string.IsNullOrEmpty(step)) return false;
        return string.Equals(step, "ReadyToRun", StringComparison.OrdinalIgnoreCase)
            || string.Equals(step, "Running", StringComparison.OrdinalIgnoreCase)
            || string.Equals(step, "IpqcApproval", StringComparison.OrdinalIgnoreCase);
        // NOTE: Fqc/Oqc/Closed deliberately omitted from the LEGACY fallback —
        // those steps in old cached summaries (with MesPhase missing) keep
        // the legacy Advance CTA path. New summaries with MesPhase populated
        // route through RunningDashboard's placeholder cards via the
        // MesPhase canonical path above.
    }

    /// <summary>Internal — true for any MesPhase that RunningDashboard
    /// knows how to render (action UI for IPQC_APPROVED/RUNNING/PAUSED;
    /// read-only placeholder for DONE/CANCELLED). 7d-3 dropped IPQC_WAIT +
    /// QA_PENDING; 7e-3 dropped FQC_PENDING + OQC_PENDING + SHIPPED — all
    /// route to their own dashboards. Only DONE + CANCELLED remain as
    /// terminal placeholders. Test surface for the dashboard's own
    /// validity gate.</summary>
    private static bool IsRunningSurfacePhaseValue(string phase) =>
        string.Equals(phase, "IPQC_APPROVED", StringComparison.OrdinalIgnoreCase)
        || string.Equals(phase, "RUNNING", StringComparison.OrdinalIgnoreCase)
        || string.Equals(phase, "PAUSED", StringComparison.OrdinalIgnoreCase)
        || string.Equals(phase, "DONE", StringComparison.OrdinalIgnoreCase)
        || string.Equals(phase, "CANCELLED", StringComparison.OrdinalIgnoreCase);

    /// <summary>P10.7d-3 — IPQC_WAIT routes to IpqcDashboard. Same
    /// canonical-MesPhase pattern as <see cref="IsSettingPhase"/>: trust
    /// MesPhase when present, fall back to legacy CurrentStep only when
    /// MesPhase is absent (genuinely pre-7c-3 cached summary).</summary>
    private static bool IsIpqcWaitPhase(WorkOrderSummary summary)
    {
        if (string.Equals(summary.MesPhase, "IPQC_WAIT", StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(summary.MesPhase)) return false;
        // No legacy CurrentStep fallback — pre-7c-3 caches never saw an
        // IPQC_WAIT-equivalent step (IpqcApproval mapped to IPQC_APPROVED).
        return false;
    }

    /// <summary>P10.7d-3 — QA_PENDING routes to QaApprovalDashboard.</summary>
    private static bool IsQaPendingPhase(WorkOrderSummary summary)
    {
        if (string.Equals(summary.MesPhase, "QA_PENDING", StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(summary.MesPhase)) return false;
        return false;
    }

    /// <summary>P10.7e-3 — FQC_PENDING routes to FqcDashboard. Pre-7e-3
    /// cached summaries with MesPhase missing keep the legacy
    /// RunningDashboard placeholder path.</summary>
    private static bool IsFqcPendingPhase(WorkOrderSummary summary)
    {
        if (string.Equals(summary.MesPhase, "FQC_PENDING", StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(summary.MesPhase)) return false;
        return false;
    }

    /// <summary>P10.7e-3 — OQC_PENDING routes to OqcDashboard.</summary>
    private static bool IsOqcPendingPhase(WorkOrderSummary summary)
    {
        if (string.Equals(summary.MesPhase, "OQC_PENDING", StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(summary.MesPhase)) return false;
        return false;
    }

    /// <summary>P10.7e-3 — SHIPPED routes to ShippedSummaryDashboard.</summary>
    private static bool IsShippedPhase(WorkOrderSummary summary)
    {
        if (string.Equals(summary.MesPhase, "SHIPPED", StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrEmpty(summary.MesPhase)) return false;
        return false;
    }

    /// <summary>Operator-visible display label for the chip + status
    /// row. Prefers canonical MesPhase; falls back to legacy CurrentStep
    /// for pre-7c-3 cached summaries that don't carry MesPhase yet.</summary>
    private static string MesPhaseDisplay(WorkOrderSummary summary) =>
        !string.IsNullOrEmpty(summary.MesPhase)
            ? summary.MesPhase
            : (string.IsNullOrEmpty(summary.CurrentStep) ? "—" : summary.CurrentStep);

    /// <summary>Maps canonical MesPhase → CSS class on the wo-card chip.
    /// Falls back to the server-emitted legacy BadgeCssClass when
    /// MesPhase is empty (preserves pre-7c-3 behaviour).</summary>
    private static string MesPhaseCssClass(WorkOrderSummary summary)
    {
        var p = summary.MesPhase;
        if (string.IsNullOrEmpty(p)) return summary.BadgeCssClass ?? "";
        return p.ToUpperInvariant() switch
        {
            "NEW"            => "wo-phase-new",
            "PREPRESS"       => "wo-phase-prepress",
            "SETTING"        => "wo-phase-setting",
            "IPQC_WAIT"      => "wo-phase-ipqc-wait",
            "QA_PENDING"     => "wo-phase-ipqc-wait",
            "IPQC_APPROVED"  => "wo-phase-ipqc-approved",
            "RUNNING"        => "wo-phase-running",
            "PAUSED"         => "wo-phase-paused",
            "FQC_PENDING"    => "wo-phase-fqc-pending",
            "OQC_PENDING"    => "wo-phase-oqc-pending",
            "DONE"           => "wo-phase-done",
            "SHIPPED"        => "wo-phase-shipped",
            "CANCELLED"      => "wo-phase-cancelled",
            _                => "wo-phase-other",
        };
    }

    /// <summary>True when ANY 7b/7c dashboard OWNS the operator's next
    /// action. Used to hide the legacy Advance CTA + the stale advance
    /// error banner so the dashboards don't compete with legacy UI for
    /// operator attention.</summary>
    private static bool IsDashboardOwnedPhase(WorkOrderSummary summary) =>
        IsPrepressPhase(summary)
        || IsSettingPhase(summary)
        || IsIpqcWaitPhase(summary)
        || IsQaPendingPhase(summary)
        || IsFqcPendingPhase(summary)
        || IsOqcPendingPhase(summary)
        || IsShippedPhase(summary)
        || IsSplitPhase(summary)
        || IsRunningSurfacePhase(summary);

    // P11-3 — SPLIT (multi-leg fork) owned by LegsDashboard.
    private static bool IsSplitPhase(WorkOrderSummary summary) =>
        string.Equals(summary.MesPhase, "SPLIT", StringComparison.OrdinalIgnoreCase);

    // P11-3 — fork trigger: materialize routing → leg DAG. forked=true →
    // WO thành SPLIT, L21 re-fetch mount LegsDashboard; forked=false (T1)
    // → thông báo WO đơn công đoạn.
    private bool _forkBusy;
    private string? _forkMsg;

    private async Task MaterializeLegsAsync()
    {
        if (_forkBusy || _summary is null) return;
        _forkBusy = true; _forkMsg = null;
        try
        {
            var view = await Api.GetLegsViewAsync(_summary.Id);
            var resp = await Api.MaterializeLegsAsync(_summary.Id, view.WoETag);
            if (resp.Ok && resp.Forked)
            {
                await HandleDashboardPhaseChangedAsync(); // → SPLIT → LegsDashboard
            }
            else if (resp.Ok)
            {
                _forkMsg = $"WO đơn công đoạn ({resp.LegCount} leg) — không tách.";
            }
            else
            {
                _forkMsg = CCL.MES.Hybrid.Client.Routing.RoutingErrorLocaliser
                    .LocaliseSetError(resp.ErrorCode ?? "");
            }
        }
        catch (ApiException ex)
        {
            _forkMsg = CCL.MES.Hybrid.Client.Routing.RoutingErrorLocaliser
                .LocaliseApiError(ex.StatusCode, ex.ApiError);
        }
        catch (Exception ex) { _forkMsg = ex.Message; }
        finally { _forkBusy = false; }
    }

    // P10.7a-1.3 — both VN mapper switches extracted into
    // CCL.MES.Hybrid.Client.WorkOrders.WorkOrderErrorLocaliser so the
    // client xUnit suite can lock the message bank without booting MAUI.
    private static string LocaliseApiError(ApiException ex) =>
        CCL.MES.Hybrid.Client.WorkOrders.WorkOrderErrorLocaliser
            .LocaliseApiError(ex.StatusCode, ex.ApiError);

    private static string LocaliseAdvanceError(string code) =>
        CCL.MES.Hybrid.Client.WorkOrders.WorkOrderErrorLocaliser
            .LocaliseAdvanceError(code);

    private static string TrimDetail(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw;
        var oneLine = raw.Replace('\n', ' ').Replace('\r', ' ').Trim();
        return oneLine.Length <= 240 ? oneLine : oneLine[..240] + "…";
    }
}
