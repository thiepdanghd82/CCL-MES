@page "/qms/history"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using System.Globalization
@using System.Text
@using CCL.MES.Shared.Qms
@inject ICclApiClient Api
@inject IJSRuntime JS

<PageTitle>@T("qchistory.pagetitle")</PageTitle>

@* P10.10 — QC History redesigned to the Shop Order History forensic-record
   layout: KPI tiles + Export CSV + kind/result/search filters + a
   columned table with result badges + a sidebar (by-kind / top inspectors /
   top reject reasons) + a row detail drawer. Source data unchanged
   (completed FQC/OQC checks); KPIs come from the server (filtered set),
   sidebar roll-ups computed client-side. *@
<div class="md-head">
    <div>
        <PageHead TitleKey="qchistory.title" />
        <div class="md-subtitle">@T("qchistory.subtitle", _data?.Total ?? 0)</div>
    </div>
    <button type="button" class="md-refresh" @onclick="ExportCsvAsync" disabled="@(_data is null || _data.Rows.Count == 0)"><Icon Name="import" /> @T("qchistory.export.csv")</button>
</div>

<div class="md-kpi-grid soh-kpi-grid">
    <div class="md-kpi md-kpi-maint">
        <div class="md-kpi-label">@T("qchistory.kpi.total")</div>
        <div class="md-kpi-num">@(_data?.Total ?? 0)</div>
        <div class="md-kpi-oee-sub">FQC @FqcCount · OQC @OqcCount</div>
    </div>
    <div class="md-kpi md-kpi-running">
        <div class="md-kpi-label">@T("qchistory.kpi.pass")</div>
        <div class="md-kpi-num">@(_data?.Pass ?? 0)</div>
        <div class="md-kpi-oee-sub">@T("qchistory.kpi.pct.ofchecks", _data?.PassRatePct ?? 0)</div>
    </div>
    <div class="md-kpi md-kpi-down">
        <div class="md-kpi-label">@T("qchistory.kpi.reject")</div>
        <div class="md-kpi-num">@(_data?.Reject ?? 0)</div>
        <div class="md-kpi-oee-sub">@T("qchistory.kpi.pct.ofchecks", RejectRate)</div>
    </div>
    <div class="md-kpi @PassRateKpiClass">
        <div class="md-kpi-label">@T("qchistory.kpi.passrate")</div>
        <div class="md-kpi-num">@(_data?.PassRatePct ?? 0)%</div>
        <div class="md-kpi-oee-sub">@T("qchistory.kpi.target")</div>
    </div>
    <div class="md-kpi md-kpi-setup">
        <div class="md-kpi-label">@T("qchistory.kpi.distinctwos")</div>
        <div class="md-kpi-num">@DistinctWos</div>
        <div class="md-kpi-oee-sub">@T("qchistory.kpi.distinctwos.sub")</div>
    </div>
</div>

<div class="md-filters soh-filters">
    <input class="md-search" type="text" placeholder="@T("qchistory.search.placeholder")" value="@_search" @onchange="OnSearchChanged" />
    <span class="md-filter-count">@T("qchistory.filter.records", _data?.Rows.Count ?? 0)</span>
</div>
<div class="md-filters soh-filters-row">
    <span class="soh-filter-label">@T("qchistory.filter.kind")</span>
    <div class="md-chips">
        @foreach (var k in KindChips)
        {
            <button type="button" class="md-chip @(_kind == k.Key ? "md-chip-on" : "")"
                    @onclick="@(() => SetKindAsync(k.Key))">@k.Label</button>
        }
    </div>
    <span class="soh-filter-label">@T("qchistory.filter.result")</span>
    <div class="md-chips">
        @foreach (var j in JudgmentChips)
        {
            <button type="button" class="md-chip @(_judgment == j.Key ? "md-chip-on" : "")"
                    @onclick="@(() => SetJudgmentAsync(j.Key))">@j.Label</button>
        }
    </div>
</div>

@if (_loading && _data is null)
{
    <p class="md-muted">@T("qchistory.loading")</p>
}
else if (_error is not null)
{
    <p class="md-error">@T("qchistory.error.load", _error)</p>
}
else if (_data is null || _data.Rows.Count == 0)
{
    <p class="md-muted">@T("qchistory.empty")</p>
}
else
{
    <div class="md-content">
        <div class="md-main">
            <div class="md-table-wrap">
                <table class="md-table soh-tbl">
                    <thead>
                        <tr>
                            <th>@T("qchistory.col.wo")</th><th>@T("qchistory.col.kind")</th><th>@T("qchistory.col.result")</th><th>@T("qchistory.col.inspector")</th>
                            <th>@T("qchistory.col.reviewer")</th><th>@T("qchistory.col.approver")</th><th>@T("qchistory.col.finished")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _data.Rows)
                        {
                            <tr class="md-row soh-trow @(_selected?.CheckId == r.CheckId ? "is-active" : "")" @onclick="@(() => _selected = r)">
                                <td class="soh-cell-wo">@r.WoNo</td>
                                <td><span class="qc-kind-pill">@r.QcKind</span></td>
                                <td><span class="soh-status @(r.Judgment == "Pass" ? "done" : "stopped")">@(r.Judgment == "Pass" ? T("qchistory.badge.pass") : T("qchistory.badge.reject"))</span></td>
                                <td>@(r.InspectedBy ?? "—")</td>
                                <td>@(r.ReviewedBy ?? "—")</td>
                                <td>@(r.ApprovedBy ?? "—")</td>
                                <td>@FormatRelative(r.CompletedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <aside class="md-side">
            <div class="md-side-card">
                <div class="md-side-head">▦ @T("qchistory.side.bykind")</div>
                <div class="md-side-body">@RenderAgg(ByKind, _data.Rows.Count, "#2563eb", false)</div>
            </div>
            <div class="md-side-card">
                <div class="md-side-head"><Icon Name="user" /> @T("qchistory.side.topinspectors")</div>
                <div class="md-side-body">@RenderAgg(TopInspectors, _data.Rows.Count, "#16a34a", false)</div>
            </div>
            <div class="md-side-card">
                <div class="md-side-head">✕ @T("qchistory.side.topreject")</div>
                <div class="md-side-body">@RenderAgg(TopRejectReasons, RejectTotal, "#dc2626", false, pct: true)</div>
            </div>
        </aside>
    </div>
}

@if (_selected is not null)
{
    <div class="md-drawer-overlay" @onclick="@(() => _selected = null)"></div>
    <aside class="md-drawer soh-drawer">
        <div class="md-drawer-head" style="border-left:4px solid @(_selected.Judgment == "Pass" ? "#16a34a" : "#dc2626"); padding-left:12px">
            <div>
                <h2 class="md-drawer-title">@_selected.WoNo</h2>
                <div class="soh-drawer-sub">@T("qchistory.drawer.sub", _selected.QcKind)</div>
            </div>
            <button type="button" class="md-drawer-close" @onclick="@(() => _selected = null)">✕</button>
        </div>
        <div class="md-drawer-body">
            <h3 class="md-drawer-sub">@T("qchistory.drawer.result")</h3>
            <div class="md-kv"><span>@T("qchistory.drawer.judgment")</span><strong><span class="soh-status @(_selected.Judgment == "Pass" ? "done" : "stopped")">@(_selected.Judgment == "Pass" ? T("qchistory.badge.pass") : T("qchistory.badge.reject"))</span></strong></div>
            <div class="md-kv"><span>@T("qchistory.drawer.kind")</span><strong>@_selected.QcKind</strong></div>
            <div class="md-kv"><span>@T("qchistory.drawer.finished")</span><strong>@(_selected.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</strong></div>
            @if (!string.IsNullOrWhiteSpace(_selected.JudgmentReason))
            {
                <div class="md-kv"><span>@T("qchistory.drawer.reason")</span><strong>@_selected.JudgmentReason</strong></div>
            }

            <h3 class="md-drawer-sub">@T("qchistory.drawer.signatures")</h3>
            <div class="md-kv"><span>@T("qchistory.drawer.inspector")</span><strong>@(_selected.InspectedBy ?? "—")</strong></div>
            <div class="md-kv"><span>@T("qchistory.drawer.reviewer")</span><strong>@(_selected.ReviewedBy ?? "—")</strong></div>
            <div class="md-kv"><span>@T("qchistory.drawer.approver")</span><strong>@(_selected.ApprovedBy ?? "—")</strong></div>
        </div>
    </aside>
}

@code {
    private QcHistoryDto? _data;
    private bool _loading = true;
    private string? _error;

    private string? _kind;       // null = all, else FQC | OQC
    private string? _judgment;   // null = all, else pass | reject
    private string _search = "";
    private QcHistoryRow? _selected;

    private (string? Key, string Label)[] KindChips =>
    [
        (null, T("qchistory.chip.all")), ("FQC", "FQC"), ("OQC", "OQC"),
    ];
    private (string? Key, string Label)[] JudgmentChips =>
    [
        (null, T("qchistory.chip.all")), ("pass", T("qchistory.badge.pass")), ("reject", T("qchistory.badge.reject")),
    ];

    private IReadOnlyList<QcHistoryRow> Rows => _data?.Rows ?? Array.Empty<QcHistoryRow>();
    private int FqcCount => Rows.Count(r => r.QcKind == "FQC");
    private int OqcCount => Rows.Count(r => r.QcKind == "OQC");
    private int DistinctWos => Rows.Select(r => r.WoNo).Distinct().Count();
    private int RejectRate => (_data?.Total ?? 0) == 0 ? 0 : (int)Math.Round(100.0 * (_data!.Reject) / _data.Total);
    private int RejectTotal => Rows.Count(r => r.Judgment != "Pass");

    private string PassRateKpiClass => (_data?.PassRatePct ?? 0) >= 98 ? "md-kpi-running" : (_data?.PassRatePct ?? 0) >= 95 ? "md-kpi-setup" : "md-kpi-down";

    private List<AggRow> ByKind => Rows.GroupBy(r => r.QcKind)
        .Select(g => new AggRow(g.Key, g.Count())).OrderByDescending(a => a.Count).ToList();
    private List<AggRow> TopInspectors => Rows.Where(r => !string.IsNullOrEmpty(r.InspectedBy))
        .GroupBy(r => r.InspectedBy!).Select(g => new AggRow(g.Key, g.Count()))
        .OrderByDescending(a => a.Count).Take(5).ToList();
    private List<AggRow> TopRejectReasons => Rows.Where(r => r.Judgment != "Pass")
        .GroupBy(r => string.IsNullOrWhiteSpace(r.JudgmentReason) ? T("qchistory.side.noreason") : r.JudgmentReason!)
        .Select(g => new AggRow(g.Key, g.Count())).OrderByDescending(a => a.Count).Take(5).ToList();

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task SetKindAsync(string? kind) { _kind = kind; await ReloadAsync(); }
    private async Task SetJudgmentAsync(string? j) { _judgment = j; await ReloadAsync(); }
    private async Task OnSearchChanged(ChangeEventArgs e) { _search = e.Value?.ToString() ?? ""; await ReloadAsync(); }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try { _data = await Api.GetQcHistoryAsync(_kind, _judgment, string.IsNullOrWhiteSpace(_search) ? null : _search); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task ExportCsvAsync()
    {
        if (_data is null || _data.Rows.Count == 0) return;
        var sb = new StringBuilder();
        sb.AppendLine("wo,kind,result,reason,inspector,reviewer,approver,finished");
        foreach (var r in _data.Rows)
        {
            string C(string? v) => v is null ? "" : (v.Contains(',') || v.Contains('"') || v.Contains('\n') ? $"\"{v.Replace("\"", "\"\"")}\"" : v);
            sb.Append(C(r.WoNo)).Append(',').Append(C(r.QcKind)).Append(',').Append(C(r.Judgment)).Append(',')
              .Append(C(r.JudgmentReason)).Append(',').Append(C(r.InspectedBy)).Append(',').Append(C(r.ReviewedBy)).Append(',')
              .Append(C(r.ApprovedBy)).Append(',').Append(r.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "").Append('\n');
        }
        try { await JS.InvokeVoidAsync("cclMesClipboard.download", $"qc-history-{DateTime.Now:yyyy-MM-dd}.csv", sb.ToString(), "text/csv;charset=utf-8"); }
        catch { /* renderer-safe */ }
    }

    private string FormatRelative(DateTime? at)
    {
        if (at is null) return "—";
        var diff = DateTime.UtcNow - at.Value.ToUniversalTime();
        if (diff.TotalHours < 1) return T("qchistory.time.justnow");
        if (diff.TotalHours < 24) return T("qchistory.time.hours", (int)diff.TotalHours);
        if (diff.TotalDays < 7) return T("qchistory.time.days", (int)diff.TotalDays);
        return at.Value.ToLocalTime().ToString("dd/MM/yy");
    }

    private sealed record AggRow(string Key, int Count);

    private RenderFragment RenderAgg(IReadOnlyList<AggRow> rows, int total, string color, bool mono, bool pct = false) => builder =>
    {
        if (rows.Count == 0)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "md-side-empty");
            builder.AddContent(2, pct ? T("qchistory.side.norejects") : T("qchistory.side.nodata"));
            builder.CloseElement();
            return;
        }
        var denom = total <= 0 ? 1 : total;
        var seq = 0;
        foreach (var r in rows)
        {
            var width = Math.Min(100, 100.0 * r.Count / denom);
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "soh-side-row");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "soh-side-key");
            builder.AddContent(seq++, r.Key);
            builder.CloseElement();
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "soh-side-bar");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "soh-side-bar-fill");
            builder.AddAttribute(seq++, "style", $"width:{width.ToString("0.#", CultureInfo.InvariantCulture)}%; background:{color}");
            builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, pct ? $"{r.Count} ({(100.0 * r.Count / denom).ToString("0", CultureInfo.InvariantCulture)}%)" : r.Count.ToString());
            builder.CloseElement();
            builder.CloseElement();
        }
    };
}
