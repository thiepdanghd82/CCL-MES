@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@inject ICclApiClient Api
@inject IFilePickerService FilePicker
@inject IFileOpener FileOpener
@inject IAuthSession Session
@inject IJSRuntime JS
@using CCL.MES.Hybrid.Client.Files
@using CCL.MES.Hybrid.Client.Specs
@using CCL.MES.Shared.Drawings
@using Microsoft.AspNetCore.Components.Rendering

@*
    P10.5e-1 — Drawings tab on the Spec detail page. Surface:
      · 9-kind grid (one card per DrawingKind)
      · per-card: title + drawing-level status pill + version chain
        (newest first) + per-version download button + read-only
        3-role approval chips
      · Admin/Engineer-only "Tải lên bản mới" button → native picker
        (drawing allowlist UTType filter) → multipart streaming upload
        → reload slot
      · per-card inline error banner from SpecMutationErrorMapper

    Constraints:
      · _submitting per-card so one slow upload doesn't block the others
      · download streams to <app sandbox>/downloads/ then opens via
        Launcher (QuickLook / Preview on Catalyst); IFileOpener.Stub
        on test hosts returns false → fallback "Đã lưu" toast
      · 3-role decide buttons NOT here yet — chips are read-only
        Pending placeholders until P10.5e-2 ships the gate + modal
*@

@if (Slots is null || Slots.Count == 0)
{
    <p class="grid-status">@T("specdrawtab.empty.norevision")</p>
}
else
{
    <div class="drawing-grid">
        @foreach (var slot in Slots)
        {
            var kindKey = slot.Kind.ToString();
            var submitting = _submittingKind == kindKey;
            var error = _errorByKind.TryGetValue(kindKey, out var e) ? e : null;
            var notice = _noticeByKind.TryGetValue(kindKey, out var n) ? n : null;

            <div class="drawing-slot @(submitting ? "is-busy" : "")">
                <div class="drawing-slot-head">
                    <strong>@KindLabel(slot.Kind)</strong>
                    <span class="spec-status-pill drawing-status-@slot.DrawingStatus.ToString().ToLowerInvariant()">
                        @DrawingSlotStatusLabel(slot.DrawingStatus)
                    </span>
                    <AuthorizeView Roles="Admin,Engineer" Context="ctx">
                        <button type="button" class="grid-btn grid-btn-primary drawing-upload-btn"
                                disabled="@submitting"
                                @onclick="() => OnUploadAsync(slot)">
                            @(submitting ? @T("specdrawtab.upload.busy") : @T("specdrawtab.upload.new"))
                        </button>
                    </AuthorizeView>
                </div>

                @if (error is not null)
                {
                    <div class="modal-banner modal-banner-error drawing-card-error" role="alert">
                        <strong>@T("specdrawtab.upload.failed")</strong>
                        <div>@error</div>
                    </div>
                }
                @if (notice is not null)
                {
                    <div class="modal-banner modal-banner-success drawing-card-notice" role="status">
                        @notice
                    </div>
                }

                <div class="drawing-slot-versions">
                    @if (slot.Versions.Count == 0)
                    {
                        <span class="spec-empty-inline">@T("specdrawtab.version.none")</span>
                    }
                    else
                    {
                        @foreach (var v in slot.Versions)
                        {
                            var dl = _downloadingVersionId == v.Id;
                            <div class="drawing-version-row drawing-version-@v.Status.ToString().ToLowerInvariant()">
                                <span class="spec-mono drawing-vno">v@v.VersionNo</span>
                                <span class="drawing-fname" title="@T("specdrawtab.version.fname.title", DrawingDisplayName(v), v.FileName)">@DrawingDisplayName(v)</span>
                                <span class="drawing-size">@FormatBytes(v.FileSize)</span>
                                <span class="drawing-status-pill drawing-status-@v.Status.ToString().ToLowerInvariant()">
                                    @DrawingVersionStatusLabel(v.Status)
                                </span>
                                <span class="drawing-uploader">@(v.UploadedBy ?? "—")</span>

                                <span class="drawing-approval-strip">
                                    @foreach (var a in v.Approvals)
                                    {
                                        @RenderChip(slot, v, a)
                                    }
                                </span>

                                <div class="drawing-version-actions">
                                    <button type="button" class="grid-btn grid-btn-primary drawing-dl-btn"
                                            disabled="@dl"
                                            @onclick="() => OnOpenAsync(slot, v)">
                                        @(dl ? @T("specdrawtab.action.open.busy") : @T("specdrawtab.action.open"))
                                    </button>
                                    <button type="button" class="grid-btn drawing-dl-btn"
                                            disabled="@dl" title="@T("specdrawtab.action.save.title")"
                                            @onclick="() => OnDownloadAsync(slot, v)">
                                        @T("specdrawtab.action.save")
                                    </button>
                                    <AuthorizeView Roles="Admin,Engineer" Context="del">
                                        <button type="button" class="grid-btn drawing-dl-btn drawing-del-btn"
                                                disabled="@dl" title="@T("specdrawtab.action.delete.title")"
                                                @onclick="() => OpenDeleteModal(slot, v)">
                                            @T("specdrawtab.action.delete")
                                        </button>
                                    </AuthorizeView>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@* P10.10 — in-app drawing preview (reliable in WKWebView via a blob URL;
   the native Launcher / data: PDFs are flaky on Catalyst). *@
@if (_previewOpen)
{
    <div class="drawing-preview-overlay" @onclick="ClosePreviewAsync">
        <div class="drawing-preview-box" @onclick:stopPropagation="true">
            <div class="drawing-preview-head">
                <span class="drawing-preview-title spec-mono" title="@_previewName">@_previewName</span>
                <button type="button" class="drawing-preview-close" @onclick="ClosePreviewAsync">✕</button>
            </div>
            <div class="drawing-preview-body">
                @if (string.IsNullOrEmpty(_previewUrl))
                {
                    <div class="drawing-preview-empty">@T("specdrawtab.preview.loading")</div>
                }
                else if (_previewIsImage)
                {
                    <img class="drawing-preview-img" src="@_previewUrl" alt="@_previewName" />
                }
                else
                {
                    <iframe class="drawing-preview-frame" src="@_previewUrl" title="@_previewName"></iframe>
                }
            </div>
        </div>
    </div>
}

@* P10.10 — Delete-version modal. Requires an NPI-team member's
   username + password (verified server-side) before the version's blob +
   metadata are removed. Optional reason is recorded in the audit row. *@
@if (_deleteOpen && _deleteVersion is not null && _deleteSlot is not null)
{
    <div class="modal-scrim" @onclick="CloseDeleteModal">
        <div class="modal-card modal-sm modal-severity-danger" @onclick:stopPropagation="true">
            <div class="modal-head">
                <span class="modal-title">@T("specdrawtab.delete.title")</span>
                <button type="button" class="modal-close" @onclick="CloseDeleteModal">✕</button>
            </div>
            <div class="modal-body">
                <p class="drawing-del-target">
                    @KindLabel(_deleteSlot.Kind) · <span class="spec-mono">v@_deleteVersion.VersionNo</span>
                    — <span class="spec-mono">@DrawingDisplayName(_deleteVersion)</span>
                </p>
                <p class="drawing-del-warn">
                    @T("specdrawtab.delete.warn") <strong>@T("specdrawtab.delete.warn.team")</strong>@T("specdrawtab.delete.warn.tail")
                </p>
                @if (_deleteError is not null)
                {
                    <div class="modal-banner modal-banner-error" role="alert">@_deleteError</div>
                }
                <div class="modal-field">
                    <label>@T("specdrawtab.delete.field.user")</label>
                    <input class="modal-input" type="text" autocomplete="off"
                           placeholder="@T("specdrawtab.delete.field.user.ph")" disabled="@_deleteBusy"
                           @bind="_deleteUser" @bind:event="oninput" />
                </div>
                <div class="modal-field">
                    <label>@T("specdrawtab.delete.field.pwd")</label>
                    <input class="modal-input" type="password" autocomplete="off"
                           placeholder="••••••••" disabled="@_deleteBusy"
                           @bind="_deletePassword" @bind:event="oninput" />
                </div>
                <div class="modal-field">
                    <label>@T("specdrawtab.delete.field.reason")</label>
                    <input class="modal-input" type="text" disabled="@_deleteBusy"
                           placeholder="@T("specdrawtab.delete.field.reason.ph")" @bind="_deleteReason" />
                </div>
            </div>
            <div class="modal-foot">
                <button type="button" class="grid-btn" disabled="@_deleteBusy" @onclick="CloseDeleteModal">@T("specdrawtab.delete.cancel")</button>
                <button type="button" class="grid-btn grid-btn-danger"
                        disabled="@(_deleteBusy || string.IsNullOrWhiteSpace(_deleteUser) || string.IsNullOrWhiteSpace(_deletePassword))"
                        @onclick="ConfirmDeleteAsync">
                    @(_deleteBusy ? @T("specdrawtab.delete.confirm.busy") : @T("specdrawtab.delete.confirm"))
                </button>
            </div>
        </div>
    </div>
}

@* P10.5e-2 — Decide modal. One instance per tab — the click handler
   stashes the chip context + opens. Closing snaps the state back so
   the next click starts clean. *@
<DrawingDecideModal Open="_decideOpen"
                    RevisionId="@RevisionId"
                    VersionId="@_decideVersionId"
                    VersionNo="@_decideVersionNo"
                    Kind="@_decideKind"
                    Role="@_decideRole"
                    OnDecided="OnDecidedAsync"
                    OnClose="OnDecideClosedAsync" />

@code {
    [Parameter] public long RevisionId { get; set; }
    [Parameter] public IReadOnlyList<DrawingKindSlot>? Slots { get; set; }
    [Parameter] public EventCallback OnReloadRequested { get; set; }
    // P10.10 — drive the displayed/opened drawing name off the spec's IFS code
    // + Part No (IFS_PartNo) instead of the raw uploaded filename.
    [Parameter] public string? IfsCode { get; set; }
    [Parameter] public string? PartNo { get; set; }

    /// <summary>Auto name a drawing as "IFScode_PartNo.ext" (keeping the
    /// uploaded extension). Falls back to Part No / IFS code / the original
    /// name when one side is missing.</summary>
    private string DrawingDisplayName(DrawingVersionView v)
    {
        var ext = System.IO.Path.GetExtension(v.FileName);
        var ifs = (IfsCode ?? "").Trim();
        var part = (PartNo ?? "").Trim();
        string baseName =
            ifs.Length > 0 && part.Length > 0 ? $"{ifs}_{part}"
            : part.Length > 0 ? part
            : ifs.Length > 0 ? ifs
            : System.IO.Path.GetFileNameWithoutExtension(v.FileName);
        return Sanitize(baseName) + ext;
    }

    private static string Sanitize(string s)
    {
        var bad = System.IO.Path.GetInvalidFileNameChars();
        var cleaned = new string(s.Select(c => bad.Contains(c) || c == ' ' ? '_' : c).ToArray());
        return string.IsNullOrWhiteSpace(cleaned) ? "drawing" : cleaned;
    }

    private string? _submittingKind;
    private long _downloadingVersionId;
    private readonly Dictionary<string, string?> _errorByKind = new(StringComparer.Ordinal);

    // P10.5e-2 — decide modal context
    private bool _decideOpen;
    private long _decideVersionId;
    private int _decideVersionNo;
    private DrawingKindCode _decideKind;
    private DrawingApprovalRole _decideRole;
    private string? _decideKindKey; // for error/notice routing back to the slot card
    private readonly Dictionary<string, string?> _noticeByKind = new(StringComparer.Ordinal);

    private async Task OnUploadAsync(DrawingKindSlot slot)
    {
        var kindKey = slot.Kind.ToString();
        if (_submittingKind is not null) return; // global busy — Q11 _submitting guard
        _errorByKind[kindKey] = null;
        _noticeByKind[kindKey] = null;

        PickedFile? pick;
        try
        {
            pick = await FilePicker.PickFileAsync(FilePickerExtensionMap.DrawingAllowlist);
        }
        catch (Exception ex)
        {
            _errorByKind[kindKey] = $"{ex.GetType().Name}: {ex.Message}";
            StateHasChanged();
            return;
        }
        if (pick is null) return; // operator cancelled

        _submittingKind = kindKey;
        StateHasChanged();
        try
        {
            // Stream the picked file directly into the multipart upload —
            // no full-file buffer. Disposed once consumed.
            await using (pick)
            {
                var resp = await Api.UploadDrawingAsync(
                    RevisionId, kindKey, pick.Content, pick.FileName);
                _noticeByKind[kindKey] = T("specdrawtab.notice.uploaded", resp.VersionNo, pick.FileName, FormatBytes(resp.SizeBytes));
            }
            if (OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
        }
        catch (ApiException apiEx)
        {
            _errorByKind[kindKey] = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
        }
        catch (HttpRequestException ex)
        {
            _errorByKind[kindKey] = T("specdrawtab.err.connect", ex.Message);
        }
        catch (TaskCanceledException)
        {
            _errorByKind[kindKey] = T("specdrawtab.err.upload.timeout");
        }
        catch (Exception ex)
        {
            _errorByKind[kindKey] = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _submittingKind = null;
            StateHasChanged();
        }
    }

    private async Task OnDownloadAsync(DrawingKindSlot slot, DrawingVersionView v)
    {
        if (_downloadingVersionId != 0) return;
        var kindKey = slot.Kind.ToString();
        _errorByKind[kindKey] = null;
        _noticeByKind[kindKey] = null;
        _downloadingVersionId = v.Id;
        StateHasChanged();
        try
        {
            var safeDir = FileOpener.GetSafeDownloadDirectory();
            // P10.10 — open under the auto IFS_PartNo name (keeps the extension
            // so QuickLook picks the right app); version suffix avoids
            // collisions across re-opens of different versions.
            var openName = System.IO.Path.GetFileNameWithoutExtension(DrawingDisplayName(v))
                + $"_v{v.VersionNo}" + System.IO.Path.GetExtension(v.FileName);
            var dest = Path.Combine(safeDir, openName);
            var size = await Api.DownloadDrawingToFileAsync(RevisionId, v.Id, dest);
            _noticeByKind[kindKey] = T("specdrawtab.notice.opened", v.VersionNo, openName, FormatBytes(size));
            var opened = await FileOpener.TryOpenAsync(dest);
            if (!opened)
            {
                _noticeByKind[kindKey] = T("specdrawtab.notice.saved", dest);
            }
        }
        catch (ApiException apiEx)
        {
            _errorByKind[kindKey] = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
        }
        catch (HttpRequestException ex)
        {
            _errorByKind[kindKey] = T("specdrawtab.err.connect", ex.Message);
        }
        catch (Exception ex)
        {
            _errorByKind[kindKey] = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _downloadingVersionId = 0;
            StateHasChanged();
        }
    }

    // ── P10.10 — in-app drawing preview ──────────────────────────────
    private bool _previewOpen;
    private string? _previewUrl;       // blob: URL
    private string? _previewName;
    private bool _previewIsImage;
    private static readonly string[] _imageExts = { ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp" };

    private async Task OnOpenAsync(DrawingKindSlot slot, DrawingVersionView v)
    {
        if (_downloadingVersionId != 0) return;
        var kindKey = slot.Kind.ToString();
        _errorByKind[kindKey] = null;
        _noticeByKind[kindKey] = null;
        _downloadingVersionId = v.Id;
        StateHasChanged();
        try
        {
            var ext = System.IO.Path.GetExtension(v.FileName).ToLowerInvariant();
            _previewIsImage = _imageExts.Contains(ext);
            _previewName = DrawingDisplayName(v);
            var bytes = await Api.DownloadDrawingBytesAsync(RevisionId, v.Id);
            var b64 = Convert.ToBase64String(bytes);
            _previewUrl = await JS.InvokeAsync<string>("cclMesDrawings.toObjectUrl", b64, MimeForExt(ext));
            if (string.IsNullOrEmpty(_previewUrl))
            {
                _errorByKind[kindKey] = T("specdrawtab.err.preview");
            }
            else
            {
                _previewOpen = true;
            }
        }
        catch (ApiException apiEx) { _errorByKind[kindKey] = SpecMutationErrorMapper.ToVietnameseMessage(apiEx); }
        catch (HttpRequestException ex) { _errorByKind[kindKey] = T("specdrawtab.err.connect", ex.Message); }
        catch (Exception ex) { _errorByKind[kindKey] = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _downloadingVersionId = 0; StateHasChanged(); }
    }

    private async Task ClosePreviewAsync()
    {
        _previewOpen = false;
        if (!string.IsNullOrEmpty(_previewUrl))
        {
            try { await JS.InvokeVoidAsync("cclMesDrawings.revoke", _previewUrl); } catch { /* noop */ }
        }
        _previewUrl = null;
        StateHasChanged();
    }

    private static string MimeForExt(string ext) => ext switch
    {
        ".png" => "image/png",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        ".bmp" => "image/bmp",
        ".pdf" => "application/pdf",
        ".svg" => "image/svg+xml",
        _ => "application/octet-stream",
    };

    // ── P10.10 — delete-version modal (NPI password gate) ────────────
    private bool _deleteOpen;
    private DrawingKindSlot? _deleteSlot;
    private DrawingVersionView? _deleteVersion;
    private string _deleteUser = "";
    private string _deletePassword = "";
    private string _deleteReason = "";
    private bool _deleteBusy;
    private string? _deleteError;

    private void OpenDeleteModal(DrawingKindSlot slot, DrawingVersionView v)
    {
        _deleteSlot = slot;
        _deleteVersion = v;
        _deleteUser = "";
        _deletePassword = "";
        _deleteReason = "";
        _deleteError = null;
        _deleteBusy = false;
        _deleteOpen = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        if (_deleteBusy) return;   // don't dismiss mid-request
        _deleteOpen = false;
        _deleteSlot = null;
        _deleteVersion = null;
        _deletePassword = "";
        _deleteError = null;
        StateHasChanged();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteVersion is null || _deleteSlot is null) return;
        if (string.IsNullOrWhiteSpace(_deleteUser) || string.IsNullOrWhiteSpace(_deletePassword)) return;

        _deleteBusy = true;
        _deleteError = null;
        StateHasChanged();

        var kindKey = _deleteSlot.Kind.ToString();
        try
        {
            var req = new DrawingDeleteRequest
            {
                Username = _deleteUser.Trim(),
                Password = _deletePassword,
                Reason = string.IsNullOrWhiteSpace(_deleteReason) ? null : _deleteReason.Trim(),
            };
            await Api.DeleteDrawingVersionAsync(RevisionId, _deleteVersion.Id, req);

            _noticeByKind[kindKey] = T("specdrawtab.notice.deleted", _deleteVersion.VersionNo, DrawingDisplayName(_deleteVersion));
            _deleteBusy = false;
            _deleteOpen = false;
            _deleteSlot = null;
            _deleteVersion = null;
            _deletePassword = "";
            if (OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
        }
        catch (ApiException apiEx)
        {
            _deleteError = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _deleteBusy = false;
            StateHasChanged();
        }
        catch (HttpRequestException ex)
        {
            _deleteError = T("specdrawtab.err.connect", ex.Message);
            _deleteBusy = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _deleteError = $"{ex.GetType().Name}: {ex.Message}";
            _deleteBusy = false;
            StateHasChanged();
        }
    }

    // ── P10.5e-2 — chip rendering + decide handlers ──────────────────

    private RenderFragment RenderChip(DrawingKindSlot slot, DrawingVersionView v, DrawingApprovalView a) => __builder =>
    {
        var actor = Session.CurrentUserInfo;
        var availability = DrawingsApprovalGateVm.ResolveAvailability(
            actor?.Role ?? "",
            actor?.Department,
            a.Role,
            v.Status,
            a.Status);

        var statusCls = a.Status.ToString().ToLowerInvariant();
        var availabilityCls = availability switch
        {
            DrawingsApprovalGateVm.ChipAvailability.Actionable     => "is-actionable",
            DrawingsApprovalGateVm.ChipAvailability.AlreadyDecided => "is-decided",
            DrawingsApprovalGateVm.ChipAvailability.NotAuthorized  => "is-not-authorized",
            DrawingsApprovalGateVm.ChipAvailability.VersionLocked  => "is-locked",
            _ => "",
        };

        // Title shows actor + time when decided, gate hint when not
        // authorized. Operators care about who said what — keep it
        // dense.
        string title;
        if (a.ActedBy is not null && a.ActedAt is not null)
        {
            var ts = a.ActedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
            title = T("specdrawtab.chip.title.acted", ApprovalRoleLabel(a.Role), ApprovalStatusLabel(a.Status), a.ActedBy, ts);
            if (!string.IsNullOrWhiteSpace(a.Comment))
                title += "\n" + T("specdrawtab.chip.title.reason", a.Comment);
        }
        else if (availability == DrawingsApprovalGateVm.ChipAvailability.NotAuthorized)
        {
            title = DrawingsApprovalGateVm.TooltipForNotAuthorized(a.Role);
        }
        else
        {
            title = T("specdrawtab.chip.title.pending", ApprovalRoleLabel(a.Role), ApprovalStatusLabel(a.Status));
        }

        if (availability == DrawingsApprovalGateVm.ChipAvailability.Actionable
            || availability == DrawingsApprovalGateVm.ChipAvailability.AlreadyDecided)
        {
            __builder.OpenElement(0, "button");
            __builder.AddAttribute(1, "type", "button");
            __builder.AddAttribute(2, "class",
                $"drawing-approval-chip drawing-approval-chip-{statusCls} drawing-approval-chip-clickable {availabilityCls}");
            __builder.AddAttribute(3, "title", title);
            __builder.AddAttribute(4, "onclick",
                EventCallback.Factory.Create<MouseEventArgs>(this, _ => OpenDecideModal(slot, v, a)));
            __builder.AddAttribute(5, "onclick:stopPropagation", true);
            RenderChipContent(__builder, a);
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "class",
                $"drawing-approval-chip drawing-approval-chip-{statusCls} {availabilityCls}");
            __builder.AddAttribute(2, "title", title);
            RenderChipContent(__builder, a);
            __builder.CloseElement();
        }
    };

    private void RenderChipContent(RenderTreeBuilder __builder, DrawingApprovalView a)
    {
        __builder.AddContent(10, ApprovalRoleLabel(a.Role));
        __builder.AddContent(11, " · ");
        __builder.AddContent(12, ApprovalStatusLabel(a.Status));
        if (a.ActedBy is not null)
        {
            __builder.OpenElement(13, "span");
            __builder.AddAttribute(14, "class", "drawing-approval-actor");
            __builder.AddContent(15, $" · {a.ActedBy}");
            __builder.CloseElement();
        }
    }

    private void OpenDecideModal(DrawingKindSlot slot, DrawingVersionView v, DrawingApprovalView a)
    {
        // Server is source of truth — re-decide IS allowed by D-5c
        // semantics, so we don't gate by approvalStatus here.
        _decideKind = slot.Kind;
        _decideKindKey = slot.Kind.ToString();
        _decideVersionId = v.Id;
        _decideVersionNo = v.VersionNo;
        _decideRole = a.Role;
        _decideOpen = true;
        _errorByKind[_decideKindKey] = null;
        _noticeByKind[_decideKindKey] = null;
        StateHasChanged();
    }

    private async Task OnDecideClosedAsync()
    {
        _decideOpen = false;
        await Task.CompletedTask;
        StateHasChanged();
    }

    private async Task OnDecidedAsync(DrawingDecideResponse resp)
    {
        // Server returned the post-decide state. We trust the server
        // (Q4 — no client-side state mutation, just refresh from the
        // canonical source) so the version chain + supersede sweep
        // surface correctly without drift.
        if (_decideKindKey is not null)
        {
            var summary = T("specdrawtab.notice.decided", _decideVersionNo);
            if (resp.SupersededCount > 0)
                summary += T("specdrawtab.notice.decided.superseded", resp.SupersededCount);
            _noticeByKind[_decideKindKey] = summary;
        }
        if (OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
    }

    private string KindLabel(DrawingKindCode kind) => kind switch
    {
        DrawingKindCode.CustomerDrawing    => T("specdrawtab.kind.customerdrawing"),
        DrawingKindCode.NpiPrintLayout     => T("specdrawtab.kind.npiprintlayout"),
        DrawingKindCode.NpiCutLayout       => T("specdrawtab.kind.npicutlayout"),
        DrawingKindCode.IpqcPrintReference => T("specdrawtab.kind.ipqcprintref"),
        DrawingKindCode.IpqcCutReference   => T("specdrawtab.kind.ipqccutref"),
        DrawingKindCode.FqcChecksheet      => T("specdrawtab.kind.fqcchecksheet"),
        DrawingKindCode.OqcChecksheet      => T("specdrawtab.kind.oqcchecksheet"),
        DrawingKindCode.CustomerApproval   => T("specdrawtab.kind.customerapproval"),
        DrawingKindCode.InternalProof      => T("specdrawtab.kind.internalproof"),
        _                                  => kind.ToString(),
    };

    private string DrawingSlotStatusLabel(DrawingSlotStatus s) => s switch
    {
