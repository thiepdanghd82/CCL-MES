@*
  Left-side navigation. Items render with role-gating via <AuthorizeView>.
  English UI (P10.10 EN pass). NpiRead policy gates the master-data grids;
  the Spec sub-link tightens to NpiSpecRead (Admin/Supervisor/Engineer).
*@
@using CCL.MES.Hybrid.Client.Hardware
@inject IAuthSession Session
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<HardwareOptions> HwOptions

<aside class="app-nav">
    <div class="app-nav-brand">CCL · MES</div>

    <nav>
        <NavLink href="/" Match="NavLinkMatch.All" class="app-nav-link">Home</NavLink>

        <AuthorizeView Roles="Admin,Supervisor,Engineer,QC">
            <div class="app-nav-section">NPI DATA</div>
            <NavLink href="/npi/structure" class="app-nav-link app-nav-link-sub">Structure (BOM)</NavLink>
            <NavLink href="/npi/routine" class="app-nav-link app-nav-link-sub">Routings</NavLink>
            <NavLink href="/npi/rawmaterials" class="app-nav-link app-nav-link-sub">Raw Materials</NavLink>
            <NavLink href="/npi/workcenters" class="app-nav-link app-nav-link-sub">Work Centers</NavLink>
            <AuthorizeView Roles="Admin,Supervisor,Engineer" Context="specCtx">
                <NavLink href="/npi/specs" class="app-nav-link app-nav-link-sub">Engineer Spec</NavLink>
            </AuthorizeView>
        </AuthorizeView>

        @if (HwOptions.Value.ScanEnabled)
        {
            <div class="app-nav-section">PRODUCTION</div>
            <NavLink href="/workorders" class="app-nav-link">Work Orders — Scan</NavLink>
        }

        @* P10.8 — Machine Dashboard + Shop Order History + QMS (SpecHub
           parity). Read-only monitoring; open to every authenticated role. *@
        <div class="app-nav-section">MONITORING</div>
        <NavLink href="/machines" class="app-nav-link">Machine Dashboard</NavLink>
        <NavLink href="/shop-orders" class="app-nav-link">Shop Order History</NavLink>
        <NavLink href="/qms" class="app-nav-link">Inspection Queue</NavLink>
        <NavLink href="/qms/history" class="app-nav-link">QC History</NavLink>

        <div class="app-nav-section">SETTINGS</div>
        <NavLink href="/settings" Match="NavLinkMatch.All" class="app-nav-link">Overview</NavLink>
        <NavLink href="/settings/profile" class="app-nav-link app-nav-link-sub">My Profile</NavLink>
        <NavLink href="/settings/password" class="app-nav-link app-nav-link-sub">Change Password</NavLink>
        <NavLink href="/settings/connection" class="app-nav-link app-nav-link-sub">Connection</NavLink>
        <NavLink href="/settings/about" class="app-nav-link app-nav-link-sub">About</NavLink>
        <NavLink href="/settings/appearance" class="app-nav-link app-nav-link-sub">Appearance</NavLink>
        <AuthorizeView Roles="Admin" Context="bkpCtx">
            <NavLink href="/settings/backup" class="app-nav-link app-nav-link-sub">Backup &amp; Restore</NavLink>
        </AuthorizeView>
        <AuthorizeView Roles="Admin" Context="audCtx">
            <NavLink href="/settings/audit" class="app-nav-link app-nav-link-sub">Audit Log</NavLink>
        </AuthorizeView>
        <AuthorizeView Roles="Admin" Context="accCtx">
            <NavLink href="/settings/accounts" class="app-nav-link app-nav-link-sub">Account Control</NavLink>
        </AuthorizeView>
        @if (HwOptions.Value.ScanEnabled)
        {
            <AuthorizeView Roles="Admin,Supervisor,Engineer">
                <NavLink href="/hardware" class="app-nav-link app-nav-link-sub">Hardware</NavLink>
                <AuthorizeView Roles="Admin,Supervisor" Context="modeCtx">
                    <NavLink href="/mode" class="app-nav-link app-nav-link-sub">Station Mode</NavLink>
                </AuthorizeView>
            </AuthorizeView>
        }

        <RecentScansWidget />
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="app-nav-userbox">
                <div class="app-nav-userline">
                    @(context.User.FindFirst("display_name")?.Value ?? context.User.Identity?.Name ?? "")
                </div>
                <div class="app-nav-userline-sub">
                    @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                </div>
                <button type="button" class="app-nav-logout"
                        @onclick="LogoutAsync">Logout</button>
            </div>
        </Authorized>
    </AuthorizeView>
</aside>

@code {
    private async Task LogoutAsync()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("/login", forceLoad: false, replace: true);
    }
}
