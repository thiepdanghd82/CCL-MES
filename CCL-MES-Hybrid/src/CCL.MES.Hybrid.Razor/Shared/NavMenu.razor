@*
  Left-side navigation. Items render with role-gating via <AuthorizeView>:
  the NPI grid is visible to any user the API would let read NPI (matches
  the NpiRead policy: Admin / Supervisor / Engineer / QC). Operator-only
  users see the welcome page until P10.5 ships a shop-floor screen.

  P10.3 W1: Settings group (Hardware + Mode) only renders when the
  HardwareOptions.ScanEnabled flag is on. Hides the buttons entirely
  rather than greying them out so operators don't see a feature they
  can't use. The routes still mount so deep-links from /hardware
  state pages work for an admin who manually flipped the flag locally.
*@
@using CCL.MES.Hybrid.Client.Hardware
@inject IAuthSession Session
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<HardwareOptions> HwOptions

<aside class="app-nav">
    <div class="app-nav-brand">CCL · MES</div>

    <nav>
        <NavLink href="/" Match="NavLinkMatch.All" class="app-nav-link">Trang chủ</NavLink>

        @* P10.5a — NPI Data sub-group. Five read-only grids from legacy
           Phase 7 master data. Engineer Spec list ships in P10.5b.
           NpiRead policy gates the four master-data grids; the Spec
           sub-link tightens to NpiSpecRead (Admin / Supervisor / Engineer
           only — same as legacy /npi/engineer-spec). *@
        <AuthorizeView Roles="Admin,Supervisor,Engineer,QC">
            <div class="app-nav-section">NPI DATA</div>
            <NavLink href="/npi/structure" class="app-nav-link app-nav-link-sub">Cấu trúc (BOM)</NavLink>
            <NavLink href="/npi/routine" class="app-nav-link app-nav-link-sub">Định tuyến</NavLink>
            <NavLink href="/npi/rawmaterials" class="app-nav-link app-nav-link-sub">Nguyên vật liệu</NavLink>
            <NavLink href="/npi/workcenters" class="app-nav-link app-nav-link-sub">Trung tâm sản xuất</NavLink>
            <AuthorizeView Roles="Admin,Supervisor,Engineer" Context="specCtx">
                <NavLink href="/npi/specs" class="app-nav-link app-nav-link-sub">Engineer Spec</NavLink>
            </AuthorizeView>
        </AuthorizeView>

        @if (HwOptions.Value.ScanEnabled)
        {
            @* P10.3 W4 — Work Orders scan→Accept surface. Open to every authenticated
               role because Operator + QC routinely need to advance WOs on the floor.
               Server-side authorization on the advance endpoint stays at the
               FallbackPolicy = RequireAuthenticatedUser. *@
            <div class="app-nav-section">SẢN XUẤT</div>
            <NavLink href="/workorders" class="app-nav-link">Work Orders — Quét</NavLink>
        }

        @* P10.8 — Machine Dashboard (SpecHub parity). Read-only plant
           monitoring; open to every authenticated role. *@
        <div class="app-nav-section">GIÁM SÁT</div>
        <NavLink href="/machines" class="app-nav-link">Bảng máy</NavLink>

        @* P10.6a — Settings group. The landing + Profile + Password are
           self-service (any authenticated role). Hardware + Mode stay
           gated by HardwareOptions.ScanEnabled + role; the Settings
           landing also surfaces the same gates as cards so operators
           who can't reach Hardware/Mode just don't see those cards.
           Remaining sub-tabs (Appearance / Accounts / Audit / About /
           Backup) ship in P10.6b-h. *@
        <div class="app-nav-section">CÀI ĐẶT</div>
        <NavLink href="/settings" Match="NavLinkMatch.All" class="app-nav-link">Tổng quan</NavLink>
        <NavLink href="/settings/profile" class="app-nav-link app-nav-link-sub">Hồ sơ của tôi</NavLink>
        <NavLink href="/settings/password" class="app-nav-link app-nav-link-sub">Đổi mật khẩu</NavLink>
        @* P10.6d — About + Connection Mode (read-only / link-out cards;
           the actual Hardware + Mode change controls stay where P10.3 W1
           put them). *@
        <NavLink href="/settings/connection" class="app-nav-link app-nav-link-sub">Chế độ kết nối</NavLink>
        <NavLink href="/settings/about" class="app-nav-link app-nav-link-sub">Về ứng dụng</NavLink>
        @* P10.6b — Appearance (language picker; theme deferred to 6g). *@
        <NavLink href="/settings/appearance" class="app-nav-link app-nav-link-sub">Giao diện</NavLink>
        @* P10.6h — Backup/Restore — Admin only (page itself is
           [Authorize(Roles="Admin")] + every API endpoint is
           AdminOnly policy). *@
        <AuthorizeView Roles="Admin" Context="bkpCtx">
            <NavLink href="/settings/backup" class="app-nav-link app-nav-link-sub">Sao lưu &amp; Khôi phục</NavLink>
        </AuthorizeView>
        @* P10.6e — Audit Log viewer + CSV/XLSX export — Admin only. *@
        <AuthorizeView Roles="Admin" Context="audCtx">
            <NavLink href="/settings/audit" class="app-nav-link app-nav-link-sub">Nhật ký kiểm tra</NavLink>
        </AuthorizeView>
        @* P10.6c — Account Control — Admin only. *@
        <AuthorizeView Roles="Admin" Context="accCtx">
            <NavLink href="/settings/accounts" class="app-nav-link app-nav-link-sub">Quản lý tài khoản</NavLink>
        </AuthorizeView>
        @if (HwOptions.Value.ScanEnabled)
        {
            <AuthorizeView Roles="Admin,Supervisor,Engineer">
                <NavLink href="/hardware" class="app-nav-link app-nav-link-sub">Thiết bị</NavLink>
                <AuthorizeView Roles="Admin,Supervisor" Context="modeCtx">
                    <NavLink href="/mode" class="app-nav-link app-nav-link-sub">Chế độ trạm</NavLink>
                </AuthorizeView>
            </AuthorizeView>
        }

        @* P10.6f — Recent Scans sidebar widget (SpecHub §11 port).
           Self-hides when empty; renders a "QUÉT GẦN ĐÂY" section + up
           to 5 rows; tap re-opens the scan surface. Client-only —
           backed by MAUI Preferences via IRecentScansService. *@
        <RecentScansWidget />
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="app-nav-userbox">
                <div class="app-nav-userline">
                    @* Show the display_name claim when present, fall back to identity name. *@
                    @(context.User.FindFirst("display_name")?.Value ?? context.User.Identity?.Name ?? "")
                </div>
                <div class="app-nav-userline-sub">
                    @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                </div>
                <button type="button" class="app-nav-logout"
                        @onclick="LogoutAsync">Đăng xuất</button>
            </div>
        </Authorized>
    </AuthorizeView>
</aside>

@code {
    private async Task LogoutAsync()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("/login", forceLoad: false, replace: true);
    }
}
