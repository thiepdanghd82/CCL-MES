@*
  Left-side navigation. Items render with role-gating via <AuthorizeView>:
  the NPI grid is visible to any user the API would let read NPI (matches
  the NpiRead policy: Admin / Supervisor / Engineer / QC). Operator-only
  users see the welcome page until P10.5 ships a shop-floor screen.

  P10.3 W1: Settings group (Hardware + Mode) only renders when the
  HardwareOptions.ScanEnabled flag is on. Hides the buttons entirely
  rather than greying them out so operators don't see a feature they
  can't use. The routes still mount so deep-links from /hardware
  state pages work for an admin who manually flipped the flag locally.
*@
@using CCL.MES.Hybrid.Client.Hardware
@inject IAuthSession Session
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<HardwareOptions> HwOptions

<aside class="app-nav">
    <div class="app-nav-brand">CCL · MES</div>

    <nav>
        <NavLink href="/" Match="NavLinkMatch.All" class="app-nav-link">Trang chủ</NavLink>

        <AuthorizeView Roles="Admin,Supervisor,Engineer,QC">
            <NavLink href="/npi/workcenters" class="app-nav-link">NPI — Work Centers</NavLink>
        </AuthorizeView>

        @if (HwOptions.Value.ScanEnabled)
        {
            @* P10.3 W4 — Work Orders scan→Accept surface. Open to every authenticated
               role because Operator + QC routinely need to advance WOs on the floor.
               Server-side authorization on the advance endpoint stays at the
               FallbackPolicy = RequireAuthenticatedUser. *@
            <div class="app-nav-section">SẢN XUẤT</div>
            <NavLink href="/workorders" class="app-nav-link">Work Orders — Quét</NavLink>

            <AuthorizeView Roles="Admin,Supervisor,Engineer">
                <div class="app-nav-section">CÀI ĐẶT</div>
                <NavLink href="/hardware" class="app-nav-link">Thiết bị</NavLink>
                <AuthorizeView Roles="Admin,Supervisor" Context="modeCtx">
                    <NavLink href="/mode" class="app-nav-link">Chế độ trạm</NavLink>
                </AuthorizeView>
            </AuthorizeView>
        }
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="app-nav-userbox">
                <div class="app-nav-userline">
                    @* Show the display_name claim when present, fall back to identity name. *@
                    @(context.User.FindFirst("display_name")?.Value ?? context.User.Identity?.Name ?? "")
                </div>
                <div class="app-nav-userline-sub">
                    @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                </div>
                <button type="button" class="app-nav-logout"
                        @onclick="LogoutAsync">Đăng xuất</button>
            </div>
        </Authorized>
    </AuthorizeView>
</aside>

@code {
    private async Task LogoutAsync()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("/login", forceLoad: false, replace: true);
    }
}
