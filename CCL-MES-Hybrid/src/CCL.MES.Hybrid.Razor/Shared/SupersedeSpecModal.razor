@inject ICclApiClient Api
@using CCL.MES.Hybrid.Client.Specs

@*
    P10.5c-1 — Mark Superseded (manual). 2-step confirm UX: operator
    must type the SpecCode exactly into the textbox. Server-side
    re-validates the typed value (Q2 defence-in-depth — UI nudge +
    server enforce).
*@

<Modal Open="@Open" OnClose="@RequestCloseAsync" Size="ModalSize.Md" Severity="ModalSeverity.Danger"
       ClickOutsideToClose="false">
    <Header>Đánh dấu Spec @SourceSpec?.SpecCode đã thay thế</Header>
    <Body>
        @if (SourceSpec is null)
        {
            <p class="grid-status">Chưa có Spec.</p>
        }
        else
        {
            <p class="modal-helper">
                Đánh dấu Spec này là <strong>Đã thay thế</strong> sẽ khoá khả năng phát hành tiếp.
                Hành động này không tự hoàn tác (cần tạo Revise mới nếu muốn quay lại quy trình).
            </p>
            <form @onsubmit:preventDefault="true">
                <div class="modal-field">
                    <label for="ss-confirm">
                        Gõ chính xác mã Spec
                        <code class="modal-confirm-target">@SourceSpec.SpecCode</code>
                        để xác nhận <span class="modal-req">*</span>
                    </label>
                    <input id="ss-confirm" type="text" class="modal-input"
                           autocomplete="off" autocorrect="off" spellcheck="false"
                           @bind="_confirmCode" @bind:event="oninput" disabled="@_submitting" />
                </div>
                @if (_error is not null)
                {
                    <div class="modal-banner modal-banner-error" role="alert">@_error</div>
                }
            </form>
        }
    </Body>
    <Footer>
        <button type="button" class="op-btn op-btn-secondary"
                disabled="@_submitting" @onclick="RequestCloseAsync">Hủy</button>
        <button type="button" class="op-btn op-btn-danger"
                disabled="@(!CanSubmit())" @onclick="SubmitAsync">
            @(_submitting ? "Đang đánh dấu…" : "Đánh dấu thay thế")
        </button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public SpecDetailItem? SourceSpec { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SpecMutationResponse> OnSuperseded { get; set; }

    private string _confirmCode = "";
    private bool _submitting;
    private string? _error;

    private bool CanSubmit() =>
        !_submitting
        && SourceSpec is not null
        && string.Equals(_confirmCode?.Trim() ?? "", SourceSpec.SpecCode, StringComparison.Ordinal);

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            _confirmCode = "";
            _error = null;
        }
    }

    private async Task SubmitAsync()
    {
        if (_submitting || !CanSubmit() || SourceSpec is null) return;
        _submitting = true;
        _error = null;
        try
        {
            var resp = await Api.SupersedeSpecAsync(SourceSpec.Id, new SupersedeSpecMutation
            {
                ConfirmSpecCode = _confirmCode.Trim(),
            });
            if (OnSuperseded.HasDelegate) await OnSuperseded.InvokeAsync(resp);
            _confirmCode = "";
            if (OnClose.HasDelegate) await OnClose.InvokeAsync();
        }
        catch (ApiException apiEx) { _error = SpecMutationErrorMapper.ToVietnameseMessage(apiEx); }
        catch (HttpRequestException ex) { _error = $"Không kết nối được máy chủ: {ex.Message}"; }
        catch (Exception ex) { _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _submitting = false; }
    }

    private async Task RequestCloseAsync()
    {
        if (_submitting) return;
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }
}
