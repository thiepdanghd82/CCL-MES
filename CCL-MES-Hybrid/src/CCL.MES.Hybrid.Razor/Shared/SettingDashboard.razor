@*
    P10.7c-3 — SETTING phase operator dashboard.

    Hosted inside WorkOrders.razor when the scanned WO has
    MesPhase=SETTING. Owns the entire RunningSurfaceView state +
    every API call that mutates it.

    Entry behaviour (closes the 7c-2 gap):
      - On first load, if MesPhase=SETTING and SettingStartAt is null
        we fire POST /setting/enter once to stamp the timer. The
        helper is idempotent server-side so a stray re-load can't
        reset the clock.

    Render:
      - Live setting timer (HH:MM:SS since SettingStartAt, ticks every
        second via a System.Timers.Timer scoped to this component).
      - 6-item operator checklist. Each item is a local boolean — NOT
        persisted server-side in 7c-3 (operator-attestation only; if a
        future audit needs persistence, we'll mint wo_setting_checks
        in 7d). All 6 must be ticked + setting/done becomes enabled.
      - Single primary button: "Hoàn tất Setting (chuyển bước)"
        → POST /setting/done → SETTING → IPQC_WAIT.

    Concurrency / error handling matches PrepressDashboard:
      - 200 → swap state from the response (MesPhase + ETag) then
        refetch the view to capture SettingEndAt + duration for the
        post-write banner.
      - 409 wo.state_conflict → refetch + show banner (the same
        response carries the fresh ETag).
      - 422 wo.invalid_phase → collapse to "không ở SETTING" banner.
      - Network → red banner with retry tip.

    Rule 4: plain <input> + <button>, NO <InputText>. No form fields
    here other than the checklist checkboxes which are <input type="checkbox">.
*@

@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using System.Timers
@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.RunningSurface
@using CCL.MES.Shared.Envelopes
@using CCL.MES.Shared.RunningSurface
@inject ICclApiClient Api

<div class="rs-dashboard" data-testid="setting-dashboard">
    @if (_view is null && _initialError is null)
    {
        <div class="rs-loading" data-testid="setting-loading">@T("setting.loading")</div>
    }
    else if (_initialError is not null)
    {
        <div class="wo-card-error" data-testid="setting-initial-error">
            <strong>@T("setting.error.load")</strong> @_initialError
        </div>
    }
    else if (_invalidPhase)
    {
        <div class="wo-card-error" data-testid="setting-invalid-phase">
            <strong>@T("setting.invalidphase.title")</strong> —
            @T("setting.invalidphase.current") <code>@(_view?.MesPhase ?? "?")</code>.
            @T("setting.invalidphase.hint")
        </div>
    }
    else if (_view is not null)
    {
        <div class="rs-head">
            <div class="rs-head-wo">
                <span class="rs-head-label">WO</span>
                <span class="rs-head-wo-no">@_view.WoNo</span>
                <StatusPill Phase="@_view.MesPhase" />
            </div>
            <div class="rs-head-timer" data-testid="setting-timer">
                <span class="rs-timer-label">@T("setting.timer.label")</span>
                <span class="rs-timer-value scan-mono">@FormatTimer()</span>
            </div>
        </div>

        @if (_setError is not null)
        {
            <div class="wo-card-error" data-testid="setting-set-error">
                <strong>@T("setting.error.save")</strong> @_setError
                <button type="button" class="op-btn op-btn-secondary op-btn-sm"
                        @onclick="DismissSetError"
                        data-testid="setting-set-error-dismiss">@T("setting.dismiss")</button>
            </div>
        }

        <div class="rs-card rs-card-stretch">
            <div class="rs-card-head">
                <div class="rs-card-title">@T("setting.checklist.title")</div>
                <div class="rs-card-pill" data-testid="setting-count">
                    @T("setting.checklist.confirmed", ActiveOkCount, ActiveItems.Length)
                </div>
            </div>

            @* Hai quy trình khác nhau: In (makeready) vs Cắt (die-cut).
               Chip-button, KHÔNG native <select> (WKWebView freeze). *@
            <div class="setting-subtabs" role="tablist" data-testid="setting-subtabs">
                <button type="button"
                        class="setting-subtab @(_activeTab == SettingTab.Print ? "is-active" : "")"
                        role="tab" aria-selected="@(_activeTab == SettingTab.Print)"
                        @onclick="@(() => _activeTab = SettingTab.Print)"
                        data-testid="setting-tab-print">
                    @T("setting.tab.print")
                    <span class="setting-subtab-count scan-mono">@OkCount(_printItems)/@_printItems.Length</span>
                </button>
                <button type="button"
                        class="setting-subtab @(_activeTab == SettingTab.Cut ? "is-active" : "")"
                        role="tab" aria-selected="@(_activeTab == SettingTab.Cut)"
                        @onclick="@(() => _activeTab = SettingTab.Cut)"
                        data-testid="setting-tab-cut">
                    @T("setting.tab.cut")
                    <span class="setting-subtab-count scan-mono">@OkCount(_cutItems)/@_cutItems.Length</span>
                </button>
            </div>

            <div class="setting-check-wrap" data-testid="setting-checklist">
                <table class="setting-table">
                    <thead>
                        <tr>
                            <th class="c-no">@T("setting.col.no")</th>
                            <th>@T("setting.col.item")</th>
                            <th class="wrap">@T("setting.col.standard")</th>
                            <th class="c-center c-conf">@T("confirm.header")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var items = ActiveItems;
                            var prefix = ActivePrefix;
                        }
                        @for (var i = 0; i < items.Length; i++)
                        {
                            var it = items[i];
                            var st = Status(it.Key);
                            <tr class="setting-row @RowClass(st)"
                                data-testid="@($"setting-row-{prefix}-{i}")">
                                <td class="c-no">@(i + 1)</td>
                                <td class="setting-row-item">@T(it.LabelKey)</td>
                                <td class="wrap setting-row-std">@T(it.StdKey)</td>
                                <td class="c-center c-conf">
                                    <ConfirmToggle Status="@st"
                                                   Disabled="@_busy"
                                                   TestIdPrefix="@($"setting-item-{prefix}-{i}")"
                                                   OnOk="@(() => SetStatus(it.Key, "Ok"))"
                                                   OnNg="@(() => SetStatus(it.Key, "Ng"))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="rs-action-bar">
            <button type="button"
                    class="op-btn op-btn-primary rs-primary-btn"
                    data-testid="setting-done-btn"
                    disabled="@(!AllChecked || _busy)"
                    @onclick="OnSettingDoneAsync">
                @T("setting.done.button")
            </button>
            @if (!AllChecked)
            {
                <span class="rs-action-hint" data-testid="setting-action-hint">
                    @T("setting.action.hint")
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public long WorkOrderId { get; set; }

    /// <summary>P10.7d-3 BUG-FIX (Henry RCA on PR #119) — invoked
    /// after a successful /setting/done so the parent (WorkOrders.razor)
    /// re-fetches the summary + dispatch picks up IPQC_WAIT, mounting
    /// IpqcDashboard automatically. Without this the operator had to
    /// tap "Tìm" to leave the now-invalid SettingDashboard. See Lesson L21.</summary>
    [Parameter] public EventCallback OnPhaseChanged { get; set; }

    // Two process-specific setting checklists: Print (makeready) vs Cut (die-cut).
    // Operator-attestation only — NOT server-persisted in 7c-3. When Henry approves
    // a schema (WoSettingCheckItem + migration + AuditAction) we persist per-item
    // OK/NG the same way WoIpqcCheck does; for now the status lives in _status.
    // TODO(persist): mint wo_setting_check_items + advance-guard on server rollup.
    // TODO(routing): D2 — show only the tab(s) the WO's routing actually needs
    //   (PRINT leg → Print tab, CUT leg → Cut tab). Today both tabs always show
    //   and BOTH must be all-OK to advance, which suits full print+die-cut labels.
    private sealed record SettingItem(string Key, string LabelKey, string StdKey);

    private static readonly SettingItem[] _printItems =
    {
        new("print-0", "setting.print.item0", "setting.print.std0"),
        new("print-1", "setting.print.item1", "setting.print.std1"),
        new("print-2", "setting.print.item2", "setting.print.std2"),
        new("print-3", "setting.print.item3", "setting.print.std3"),
        new("print-4", "setting.print.item4", "setting.print.std4"),
        new("print-5", "setting.print.item5", "setting.print.std5"),
        new("print-6", "setting.print.item6", "setting.print.std6"),
        new("print-7", "setting.print.item7", "setting.print.std7"),
        new("print-8", "setting.print.item8", "setting.print.std8"),
        new("print-9", "setting.print.item9", "setting.print.std9"),
    };

    private static readonly SettingItem[] _cutItems =
    {
        new("cut-0", "setting.cut.item0", "setting.cut.std0"),
        new("cut-1", "setting.cut.item1", "setting.cut.std1"),
        new("cut-2", "setting.cut.item2", "setting.cut.std2"),
        new("cut-3", "setting.cut.item3", "setting.cut.std3"),
        new("cut-4", "setting.cut.item4", "setting.cut.std4"),
        new("cut-5", "setting.cut.item5", "setting.cut.std5"),
        new("cut-6", "setting.cut.item6", "setting.cut.std6"),
        new("cut-7", "setting.cut.item7", "setting.cut.std7"),
        new("cut-8", "setting.cut.item8", "setting.cut.std8"),
        new("cut-9", "setting.cut.item9", "setting.cut.std9"),
    };

    private enum SettingTab { Print, Cut }
    private SettingTab _activeTab = SettingTab.Print;

    // Per-item local status keyed by SettingItem.Key: "Pending" | "Ok" | "Ng".
    private readonly Dictionary<string, string> _status = new();

    private RunningSurfaceView? _view;
    private string? _initialError;
    private string? _setError;
    private bool _busy;
    private bool _invalidPhase;
    private long _lastLoadedWoId;
    private Timer? _ticker;

    private SettingItem[] ActiveItems => _activeTab == SettingTab.Print ? _printItems : _cutItems;
    private string ActivePrefix => _activeTab == SettingTab.Print ? "print" : "cut";

    private string Status(string key) => _status.TryGetValue(key, out var v) ? v : "Pending";
    private void SetStatus(string key, string status) => _status[key] = status;

    private int OkCount(SettingItem[] items) => items.Count(it => Status(it.Key) == "Ok");
    private int ActiveOkCount => OkCount(ActiveItems);

    // Advance is gated on every item across BOTH process tabs being OK. An NG or a
    // still-Pending row keeps "Finish Setting" disabled (matches the old all-ticked gate).
    private bool AllChecked =>
        _printItems.Concat(_cutItems).All(it => Status(it.Key) == "Ok");

    private static string RowClass(string status) => status switch
    {
        "Ok" => "is-ok",
        "Ng" => "is-ng",
        _    => "is-pending",
    };

    protected override async Task OnParametersSetAsync()
    {
        if (WorkOrderId != _lastLoadedWoId)
        {
            _lastLoadedWoId = WorkOrderId;
            _view = null;
            _initialError = null;
            _setError = null;
            _invalidPhase = false;
            // Reset checklist between WOs so a fresh tab starts clean.
            _status.Clear();
            _activeTab = SettingTab.Print;
            await ReloadAsync();
            await EnterIfNeededAsync();
            EnsureTicker();
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _view = await Api.GetRunningSurfaceViewAsync(WorkOrderId);
            _invalidPhase = _view.MesPhase != "SETTING";
        }
        catch (ApiException apiEx)
        {
            _initialError = RunningSurfaceErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (HttpRequestException ex)
        {
            _initialError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _initialError = $"Error loading SETTING status: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private async Task EnterIfNeededAsync()
    {
        if (_view is null || _invalidPhase) return;
        if (_view.SettingStartAt is not null) return; // already stamped
        // Fire-and-forget-ish: capture errors into the set-error banner but
        // don't block render. After success we refetch to surface the stamp.
        _busy = true;
        try
        {
            var resp = await Api.PostSettingEnterAsync(WorkOrderId, _view.ETag);
            if (resp.Ok)
            {
                await ReloadAsync();
            }
            else if (!string.IsNullOrEmpty(resp.ErrorCode))
            {
                _setError = RunningSurfaceErrorLocaliser.LocaliseSetError(resp.ErrorCode);
                await ReloadAsync();
            }
        }
        catch (ApiException apiEx)
        {
            _setError = RunningSurfaceErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnSettingDoneAsync()
    {
        if (_view is null || !AllChecked || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var resp = await Api.PostSettingDoneAsync(WorkOrderId, _view.ETag);
            if (resp.Ok)
            {
                await ReloadAsync();
                // P10.7d-3 BUG-FIX — bubble phase change SETTING → IPQC_WAIT
                // so the parent re-fetches the summary + dispatch routes to
                // IpqcDashboard without the operator tapping "Tìm". See L21.
                await OnPhaseChanged.InvokeAsync();
            }
            else if (!string.IsNullOrEmpty(resp.ErrorCode))
            {
                _setError = RunningSurfaceErrorLocaliser.LocaliseSetError(resp.ErrorCode);
                await ReloadAsync();
            }
            else
            {
                _setError = "Server returned Ok=false without an error code — report to IT.";
            }
        }
        catch (ApiException apiEx)
        {
            _setError = RunningSurfaceErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void EnsureTicker()
    {
        _ticker?.Dispose();
        _ticker = new Timer(1000) { AutoReset = true, Enabled = true };
        _ticker.Elapsed += async (_, __) => await InvokeAsync(StateHasChanged);
    }

    private string FormatTimer()
    {
        var start = _view?.SettingStartAt;
        if (start is null) return "00:00:00";
        var elapsed = DateTime.UtcNow - start.Value;
        if (elapsed.TotalSeconds < 0) elapsed = TimeSpan.Zero;
        return $"{(int)elapsed.TotalHours:D2}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
    }

    private void DismissSetError() => _setError = null;

    public override void Dispose()
    {
        _ticker?.Dispose();
        _ticker = null;
        base.Dispose();
    }
}
