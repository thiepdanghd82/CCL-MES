@*
    P10.7g-3 — SETTING phase operator dashboard (API-driven).

    Hosted inside WorkOrders.razor when the scanned WO has
    MesPhase=SETTING. Owns two server views:
      - RunningSurfaceView (_view)  → timer / enter / done + HasPrint/HasCut
      - SettingChecksView  (_checks) → the per-item checklist (materialised
        server-side from CheckItemLibrary per-product). Each item carries
        its own status / applicable / defect + per-item defect drop-list +
        a server-computed Ready rollup that gates /setting/done.

    7g change (from 7c-3): the checklist is no longer attestation-cục-bộ
    RAM (_status/_applicable/_defect dicts + hard-coded _printItems/_cutItems).
    Every OK/NG/applicable/defect toggle now PUTs to
    /work-orders/{id}/setting-checks/{itemKey} (If-Match ETag from _checks);
    200 → refetch, 409 wo.state_conflict → banner + refetch (optimistic
    revert), 422 → localiser banner. Two add-new affordances land per the
    cmes-add-new-inline skill:
      - F3 "＋ Thêm mới…" at the tail of each NG defect dropdown (Engineer+
        only, RBAC-by-omission) → inline form → POST .../defect.
      - F4 "＋ Thêm hạng mục" under the last row of each tab → inline form
        → POST .../item (server branches per-product master vs ad-hoc).

    Concurrency / error handling matches IpqcDashboard.

    Rule 4: plain <input> + <button> + <select>, NO <InputText>/<EditForm>.
*@

@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using System.Timers
@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.Auth
@using CCL.MES.Hybrid.Client.RunningSurface
@using CCL.MES.Shared.Envelopes
@using CCL.MES.Shared.RunningSurface
@using CCL.MES.Shared.SettingChecks
@inject ICclApiClient Api
@inject IAuthSession Session

<div class="rs-dashboard" data-testid="setting-dashboard">
    @if (_view is null && _initialError is null)
    {
        <div class="rs-loading" data-testid="setting-loading">@T("setting.loading")</div>
    }
    else if (_initialError is not null)
    {
        <div class="wo-card-error" data-testid="setting-initial-error">
            <strong>@T("setting.error.load")</strong> @_initialError
        </div>
    }
    else if (_invalidPhase)
    {
        <div class="wo-card-error" data-testid="setting-invalid-phase">
            <strong>@T("setting.invalidphase.title")</strong> —
            @T("setting.invalidphase.current") <code>@(_view?.MesPhase ?? "?")</code>.
            @T("setting.invalidphase.hint")
        </div>
    }
    else if (_view is not null)
    {
        <div class="rs-head">
            <div class="rs-head-wo">
                <span class="rs-head-label">WO</span>
                <span class="rs-head-wo-no">@_view.WoNo</span>
                <StatusPill Phase="@_view.MesPhase" />
            </div>
            <div class="rs-head-timer" data-testid="setting-timer">
                <span class="rs-timer-label">@T("setting.timer.label")</span>
                <span class="rs-timer-value scan-mono">@FormatTimer()</span>
            </div>
        </div>

        @if (_setError is not null)
        {
            <div class="wo-card-error" data-testid="setting-set-error">
                <strong>@T("setting.error.save")</strong> @_setError
                <button type="button" class="op-btn op-btn-secondary op-btn-sm"
                        @onclick="DismissSetError"
                        data-testid="setting-set-error-dismiss">@T("setting.dismiss")</button>
            </div>
        }

        <div class="rs-card rs-card-stretch">
            <div class="rs-card-head">
                <div class="rs-card-title">@T("setting.checklist.title")</div>
                <div class="rs-card-pill" data-testid="setting-count">
                    @T("setting.checklist.confirmed", ActiveOkCount, ActiveApplicableCount)
                </div>
            </div>

            @* Hai quy trình khác nhau: In (makeready) vs Cắt (die-cut).
               Chip-button, KHÔNG native <select> (WKWebView freeze). Chỉ hiện
               tab mà routing của WO thật sự cần (HasPrint/HasCut); routing chưa
               map → hiện cả hai (an toàn, giữ đủ coverage). *@
            @if (ShowPrint && ShowCut)
            {
                <div class="setting-subtabs" role="tablist" data-testid="setting-subtabs">
                    <button type="button"
                            class="setting-subtab @(_activeTab == SettingTab.Print ? "is-active" : "")"
                            role="tab" aria-selected="@(_activeTab == SettingTab.Print)"
                            disabled="@_hasPendingNg"
                            @onclick="@(() => _activeTab = SettingTab.Print)"
                            data-testid="setting-tab-print">
                        @T("setting.tab.print")
                        <span class="setting-subtab-count scan-mono">@OkCount(PrintItems)/@ApplicableCount(PrintItems)</span>
                    </button>
                    <button type="button"
                            class="setting-subtab @(_activeTab == SettingTab.Cut ? "is-active" : "")"
                            role="tab" aria-selected="@(_activeTab == SettingTab.Cut)"
                            disabled="@_hasPendingNg"
                            @onclick="@(() => _activeTab = SettingTab.Cut)"
                            data-testid="setting-tab-cut">
                        @T("setting.tab.cut")
                        <span class="setting-subtab-count scan-mono">@OkCount(CutItems)/@ApplicableCount(CutItems)</span>
                    </button>
                </div>
            }
            else
            {
                @* Single-process WO → no switcher, just name the active process. *@
                <div class="setting-single-process" data-testid="setting-single-process">
                    @T(_activeTab == SettingTab.Print ? "setting.tab.print" : "setting.tab.cut")
                </div>
            }

            @if (_hasPendingNg)
            {
                <div class="setting-pending-ng-hint" data-testid="setting-pending-ng-hint">
                    @T("setting.ng.pick_first")
                </div>
            }

            <div class="setting-check-wrap" data-testid="setting-checklist">
                <table class="setting-table">
                    @{
                        var items = ActiveItems;
                        var prefix = ActivePrefix;
                        var allApplied = items.Count > 0 && items.All(it => it.Applicable);
                    }
                    <thead>
                        <tr>
                            <th class="c-app c-center" title="@T("setting.applyall")">
                                <input type="checkbox" checked="@allApplied"
                                       @onchange="@(e => SetApplicableAll(items, e.Value is bool b && b))"
                                       disabled="@_busy"
                                       aria-label="@T("setting.applyall")"
                                       data-testid="@($"setting-applyall-{prefix}")" />
                            </th>
                            <th class="c-no">@T("setting.col.no")</th>
                            <th>@T("setting.col.item")</th>
                            <th class="wrap">@T("setting.col.standard")</th>
                            <th class="c-center c-result">@T("setting.col.result")</th>
                            <th class="wrap c-defect">@T("setting.col.defect")</th>
                            <th class="c-center c-conf">@T("confirm.header")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < items.Count; i++)
                        {
                            var it = items[i];
                            var idx = i;
                            <tr class="setting-row @RowClass(it)"
                                data-testid="@($"setting-row-{prefix}-{idx}")">
                                <td class="c-app c-center">
                                    <input type="checkbox" checked="@it.Applicable"
                                           @onchange="@(e => OnSetApplicableAsync(it, e.Value is bool b && b))"
                                           disabled="@(_busy || RowLocked(it))"
                                           aria-label="@T("setting.col.apply")"
                                           data-testid="@($"setting-apply-{prefix}-{idx}")" />
                                </td>
                                <td class="c-no">@(idx + 1)</td>
                                <td class="setting-row-item">@(it.Label ?? it.ItemKey)</td>
                                <td class="wrap setting-row-std">@(it.Standard ?? "")</td>
                                <td class="c-center c-result">
                                    <span class="setting-result @ResultCss(it)"
                                          data-testid="@($"setting-result-{prefix}-{idx}")">@ResultLabel(it)</span>
                                </td>
                                <td class="wrap c-defect">
                                    @if (it.Applicable && IsNgActive(it))
                                    {
                                        <select class="setting-defect-select"
                                                value="@(it.DefectCode ?? "")"
                                                @onchange="@(e => OnDefectChangedAsync(it, e.Value?.ToString() ?? ""))"
                                                disabled="@_busy"
                                                data-testid="@($"setting-defect-{prefix}-{idx}")">
                                            <option value="">@T("setting.defect.select")</option>
                                            @foreach (var d in it.DefectOptions)
                                            {
                                                <option value="@d.DefectCode">@d.DefectCode — @d.LabelVi</option>
                                            }
                                            @if (_canAddNew)
                                            {
                                                <option value="@AddNewValue"
                                                        data-testid="@($"setting-defect-{prefix}-{idx}-addnew")">@T("setting.addnew.option")</option>
                                            }
                                        </select>

                                        @if (_addDefectFor == it.ItemKey)
                                        {
                                            <div class="setting-addnew-form" data-testid="@($"setting-defect-{prefix}-{idx}-addnew-form")">
                                                <label class="setting-addnew-label">@T("setting.addnew.defect.code")</label>
                                                <input type="text" class="setting-addnew-input" maxlength="64"
                                                       value="@_newDefectCode"
                                                       @oninput="@(e => _newDefectCode = e.Value?.ToString() ?? "")"
                                                       data-testid="@($"setting-defect-{prefix}-{idx}-addnew-code")" />
                                                <label class="setting-addnew-label">@T("setting.addnew.defect.vi")</label>
                                                <input type="text" class="setting-addnew-input" maxlength="256"
                                                       value="@_newDefectVi"
                                                       @oninput="@(e => _newDefectVi = e.Value?.ToString() ?? "")"
                                                       data-testid="@($"setting-defect-{prefix}-{idx}-addnew-vi")" />
                                                <label class="setting-addnew-label">@T("setting.addnew.defect.en")</label>
                                                <input type="text" class="setting-addnew-input" maxlength="256"
                                                       value="@_newDefectEn"
                                                       @oninput="@(e => _newDefectEn = e.Value?.ToString() ?? "")"
                                                       data-testid="@($"setting-defect-{prefix}-{idx}-addnew-en")" />
                                                <div class="setting-addnew-actions">
                                                    <button type="button" class="op-btn op-btn-secondary op-btn-sm"
                                                            @onclick="CloseAddDefect"
                                                            data-testid="@($"setting-defect-{prefix}-{idx}-addnew-cancel")">@T("setting.addnew.cancel")</button>
                                                    <button type="button" class="op-btn op-btn-primary op-btn-sm"
                                                            disabled="@(!CanSaveDefect || _busy)"
                                                            @onclick="@(() => OnSaveDefectAsync(it))"
                                                            data-testid="@($"setting-defect-{prefix}-{idx}-addnew-save")">@T("setting.addnew.save")</button>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="setting-muted">—</span>
                                    }
                                </td>
                                <td class="c-center c-conf">
                                    <ConfirmToggle Status="@EffectiveStatus(it)"
                                                   Disabled="@(_busy || !it.Applicable || RowLocked(it))"
                                                   TestIdPrefix="@($"setting-item-{prefix}-{idx}")"
                                                   OnOk="@(() => OnSetOkAsync(it))"
                                                   OnNg="@(() => OnArmNg(it))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* F4 — add a new check item under the last row of this tab. *@
                <button type="button"
                        class="op-btn op-btn-secondary setting-addrow-btn"
                        disabled="@_busy"
                        @onclick="OpenAddRow"
                        data-testid="@($"setting-{prefix}-addrow")">
                    @T("setting.addrow.button")
                </button>

                @if (_addRowForTab == _activeTab)
                {
                    <div class="setting-addnew-form setting-addrow-form"
                         data-testid="@($"setting-{prefix}-addrow-form")">
                        <label class="setting-addnew-label">@T("setting.addrow.name")</label>
                        <input type="text" class="setting-addnew-input" maxlength="512"
                               value="@_newItemLabel"
                               @oninput="@(e => _newItemLabel = e.Value?.ToString() ?? "")"
                               data-testid="@($"setting-{prefix}-addrow-name")" />
                        <label class="setting-addnew-label">@T("setting.addrow.standard")</label>
                        <input type="text" class="setting-addnew-input" maxlength="512"
                               value="@_newItemStandard"
                               @oninput="@(e => _newItemStandard = e.Value?.ToString() ?? "")"
                               data-testid="@($"setting-{prefix}-addrow-standard")" />
                        <div class="setting-addnew-actions">
                            <button type="button" class="op-btn op-btn-secondary op-btn-sm"
                                    @onclick="CloseAddRow"
                                    data-testid="@($"setting-{prefix}-addrow-cancel")">@T("setting.addnew.cancel")</button>
                            <button type="button" class="op-btn op-btn-primary op-btn-sm"
                                    disabled="@(!CanSaveItem || _busy)"
                                    @onclick="OnSaveItemAsync"
                                    data-testid="@($"setting-{prefix}-addrow-save")">@T("setting.addnew.save")</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="rs-action-bar">
            <button type="button"
                    class="op-btn op-btn-primary rs-primary-btn"
                    data-testid="setting-done-btn"
                    disabled="@(!DoneEnabled || _busy)"
                    @onclick="OnSettingDoneAsync">
                @T("setting.done.button")
            </button>
            @if (!DoneEnabled)
            {
                <span class="rs-action-hint" data-testid="setting-action-hint">
                    @T("setting.action.hint")
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public long WorkOrderId { get; set; }

    /// <summary>P10.7d-3 BUG-FIX (Henry RCA on PR #119) — invoked
    /// after a successful /setting/done so the parent (WorkOrders.razor)
    /// re-fetches the summary + dispatch picks up IPQC_WAIT, mounting
    /// IpqcDashboard automatically. See Lesson L21.</summary>
    [Parameter] public EventCallback OnPhaseChanged { get; set; }

    private const string AddNewValue = "__add_new__";

    private enum SettingTab { Print, Cut }
    private SettingTab _activeTab = SettingTab.Print;

    // Two server views: timer/phase surface + the persisted checklist (7g).
    private RunningSurfaceView? _view;
    private SettingChecksView? _checks;

    private string? _initialError;
    private string? _setError;
    private bool _busy;
    private bool _invalidPhase;
    private long _lastLoadedWoId;
    private Timer? _ticker;

    // F3 add-new-defect inline form state (single open at a time, keyed by ItemKey).
    private string? _addDefectFor;
    private string _newDefectCode = "";
    private string _newDefectVi = "";
    private string _newDefectEn = "";

    // F4 add-row inline form state (single open at a time, keyed by tab).
    private SettingTab? _addRowForTab;
    private string _newItemLabel = "";
    private string _newItemStandard = "";

    // RBAC-by-omission: only Engineer+ can register a per-product defect/master item.
    private bool _canAddNew =>
        Session.CurrentUserInfo?.Role is "Admin" or "Supervisor" or "Engineer";

    private IReadOnlyList<SettingCheckItemView> PrintItems =>
        _checks is null ? Array.Empty<SettingCheckItemView>()
        : _checks.Items.Where(IsPrint).OrderBy(i => i.Sort).ToList();

    private IReadOnlyList<SettingCheckItemView> CutItems =>
        _checks is null ? Array.Empty<SettingCheckItemView>()
        : _checks.Items.Where(i => !IsPrint(i)).OrderBy(i => i.Sort).ToList();

    private static bool IsPrint(SettingCheckItemView it) =>
        string.Equals(it.ProcessKind, "Print", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<SettingCheckItemView> ActiveItems =>
        _activeTab == SettingTab.Print ? PrintItems : CutItems;
    private string ActivePrefix => _activeTab == SettingTab.Print ? "print" : "cut";

    // Which tabs the WO's routing needs. Null view → both true (safe default).
    private bool ShowPrint => _view?.HasPrintProcess ?? true;
    private bool ShowCut => _view?.HasCutProcess ?? true;

    private void ClampActiveTab()
    {
        if (_activeTab == SettingTab.Print && !ShowPrint && ShowCut) _activeTab = SettingTab.Cut;
        else if (_activeTab == SettingTab.Cut && !ShowCut && ShowPrint) _activeTab = SettingTab.Print;
    }

    private static int OkCount(IReadOnlyList<SettingCheckItemView> items) =>
        items.Count(it => it.Applicable && it.Status == "Ok");
    private static int ApplicableCount(IReadOnlyList<SettingCheckItemView> items) =>
        items.Count(it => it.Applicable);

    private int ActiveOkCount => OkCount(ActiveItems);
    private int ActiveApplicableCount => ApplicableCount(ActiveItems);

    // Advance gate: prefer the server-computed rollup (Ready). Fall back to a
    // client tally only when the checks view is missing (defensive).
    private bool DoneEnabled => _checks?.Ready ?? ClientReady;
    private bool ClientReady
    {
        get
        {
            if (_checks is null) return false;
            var applicable = _checks.Items.Where(i => i.Applicable).ToList();
            return applicable.Count > 0 && applicable.All(i => i.Status == "Ok");
        }
    }

    // NG là thao tác 2 bước (như IPQC): tap NG "arm" cục bộ → hiện dropdown defect
    // → chọn defect mới PUT (server bắt buộc defect khi NG). KHÔNG PUT lúc tap NG
    // vì chưa có defect → server 422. _armNg giữ các item đang arm, chưa persist.
    private readonly HashSet<string> _armNg = new();

    /// <summary>Trạng thái hiển thị: item đang arm-NG (chưa persist) vẫn hiện NG.</summary>
    private string EffectiveStatus(SettingCheckItemView it) =>
        _armNg.Contains(it.ItemKey) ? "Ng" : it.Status;

    /// <summary>NG đang bật (đã persist Ng HOẶC đang arm) → hiện dropdown defect.</summary>
    private bool IsNgActive(SettingCheckItemView it) =>
        it.Status == "Ng" || _armNg.Contains(it.ItemKey);

    /// <summary>Có hạng mục vừa đánh NG nhưng CHƯA chọn defect (arm, chưa persist).
    /// Buộc chọn defect trước khi đánh giá hạng mục khác.</summary>
    private bool _hasPendingNg => _armNg.Count > 0;

    /// <summary>Khoá control hàng khác trong khi còn một NG chưa chọn defect —
    /// operator phải hoàn tất (chọn defect) HOẶC bấm OK để bỏ NG rồi mới đi tiếp.</summary>
    private bool RowLocked(SettingCheckItemView it) =>
        _hasPendingNg && !_armNg.Contains(it.ItemKey);

    private string ResultCss(SettingCheckItemView it) =>
        !it.Applicable ? "setting-result-na"
        : EffectiveStatus(it) switch { "Ok" => "setting-result-ok", "Ng" => "setting-result-ng", _ => "setting-result-pending" };

    private string ResultLabel(SettingCheckItemView it) =>
        !it.Applicable ? T("setting.result.na")
        : EffectiveStatus(it) switch
        {
            "Ok" => T("setting.result.pass"),
            "Ng" => T("setting.result.ng"),
            _    => "—",
        };

    private string RowClass(SettingCheckItemView it)
    {
        if (!it.Applicable) return "is-na";
        return EffectiveStatus(it) switch { "Ok" => "is-ok", "Ng" => "is-ng", _ => "is-pending" };
    }

    // ── Load ────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        if (WorkOrderId != _lastLoadedWoId)
        {
            _lastLoadedWoId = WorkOrderId;
            _view = null;
            _checks = null;
            _initialError = null;
            _setError = null;
            _invalidPhase = false;
            _activeTab = SettingTab.Print;
            _armNg.Clear();
            ResetAddForms();
            await ReloadAsync();
            ClampActiveTab();
            await EnterIfNeededAsync();
            EnsureTicker();
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _view = await Api.GetRunningSurfaceViewAsync(WorkOrderId);
            _invalidPhase = _view.MesPhase != "SETTING";
            if (!_invalidPhase)
                _checks = await Api.GetSettingChecksAsync(WorkOrderId);
        }
        catch (ApiException apiEx)
        {
            _initialError = RunningSurfaceErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (HttpRequestException ex)
        {
            _initialError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _initialError = $"Error loading SETTING status: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private async Task EnterIfNeededAsync()
    {
        if (_view is null || _invalidPhase) return;
        if (_view.SettingStartAt is not null) return; // already stamped
        _busy = true;
        try
        {
            var resp = await Api.PostSettingEnterAsync(WorkOrderId, _view.ETag);
            if (resp.Ok)
            {
                await ReloadAsync();
            }
            else if (!string.IsNullOrEmpty(resp.ErrorCode))
            {
                _setError = RunningSurfaceErrorLocaliser.LocaliseSetError(resp.ErrorCode);
                await ReloadAsync();
            }
        }
        catch (ApiException apiEx)
        {
            _setError = RunningSurfaceErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // ── PUT set-item (status / applicable / defect) ──────────────────

    // Tap NG → arm cục bộ (hiện dropdown), CHƯA PUT — server bắt buộc defect khi NG.
    // Nếu item đã persist Ng (có defect rồi) thì dropdown vẫn hiện để đổi defect.
    private void OnArmNg(SettingCheckItemView it)
    {
        if (_busy) return;
        _armNg.Add(it.ItemKey);
    }

    // Tap OK → bỏ arm + PUT Ok ngay (Ok không cần defect).
    private Task OnSetOkAsync(SettingCheckItemView it)
    {
        _armNg.Remove(it.ItemKey);
        return PutItemAsync(it.ItemKey, new SetSettingItemRequest
        {
            Status = "Ok",
            Applicable = it.Applicable,
            DefectCode = null,
            NgNote = null,
        });
    }

    private Task OnSetApplicableAsync(SettingCheckItemView it, bool applicable)
    {
        // The PUT contract requires a valid Status ("Ok"|"Ng"). When toggling
        // applicability we resend the item's current judgment if it already has
        // one; a still-Pending item is recorded as Ok (the applicable flag is
        // the point of this write, and server skips result validation for N/A).
        var req = new SetSettingItemRequest
        {
            Status = it.Status is "Ok" or "Ng" ? it.Status : "Ok",
            Applicable = applicable,
            DefectCode = applicable && it.Status == "Ng" ? it.DefectCode : null,
            NgNote = applicable && it.Status == "Ng" ? it.NgNote : null,
        };
        return PutItemAsync(it.ItemKey, req);
    }

    private Task OnDefectChangedAsync(SettingCheckItemView it, string defectCode)
    {
        if (defectCode == AddNewValue)
        {
            OpenAddDefect(it);
            return Task.CompletedTask;
        }
        if (string.IsNullOrEmpty(defectCode)) return Task.CompletedTask; // "— chọn defect —"
        // Đã chọn defect → giờ mới PUT Ng (persist). Bỏ arm cục bộ.
        _armNg.Remove(it.ItemKey);
        var req = new SetSettingItemRequest
        {
            Status = "Ng",
            Applicable = it.Applicable,
            DefectCode = defectCode,
            NgNote = string.IsNullOrWhiteSpace(it.NgNote) ? T("setting.ng.note.default") : it.NgNote,
        };
        return PutItemAsync(it.ItemKey, req);
    }

    private async Task PutItemAsync(string itemKey, SetSettingItemRequest req)
    {
        if (_checks is null || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var resp = await Api.PutSettingItemAsync(WorkOrderId, _checks.ETag, itemKey, req);
            await HandleSetResponseAsync(resp);
        }
        catch (ApiException apiEx)
        {
            _setError = LocaliseApi(apiEx);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // ── F3 — add-new defect ──────────────────────────────────────────

    private void OpenAddDefect(SettingCheckItemView it)
    {
        if (!_canAddNew) return;
        _addDefectFor = it.ItemKey;
        _newDefectCode = "";
        _newDefectVi = "";
        _newDefectEn = "";
    }

    private void CloseAddDefect()
    {
        _addDefectFor = null;
        _newDefectCode = "";
        _newDefectVi = "";
        _newDefectEn = "";
    }

    private bool CanSaveDefect =>
        !string.IsNullOrWhiteSpace(_newDefectCode)
        && !string.IsNullOrWhiteSpace(_newDefectVi)
        && !string.IsNullOrWhiteSpace(_newDefectEn);

    private async Task OnSaveDefectAsync(SettingCheckItemView it)
    {
        if (!CanSaveDefect || _checks is null || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var resp = await Api.PostSettingDefectAsync(WorkOrderId, _checks.ETag, new AddSettingDefectRequest
            {
                ItemId = it.ItemKey,
                DefectCode = _newDefectCode.Trim(),
                LabelVi = _newDefectVi.Trim(),
                LabelEn = _newDefectEn.Trim(),
            });
            if (resp.Ok)
            {
                CloseAddDefect();
                await ReloadAsync();
            }
            else if (!string.IsNullOrEmpty(resp.ErrorCode))
            {
                _setError = LocaliseSet(resp.ErrorCode);
                await ReloadAsync();
            }
        }
        catch (ApiException apiEx)
        {
            _setError = LocaliseApi(apiEx);
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // ── F4 — add-row ─────────────────────────────────────────────────

    private void OpenAddRow()
    {
        _addRowForTab = _activeTab;
        _newItemLabel = "";
        _newItemStandard = "";
    }

    private void CloseAddRow()
    {
        _addRowForTab = null;
        _newItemLabel = "";
        _newItemStandard = "";
    }

    private bool CanSaveItem => !string.IsNullOrWhiteSpace(_newItemLabel);

    private async Task OnSaveItemAsync()
    {
        if (!CanSaveItem || _checks is null || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var resp = await Api.PostSettingItemAsync(WorkOrderId, _checks.ETag, new AddSettingItemRequest
            {
                ProcessKind = _activeTab == SettingTab.Print ? "Print" : "Cut",
                Label = _newItemLabel.Trim(),
                Standard = string.IsNullOrWhiteSpace(_newItemStandard) ? null : _newItemStandard.Trim(),
            });
            if (resp.Ok)
            {
                CloseAddRow();
                await ReloadAsync();
            }
            else if (!string.IsNullOrEmpty(resp.ErrorCode))
            {
                _setError = LocaliseSet(resp.ErrorCode);
                await ReloadAsync();
            }
        }
        catch (ApiException apiEx)
        {
            _setError = LocaliseApi(apiEx);
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Applicable-all ───────────────────────────────────────────────

    private async Task SetApplicableAll(IReadOnlyList<SettingCheckItemView> items, bool value)
    {
        foreach (var it in items.ToList())
        {
            if (it.Applicable == value) continue;
            await OnSetApplicableAsync(it, value);
        }
    }

    // ── setting/done ─────────────────────────────────────────────────

    private async Task OnSettingDoneAsync()
    {
        if (_view is null || !DoneEnabled || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var resp = await Api.PostSettingDoneAsync(WorkOrderId, _view.ETag);
            if (resp.Ok)
            {
                await ReloadAsync();
                await OnPhaseChanged.InvokeAsync();
            }
            else if (!string.IsNullOrEmpty(resp.ErrorCode))
            {
                _setError = LocaliseSet(resp.ErrorCode);
                await ReloadAsync();
            }
            else
            {
                _setError = "Server returned Ok=false without an error code — report to IT.";
            }
        }
        catch (ApiException apiEx)
        {
            _setError = LocaliseApi(apiEx);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Shared response handler (optimistic-revert on 409) ───────────

    private async Task HandleSetResponseAsync(SettingChecksSetResponse resp)
    {
        if (resp.Ok)
        {
            await ReloadAsync();
            return;
        }
        if (!string.IsNullOrEmpty(resp.ErrorCode))
        {
            _setError = LocaliseSet(resp.ErrorCode);
            await ReloadAsync();
            return;
        }
        _setError = "Server returned Ok=false without an error code — report to IT.";
    }

    // ── Localisers (setting.* first, then shared running-surface bank) ─

    private string LocaliseSet(string code) => code switch
    {
        "setting.incomplete" => T("setting.error.incomplete"),
        _                    => RunningSurfaceErrorLocaliser.LocaliseSetError(code),
    };

    private string LocaliseApi(ApiException apiEx) => apiEx.ApiError.Code switch
    {
        "setting.incomplete"        => T("setting.error.incomplete"),
        "setting.invalid_status"    => T("setting.error.invalid_status"),
        "setting.invalid_item"      => T("setting.error.invalid_item"),
        "setting.invalid_defect"    => T("setting.error.invalid_defect"),
        "setting.invalid_ng_note"   => T("setting.error.invalid_ng_note"),
        "setting.invalid_label"     => T("setting.error.invalid_label"),
        "setting.invalid_process_kind" => T("setting.error.invalid_process_kind"),
        "setting.defect_exists"     => T("setting.error.defect_exists"),
        "setting.no_product"        => T("setting.error.no_product"),
        _                           => RunningSurfaceErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError),
    };

    // ── Misc ─────────────────────────────────────────────────────────

    private void ResetAddForms()
    {
        CloseAddDefect();
        CloseAddRow();
    }

    private void EnsureTicker()
    {
        _ticker?.Dispose();
        _ticker = new Timer(1000) { AutoReset = true, Enabled = true };
        _ticker.Elapsed += async (_, __) => await InvokeAsync(StateHasChanged);
    }

    private string FormatTimer()
    {
        var start = _view?.SettingStartAt;
        if (start is null) return "00:00:00";
        var elapsed = DateTime.UtcNow - start.Value;
        if (elapsed.TotalSeconds < 0) elapsed = TimeSpan.Zero;
        return $"{(int)elapsed.TotalHours:D2}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
    }

    private void DismissSetError() => _setError = null;

    public override void Dispose()
    {
        _ticker?.Dispose();
        _ticker = null;
        base.Dispose();
    }
}
