@*
    P10.5c-1 — Spec list row context menu. Items split by where the
    mutation lives:
      · Open / Get info → navigate to detail (handled in page)
      · Edit / Copy / Revise / Mark Superseded → fire OnRequestEditClass;
        page navigates to detail with the action queued so the operator
        lands in the detail page with the right modal already open.
      · Trash / Restore → fire OnTrash/OnRestore directly so the page
        owns a SpecConfirmActionModal inline (no detail nav needed).

    Trash is exposed only in active/all views; Restore only in trash view.
*@

@if (Open)
{
    <div class="spec-ctx-scrim" @onclick="OnClose" @onclick:stopPropagation="true"></div>
    <div class="spec-ctx-menu"
         style="@($"left:{Anchor.X}px; top:{Anchor.Y}px;")"
         role="menu" @onclick:stopPropagation="true">
        <div class="spec-ctx-section">@TargetSpecCode</div>

        <button type="button" class="spec-ctx-item" @onclick="OnOpenAsync">
            <span class="spec-ctx-ico">↗</span>
            <span>Open details</span>
        </button>
        <button type="button" class="spec-ctx-item" @onclick="OnInfoAsync">
            <span class="spec-ctx-ico">ⓘ</span>
            <span>View info</span>
        </button>

        <div class="spec-ctx-divider"></div>

        <button type="button" class="spec-ctx-item"
                @onclick="() => RequestEditClassAsync(SpecMutationAction.Edit)">
            <span class="spec-ctx-ico">📝</span>
            <span>Edit (Draft)</span>
        </button>
        <button type="button" class="spec-ctx-item"
                @onclick="() => RequestEditClassAsync(SpecMutationAction.Copy)">
            <span class="spec-ctx-ico">⎘</span>
            <span>Copy</span>
        </button>
        @* P10.10 — "Create new version (Revise)" removed: the new-version flow
           now lives inside the Copy chooser ("Update ver"). *@
        <button type="button" class="spec-ctx-item"
                @onclick="() => RequestEditClassAsync(SpecMutationAction.Supersede)">
            <span class="spec-ctx-ico">⊘</span>
            <span>Mark Superseded</span>
        </button>

        <div class="spec-ctx-divider"></div>

        @if (IsTrashView)
        {
            <button type="button" class="spec-ctx-item" @onclick="OnRestoreAsync">
                <span class="spec-ctx-ico">↺</span>
                <span>Restore from Trash</span>
            </button>
        }
        else
        {
            <button type="button" class="spec-ctx-item spec-ctx-item-danger" @onclick="OnTrashAsync">
                <span class="spec-ctx-ico">🗑</span>
                <span>Move to Trash</span>
            </button>
        }
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public (double X, double Y) Anchor { get; set; }
    [Parameter, EditorRequired] public long TargetSpecId { get; set; }
    [Parameter] public string TargetSpecCode { get; set; } = "";
    /// <summary>Set true when the list is rendering the trash view so the
    /// context menu surfaces Restore instead of Trash.</summary>
    [Parameter] public bool IsTrashView { get; set; }

    [Parameter] public EventCallback<long> OnOpen { get; set; }
    [Parameter] public EventCallback<long> OnInfo { get; set; }
    [Parameter] public EventCallback<(long Id, SpecMutationAction Action)> OnRequestEditClass { get; set; }
    [Parameter] public EventCallback<long> OnTrash { get; set; }
    [Parameter] public EventCallback<long> OnRestore { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task OnOpenAsync()
    {
        if (OnOpen.HasDelegate) await OnOpen.InvokeAsync(TargetSpecId);
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task OnInfoAsync()
    {
        if (OnInfo.HasDelegate) await OnInfo.InvokeAsync(TargetSpecId);
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task RequestEditClassAsync(SpecMutationAction action)
    {
        if (OnRequestEditClass.HasDelegate) await OnRequestEditClass.InvokeAsync((TargetSpecId, action));
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task OnTrashAsync()
    {
        if (OnTrash.HasDelegate) await OnTrash.InvokeAsync(TargetSpecId);
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task OnRestoreAsync()
    {
        if (OnRestore.HasDelegate) await OnRestore.InvokeAsync(TargetSpecId);
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }
}
