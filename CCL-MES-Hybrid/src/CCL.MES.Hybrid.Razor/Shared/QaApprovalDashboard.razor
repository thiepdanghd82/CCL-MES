@*
    P10.7d-3 — QA Approval operator dashboard.

    Hosted inside WorkOrders.razor when the scanned WO has
    MesPhase=QA_PENDING — operator IPQC nộp Special Accept và WO
    đang chờ một QC khác duyệt.

    Render:
      - Head: WO + phase chip + người nộp IPQC (IpqcSubmittedBy + At).
      - Special Accept context card: 4 slot status (read-only) +
        SpecialAcceptReason mà người IPQC đã nhập.
      - Q3 dual-sig client guard: nếu Session.CurrentUserInfo.Username
        == _view.IpqcSubmittedBy thì:
          * banner cảnh báo bằng VN (IpqcReviewErrorLocaliser.Q3SameUserBanner)
          * nút Approve disabled + tooltip "Cần người khác duyệt"
          * nút Reject vẫn enabled (Reject == StopLine = đẩy về PREPRESS,
            cùng người IPQC vẫn có thể tự huỷ phán quyết của mình)
        Server-side Q3 guard (qa.same_user_as_ipqc_submitter, 422 +
        WO_QA_APPROVE_DENIED audit) là double-check phòng curl bypass.
      - QA Reason input: optional cho Approve, required cho Reject.
      - 2 buttons: Approve (success) + Reject (danger).

    Concurrency / error handling matches IpqcDashboard.

    Rule 4: plain <input> + <button>, NO <InputText>.
    Rule 7.3: every wire-path probe has TestServer mirror
    (IpqcReviewControllerTests.PostQaApprove_* fixtures).
*@

@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.Auth
@using CCL.MES.Hybrid.Client.IpqcReview
@using CCL.MES.Shared.Envelopes
@using CCL.MES.Shared.IpqcReview
@inject ICclApiClient Api
@inject IAuthSession Session

<div class="rs-dashboard qa-dashboard" data-testid="qa-dashboard">
    @if (_view is null && _initialError is null)
    {
        <div class="rs-loading" data-testid="qa-loading">Loading QA status…</div>
    }
    else if (_initialError is not null)
    {
        <div class="wo-card-error" data-testid="qa-initial-error">
            <strong>Could not load QA status:</strong> @_initialError
        </div>
    }
    else if (_invalidPhase)
    {
        <div class="wo-card-error" data-testid="qa-invalid-phase">
            <strong>WO is not in the QA_PENDING phase</strong> —
            Current: <code>@(_view?.MesPhase ?? "?")</code>.
            Go back to the Work Orders tab to select another WO.
        </div>
    }
    else if (_view is not null)
    {
        <div class="rs-head">
            <div class="rs-head-wo">
                <span class="rs-head-label">WO</span>
                <span class="rs-head-wo-no">@_view.WoNo</span>
                <span class="rs-head-phase rs-phase-paused">@_view.MesPhase</span>
            </div>
            <div class="qa-submitter-pill" data-testid="qa-submitter">
                <span class="qa-submitter-label">IPQC submitted by</span>
                <span class="qa-submitter-value scan-mono">@(_view.IpqcSubmittedBy ?? "?")</span>
                @if (_view.IpqcSubmittedAt is { } at)
                {
                    <span class="qa-submitter-time">@at.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                }
            </div>
        </div>

        @if (_setError is not null)
        {
            <div class="wo-card-error" data-testid="qa-set-error">
                <strong>Could not save change:</strong> @_setError
                <button type="button" class="op-btn op-btn-secondary op-btn-sm"
                        @onclick="DismissSetError"
                        data-testid="qa-set-error-dismiss">Dismiss</button>
            </div>
        }

        @* ── Q3 dual-sig client guard banner ──────────────────────── *@
        @if (IsSameAsSubmitter())
        {
            <div class="wo-card-error qa-q3-banner" data-testid="qa-q3-banner">
                <strong>⚠ Dual-sig policy:</strong>
                @CCL.MES.Hybrid.Client.IpqcReview.IpqcReviewErrorLocaliser.Q3SameUserBanner
            </div>
        }

        @* ── Context card: read-only IPQC summary ─────────────────── *@
        <div class="rs-card qa-context">
            <div class="rs-card-head">
                <div class="rs-card-title">IPQC summary (read-only)</div>
                <div class="ipqc-rollup-pill @(_view.AnyNg ? "ipqc-rollup-warn" : "ipqc-rollup-ok")"
                     data-testid="qa-rollup-pill">
                    @if (_view.AllOk)
                    {
                        <span>All OK</span>
                    }
                    else
                    {
                        <span>One or more slots NG</span>
                    }
                </div>
            </div>
            <div class="qa-slot-summary">
                <div class="qa-slot-row" data-testid="qa-slot-material">
                    <span class="qa-slot-name">Material</span>
                    <span class="ipqc-status-pill @StatusPillCss(_view.MaterialStatus)">@StatusDisplay(_view.MaterialStatus)</span>
                    @if (_view.MaterialStatus == "Ng" && _view.MaterialNgReasonCode is { } r1)
                    {
                        <span class="qa-slot-reason">@r1 — @(_view.MaterialNgNote ?? "")</span>
                    }
                </div>
                <div class="qa-slot-row" data-testid="qa-slot-print-a">
                    <span class="qa-slot-name">Print A (Color/ΔE)</span>
                    <span class="ipqc-status-pill @StatusPillCss(_view.PrintAStatus)">@StatusDisplay(_view.PrintAStatus)</span>
                    @if (_view.PrintAStatus == "Ng" && _view.PrintANgReasonCode is { } r2)
                    {
                        <span class="qa-slot-reason">@r2 — @(_view.PrintANgNote ?? "")</span>
                    }
                </div>
                <div class="qa-slot-row" data-testid="qa-slot-print-b">
                    <span class="qa-slot-name">Print B (Registration)</span>
                    <span class="ipqc-status-pill @StatusPillCss(_view.PrintBStatus)">@StatusDisplay(_view.PrintBStatus)</span>
                    @if (_view.PrintBStatus == "Ng" && _view.PrintBNgReasonCode is { } r3)
                    {
                        <span class="qa-slot-reason">@r3 — @(_view.PrintBNgNote ?? "")</span>
                    }
                </div>
                <div class="qa-slot-row" data-testid="qa-slot-print-c">
                    <span class="qa-slot-name">Print C (Content)</span>
                    <span class="ipqc-status-pill @StatusPillCss(_view.PrintCStatus)">@StatusDisplay(_view.PrintCStatus)</span>
                    @if (_view.PrintCStatus == "Ng" && _view.PrintCNgReasonCode is { } r4)
                    {
                        <span class="qa-slot-reason">@r4 — @(_view.PrintCNgNote ?? "")</span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_view.SpecialAcceptReason))
            {
                <div class="qa-special-reason" data-testid="qa-special-reason">
                    <div class="qa-special-reason-label">Special Accept reason (entered by IPQC)</div>
                    <div class="qa-special-reason-body">@_view.SpecialAcceptReason</div>
                </div>
            }
        </div>

        @* ── QA action card ──────────────────────────────────────── *@
        <div class="rs-card qa-action">
            <div class="rs-card-head">
                <div class="rs-card-title">QA judgment</div>
            </div>

            <div class="qa-reason-field">
                <label class="rs-modal-label" for="qa-reason">
                    QA note (optional for Approve · REQUIRED for Reject; 1-500 characters)
                </label>
                <input id="qa-reason"
                       type="text"
                       class="ipqc-input"
                       maxlength="500"
                       value="@_qaReason"
                       @oninput="@(e => _qaReason = e.Value?.ToString() ?? "")"
                       data-testid="qa-reason-input" />
                <div class="ipqc-char-count">@_qaReason.Length/500</div>
            </div>

            <div class="qa-action-buttons rs-action-bar-multi" data-testid="qa-action-buttons">
                <button type="button"
                        class="op-btn op-btn-success ipqc-judgment-btn"
                        disabled="@(!CanApprove() || _busy)"
                        title="@(IsSameAsSubmitter() ? "The QA approver must differ from the IPQC submitter" : "")"
                        @onclick="@(() => OnQaDecisionAsync(QaApprove))"
                        data-testid="qa-approve-btn">
                    Approve
                </button>
                <button type="button"
                        class="op-btn op-btn-danger ipqc-judgment-btn"
                        disabled="@(!CanReject() || _busy)"
                        @onclick="@(() => OnQaDecisionAsync(QaReject))"
                        data-testid="qa-reject-btn">
                    Reject
                </button>
            </div>

            @if (IsSameAsSubmitter())
            {
                <div class="rs-action-hint qa-hint-q3" data-testid="qa-hint-q3">
                    The Approve button is locked because you are the IPQC submitter.
                    Log out and log in with a different QC account to approve.
                </div>
            }
            else if (string.IsNullOrEmpty(_view.IpqcSubmittedBy))
            {
                <div class="rs-action-hint" data-testid="qa-hint-no-submitter">
                    No IPQC submitter information yet — reload the page.
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public long WorkOrderId { get; set; }

    /// <summary>P10.7d-3 BUG-FIX (Henry RCA on PR #119) — invoked
    /// after a successful Approve/Reject so the parent (WorkOrders.razor)
    /// re-fetches the summary + the dispatch picks the new phase
    /// (IPQC_APPROVED on Approve; PREPRESS on Reject). Operator never
    /// sees a stale QA dashboard with an "invalid_phase" dead-end.
    /// See Lesson L21.</summary>
    [Parameter] public EventCallback OnPhaseChanged { get; set; }

    private const string QaApprove = "Approve";
    private const string QaReject = "Reject";

    private IpqcView? _view;
    private string? _initialError;
    private string? _setError;
    private bool _busy;
    private bool _invalidPhase;
    private long _lastLoadedWoId;
    private string _qaReason = "";

    protected override async Task OnParametersSetAsync()
    {
        if (WorkOrderId != _lastLoadedWoId)
        {
            _lastLoadedWoId = WorkOrderId;
            _view = null;
            _initialError = null;
            _setError = null;
            _invalidPhase = false;
            _qaReason = "";
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _view = await Api.GetIpqcViewAsync(WorkOrderId);
            _invalidPhase = _view.MesPhase != "QA_PENDING";
        }
        catch (ApiException apiEx)
        {
            _initialError = IpqcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (HttpRequestException ex)
        {
            _initialError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _initialError = $"Error loading QA status: {ex.GetType().Name}: {ex.Message}";
        }
    }

    // ── Q3 client guard ─────────────────────────────────────────────

    /// <summary>Test surface: same user → Approve disabled +
    /// Q3SameUserBanner rendered. Case-insensitive Ordinal so a
    /// MariaDB-style mixed-case username won't slip through (server
    /// uses StringComparison.OrdinalIgnoreCase per the audit report
    /// in IpqcReviewControllerTests.Same_user_QaApprove_returns_422).</summary>
    private bool IsSameAsSubmitter()
    {
        var currentUsername = Session.CurrentUserInfo?.Username;
        var submitterUsername = _view?.IpqcSubmittedBy;
        if (string.IsNullOrEmpty(currentUsername) || string.IsNullOrEmpty(submitterUsername))
            return false;
        return string.Equals(currentUsername, submitterUsername, StringComparison.OrdinalIgnoreCase);
    }

    private bool CanApprove() =>
        _view is not null
        && !IsSameAsSubmitter()
        && (_qaReason.Length == 0 || _qaReason.Length <= 500); // optional

    private bool CanReject() =>
        _view is not null
        && !string.IsNullOrWhiteSpace(_qaReason)
        && _qaReason.Length <= 500;

    // ── QA decision call ────────────────────────────────────────────

    private async Task OnQaDecisionAsync(string outcome)
    {
        if (_view is null || _busy) return;
        // Belt-and-braces: if the operator somehow taps Approve while same-as-submitter
        // (shouldn't happen — button is disabled) we still refuse client-side so the
        // 422 trip never happens. The server is still source of truth on a curl bypass.
        if (outcome == QaApprove && IsSameAsSubmitter())
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseSetError("qa.same_user_as_ipqc_submitter");
            return;
        }
        if (outcome == QaReject && string.IsNullOrWhiteSpace(_qaReason))
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseSetError("qa.invalid_qa_reason");
            return;
        }

        _busy = true;
        _setError = null;
        try
        {
            var req = new QaApproveRequest
            {
                Outcome = outcome,
                QaReason = string.IsNullOrWhiteSpace(_qaReason) ? null : _qaReason,
            };
            var resp = await Api.PostQaApproveAsync(WorkOrderId, _view.ETag, req);
            await HandleSetResponseAsync(resp);
            // Approve → IPQC_APPROVED (RunningDashboard takes over).
            // Reject  → PREPRESS (PrepressDashboard takes over).
            // P10.7d-3 BUG-FIX — bubble the phase change up so the parent
            // re-fetches the summary + re-dispatches without the operator
            // tapping "Tìm" again. See Lesson L21.
            if (resp.Ok)
            {
                await OnPhaseChanged.InvokeAsync();
            }
        }
        catch (ApiException apiEx)
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HandleSetResponseAsync(IpqcSetResponse resp)
    {
        if (resp.Ok)
        {
            await ReloadAsync();
            return;
        }
        if (!string.IsNullOrEmpty(resp.ErrorCode))
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseSetError(resp.ErrorCode);
            await ReloadAsync();
            return;
        }
        _setError = "Server returned Ok=false without an error code — report to IT.";
    }

    // ── Display helpers (shared shape with IpqcDashboard) ───────────

    private static string StatusDisplay(string status) => status switch
    {
        "Ok" => "✓ OK",
        "Ng" => "✗ NG",
        _    => "— Pending",
    };

    private static string StatusPillCss(string status) => status switch
    {
        "Ok" => "ipqc-status-ok",
        "Ng" => "ipqc-status-ng",
        _    => "ipqc-status-pending",
    };

    private void DismissSetError() => _setError = null;
}
