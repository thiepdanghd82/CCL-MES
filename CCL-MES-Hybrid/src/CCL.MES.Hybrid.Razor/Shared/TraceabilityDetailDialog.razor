@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Quality
@using CCL.MES.Hybrid.Client.Windows
@inject ICclApiClient Api

@*
    Read-only frozen-trace detail. The window CHROME (drag / 8-way resize /
    traffic-lights / keyboard / rect persistence) is the shared
    <FloatingWindow> component — this dialog only supplies the CONTENT: 4
    sub-tabs [Product|IPQC|FQC|OQC]. Product uses a fixed 2-section layout
    (Materials + Tools); IPQC/FQC/OQC use ONE generic renderer over header
    (key-value) + items. A phase with no frozen snapshot shows an empty-state.

    P2 showcard-migration — this component has two hosting modes:
      • Chrome=true (default): self-wraps <FloatingWindow> (legacy standalone
        showcard). Kept for any caller still hand-hosting a card.
      • Chrome=false: renders ONLY the body (tab strip + 4-tab content), NO
        <FloatingWindow>. The WindowManager host (MainLayout .window-layer)
        already wraps a DynamicComponent in FloatingWindow, so nesting one here
        would double-wrap. In WM mode the tab strip moves INTO the body (there
        is no chrome TabBar slot to fill).
*@

@if (Chrome)
{
    <FloatingWindow Title="@WoNo" Subtitle="@(_detail?.ProductName ?? "")"
                    AriaLabel="@T("trace.aria.window", WoNo)"
                    WindowId="@WindowId" Rect="Rect" CascadeIndex="CascadeIndex"
                    OnClose="OnClose" OnRectChanged="OnRectChanged">
        <TabBar>
            @TabStrip
        </TabBar>
        <ChildContent>
            @Body
        </ChildContent>
    </FloatingWindow>
}
else
{
    @* WM-hosted: the FloatingWindow lives in the host; render the tab strip
       inline at the top of the body, then the body. *@
    @TabStrip
    <div class="trace-win-body-inner">
        @Body
    </div>
}

@* ── Tab strip + body, shared by both hosting modes. Declared as instance
   RenderFragment members so they can be referenced from the render block above
   regardless of source order (they are class members, not locals). ─────────── *@
@code {
    private RenderFragment TabStrip => @<div class="trace-tabs" role="tablist">
        @foreach (var t in _tabs)
        {
            <button type="button" role="tab"
                    class="trace-tab @(t.Phase == _active ? "trace-tab-active" : "")"
                    @onclick="() => _active = t.Phase">
                @TabDisplay(t.Phase, t.Label)
                @if (Phase(t.Phase) is not null) { <span class="trace-tab-dot" title="@T("trace.frozen.tooltip")">●</span> }
            </button>
        }
    </div>;

    private RenderFragment Body => @<text>
        @if (_loading)
        {
            <p class="grid-status">@T("trace.loading")</p>
        }
        else if (_error is not null)
        {
            <div class="grid-error" role="alert">@_error</div>
        }
        else
        {
            var phase = Phase(_active);
            @if (phase is null)
            {
                <div class="trace-empty">
                    <div class="trace-empty-icon">◷</div>
                    <div>@T("trace.empty.notfrozen", TabDisplay(_active, TabLabel(_active)))</div>
                </div>
            }
            else
            {
                <div class="trace-meta">
                    <span class="trace-sub">@T("trace.meta.frozen", phase.Version, phase.FrozenAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"), phase.FrozenBy)</span>
                    @if (!string.IsNullOrEmpty(phase.Payload.Variant)) { <span class="trace-sub">@T("trace.meta.variant", phase.Payload.Variant)</span> }
                </div>

                @* header — generic key-value list *@
                <div class="trace-kv-grid">
                    @foreach (var kv in phase.Payload.Header)
                    {
                        <div class="trace-kv"><span>@HeaderLabel(kv.Label)</span><b>@(string.IsNullOrEmpty(kv.Value) ? "—" : StatusText(kv.Value))</b></div>
                    }
                </div>

                @* items — Product uses a FIXED 2-section layout; IPQC/FQC/OQC keep the generic renderer. *@
                @if (phase.Payload.Items.Count == 0)
                {
                    <p class="trace-sub">@T("trace.items.none")</p>
                }
                else if (_active == TracePhase.Product)
                {
                    <h3 class="trace-prod-section">@T("trace.prod.materials.section")</h3>
                    <div class="grid-scroll trace-items-scroll">
                        <table class="grid grid-sticky trace-items trace-prod">
                            <thead>
                                <tr>
                                    <th class="grid-h trace-prod-no">@T("trace.col.no")</th>
                                    <th class="grid-h">@T("trace.col.partno")</th>
                                    <th class="grid-h">@T("trace.col.description")</th>
                                    <th class="grid-h trace-prod-num">@T("trace.col.qpa")</th>
                                    <th class="grid-h trace-prod-num">@T("trace.col.qtyrequired")</th>
                                    <th class="grid-h">@T("trace.col.uom")</th>
                                    <th class="grid-h">@T("trace.col.partscan")</th>
                                    <th class="grid-h">@T("trace.col.partdescription")</th>
                                    <th class="grid-h">@T("trace.col.lot")</th>
                                    <th class="grid-h">@T("trace.col.status")</th>
                                    <th class="grid-h">@T("trace.col.ng.reasonnote")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var _mno = 0; }
                                @foreach (var it in phase.Payload.Items)
                                {
                                    var st = ProductStatus(it);
                                    _mno++;
                                    <tr>
                                        @* No. from the loop index → correct even for OLD frozen
                                           snapshots that predate the "no" payload key. *@
                                        <td class="trace-prod-no">@_mno</td>
                                        <td class="trace-mono">@E(it, "partNo")</td>
                                        <td>@E(it, "description")</td>
                                        <td class="trace-prod-num">@E(it, "qpaM2")</td>
                                        <td class="trace-prod-num">@E(it, "qtyRequired")</td>
                                        <td>@E(it, "uom")</td>
                                        <td class="trace-mono">@E(it, "partScan")</td>
                                        <td>@E(it, "partDescription")</td>
                                        <td class="trace-mono">@E(it, "lotNo")</td>
                                        <td><span class="trace-chip @st.Tone">@st.Label</span></td>
                                        <td>@NgCombined(it)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <h3 class="trace-prod-section">@T("trace.prod.tools.section")</h3>
                    @if (phase.Payload.Tools.Count == 0)
                    {
                        <p class="trace-sub">@T("trace.tools.none")</p>
                    }
                    else
                    {
                        @* Variable-length: 2 tools today (Plate/Cutter); N tools when
                           an upstream multi-tool source (e.g. silkscreen) is captured —
                           renderer + freeze need NO change, just more list elements. *@
                        <div class="grid-scroll trace-items-scroll">
                            <table class="grid grid-sticky trace-items trace-tools">
                                <thead>
                                    <tr>
                                        <th class="grid-h trace-prod-no">@T("trace.col.no")</th>
                                        <th class="grid-h">@T("trace.col.tool")</th>
                                        <th class="grid-h">@T("trace.col.numbercode")</th>
                                        <th class="grid-h">@T("trace.col.status")</th>
                                        <th class="grid-h">@T("trace.col.checkedby")</th>
                                        <th class="grid-h">@T("trace.col.checkedat")</th>
                                        <th class="grid-h">@T("trace.col.ngreason")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var _tno = 0; }
                                    @foreach (var t in phase.Payload.Tools)
                                    {
                                        var ts = ToolStatus(t.Status);
                                        _tno++;
                                        <tr>
                                            <td class="trace-prod-no">@_tno</td>
                                            <td>@(string.IsNullOrEmpty(t.Type) ? "—" : t.Type)@(string.IsNullOrEmpty(t.Name) ? "" : $" · {t.Name}")</td>
                                            <td class="trace-mono">@Dash(t.NumberOrCode)</td>
                                            <td><span class="trace-chip @ts.Tone">@ts.Label</span></td>
                                            <td>@Dash(t.CheckedBy)</td>
                                            <td class="trace-mono">@Dash(t.CheckedAt)</td>
                                            <td>@Dash(t.NgReason)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    var extraKeys = phase.Payload.Items
                        .SelectMany(i => i.Extra?.Keys ?? Enumerable.Empty<string>())
                        .Distinct().ToList();
                    <div class="grid-scroll trace-items-scroll">
                        <table class="grid grid-sticky trace-items">
                            <thead>
                                <tr>
                                    <th class="grid-h">@T("trace.col.item")</th>
                                    <th class="grid-h">@T("trace.col.status")</th>
                                    <th class="grid-h">@T("trace.col.ngreason")</th>
                                    <th class="grid-h">@T("trace.col.ngnote")</th>
                                    @foreach (var k in extraKeys) { <th class="grid-h">@k</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var it in phase.Payload.Items)
                                {
                                    <tr>
                                        <td>@ItemLabel(it.Label)</td>
                                        <td><span class="trace-chip @StatusTone(it.Status)">@(string.IsNullOrEmpty(it.Status) ? "—" : StatusText(it.Status))</span></td>
                                        <td>@(it.NgReason ?? "—")</td>
                                        <td>@(it.NgNote ?? "—")</td>
                                        @foreach (var k in extraKeys)
                                        {
                                            <td class="trace-mono">@(it.Extra is not null && it.Extra.TryGetValue(k, out var v) ? (v ?? "—") : "—")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    </text>;
}

@code {
    [Parameter, EditorRequired] public string WoNo { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>P2 showcard-migration — when false the component renders only the
    /// body (tab strip + 4-tab content) so the WindowManager host can wrap it in
    /// its own <see cref="FloatingWindow"/> (no double-wrap). Default true keeps
    /// the legacy self-hosted-chrome behaviour for any standalone caller.</summary>
    [Parameter] public bool Chrome { get; set; } = true;

    /// <summary>Passed straight through to <see cref="FloatingWindow"/> (Chrome mode only).</summary>
    [Parameter] public string WindowId { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public WindowRect? Rect { get; set; }
    [Parameter] public int CascadeIndex { get; set; }
    [Parameter] public EventCallback<WindowRect> OnRectChanged { get; set; }

    private TraceabilityDetailDto? _detail;
    private bool _loading = true;
    private string? _error;
    private string _active = TracePhase.Product;
    private string? _loadedWoNo;

    private readonly (string Phase, string Label)[] _tabs =
    {
        (TracePhase.Product, "Product data"),
        (TracePhase.Ipqc, "IPQC"),
        (TracePhase.Fqc, "FQC"),
        (TracePhase.Oqc, "OQC"),
    };

    protected override async Task OnParametersSetAsync()
    {
        // Only (re)load when the target WO actually changes — a parent re-render
        // (e.g. a live re-pull) must not reload/flicker an open card.
        if (_loadedWoNo == WoNo) return;
        _loadedWoNo = WoNo;
        _loading = true; _error = null; _detail = null;
        try { _detail = await Api.GetTraceabilityDetailAsync(WoNo); }
        catch (ApiException apiEx) { _error = apiEx.ApiError.MessageEn; }
        catch (Exception ex) { _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _loading = false; }
    }

    private TracePhaseDto? Phase(string phase) => _detail is null ? null : phase switch
    {
        TracePhase.Product => _detail.Product,
        TracePhase.Ipqc => _detail.Ipqc,
        TracePhase.Fqc => _detail.Fqc,
        TracePhase.Oqc => _detail.Oqc,
        _ => null,
    };

    private static string TabLabel(string phase) => phase switch
    {
        TracePhase.Product => "Product", TracePhase.Ipqc => "IPQC",
        TracePhase.Fqc => "FQC", TracePhase.Oqc => "OQC", _ => phase,
    };

    // Display label for a tab: the Product tab is a translated phrase; the
    // QC phases (IPQC/FQC/OQC) are raw technical tokens kept as-is.
    private string TabDisplay(string phase, string fallback) => phase == TracePhase.Product
        ? T("trace.tab.product")
        : fallback;

    // Frozen HEADER labels are baked English (TraceFreezeService). Map the
    // known vocabulary → translated at render; anything unknown renders raw.
    private string HeaderLabel(string? raw) => raw switch
    {
        "Product code" => T("trace.hdr.productcode"),
        "Part description" => T("trace.hdr.partdescription"),
        "Customer" => T("trace.hdr.customer"),
        "Target qty" => T("trace.hdr.targetqty"),
        "MES status" => T("trace.hdr.messtatus"),
        "Plate check" => T("trace.hdr.platecheck"),
        "Cutter check" => T("trace.hdr.cuttercheck"),
        "Judgment" => T("trace.hdr.judgment"),
        "Judgment reason" => T("trace.hdr.judgmentreason"),
        "Special-accept reason" => T("trace.hdr.specialacceptreason"),
        "IPQC submitted by" => T("trace.hdr.ipqcsubmittedby"),
        "QA outcome" => T("trace.hdr.qaoutcome"),
        "QA reason" => T("trace.hdr.qareason"),
        "QA approved by" => T("trace.hdr.qaapprovedby"),
        "Inspected by" => T("trace.hdr.inspectedby"),
        "Reviewed by" => T("trace.hdr.reviewedby"),
        "Approved by" => T("trace.hdr.approvedby"),
        _ => raw ?? "",
    };

    // Localize the fixed IPQC slot item labels; Plan-C dynamic library labels
    // (and FQC/OQC item keys) fall through as captured.
    private string ItemLabel(string? raw) => raw switch
    {
        "Material" => T("trace.item.material"),
        "Print A (Colour)" => T("trace.item.printa"),
        "Print B (Registration)" => T("trace.item.printb"),
        "Print C (Content)" => T("trace.item.printc"),
        _ => raw ?? "",
    };

    // Localize a status VALUE (chip text / frozen header status). Only the
    // known enum tokens match — data values (product code, customer, phase
    // token like IPQC_APPROVED, "1000 pcs") fall through unchanged.
    private string StatusText(string? raw)
    {
        if (string.IsNullOrEmpty(raw)) return "—";
        return raw.ToLowerInvariant() switch
        {
            "ok" => T("trace.st.ok"),
            "ng" => T("trace.st.ng"),
            "pending" => T("trace.st.pending"),
            "pass" => T("trace.st.pass"),
            "reject" => T("trace.st.reject"),
            "gorun" => T("trace.st.gorun"),
            "stopline" => T("trace.st.stopline"),
            "specialaccept" => T("trace.st.specialaccept"),
            "approved" => T("trace.st.approved"),
            "rejected" => T("trace.st.rejected"),
            "none" => T("trace.st.none"),
            _ => raw,
        };
    }

    private static string StatusTone(string? status) => status switch
    {
        "Ok" or "Pass" or "GoRun" => "trace-chip-ok",
        "Ng" or "Reject" or "StopLine" => "trace-chip-ng",
        "SpecialAccept" => "trace-chip-warn",
        null or "" => "trace-chip-none",
        _ => "trace-chip-pending",
    };

    // ── Product-tab helpers (fixed layout) ───────────────────────────
    private static string E(TraceItem it, string key)
        => it.Extra is not null && it.Extra.TryGetValue(key, out var v) && !string.IsNullOrEmpty(v) ? v! : "—";

    private static string Dash(string? v) => string.IsNullOrEmpty(v) ? "—" : v!;

    private (string Label, string Tone) ToolStatus(string? status) => status switch
    {
        "Ng" => (T("trace.st.ng"), "trace-chip-ng"),
        "Ok" => (T("trace.st.ok"), "trace-chip-ok"),
        "Pending" or null or "" => (T("trace.st.pending"), "trace-chip-none"),
        _ => (status!, "trace-chip-pending"),
    };

    // A special-accept row is stored as Status=Ok WITH a retained NG reason
    // (the concession) — surface it distinctly from a clean OK.
    private (string Label, string Tone) ProductStatus(TraceItem it)
    {
        var ok = string.Equals(it.Status, "Ok", StringComparison.OrdinalIgnoreCase);
        var hasDeviation = !string.IsNullOrEmpty(it.NgReason);
        return it.Status switch
        {
            "Ng" => (T("trace.st.ng"), "trace-chip-ng"),
            _ when ok && hasDeviation => (T("trace.st.ok.specialaccept"), "trace-chip-warn"),
            _ when ok => (T("trace.st.ok"), "trace-chip-ok"),
            "Pending" or null or "" => (T("trace.st.pending"), "trace-chip-none"),
            _ => (it.Status!, "trace-chip-pending"),
        };
    }

    private static string NgCombined(TraceItem it)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(it.NgReason)) parts.Add(it.NgReason!);
        if (!string.IsNullOrEmpty(it.NgNote)) parts.Add(it.NgNote!);
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }
}
