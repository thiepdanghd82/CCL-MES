@*
    P10.7e-3 — FQC review operator dashboard. Single-sig Inspector.

    Hosted by WorkOrders.razor when the scanned WO has
    MesPhase=FQC_PENDING. Owns the WoQcView state + every API call
    that mutates it (PUT items + POST judgment + photo upload via
    QcPhotoStrip).

    Q3 data-driven: items come from the WoQcView returned by
    GET /qc/fqc. Profile snapshot is opaque JSON; we render the
    Items array (server-emitted in declared order). Each item gets
    OK + NG buttons + NG sub-form + photo strip.

    Render:
      - Head: WO + phase chip + counter "X/N đã xác nhận"
      - N item cards (data-driven from view.Items) — 3-state status
        pill (Pending/Ok/Ng), OK + NG buttons, NG sub-form (reason
        picker + 1-500 char note + photo strip)
      - Judgment row visible when IsReadyForJudgment:
          - Pass : enabled iff AllOk
          - Reject: enabled iff AnyNg (Reject reason required)
        Server validates both sides per L15 dual-side check.

    Concurrency / error handling matches IpqcDashboard exactly:
      - 200 → reload to capture audit-side fields
      - 409 wo.state_conflict → reload + banner (response carries
        fresh ETag — optimistic revert)
      - 422 qc.* / wo.invalid_phase → in-band ErrorCode mapped via
        WoQcReviewErrorLocaliser
      - L21: OnPhaseChanged invoked after successful judgment so
        parent re-fetches summary → dispatch picks the new phase
        (OQC_PENDING on Pass, PREPRESS on Reject) → next dashboard
        mounts automatically.

    Rule 4: plain <input> + plain <button> + plain <select>. NO
    <EditForm>/<InputText> — Lesson L2 trap.
    Rule 7.3: wire-mirror via WoQcReviewControllerTests.
*@

@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.WoQcReview
@using CCL.MES.Shared.Envelopes
@using CCL.MES.Shared.ReasonCodes
@using CCL.MES.Shared.WoQcReview
@using CCL.MES.Shared.Localization
@inject ICclApiClient Api

<div class="rs-dashboard fqc-dashboard" data-testid="fqc-dashboard">
    @if (_view is null && _initialError is null)
    {
        <div class="rs-loading" data-testid="fqc-loading">@T("fqc.loading")</div>
    }
    else if (_initialError is not null)
    {
        <div class="wo-card-error" data-testid="fqc-initial-error">
            <strong>@T("fqc.initial.error")</strong> @_initialError
        </div>
    }
    else if (_invalidPhase)
    {
        <div class="wo-card-error" data-testid="fqc-invalid-phase">
            <strong>@T("fqc.invalid.phase.title")</strong> —
            @T("fqc.invalid.phase.current"): <code>@(_view?.MesPhase ?? "?")</code>.
            @T("fqc.invalid.phase.hint")
        </div>
    }
    else if (_view is not null)
    {
        <div class="rs-head">
            <div class="rs-head-wo">
                <span class="rs-head-label">WO</span>
                <span class="rs-head-wo-no">@_view.WoNo</span>
                <StatusPill Phase="@_view.MesPhase" />
            </div>
            <div class="ipqc-counter-pill" data-testid="fqc-counter">
                <span class="ipqc-counter-label">@T("fqc.counter.label")</span>
                <span class="ipqc-counter-value scan-mono @(_view.Items.Count > 0 && ConfirmedCount >= _view.Items.Count ? "is-complete" : null)">@*
      *@<span class="ipqc-counter-done">@ConfirmedCount</span>/@(_view.Items.Count)</span>
            </div>
        </div>

        @if (_setError is not null)
        {
            <div class="wo-card-error" data-testid="fqc-set-error">
                <strong>@T("fqc.set.error")</strong> @_setError
                <button type="button" class="op-btn op-btn-secondary op-btn-sm"
                        @onclick="DismissSetError"
                        data-testid="fqc-set-error-dismiss">@T("fqc.dismiss")</button>
            </div>
        }

        @if (_view.Items.Count == 0)
        {
            <div class="wo-card-error" data-testid="fqc-empty-profile">
                <strong>@T("fqc.empty.title")</strong>
                @T("fqc.empty.body", "MES_FQC_PROFILE")
            </div>
        }

        @* ── TAB NHÓM + BẢNG HẠNG MỤC ─────────────────────────────────
           Nguyên tắc Henry 2026-08-28: IPQC · FQC · OQC dùng CÙNG bộ hạng mục
           và CÙNG cấu trúc; khác biệt duy nhất là FQC/OQC không kiểm lại bảng
           vật tư.

           MỘT tầng tab, không hai. IPQC chẻ thêm chip công đoạn (PRINT/CẮT) vì
           nó kiểm TẠI MÁY. Lô ở đây đã rời chuyền và được kiểm một lần, nên
           bắt người kiểm cuối bấm qua lại giữa các công đoạn là bắt họ mô phỏng
           một sự phân chia không còn tồn tại ở khâu của họ.

           KHOÁ tab là chuỗi VI (định danh) — chỉ NHÃN mới dịch, nếu không thì
           đổi ngôn ngữ sẽ văng tab đang mở. Cùng bài học với IpqcDashboard. *@
        <div class="ipqc-tabs" role="tablist" data-testid="fqc-tabs">
            @foreach (var tab in ActiveTabs)
            {
                <button type="button"
                        class="ipqc-tab-chip @(_activeTab == tab.Key ? "is-active" : "")"
                        role="tab"
                        aria-selected="@(_activeTab == tab.Key ? "true" : "false")"
                        @onclick="@(() => _activeTab = tab.Key)"
                        data-testid="@($"fqc-tab-{tab.Key}")">
                    <span class="ipqc-tab-label">@tab.Label</span>
                    <span class="ipqc-tab-count"
                          data-testid="@($"fqc-tab-{tab.Key}-count")">@tab.Done/@tab.Total</span>
                </button>
            }
        </div>

        @* Bảng 5 cột. IPQC có thêm cột APPLY dựa trên WoIpqcCheckItem.Applicable
           — WoQcCheckItems KHÔNG có cột đó, nên ở đây là 5 chứ không 6. Thêm nó
           cần migration lên live DB (STOP-gate) cho việc chưa ai yêu cầu. *@
        <table class="ipqc-item-table ipqc-no-result" data-testid="fqc-item-table">
            <thead>
                <tr>
                    <th class="ipqc-col-num">@T("ipqc.col.num")</th>
                    <th class="ipqc-col-item">@T("ipqc.col.item")</th>
                    <th class="ipqc-col-method">@T("ipqc.col.method")</th>
                    <th class="ipqc-col-spec">@T("ipqc.col.spec")</th>
                    <th class="ipqc-col-verdict">@T("ipqc.col.verdict")</th>
                </tr>
            </thead>
            <tbody>
                @{ var __rowNo = 0; }
                @foreach (var item in ItemsInActiveTab)
                {
                    __rowNo++;
                    <tr class="ipqc-item-row @SlotCssClass(item.Status)"
                        data-testid="@($"fqc-item-{item.ItemKey}")">
                        <td class="ipqc-col-num scan-mono">@__rowNo</td>
                        <td class="ipqc-col-item">
                            <span class="ipqc-item-label">@item.LabelFor(IsEnglish)</span>
                            <span class="ipqc-status-pill @StatusPillCss(item.Status)"
                                  data-testid="@($"fqc-item-{item.ItemKey}-status")">@StatusDisplay(item.Status)</span>
                        </td>
                        @* METHOD là văn xuôi, không phải mã — không scan-mono (L-CSS
                           đã học ở bảng IPQC: mono làm cùng chuỗi rộng thêm ~20%
                           và vỡ dòng trong khi SPEC cùng bề rộng thì không). *@
                        <td class="ipqc-col-method" data-label="@T("ipqc.col.method")">@(item.MethodFor(IsEnglish) is { Length: > 0 } m && !string.IsNullOrWhiteSpace(m) ? m : "—")</td>
                        <td class="ipqc-col-spec" data-label="@T("ipqc.col.spec")">@(item.SpecFor(IsEnglish) is { Length: > 0 } sp && !string.IsNullOrWhiteSpace(sp) ? sp : "—")</td>
                        <td class="ipqc-col-verdict">
                            @* L52 — shared OK/NG segmented toggle *@
                            <ConfirmToggle Status="@item.Status"
                                           Disabled="@_busy"
                                           OnOk="@(() => OnSetOkAsync(item))"
                                           OnNg="@(() => OpenNgForm(item.ItemKey))"
                                           TestIdPrefix="@($"fqc-item-{item.ItemKey}")" />
                        </td>
                    </tr>

                    @if (item.Status == "Ng" && item.NgReasonCode is not null || _openNgFor == item.ItemKey || item.PhotoIds.Count > 0)
                    {
                        <tr class="ipqc-item-detail-row" data-testid="@($"fqc-item-{item.ItemKey}-detail")">
                            <td colspan="5">
                                @if (item.Status == "Ng" && item.NgReasonCode is not null)
                                {
                                    <div class="ipqc-slot-ng-summary" data-testid="@($"fqc-item-{item.ItemKey}-ng-summary")">
                                        <span class="ipqc-slot-ng-label">@T("fqc.ng.code.label")</span>
                                        <span class="ipqc-slot-ng-value scan-mono">@item.NgReasonCode</span>
                                        @if (!string.IsNullOrEmpty(item.NgNote))
                                        {
                                            <div class="ipqc-slot-ng-note">@item.NgNote</div>
                                        }
                                    </div>
                                }

                                @if (_openNgFor == item.ItemKey)
                                {
                                    <div class="ipqc-ng-form" data-testid="@($"fqc-item-{item.ItemKey}-ng-form")">
                                        <div class="ipqc-ng-field">
                                            <label class="rs-modal-label" for="@($"fqc-{item.ItemKey}-reason")">@T("fqc.ng.code")</label>
                                            <select id="@($"fqc-{item.ItemKey}-reason")"
                                                    class="ipqc-input"
                                                    value="@_ngReasonCode"
                                                    @onchange="@(e => _ngReasonCode = e.Value?.ToString() ?? "")"
                                                    data-testid="@($"fqc-item-{item.ItemKey}-ng-reason")">
                                                <option value="">@T("fqc.ng.code.select")</option>
                                                @foreach (var r in ScrapReasons)
                                                {
                                                    <option value="@r.Code">@r.Code — @r.LabelVi</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="ipqc-ng-field ipqc-ng-field-wide">
                                            <label class="rs-modal-label" for="@($"fqc-{item.ItemKey}-note")">@T("fqc.ng.note.label")</label>
                                            <input id="@($"fqc-{item.ItemKey}-note")"
                                                   type="text"
                                                   class="ipqc-input"
                                                   maxlength="500"
                                                   value="@_ngNote"
                                                   @oninput="@(e => _ngNote = e.Value?.ToString() ?? "")"
                                                   data-testid="@($"fqc-item-{item.ItemKey}-ng-note")" />
                                            <div class="ipqc-char-count">@_ngNote.Length/500</div>
                                        </div>
                                        <div class="ipqc-ng-actions">
                                            <button type="button"
                                                    class="op-btn op-btn-secondary"
                                                    @onclick="CloseNgForm"
                                                    data-testid="@($"fqc-item-{item.ItemKey}-ng-cancel")">@T("fqc.cancel")</button>
                                            <button type="button"
                                                    class="op-btn op-btn-danger"
                                                    disabled="@(!CanSubmitNg() || _busy)"
                                                    @onclick="@(() => OnSetNgAsync(item))"
                                                    data-testid="@($"fqc-item-{item.ItemKey}-ng-submit")">
                                                @T("fqc.ng.save")
                                            </button>
                                        </div>
                                    </div>
                                }

                                @* Ảnh bằng chứng — chỉ hiện khi hạng mục NG, đang mở form
                                   NG, hoặc đã có ảnh. Dựng 42 dải ảnh cho 42 dòng OK sẽ
                                   xoá sạch cái mật độ mà bảng vừa mang lại. *@
                                <QcPhotoStrip WorkOrderId="@_view.WoId"
                                              Kind="fqc"
                                              ItemKey="@item.ItemKey"
                                              PhotoIds="@item.PhotoIds"
                                              ETag="@_view.ETag"
                                              Disabled="@_busy"
                                              OnPhotosChanged="OnPhotosChangedAsync" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>


        @* ── Judgment row ──────────────────────────────────────────── *@
        <div class="rs-card ipqc-judgment" data-testid="fqc-judgment">
            <div class="rs-card-head">
                <div class="rs-card-title">@T("fqc.judgment.title")</div>
                @if (_view.IsReadyForJudgment)
                {
                    <div class="ipqc-rollup-pill @(_view.AnyNg ? "ipqc-rollup-warn" : "ipqc-rollup-ok")"
                         data-testid="fqc-rollup-pill">
                        @if (_view.AllOk)
                        {
                            <span>@T("fqc.rollup.allok")</span>
                        }
                        else
                        {
                            <span>@T("fqc.rollup.anyng", "PREPRESS")</span>
                        }
                    </div>
                }
                else if (_view.Items.Count > 0)
                {
                    <div class="ipqc-rollup-pill ipqc-rollup-pending"
                         data-testid="fqc-rollup-pill">
                        @T("fqc.rollup.pending", _view.Items.Count - ConfirmedCount)
                    </div>
                }
            </div>

            <div class="ipqc-judgment-actions rs-action-bar-multi" data-testid="fqc-judgment-buttons">
                <button type="button"
                        class="op-btn op-btn-success ipqc-judgment-btn"
                        disabled="@(!CanPass() || _busy)"
                        @onclick="@(() => OnSubmitJudgmentAsync(JudgmentPass))"
                        data-testid="fqc-judgment-pass">
                    @T("fqc.judgment.pass", "OQC")
                </button>
                <button type="button"
                        class="op-btn op-btn-danger ipqc-judgment-btn"
                        disabled="@(!CanReject() || _busy)"
                        @onclick="@(() => OnSubmitJudgmentAsync(JudgmentReject))"
                        data-testid="fqc-judgment-reject">
                    @T("fqc.judgment.reject", "PREPRESS")
                </button>
            </div>

            @if (_view.IsReadyForJudgment && _view.AnyNg)
            {
                <div class="ipqc-judgment-reason">
                    <label class="rs-modal-label" for="fqc-reject-reason">
                        @T("fqc.reject.reason.label")
                    </label>
                    <input id="fqc-reject-reason"
                           type="text"
                           class="ipqc-input"
                           maxlength="500"
                           value="@_rejectReason"
                           @oninput="@(e => _rejectReason = e.Value?.ToString() ?? "")"
                           data-testid="fqc-reject-reason" />
                    <div class="ipqc-char-count">@_rejectReason.Length/500</div>
                </div>
            }

            @if (!_view.IsReadyForJudgment)
            {
                <div class="rs-action-hint" data-testid="fqc-judgment-hint">
                    @T("fqc.hint.confirm")
                </div>
            }
            else if (!_view.AnyNg)
            {
                <div class="rs-action-hint" data-testid="fqc-judgment-hint">
                    @T("fqc.hint.allok")
                </div>
            }
            else
            {
                <div class="rs-action-hint" data-testid="fqc-judgment-hint">
                    @T("fqc.hint.anyng", "PREPRESS")
                </div>
            }
        </div>
    }
</div>

@code {

    // ── TẦNG TAB NHÓM (A·Ngoại quan … E·RoHS) ────────────────────────────
    // Một tầng, không hai: lô đã rời chuyền nên không chẻ theo công đoạn.
    // Xem chú thích ở phần markup và QcLibraryProfileBuilder.

    private const string TabOtherKey = "__other__";
    private string _activeTab = "";

    /// <summary>Khoá tab của một hạng mục = <c>GroupLabel</c> (chuỗi VI, trim).
    /// Rỗng → gom vào tab "Khác". KHOÁ luôn là VI kể cả khi hiển thị EN — dịch
    /// khoá thì đổi ngôn ngữ sẽ làm _activeTab không khớp và bảng trắng trơn.</summary>
    private static string TabForItem(WoQcViewItem i) =>
        string.IsNullOrWhiteSpace(i.GroupLabel) ? TabOtherKey : i.GroupLabel!.Trim();

    private sealed record TabDef(string Key, string Label, int Done, int Total);

    /// <summary>Tab = tập GroupLabel DISTINCT của view, sắp tăng dần (A·→B·→…→E·).
    /// Tab "Khác" LUÔN xuống cuối và chỉ khi thực sự có hạng mục rơi vào đó.</summary>
    private IReadOnlyList<TabDef> ActiveTabs
    {
        get
        {
            if (_view is null || _view.Items.Count == 0) return Array.Empty<TabDef>();
            return _view.Items
                .GroupBy(TabForItem)
                .Select(g => new TabDef(
                    g.Key,
                    g.Key == TabOtherKey
                        ? T("ipqc.tab.other")
                        : (g.First().GroupLabelFor(IsEnglish) ?? g.Key),
                    g.Count(i => i.Status is "Ok" or "Ng"),
                    g.Count()))
                .OrderBy(t => t.Key == TabOtherKey ? 1 : 0)
                .ThenBy(t => t.Key, StringComparer.Ordinal)
                .ToList();
        }
    }

    /// <summary>Hạng mục của tab đang mở. Tab chưa chọn (hoặc chọn phải tab vừa
    /// biến mất sau khi view đổi) → lùi về tab đầu tiên thay vì trả rỗng.</summary>
    private IEnumerable<WoQcViewItem> ItemsInActiveTab
    {
        get
        {
            if (_view is null) return Array.Empty<WoQcViewItem>();
            var tabs = ActiveTabs;
            if (tabs.Count == 0) return Array.Empty<WoQcViewItem>();
            var key = tabs.Any(t => t.Key == _activeTab) ? _activeTab : tabs[0].Key;
            return _view.Items.Where(i => TabForItem(i) == key);
        }
    }

    /// <summary>Ngôn ngữ đang bật. Nhãn hạng mục · tiêu chí · phương pháp
    /// là DỮ LIỆU ĐÃ ĐÓNG BĂNG trong snapshot của check, không phải khoá
    /// resx — nên không đi qua T(), mà qua *For(bool) của WoQcViewItem.
    /// LocalizedComponentBase đã bắt sự kiện đổi ngôn ngữ và gọi
    /// StateHasChanged, nên bảng tự vẽ lại khi người dùng bấm cờ.</summary>
    private bool IsEnglish => LanguageService.Current == LanguageCode.English;
    [Parameter, EditorRequired] public long WorkOrderId { get; set; }

    /// <summary>Scrap reason codes for the NG dropdowns. Loaded once by
    /// parent + handed in.</summary>
    [Parameter] public IReadOnlyList<ReasonCodeOption> ScrapReasons { get; set; } = Array.Empty<ReasonCodeOption>();

    /// <summary>L21 — invoked after a successful judgment so parent
    /// re-fetches summary + re-dispatches (Pass → OQC_PENDING,
    /// Reject → PREPRESS).</summary>
    [Parameter] public EventCallback OnPhaseChanged { get; set; }

    private const string JudgmentPass = "Pass";
    private const string JudgmentReject = "Reject";

    private WoQcView? _view;
    private string? _initialError;
    private string? _setError;
    private bool _busy;
    private bool _invalidPhase;
    private long _lastLoadedWoId;

    private string? _openNgFor;
    private string _ngReasonCode = "";
    private string _ngNote = "";
    private string _rejectReason = "";

    private int ConfirmedCount =>
        _view?.Items.Count(i => i.Status != "Pending") ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        if (WorkOrderId != _lastLoadedWoId)
        {
            _lastLoadedWoId = WorkOrderId;
            _view = null;
            _initialError = null;
            _setError = null;
            _invalidPhase = false;
            _openNgFor = null;
            _ngReasonCode = "";
            _ngNote = "";
            _rejectReason = "";
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _view = await Api.GetWoQcViewAsync(WorkOrderId, "fqc");
            _invalidPhase = _view.MesPhase != "FQC_PENDING";
        }
        catch (ApiException apiEx)
        {
            _initialError = WoQcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (HttpRequestException ex)
        {
            _initialError = $"{T("fqc.error.connect")}: {ex.Message}";
        }
        catch (Exception ex)
        {
            _initialError = $"{T("fqc.error.loading")}: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private static string SlotCssClass(string status) => status switch
    {
        "Ok"  => "ipqc-slot-ok",
        "Ng"  => "ipqc-slot-ng",
        _     => "ipqc-slot-pending",
    };

    private string StatusDisplay(string status) => status switch
    {
        "Ok" => T("fqc.status.ok"),
        "Ng" => T("fqc.status.ng"),
        _    => T("fqc.status.pending"),
    };

    private static string StatusPillCss(string status) => status switch
    {
        "Ok" => "ipqc-status-ok",
        "Ng" => "ipqc-status-ng",
        _    => "ipqc-status-pending",
    };

    private void OpenNgForm(string itemKey)
    {
        if (_busy) return;
        _openNgFor = itemKey;
        var item = _view?.Items.FirstOrDefault(i => i.ItemKey == itemKey);
        _ngReasonCode = item?.NgReasonCode ?? "";
        _ngNote = item?.NgNote ?? "";
    }

    private void CloseNgForm()
    {
        _openNgFor = null;
        _ngReasonCode = "";
        _ngNote = "";
    }

    private bool CanSubmitNg() =>
        !string.IsNullOrWhiteSpace(_ngReasonCode)
        && ScrapReasons.Any(r => r.Code == _ngReasonCode)
        && !string.IsNullOrWhiteSpace(_ngNote)
        && _ngNote.Length <= 500;

    private void DismissSetError() => _setError = null;

    private Task OnSetOkAsync(WoQcViewItem item) =>
        SubmitItemAsync(item, new SetWoQcItemRequest { Status = "Ok" });

    private async Task OnSetNgAsync(WoQcViewItem item)
    {
        if (!CanSubmitNg()) return;
        await SubmitItemAsync(item, new SetWoQcItemRequest
        {
            Status = "Ng",
            NgReasonCode = _ngReasonCode,
            NgNote = _ngNote,
        });
    }

    private async Task SubmitItemAsync(WoQcViewItem item, SetWoQcItemRequest req)
    {
        if (_view is null || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var resp = await Api.PutWoQcItemAsync(
                WorkOrderId, "fqc", item.ItemKey, _view.ETag, req);
            await HandleSetResponseAsync(resp);
            if (resp.Ok) CloseNgForm();
        }
        catch (ApiException apiEx)
        {
            _setError = WoQcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"{T("fqc.error.connect")}: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnPhotosChangedAsync()
    {
        // Photo upload bumps WO RowVersion via the trigger — refresh the
        // view so PhotoIds + ETag stay in sync.
        await ReloadAsync();
    }

    private bool CanPass() =>
        _view is not null
        && _view.IsReadyForJudgment
        && _view.AllOk
        && !_view.AnyNg
        && _view.Items.Count > 0;

    private bool CanReject() =>
        _view is not null
        && _view.IsReadyForJudgment
        && _view.AnyNg
        && !string.IsNullOrWhiteSpace(_rejectReason)
        && _rejectReason.Length <= 500;

    private async Task OnSubmitJudgmentAsync(string judgment)
    {
        if (_view is null || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var req = new SubmitFqcJudgmentRequest
            {
                Judgment = judgment,
                JudgmentReason = judgment == JudgmentReject ? _rejectReason : null,
            };
            var resp = await Api.PostFqcJudgmentAsync(WorkOrderId, _view.ETag, req);
            await HandleSetResponseAsync(resp);
            if (resp.Ok)
            {
                // L21 — Pass → OQC_PENDING, Reject → PREPRESS.
                await OnPhaseChanged.InvokeAsync();
            }
        }
        catch (ApiException apiEx)
        {
            _setError = WoQcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"{T("fqc.error.connect")}: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HandleSetResponseAsync(WoQcSetResponse resp)
    {
        if (resp.Ok)
        {
            await ReloadAsync();
            return;
        }
        if (!string.IsNullOrEmpty(resp.ErrorCode))
        {
            _setError = WoQcReviewErrorLocaliser.LocaliseSetError(resp.ErrorCode);
            await ReloadAsync();
            return;
        }
        _setError = T("fqc.error.no.code");
    }
}
