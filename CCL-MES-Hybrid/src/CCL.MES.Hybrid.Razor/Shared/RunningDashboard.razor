@*
    P10.7c-3 — RUNNING + PAUSED + IPQC_APPROVED operator dashboard.

    Hosted by WorkOrders.razor when the scanned WO is in one of the
    running-surface phases. Owns the entire RunningSurfaceView state +
    every API call (run/start, run/qty, run/qty/correct, run/pause,
    run/resume, run/finish).

    Phase fan-out:
      IPQC_APPROVED  — single primary button "Bắt đầu chạy" (run/start).
      RUNNING        — big counter (Done / NG / Target), quick-tap +100
                       / +500 / +1000, NG tile with reason picker,
                       "Sửa số" (correction modal), "Tạm dừng" + "Kết thúc".
      PAUSED         — pause banner (reason + elapsed),
                       "Tiếp tục chạy" (resume), "Sửa số" + "Kết thúc".

    Concurrency / error handling:
      - Every mutation refetches view on success (cheap; SQLite write-
        lock serialises) so audit-touched fields surface.
      - 409 wo.state_conflict carries fresh ETag in the response; we
        refetch + show banner.
      - 422 codes surface via RunningSurfaceErrorLocaliser.
      - Optimistic counter increment NOT used in v1 — every tap awaits
        the POST so we never show a stale total that the server hasn't
        accepted yet. Acceptable because /run/qty is ~50 ms on the local
        SQLite.

    Rule 4: plain <button>, plain <input> in modals.
*@

@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.RunningSurface
@using CCL.MES.Shared.Envelopes
@using CCL.MES.Shared.ReasonCodes
@using CCL.MES.Shared.RunningSurface
@using System.Timers
@inject ICclApiClient Api

<div class="rs-dashboard" data-testid="running-dashboard">
    @if (_view is null && _initialError is null)
    {
        <div class="rs-loading" data-testid="running-loading">@T("running.loading")</div>
    }
    else if (_initialError is not null)
    {
        <div class="wo-card-error" data-testid="running-initial-error">
            <strong>@T("running.initial.error")</strong> @_initialError
        </div>
    }
    else if (_view is not null && DeferredPhaseInfo.TryGetValue(_view.MesPhase, out var deferred))
    {
        @* P10.7c-3 BUG-FIX L19-finalization (Henry RCA on WO-26-3686):
           7d-deferred phases (IPQC_WAIT / QA_PENDING / FQC_PENDING /
           OQC_PENDING / DONE / CANCELLED) all render a read-only
           informational placeholder card via DeferredPhaseInfo lookup.
           Replaces the previous IPQC_WAIT-only branch + the dead-end
           "WO không ở giai đoạn chạy" error banner that previously
           ambushed operators after Finish. 7d/7e will replace each
           placeholder with a real dashboard. *@
        <div class="rs-head">
            <div class="rs-head-wo">
                <span class="rs-head-label">WO</span>
                <span class="rs-head-wo-no">@_view.WoNo</span>
                <StatusPill Phase="@_view.MesPhase" />
            </div>
        </div>
        <div class="rs-card rs-card-stretch"
             data-testid="running-deferred"
             data-deferred-phase="@_view.MesPhase">
            <div class="rs-card-head">
                <div class="rs-card-title">@T(deferred.TitleKey)</div>
            </div>
            <div class="rs-ipqc-wait-body">
                <p>@T(deferred.BodyKey)</p>
                <p class="rs-ipqc-wait-hint">@T(deferred.HintKey)</p>
                @if (_view.QtyDoneCached > 0 || _view.QtyNgCached > 0)
                {
                    <div class="rs-ipqc-wait-stats">
                        <span>@T("running.done.recorded") <strong class="scan-mono">@_view.QtyDoneCached</strong></span>
                        <span>@T("running.ng.recorded") <strong class="scan-mono">@_view.QtyNgCached</strong></span>
                    </div>
                }
            </div>
        </div>
    }
    else if (_invalidPhase)
    {
        <div class="wo-card-error" data-testid="running-invalid-phase">
            <strong>@T("running.invalid.phase")</strong> —
            @T("running.invalid.current") <code>@(_view?.MesPhase ?? "?")</code>.
            @T("running.invalid.goback")
        </div>
    }
    else if (_view is not null)
    {
        <div class="rs-head">
            <div class="rs-head-wo">
                <span class="rs-head-label">WO</span>
                <span class="rs-head-wo-no">@_view.WoNo</span>
                <StatusPill Phase="@_view.MesPhase" TestId="running-wo-phase" />
            </div>
            @if (_view.MesPhase == "PAUSED" && _view.ActivePauseStartAt is not null)
            {
                <div class="rs-head-pause" data-testid="running-pause-banner">
                    <span class="rs-pause-label">@T("running.paused.label")</span>
                    <span class="rs-pause-reason">@(_view.ActivePauseReasonCode ?? "?")</span>
                </div>
            }
            @if (ShowRunClock)
            {
                <div class="rs-runclock @(IsPausedNow ? "is-paused" : "")"
                     data-testid="running-clock" title="@T("running.timer.hint")">
                    <div class="rs-runclock-main">
                        <span class="rs-runclock-label">
                            @T("running.timer.run.label")
                            @if (IsPausedNow)
                            {
                                <span class="rs-runclock-flag">@T("running.timer.paused.now")</span>
                            }
                        </span>
                        <span class="rs-runclock-value scan-mono" data-testid="running-clock-run">@Hms(RunSecondsLive)</span>
                    </div>
                    <div class="rs-runclock-side">
                        <div class="rs-runclock-stat">
                            <span class="rs-runclock-stat-label">@T("running.timer.pause.label")</span>
                            <span class="rs-runclock-stat-value scan-mono" data-testid="running-clock-pause">@Hms(PauseSecondsLive)</span>
                        </div>
                        <div class="rs-runclock-stat">
                            <span class="rs-runclock-stat-label">@T("running.timer.availability.label")</span>
                            <span class="rs-runclock-stat-value scan-mono" data-testid="running-clock-availability">@AvailabilityText</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (_setError is not null)
        {
            <div class="wo-card-error" data-testid="running-set-error">
                <strong>@T("running.set.error")</strong> @_setError
                <button type="button" class="op-btn op-btn-secondary op-btn-sm"
                        @onclick="DismissSetError"
                        data-testid="running-set-error-dismiss">@T("running.dismiss")</button>
            </div>
        }

        @* D2 — ĐƯỜNG RA phải ở ngay cạnh chỗ bị chặn.
           Câu báo lỗi bảo "nhờ kỹ sư chấp nhận đặc biệt", nhưng ở phase này
           màn Pre-press không được render và endpoint special-accept trước đây
           cũng bị guard chặn — người đứng máy đọc xong không có chỗ nào để đi.
           Panel này mở đúng khi cổng vừa từ chối, và tự biến mất khi bỏ qua
           lỗi hoặc khi khắc phục xong (ReloadAsync xoá _setErrorCode). *@
        @if (_setErrorCode is "run.material_line_unchecked" or "run.material_lot_unusable")
        {
            <div class="rs-card rs-card-stretch" data-testid="running-material-remediation">
                <div class="rs-card-head">
                    <div class="rs-card-title">@T("running.material.remediation.title")</div>
                </div>
                <PrepressDashboard WorkOrderId="@WorkOrderId" SpecialAcceptOnly="true" />
            </div>
        }

        @if (_view.MesPhase == "IPQC_APPROVED")
        {
            <div class="rs-card rs-card-stretch">
                <div class="rs-card-head">
                    <div class="rs-card-title">@T("running.ipqc.approved.title")</div>
                </div>
                <div class="rs-action-bar">
                    <button type="button"
                            class="op-btn op-btn-primary rs-primary-btn"
                            data-testid="run-start-btn"
                            disabled="@_busy"
                            @onclick="OnRunStartAsync">@T("running.start")</button>
                </div>
            </div>
        }
        else
        {
            <div class="rs-counter" data-testid="running-counter">
                <div class="rs-counter-cell rs-counter-done">
                    <div class="rs-counter-label">@T("running.counter.done")</div>
                    <div class="rs-counter-value scan-mono" data-testid="counter-done">@_view.QtyDoneCached</div>
                </div>
                <div class="rs-counter-cell rs-counter-ng">
                    <div class="rs-counter-label">@T("running.counter.ng")</div>
                    <div class="rs-counter-value scan-mono" data-testid="counter-ng">@_view.QtyNgCached</div>
                </div>
                <div class="rs-counter-cell rs-counter-target">
                    <div class="rs-counter-label">@T("running.counter.target")</div>
                    <div class="rs-counter-value scan-mono" data-testid="counter-target">@_view.TargetQty</div>
                </div>
            </div>

            <div class="rs-card">
                <div class="rs-card-head">
                    <div class="rs-card-title">@T("running.addoutput.title")</div>
                </div>
                <div class="rs-tap-grid" data-testid="running-tap-grid">
                    @foreach (var amt in TapAmounts)
                    {
                        var capturedAmt = amt;
                        <button type="button"
                                class="op-btn op-btn-primary rs-tap-btn"
                                data-testid="@($"tap-done-{capturedAmt}")"
                                disabled="@(_busy || _view.MesPhase != "RUNNING")"
                                @onclick="() => OnTapDoneAsync(capturedAmt)">+@capturedAmt</button>
                    }
                </div>
                @if (_view.MesPhase == "PAUSED")
                {
                    <div class="rs-tap-hint" data-testid="running-tap-paused-hint">
                        @T("running.tap.paused.hint")
                    </div>
                }
            </div>

            <div class="rs-card">
                <div class="rs-card-head">
                    <div class="rs-card-title">@T("running.ng.title")</div>
                </div>
                <div class="rs-ng-row">
                    <div class="rs-ng-field">
                        <label class="rs-modal-label" for="ng-amount-input">@T("running.ng.quantity")</label>
                        <input id="ng-amount-input"
                               type="number"
                               class="rs-input"
                               min="1"
                               step="1"
                               value="@_ngAmount"
                               data-testid="ng-amount-input"
                               disabled="@(_busy || _view.MesPhase != "RUNNING")"
                               @oninput="OnNgAmountInput" />
                    </div>
                    <div class="rs-ng-field">
                        <label class="rs-modal-label" for="ng-reason-select">@T("running.ng.defectcode")</label>
                        <select id="ng-reason-select"
                                class="rs-input rs-select"
                                value="@_ngReasonCode"
                                data-testid="ng-reason-select"
                                disabled="@(_busy || _view.MesPhase != "RUNNING" || ScrapReasons.Count == 0)"
                                @onchange="OnNgReasonChange">
                            <option value="">@T("running.ng.defectcode.placeholder")</option>
                            @foreach (var rc in ScrapReasons)
                            {
                                <option value="@rc.Code">@rc.Code · @rc.LabelVi</option>
                            }
                        </select>
                    </div>
                    <div class="rs-ng-field rs-ng-field-wide">
                        <label class="rs-modal-label" for="ng-note-input">@T("running.ng.note")</label>
                        <input id="ng-note-input"
                               type="text"
                               class="rs-input"
                               maxlength="500"
                               value="@_ngNote"
                               data-testid="ng-note-input"
                               disabled="@(_busy || _view.MesPhase != "RUNNING")"
                               @oninput="OnNgNoteInput" />
                    </div>
                    <div class="rs-ng-field rs-ng-submit">
                        <button type="button"
                                class="op-btn op-btn-warning rs-ng-btn"
                                data-testid="ng-submit-btn"
                                disabled="@(_busy || _view.MesPhase != "RUNNING" || !IsNgValid())"
                                @onclick="OnNgSubmitAsync">@T("running.ng.submit")</button>
                    </div>
                </div>
                @if (ScrapReasons.Count == 0)
                {
                    <div class="wo-card-error" data-testid="running-scrap-reasons-empty">
                        <strong>@T("running.scrap.empty.strong")</strong> @T("running.scrap.empty.body")
                    </div>
                }
            </div>

            <div class="rs-action-bar rs-action-bar-multi">
                @if (_view.MesPhase == "RUNNING")
                {
                    <button type="button"
                            class="op-btn op-btn-warning"
                            data-testid="run-pause-btn"
                            disabled="@_busy"
                            @onclick="OpenPauseModal">@T("running.pause")</button>
                }
                else if (_view.MesPhase == "PAUSED")
                {
                    <button type="button"
                            class="op-btn op-btn-primary"
                            data-testid="run-resume-btn"
                            disabled="@_busy"
                            @onclick="OnRunResumeAsync">@T("running.resume")</button>
                }

                <button type="button"
                        class="op-btn op-btn-secondary"
                        data-testid="run-correct-btn"
                        disabled="@(_busy || _view.RecentEntries.Count == 0)"
                        @onclick="OpenCorrectModal">@T("running.correct")</button>

                <button type="button"
                        class="op-btn op-btn-danger"
                        data-testid="run-finish-btn"
                        disabled="@(_busy || _view.QtyDoneCached <= 0)"
                        @onclick="OpenFinishModal">@T("running.finish")</button>
            </div>
        }

        <WoPauseModal Open="@_pauseModalOpen"
                      Busy="@_busy"
                      PauseReasons="@PauseReasons"
                      OnClose="ClosePauseModal"
                      OnConfirm="OnPauseConfirmAsync" />

        <WoQtyCorrectModal Open="@_correctModalOpen"
                           Busy="@_busy"
                           RecentEntries="@_view.RecentEntries"
                           OnClose="CloseCorrectModal"
                           OnConfirm="OnCorrectConfirmAsync" />

        <WoFinishConfirm Open="@_finishModalOpen"
                         Busy="@_busy"
                         WoNo="@_view.WoNo"
                         QtyDoneCached="@_view.QtyDoneCached"
                         QtyNgCached="@_view.QtyNgCached"
                         TargetQty="@_view.TargetQty"
                         OnClose="CloseFinishModal"
                         OnConfirm="OnFinishConfirmAsync" />
    }
</div>

@code {
    [Parameter, EditorRequired] public long WorkOrderId { get; set; }
    [Parameter] public IReadOnlyList<ReasonCodeOption> ScrapReasons { get; set; } = Array.Empty<ReasonCodeOption>();
    [Parameter] public IReadOnlyList<ReasonCodeOption> PauseReasons { get; set; } = Array.Empty<ReasonCodeOption>();

    /// <summary>P10.7d-3 BUG-FIX (Henry RCA on PR #119) — invoked after
    /// a successful action that may have changed the WO's MesPhase
    /// (run/start IPQC_APPROVED→RUNNING, run/finish RUNNING|PAUSED→FQC_PENDING).
    /// Parent re-fetches the summary so the chip + dispatch see the
    /// canonical post-transition state without the operator tapping
    /// "Tìm" again. Tap qty / pause / resume do NOT bubble (no phase
    /// change). See Lesson L21.</summary>
    [Parameter] public EventCallback OnPhaseChanged { get; set; }

    private static readonly int[] TapAmounts = new[] { 100, 500, 1000 };

    private RunningSurfaceView? _view;
    private string? _initialError;
    private string? _setError;
    private bool _busy;
    private bool _invalidPhase;
    private long _lastLoadedWoId;

    private int _ngAmount = 1;
    private string _ngReasonCode = "";
    private string _ngNote = "";

    private bool _pauseModalOpen;
    private bool _correctModalOpen;
    private bool _finishModalOpen;

    protected override async Task OnParametersSetAsync()
    {
        if (WorkOrderId != _lastLoadedWoId)
        {
            _lastLoadedWoId = WorkOrderId;
            _view = null;
            _initialError = null;
            _setError = null;
            _setErrorCode = null;
            _invalidPhase = false;
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _view = await Api.GetRunningSurfaceViewAsync(WorkOrderId);
            _invalidPhase = !IsValidRunningPhase(_view.MesPhase);
            SyncClockTicker();
        }
        catch (ApiException apiEx)
        {
            _initialError = RunningSurfaceErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (HttpRequestException ex)
        {
            _initialError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _initialError = $"Error loading status: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private static bool IsValidRunningPhase(string phase) =>
        phase == "IPQC_APPROVED"
        || phase == "RUNNING"
        || phase == "PAUSED"
        // P10.7c-3 L19-finalization — every deferred phase below is valid;
        // the render branch above routes them to a placeholder card so
        // the dashboard never falls into the dead-end error path.
        || DeferredPhaseInfo.ContainsKey(phase);

    /// <summary>P10.7c-3 L19-finalization — phase → placeholder card
    /// content map. Operators landing on a 7e-deferred phase see a
    /// consistent read-only info card instead of a dead-end error banner.
    /// 7d-3 REMOVED IPQC_WAIT + QA_PENDING entries — those have real
    /// dashboards (IpqcDashboard + QaApprovalDashboard) hosted by
    /// WorkOrders.razor BEFORE this dispatch. 7e-3 REMOVED FQC_PENDING +
    /// OQC_PENDING entries — those now route to FqcDashboard +
    /// OqcDashboard. SHIPPED also routes to its own dashboard. Only
    /// DONE / CANCELLED remain as terminal info cards.
    /// Maintain THIS map (not the render branch) to add new placeholders.</summary>
    private static readonly Dictionary<string, DeferredPhase> DeferredPhaseInfo = new(StringComparer.OrdinalIgnoreCase)
    {
        ["DONE"] = new(
            TitleKey: "running.deferred.done.title",
            BodyKey: "running.deferred.done.body",
            HintKey: "running.deferred.scan.hint"),
        ["CANCELLED"] = new(
            TitleKey: "running.deferred.cancelled.title",
            BodyKey: "running.deferred.cancelled.body",
            HintKey: "running.deferred.scan.hint"),
    };

    private sealed record DeferredPhase(string TitleKey, string BodyKey, string HintKey);

    private bool IsNgValid() =>
        _ngAmount > 0
        && !string.IsNullOrWhiteSpace(_ngReasonCode)
        && ScrapReasons.Any(r => r.Code == _ngReasonCode)
        && !string.IsNullOrWhiteSpace(_ngNote)
        && _ngNote.Length <= 500;

    private async Task GuardedPostAsync(Func<string, Task<RunningSurfaceSetResponse>> doPost,
                                       Action? onSuccessExtra = null,
                                       bool notifyPhaseChange = false)
    {
        if (_view is null) return;
        _busy = true;
        _setError = null;
        // Xoá cùng lúc với _setError: bấm lại mà panel khắc phục còn treo thì
        // người đứng máy không biết lần này đã qua hay chưa.
        _setErrorCode = null;
        try
        {
            var ifMatch = _view.ETag;
            var resp = await doPost(ifMatch);
            if (resp.Ok)
            {
                await ReloadAsync();
                onSuccessExtra?.Invoke();
                // P10.7d-3 BUG-FIX (Henry RCA on PR #119) — bubble phase
                // change up to the parent only on actions that genuinely
                // changed MesPhase: run/start, pause, resume, finish.
                // Tap qty + correct DON'T flip the phase, so they skip the
                // parent re-fetch (no observable change, just a wasted
                // round-trip). See Lesson L21.
                if (notifyPhaseChange)
                {
                    await OnPhaseChanged.InvokeAsync();
                }
            }
            else if (!string.IsNullOrEmpty(resp.ErrorCode))
            {
                _setError = RunningSurfaceErrorLocaliser.LocaliseSetError(resp.ErrorCode);
                await ReloadAsync();
            }
            else
            {
                _setError = "Server returned Ok=false without an error code — report to IT.";
            }
        }
        catch (ApiException apiEx)
        {
            _setError = RunningSurfaceErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            _setErrorCode = apiEx.ApiError.Code;
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private Task OnRunStartAsync() => GuardedPostAsync(ifMatch =>
        Api.PostRunStartAsync(WorkOrderId, ifMatch),
        notifyPhaseChange: true);  // IPQC_APPROVED → RUNNING

    private Task OnTapDoneAsync(int amount) => GuardedPostAsync(ifMatch =>
        Api.PostRunQtyAddAsync(WorkOrderId, ifMatch, new RunQtyAddRequest
        {
            QtyDoneDelta = amount,
            QtyNgDelta = 0,
        }));

    private async Task OnNgSubmitAsync()
    {
        if (!IsNgValid()) return;
        await GuardedPostAsync(ifMatch =>
            Api.PostRunQtyAddAsync(WorkOrderId, ifMatch, new RunQtyAddRequest
            {
                QtyDoneDelta = 0,
                QtyNgDelta = _ngAmount,
                NgReasonCode = _ngReasonCode,
                NgNote = _ngNote,
            }),
            onSuccessExtra: () =>
            {
                _ngAmount = 1;
                _ngReasonCode = "";
                _ngNote = "";
            });
    }

    private void OpenPauseModal() => _pauseModalOpen = true;
    private void ClosePauseModal() => _pauseModalOpen = false;

    private async Task OnPauseConfirmAsync(RunPauseRequest req)
    {
        _pauseModalOpen = false;
        await GuardedPostAsync(
            ifMatch => Api.PostRunPauseAsync(WorkOrderId, ifMatch, req),
            notifyPhaseChange: true);  // RUNNING → PAUSED (chip color updates)
    }

    private Task OnRunResumeAsync() => GuardedPostAsync(
        ifMatch => Api.PostRunResumeAsync(WorkOrderId, ifMatch),
        notifyPhaseChange: true);  // PAUSED → RUNNING (chip color updates)

    private void OpenCorrectModal() => _correctModalOpen = true;
    private void CloseCorrectModal() => _correctModalOpen = false;

    private async Task OnCorrectConfirmAsync(RunQtyCorrectRequest req)
    {
        _correctModalOpen = false;
        await GuardedPostAsync(ifMatch => Api.PostRunQtyCorrectAsync(WorkOrderId, ifMatch, req));
    }

    private void OpenFinishModal() => _finishModalOpen = true;
    private void CloseFinishModal() => _finishModalOpen = false;

    private async Task OnFinishConfirmAsync()
    {
        _finishModalOpen = false;
        await GuardedPostAsync(
            ifMatch => Api.PostRunFinishAsync(WorkOrderId, ifMatch),
            notifyPhaseChange: true);  // RUNNING|PAUSED → FQC_PENDING
    }

    private void OnNgAmountInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var s = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(s)) { _ngAmount = 0; return; }
        if (int.TryParse(s, out var n) && n >= 0) _ngAmount = n;
    }

    private void OnNgReasonChange(Microsoft.AspNetCore.Components.ChangeEventArgs e)
        => _ngReasonCode = e.Value?.ToString() ?? "";

    private void OnNgNoteInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
        => _ngNote = e.Value?.ToString() ?? "";

    private void DismissSetError()
    {
        _setError = null;
        _setErrorCode = null;
    }

    /// <summary>
    /// Mã lỗi THÔ của lần ghi hỏng gần nhất — giữ riêng khỏi <c>_setError</c>
    /// (đã dịch) vì UI cần rẽ nhánh theo MÃ, mà so khớp trên câu tiếng Việt thì
    /// hỏng ngay lần đầu ai đó sửa chính tả.
    /// </summary>
    private string? _setErrorCode;

    // ── Đồng hồ chạy máy (OEE) ──────────────────────────────────────────
    //
    // Nguồn số: server gửi giây ĐÃ CHỐT của các phiên/lần dừng đã đóng
    // (RunSecondsClosed / PauseSecondsClosed, tính bằng WoRuntimeMath — đúng
    // công thức báo cáo OEE dùng). Phần đang mở thì cộng tại client mỗi giây,
    // nên đồng hồ nhảy mà không phải gọi API liên tục.
    //
    // Vì sao KHÔNG đếm thẳng từ ActiveSessionStartAt: Pause ĐÓNG phiên chạy và
    // Resume mở phiên MỚI. Đếm theo phiên hiện tại thì mỗi lần tạm dừng đồng hồ
    // lại về 0 và báo thiếu giờ máy — đúng thứ làm hỏng chỉ số OEE.

    private Timer? _clockTicker;

    /// <summary>Chỉ chạy đồng hồ ở hai phase mà thời gian máy còn ý nghĩa.
    /// Phase khác (chờ IPQC, đã xong, đã huỷ) thì không hiện, để người đứng
    /// máy không đọc nhầm một con số đang đứng yên là máy đang chạy.</summary>
    private bool ShowRunClock =>
        _view is not null
        && (_view.MesPhase == "RUNNING" || _view.MesPhase == "PAUSED")
        && (_view.RunSecondsClosed > 0 || _view.ActiveSessionStartAt is not null);

    private bool IsPausedNow => _view?.ActivePauseStartAt is not null;

    private long RunSecondsLive =>
        (_view?.RunSecondsClosed ?? 0) + OpenSpanSeconds(_view?.ActiveSessionStartAt);

    private long PauseSecondsLive =>
        (_view?.PauseSecondsClosed ?? 0) + OpenSpanSeconds(_view?.ActivePauseStartAt);

    /// <summary>Giây đã trôi của một khoảng CÒN MỞ. Không bao giờ âm — lệch
    /// đồng hồ máy/DB không được phép làm đồng hồ chạy ngược.</summary>
    private static long OpenSpanSeconds(DateTime? startedAtUtc)
    {
        if (startedAtUtc is null) return 0;
        var secs = (DateTime.UtcNow - startedAtUtc.Value).TotalSeconds;
        return secs > 0 ? (long)secs : 0;
    }

    /// <summary>HH:MM:SS, giờ KHÔNG cuộn về 0 sau 24h (ca dài / WO qua đêm
    /// vẫn phải đọc đúng tổng giờ máy).</summary>
    private static string Hms(long totalSeconds)
    {
        if (totalSeconds < 0) totalSeconds = 0;
        var h = totalSeconds / 3600;
        var m = totalSeconds % 3600 / 60;
        var sec = totalSeconds % 60;
        return $"{h:D2}:{m:D2}:{sec:D2}";
    }

    /// <summary>Availability = run / (run + pause) — đúng công thức Nakajima
    /// mà <c>WoSummaryReportBuilder</c> dùng. Phiên và lần dừng KHÔNG chồng
    /// nhau (pause đóng phiên) nên mẫu số không đếm trùng. Chưa có giây nào
    /// thì hiện "—" chứ không hiện 0% (0% nghĩa là máy đứng, không phải chưa đo).</summary>
    private string AvailabilityText
    {
        get
        {
            var run = RunSecondsLive;
            var total = run + PauseSecondsLive;
            if (total <= 0) return "—";
            return $"{Math.Round(run * 100d / total)}%";
        }
    }

    /// <summary>Bật/tắt nhịp 1 giây theo phase. Gọi sau MỖI lần tải lại view,
    /// nên WO chuyển sang DONE/CANCELLED là nhịp tự tắt — không để timer chạy
    /// mồ côi trên một màn hình không còn đồng hồ.</summary>
    private void SyncClockTicker()
    {
        if (!ShowRunClock) { StopClockTicker(); return; }
        if (_clockTicker is not null) return;
        _clockTicker = new Timer(1000) { AutoReset = true, Enabled = true };
        _clockTicker.Elapsed += async (_, __) => await InvokeAsync(StateHasChanged);
    }

    private void StopClockTicker()
    {
        _clockTicker?.Dispose();
        _clockTicker = null;
    }

    public override void Dispose()
    {
        StopClockTicker();
        base.Dispose();
    }
}
