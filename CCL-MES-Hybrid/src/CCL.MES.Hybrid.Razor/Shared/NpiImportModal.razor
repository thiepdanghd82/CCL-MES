@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Hybrid.Client.Npi
@using Microsoft.AspNetCore.Components.Forms
@inject ICclApiClient Api

@* P10.5 follow-up — CSV import for the NPI grids (SpecHub "Import…"
   parity). Uploads to POST /npi/{kind}/import; appends matched rows. *@
<Modal Open="Open" OnClose="OnClose" ClickOutsideToClose="!_busy">
    <Header>@T("npiimport.header", KindLabel)</Header>
    <Body>
        @if (Kind == "rawmaterials")
        {
            <p class="md-muted">@T("npiimport.instructions.rawmaterials")</p>
        }
        else
        {
            <p class="md-muted">
                @T("npiimport.instructions.before") <code>Part No</code>@T("npiimport.instructions.after")
            </p>
        }
        <InputFile OnChange="OnFileAsync" accept=".xlsx,.csv" disabled="@_busy" />
        @if (_busy)
        {
            <p class="md-muted" style="margin-top:10px;">@T("npiimport.importing")</p>
        }
        @if (_result is not null)
        {
            <p class="grid-status" style="margin-top:10px;">
                ✔ @T("npiimport.result", _result.Inserted, _result.Updated, _result.Skipped)
            </p>
        }
        @if (_error is not null)
        {
            <p class="md-error" style="margin-top:10px;">@_error</p>
        }
    </Body>
    <Footer>
        <button type="button" class="grid-btn" @onclick="OnClose" disabled="@_busy">@T("common.close")</button>
    </Footer>
</Modal>

@code {
    [Parameter] public string Kind { get; set; } = "structures";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnImported { get; set; }

    private bool _busy;
    private string? _error;
    private NpiImportResultDto? _result;

    private string KindLabel => Kind switch
    {
        "routings" => T("npiimport.kind.routings"),
        "rawmaterials" => T("npiimport.kind.rawmaterials"),
        _ => T("npiimport.kind.structure"),
    };

    private async Task OnFileAsync(InputFileChangeEventArgs e)
    {
        _busy = true;
        _error = null;
        _result = null;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(256L * 1024 * 1024).CopyToAsync(ms);
            _result = await Api.ImportNpiAsync(Kind, e.File.Name, ms.ToArray());
            if (_result is not null)
                await OnImported.InvokeAsync();
        }
        catch (ApiException apiEx)
        {
            _error = apiEx.ApiError.Code switch
            {
                "import.header_not_found" => T("npiimport.err.header_not_found"),
                "import.xlsx_unreadable"  => T("npiimport.err.xlsx_unreadable"),
                "import.no_file"          => T("npiimport.err.no_file"),
                _                          => apiEx.ApiError.MessageEn,
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
