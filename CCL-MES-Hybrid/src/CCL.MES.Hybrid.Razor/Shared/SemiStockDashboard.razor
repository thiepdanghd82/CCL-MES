@*
    P11.5-3 — Kho bán thành phẩm (semi-stock warehouse) — REDESIGN chuyên nghiệp.

    Tầng trình bày: KPI stat-cards + toolbar lọc/search + data-grid (sticky
    head, zebra, progress-bar tồn, status pill, đếm ngược hạn) + nhập kho =
    <Modal> (L34 transactional) + row action = <RowContextMenu> (L35). Backend
    + hợp đồng dữ liệu GIỮ NGUYÊN: GetSemiLotsAsync / PostSemiLotAsync.

    Rule 4: plain <button>/<input>/<select>. L37: màu qua design token (scoped
    .razor.css). S9: container-query desktop grid ↔ mobile card-stack.
    Banner qua SemiStockErrorLocaliser (wording locked — không đổi chuỗi).
*@
@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.Routing
@using CCL.MES.Shared.Envelopes
@using CCL.MES.Shared.Routing
@inject ICclApiClient Api

<div class="semi-dashboard" data-testid="semi-dashboard">

    @* ── 1. HEADER + KPI stat-cards ─────────────────────────────── *@
    <div class="semi-header">
        <div class="semi-title-wrap">
            <span class="semi-ico-hdr">@Ico("box", 22)</span>
            <div>
                <h2 class="semi-title">@T("semi.title")</h2>
                <p class="semi-subtitle">@T("semi.subtitle")</p>
            </div>
        </div>
    </div>

    <div class="semi-kpis" data-testid="semi-totals">
        <div class="semi-kpi semi-kpi-ok">
            <div class="semi-kpi-top"><span class="semi-kpi-ico">@Ico("check", 15)</span><span class="semi-kpi-label">@T("semi.kpi.available")</span></div>
            <div class="semi-kpi-num" data-testid="semi-kpi-available">@(_view?.TotalAvailable.ToString() ?? "—")</div>
            <div class="semi-kpi-sub">@T("semi.kpi.available.sub")</div>
        </div>
        <div class="semi-kpi semi-kpi-hold">
            <div class="semi-kpi-top"><span class="semi-kpi-ico">@Ico("lock", 15)</span><span class="semi-kpi-label">@T("semi.kpi.reserved")</span></div>
            <div class="semi-kpi-num" data-testid="semi-kpi-reserved">@(_view?.TotalReserved.ToString() ?? "—")</div>
            <div class="semi-kpi-sub">@T("semi.kpi.reserved.sub")</div>
        </div>
        <div class="semi-kpi @(ExpiringCount > 0 ? "semi-kpi-warn" : "semi-kpi-muted")">
            <div class="semi-kpi-top"><span class="semi-kpi-ico">@Ico("clock", 15)</span><span class="semi-kpi-label">@T("semi.kpi.expiring")</span></div>
            <div class="semi-kpi-num" data-testid="semi-kpi-expiring">@(_view is null ? "—" : ExpiringCount.ToString())</div>
            <div class="semi-kpi-sub">@T("semi.kpi.expiring.sub")</div>
        </div>
        <div class="semi-kpi semi-kpi-total">
            <div class="semi-kpi-top"><span class="semi-kpi-ico">@Ico("box", 15)</span><span class="semi-kpi-label">@T("semi.kpi.count")</span></div>
            <div class="semi-kpi-num" data-testid="semi-kpi-count">@(_view is null ? "—" : _view.Lots.Count.ToString())</div>
            <div class="semi-kpi-sub">@T("semi.kpi.count.sub")</div>
        </div>
    </div>

    @* ── 2. TOOLBAR (lọc + search + actions) ────────────────────── *@
    <div class="semi-toolbar" data-testid="semi-filters">
        @* Segmented chip-buttons thay <select> native: WKWebView native picker
           kẹt sau re-render (mọi biến thể <select> đều lỗi). <button> KHÔNG có
           picker → không thể kẹt (pattern MachineDashboard). Lọc client-side. *@
        <div class="semi-filter">
            <span>@T("semi.filter.kind")</span>
            <div class="semi-seg" data-testid="semi-filter-kind" role="group" aria-label="@T("semi.filter.kind.aria")">
                @foreach (var opt in KindOptions)
                {
                    <button type="button" class="semi-seg-btn @(_filterKind == opt.Val ? "is-on" : "")"
                            data-testid="@($"semi-kind-{(opt.Val == "" ? "all" : opt.Val)}")"
                            aria-pressed="@(_filterKind == opt.Val)"
                            @onclick="() => _filterKind = opt.Val">@T(opt.Key)</button>
                }
            </div>
        </div>
        <div class="semi-filter">
            <span>@T("semi.filter.status")</span>
            <div class="semi-seg" data-testid="semi-filter-status" role="group" aria-label="@T("semi.filter.status.aria")">
                @foreach (var opt in StatusOptions)
                {
                    <button type="button" class="semi-seg-btn @(_filterStatus == opt.Val ? "is-on" : "")"
                            data-testid="@($"semi-status-{(opt.Val == "" ? "all" : opt.Val)}")"
                            aria-pressed="@(_filterStatus == opt.Val)"
                            @onclick="() => _filterStatus = opt.Val">@T(opt.Key)</button>
                }
            </div>
        </div>
        <label class="semi-filter semi-filter-search">
            <span>@T("semi.filter.search")</span>
            <input type="search" class="semi-input" data-testid="semi-search" placeholder="@T("semi.filter.search.ph")"
                   @bind="_search" @bind:event="oninput" />
        </label>
        <div class="semi-toolbar-spacer"></div>
        <button type="button" class="btn btn-ghost semi-refresh" data-testid="semi-refresh"
                disabled="@_busy" @onclick="ReloadAsync">↻ @T("semi.reload")</button>
        <button type="button" class="btn btn-primary semi-add-toggle" data-testid="semi-add-toggle"
                @onclick="OpenAdd">＋ @T("semi.add")</button>
    </div>

    @if (_banner is not null)
    {
        <div class="wo-card-error" data-testid="semi-banner">@_banner</div>
    }

    @* ── 4. DATA GRID / states ──────────────────────────────────── *@
    @if (_view is null && _initialError is null)
    {
        <div class="semi-skeleton" data-testid="semi-loading" aria-busy="true">
            @for (var i = 0; i < 5; i++)
            {
                <div class="semi-skel-row"></div>
            }
        </div>
    }
    else if (_initialError is not null)
    {
        <div class="wo-card-error" data-testid="semi-initial-error">
            <strong>@T("semi.load.failed")</strong> @_initialError
        </div>
    }
    else if (_view is not null)
    {
        @if (_view.Lots.Any(l => l.Expiring))
        {
            <div class="semi-expiry-banner" data-testid="semi-expiry-banner">
                <span class="semi-expiry-ico">@Ico("clock", 16)</span>
                @T("semi.expiry.banner", ExpiringCount)
            </div>
        }

        @if (FilteredLots() is var rows && rows.Count == 0)
        {
            <div class="semi-empty" data-testid="semi-empty">
                <div class="semi-empty-ico">@Ico("box", 44)</div>
                <div class="semi-empty-title">@T("semi.empty.title")</div>
                <div class="semi-empty-sub">@T("semi.empty.sub")</div>
                <button type="button" class="btn btn-primary" @onclick="OpenAdd">＋ @T("semi.add")</button>
            </div>
        }
        else
        {
            <div class="semi-table-wrap">
                <table class="semi-table" data-testid="semi-table">
                    <thead>
                        <tr>
                            <th>@T("semi.col.lotno")</th><th>@T("semi.col.kind")</th><th>@T("semi.col.spec")</th><th>@T("semi.col.sourcewo")</th>
                            <th class="semi-num">@T("semi.col.produced")</th><th class="semi-num">@T("semi.col.available")</th><th class="semi-num">@T("semi.col.reserved")</th>
                            <th class="semi-col-fill">@T("semi.col.stock")</th>
                            <th>@T("semi.col.status")</th><th>@T("semi.col.expiry")</th>
                            <th class="semi-kebab-col" aria-label="@T("semi.col.actions")"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lot in rows)
                        {
                            <tr class="semi-row @(lot.Expiring ? "semi-row-expiring" : "")" data-testid="semi-row-@lot.Id"
                                @oncontextmenu="e => OpenMenuAt(lot, e.ClientX, e.ClientY)" @oncontextmenu:preventDefault="true"
                                @onpointerdown="e => LongPressStart(lot, e)" @onpointerup="LongPressCancel"
                                @onpointerleave="LongPressCancel" @onpointermove="LongPressCancel">
                                <td class="semi-lotno">@lot.LotNo</td>
                                <td><span class="semi-kind-tag">@KindLabel(lot.SemiKind)</span></td>
                                <td class="semi-dim">@(lot.SpecRevisionId?.ToString() ?? "—")</td>
                                <td class="semi-dim">#@lot.SourceWorkOrderId</td>
                                <td class="semi-num">@lot.QtyProduced</td>
                                <td class="semi-num semi-num-ok">@lot.QtyAvailable</td>
                                <td class="semi-num semi-num-hold">@lot.QtyReserved</td>
                                <td class="semi-col-fill">
                                    <div class="semi-bar" title="@T("semi.bar.title", lot.QtyAvailable, lot.QtyReserved, lot.QtyProduced)">
                                        <span class="semi-bar-avail" style="width:@Pct(lot.QtyAvailable, lot.QtyProduced)%"></span>
                                        <span class="semi-bar-hold" style="width:@Pct(lot.QtyReserved, lot.QtyProduced)%"></span>
                                    </div>
                                </td>
                                <td><span class="semi-status semi-status-@lot.Status.ToLowerInvariant()">@StatusLabel(lot.Status)</span></td>
                                <td class="@(lot.Expiring ? "semi-expiry-cell semi-expiry-hot" : "semi-expiry-cell")">
                                    <span class="semi-expiry-text">@ExpiryCountdown(lot.ExpiryAt)</span>
                                    @if (lot.Expiring)
                                    {
                                        <span class="semi-expiring-tag" data-testid="semi-expiring-@lot.Id">FEFO</span>
                                    }
                                </td>
                                <td class="semi-kebab-col">
                                    <button type="button" class="row-kebab" data-fw-nodrag data-testid="semi-kebab-@lot.Id"
                                            @onclick="e => OpenMenuAt(lot, e.ClientX, e.ClientY)" @onclick:stopPropagation="true"
                                            aria-haspopup="menu" aria-label="@T("semi.actions")" title="@T("semi.actions")">⋯</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@* ── Row action menu (right-click / long-press / kebab → 1 menu) ── *@
<RowContextMenu Open="_menuLot is not null" Anchor="_menuAnchor" Items="_menuItems"
                AriaLabel="@T("semi.menu.aria", _menuLot?.LotNo ?? "")" OnClose="CloseMenu" />

@* ── Nhập kho = Modal transactional (L34) ───────────────────────── *@
<Modal Open="_showAdd" OnClose="CloseAdd" Size="ModalSize.Md" Severity="ModalSeverity.Info">
    <Header>@T("semi.add.title")</Header>
    <Body>
        <div class="semi-add-form" data-testid="semi-add-form">
            <label class="semi-field semi-field-scan">
                <span class="semi-field-lbl"><span class="semi-scan-ico">@Ico("barcode", 15)</span> @T("semi.add.lotno")</span>
                <input type="text" class="semi-input semi-input-scan" data-testid="semi-add-lotno" maxlength="80"
                       autofocus placeholder="@T("semi.add.lotno.ph")" @bind="_addLotNo" @bind:event="oninput" />
            </label>
            <div class="semi-add-grid">
                <label class="semi-field">
                    <span class="semi-field-lbl">@T("semi.add.kind")</span>
                    <select class="semi-select" data-testid="semi-add-kind" @bind="_addKind">
                        <option value="PRINTED_SEMI">@T("semi.add.kind.printed")</option>
                        <option value="TAPE_SEMI">@T("semi.add.kind.tape")</option>
                    </select>
                </label>
                <label class="semi-field">
                    <span class="semi-field-lbl">@T("semi.add.qty")</span>
                    <input type="number" min="1" class="semi-input" data-testid="semi-add-qty" @bind="_addQty" />
                </label>
                <label class="semi-field">
                    <span class="semi-field-lbl">@T("semi.add.source")</span>
                    <input type="number" min="0" class="semi-input" data-testid="semi-add-source" @bind="_addSourceWoId" />
                </label>
                <label class="semi-field">
                    <span class="semi-field-lbl">@T("semi.add.spec")</span>
                    <input type="number" min="0" class="semi-input" data-testid="semi-add-spec" @bind="_addSpecId" />
                </label>
                <label class="semi-field semi-field-wide">
                    <span class="semi-field-lbl">@T("semi.add.expiry")</span>
                    <input type="date" class="semi-input" data-testid="semi-add-expiry" @bind="_addExpiry" />
                </label>
            </div>
        </div>
    </Body>
    <Footer>
        <button type="button" class="op-btn op-btn-secondary" @onclick="CloseAdd">@T("semi.cancel")</button>
        <button type="button" class="op-btn op-btn-primary" data-testid="semi-add-submit"
                disabled="@(_busy || string.IsNullOrWhiteSpace(_addLotNo) || _addQty <= 0)"
                @onclick="SubmitLotAsync">@T("semi.add.submit")</button>
    </Footer>
</Modal>

@* ── Genealogy (WO nguồn) — Modal info read-only ────────────────── *@
<Modal Open="_genealogy is not null" OnClose="() => _genealogy = null" Size="ModalSize.Sm" Severity="ModalSeverity.Info">
    <Header>@T("semi.genea.title")</Header>
    <Body>
        @if (_genealogy is not null)
        {
            <dl class="semi-genea" data-testid="semi-genealogy">
                <dt>@T("semi.genea.lotno")</dt><dd class="semi-lotno">@_genealogy.LotNo</dd>
                <dt>@T("semi.genea.kind")</dt><dd>@KindLabel(_genealogy.SemiKind)</dd>
                <dt>@T("semi.genea.sourcewo")</dt><dd>#@_genealogy.SourceWorkOrderId</dd>
                <dt>@T("semi.genea.spec")</dt><dd>@(_genealogy.SpecRevisionId?.ToString() ?? "—")</dd>
                <dt>@T("semi.genea.qtys")</dt><dd>@_genealogy.QtyProduced / @_genealogy.QtyAvailable / @_genealogy.QtyReserved</dd>
                <dt>@T("semi.genea.expiry")</dt><dd>@(_genealogy.ExpiryAt?.ToString("yyyy-MM-dd") ?? "—") · @ExpiryCountdown(_genealogy.ExpiryAt)</dd>
            </dl>
        }
    </Body>
    <Footer>
        <button type="button" class="op-btn op-btn-primary" @onclick="() => _genealogy = null">@T("semi.close")</button>
    </Footer>
</Modal>

@code {
    private SemiStockView? _view;
    private string? _initialError;
    private string? _banner;
    private bool _busy;
    private bool _loaded;

    private string _filterKind = "";
    private string _filterStatus = "";
    private string _search = "";
    // Monotonic reload token: response cũ đến sau KHÔNG ghi đè filter mới hơn
    // (đổi filter liên tiếp nhanh). Không khoá/disable select.
    private int _reloadSeq;

    // Nhập kho modal
    private bool _showAdd;
    private string _addLotNo = "";
    private string _addKind = "PRINTED_SEMI";
    private int _addQty = 0;
    private long _addSourceWoId = 0;
    private long _addSpecId = 0;
    private DateTime? _addExpiry;

    // Row action menu
    private SemiLotRow? _menuLot;
    private (double X, double Y) _menuAnchor;
    private (double X, double Y) _pressAt;
    private IReadOnlyList<ContextMenuItem> _menuItems = System.Array.Empty<ContextMenuItem>();
    private System.Threading.Timer? _longPress;

    // Genealogy modal
    private SemiLotRow? _genealogy;

    private int ExpiringCount => _view?.Lots.Count(l => l.Expiring) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        if (_loaded) return;
        _loaded = true;
        await ReloadAsync();
    }

    // Lọc CLIENT-SIDE (kind + status + search) — pattern MachineDashboard.
    // Đổi filter KHÔNG gọi GET/await → không có re-render async giữa change-event
    // của <select> native trong WKWebView → hết đóng băng. GET chỉ tải toàn bộ
    // kho (initial / Tải lại / sau nhập lô).
    private List<SemiLotRow> FilteredLots()
    {
        if (_view is null) return new();
        var q = _view.Lots.AsEnumerable();
        if (!string.IsNullOrEmpty(_filterKind))
            q = q.Where(l => string.Equals(l.SemiKind, _filterKind, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_filterStatus))
            q = q.Where(l => string.Equals(l.Status, _filterStatus, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(l => l.LotNo.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
        return q.ToList();
    }

    // Chip-buttons thay <select> native → đổi filter là @onclick set field
    // (client-side). Không native picker → re-render không xung đột → không kẹt.
    private static readonly (string Val, string Key)[] KindOptions =
    {
        ("", "semi.opt.all"), ("PRINTED_SEMI", "semi.opt.printed"), ("TAPE_SEMI", "semi.opt.tape"),
    };
    private static readonly (string Val, string Key)[] StatusOptions =
    {
        ("", "semi.opt.all"), ("AVAILABLE", "semi.status.available"), ("DEPLETED", "semi.status.depleted"), ("EXPIRED", "semi.status.expired"),
    };

    private async Task ReloadAsync()
    {
        var seq = ++_reloadSeq;
        _busy = true; _banner = null;
        try
        {
            // Tải TOÀN BỘ kho (lọc kind/status/search làm client-side).
            var view = await Api.GetSemiLotsAsync();
            if (seq != _reloadSeq) return;   // reload mới hơn đã chạy → bỏ kết quả cũ
            _view = view;                    // KHÔNG set _view=null trước đó → bảng cũ giữ tới khi có data mới
            _initialError = null;
        }
        catch (ApiException ex) { if (seq == _reloadSeq) _initialError = SemiStockErrorLocaliser.LocaliseApiError(ex.StatusCode, ex.ApiError); }
        catch (Exception ex) { if (seq == _reloadSeq) _initialError = ex.Message; }
        finally { if (seq == _reloadSeq) _busy = false; }
    }

    private void OpenAdd()
    {
        _banner = null;
        _showAdd = true;
    }
    private void CloseAdd() => _showAdd = false;

    private async Task SubmitLotAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_addLotNo) || _addQty <= 0) return;
        _busy = true; _banner = null;
        try
        {
            var resp = await Api.PostSemiLotAsync(new PostSemiLotRequest
            {
                LotNo = _addLotNo.Trim(),
                SemiKind = _addKind,
                Qty = _addQty,
                SourceWorkOrderId = _addSourceWoId,
                SpecRevisionId = _addSpecId > 0 ? _addSpecId : null,
                ExpiryAt = _addExpiry,
            });
            if (resp.Ok)
            {
                _addLotNo = ""; _addQty = 0; _addExpiry = null; _showAdd = false;
                await ReloadAsync();
            }
            else { _banner = SemiStockErrorLocaliser.LocaliseSetError(resp.ErrorCode ?? ""); }
        }
        catch (ApiException ex) { _banner = SemiStockErrorLocaliser.LocaliseApiError(ex.StatusCode, ex.ApiError); }
        catch (Exception ex) { _banner = ex.Message; }
        finally { _busy = false; }
    }

    // ── Row action menu (right-click / long-press / kebab) ─────────
    private void OpenMenuAt(SemiLotRow lot, double x, double y)
    {
        _menuLot = lot;
        _menuAnchor = (x, y);
        _menuItems = new[]
        {
            new ContextMenuItem { Label = T("semi.menu.viewwo"), Icon = "⤴", OnClick = EventCallback.Factory.Create(this, () => OpenGenealogy(lot)) },
        };
    }
    private void CloseMenu() => _menuLot = null;
    private void OpenGenealogy(SemiLotRow lot) { _menuLot = null; _genealogy = lot; }

    private void LongPressStart(SemiLotRow lot, PointerEventArgs e)
    {
        if (e.Button != 0) return;
        _pressAt = (e.ClientX, e.ClientY);
        _longPress?.Dispose();
        _longPress = new System.Threading.Timer(
            _ => InvokeAsync(() => { OpenMenuAt(lot, _pressAt.X, _pressAt.Y); StateHasChanged(); }),
            null, 500, System.Threading.Timeout.Infinite);
    }
    private void LongPressCancel() { _longPress?.Dispose(); _longPress = null; }

    public override void Dispose()
    {
        _longPress?.Dispose();
        base.Dispose();
    }

    // ── Presentation helpers ───────────────────────────────────────
    private static int Pct(int part, int whole) => whole <= 0 ? 0 : (int)Math.Round(100.0 * part / whole);

    /// <summary>Đếm ngược tương đối theo UTC (khớp cờ Expiring server = +7d).</summary>
    private string ExpiryCountdown(DateTime? expiry)
    {
        if (expiry is null) return "—";
        var days = (expiry.Value.Date - DateTime.UtcNow.Date).Days;
        if (days < 0) return T("semi.expiry.overdue", -days);
        if (days == 0) return T("semi.expiry.today");
        return T("semi.expiry.remaining", days);
    }

    private string KindLabel(string kind) => kind switch
    {
        "PRINTED_SEMI" => T("semi.opt.printed"),
        "TAPE_SEMI"    => T("semi.opt.tape"),
        _              => kind,
    };

    private string StatusLabel(string status) => status switch
    {
        "AVAILABLE" => T("semi.status.available"),
        "DEPLETED"  => T("semi.status.depleted"),
        "EXPIRED"   => T("semi.status.expired"),
        _           => status,
    };

    // Inline line icons (Feather-style, stroke=currentColor → inherit màu token).
    // Kích thước qua INLINE style (px) — scoped .razor.css KHÔNG áp được cho
    // <svg> sinh từ MarkupString (thiếu scope attribute), nên phải nhúng size
    // trực tiếp, nếu không SVG nở kín container (L: giant-icon bug).
    private static MarkupString Ico(string name, int px = 16)
    {
        var p = name switch
        {
            "box"     => "<path d='M3 7.5 12 3l9 4.5-9 4.5z'/><path d='M3 7.5V17l9 4.5V12'/><path d='M21 7.5V17l-9 4.5'/>",
            "check"   => "<path d='M20 6 9 17l-5-5'/>",
            "lock"    => "<rect x='5' y='11' width='14' height='9' rx='2'/><path d='M8 11V8a4 4 0 0 1 8 0v3'/>",
            "clock"   => "<circle cx='12' cy='12' r='9'/><path d='M12 7v5l3.5 2'/>",
            "barcode" => "<path d='M4 6v12M7 6v12M10 6v12M13 6v12M16 6v12M20 6v12'/>",
            _         => "",
        };
        return new MarkupString(
            $"<svg width='{px}' height='{px}' viewBox='0 0 24 24' fill='none' stroke='currentColor' " +
            $"stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' " +
            $"style='width:{px}px;height:{px}px;display:block;flex:none'>{p}</svg>");
    }
}
