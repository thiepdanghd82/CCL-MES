@*
    P10.7b-3 — PREPRESS operator dashboard.

    Hosted inside WorkOrders.razor when the scanned/looked-up WO has
    MesPhase=PREPRESS (or NEW, which the §5.2 contract treats as the
    pre-PREPRESS entry surface). Owns the entire PrepressView state +
    every API call that mutates it. Three child components are
    prop-driven + emit EventCallbacks; this parent does the wire work.

    Concurrency / error handling:
      - Every PUT returns the bumped ETag in PrepressSetResponse.
        On Ok=true we refetch the whole view (cheap; serialises
        cascade with the SQLite write-lock) so audit-touched fields
        (CheckedBy/CheckedAt) surface.
      - On Ok=false + ErrorCode="wo.state_conflict" the response
        carries the fresh ETag — we refetch + show a banner so the
        operator can retry. (Pattern parallels WorkOrders.razor /
        AdvanceOrchestrator outcomes.)
      - On 422 (invalid_phase / invalid_status / invalid_reason_code /
        invalid_ng_note) the server's ApiError code surfaces via
        PrepressErrorLocaliser → a sticky banner above the dashboard.
        invalid_phase additionally collapses the row UI to "WO không ở
        PREPRESS — quay lại Work Orders" because no further writes
        will succeed until the WO is in the right phase.

    The Advance button is gated on view.MaterialsReady (server-
    computed rollup). The actual phase transition is bubbled up to
    WorkOrders.razor's existing AdvanceOrchestrator via OnAdvanceRequested
    so the success-banner UX from 7a-1.4 still fires.

    Rule 4: plain <input>, NO <InputText>. The 3 children honour the
    same rule; this parent has no form fields at all (just buttons +
    banners) so no input renderer concerns.
*@

@using System.Linq
@using Microsoft.AspNetCore.Components.Web
@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.Hardware
@using CCL.MES.Hybrid.Client.Prepress
@using CCL.MES.Hybrid.Client.RecentScans
@using CCL.MES.Shared.Devices
@using CCL.MES.Shared.Envelopes
@using CCL.MES.Shared.Prepress
@using CCL.MES.Shared.ReasonCodes
@using CCL.MES.Shared.RecentScans
@inject ICclApiClient Api
@inject IRecentScansService RecentScans
@inject Microsoft.Extensions.Options.IOptions<HardwareOptions> HwOptions
@implements IDisposable

<div class="prepress-dashboard" data-testid="prepress-dashboard">
    @if (_view is null && _initialError is null)
    {
        <div class="prepress-loading" data-testid="prepress-loading">
            Loading PREPRESS checklist…
        </div>
    }
    else if (_initialError is not null)
    {
        <div class="wo-card-error" data-testid="prepress-initial-error">
            <strong>Could not load PREPRESS checklist:</strong> @_initialError
        </div>
    }
    else if (_invalidPhase)
    {
        <div class="wo-card-error" data-testid="prepress-invalid-phase">
            <strong>WO is not in the PREPRESS phase</strong> —
            Current: <code>@(_view?.MesPhase ?? "?")</code>.
            Go back to the Work Orders tab to select another WO.
        </div>
    }
    else if (_view is not null)
    {
        <div class="prepress-head">
            <div class="prepress-head-wo">
                <span class="prepress-head-label">WO</span>
                <span class="prepress-head-wo-no">@_view.WoNo</span>
                <span class="prepress-head-phase">@_view.MesPhase</span>
            </div>
            <div class="prepress-head-rollup" data-testid="prepress-rollup-pill">
                @if (_view.MaterialsReady)
                {
                    <span class="prepress-pill prepress-pill-ok">Materials Ready ✓</span>
                }
                else
                {
                    <span class="prepress-pill prepress-pill-pending">Materials not ready</span>
                }
            </div>
        </div>

        @if (_setError is not null)
        {
            <div class="wo-card-error" data-testid="prepress-set-error">
                <strong>Could not save change:</strong> @_setError
                <button type="button" class="op-btn op-btn-secondary op-btn-sm"
                        @onclick="DismissSetError"
                        data-testid="prepress-set-error-dismiss">
                    Dismiss
                </button>
            </div>
        }

        @if (_scrapReasons.Count == 0 && !_reasonsLoading)
        {
            <div class="wo-card-error" data-testid="prepress-reasons-empty">
                <strong>NG defect code catalog is empty.</strong>
                The server has not seeded reason codes (kind=Scrap). Report to IT —
                restart the API to run the boot probe
                <code>[seed] reason_codes</code>; only OK can be recorded until this is fixed.
            </div>
        }

        @if (HwOptions.Value.ScanEnabled)
        {
            <div class="prepress-scan-bar" data-testid="prepress-scan-bar">
                <label class="prepress-scan-label" for="prepress-scan-input">Scan material</label>
                <input id="prepress-scan-input"
                       type="text"
                       class="prepress-scan-input"
                       data-testid="prepress-scan-input"
                       placeholder="Point the scanner at a material label, then it auto-matches…"
                       value="@_scanInput"
                       @oninput="OnScanInput"
                       @onchange="OnScanCommitted"
                       @onkeydown="OnScanKeyDown"
                       disabled="@_busy"
                       autocomplete="off"
                       autofocus />
                <span class="prepress-scan-count" data-testid="prepress-scan-count">
                    @MaterialsOkCount/@_view.Materials.Count materials OK
                </span>
                @if (_scanStatus is not null)
                {
                    <span class="prepress-scan-status" data-testid="prepress-scan-status">@_scanStatus</span>
                }
            </div>
        }

        <WoMaterialsList Materials="_view.Materials"
                         Busy="_busy"
                         ScrapReasons="_scrapReasons"
                         ScannedByRow="_scannedByRow"
                         OnSetMaterial="OnSetMaterial"
                         OnPartScanInput="OnPartScanInput"
                         OnPartScanCommit="OnPartScanCommit"
                         OnSpecialAccept="OnSpecialAccept" />

        <WoPlateCheck Row="_view.PlateCheck"
                      Busy="_busy"
                      ScrapReasons="_scrapReasons"
                      OnSetPlate="OnSetPlate" />

        <WoCutterCheck Row="_view.CutterCheck"
                       Busy="_busy"
                       ScrapReasons="_scrapReasons"
                       OnSetCutter="OnSetCutter" />

        <div class="prepress-advance-bar">
            <button type="button"
                    class="op-btn op-btn-primary prepress-advance-btn"
                    data-testid="prepress-advance-btn"
                    disabled="@(!_view.MaterialsReady || _busy)"
                    @onclick="OnAdvanceClicked">
                Start Setting (advance step)
            </button>
            @if (!_view.MaterialsReady)
            {
                <span class="prepress-advance-hint" data-testid="prepress-advance-hint">
                    Complete all 3 checklists (Material + Plate + Cutter) → this button becomes active.
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public long WorkOrderId { get; set; }
    [Parameter] public EventCallback OnAdvanceRequested { get; set; }

    private PrepressView? _view;
    private string? _initialError;
    private string? _setError;
    private bool _busy;
    private bool _invalidPhase;
    private long _lastLoadedWoId;

    private IReadOnlyList<ReasonCodeOption> _scrapReasons = Array.Empty<ReasonCodeOption>();
    private bool _reasonsLoading;

    private string _scanInput = string.Empty;
    private string? _scanStatus;

    // Per-row scanned data (BomLineIdx → part + description + manual flag)
    // shown in the "Part Scan" / "Part Description" columns. Manual=true when
    // the operator typed it by hand (rendered dark purple). Survives reload.
    private readonly Dictionary<int, (string Part, string Desc, bool Manual)> _scannedByRow = new();

    private int MaterialsOkCount =>
        _view?.Materials.Count(m => string.Equals(m.Status, "Ok", StringComparison.OrdinalIgnoreCase)) ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        if (WorkOrderId != _lastLoadedWoId)
        {
            _lastLoadedWoId = WorkOrderId;
            _view = null;
            _initialError = null;
            _setError = null;
            _invalidPhase = false;
            _scanStatus = null;
            _scanInput = string.Empty;
            _scannedByRow.Clear();
            await LoadScrapReasonsAsync();
            await ReloadAsync();
        }
    }

    private async Task LoadScrapReasonsAsync()
    {
        _reasonsLoading = true;
        try
        {
            _scrapReasons = await Api.GetReasonCodesAsync("Scrap");
        }
        catch (ApiException)
        {
            _scrapReasons = Array.Empty<ReasonCodeOption>();
        }
        catch (HttpRequestException)
        {
            _scrapReasons = Array.Empty<ReasonCodeOption>();
        }
        catch (Exception)
        {
            _scrapReasons = Array.Empty<ReasonCodeOption>();
        }
        finally
        {
            _reasonsLoading = false;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _view = await Api.GetPrepressViewAsync(WorkOrderId);
            _invalidPhase = !(_view.MesPhase == "PREPRESS" || _view.MesPhase == "NEW");
        }
        catch (ApiException apiEx)
        {
            _initialError = PrepressErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (HttpRequestException ex)
        {
            _initialError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _initialError = $"Error loading checklist: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private async Task OnSetMaterial(WoMaterialsList.MaterialSetIntent intent)
    {
        if (_view is null) return;
        await GuardedPutAsync(async ifMatch =>
            await Api.PutPrepressMaterialAsync(
                WorkOrderId, intent.BomLineIdx, ifMatch,
                new SetPrepressMaterialRequest
                {
                    Status = intent.Status,
                    QtyLoaded = intent.QtyLoaded,
                    LotNo = intent.LotNo,
                    NgReasonCode = intent.NgReasonCode,
                    NgNote = intent.NgNote,
                }));
    }

    // Manual entry into a row's Part Scan cell (special-accept case) — flag
    // Manual=true so the columns render dark purple.
    private void OnPartScanInput((int BomLineIdx, string Value) arg)
    {
        var desc = _scannedByRow.TryGetValue(arg.BomLineIdx, out var prev) ? prev.Desc : string.Empty;
        _scannedByRow[arg.BomLineIdx] = (arg.Value, desc, true);
    }

    // Manual Part Scan committed (scanner-down fallback). Validate against THIS
    // row's own code: exact match → auto-OK like a real scan; mismatch → leave
    // it (purple) + tell the operator to use Special Accept.
    private async Task OnPartScanCommit((int BomLineIdx, string Value) arg)
    {
        if (_view is null) return;
        var row = _view.Materials.FirstOrDefault(m => m.BomLineIdx == arg.BomLineIdx);
        if (row is null) return;

        var part = MaterialBarcodeMatcher.ExtractPartNo(arg.Value);
        _scannedByRow[arg.BomLineIdx] =
            (part, MaterialBarcodeMatcher.ExtractDescription(arg.Value), true);   // manual → purple
        if (part.Length == 0) return;

        if (string.Equals(part, (row.MaterialCode ?? "").Trim(), StringComparison.OrdinalIgnoreCase))
        {
            if (!string.Equals(row.Status, "Ok", StringComparison.OrdinalIgnoreCase))
                await OnSetMaterial(new WoMaterialsList.MaterialSetIntent
                {
                    BomLineIdx = row.BomLineIdx,
                    Status = "Ok",
                });
            if (_setError is null)
                _scanStatus = PrepressErrorLocaliser.ScanRecordedOk(row.MaterialCode ?? "");
        }
        else
        {
            _scanStatus = PrepressErrorLocaliser.ScanMismatch(part, row.MaterialCode ?? "");
        }
    }

    private async Task OnSpecialAccept(WoMaterialsList.SpecialAcceptIntent intent)
    {
        if (_view is null) return;
        await GuardedPutAsync(async ifMatch =>
            await Api.SpecialAcceptMaterialAsync(
                WorkOrderId, intent.BomLineIdx, ifMatch,
                new SpecialAcceptMaterialRequest
                {
                    NgReasonCode = intent.NgReasonCode,
                    Note = intent.NgNote,
                    PartScan = intent.PartScan,
                }));
    }

    private async Task OnSetPlate(WoPlateCheck.PlateSetIntent intent)
    {
        if (_view is null) return;
        await GuardedPutAsync(async ifMatch =>
            await Api.PutPrepressPlateAsync(
                WorkOrderId, ifMatch,
                new SetPrepressPlateRequest
                {
                    Status = intent.Status,
                    PlateNo = intent.PlateNo,
                    NgReasonCode = intent.NgReasonCode,
                    NgNote = intent.NgNote,
                }));
    }

    private async Task OnSetCutter(WoCutterCheck.CutterSetIntent intent)
    {
        if (_view is null) return;
        await GuardedPutAsync(async ifMatch =>
            await Api.PutPrepressCutterAsync(
                WorkOrderId, ifMatch,
                new SetPrepressCutterRequest
                {
                    Status = intent.Status,
                    CutterNo = intent.CutterNo,
                    NgReasonCode = intent.NgReasonCode,
                    NgNote = intent.NgNote,
                }));
    }

    private async Task GuardedPutAsync(Func<string, Task<PrepressSetResponse>> doPut)
    {
        if (_view is null) return;
        _busy = true;
        _setError = null;
        try
        {
            var ifMatch = _view.ETag;
            var resp = await doPut(ifMatch);

            if (resp.Ok)
            {
                await ReloadAsync();
            }
            else if (!string.IsNullOrEmpty(resp.ErrorCode))
            {
                _setError = PrepressErrorLocaliser.LocaliseSetError(resp.ErrorCode);
                await ReloadAsync();
            }
            else
            {
                _setError = "Server returned Ok=false without an error code — report to IT.";
            }
        }
        catch (ApiException apiEx)
        {
            _setError = PrepressErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase")
            {
                _invalidPhase = true;
            }
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = $"Could not connect to the server: {ex.Message}";
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnAdvanceClicked()
    {
        if (_view is null || !_view.MaterialsReady) return;
        await OnAdvanceRequested.InvokeAsync();
    }

    private void DismissSetError() => _setError = null;

    public void Dispose() => _scanDebounce?.Dispose();

    // ── Scan materials (PREPRESS) — USB wedge (Zebra DS2208) ────────────
    // The DS2208 runs HID keyboard-wedge by default: it types the barcode
    // into the focused field + an Enter suffix. So the scan UX is a single
    // always-focused <input>; on Enter we match the payload against THIS
    // WO's BOM (MaterialBarcodeMatcher, exact part-no only) and auto-record
    // OK via the existing PUT path. No camera / no scanner SDK needed.
    // Wedge auto-submit: a Zebra DS2208 types the whole barcode in a burst
    // then stops. We don't rely on its Enter suffix reaching the WebView —
    // instead, 250 ms after the last keystroke we submit the buffer
    // automatically (the "auto xlookup" the operator expects). Manual typing
    // works too (submits after a pause); Enter/blur still submit instantly.
    private System.Threading.Timer? _scanDebounce;

    private void OnScanInput(ChangeEventArgs e)
    {
        _scanInput = e.Value?.ToString() ?? string.Empty;
        _scanDebounce?.Dispose();
        _scanDebounce = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(async () =>
            {
                try { await SubmitScanAsync(); }
                catch { /* never let a timer callback crash the renderer */ }
                StateHasChanged();
            });
        }, null, dueTime: 500, period: System.Threading.Timeout.Infinite);
    }

    private async Task OnScanKeyDown(KeyboardEventArgs e)
    {
        // DS2208 default suffix is Enter (CR). Tab also accepted in case a
        // station configured a Tab suffix.
        if (e.Key is not ("Enter" or "Tab")) return;
        await SubmitScanAsync();
    }

    // Fallback: fires when the field commits (Enter or blur) — covers a
    // scanner whose suffix keydown isn't surfaced to the WebView. Idempotent
    // with OnScanKeyDown because SubmitScanAsync clears the buffer first.
    private async Task OnScanCommitted(ChangeEventArgs e)
    {
        _scanInput = e.Value?.ToString() ?? _scanInput;
        await SubmitScanAsync();
    }

    private async Task SubmitScanAsync()
    {
        var code = _scanInput;
        _scanInput = string.Empty;          // clear for the next scan
        if (_view is null || string.IsNullOrWhiteSpace(code)) return;

        await LogMaterialScanAsync(code);   // best-effort forensic
        var match = MaterialBarcodeMatcher.Match(_view.Materials, code);

        if (match.Outcome != MaterialMatchOutcome.Single)
        {
            // AllOk / NoMatch / EmptyCode — nothing to confirm. On AllOk
            // (re-scan of a done part) still refresh the Part Scan/Description
            // columns so a complete re-scan corrects an earlier partial read.
            if (match.Outcome == MaterialMatchOutcome.AllOk && match.Row is not null)
                _scannedByRow[match.Row.BomLineIdx] = (match.PartNo, match.Description, false);
            _scanStatus = PrepressErrorLocaliser.ScanOutcomeMessage(match.Outcome, match.PartNo);
            RecordRecentScan(match.PartNo, resolved: match.Outcome == MaterialMatchOutcome.AllOk);
            return;
        }

        var row = match.Row!;   // first not-yet-OK line of that part
        // Sync the scanned data into the row's Part Scan / Part Description
        // columns BEFORE the PUT so the operator sees it land immediately.
        _scannedByRow[row.BomLineIdx] = (match.PartNo, match.Description, false);

        // Reuse the proven PUT path — GuardedPutAsync handles If-Match /
        // Idempotency-Key / ETag refresh / 409 retry + sets _setError on
        // failure.
        await OnSetMaterial(new WoMaterialsList.MaterialSetIntent
        {
            BomLineIdx = row.BomLineIdx,
            Status = "Ok",
        });

        var ok = _setError is null;
        if (ok)
            _scanStatus = PrepressErrorLocaliser.ScanRecordedOk(row.MaterialCode);
        // else: GuardedPutAsync already surfaced _setError + reloaded the view.
        RecordRecentScan(row.MaterialCode, resolved: ok);
    }

    private async Task LogMaterialScanAsync(string code)
    {
        // Forensic trail — best-effort; never block the operator.
        try
        {
            await Api.LogScanAsync(new ScanLogRequest
            {
                Payload = code,
                Format = "wedge",
                Context = "prepress-materials",
                SourceDeviceLabel = "DS2208",
                ClientTimestamp = DateTimeOffset.UtcNow,
            });
        }
        catch (Exception)
        {
            // ignored — audit is secondary to the operator's task
        }
    }

    private void RecordRecentScan(string code, bool resolved)
    {
        try
        {
            RecentScans.Record(new RecentScanEntry
            {
                Code = code,
                Format = "wedge",
                Context = "prepress-materials",
                ScannedAt = DateTime.UtcNow,
                ResolvedDisplay = code,
                ResolvedSubtitle = _view?.WoNo,
                Resolved = resolved,
            });
        }
        catch (Exception)
        {
            // ignored — a Preferences hiccup must not break scanning
        }
    }
}
