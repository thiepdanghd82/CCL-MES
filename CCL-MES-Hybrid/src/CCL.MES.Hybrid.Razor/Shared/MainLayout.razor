@inherits LayoutComponentBase
@using CCL.MES.Hybrid.Client.Windows
@using CCL.MES.Hybrid.Razor.Pages
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IWindowManager WM
@inject IWindowRegistry Registry
@inject IFloatingWindowStore RectStore
@inject NavigationManager Nav
@inject CCL.MES.Hybrid.Client.Localization.ITranslator Loc
@implements IDisposable
@*
  Top-level layout. Sidebar nav on the left, content + connectivity
  banner stacked on the right. Carbon-style minimalism — operators care
  about the data not the chrome.

  P10.6a hotfix — <RendererCrashBoundary> wraps the route content so a
  render-time exception in a child page can't take the BlazorWebView
  dispatcher with it. <MacCatalystKeyboardFix> remains the always-on
  Tab+Enter focus workaround (dotnet/maui#13934).

  P2-PR1 — the .window-layer renders every OpenWindow the IWindowManager holds
  as a keep-alive floating window OVER @Body (the route surface stays the plain
  background in PR1; the empty-workspace background is PR2). @key = the window id
  + WM.Windows' stable OPEN order means an instance is never destroyed on focus
  or route change — its body state (counters, scroll, in-flight polls) survives.
  A minimized window keeps mounting (display:none via .is-min) with its cascaded
  WindowContext.IsActive=false so a polling body can pause. The taskbar sits
  full-width at the bottom; .window-layer leaves it room via padding-bottom.
*@

<div class="app-shell" data-rail="@(_railCollapsed ? "collapsed" : null)">
    <NavMenu RailCollapsed="_railCollapsed" OnToggleRail="ToggleRailAsync" />
    <main class="app-main">
        <TopBar />
        <ConnectivityBanner />
        <div class="app-content">
            <RendererCrashBoundary>
                @* P2-PR2 — when the URL resolves to a registered window key the
                   page renders ONCE inside its floating window (below), so @Body
                   is replaced by the empty-workspace background to avoid a
                   double-render. Deferred / non-window routes (e.g. /settings,
                   /qms/iqc, /workorders, /login) still render @Body normally. *@
                @if (_urlIsWindowRoute)
                {
                    <WorkspaceHome />
                }
                else
                {
                    @Body
                }
            </RendererCrashBoundary>
        </div>
    </main>

    @* Multi-window workspace layer — over @Body, under the taskbar. *@
    <div class="window-layer">
        @foreach (var w in WM.Windows)
        {
            <div class="window-host @(w.State == WindowState.Minimized ? "is-min" : null)"
                 style="z-index:@(100 + w.ZOrder)"
                 @key="w.Id">
                <RendererCrashBoundary>
                    <CascadingValue Value="new WindowContext { IsActive = w.State != WindowState.Minimized }" IsFixed="false">
                        <FloatingWindow WindowId="@w.Id"
                                        Title="@w.Title"
                                        AriaLabel="@w.Title"
                                        IsActive="@w.IsActive"
                                        Rect="RectStore.Get(w.Key)"
                                        OnRectChanged="r => RectStore.Save(w.Key, r)"
                                        OnClose="() => WM.Close(w.Id)"
                                        OnMinimizeRequested="() => WM.Minimize(w.Id)"
                                        OnMaximizeRequested="() => WM.Maximize(w.Id)"
                                        OnFocusRequested="() => WM.Focus(w.Id)">
                            <DynamicComponent Type="w.ContentType" Parameters="ToDict(w.Parameters)" />
                        </FloatingWindow>
                    </CascadingValue>
                </RendererCrashBoundary>
            </div>
        }
    </div>

    <Taskbar />
</div>
<MacCatalystKeyboardFix />

@code {
    // CCL iX nguyên tắc 5 — "khung là hằng số": rail KHÔNG tự đổi độ rộng.
    // Thu gọn chỉ xảy ra khi người dùng bấm, và lựa chọn đó được nhớ lại
    // (localStorage qua cclMesDensity.railGet/railSet — dùng chung cơ chế với
    // mật độ hiển thị thay vì dựng thêm một preference service).
    private bool _railCollapsed;

    // P2-PR2 — true while the current URL resolves to a registered window key.
    // Drives @Body → WorkspaceHome swap (single-render) + the deep-link open.
    private bool _urlIsWindowRoute;

    protected override void OnInitialized()
    {
        RegisterWindows();
        WM.Changed += OnWindowsChanged;
        // WorkspaceRouter — a deep-link / reload / in-shell nav to a window key
        // opens (or focuses, via dedupe) that window, then @Body shows the empty
        // workspace. Run once for the initial URL, then on every navigation.
        Nav.LocationChanged += OnLocationChanged;
        SyncWorkspaceRoute();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(SyncWorkspaceRoute);

    // Match the current path (query/fragment stripped) against the registry.
    // On a hit, open the window idempotently (WindowManager dedupes by key, so a
    // reload / re-nav focuses the existing instance rather than duplicating it)
    // and flip @Body to the workspace background. RBAC-by-omission holds: the
    // registry roles gate the launcher, and the server still authorises the
    // page/API — a role that can't see the route simply lands on the empty
    // workspace (no window opens) rather than a double-rendered page.
    private void SyncWorkspaceRoute()
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        if (path.Length == 0) path = "/";

        // P2-PR3 — dynamic-param deep-link: /npi/specs/{id} has no fixed registry
        // row (one row can't enumerate every id), so parse the id out of the path
        // and open a per-id spec-detail window keyed "spec:{id}" with the
        // RevisionId param. Dedupe re-focuses the same spec on reload.
        if (TryOpenSpecDetailDeepLink(path))
        {
            if (!_urlIsWindowRoute) { _urlIsWindowRoute = true; StateHasChanged(); }
            return;
        }

        var entry = Registry.Resolve(path);
        var isWindow = entry is not null;
        if (isWindow)
        {
            // Idempotent: dedupe focuses an already-open window; a cap-block
            // returns null and simply leaves the workspace empty (no throw).
            // entry.Parameters carries the static stage lock (e.g. /qms/fqc →
            // { ["Mode"] = "fqc" }); null for param-free pages.
            WM.Open(entry!.Key, Loc.T(entry.TitleKey), entry.Icon, entry.ContentType, entry.Parameters);
        }

        if (isWindow != _urlIsWindowRoute)
        {
            _urlIsWindowRoute = isWindow;
            StateHasChanged();
        }
    }

    // Parse /npi/specs/{RevisionId:long} → open (or focus) the per-id spec-detail
    // window. Returns true when the path matched a spec-detail deep-link (so the
    // caller flips to the workspace background), false otherwise. A non-numeric
    // tail (e.g. the plain /npi/specs list, handled by the normal registry path)
    // returns false.
    private bool TryOpenSpecDetailDeepLink(string path)
    {
        const string prefix = WindowRegistryKeys.SpecDetailRoutePrefix; // "/npi/specs/"
        if (!path.StartsWith(prefix, StringComparison.Ordinal)) return false;
        var tail = path.Substring(prefix.Length);
        if (!long.TryParse(tail, out var revisionId) || revisionId <= 0) return false;

        var key = WindowRegistryKeys.SpecDetailKeyPrefix + revisionId; // "spec:{id}"
        WM.Open(key, Loc.T(WindowRegistryKeys.TitleKeys.SpecDetail) + " #" + revisionId,
            "📄", typeof(SpecDetailPage),
            new Dictionary<string, object> { ["RevisionId"] = revisionId });
        return true;
    }

    // Host-side registry population (P2-PR1 subset). The concrete page TYPES live
    // in this Razor project, which references the Client lib holding the registry
    // shape — so the type reference must live here, not in Client. Idempotent by
    // key: safe even if the layout re-initialises.
    private void RegisterWindows()
    {
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.QcHistory, typeof(QcHistory),
            WindowRegistryKeys.TitleKeys.QcHistory, "🗂"));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.ShopOrderHistory, typeof(ShopOrderHistory),
            WindowRegistryKeys.TitleKeys.ShopOrderHistory, "🧾"));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.MachineDashboard, typeof(MachineDashboard),
            WindowRegistryKeys.TitleKeys.MachineDashboard, "🖥"));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.QcLibrary, typeof(QcLibrary),
            WindowRegistryKeys.TitleKeys.QcLibrary, "📚",
            WindowRegistryKeys.QcLibraryRoles));

        // ── P2-PR2 subset — 9 more param-free window-safe pages. ──
        // Home is DELIBERATELY NOT a window: route "/" is the default full-page
        // landing (Home dashboard renders in @Body). Registering it here would
        // make "/" a window-route → _urlIsWindowRoute=true → the empty
        // WorkspaceHome shows instead of the dashboard on app open / Home tap.
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.NpiStructure, typeof(NpiStructures),
            WindowRegistryKeys.TitleKeys.NpiStructure, "🧬",
            WindowRegistryKeys.NpiRoles));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.NpiRoutine, typeof(NpiRoutine),
            WindowRegistryKeys.TitleKeys.NpiRoutine, "🛤",
            WindowRegistryKeys.NpiRoles));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.NpiRawMaterials, typeof(NpiRawMaterials),
            WindowRegistryKeys.TitleKeys.NpiRawMaterials, "📦",
            WindowRegistryKeys.NpiRoles));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.NpiWorkCenters, typeof(NpiWorkCenters),
            WindowRegistryKeys.TitleKeys.NpiWorkCenters, "🏭",
            WindowRegistryKeys.NpiRoles));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.SemiProducts, typeof(SemiStockWarehouse),
            WindowRegistryKeys.TitleKeys.SemiProducts, "🗄"));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.QmsDashboard, typeof(QmsDashboard),
            WindowRegistryKeys.TitleKeys.QmsDashboard, "📊"));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.QmsIpqc, typeof(IpqcModule),
            WindowRegistryKeys.TitleKeys.QmsIpqc, "🔬"));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.QmsOqc, typeof(OqcModule),
            WindowRegistryKeys.TitleKeys.QmsOqc, "🔎"));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.QmsIcra, typeof(IcraModule),
            WindowRegistryKeys.TitleKeys.QmsIcra, "🛠"));

        // ── P2-PR3 subset — route-param tabs. ──
        // QMS Inspection Queue: the hub (/qms) and the FQC stage lock (/qms/fqc)
        // are two DISTINCT window keys over the SAME QmsQueue component. Only the
        // FQC key carries a static { ["Mode"] = "fqc" } param — the hub is
        // param-free (3-tab). QcRead roles mirror the NavMenu AuthorizeView.
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.QmsQueueHub, typeof(QmsQueue),
            WindowRegistryKeys.TitleKeys.QmsQueueHub, "📋",
            WindowRegistryKeys.QmsQueueRoles));
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.QmsQueueFqc, typeof(QmsQueue),
            WindowRegistryKeys.TitleKeys.QmsQueueFqc, "📋",
            WindowRegistryKeys.QmsQueueRoles,
            WindowRegistryKeys.QmsQueueFqcParameters));

        // Engineer Spec LIST — a param-free grid window (row-open spawns a
        // per-id spec-detail window; see SyncWorkspaceRoute + Specs.OpenAsync).
        Registry.Register(new WindowRegistryEntry(
            WindowRegistryKeys.Specs, typeof(Specs),
            WindowRegistryKeys.TitleKeys.Specs, "📄",
            WindowRegistryKeys.SpecRoles));
    }

    private void OnWindowsChanged() => InvokeAsync(StateHasChanged);

    // DynamicComponent wants a mutable IDictionary; the manager hands a
    // read-only snapshot (or null for the param-free PR1 pages).
    private static IDictionary<string, object>? ToDict(IReadOnlyDictionary<string, object>? p)
        => p is null ? null : new Dictionary<string, object>(p);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var collapsed = await JS.InvokeAsync<bool>("cclMesDensity.railGet");
            if (collapsed != _railCollapsed)
            {
                _railCollapsed = collapsed;
                StateHasChanged();
            }
        }
        catch
        {
            // JS chưa sẵn sàng → rail mở. Không để lỗi interop nổi lên
            // renderer (L1) — layout là nơi tệ nhất để ném exception.
        }
    }

    private async Task ToggleRailAsync()
    {
        _railCollapsed = !_railCollapsed;
        try { await JS.InvokeVoidAsync("cclMesDensity.railSet", _railCollapsed); } catch { }
    }

    public void Dispose()
    {
        WM.Changed -= OnWindowsChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
