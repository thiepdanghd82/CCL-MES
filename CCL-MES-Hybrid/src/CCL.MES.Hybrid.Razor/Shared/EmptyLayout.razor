@inherits LayoutComponentBase
@* Chromeless layout for the login screen.
   P10.6a hotfix — <RendererCrashBoundary> wraps the page body so a
   render-time throw in Login can't take the dispatcher with it.
   <MacCatalystKeyboardFix> stays as the always-on Tab+Enter fix. *@
<div class="empty-layout">
    <RendererCrashBoundary>
        @Body
    </RendererCrashBoundary>
</div>
<MacCatalystKeyboardFix />
