@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@inject ICclApiClient Api
@using CCL.MES.Hybrid.Client.Specs

@*
    P10.5c-1 — Copy Spec → new Draft revision. Operator may switch
    product when copying (legacy CopySpecRequest pattern); ProductId
    pre-fills to the source spec's product. SpecCode + Title required.
*@

<Modal Open="@Open" OnClose="@RequestCloseAsync" Size="ModalSize.Md" Severity="ModalSeverity.Info"
       ClickOutsideToClose="false">
    <Header>@T("copyspec.header") @SourceSpec?.SpecCode</Header>
    <Body>
        @if (_loadProductsError is not null)
        {
            <div class="modal-banner modal-banner-error" role="alert">
                <strong>@T("copyspec.load.failed")</strong>
                <div>@_loadProductsError</div>
                <button type="button" class="grid-btn" @onclick="LoadProductsAsync">@T("copyspec.retry")</button>
            </div>
        }
        else if (_products is null)
        {
            <p class="grid-status">@T("copyspec.loading")</p>
        }
        else if (SourceSpec is null)
        {
            <p class="grid-status">@T("copyspec.nosource")</p>
        }
        else
        {
            <form @onsubmit:preventDefault="true">
                <div class="modal-field">
                    <label for="cp-product">@T("copyspec.field.product") <span class="modal-req">*</span></label>
                    <select id="cp-product" class="modal-input" @bind="_productId" disabled="@_submitting">
                        <option value="0">@T("copyspec.product.select")</option>
                        @foreach (var p in _products)
                        {
                            <option value="@p.Id">@p.ProductCode · @p.Name</option>
                        }
                    </select>
                </div>
                <div class="modal-field">
                    <label for="cp-code">@T("copyspec.field.speccode") <span class="modal-req">*</span></label>
                    <input id="cp-code" type="text" class="modal-input" maxlength="64"
                           @bind="_specCode" @bind:event="oninput" disabled="@_submitting" />
                </div>
                <div class="modal-field">
                    <label for="cp-title">@T("copyspec.field.title") <span class="modal-req">*</span></label>
                    <input id="cp-title" type="text" class="modal-input" maxlength="200"
                           @bind="_title" @bind:event="oninput" disabled="@_submitting" />
                </div>
                @if (_error is not null)
                {
                    <div class="modal-banner modal-banner-error" role="alert">@_error</div>
                }
            </form>
        }
    </Body>
    <Footer>
        <button type="button" class="op-btn op-btn-secondary"
                disabled="@_submitting" @onclick="RequestCloseAsync">@T("copyspec.cancel")</button>
        <button type="button" class="op-btn op-btn-primary"
                disabled="@(!CanSubmit())" @onclick="SubmitAsync">
            @(_submitting ? T("copyspec.copying") : T("copyspec.copy"))
        </button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public SpecDetailItem? SourceSpec { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SpecMutationResponse> OnCopied { get; set; }

    private List<SpecProductDropdownItem>? _products;
    private string? _loadProductsError;

    private long _productId;
    private string _specCode = "";
    private string _title = "";
    private bool _submitting;
    private string? _error;

    private bool CanSubmit() =>
        !_submitting && _productId > 0
        && !string.IsNullOrWhiteSpace(_specCode)
        && !string.IsNullOrWhiteSpace(_title)
        && SourceSpec is not null;

    protected override async Task OnParametersSetAsync()
    {
        if (Open)
        {
            if (_products is null && _loadProductsError is null) await LoadProductsAsync();
            // Pre-fill once per open.
            if (SourceSpec is not null && _specCode == "")
            {
                _specCode = SourceSpec.SpecCode + "-COPY";
                _title = SourceSpec.Title + " (copy)";
                // Best-effort product pre-select — page caller may pass it later
                // via cascade; default to 0 so the operator confirms.
            }
        }
        if (!Open) ResetForm();
    }

    private async Task LoadProductsAsync()
    {
        _loadProductsError = null;
        try { _products = await Api.GetSpecProductsAsync(); }
        catch (ApiException apiEx) { _loadProductsError = SpecMutationErrorMapper.ToVietnameseMessage(apiEx); }
        catch (HttpRequestException ex) { _loadProductsError = $"Could not connect to the server: {ex.Message}"; }
        catch (Exception ex) { _loadProductsError = $"{ex.GetType().Name}: {ex.Message}"; }
    }

    private async Task SubmitAsync()
    {
        if (_submitting || !CanSubmit() || SourceSpec is null) return;
        _submitting = true;
        _error = null;
        try
        {
            var resp = await Api.CopySpecAsync(SourceSpec.Id, new CopySpecMutation
            {
                ProductId = _productId,
                SpecCode = _specCode.Trim(),
                Title = _title.Trim(),
            });
            if (OnCopied.HasDelegate) await OnCopied.InvokeAsync(resp);
            ResetForm();
            if (OnClose.HasDelegate) await OnClose.InvokeAsync();
        }
        catch (ApiException apiEx) { _error = SpecMutationErrorMapper.ToVietnameseMessage(apiEx); }
        catch (HttpRequestException ex) { _error = $"Could not connect to the server: {ex.Message}"; }
        catch (Exception ex) { _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _submitting = false; }
    }

    private async Task RequestCloseAsync()
    {
        if (_submitting) return;
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private void ResetForm()
    {
        _productId = 0;
        _specCode = "";
        _title = "";
        _error = null;
    }
}
