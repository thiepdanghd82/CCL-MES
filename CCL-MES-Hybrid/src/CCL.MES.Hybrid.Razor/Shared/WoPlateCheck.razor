@*
    P10.7b-3 — Plate (clichê) check sub-component. Single-row check
    surface. Parent owns state; we emit OnSetPlate intents only.

    Rule 4: plain <input>, no <InputText>.
*@

@using CCL.MES.Shared.Prepress

<div class="prepress-section">
    <div class="prepress-section-head">
        <span class="prepress-section-title">Kiểm tra clichê</span>
        <span class="prepress-pill @StatusPillClass(Row?.Status ?? "Pending")" data-testid="plate-status-pill">
            @StatusLabel(Row?.Status ?? "Pending")
        </span>
    </div>

    <div class="prepress-row-form">
        <div class="prepress-form-cell">
            <label for="plate-no-input">Số/mã clichê</label>
            <input id="plate-no-input"
                   type="text"
                   class="prepress-input"
                   value="@_plateNo"
                   @oninput="OnPlateNoInput"
                   disabled="@Busy"
                   aria-label="Số clichê" />
        </div>

        @if (IsNgOrArming)
        {
            <div class="prepress-form-cell">
                <label for="plate-ng-reason">Mã lý do NG (scrap)</label>
                <input id="plate-ng-reason"
                       type="text"
                       class="prepress-input"
                       value="@_ngReason"
                       @oninput="OnNgReasonInput"
                       disabled="@Busy"
                       aria-label="Mã lý do NG clichê" />
            </div>
            <div class="prepress-form-cell prepress-form-cell-wide">
                <label for="plate-ng-note">Ghi chú NG (1-500 ký tự)</label>
                <input id="plate-ng-note"
                       type="text"
                       class="prepress-input"
                       value="@_ngNote"
                       @oninput="OnNgNoteInput"
                       disabled="@Busy"
                       aria-label="Ghi chú NG clichê" />
            </div>
        }
    </div>

    <div class="prepress-actions">
        <button type="button"
                class="op-btn op-btn-success"
                data-testid="plate-btn-ok"
                disabled="@(Busy || (Row?.Status == "Ok"))"
                @onclick="OnSubmitOk">
            Ghi clichê OK
        </button>
        @if (!_armingNg && (Row?.Status != "Ng"))
        {
            <button type="button"
                    class="op-btn op-btn-danger"
                    data-testid="plate-btn-ng-arm"
                    disabled="@Busy"
                    @onclick="() => _armingNg = true">
                Đánh NG
            </button>
        }
        else
        {
            <button type="button"
                    class="op-btn op-btn-danger"
                    data-testid="plate-btn-ng-confirm"
                    disabled="@Busy"
                    @onclick="OnSubmitNg">
                Lưu NG
            </button>
            <button type="button"
                    class="op-btn op-btn-secondary"
                    data-testid="plate-btn-ng-cancel"
                    disabled="@Busy"
                    @onclick="CancelNg">
                Hủy
            </button>
        }
    </div>

    @if (Row?.CheckedBy is not null)
    {
        <div class="prepress-checked-by" data-testid="plate-checked-by">
            Người kiểm: <strong>@Row.CheckedBy</strong>
            @if (Row.CheckedAt is not null)
            {
                <span> · @Row.CheckedAt.Value.ToLocalTime().ToString("HH:mm dd/MM")</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public PrepressPlateRow? Row { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<PlateSetIntent> OnSetPlate { get; set; }

    private string _plateNo = "";
    private string _ngReason = "";
    private string _ngNote = "";
    private bool _armingNg;
    private long? _lastRowSyncedId;

    private bool IsNgOrArming => _armingNg || (Row?.Status == "Ng");

    protected override void OnParametersSet()
    {
        if (Row is not null && Row.Id != _lastRowSyncedId)
        {
            _plateNo = Row.PlateNo ?? "";
            _ngReason = Row.NgReasonCode ?? "";
            _ngNote = Row.NgNote ?? "";
            _lastRowSyncedId = Row.Id;
        }
    }

    private void OnPlateNoInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _plateNo = e.Value?.ToString() ?? "";
    private void OnNgReasonInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _ngReason = e.Value?.ToString() ?? "";
    private void OnNgNoteInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _ngNote = e.Value?.ToString() ?? "";

    private async Task OnSubmitOk()
    {
        await OnSetPlate.InvokeAsync(new PlateSetIntent
        {
            Status = "Ok",
            PlateNo = string.IsNullOrWhiteSpace(_plateNo) ? null : _plateNo,
            NgReasonCode = null,
            NgNote = null,
        });
        _armingNg = false;
    }

    private async Task OnSubmitNg()
    {
        await OnSetPlate.InvokeAsync(new PlateSetIntent
        {
            Status = "Ng",
            PlateNo = string.IsNullOrWhiteSpace(_plateNo) ? null : _plateNo,
            NgReasonCode = string.IsNullOrWhiteSpace(_ngReason) ? null : _ngReason,
            NgNote = string.IsNullOrWhiteSpace(_ngNote) ? null : _ngNote,
        });
        _armingNg = false;
    }

    private void CancelNg()
    {
        _armingNg = false;
        _ngReason = "";
        _ngNote = "";
    }

    private static string StatusPillClass(string status) => status switch
    {
        "Ok"      => "prepress-pill-ok",
        "Ng"      => "prepress-pill-ng",
        _         => "prepress-pill-pending",
    };

    private static string StatusLabel(string status) => status switch
    {
        "Ok"      => "OK",
        "Ng"      => "NG",
        _         => "Chưa kiểm",
    };

    public sealed class PlateSetIntent
    {
        public string Status { get; init; } = "";
        public string? PlateNo { get; init; }
        public string? NgReasonCode { get; init; }
        public string? NgNote { get; init; }
    }
}
