@*
    P10.7b-3 — Plate (clichê) check sub-component. Single-row check
    surface. Parent owns state; we emit OnSetPlate intents only.

    Rule 4: plain <input>, no <InputText>.
*@

@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Prepress
@using CCL.MES.Shared.ReasonCodes

<div class="prepress-section">
    <div class="prepress-section-head">
        <span class="prepress-section-title">@T("woplate.section.title")</span>
        <span class="prepress-pill @StatusPillClass(Row?.Status ?? "Pending")" data-testid="plate-status-pill">
            @StatusLabel(Row?.Status ?? "Pending")
        </span>
        @* StatusLabel maps: Ok→"OK", Ng→"NG" (raw tokens), else→woplate.status.pending *@
    </div>

    <div class="prepress-checkrow">
    <div class="prepress-row-form">
        <div class="prepress-form-cell">
            <label for="plate-no-input">@T("woplate.plateno.label")</label>
            <input id="plate-no-input"
                   type="text"
                   class="prepress-input"
                   value="@_plateNo"
                   @oninput="OnPlateNoInput"
                   disabled="@Busy"
                   aria-label="@T("woplate.plateno.aria")" />
        </div>

        @if (IsNgOrArming)
        {
            <div class="prepress-form-cell">
                <label for="plate-ng-reason">@T("woplate.ngreason.label")</label>
                <select id="plate-ng-reason"
                        class="prepress-input prepress-select"
                        value="@_ngReason"
                        @onchange="OnNgReasonChange"
                        disabled="@Busy"
                        aria-label="@T("woplate.ngreason.aria")"
                        data-testid="plate-ng-reason-picker">
                    <option value="">@T("woplate.ngreason.placeholder")</option>
                    @foreach (var rc in ScrapReasons)
                    {
                        <option value="@rc.Code">@rc.Code · @rc.LabelVi</option>
                    }
                </select>
            </div>
            <div class="prepress-form-cell prepress-form-cell-wide">
                <label for="plate-ng-note">@T("woplate.ngnote.label")</label>
                <input id="plate-ng-note"
                       type="text"
                       class="prepress-input"
                       value="@_ngNote"
                       @oninput="OnNgNoteInput"
                       disabled="@Busy"
                       aria-label="@T("woplate.ngnote.aria")" />
            </div>
        }
    </div>

    <div class="prepress-actions">
        @* L52 — OK/NG confirmation via the shared segmented ConfirmToggle.
           NG cell arms the sub-form (reason/note above); when armed or the row
           is already NG we also render Save-NG + Cancel below. *@
        <ConfirmToggle Status="@(Row?.Status ?? "Pending")"
                       Disabled="@Busy"
                       OkDisabled="@(Row?.Status == "Ok")"
                       NgDisabled="@(ScrapReasons.Count == 0)"
                       NgTitle="@(ScrapReasons.Count == 0 ? T("woplate.ng.empty.title") : null)"
                       OnOk="OnSubmitOk"
                       OnNg="ArmNg"
                       TestIdPrefix="plate-btn" />
        @if (IsNgOrArming)
        {
            <button type="button"
                    class="op-btn op-btn-danger"
                    data-testid="plate-btn-ng-confirm"
                    disabled="@(Busy || !IsValidNgReason(_ngReason))"
                    @onclick="OnSubmitNg">
                @T("woplate.btn.ng.save")
            </button>
            <button type="button"
                    class="op-btn op-btn-secondary"
                    data-testid="plate-btn-ng-cancel"
                    disabled="@Busy"
                    @onclick="CancelNg">
                @T("woplate.btn.cancel")
            </button>
        }
    </div>
    </div>

    @if (Row?.CheckedBy is not null)
    {
        <div class="prepress-checked-by" data-testid="plate-checked-by">
            @T("woplate.checkedby.label") <strong>@Row.CheckedBy</strong>
            @if (Row.CheckedAt is not null)
            {
                <span> · @Row.CheckedAt.Value.ToLocalTime().ToString("HH:mm dd/MM")</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public PrepressPlateRow? Row { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public IReadOnlyList<ReasonCodeOption> ScrapReasons { get; set; } = Array.Empty<ReasonCodeOption>();
    [Parameter] public EventCallback<PlateSetIntent> OnSetPlate { get; set; }

    private string _plateNo = "";
    private string _ngReason = "";
    private string _ngNote = "";
    private bool _armingNg;
    private long? _lastRowSyncedId;

    private bool IsNgOrArming => _armingNg || (Row?.Status == "Ng");

    protected override void OnParametersSet()
    {
        if (Row is not null && Row.Id != _lastRowSyncedId)
        {
            _plateNo = Row.PlateNo ?? "";
            _ngReason = Row.NgReasonCode ?? "";
            _ngNote = Row.NgNote ?? "";
            _lastRowSyncedId = Row.Id;
        }
    }

    private void ArmNg() => _armingNg = true;

    private void OnPlateNoInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _plateNo = e.Value?.ToString() ?? "";
    private void OnNgReasonChange(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _ngReason = e.Value?.ToString() ?? "";
    private void OnNgNoteInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _ngNote = e.Value?.ToString() ?? "";

    private bool IsValidNgReason(string code)
    {
        if (string.IsNullOrWhiteSpace(code)) return false;
        foreach (var rc in ScrapReasons)
        {
            if (string.Equals(rc.Code, code, StringComparison.Ordinal)) return true;
        }
        return false;
    }

    private async Task OnSubmitOk()
    {
        await OnSetPlate.InvokeAsync(new PlateSetIntent
        {
            Status = "Ok",
            PlateNo = string.IsNullOrWhiteSpace(_plateNo) ? null : _plateNo,
            NgReasonCode = null,
            NgNote = null,
        });
        _armingNg = false;
    }

    private async Task OnSubmitNg()
    {
        await OnSetPlate.InvokeAsync(new PlateSetIntent
        {
            Status = "Ng",
            PlateNo = string.IsNullOrWhiteSpace(_plateNo) ? null : _plateNo,
            NgReasonCode = string.IsNullOrWhiteSpace(_ngReason) ? null : _ngReason,
            NgNote = string.IsNullOrWhiteSpace(_ngNote) ? null : _ngNote,
        });
        _armingNg = false;
    }

    private void CancelNg()
    {
        _armingNg = false;
        _ngReason = "";
        _ngNote = "";
    }

    private static string StatusPillClass(string status) => status switch
    {
        "Ok"      => "prepress-pill-ok",
        "Ng"      => "prepress-pill-ng",
        _         => "prepress-pill-pending",
    };

    private string StatusLabel(string status) => status switch
    {
        "Ok"      => "OK",
        "Ng"      => "NG",
        _         => T("woplate.status.pending"),
    };

    public sealed class PlateSetIntent
    {
        public string Status { get; init; } = "";
        public string? PlateNo { get; init; }
        public string? NgReasonCode { get; init; }
        public string? NgNote { get; init; }
    }
}
