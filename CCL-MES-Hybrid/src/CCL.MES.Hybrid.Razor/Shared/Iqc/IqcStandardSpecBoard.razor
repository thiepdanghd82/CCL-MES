@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Quality
@using CCL.MES.Hybrid.Razor.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject ICclApiClient Api
@inject CCL.MES.Hybrid.Client.Auth.IAuthSession Session
@inject IJSRuntime Js

@*
    Catalog tiêu chuẩn CCL-SPEC-QC* — double-click / chuột phải / kebab mở
    tab Standards (giống IQC Data → mở phiếu). Import đọc đủ Form (header + hạng mục).
*@

<section class="qms-section" data-testid="iqc-stdspec">
    <div class="qms-section-head">
        <h2 class="qms-section-title">@T("iqc.stdspec.title")</h2>
    </div>
    <p class="qms-section-desc">@T("iqc.stdspec.desc")</p>

    <div class="iqc-data-toolbar">
        <div class="iqc-search-wrap">
            <input type="search" class="op-input iqc-data-search" data-testid="iqc-stdspec-search"
                   placeholder="@T("iqc.stdspec.search.ph")" value="@_search"
                   @oninput="OnSearchInput" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <button type="button" class="iqc-search-clear" data-testid="iqc-stdspec-search-clear"
                        title="@T("iqc.stdspec.search.clear")" aria-label="@T("iqc.stdspec.search.clear")"
                        @onclick="ClearSearch">×</button>
            }
        </div>
        <button type="button" class="op-btn op-btn-primary" data-testid="iqc-stdspec-import"
                disabled="@_importing" @onclick="ImportAsync">
            @(_importing ? T("iqc.stdspec.importing") : T("iqc.stdspec.import"))
        </button>
        @if (_status is not null)
        {
            <span class="iqc-hint" data-testid="iqc-stdspec-status">@_status</span>
        }
    </div>

    @if (_loading && _data is null)
    {
        <p class="qms-section-desc">@T("iqc.stdspec.loading")</p>
    }
    else if (_error is not null)
    {
        <p class="iqc-warn iqc-warn-error" data-testid="iqc-stdspec-error">@_error</p>
    }
    else
    {
        <p class="iqc-hint" data-testid="iqc-stdspec-total">
            @T("iqc.stdspec.total", _data?.Total ?? 0)
        </p>
        <div class="qms-table-wrap qms-fill">
            <table class="qms-table iqc-data-table" data-testid="iqc-stdspec-table">
                <thead>
                    <tr>
                        <th>@T("iqc.stdspec.col.specno")</th>
                        <th>@T("iqc.stdspec.col.material")</th>
                        <th>@T("iqc.stdspec.col.supplier")</th>
                        <th>@T("iqc.stdspec.col.revision")</th>
                        <th class="num">@T("iqc.stdspec.col.items")</th>
                        <th>@T("iqc.stdspec.col.approval")</th>
                        <th>@T("iqc.stdspec.col.source")</th>
                        <th class="wc-kebab-col" aria-hidden="true"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_data is null || _data.Items.Count == 0)
                    {
                        <tr data-testid="iqc-stdspec-empty">
                            <td colspan="8">@T("iqc.stdspec.empty")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in _data.Items)
                        {
                            var r = row;
                            <tr class="iqc-data-row" data-testid="iqc-stdspec-row"
                                @oncontextmenu="e => OpenMenuAt(r, e.ClientX, e.ClientY)" @oncontextmenu:preventDefault="true"
                                @ondblclick="() => OpenInEditor(r)"
                                @onpointerdown="e => LongPressStart(r, e)" @onpointerup="LongPressCancel"
                                @onpointerleave="LongPressCancel" @onpointermove="LongPressCancel">
                                <td>@r.SpecNo</td>
                                <td>@r.MaterialCode</td>
                                <td>@(r.SupplierName ?? "—")</td>
                                <td>@(r.Revision ?? "—")</td>
                                <td class="num">@r.ItemCount</td>
                                <td>
                                    <span class="iqc-status @(r.Approval == "Approved" ? "iqc-status-pass" : "iqc-status-pending")">
                                        @ApprovalLabel(r.Approval)
                                    </span>
                                </td>
                                <td>@(r.ImportSource ?? "—")</td>
                                <td class="wc-kebab-col">
                                    <button type="button" class="row-kebab" data-fw-nodrag
                                            data-testid="iqc-stdspec-kebab"
                                            aria-haspopup="menu" aria-label="@T("iqc.data.menu.actions")"
                                            @onclick="e => OpenMenuAt(r, e.ClientX, e.ClientY)"
                                            @onclick:stopPropagation="true">⋯</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if ((_data?.Total ?? 0) > _pageSize)
        {
            <div class="iqc-data-pager" data-testid="iqc-stdspec-pager">
                <button type="button" class="op-btn" disabled="@(_page <= 1 || _loading)"
                        @onclick="() => GoPage(_page - 1)">@T("iqc.stdspec.prev")</button>
                <span>@_page / @MaxPage</span>
                <button type="button" class="op-btn" disabled="@(_page >= MaxPage || _loading)"
                        @onclick="() => GoPage(_page + 1)">@T("iqc.stdspec.next")</button>
            </div>
        }
    }

    <RowContextMenu Open="_menuRow is not null" Anchor="_menuAnchor" Items="_menuItems"
                    AriaLabel="@T("iqc.stdspec.menu.aria", _menuRow?.SpecNo ?? "")"
                    OnClose="CloseMenu" />
</section>

@code {
    [Parameter] public int DebounceMs { get; set; } = 280;
    [Parameter] public EventCallback<string> OnOpenMaterial { get; set; }

    private IqcStandardSpecListResponse? _data;
    private string _search = "";
    private string? _error;
    private string? _status;
    private bool _loading;
    private bool _importing;
    private int _page = 1;
    private const int _pageSize = 50;
    private CancellationTokenSource? _debounce;
    private int MaxPage => Math.Max(1, (int)Math.Ceiling((_data?.Total ?? 0) / (double)_pageSize));

    private IqcStandardSpecListItem? _menuRow;
    private (double X, double Y) _menuAnchor;
    private IReadOnlyList<ContextMenuItem> _menuItems = Array.Empty<ContextMenuItem>();
    private System.Threading.Timer? _longPress;
    private (double X, double Y) _pressAt;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    public override void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _longPress?.Dispose();
        base.Dispose();
    }

    private string ApprovalLabel(string a) => a switch
    {
        "Approved" => T("iqc.stdspec.approval.approved"),
        "PendingQc" => T("iqc.stdspec.approval.pending"),
        "Rejected" => T("iqc.stdspec.approval.rejected"),
        _ => a,
    };

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(DebounceMs, token);
            _page = 1;
            await LoadAsync();
        }
        catch (TaskCanceledException) { /* debounce */ }
    }

    private async Task ClearSearch()
    {
        _search = "";
        _page = 1;
        await LoadAsync();
    }

    private async Task GoPage(int p)
    {
        _page = Math.Max(1, p);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await Api.ListIqcStandardSpecsAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search, _page, _pageSize);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _data = null;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ImportAsync()
    {
        _importing = true;
        _status = null;
        _error = null;
        try
        {
            var r = await Api.ImportIqcStandardSpecsAsync();
            _status = T("iqc.stdspec.import.done",
                r.FilesSeen, r.Inserted, r.Updated, r.AlreadyPresent,
                r.ItemsInserted, r.ItemsUpdated);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    private void OpenMenuAt(IqcStandardSpecListItem row, double x, double y)
    {
        _menuRow = row;
        _menuAnchor = (x, y);
        _menuItems = new[]
        {
            new ContextMenuItem { Label = T("iqc.data.menu.open"), Icon = "🗂",
                OnClick = EventCallback.Factory.Create(this, () => MenuOpen(row)) },
            new ContextMenuItem { Label = T("iqc.stdspec.menu.copy.spec"), Icon = "⎘",
                OnClick = EventCallback.Factory.Create(this, () => CopyTextAsync(row.SpecNo)) },
            new ContextMenuItem { Label = T("iqc.stdspec.menu.copy.material"), Icon = "⎘",
                OnClick = EventCallback.Factory.Create(this, () => CopyTextAsync(row.MaterialCode)) },
            new ContextMenuItem { Label = T("iqc.data.menu.edit"), Icon = "✎",
                OnClick = EventCallback.Factory.Create(this, () => MenuOpen(row)) },
            ContextMenuItem.Divider,
            new ContextMenuItem { Label = T("iqc.data.menu.delete"), Icon = "✕", Danger = true,
                OnClick = EventCallback.Factory.Create(this, NotYet) },
        };
    }

    private void CloseMenu() => _menuRow = null;

    private async Task MenuOpen(IqcStandardSpecListItem row)
    {
        _menuRow = null;
        await OpenInEditor(row);
    }

    private void NotYet()
    {
        _status = T("iqc.data.action.notyet");
        _menuRow = null;
    }

    private async Task CopyTextAsync(string? text)
    {
        _menuRow = null;
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            var ok = await Js.InvokeAsync<bool>("cclMesClipboard.copy", text);
            _status = ok ? T("iqc.stdspec.copied", text) : T("iqc.data.action.notyet");
        }
        catch
        {
            _status = T("iqc.data.action.notyet");
        }
    }

    private void LongPressStart(IqcStandardSpecListItem row, PointerEventArgs e)
    {
        if (e.Button != 0) return;
        _pressAt = (e.ClientX, e.ClientY);
        _longPress?.Dispose();
        _longPress = new System.Threading.Timer(
            _ => InvokeAsync(() => { OpenMenuAt(row, _pressAt.X, _pressAt.Y); StateHasChanged(); }),
            null, 500, System.Threading.Timeout.Infinite);
    }

    private void LongPressCancel()
    {
        _longPress?.Dispose();
        _longPress = null;
    }

    private async Task OpenInEditor(IqcStandardSpecListItem row)
    {
        if (string.IsNullOrWhiteSpace(row.MaterialCode)) return;
        if (OnOpenMaterial.HasDelegate)
            await OnOpenMaterial.InvokeAsync(row.MaterialCode);
    }
}
