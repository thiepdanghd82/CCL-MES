@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Quality
@using CCL.MES.Shared.Localization
@using System.Globalization
@inject ICclApiClient Api
@inject CCL.MES.Hybrid.Client.Qms.IIqcDashboardPrefs DashPrefs

@*
    IQC Dashboard v2 — hệ Broadsheet (bản tin giấy), thay hero navy + 6 thẻ KPI
    + Pareto SVG dọc của v1.

    Bốn thay đổi mang tính quyết định, không phải trang trí:
      • Măng-sét giấy thay khối navy: trả 15% chiều cao màn về cho SỐ LIỆU.
      • Một số dẫn (%NG) + 6 số phụ: mắt có một điểm neo, không phải sáu.
      • KẾT LUẬN + CẦN QUYẾT ĐỊNH: trả lời "hôm nay làm gì" ngay hàng đầu,
        thay vì bắt người đọc tự suy ra từ sáu con số.
      • Pareto NGANG bằng DOM: tên lỗi đọc thẳng, hết cuộn, và ngưỡng ưu tiên
        chạy bằng CSS var --iqc-par-n (bỏ hẳn đo font theo viewBox qua JS).

    Hợp đồng dữ liệu KHÔNG đổi: ReloadAsync() · ICclApiClient · IIqcDashboardPrefs
    · GetIqcDashboardAsync(year, month). Năm EventCallback dưới đây mặc định
    không gắn ⇒ nút vô hại, component vẫn tự đứng được.
*@

<section class="qms-section iqc-dash iqc-dash-v2" data-testid="iqc-dash">

    @* ── 1. Măng-sét: rule dày–mảnh + dateline (thay hero navy) ────────── *@
    <header class="iqc-dash-hero iqc-v2-mast">
        <div class="iqc-v2-rule iqc-v2-rule-thick"></div>
        <div class="iqc-v2-mast-row">
            <div class="iqc-v2-mast-id">
                <p class="iqc-v2-eyebrow">@T("iqc.dash.eyebrow")</p>
                <h2 class="iqc-v2-masthead">@T("iqc.dash.hero")</h2>
            </div>
            <div class="iqc-v2-mast-tools">
                <label class="iqc-dash-year iqc-v2-year">
                    <span class="iqc-dash-year-lbl">@T("iqc.dash.filter.year")</span>
                    <select class="ix-input iqc-dash-select" data-testid="iqc-dash-year"
                            value="@(_year?.ToString() ?? "")" @onchange="OnYearChanged">
                        @if (_dash.AvailableYears.Count == 0)
                        {
                            <option value="">—</option>
                        }
                        else
                        {
                            @foreach (var y in _dash.AvailableYears)
                            {
                                <option value="@y">@y</option>
                            }
                        }
                    </select>
                </label>
                <button type="button" class="iqc-v2-tool" data-testid="iqc-dash-export"
                        @onclick="() => OnExport.InvokeAsync()">@T("iqc.dash.v2.export")</button>
                <button type="button" class="iqc-v2-tool" data-testid="iqc-dash-print"
                        @onclick="() => OnPrint.InvokeAsync()">@T("iqc.dash.v2.print")</button>
            </div>
        </div>
        <div class="iqc-v2-rule iqc-v2-rule-thin"></div>
        <p class="iqc-v2-dateline">@PeriodLabel</p>
    </header>

    @* ── Dải chip tháng (13 nút chạm được, giữ nguyên hợp đồng v1) ─────── *@
    <div class="iqc-dash-months" role="group" aria-label="@T("iqc.dash.filter.month")"
         data-testid="iqc-dash-month">
        <button type="button" class="iqc-chip @(_month is null ? "iqc-chip-on" : null)"
                data-testid="iqc-dash-month-all" aria-pressed="@(_month is null)"
                @onclick="() => SelectMonthAsync(null)">@T("iqc.dash.filter.month.all")</button>
        @for (var m = 1; m <= 12; m++)
        {
            var mm = m;
            var lots = LotsIn(mm);
            <button type="button"
                    class="iqc-chip @(_month == mm ? "iqc-chip-on" : null) @(lots == 0 ? "iqc-chip-empty" : null)"
                    data-testid="@($"iqc-dash-month-{mm}")" aria-pressed="@(_month == mm)"
                    title="@($"{T($"iqc.dash.month.{mm}")} — {FmtInt(lots)}")"
                    @onclick="() => SelectMonthAsync(mm)">@T($"iqc.dash.month.short.{mm}")</button>
        }
    </div>

    @if (_loading && _dash.AvailableYears.Count == 0)
    {
        <p class="qms-section-desc">@T("iqc.data.loading")</p>
    }
    else
    {
        @* ── 2. Một SỐ DẪN + sáu số phụ, mỗi ô bấm được → IQC Data ─────── *@
        <div class="iqc-kpis iqc-v2-kpis">
            <button type="button" class="iqc-v2-lead @LeadTone" data-testid="iqc-kpi-lead"
                    @onclick="() => Drill(IqcDrill.Ng)">
                <span class="iqc-v2-lead-lbl">@T("iqc.dash.kpi.failrate")</span>
                <span class="iqc-v2-lead-val" data-testid="iqc-kpi-failrate">@FmtPct(_dash.FailRate)</span>
                <span class="iqc-v2-lead-sub">@T("iqc.dash.v2.lead.of", FmtInt(_dash.Fail), FmtInt(_dash.Total))</span>
            </button>
            <div class="iqc-v2-stats">
                <button type="button" class="iqc-v2-stat" data-testid="iqc-kpi-total"
                        @onclick="() => Drill(IqcDrill.All)">
                    <span class="iqc-v2-stat-lbl">@T("iqc.dash.kpi.lots")</span>
                    <span class="iqc-v2-stat-val">@FmtInt(_dash.Total)</span>
                </button>
                <button type="button" class="iqc-v2-stat" data-testid="iqc-kpi-passcard"
                        @onclick="() => Drill(IqcDrill.Pass)">
                    <span class="iqc-v2-stat-lbl">@T("iqc.dash.kpi.pass")</span>
                    <span class="iqc-v2-stat-val is-ok" data-testid="iqc-kpi-pass">@FmtInt(_dash.Pass)</span>
                </button>
                <button type="button" class="iqc-v2-stat" data-testid="iqc-kpi-failcard"
                        @onclick="() => Drill(IqcDrill.Ng)">
                    <span class="iqc-v2-stat-lbl">@T("iqc.dash.kpi.fail")</span>
                    <span class="iqc-v2-stat-val is-ng" data-testid="iqc-kpi-fail">@FmtInt(_dash.Fail)</span>
                </button>
                <button type="button" class="iqc-v2-stat" data-testid="iqc-kpi-pending"
                        @onclick="() => Drill(IqcDrill.Pending)">
                    <span class="iqc-v2-stat-lbl">@T("iqc.dash.pending")</span>
                    <span class="iqc-v2-stat-val">@FmtInt(_dash.Pending)</span>
                </button>
                <button type="button" class="iqc-v2-stat" data-testid="iqc-kpi-nq"
                        @onclick="() => Drill(IqcDrill.Nq)">
                    <span class="iqc-v2-stat-lbl">@T("iqc.dash.kpi.nq")</span>
                    <span class="iqc-v2-stat-val is-warn">@FmtInt(_dash.TotalNqDefects)</span>
                    <span class="iqc-v2-stat-note">@T("iqc.dash.kpi.nq.per", NqPerNg)</span>
                </button>
                <button type="button" class="iqc-v2-stat" data-testid="iqc-kpi-claim"
                        @onclick="() => Drill(IqcDrill.Claim)">
                    <span class="iqc-v2-stat-lbl">@T("iqc.dash.kpi.claim")</span>
                    <span class="iqc-v2-stat-val">@FmtInt(_dash.ClaimNgLots)</span>
                </button>
                <button type="button" class="iqc-v2-stat" data-testid="iqc-kpi-wide"
                        @onclick="() => Drill(IqcDrill.WideOos)">
                    <span class="iqc-v2-stat-lbl">@T("iqc.dash.kpi.wide")</span>
                    <span class="iqc-v2-stat-val">@FmtInt(_dash.WideOosLots)</span>
                </button>
            </div>
        </div>

        @* ── 3a. KẾT LUẬN — headline tự sinh từ so sánh hai tháng gần nhất *@
        <section class="iqc-v2-verdict">
            <p class="iqc-v2-kicker">@T("iqc.dash.v2.verdict.kicker")</p>
            <p class="iqc-v2-headline">@VerdictHeadline</p>
            <p class="iqc-v2-standfirst">@VerdictStandfirst</p>
        </section>

        @* ── 3b. CẦN QUYẾT ĐỊNH HÔM NAY ────────────────────────────────── *@
        <section class="iqc-v2-decide" data-testid="iqc-dash-decide">
            <h3 class="iqc-v2-sec-title">@T("iqc.dash.v2.decide.title")</h3>
            @if (DecisionCount == 0)
            {
                <p class="iqc-v2-decide-none">@T("iqc.dash.v2.decide.none")</p>
            }
            else
            {
                <ul class="iqc-v2-decide-list">
                    @if (_dash.WideOosLots > 0)
                    {
                        <li class="iqc-v2-decide-row is-alarm" data-testid="iqc-decide-wide">
                            <span class="iqc-v2-decide-n">@FmtInt(_dash.WideOosLots)</span>
                            <span class="iqc-v2-decide-txt">@T("iqc.dash.v2.decide.wide")</span>
                            <span class="iqc-v2-decide-lead" aria-hidden="true"></span>
                            <button type="button" class="iqc-v2-act"
                                    @onclick="() => Drill(IqcDrill.WideOos)">@T("iqc.dash.v2.act.view")</button>
                        </li>
                    }
                    @if (_dash.ClaimNgLots > 0)
                    {
                        <li class="iqc-v2-decide-row is-warn" data-testid="iqc-decide-claim">
                            <span class="iqc-v2-decide-n">@FmtInt(_dash.ClaimNgLots)</span>
                            <span class="iqc-v2-decide-txt">@T("iqc.dash.v2.decide.claim")</span>
                            <span class="iqc-v2-decide-lead" aria-hidden="true"></span>
                            <button type="button" class="iqc-v2-act"
                                    @onclick="() => OnOpenCar.InvokeAsync(null)">@T("iqc.dash.v2.act.car")</button>
                        </li>
                    }
                    @if (_dash.Pending > 0)
                    {
                        <li class="iqc-v2-decide-row" data-testid="iqc-decide-pending">
                            <span class="iqc-v2-decide-n">@FmtInt(_dash.Pending)</span>
                            <span class="iqc-v2-decide-txt">@T("iqc.dash.v2.decide.pending")</span>
                            <span class="iqc-v2-decide-lead" aria-hidden="true"></span>
                            <button type="button" class="iqc-v2-act"
                                    @onclick="() => Drill(IqcDrill.Pending)">@T("iqc.dash.v2.act.view")</button>
                        </li>
                    }
                </ul>
            }
        </section>

        @* ── 4. Hai cột CÂN THEO CHIỀU CAO, không theo số khối.
             Đo trên hình dạng dữ liệu thật (12 dạng lỗi · 23 NCC có NG): xếp
             Pareto một cột và NCC một cột thì lệch 39–42%, vì hàng NCC cao hơn
             hàng Pareto và còn thêm hàng công cụ tìm kiếm. Ép cân bằng cách
             cắt tiếp danh sách NCC thì mất luôn ý nghĩa của nó. Nên cột TRÁI
             gánh thêm Xu hướng ở dưới Pareto. *@
        <div class="iqc-split iqc-v2-split">
            <div class="iqc-v2-col">
                <section class="ix-panel iqc-panel iqc-panel-detail iqc-v2-panel">
                    <div class="iqc-panel-head iqc-v2-panel-head">
                        <div>
                            <h3 class="iqc-panel-title iqc-v2-sec-title">@T("iqc.dash.pareto.title")</h3>
                            @if (ParetoFocusCount > 0)
                            {
                                <p class="iqc-panel-note">@T("iqc.dash.pareto.top3", ParetoFocusCount, FmtPct(ParetoFocusCum))</p>
                            }
                        </div>
                        <label class="iqc-thr">
                            <span class="iqc-thr-lbl">@T("iqc.dash.pareto.legend.thr")</span>
                            <input type="range" min="50" max="100" step="1" value="@_thrPct"
                                   data-testid="iqc-dash-pareto-thr"
                                   aria-valuemin="50" aria-valuemax="100" aria-valuenow="@_thrPct"
                                   aria-label="@T("iqc.dash.pareto.legend.thr")"
                                   @oninput="OnThrChanged" />
                            <span class="iqc-thr-val" data-testid="iqc-dash-pareto-thr-val">@($"{_thrPct}%")</span>
                        </label>
                    </div>

                    @* Ngưỡng ưu tiên chạy bằng CSS var: đường cắt nét đứt nằm sau
                       đúng --iqc-par-n hàng, không cần một dòng JS nào. *@
                    <div class="iqc-v2-par" data-testid="iqc-dash-pareto"
                         style="--iqc-par-n: @ParetoFocusCount">
                        @if (_dash.VisualPareto.Count == 0)
                        {
                            <p class="iqc-dash-empty">@T("iqc.dash.empty.pareto")</p>
                        }
                        else
                        {
                            <table class="iqc-report-table iqc-v2-par-table">
                                <thead>
                                    <tr>
                                        <th>@T("iqc.dash.pareto.defect")</th>
                                        <th>@T("iqc.dash.pareto.dist")</th>
                                        <th class="num">@T("iqc.dash.pareto.qty")</th>
                                        <th class="num">@T("iqc.dash.pareto.cum")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < _dash.VisualPareto.Count; i++)
                                    {
                                        var row = _dash.VisualPareto[i];
                                        @if (i == ParetoFocusCount)
                                        {
                                            @* Đường ngưỡng = HÀNG THẬT giữa dải ưu tiên và phần còn
                                               lại. Đặt lớp phủ tính bằng calc() thì lệch theo padding
                                               ô — một đường ngưỡng lệch là số liệu sai. *@
                                            <tr class="iqc-v2-cut">
                                                <td colspan="4">
                                                    <span class="iqc-v2-cut-lbl">@T("iqc.dash.v2.par.cut", _thrPct)</span>
                                                </td>
                                            </tr>
                                        }
                                        <tr class="iqc-v2-par-row @(i < ParetoFocusCount ? "is-focus" : null)">
                                            <td class="strong iqc-cell-ellipsis" title="@DefectLabel(row)">@DefectLabel(row)</td>
                                            <td class="iqc-v2-par-cell">
                                                <span class="iqc-v2-par-bar" style="width:@Css(100.0 * row.Count / ParetoMax)"></span>
                                            </td>
                                            <td class="num">@row.Count</td>
                                            <td class="num iqc-cell-mut">@FmtPct(row.Cumulative)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <p class="iqc-panel-note iqc-v2-foot-note">
                        @T("iqc.dash.pareto.recorded", FmtInt(ParetoTotal), _dash.VisualPareto.Count)
                    </p>
                </section>
                <section class="ix-panel iqc-panel iqc-v2-panel">
                    <div class="iqc-panel-head iqc-v2-panel-head">
                        <div>
                            <h3 class="iqc-panel-title iqc-v2-sec-title">@T("iqc.dash.trend.hero")</h3>
                            @if (TrendPeak is { } peak && TrendLow is { } low)
                            {
                                <p class="iqc-panel-note">
                                    @T("iqc.dash.trend.peak", T($"iqc.dash.month.{peak.Month}"), FmtPct(peak.NgRate))
                                    · @T("iqc.dash.trend.low", T($"iqc.dash.month.{low.Month}"), FmtPct(low.NgRate))
                                </p>
                            }
                        </div>
                    </div>
                    <div class="iqc-v2-tbars" data-testid="iqc-dash-volume"
                         role="img" aria-label="@T("iqc.dash.trend.title")">
                        @foreach (var row in _dash.MonthlyTrend)
                        {
                            <div class="iqc-v2-tbar-slot" title="@($"{T($"iqc.dash.month.{row.Month}")} — {FmtInt(row.Lots)}")">
                                <span class="iqc-v2-tbar-n">@(row.Lots > 0 ? FmtInt(row.Lots) : "")</span>
                                <span class="iqc-v2-tbar" style="height:@Css(100.0 * row.Lots / TrendMax)"></span>
                                <span class="iqc-v2-tbar-ng" style="bottom:@Css(100.0 * (row.NgRate / TrendNgMax))"></span>
                            </div>
                        }
                    </div>
                    <div class="iqc-month-strip" data-testid="iqc-dash-trend">
                        @foreach (var row in _dash.MonthlyTrend)
                        {
                            var tone = MonthTone(row);
                            <button type="button" class="iqc-month-cell @tone @(_month == row.Month ? "is-on" : null)"
                                    @onclick="() => SelectMonthAsync(row.Month)">
                                <span class="iqc-month-cell-m">@T($"iqc.dash.month.short.{row.Month}")</span>
                                @if (row.Lots == 0)
                                {
                                    <span class="iqc-month-cell-ng">—</span>
                                    <span class="iqc-month-cell-pct">—</span>
                                }
                                else
                                {
                                    <span class="iqc-month-cell-ng">@row.Ng</span>
                                    <span class="iqc-month-cell-pct">@FmtPct(row.NgRate)</span>
                                }
                            </button>
                        }
                    </div>
                    <div class="iqc-legend">
                        <span class="iqc-legend-item"><i class="iqc-swatch iqc-swatch-lots"></i>@T("iqc.dash.trend.lots")</span>
                        <span class="iqc-legend-item"><i class="iqc-swatch iqc-swatch-ng"></i>@T("iqc.dash.trend.ngrate")</span>
                    </div>
                </section>
            </div>
            <section class="ix-panel iqc-panel iqc-v2-panel">
                <div class="iqc-panel-head iqc-panel-head-tools iqc-v2-panel-head">
                    <div>
                        <h3 class="iqc-panel-title iqc-v2-sec-title">@T("iqc.dash.supplier.perf")</h3>
                        <p class="iqc-panel-note">@T("iqc.dash.supplier.showing", VisibleSuppliers.Count, NgSupplierCount, SortLabel)</p>
                    </div>
                    <div class="iqc-sup-tools">
                        <input class="ix-input iqc-sup-search" data-testid="iqc-dash-sup-search"
                               value="@_supQuery" @oninput="OnSupQuery"
                               placeholder="@T("iqc.dash.supplier.search")" />
                        <button type="button" class="iqc-chip @(_onlyNg ? "iqc-chip-on" : null)"
                                data-testid="iqc-dash-sup-onlyng" @onclick="ToggleOnlyNg">
                            @T(_onlyNg ? "iqc.dash.supplier.all" : "iqc.dash.supplier.onlyng")
                        </button>
                    </div>
                </div>

                <div class="iqc-v2-sup" data-testid="iqc-dash-suppliers">
                    @if (VisibleSuppliers.Count == 0)
                    {
                        <p class="iqc-dash-empty">@T("iqc.dash.empty.supplier")</p>
                    }
                    else
                    {
                        <div class="iqc-v2-sup-band is-alarm" data-testid="iqc-sup-band-car">
                            <p class="iqc-v2-band-title">@T("iqc.dash.v2.sup.car")</p>
                            @if (CarSuppliers.Count == 0)
                            {
                                <p class="iqc-v2-band-none">@T("iqc.dash.v2.sup.none")</p>
                            }
                            else
                            {
                                @foreach (var row in CarSuppliers)
                                {
                                    <div class="iqc-v2-sup-row">
                                        <button type="button" class="iqc-v2-sup-name" data-testid="iqc-sup-name"
                                            title="@T("iqc.dash.v2.sup.open", row.Supplier)"
                                            @onclick="() => DrillSupplier(row.Supplier)">@row.Supplier</button>
                                        <span class="iqc-v2-sup-bar"><span class="iqc-v2-sup-fill iqc-bar-alarm" style="width:@RiskBarWidth(row.NgRate)"></span></span>
                                        <span class="iqc-v2-sup-pct iqc-cell-alarm">@FmtPct(row.NgRate)</span>
                                        <span class="iqc-v2-sup-n">@T("iqc.dash.v2.sup.lots", row.Ng, row.Lots)</span>
                                        <span class="iqc-v2-sup-acts">
                                            <button type="button" class="iqc-v2-act"
                                                    @onclick="() => OnOpenCar.InvokeAsync(row.Supplier)">@T("iqc.dash.v2.act.car")</button>
                                            <button type="button" class="iqc-v2-act iqc-v2-act-ghost"
                                                    @onclick="() => OnPin.InvokeAsync(row.Supplier)">@T("iqc.dash.v2.act.pin")</button>
                                        </span>
                                    </div>
                                }
                            }
                        </div>

                        <div class="iqc-v2-sup-band is-warn" data-testid="iqc-sup-band-watch">
                            <p class="iqc-v2-band-title">@T("iqc.dash.v2.sup.watch")</p>
                            @if (WatchSuppliers.Count == 0)
                            {
                                <p class="iqc-v2-band-none">@T("iqc.dash.v2.sup.none")</p>
                            }
                            else
                            {
                                @foreach (var row in WatchSuppliers)
                                {
                                    <div class="iqc-v2-sup-row">
                                        <button type="button" class="iqc-v2-sup-name" data-testid="iqc-sup-name"
                                            title="@T("iqc.dash.v2.sup.open", row.Supplier)"
                                            @onclick="() => DrillSupplier(row.Supplier)">@row.Supplier</button>
                                        <span class="iqc-v2-sup-bar"><span class="iqc-v2-sup-fill iqc-bar-warn" style="width:@RiskBarWidth(row.NgRate)"></span></span>
                                        <span class="iqc-v2-sup-pct is-warn">@FmtPct(row.NgRate)</span>
                                        <span class="iqc-v2-sup-n">@T("iqc.dash.v2.sup.lots", row.Ng, row.Lots)</span>
                                        <span class="iqc-v2-sup-acts">
                                            <button type="button" class="iqc-v2-act iqc-v2-act-ghost"
                                                    @onclick="() => OnPin.InvokeAsync(row.Supplier)">@T("iqc.dash.v2.act.pin")</button>
                                        </span>
                                    </div>
                                }
                            }
                                                @if (CarHidden > 0)
                        {
                            <button type="button" class="iqc-v2-sup-more" data-testid="iqc-sup-more-car"
                                    @onclick="() => Drill(IqcDrill.Suppliers)">
                                @T("iqc.dash.v2.sup.more", CarHidden)
                            </button>
                        }
                        @if (WatchHidden > 0)
                        {
                            <button type="button" class="iqc-v2-sup-more" data-testid="iqc-sup-more-watch"
                                    @onclick="() => Drill(IqcDrill.Suppliers)">
                                @T("iqc.dash.v2.sup.more", WatchHidden)
                            </button>
                        }
</div>

                        <button type="button" class="iqc-v2-sup-rest" data-testid="iqc-sup-band-rest"
                                @onclick="() => Drill(IqcDrill.Suppliers)">
                            @T("iqc.dash.v2.sup.rest", RestSuppliers.Count, FmtPct(RestNgRate))
                        </button>
                    }
                </div>
            </section>
        </div>

        <p class="iqc-dash-foot iqc-v2-colophon">
            <span>@T("iqc.dash.footer.source", FmtInt(_dash.Total), _dash.Suppliers.Count)</span>
            <span>@T("iqc.dash.footer.unit")</span>
        </p>
    }
</section>

@code {
    /// <summary>Ô số / hàng nào được bấm — cho trang cha lọc sang IQC Data.</summary>
    public enum IqcDrill { All, Ng, Nq, WideOos, Claim, Pending, Pass, Suppliers }

    /// <summary>Kèm theo drill: NCC cụ thể khi người dùng bấm vào TÊN nhà cung
    /// cấp. Dùng record struct thay vì thêm tham số thứ hai để hợp đồng
    /// EventCallback còn một kiểu duy nhất, mở rộng sau không phá call site.</summary>
    public readonly record struct IqcDrillArgs(IqcDrill What, string? Supplier = null);

    private enum SupSort { Ng, NgRate, Lots, Nq, Name }

    /// <summary>Bấm một ô số / hàng → cha nhảy sang tab dữ liệu đã lọc.</summary>
    [Parameter] public EventCallback<IqcDrillArgs> OnDrill { get; set; }
    /// <summary>Mở CAR / claim. Tham số là NCC, hoặc null khi mở từ khối quyết định.</summary>
    [Parameter] public EventCallback<string?> OnOpenCar { get; set; }
    /// <summary>Ghim NCC vào watchlist.</summary>
    [Parameter] public EventCallback<string> OnPin { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback OnPrint { get; set; }

    private IqcDashboardResponse _dash = new();
    private int? _year;
    private int? _month;
    private bool _loading = true;
    private string _supQuery = "";
    private bool _onlyNg;
    private SupSort _sort = SupSort.Ng;
    private bool _sortDesc = true;
    private int _thrPct = 80;

    /// <summary>Ngưỡng gộp NCC — trên 5% là yêu cầu CAR, 2–5% là theo dõi.</summary>
    private const double CarRate = 0.05, WatchRate = 0.02;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _thrPct = DashPrefs.GetThresholdPct();
    }

    protected override async Task OnInitializedAsync() => await LoadAsync(_year, _month);

    public async Task ReloadAsync()
    {
        await LoadAsync(_year, _month);
        await InvokeAsync(StateHasChanged);
    }

    private Task Drill(IqcDrill what) => OnDrill.InvokeAsync(new IqcDrillArgs(what));

    /// <summary>Bấm TÊN nhà cung cấp = "cho tôi xem các lô NG của NCC này".</summary>
    private Task DrillSupplier(string supplier)
        => OnDrill.InvokeAsync(new IqcDrillArgs(IqcDrill.Ng, supplier));

    private async Task LoadAsync(int? year, int? month)
    {
        _loading = true;
        try
        {
            _dash = await Api.GetIqcDashboardAsync(year, month);
            _year = _dash.Year;
            _month = _dash.Month;
        }
        catch
        {
            _dash = new IqcDashboardResponse();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y > 0)
            await LoadAsync(y, _month);
    }

    private Task SelectMonthAsync(int? month)
        => LoadAsync(_year, _month == month ? null : month);

    private void OnSupQuery(ChangeEventArgs e) => _supQuery = e.Value?.ToString() ?? "";

    private void ToggleOnlyNg() => _onlyNg = !_onlyNg;

    private string PeriodLabel
    {
        get
        {
            if (_year is null) return T("iqc.dash.desc");
            var scope = _month is int m ? T($"iqc.dash.month.{m}") : T("iqc.dash.filter.month.all");
            return T("iqc.dash.period", scope, _year.Value, FmtInt(_dash.Total));
        }
    }

    private int LotsIn(int month)
        => _dash.MonthlyTrend.FirstOrDefault(x => x.Month == month)?.Lots ?? 0;

    private int TrendMax => Math.Max(1, _dash.MonthlyTrend.Count == 0 ? 1 : _dash.MonthlyTrend.Max(x => x.Lots));

    private double TrendNgMax
    {
        get
        {
            var max = _dash.MonthlyTrend.Count == 0 ? 0 : _dash.MonthlyTrend.Max(x => x.NgRate);
            return max <= 0 ? 0.04 : Math.Ceiling(max * 100) / 100;
        }
    }

    private int ParetoTotal => _dash.VisualPareto.Sum(x => x.Count);
    private int ParetoMax => Math.Max(1, _dash.VisualPareto.Count == 0 ? 1 : _dash.VisualPareto.Max(x => x.Count));
    private double ParetoThr => _thrPct / 100.0;

    private int ParetoFocusCount
    {
        get
        {
            if (_dash.VisualPareto.Count == 0) return 0;
            var n = _dash.VisualPareto.Count(r => r.Cumulative <= ParetoThr + 1e-9);
            return n == 0 ? 1 : n;
        }
    }

    private double ParetoFocusCum
        => ParetoFocusCount <= 0 ? 0 : _dash.VisualPareto[ParetoFocusCount - 1].Cumulative;

    private void OnThrChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
        {
            _thrPct = Math.Clamp(n, 50, 100);
            DashPrefs.SetThresholdPct(_thrPct);
        }
    }

    private bool IsEnglish => LanguageService.Current == LanguageCode.English;

    private string DefectLabel(IqcParetoRow row)
    {
        var vi = string.IsNullOrWhiteSpace(row.LabelVi) ? null : row.LabelVi.Trim();
        var en = string.IsNullOrWhiteSpace(row.LabelEn) ? null : row.LabelEn.Trim();
        return IsEnglish ? en ?? vi ?? row.Defect : vi ?? en ?? row.Defect;
    }

    private string NqPerNg
        => _dash.Fail <= 0 ? "—" : ((double)_dash.TotalNqDefects / _dash.Fail).ToString("0.00", CultureInfo.CurrentCulture);

    private string LeadTone
        => _dash.Total <= 0 ? "" : _dash.FailRate > CarRate ? "is-alarm" : _dash.FailRate >= WatchRate ? "is-warn" : "is-ok";

    private int DecisionCount
        => (_dash.WideOosLots > 0 ? 1 : 0) + (_dash.ClaimNgLots > 0 ? 1 : 0) + (_dash.Pending > 0 ? 1 : 0);

    private IqcMonthlyTrendRow? TrendPeak
        => _dash.MonthlyTrend.Where(x => x.Lots > 0).OrderByDescending(x => x.NgRate).ThenByDescending(x => x.Ng).FirstOrDefault();

    private IqcMonthlyTrendRow? TrendLow
        => _dash.MonthlyTrend.Where(x => x.Lots > 0).OrderBy(x => x.NgRate).ThenBy(x => x.Ng).FirstOrDefault();

    /// <summary>Hai tháng CÓ DỮ LIỆU gần nhất — nền của câu kết luận.</summary>
    private (IqcMonthlyTrendRow Prev, IqcMonthlyTrendRow Last)? LastTwoMonths
    {
        get
        {
            var with = _dash.MonthlyTrend.Where(x => x.Lots > 0).ToList();
            return with.Count < 2 ? null : (with[^2], with[^1]);
        }
    }

    private string VerdictHeadline
    {
        get
        {
            if (_dash.Total <= 0) return T("iqc.dash.v2.verdict.nodata");
            if (LastTwoMonths is not { } mm) return T("iqc.dash.v2.verdict.flat", FmtPct(_dash.FailRate));
            var delta = mm.Last.NgRate - mm.Prev.NgRate;
            var key = Math.Abs(delta) < 0.005 ? "flat.two" : delta > 0 ? "up" : "down";
            return T($"iqc.dash.v2.verdict.{key}",
                T($"iqc.dash.month.{mm.Last.Month}"), FmtPct(mm.Last.NgRate),
                T($"iqc.dash.month.{mm.Prev.Month}"), FmtPct(mm.Prev.NgRate));
        }
    }

    private string VerdictStandfirst
    {
        get
        {
            if (_dash.VisualPareto.Count == 0) return T("iqc.dash.insight.empty");
            var names = string.Join(" · ", _dash.VisualPareto.Take(ParetoFocusCount == 0 ? 1 : Math.Min(3, ParetoFocusCount)).Select(DefectLabel));
            var worst = _dash.Suppliers.OrderByDescending(x => x.NgRate).ThenByDescending(x => x.Ng).FirstOrDefault(x => x.Ng > 0);
            return worst is null
                ? T("iqc.dash.v2.verdict.stand.nosup", names, FmtPct(ParetoFocusCum))
                : T("iqc.dash.v2.verdict.stand", names, FmtPct(ParetoFocusCum), worst.Supplier, FmtPct(worst.NgRate));
        }
    }

    private IReadOnlyList<IqcSupplierStatRow> VisibleSuppliers
    {
        get
        {
            IEnumerable<IqcSupplierStatRow> q = _dash.Suppliers;
            if (_onlyNg) q = q.Where(x => x.Ng > 0);
            if (!string.IsNullOrWhiteSpace(_supQuery))
            {
                var s = _supQuery.Trim();
                q = q.Where(x => x.Supplier.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            q = _sort switch
            {
                SupSort.Name => _sortDesc ? q.OrderByDescending(x => x.Supplier) : q.OrderBy(x => x.Supplier),
                SupSort.Lots => _sortDesc ? q.OrderByDescending(x => x.Lots) : q.OrderBy(x => x.Lots),
                SupSort.NgRate => _sortDesc ? q.OrderByDescending(x => x.NgRate) : q.OrderBy(x => x.NgRate),
                SupSort.Nq => _sortDesc ? q.OrderByDescending(x => x.NqDefects) : q.OrderBy(x => x.NqDefects),
                _ => _sortDesc ? q.OrderByDescending(x => x.Ng) : q.OrderBy(x => x.Ng),
            };
            return q.ToList();
        }
    }

    /// <summary>Số dòng tối đa mỗi dải. Dữ liệu thật có 15 NCC vượt 5%: liệt kê
    /// hết thì cột NCC dài hơn cột Pareto ~480px, và một "danh sách việc cần
    /// làm" 15 dòng thì không còn là danh sách việc cần làm.</summary>
    private const int BandCap = 8;

    private IReadOnlyList<IqcSupplierStatRow> CarAll
        => VisibleSuppliers.Where(x => x.NgRate > CarRate).OrderByDescending(x => x.NgRate).ToList();

    private IReadOnlyList<IqcSupplierStatRow> WatchAll
        => VisibleSuppliers.Where(x => x.NgRate >= WatchRate && x.NgRate <= CarRate)
                           .OrderByDescending(x => x.NgRate).ToList();

    private IReadOnlyList<IqcSupplierStatRow> CarSuppliers => CarAll.Take(BandCap).ToList();
    private IReadOnlyList<IqcSupplierStatRow> WatchSuppliers => WatchAll.Take(BandCap).ToList();

    private int CarHidden => Math.Max(0, CarAll.Count - BandCap);
    private int WatchHidden => Math.Max(0, WatchAll.Count - BandCap);

    private IReadOnlyList<IqcSupplierStatRow> RestSuppliers
        => VisibleSuppliers.Where(x => x.NgRate < WatchRate).ToList();

    private double RestNgRate
    {
        get
        {
            var lots = RestSuppliers.Sum(x => x.Lots);
            return lots <= 0 ? 0 : (double)RestSuppliers.Sum(x => x.Ng) / lots;
        }
    }

    private int NgSupplierCount => _dash.Suppliers.Count(x => x.Ng > 0);

    private string SortLabel => _sort switch
    {
        SupSort.Name => T("iqc.dash.supplier.name"),
        SupSort.Lots => T("iqc.dash.trend.lots"),
        SupSort.NgRate => T("iqc.dash.trend.ngrate"),
        SupSort.Nq => T("iqc.dash.kpi.nq"),
        _ => T("iqc.dash.trend.ng"),
    };

    private string MonthTone(IqcMonthlyTrendRow row)
    {
        if (row.Lots == 0) return "is-empty";
        if (TrendPeak is { } p && p.Month == row.Month) return "is-peak";
        if (TrendLow is { } l && l.Month == row.Month) return "is-low";
        return "";
    }

    private string RiskBarWidth(double rate)
    {
        var cap = Math.Max(0.10, VisibleSuppliers.Select(x => x.NgRate).DefaultIfEmpty(0).Max());
        return Css(100.0 * rate / cap);
    }

    private static string Css(double pct) => Math.Clamp(pct, 0, 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    private static string FmtInt(int n) => n.ToString("N0", CultureInfo.CurrentCulture);
    private static string FmtPct(double rate) => (rate * 100).ToString("0.0", CultureInfo.CurrentCulture) + "%";
}
