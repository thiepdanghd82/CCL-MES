@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Quality
@using CCL.MES.Shared.Localization
@using System.Globalization
@inject ICclApiClient Api

@*
    IQC Dashboard — layout theo IQC-Dashboard-standalone.html (báo cáo NQ):
    hero navy · 6 thẻ KPI · Pareto SVG + bảng · xu hướng full-width · NCC.
    Dữ liệu live API; màu/khoảng cách đi qua token (L37 / design tokens).
*@

<section class="qms-section iqc-dash" data-testid="iqc-dash">
    <header class="iqc-dash-hero">
        <div class="iqc-dash-hero-main">
            <p class="iqc-dash-hero-eye">@T("iqc.dash.eyebrow")</p>
            <h2 class="iqc-dash-hero-title">@T("iqc.dash.hero")</h2>
            <p class="iqc-dash-hero-sub">@PeriodLabel</p>
        </div>
        <div class="iqc-dash-hero-tools">
            <label class="iqc-dash-year">
                <span class="iqc-dash-year-lbl">@T("iqc.dash.filter.year")</span>
                <select class="ix-input iqc-dash-select" data-testid="iqc-dash-year"
                        value="@(_year?.ToString() ?? "")" @onchange="OnYearChanged">
                    @if (_dash.AvailableYears.Count == 0)
                    {
                        <option value="">—</option>
                    }
                    else
                    {
                        @foreach (var y in _dash.AvailableYears)
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </label>
        </div>
    </header>

    <div class="iqc-dash-months" role="group" aria-label="@T("iqc.dash.filter.month")"
         data-testid="iqc-dash-month">
        <button type="button" class="iqc-chip @(_month is null ? "iqc-chip-on" : null)"
                data-testid="iqc-dash-month-all" aria-pressed="@(_month is null)"
                @onclick="() => SelectMonthAsync(null)">@T("iqc.dash.filter.month.all")</button>
        @for (var m = 1; m <= 12; m++)
        {
            var mm = m;
            var lots = LotsIn(mm);
            <button type="button"
                    class="iqc-chip @(_month == mm ? "iqc-chip-on" : null) @(lots == 0 ? "iqc-chip-empty" : null)"
                    data-testid="@($"iqc-dash-month-{mm}")" aria-pressed="@(_month == mm)"
                    title="@($"{T($"iqc.dash.month.{mm}")} — {FmtInt(lots)}")"
                    @onclick="() => SelectMonthAsync(mm)">@T($"iqc.dash.month.short.{mm}")</button>
        }
    </div>

    @if (_loading && _dash.AvailableYears.Count == 0)
    {
        <p class="qms-section-desc">@T("iqc.data.loading")</p>
    }
    else
    {
        <div class="iqc-kpis" data-testid="iqc-dash-kpi-strip">
            <article class="iqc-kcard iqc-kcard-ink" data-testid="iqc-kpi-total">
                <span class="iqc-kcard-lbl">@T("iqc.dash.kpi.lots")</span>
                <span class="iqc-kcard-val">@FmtInt(_dash.Total)</span>
                <span class="iqc-kcard-sub">
                    @T("iqc.dash.kpi.pass")
                    <b data-testid="iqc-kpi-pass">@FmtInt(_dash.Pass)</b>
                    · @T("iqc.dash.pending") @FmtInt(_dash.Pending)
                </span>
            </article>
            <article class="iqc-kcard iqc-kcard-ok" data-testid="iqc-kpi-passrate">
                <span class="iqc-kcard-lbl">@T("iqc.dash.kpi.passrate")</span>
                <span class="iqc-kcard-val is-ok">@FmtPct(_dash.PassRate)</span>
                <span class="iqc-sum-gauge" role="img" aria-label="@FmtPct(_dash.PassRate)">
                    <span class="iqc-sum-gauge-fill" style="width:@Css(_dash.PassRate * 100)"></span>
                </span>
            </article>
            <article class="iqc-kcard iqc-kcard-ng">
                <span class="iqc-kcard-lbl">@T("iqc.dash.kpi.fail")</span>
                <span class="iqc-kcard-val is-ng" data-testid="iqc-kpi-fail">@FmtInt(_dash.Fail)</span>
                <span class="iqc-kcard-sub" data-testid="iqc-kpi-failrate">
                    @T("iqc.dash.kpi.failrate") <b class="is-ng">@FmtPct(_dash.FailRate)</b>
                </span>
            </article>
            <article class="iqc-kcard iqc-kcard-warn" data-testid="iqc-kpi-nq">
                <span class="iqc-kcard-lbl">@T("iqc.dash.kpi.nq")</span>
                <span class="iqc-kcard-val is-warn">@FmtInt(_dash.TotalNqDefects)</span>
                <span class="iqc-kcard-sub">@T("iqc.dash.kpi.nq.per", NqPerNg)</span>
            </article>
            <article class="iqc-kcard" data-testid="iqc-kpi-claim">
                <span class="iqc-kcard-lbl">@T("iqc.dash.kpi.claim")</span>
                <span class="iqc-kcard-val">@FmtInt(_dash.ClaimNgLots)</span>
                <span class="iqc-kcard-sub">@T("iqc.dash.kpi.claim.share", FmtPct(ClaimShare))</span>
            </article>
            <article class="iqc-kcard" data-testid="iqc-kpi-wide">
                <span class="iqc-kcard-lbl">@T("iqc.dash.kpi.wide")</span>
                <span class="iqc-kcard-val">@FmtInt(_dash.WideOosLots)</span>
                <span class="iqc-kcard-sub">@T("iqc.dash.kpi.wide.share", FmtPct(WideShare))</span>
            </article>
        </div>

        <div class="iqc-split">
            <section class="ix-panel iqc-panel iqc-panel-chart">
                <div class="iqc-panel-head">
                    <div>
                        <h3 class="iqc-panel-title">@T("iqc.dash.pareto.title")</h3>
                        @if (ParetoFocusCount > 0)
                        {
                            <p class="iqc-panel-note">@T("iqc.dash.pareto.top3", ParetoFocusCount, FmtPct(ParetoFocusCum))</p>
                        }
                    </div>
                    <label class="iqc-thr">
                        <span class="iqc-thr-lbl">@T("iqc.dash.pareto.legend.thr")</span>
                        <input type="range" min="50" max="100" step="1" value="@_thrPct"
                               data-testid="iqc-dash-pareto-thr"
                               aria-valuemin="50" aria-valuemax="100" aria-valuenow="@_thrPct"
                               aria-label="@T("iqc.dash.pareto.legend.thr")"
                               @oninput="OnThrChanged" />
                        <span class="iqc-thr-val" data-testid="iqc-dash-pareto-thr-val">@($"{_thrPct}%")</span>
                    </label>
                </div>
                @if (_dash.VisualPareto.Count == 0)
                {
                    <p class="iqc-dash-empty">@T("iqc.dash.empty.pareto")</p>
                }
                else
                {
                    <div class="iqc-chart-host">
                    <svg class="iqc-svg" viewBox="0 0 1000 340" preserveAspectRatio="none"
                         data-testid="iqc-dash-pareto-chart"
                         role="img" aria-label="@T("iqc.dash.pareto.title")">
                        <g class="iqc-svg-grid">
                            @foreach (var gy in GridY)
                            {
                                <line x1="@PlotL" y1="@F(gy)" x2="@PlotR" y2="@F(gy)"></line>
                            }
                        </g>
                        <g class="iqc-svg-axis">
                            @for (var i = 0; i <= 4; i++)
                            {
                                var y = PlotT + PlotH * (4 - i) / 4.0;
                                @SvgText("52", F(y + 4), FmtInt(ParetoMax * i / 4), "text-anchor=\"end\"")
                                @SvgText("968", F(y + 4), $"{i * 25}%")
                            }
                        </g>
                        <line class="iqc-svg-thr" x1="@PlotL" y1="@F(YCum(ParetoThr))" x2="@PlotR" y2="@F(YCum(ParetoThr))"></line>
                        @SvgText("64", F(YCum(ParetoThr) - 6), $"{_thrPct}%", "class=\"iqc-svg-thr-lbl\"")
                        <g class="iqc-svg-bars">
                            @for (var i = 0; i < _dash.VisualPareto.Count; i++)
                            {
                                var row = _dash.VisualPareto[i];
                                var h = PlotH * row.Count / ParetoMax;
                                <rect x="@F(BarX(i, _dash.VisualPareto.Count))" y="@F(PlotB - h)"
                                      width="@F(BarW(_dash.VisualPareto.Count))" height="@F(Math.Max(h, 1))"></rect>
                                @SvgText(F(SlotMid(i, _dash.VisualPareto.Count)), F(PlotB - h - 6), row.Count.ToString(),
                                    "class=\"iqc-svg-bar-lbl\" text-anchor=\"middle\"")
                            }
                        </g>
                        <polyline class="iqc-chart-line iqc-svg-cum"
                                  points="@Polyline(_dash.VisualPareto.Select(r => r.Cumulative))"
                                  fill="none" />
                        @for (var i = 0; i < _dash.VisualPareto.Count; i++)
                        {
                            <circle class="iqc-svg-dot-cum" cx="@F(SlotMid(i, _dash.VisualPareto.Count))"
                                    cy="@F(YCum(_dash.VisualPareto[i].Cumulative))" r="3.2"></circle>
                        }
                        <g class="iqc-svg-x">
                            @for (var i = 0; i < _dash.VisualPareto.Count; i++)
                            {
                                var mx = SlotMid(i, _dash.VisualPareto.Count);
                                @SvgText(F(mx), "292", DefectLabel(_dash.VisualPareto[i]),
                                    $"text-anchor=\"end\" transform=\"rotate(-32 {F(mx)} 292)\"")
                            }
                        </g>
                    </svg>
                    </div>
                    <div class="iqc-legend">
                        <span class="iqc-legend-item"><i class="iqc-swatch iqc-swatch-lots"></i>@T("iqc.dash.pareto.legend.qty")</span>
                        <span class="iqc-legend-item"><i class="iqc-swatch iqc-swatch-cum"></i>@T("iqc.dash.pareto.legend.cum")</span>
                        <span class="iqc-legend-item"><i class="iqc-swatch iqc-swatch-thr"></i>@T("iqc.dash.pareto.legend.thr")</span>
                    </div>
                }
            </section>

            <section class="ix-panel iqc-panel iqc-panel-detail">
                <div class="iqc-panel-head">
                    <h3 class="iqc-panel-title">@T("iqc.dash.pareto.detail")</h3>
                    <p class="iqc-panel-note">@T("iqc.dash.pareto.recorded", FmtInt(ParetoTotal), _dash.VisualPareto.Count)</p>
                </div>
                <div class="iqc-table-wrap">
                    <table class="iqc-report-table" data-testid="iqc-dash-pareto">
                        <thead>
                            <tr>
                                <th>@T("iqc.dash.pareto.defect")</th>
                                <th class="num">@T("iqc.dash.pareto.qty")</th>
                                <th class="num">@T("iqc.dash.pareto.share")</th>
                                <th class="num">@T("iqc.dash.pareto.cum")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_dash.VisualPareto.Count == 0)
                            {
                                <tr><td colspan="4" class="iqc-dash-empty">@T("iqc.dash.empty.pareto")</td></tr>
                            }
                            else
                            {
                                @for (var i = 0; i < _dash.VisualPareto.Count; i++)
                                {
                                    var row = _dash.VisualPareto[i];
                                    <tr class="@(i < ParetoFocusCount ? "is-focus" : null)">
                                        <td class="strong">@DefectLabel(row)</td>
                                        <td class="num">@row.Count</td>
                                        <td class="num">@FmtPct(row.Share)</td>
                                        <td class="num iqc-cell-mut">@FmtPct(row.Cumulative)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <section class="ix-panel iqc-panel">
            <div class="iqc-panel-head">
                <h3 class="iqc-panel-title">@T("iqc.dash.trend.hero")</h3>
                @if (TrendPeak is { } peak && TrendLow is { } low)
                {
                    <p class="iqc-panel-note">
                        @T("iqc.dash.trend.peak", T($"iqc.dash.month.{peak.Month}"), FmtPct(peak.NgRate))
                        · @T("iqc.dash.trend.low", T($"iqc.dash.month.{low.Month}"), FmtPct(low.NgRate))
                    </p>
                }
            </div>
            <svg class="iqc-svg iqc-chart-box-trend" viewBox="0 0 1000 300" data-testid="iqc-dash-volume"
                 role="img" aria-label="@T("iqc.dash.trend.title")">
                <g class="iqc-svg-grid">
                    @foreach (var gy in GridY)
                    {
                        <line x1="@PlotL" y1="@F(gy)" x2="@PlotR" y2="@F(gy)"></line>
                    }
                </g>
                <g class="iqc-svg-axis">
                    @for (var i = 0; i <= 4; i++)
                    {
                        var y = PlotT + PlotH * (4 - i) / 4.0;
                        @SvgText("52", F(y + 4), FmtInt(TrendMax * i / 4), "text-anchor=\"end\"")
                        @SvgText("968", F(y + 4), FmtPct(TrendNgMax * i / 4.0))
                    }
                </g>
                @if (EmptyFrom is int emptyFrom)
                {
                    var x0 = SlotMid(emptyFrom - 1, 12) - BarW(12);
                    <rect class="iqc-svg-empty" x="@F(x0)" y="@PlotT" width="@F(PlotR - x0)" height="@F(PlotH)"></rect>
                    @SvgText(F((x0 + PlotR) / 2), "150", T("iqc.dash.trend.nodata"),
                        "class=\"iqc-svg-empty-lbl\" text-anchor=\"middle\"")
                }
                <g class="iqc-svg-bars-soft">
                    @for (var i = 0; i < _dash.MonthlyTrend.Count; i++)
                    {
                        var row = _dash.MonthlyTrend[i];
                        if (row.Lots <= 0) continue;
                        var h = PlotH * row.Lots / TrendMax;
                        <rect x="@F(BarX(i, 12))" y="@F(PlotB - h)"
                              width="@F(BarW(12))" height="@F(h)"></rect>
                        @SvgText(F(SlotMid(i, 12)), F(PlotB - h - 6), row.Lots.ToString(),
                            "class=\"iqc-svg-bar-lbl-mut\" text-anchor=\"middle\"")
                    }
                </g>
                <polyline class="iqc-chart-line iqc-svg-ng"
                          points="@Polyline(_dash.MonthlyTrend.Select(r => r.NgRate / TrendNgMax))"
                          fill="none" />
                @for (var i = 0; i < _dash.MonthlyTrend.Count; i++)
                {
                    var r = _dash.MonthlyTrend[i];
                    if (r.Lots <= 0 && r.Ng <= 0) continue;
                    <circle class="iqc-svg-dot-ng" cx="@F(SlotMid(i, 12))"
                            cy="@F(YCum(r.NgRate / TrendNgMax))" r="4"></circle>
                }
                <g class="iqc-svg-x-flat">
                    @for (var i = 0; i < _dash.MonthlyTrend.Count; i++)
                    {
                        var empty = _dash.MonthlyTrend[i].Lots == 0;
                        @SvgText(F(SlotMid(i, 12)), "290", T($"iqc.dash.month.short.{_dash.MonthlyTrend[i].Month}"),
                            $"text-anchor=\"middle\"{(empty ? " class=\"is-empty\"" : "")}")
                    }
                </g>
            </svg>
            <div class="iqc-month-strip" data-testid="iqc-dash-trend">
                @foreach (var row in _dash.MonthlyTrend)
                {
                    var tone = MonthTone(row);
                    <button type="button" class="iqc-month-cell @tone @(_month == row.Month ? "is-on" : null)"
                            @onclick="() => SelectMonthAsync(row.Month)">
                        <span class="iqc-month-cell-m">@T($"iqc.dash.month.short.{row.Month}")</span>
                        @if (row.Lots == 0)
                        {
                            <span class="iqc-month-cell-ng">—</span>
                            <span class="iqc-month-cell-pct">—</span>
                        }
                        else
                        {
                            <span class="iqc-month-cell-ng">@row.Ng</span>
                            <span class="iqc-month-cell-pct">@FmtPct(row.NgRate)</span>
                        }
                    </button>
                }
            </div>
        </section>

        <section class="ix-panel iqc-panel">
            <div class="iqc-panel-head iqc-panel-head-tools">
                <div>
                    <h3 class="iqc-panel-title">@T("iqc.dash.supplier.perf")</h3>
                    <p class="iqc-panel-note">@T("iqc.dash.supplier.showing", VisibleSuppliers.Count, NgSupplierCount, SortLabel)</p>
                </div>
                <div class="iqc-sup-tools">
                    <input class="ix-input iqc-sup-search" data-testid="iqc-dash-sup-search"
                           value="@_supQuery" @oninput="OnSupQuery"
                           placeholder="@T("iqc.dash.supplier.search")" />
                    <button type="button" class="iqc-chip @(_onlyNg ? "iqc-chip-on" : null)"
                            data-testid="iqc-dash-sup-onlyng" @onclick="ToggleOnlyNg">
                        @T(_onlyNg ? "iqc.dash.supplier.all" : "iqc.dash.supplier.onlyng")
                    </button>
                </div>
            </div>
            <div class="iqc-table-wrap">
                <table class="iqc-report-table iqc-sup-table" data-testid="iqc-dash-suppliers">
                    <thead>
                        <tr>
                            <th><button type="button" class="iqc-th-btn" @onclick="() => SortBy(SupSort.Name)">@T("iqc.dash.supplier.name") @Arrow(SupSort.Name)</button></th>
                            <th class="num"><button type="button" class="iqc-th-btn" @onclick="() => SortBy(SupSort.Lots)">@T("iqc.dash.trend.lots") @Arrow(SupSort.Lots)</button></th>
                            <th class="num"><button type="button" class="iqc-th-btn" @onclick="() => SortBy(SupSort.Ng)">@T("iqc.dash.trend.ng") @Arrow(SupSort.Ng)</button></th>
                            <th class="num"><button type="button" class="iqc-th-btn" @onclick="() => SortBy(SupSort.NgRate)">@T("iqc.dash.trend.ngrate") @Arrow(SupSort.NgRate)</button></th>
                            <th>@T("iqc.dash.supplier.risk")</th>
                            <th class="num"><button type="button" class="iqc-th-btn" @onclick="() => SortBy(SupSort.Nq)">@T("iqc.dash.kpi.nq") @Arrow(SupSort.Nq)</button></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (VisibleSuppliers.Count == 0)
                        {
                            <tr><td colspan="6" class="iqc-dash-empty">@T("iqc.dash.empty.supplier")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in VisibleSuppliers)
                            {
                                <tr>
                                    <td class="strong iqc-cell-ellipsis" title="@row.Supplier">@row.Supplier</td>
                                    <td class="num">@row.Lots</td>
                                    <td class="num @(row.Ng > 0 ? "iqc-cell-alarm" : "iqc-cell-mut")">@row.Ng</td>
                                    <td class="num @RiskClass(row.NgRate)">@FmtPct(row.NgRate)</td>
                                    <td>
                                        <span class="iqc-bar" title="@FmtPct(row.NgRate)">
                                            <span class="iqc-bar-fill @RiskFill(row.NgRate)"
                                                  style="width:@RiskBarWidth(row.NgRate)"></span>
                                        </span>
                                    </td>
                                    <td class="num iqc-cell-mut">@row.NqDefects</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>@T("iqc.dash.supplier.total", VisibleSuppliers.Count)</td>
                            <td class="num">@VisibleSuppliers.Sum(x => x.Lots)</td>
                            <td class="num">@VisibleSuppliers.Sum(x => x.Ng)</td>
                            <td class="num">@FmtPct(VisibleNgRate)</td>
                            <td></td>
                            <td class="num">@VisibleSuppliers.Sum(x => x.NqDefects)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="iqc-legend iqc-legend-pad">
                <span class="iqc-legend-item"><i class="iqc-swatch iqc-swatch-lots"></i>@T("iqc.dash.supplier.leg.ok")</span>
                <span class="iqc-legend-item"><i class="iqc-swatch iqc-swatch-warn"></i>@T("iqc.dash.supplier.leg.watch")</span>
                <span class="iqc-legend-item"><i class="iqc-swatch iqc-swatch-ng"></i>@T("iqc.dash.supplier.leg.car")</span>
            </div>
        </section>

        <div class="iqc-insights">
            <article class="iqc-insight iqc-insight-ng">
                <h4>@T("iqc.dash.insight.priority")</h4>
                <p>@PriorityInsight</p>
            </article>
            <article class="iqc-insight iqc-insight-warn">
                <h4>@T("iqc.dash.insight.risk")</h4>
                <p>@RiskInsight</p>
            </article>
            <article class="iqc-insight iqc-insight-ok">
                <h4>@T("iqc.dash.insight.ok")</h4>
                <p>@TrendInsight</p>
            </article>
        </div>

        <p class="iqc-dash-foot">
            <span>@T("iqc.dash.footer.source", FmtInt(_dash.Total), _dash.Suppliers.Count)</span>
            <span>@T("iqc.dash.footer.unit")</span>
        </p>
    }
</section>

@code {
    private enum SupSort { Ng, NgRate, Lots, Nq, Name }

    private IqcDashboardResponse _dash = new();
    private int? _year;
    private int? _month;
    private bool _loading = true;
    private string _supQuery = "";
    private bool _onlyNg;
    private SupSort _sort = SupSort.Ng;
    private bool _sortDesc = true;
    private int _thrPct = 80;

    private const double PlotL = 60, PlotR = 960, PlotT = 20, PlotB = 270;
    private const double PlotH = PlotB - PlotT;
    private static readonly double[] GridY = { 270, 207.5, 145, 82.5, 20 };

    protected override async Task OnInitializedAsync() => await LoadAsync(_year, _month);

    public async Task ReloadAsync()
    {
        await LoadAsync(_year, _month);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync(int? year, int? month)
    {
        _loading = true;
        try
        {
            _dash = await Api.GetIqcDashboardAsync(year, month);
            _year = _dash.Year;
            _month = _dash.Month;
        }
        catch
        {
            _dash = new IqcDashboardResponse();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y > 0)
            await LoadAsync(y, _month);
    }

    private Task SelectMonthAsync(int? month)
        => LoadAsync(_year, _month == month ? null : month);

    private void OnSupQuery(ChangeEventArgs e) => _supQuery = e.Value?.ToString() ?? "";

    private void ToggleOnlyNg() => _onlyNg = !_onlyNg;

    private void SortBy(SupSort col)
    {
        if (_sort == col) _sortDesc = !_sortDesc;
        else { _sort = col; _sortDesc = col != SupSort.Name; }
    }

    private string Arrow(SupSort col)
        => _sort != col ? "" : _sortDesc ? "↓" : "↑";

    private string PeriodLabel
    {
        get
        {
            if (_year is null) return T("iqc.dash.desc");
            var scope = _month is int m ? T($"iqc.dash.month.{m}") : T("iqc.dash.filter.month.all");
            return T("iqc.dash.period", scope, _year.Value, FmtInt(_dash.Total));
        }
    }

    private int LotsIn(int month)
        => _dash.MonthlyTrend.FirstOrDefault(x => x.Month == month)?.Lots ?? 0;

    private int TrendMax => Math.Max(1, _dash.MonthlyTrend.Count == 0 ? 1 : _dash.MonthlyTrend.Max(x => x.Lots));

    private double TrendNgMax
    {
        get
        {
            var max = _dash.MonthlyTrend.Count == 0 ? 0 : _dash.MonthlyTrend.Max(x => x.NgRate);
            return max <= 0 ? 0.04 : Math.Ceiling(max * 100) / 100;
        }
    }

    private int ParetoTotal => _dash.VisualPareto.Sum(x => x.Count);
    private int ParetoMax => Math.Max(1, _dash.VisualPareto.Count == 0 ? 1 : _dash.VisualPareto.Max(x => x.Count));
    private double ParetoThr => _thrPct / 100.0;
    private double? ParetoTop3Cum => _dash.VisualPareto.Count == 0
        ? null
        : _dash.VisualPareto[Math.Min(2, _dash.VisualPareto.Count - 1)].Cumulative;

    private int ParetoFocusCount
    {
        get
        {
            if (_dash.VisualPareto.Count == 0) return 0;
            var n = _dash.VisualPareto.Count(r => r.Cumulative <= ParetoThr + 1e-9);
            return n == 0 ? 1 : n;
        }
    }

    private double ParetoFocusCum
        => ParetoFocusCount <= 0 ? 0 : _dash.VisualPareto[ParetoFocusCount - 1].Cumulative;

    private void OnThrChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
            _thrPct = Math.Clamp(n, 50, 100);
    }

    private bool IsEnglish => LanguageService.Current == LanguageCode.English;

    private string DefectLabel(IqcParetoRow row)
    {
        var vi = string.IsNullOrWhiteSpace(row.LabelVi) ? null : row.LabelVi.Trim();
        var en = string.IsNullOrWhiteSpace(row.LabelEn) ? null : row.LabelEn.Trim();
        return IsEnglish ? en ?? vi ?? row.Defect : vi ?? en ?? row.Defect;
    }

    private string NqPerNg
        => _dash.Fail <= 0 ? "—" : ((double)_dash.TotalNqDefects / _dash.Fail).ToString("0.00", CultureInfo.CurrentCulture);

    private double ClaimShare => _dash.Fail <= 0 ? 0 : (double)_dash.ClaimNgLots / _dash.Fail;
    private double WideShare => _dash.Total <= 0 ? 0 : (double)_dash.WideOosLots / _dash.Total;

    private IqcMonthlyTrendRow? TrendPeak
        => _dash.MonthlyTrend.Where(x => x.Lots > 0).OrderByDescending(x => x.NgRate).ThenByDescending(x => x.Ng).FirstOrDefault();

    private IqcMonthlyTrendRow? TrendLow
        => _dash.MonthlyTrend.Where(x => x.Lots > 0).OrderBy(x => x.NgRate).ThenBy(x => x.Ng).FirstOrDefault();

    private int? EmptyFrom
    {
        get
        {
            var last = _dash.MonthlyTrend.LastOrDefault(x => x.Lots > 0);
            if (last is null || last.Month >= 12) return null;
            return last.Month + 1;
        }
    }

    private IReadOnlyList<IqcSupplierStatRow> VisibleSuppliers
    {
        get
        {
            IEnumerable<IqcSupplierStatRow> q = _dash.Suppliers;
            if (_onlyNg) q = q.Where(x => x.Ng > 0);
            if (!string.IsNullOrWhiteSpace(_supQuery))
            {
                var s = _supQuery.Trim();
                q = q.Where(x => x.Supplier.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            q = _sort switch
            {
                SupSort.Name => _sortDesc ? q.OrderByDescending(x => x.Supplier) : q.OrderBy(x => x.Supplier),
                SupSort.Lots => _sortDesc ? q.OrderByDescending(x => x.Lots) : q.OrderBy(x => x.Lots),
                SupSort.NgRate => _sortDesc ? q.OrderByDescending(x => x.NgRate) : q.OrderBy(x => x.NgRate),
                SupSort.Nq => _sortDesc ? q.OrderByDescending(x => x.NqDefects) : q.OrderBy(x => x.NqDefects),
                _ => _sortDesc ? q.OrderByDescending(x => x.Ng) : q.OrderBy(x => x.Ng),
            };
            return q.ToList();
        }
    }

    private int NgSupplierCount => _dash.Suppliers.Count(x => x.Ng > 0);

    private string SortLabel => _sort switch
    {
        SupSort.Name => T("iqc.dash.supplier.name"),
        SupSort.Lots => T("iqc.dash.trend.lots"),
        SupSort.NgRate => T("iqc.dash.trend.ngrate"),
        SupSort.Nq => T("iqc.dash.kpi.nq"),
        _ => T("iqc.dash.trend.ng"),
    };

    private double VisibleNgRate
    {
        get
        {
            var lots = VisibleSuppliers.Sum(x => x.Lots);
            return lots <= 0 ? 0 : (double)VisibleSuppliers.Sum(x => x.Ng) / lots;
        }
    }

    private string PriorityInsight
    {
        get
        {
            if (_dash.VisualPareto.Count == 0) return T("iqc.dash.insight.empty");
            var names = string.Join(" · ", _dash.VisualPareto.Take(3).Select(DefectLabel));
            return T("iqc.dash.insight.priority.body", names, FmtPct(ParetoTop3Cum ?? 0));
        }
    }

    private string RiskInsight
    {
        get
        {
            var worst = _dash.Suppliers.OrderByDescending(x => x.Ng).ThenByDescending(x => x.NgRate).FirstOrDefault();
            if (worst is null || worst.Ng == 0) return T("iqc.dash.insight.empty");
            return T("iqc.dash.insight.risk.body", worst.Supplier, worst.Ng, FmtPct(worst.NgRate));
        }
    }

    private string TrendInsight
    {
        get
        {
            var with = _dash.MonthlyTrend.Where(x => x.Lots > 0).ToList();
            if (with.Count < 2) return T("iqc.dash.insight.empty");
            var a = with[^2];
            var b = with[^1];
            return T("iqc.dash.insight.ok.body",
                T($"iqc.dash.month.short.{a.Month}"), FmtPct(a.NgRate),
                T($"iqc.dash.month.short.{b.Month}"), FmtPct(b.NgRate));
        }
    }

    private string MonthTone(IqcMonthlyTrendRow row)
    {
        if (row.Lots == 0) return "is-empty";
        if (TrendPeak is { } p && p.Month == row.Month) return "is-peak";
        if (TrendLow is { } l && l.Month == row.Month) return "is-low";
        return "";
    }

    private static string RiskClass(double rate)
        => rate > 0.05 ? "iqc-cell-alarm" : rate >= 0.02 ? "is-warn" : "iqc-cell-mut";

    private static string RiskFill(double rate)
        => rate > 0.05 ? "iqc-bar-alarm" : rate >= 0.02 ? "iqc-bar-warn" : "iqc-bar-ok";

    private string RiskBarWidth(double rate)
    {
        var cap = Math.Max(0.10, VisibleSuppliers.Select(x => x.NgRate).DefaultIfEmpty(0).Max());
        return Css(100.0 * rate / cap);
    }

    private static double SlotMid(int i, int n) => n <= 0 ? PlotL : PlotL + (PlotR - PlotL) * (i + 0.5) / n;
    private static double BarW(int n) => Math.Min(40, (PlotR - PlotL) / Math.Max(n, 1) * 0.42);
    private static double BarX(int i, int n) => SlotMid(i, n) - BarW(n) / 2;
    private static double YCum(double frac) => PlotB - PlotH * Math.Clamp(frac, 0, 1);

    private static string Polyline(IEnumerable<double> fractions)
    {
        var v = fractions.ToList();
        if (v.Count == 0) return "";
        return string.Join(" ", v.Select((f, i) => $"{F(SlotMid(i, v.Count))},{F(YCum(f))}"));
    }

    private static MarkupString SvgText(string x, string y, string content, string extra = "")
        => (MarkupString)$"<text x=\"{x}\" y=\"{y}\" {extra}>{System.Net.WebUtility.HtmlEncode(content)}</text>";

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Css(double pct) => Math.Clamp(pct, 0, 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    private static string FmtInt(int n) => n.ToString("N0", CultureInfo.CurrentCulture);
    private static string FmtPct(double rate) => (rate * 100).ToString("0.0", CultureInfo.CurrentCulture) + "%";
}
