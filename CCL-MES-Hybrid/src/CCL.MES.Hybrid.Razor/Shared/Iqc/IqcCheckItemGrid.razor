@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using System.Globalization
@using CCL.MES.Shared.Quality
@using CCL.MES.Hybrid.Razor.Localization
@using CCL.MES.Shared.Localization
@inject ICclApiClient Api

@*
    P12 bước 3 — lưới hạng mục kiểm của MỘT mục trong stepper phiếu IQC.

    MỘT bảng phẳng, KHÔNG tab nhóm (Henry chốt 2026-09-03). Ở FQC/OQC tab nhóm
    là tầng chia DUY NHẤT nên nó cần thiết; ở IQC các MỤC của stepper đã chia
    hạng mục rồi, thêm tab nữa là chia hai lần cho cùng một tập.

    P13 bước 4b — hạng mục không còn chỉ có đạt/không-đạt. Ba kiểu ghi nhận:
      · Verdict/Document — người bấm OK/NG (đường cũ, không đổi)
      · DefectCount      — MỘT ô số, Ac=0: chỉ 0 mới đạt
      · Measure          — N ô số (5 cho kích thước, 1 cho bám dính) + ô tick
                           "rách vật liệu" khi tiêu chuẩn ghi "or tear"

    Cột GHI NHẬN chỉ hiện khi mục này CÓ hạng mục cần nhập số. Mục toàn hạng
    mục người bấm giữ nguyên 6 cột như trước — không bắt người kiểm nhìn một
    cột trống suốt màn hình.

    Kiểu ghi nhận đọc từ `item.Kind` (đóng băng trên phiếu), KHÔNG suy từ tiền
    tố mã hạng mục: mã đổi thì UI hỏng lặng lẽ, còn cột Kind đi cùng dữ liệu.

    Rule 4: `<input>`/`<button>` thuần + @oninput, KHÔNG <InputText>/<EditForm>.
*@

@if (SectionItems.Count == 0)
{
    <p class="qms-section-desc" data-testid="@($"{TestIdPrefix}-empty")">@T("iqc.items.empty")</p>
}
else
{
    @if (FromDefaultMatrix)
    {
        @* Sáu tháng sau, câu hỏi đầu tiên của auditor là "hồ sơ này kiểm theo
           tiêu chuẩn nào?". Không có băng này thì không ai trả lời được. *@
        <p class="iqc-warn iqc-warn-note" data-testid="@($"{TestIdPrefix}-matrix-banner")">@T("iqc.items.matrix")</p>
    }
    else if (!string.IsNullOrWhiteSpace(SpecNo))
    {
        <p class="qms-section-desc" data-testid="@($"{TestIdPrefix}-spec")">@T("iqc.items.spec", SpecNo!)</p>
    }

    <table class="ipqc-item-table @(HasRecordColumn ? "" : "ipqc-no-result")"
           data-testid="@($"{TestIdPrefix}-table")">
        <thead>
            <tr>
                <th class="iqc-col-group">@T("iqc.spec.col.group")</th>
                <th class="ipqc-col-num">@T("ipqc.col.num")</th>
                <th class="ipqc-col-item">@T("ipqc.col.item")</th>
                <th class="ipqc-col-method">@T("ipqc.col.method")</th>
                <th class="ipqc-col-spec">@T("ipqc.col.spec")</th>
                @if (HasRecordColumn)
                {
                    <th class="ipqc-col-result">@T("iqc.items.col.record")</th>
                }
                <th class="ipqc-col-verdict">@T("ipqc.col.verdict")</th>
            </tr>
        </thead>
        <tbody>
            @{ var rowNo = 0; string? prevGroup = null; }
            @foreach (var item in OrderedItems)
            {
                rowNo++;
                var status = StatusOf(item);
                var tid = $"{TestIdPrefix}-item-{item.Id}";
                var group = item.GroupLabelFor(IsEnglish);
                // Nhóm chỉ in ở dòng ĐẦU của nhóm — lặp lại 6 lần cùng một chữ
                // là nhiễu, mắt người kiểm phải lướt qua nó mỗi dòng.
                var showGroup = !string.Equals(group, prevGroup, StringComparison.Ordinal);
                prevGroup = group;
                var draft = DraftOf(item);
                <tr class="ipqc-item-row @SlotCssClass(status) @(showGroup && rowNo > 1 ? "iqc-row-groupstart" : "")" data-testid="@tid">
                    <td class="iqc-col-group" data-testid="@($"{tid}-group")">@(showGroup ? Dash(group) : "")</td>
                    <td class="ipqc-col-num scan-mono">@rowNo</td>
                    <td class="ipqc-col-item">
                        <span class="ipqc-item-label">@item.LabelFor(IsEnglish)</span>
                        <span class="ipqc-status-pill @StatusPillCss(status)"
                              data-testid="@($"{tid}-status")">@StatusDisplay(status)</span>
                        @if (AutoText(item) is { } auto)
                        {
                            @* Máy nói gì và VÌ SAO. Chỉ hiện "Fail" mà không nói lý do
                               thì người kiểm phải tự dò lại 5 con số. *@
                            <span class="iqc-auto-pill @AutoPillCss(item)"
                                  data-testid="@($"{tid}-auto")">@T("iqc.items.auto"): @auto</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.OverrideReason))
                        {
                            <span class="iqc-auto-note" data-testid="@($"{tid}-override")">
                                @T("iqc.items.override.by", item.OverriddenBy ?? "—", item.OverrideReason!)
                            </span>
                        }
                    </td>
                    @* METHOD là văn xuôi, không phải mã — không scan-mono (bài học
                       từ bảng IPQC: mono làm cùng chuỗi rộng thêm ~20% và vỡ dòng). *@
                    <td class="ipqc-col-method" data-label="@T("ipqc.col.method")">@Dash(item.MethodFor(IsEnglish))</td>
                    <td class="ipqc-col-spec" data-label="@T("ipqc.col.spec")">
                        @Dash(item.AcceptanceFor(IsEnglish))
                        @if (LimitText(item) is { } lim)
                        {
                            @* Ngưỡng SỐ đã đóng băng — cái máy thật sự so. Chuỗi
                               tiêu chí gốc có thể mơ hồ, con số thì không. *@
                            <span class="iqc-limit-chip" data-testid="@($"{tid}-limit")">@lim</span>
                        }
                        @if (item.AcceptanceUnspecified)
                        {
                            @* Hạng mục vẫn HIỆN (Henry chốt) — chỉ đánh dấu, không ẩn. *@
                            <span class="ipqc-status-pill ipqc-status-pending"
                                  data-testid="@($"{tid}-unspecified")">@T("iqc.items.unspecified")</span>
                        }
                    </td>
                    @if (HasRecordColumn)
                    {
                        <td class="ipqc-col-result" data-label="@T("iqc.items.col.record")">
                            @if (item.Kind == "DefectCount")
                            {
                                <div class="ipqc-result-group">
                                    <input type="text" inputmode="numeric" class="ipqc-input ipqc-result-input"
                                           maxlength="6" title="@T("iqc.items.defect.hint")"
                                           placeholder="@T("iqc.items.defect.ph")"
                                           disabled="@(ReadOnly || _busy)"
                                           value="@draft.Defect"
                                           @oninput="@(e => draft.Defect = e.Value?.ToString() ?? "")"
                                           data-testid="@($"{tid}-defect")" />
                                    <button type="button" class="op-btn op-btn-secondary op-btn-sm ipqc-measured-save-btn"
                                            disabled="@(ReadOnly || _busy)"
                                            @onclick="@(() => SaveAsync(item, null))"
                                            data-testid="@($"{tid}-defect-save")">@T("iqc.items.save")</button>
                                </div>
                            }
                            else if (item.Kind == "Measure" && item.MeasureCount > 0)
                            {
                                <div class="iqc-measure-group" data-testid="@($"{tid}-measures")">
                                    @for (var k = 0; k < item.MeasureCount; k++)
                                    {
                                        var idx = k;
                                        <input type="text" inputmode="decimal" class="ipqc-input iqc-measure-input"
                                               maxlength="12" placeholder="@T("iqc.items.measure.ph", idx + 1)"
                                               aria-label="@T("iqc.items.measure.ph", idx + 1)"
                                               disabled="@(ReadOnly || _busy)"
                                               value="@draft.Measures[idx]"
                                               @oninput="@(e => draft.Measures[idx] = e.Value?.ToString() ?? "")"
                                               data-testid="@($"{tid}-m{idx + 1}")" />
                                    }
                                    @if (item.TearIsPass)
                                    {
                                        <label class="iqc-tear-check" title="@T("iqc.items.tear.why")">
                                            <input type="checkbox" disabled="@(ReadOnly || _busy)"
                                                   checked="@draft.Tear"
                                                   @onchange="@(e => draft.Tear = e.Value is true)"
                                                   data-testid="@($"{tid}-tear")" />
                                            <span>@T("iqc.items.tear")</span>
                                        </label>
                                    }
                                    <button type="button" class="op-btn op-btn-secondary op-btn-sm ipqc-measured-save-btn"
                                            disabled="@(ReadOnly || _busy)"
                                            @onclick="@(() => SaveAsync(item, null))"
                                            data-testid="@($"{tid}-measures-save")">@T("iqc.items.save")</button>
                                </div>
                            }
                            else
                            {
                                <span class="iqc-muted">—</span>
                            }
                        </td>
                    }
                    <td class="ipqc-col-verdict">
                        <ConfirmToggle Status="@status"
                                       Disabled="@(ReadOnly || _busy)"
                                       OkDisabled="@item.AcceptanceUnspecified"
                                       NgTitle="@(item.AcceptanceUnspecified ? T("iqc.items.unspecified.why") : null)"
                                       OnOk="@(() => SaveAsync(item, true))"
                                       OnNg="@(() => SaveAsync(item, false))"
                                       TestIdPrefix="@tid" />
                    </td>
                </tr>
                @if (draft.NeedsReason)
                {
                    @* Hàng phụ chỉ hiện khi server đã TỪ CHỐI vì thiếu lý do. Không
                       dựng sẵn ô lý do cho mọi dòng: đặt sẵn một ô trống ở đó là mời
                       người ta điền cho xong, và lý do sẽ thành thủ tục. *@
                    <tr class="iqc-override-row" data-testid="@($"{tid}-override-row")">
                        <td colspan="@ColSpan">
                            <p class="iqc-warn iqc-warn-note">@T("iqc.items.override.need")</p>
                            <div class="ipqc-result-group iqc-override-group">
                                <input type="text" class="ipqc-input iqc-override-input" maxlength="512"
                                       placeholder="@T("iqc.items.override.ph")"
                                       disabled="@_busy"
                                       value="@draft.Reason"
                                       @oninput="@(e => draft.Reason = e.Value?.ToString() ?? "")"
                                       data-testid="@($"{tid}-reason")" />
                                <button type="button" class="op-btn op-btn-primary op-btn-sm ipqc-measured-save-btn"
                                        disabled="@(_busy || string.IsNullOrWhiteSpace(draft.Reason))"
                                        @onclick="@(() => SaveAsync(item, draft.PendingPass))"
                                        data-testid="@($"{tid}-reason-save")">@T("iqc.items.save")</button>
                                <button type="button" class="op-btn op-btn-ghost op-btn-sm ipqc-measured-save-btn"
                                        disabled="@_busy"
                                        @onclick="@(() => CancelReason(draft))"
                                        data-testid="@($"{tid}-reason-cancel")">@T("iqc.items.override.cancel")</button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (_error is not null)
    {
        <p class="iqc-warn iqc-warn-error" data-testid="@($"{TestIdPrefix}-error")">@_error</p>
    }
}

@code {
    [Parameter, EditorRequired] public long TicketId { get; set; }

    /// <summary>TOÀN BỘ hạng mục của phiếu — component tự lọc theo
    /// <see cref="Section"/>. Chia sẵn ở parent thì hai màn sẽ trôi khỏi nhau.</summary>
    [Parameter] public IReadOnlyList<IqcCheckItemDto> Items { get; set; } = Array.Empty<IqcCheckItemDto>();

    /// <summary>Mục của stepper (2 ngoại quan · 3 chức năng). Server đã tính số
    /// này cho từng hạng mục; ở đây chỉ lọc.</summary>
    [Parameter, EditorRequired] public int Section { get; set; }

    [Parameter] public string? SpecNo { get; set; }
    [Parameter] public bool FromDefaultMatrix { get; set; }

    /// <summary>Phiếu đã chốt ⇒ chỉ đọc.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Parent nạp lại phiếu sau khi ghi phán định, để số đếm trên tab
    /// và các mục khác cùng cập nhật.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public string TestIdPrefix { get; set; } = "iqc-items";

    private bool _busy;
    private string? _error;

    /// <summary>Bản nháp đang gõ của MỘT hạng mục. Giữ ở component chứ không ghi
    /// thẳng lên DTO: người kiểm gõ dở 3/5 ô rồi bấm sang tab khác thì con số dở
    /// dang không được coi là dữ liệu đã ghi.</summary>
    private sealed class Draft
    {
        public string Defect = "";
        public string[] Measures = Array.Empty<string>();
        public bool Tear;
        public string Reason = "";
        /// <summary>Server đã từ chối vì thiếu lý do ⇒ mở hàng phụ.</summary>
        public bool NeedsReason;
        /// <summary>Phán định người kiểm đang muốn ghi, giữ lại để bấm Lưu ở hàng
        /// phụ là gửi đúng cái đó chứ không phải đoán lại.</summary>
        public bool? PendingPass;
    }

    private readonly Dictionary<long, Draft> _drafts = new();

    private Draft DraftOf(IqcCheckItemDto i)
    {
        if (_drafts.TryGetValue(i.Id, out var d)) return d;
        d = new Draft
        {
            Defect = i.DefectCount?.ToString(CultureInfo.InvariantCulture) ?? "",
            Measures = Enumerable.Range(0, Math.Max(0, i.MeasureCount))
                .Select(k => k < i.Measurements.Count
                    ? i.Measurements[k]?.ToString(CultureInfo.InvariantCulture) ?? ""
                    : "")
                .ToArray(),
            Tear = i.TearObserved,
        };
        _drafts[i.Id] = d;
        return d;
    }

    private IReadOnlyList<IqcCheckItemDto> SectionItems =>
        Items.Where(i => i.Section == Section).ToList();

    /// <summary>Cột GHI NHẬN chỉ dựng khi mục này CÓ hạng mục cần nhập số. Mục
    /// toàn hạng mục người bấm không phải nhìn một cột trống suốt màn hình.</summary>
    private bool HasRecordColumn =>
        SectionItems.Any(i => i.Kind is "DefectCount" or "Measure");

    private int ColSpan => HasRecordColumn ? 7 : 6;

    /// <summary>Ngôn ngữ đang bật. Nhãn · tiêu chí · phương pháp là DỮ LIỆU ĐÃ
    /// ĐÓNG BĂNG trên phiếu, không phải khoá resx — nên không đi qua T() mà qua
    /// <c>*For(bool)</c>. LocalizedComponentBase đã bắt sự kiện đổi ngôn ngữ và
    /// gọi StateHasChanged, nên bảng tự vẽ lại khi người dùng bấm cờ.</summary>
    private bool IsEnglish => LanguageService.Current == LanguageCode.English;

    /// <summary>Toàn bộ hạng mục của MỤC này, gom theo nhóm rồi theo thứ tự
    /// thư viện. Gom theo nhóm để các dòng cùng nhóm nằm cạnh nhau — vai trò
    /// mà tab từng đảm nhiệm, nay làm bằng thứ tự + cột nhóm.</summary>
    private IReadOnlyList<IqcCheckItemDto> OrderedItems =>
        SectionItems
            .OrderBy(i => string.IsNullOrWhiteSpace(i.GroupLabelVi) ? 1 : 0)
            .ThenBy(i => i.GroupLabelVi ?? "", StringComparer.Ordinal)
            .ThenBy(i => i.Seq)
            .ToList();

    /// <summary><c>null</c> là CHƯA KIỂM — trạng thái thật, không phải NG.</summary>
    private static string StatusOf(IqcCheckItemDto i) =>
        i.Pass is null ? "Pending" : i.Pass == true ? "Ok" : "Ng";

    private static string SlotCssClass(string s) => s switch
    {
        "Ok" => "ipqc-slot-ok",
        "Ng" => "ipqc-slot-ng",
        _    => "ipqc-slot-pending",
    };

    private static string StatusPillCss(string s) => s switch
    {
        "Ok" => "ipqc-status-ok",
        "Ng" => "ipqc-status-ng",
        _    => "ipqc-status-pending",
    };

    private string StatusDisplay(string s) => s switch
    {
        "Ok" => T("iqc.status.ok"),
        "Ng" => T("iqc.status.ng"),
        _    => T("iqc.status.pending"),
    };

    /// <summary>Câu giải thích của máy. <c>null</c> ⇒ không hiện gì: hạng mục
    /// người bấm mà treo thêm nhãn "máy chưa quyết được" chỉ làm bảng ồn.</summary>
    private string? AutoText(IqcCheckItemDto i)
    {
        if (string.IsNullOrWhiteSpace(i.AutoVerdictReason)) return null;
        if (i.AutoVerdictReason == "iqc.judge.human_only") return null;
        // Mã lý do là KHOÁ, câu chữ dịch theo ngôn ngữ đang bật. Vị trí ô gây
        // trượt đi kèm để người kiểm biết sửa chỗ nào.
        var seq = i.AutoVerdictOffendingSeq?.ToString(CultureInfo.InvariantCulture) ?? "?";
        return T(i.AutoVerdictReason!, seq);
    }

    private static string AutoPillCss(IqcCheckItemDto i) => i.AutoVerdict switch
    {
        "Pass" => "iqc-auto-ok",
        "Fail" => "iqc-auto-ng",
        _      => "iqc-auto-unknown",
    };

    /// <summary>Ngưỡng SỐ đã đóng băng, dạng người đọc được. <c>null</c> khi
    /// tiêu chuẩn không có số nào — lúc đó máy nhường người chấm.</summary>
    private string? LimitText(IqcCheckItemDto i)
    {
        if (i.LimitLow is null && i.LimitUp is null) return null;
        var lo = i.LimitLow?.ToString("0.####", CultureInfo.InvariantCulture);
        var up = i.LimitUp?.ToString("0.####", CultureInfo.InvariantCulture);
        var range = (lo, up) switch
        {
            (not null, not null) => $"{lo} – {up}",
            (not null, null)     => $"≥ {lo}",
            (null, not null)     => $"≤ {up}",
            _                    => "",
        };
        if (!string.IsNullOrWhiteSpace(i.LimitUnit)) range += " " + i.LimitUnit;
        var text = T("iqc.items.limit", range);
        if (!string.IsNullOrWhiteSpace(i.LimitLabel))
            text += " · " + T("iqc.items.limit.face", i.LimitLabel!);
        return text;
    }

    private static string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;

    /// <summary>Ô trống = CHƯA nhập, KHÁC hẳn 0. Trả <c>null</c> cho ô trống chứ
    /// không ép về 0 — ép về 0 là tuyên bố "đã đếm, không có lỗi" thay cho người
    /// chưa làm việc.</summary>
    private static double? ParseNum(string s) =>
        double.TryParse((s ?? "").Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v)
            ? v : null;

    private static int? ParseInt(string s) =>
        int.TryParse((s ?? "").Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v)
            ? v : null;

    private void CancelReason(Draft d)
    {
        d.NeedsReason = false;
        d.Reason = "";
        d.PendingPass = null;
        _error = null;
    }

    /// <summary>
    /// Gửi một lần ghi. <paramref name="pass"/> <c>null</c> = "để máy quyết":
    /// người kiểm vừa nhập số, tiêu chuẩn nói con số đó nghĩa là gì, không cần
    /// bấm thêm nút để lặp lại điều đó.
    /// </summary>
    private async Task SaveAsync(IqcCheckItemDto item, bool? pass)
    {
        if (ReadOnly || _busy) return;
        var draft = DraftOf(item);
        _busy = true;
        _error = null;
        try
        {
            var body = new SetIqcItemBody
            {
                Pass = pass,
                MeasuredValue = item.MeasuredValue,
                DefectCode = item.DefectCode,
                OverrideReason = string.IsNullOrWhiteSpace(draft.Reason) ? null : draft.Reason.Trim(),
            };
            if (item.Kind == "DefectCount")
                body.DefectCount = ParseInt(draft.Defect);
            if (item.Kind == "Measure" && item.MeasureCount > 0)
            {
                body.Measurements = draft.Measures.Select(ParseNum).ToList();
                body.TearObserved = draft.Tear;
            }

            await Api.SetIqcTicketItemAsync(TicketId, item.Id, body);
            CancelReason(draft);
            // Nạp lại từ server: máy chấm ở server nên kết luận, lý do và vị trí ô
            // gây trượt chỉ server biết. Ghi lạc quan ở đây sẽ hiện một kết luận
            // do client tự nghĩ ra.
            _drafts.Remove(item.Id);
            await OnChanged.InvokeAsync();
        }
        catch (ApiException ex) when (ex.ApiError?.Code == "iqc.verdict_override_reason_required")
        {
            // Không phải lỗi — là một câu hỏi. Mở ô lý do và giữ lại phán định
            // người kiểm vừa bấm để lần gửi sau mang đúng nó.
            draft.NeedsReason = true;
            draft.PendingPass = pass;
        }
        catch (Exception ex)
        {
            // Không đoán mã lỗi: hiện đúng thứ server trả về. Ô giữ nguyên trạng
            // thái cũ vì ta chưa ghi gì lên item khi ném.
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
