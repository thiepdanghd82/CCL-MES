@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Shared.Quality
@using CCL.MES.Hybrid.Razor.Localization
@using CCL.MES.Shared.Localization
@inject ICclApiClient Api

@*
    P12 bước 3 — lưới hạng mục kiểm của MỘT mục trong stepper phiếu IQC.

    MỘT bảng phẳng, KHÔNG tab nhóm (Henry chốt 2026-09-03). Ở FQC/OQC tab nhóm
    là tầng chia DUY NHẤT nên nó cần thiết; ở IQC các MỤC của stepper đã chia
    hạng mục rồi, thêm tab nữa là chia hai lần cho cùng một tập — mục 2 chỉ có
    7 hạng mục trên 2 nhóm, mục 3 có nhóm chỉ 1 dòng.

    Nhóm KHÔNG mất đi: nó thành CỘT đầu bảng, khớp bảng ở tab Tiêu chuẩn cùng
    module. Bảng 6 cột `NHÓM · # · ITEM · METHOD · SPEC · VERDICT`, bộ class
    `ipqc-*`, ConfirmToggle dùng chung (L52). Không đẻ CSS mới.
*@

@if (SectionItems.Count == 0)
{
    <p class="qms-section-desc" data-testid="@($"{TestIdPrefix}-empty")">@T("iqc.items.empty")</p>
}
else
{
    @if (FromDefaultMatrix)
    {
        @* Sáu tháng sau, câu hỏi đầu tiên của auditor là "hồ sơ này kiểm theo
           tiêu chuẩn nào?". Không có băng này thì không ai trả lời được. *@
        <p class="iqc-warn iqc-warn-note" data-testid="@($"{TestIdPrefix}-matrix-banner")">@T("iqc.items.matrix")</p>
    }
    else if (!string.IsNullOrWhiteSpace(SpecNo))
    {
        <p class="qms-section-desc" data-testid="@($"{TestIdPrefix}-spec")">@T("iqc.items.spec", SpecNo!)</p>
    }

    <table class="ipqc-item-table ipqc-no-result" data-testid="@($"{TestIdPrefix}-table")">
        <thead>
            <tr>
                <th class="iqc-col-group">@T("iqc.spec.col.group")</th>
                <th class="ipqc-col-num">@T("ipqc.col.num")</th>
                <th class="ipqc-col-item">@T("ipqc.col.item")</th>
                <th class="ipqc-col-method">@T("ipqc.col.method")</th>
                <th class="ipqc-col-spec">@T("ipqc.col.spec")</th>
                <th class="ipqc-col-verdict">@T("ipqc.col.verdict")</th>
            </tr>
        </thead>
        <tbody>
            @{ var rowNo = 0; string? prevGroup = null; }
            @foreach (var item in OrderedItems)
            {
                rowNo++;
                var status = StatusOf(item);
                var tid = $"{TestIdPrefix}-item-{item.Id}";
                var group = item.GroupLabelFor(IsEnglish);
                // Nhóm chỉ in ở dòng ĐẦU của nhóm — lặp lại 6 lần cùng một chữ
                // là nhiễu, mắt người kiểm phải lướt qua nó mỗi dòng.
                var showGroup = !string.Equals(group, prevGroup, StringComparison.Ordinal);
                prevGroup = group;
                <tr class="ipqc-item-row @SlotCssClass(status) @(showGroup && rowNo > 1 ? "iqc-row-groupstart" : "")" data-testid="@tid">
                    <td class="iqc-col-group" data-testid="@($"{tid}-group")">@(showGroup ? Dash(group) : "")</td>
                    <td class="ipqc-col-num scan-mono">@rowNo</td>
                    <td class="ipqc-col-item">
                        <span class="ipqc-item-label">@item.LabelFor(IsEnglish)</span>
                        <span class="ipqc-status-pill @StatusPillCss(status)"
                              data-testid="@($"{tid}-status")">@StatusDisplay(status)</span>
                    </td>
                    @* METHOD là văn xuôi, không phải mã — không scan-mono (bài học
                       từ bảng IPQC: mono làm cùng chuỗi rộng thêm ~20% và vỡ dòng). *@
                    <td class="ipqc-col-method" data-label="@T("ipqc.col.method")">@Dash(item.MethodFor(IsEnglish))</td>
                    <td class="ipqc-col-spec" data-label="@T("ipqc.col.spec")">
                        @Dash(item.AcceptanceFor(IsEnglish))
                        @if (item.AcceptanceUnspecified)
                        {
                            @* Hạng mục vẫn HIỆN (Henry chốt) — chỉ đánh dấu, không ẩn. *@
                            <span class="ipqc-status-pill ipqc-status-pending"
                                  data-testid="@($"{tid}-unspecified")">@T("iqc.items.unspecified")</span>
                        }
                    </td>
                    <td class="ipqc-col-verdict">
                        <ConfirmToggle Status="@status"
                                       Disabled="@(ReadOnly || _busy)"
                                       OkDisabled="@item.AcceptanceUnspecified"
                                       NgTitle="@(item.AcceptanceUnspecified ? T("iqc.items.unspecified.why") : null)"
                                       OnOk="@(() => SetAsync(item, true))"
                                       OnNg="@(() => SetAsync(item, false))"
                                       TestIdPrefix="@tid" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_error is not null)
    {
        <p class="iqc-warn iqc-warn-error" data-testid="@($"{TestIdPrefix}-error")">@_error</p>
    }
}

@code {
    [Parameter, EditorRequired] public long TicketId { get; set; }

    /// <summary>TOÀN BỘ hạng mục của phiếu — component tự lọc theo
    /// <see cref="Section"/>. Chia sẵn ở parent thì hai màn sẽ trôi khỏi nhau.</summary>
    [Parameter] public IReadOnlyList<IqcCheckItemDto> Items { get; set; } = Array.Empty<IqcCheckItemDto>();

    /// <summary>Mục của stepper (2 ngoại quan · 3 chức năng). Server đã tính số
    /// này cho từng hạng mục; ở đây chỉ lọc.</summary>
    [Parameter, EditorRequired] public int Section { get; set; }

    [Parameter] public string? SpecNo { get; set; }
    [Parameter] public bool FromDefaultMatrix { get; set; }

    /// <summary>Phiếu đã chốt ⇒ chỉ đọc.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Parent nạp lại phiếu sau khi ghi phán định, để số đếm trên tab
    /// và các mục khác cùng cập nhật.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public string TestIdPrefix { get; set; } = "iqc-items";

    private bool _busy;
    private string? _error;

    private IReadOnlyList<IqcCheckItemDto> SectionItems =>
        Items.Where(i => i.Section == Section).ToList();

    /// <summary>Ngôn ngữ đang bật. Nhãn · tiêu chí · phương pháp là DỮ LIỆU ĐÃ
    /// ĐÓNG BĂNG trên phiếu, không phải khoá resx — nên không đi qua T() mà qua
    /// <c>*For(bool)</c>. LocalizedComponentBase đã bắt sự kiện đổi ngôn ngữ và
    /// gọi StateHasChanged, nên bảng tự vẽ lại khi người dùng bấm cờ.</summary>
    private bool IsEnglish => LanguageService.Current == LanguageCode.English;

    /// <summary>Toàn bộ hạng mục của MỤC này, gom theo nhóm rồi theo thứ tự
    /// thư viện. Gom theo nhóm để các dòng cùng nhóm nằm cạnh nhau — vai trò
    /// mà tab từng đảm nhiệm, nay làm bằng thứ tự + cột nhóm.</summary>
    private IReadOnlyList<IqcCheckItemDto> OrderedItems =>
        SectionItems
            .OrderBy(i => string.IsNullOrWhiteSpace(i.GroupLabelVi) ? 1 : 0)
            .ThenBy(i => i.GroupLabelVi ?? "", StringComparer.Ordinal)
            .ThenBy(i => i.Seq)
            .ToList();

    /// <summary><c>null</c> là CHƯA KIỂM — trạng thái thật, không phải NG.</summary>
    private static string StatusOf(IqcCheckItemDto i) =>
        i.Pass is null ? "Pending" : i.Pass == true ? "Ok" : "Ng";

    private static string SlotCssClass(string s) => s switch
    {
        "Ok" => "ipqc-slot-ok",
        "Ng" => "ipqc-slot-ng",
        _    => "ipqc-slot-pending",
    };

    private static string StatusPillCss(string s) => s switch
    {
        "Ok" => "ipqc-status-ok",
        "Ng" => "ipqc-status-ng",
        _    => "ipqc-status-pending",
    };

    private string StatusDisplay(string s) => s switch
    {
        "Ok" => T("iqc.status.ok"),
        "Ng" => T("iqc.status.ng"),
        _    => T("iqc.status.pending"),
    };

    private static string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;

    private async Task SetAsync(IqcCheckItemDto item, bool pass)
    {
        if (ReadOnly || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            await Api.SetIqcTicketItemAsync(TicketId, item.Id, new SetIqcItemBody { Pass = pass });
            // Ghi lạc quan để ô đổi ngay; parent nạp lại để số đếm tab khớp server.
            item.Pass = pass;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            // Không đoán mã lỗi: hiện đúng thứ server trả về. Ô giữ nguyên trạng
            // thái cũ vì ta chưa ghi gì lên item khi ném.
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
