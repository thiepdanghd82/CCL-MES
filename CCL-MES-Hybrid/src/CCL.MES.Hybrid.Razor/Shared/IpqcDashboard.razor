@*
    P10.7d-3 — IPQC review operator dashboard.

    Hosted inside WorkOrders.razor when the scanned WO has
    MesPhase=IPQC_WAIT. Owns the entire IpqcView state + every API call
    that mutates it (4 PUT slot + POST judgment).

    Render:
      - Head: WO + phase chip + "X/4 đã xác nhận" pill.
      - 4 slot cards (Material / Print A — Color/ΔE / Print B —
        Registration / Print C — Content). Each card carries 3-state
        status pill + OK/NG buttons + inline NG sub-form (reason
        picker + 1-500 char note). Plain <input> + <select> per Rule 4.
      - Judgment row visible only when IsReadyForJudgment (all 4 slots
        non-Pending). Three buttons:
          - Go Run  : enabled iff AllOk.
          - Stop Line: enabled iff AnyNg.
          - Special Accept: enabled iff AnyNg AND reason ≥1 char.
        Server validates the GoRun ↔ AnyNg invariant too (L15 dual-side
        check); we mirror client-side so operators get a hint, not a
        bounced server error.

    Concurrency / error handling matches SettingDashboard + the
    Prepress dashboard:
      - 200 → swap state from response (MesPhase + ETag + rollup) then
        refetch the view to capture audit-side fields
        (IpqcSubmittedAt, etc.).
      - 409 wo.state_conflict → refetch + show banner (the fresh ETag
        rides on the response so the next attempt can retry without an
        extra GET).
      - 422 ipqc.* / qa.* → in-band ErrorCode + LocaliseSetError to
        produce the VN banner. The set-error banner sits at the top
        of the dashboard so operators can't miss it.
      - 422 wo.invalid_phase → collapse to "không ở IPQC_WAIT" banner.

    Rule 4: plain <input>, plain <button>, plain <select>. NO
    <InputText> / <EditForm> — Lesson L2 trap.

    Rule 7.3 wire-mirror: every wire-path probe has an integration
    test hitting the SAME URL via TestServer
    (IpqcReviewControllerTests covers GET view + 4 PUT slots + POST
    judgment + POST qa/approve).
*@

@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Hybrid.Client
@using CCL.MES.Hybrid.Client.Auth
@using CCL.MES.Hybrid.Client.IpqcReview
@using CCL.MES.Shared.Envelopes
@using CCL.MES.Shared.IpqcReview
@using CCL.MES.Shared.ReasonCodes
@inject ICclApiClient Api
@inject IAuthSession Session

<div class="rs-dashboard ipqc-dashboard" data-testid="ipqc-dashboard">
    @if (_view is null && _initialError is null)
    {
        <div class="rs-loading" data-testid="ipqc-loading">@T("ipqc.loading")</div>
    }
    else if (_initialError is not null)
    {
        <div class="wo-card-error" data-testid="ipqc-initial-error">
            <strong>@T("ipqc.initial.error")</strong> @_initialError
        </div>
    }
    else if (_invalidPhase)
    {
        <div class="wo-card-error" data-testid="ipqc-invalid-phase">
            <strong>@T("ipqc.invalidphase.title")</strong> —
            @T("ipqc.invalidphase.current") <code>@(_view?.MesPhase ?? "?")</code>.
            @T("ipqc.invalidphase.hint")
        </div>
    }
    else if (_view is not null)
    {
        <div class="rs-head">
            @if (WoLegId is null)
            {
                <div class="rs-head-wo">
                    <span class="rs-head-label">WO</span>
                    <span class="rs-head-wo-no">@_view.WoNo</span>
                    <StatusPill Phase="@_view.MesPhase" />
                </div>
            }
            <div class="ipqc-counter-pill" data-testid="ipqc-counter">
                <span class="ipqc-counter-label">@(ItemsMode ? T("ipqc.counter.items") : T("ipqc.counter.slots"))</span>
                <span class="ipqc-counter-value scan-mono">@ConfirmedCount/@TotalCount</span>
            </div>
        </div>

        @if (_setError is not null)
        {
            <div class="wo-card-error" data-testid="ipqc-set-error">
                <strong>@T("ipqc.seterror.title")</strong> @_setError
                <button type="button" class="op-btn op-btn-secondary op-btn-sm"
                        @onclick="DismissSetError"
                        data-testid="ipqc-set-error-dismiss">@T("ipqc.dismiss")</button>
            </div>
        }

        @* F2 (finding #2) — cảnh báo auto-sync bị bỏ qua, KHÔNG im lặng *@
        @if (AutoSyncWarning is { } warn)
        {
            <div class="wo-card-warn" data-testid="ipqc-autosync-warning">
                <strong>@T("ipqc.autosync.title")</strong> @warn
            </div>
        }

        @* ── MATERIAL (SYSTEM) — first-article reconciliation panel ────
             h-3: TOP of the IPQC sheet, only in IPQC_WAIT (WoLegId null =
             WO-level). Reconciles each BOM line vs the resolved IQC lot; a
             divergent row is highlighted + gated by an Engineer waiver. *@
        @if (WoLegId is null && !_invalidPhase && _material is { Rows.Count: > 0 })
        {
            <div class="rs-card ipqc-mat-panel @(_material.AnyPendingWaiver ? "ipqc-mat-panel-warn" : "")"
                 data-testid="ipqc-material-panel">
                <div class="rs-card-head">
                    <div class="rs-card-title">@T("ipqc.material.title")</div>
                    <div class="ipqc-slot-subtitle">@T("ipqc.material.subtitle")</div>
                </div>

                @if (_material.Rows.Any(r => r.IsDivergent))
                {
                    <div class="ipqc-mat-banner" data-testid="ipqc-material-divergent-banner">
                        <strong>@T("ipqc.material.divergent.banner")</strong>
                    </div>
                }

                <div class="ipqc-mat-grid" role="table">
                    <div class="ipqc-mat-row ipqc-mat-head" role="row">
                        <span role="columnheader">@T("ipqc.material.col.system")</span>
                        <span role="columnheader">@T("ipqc.material.col.code")</span>
                        <span role="columnheader">@T("ipqc.material.col.iqclot")</span>
                        <span role="columnheader">@T("ipqc.material.col.actual")</span>
                        <span role="columnheader">@T("ipqc.material.col.confirm")</span>
                    </div>

                    @foreach (var row in _material.Rows)
                    {
                        <div class="ipqc-mat-row @(row.IsDivergent ? "ipqc-mat-row-divergent" : "")"
                             role="row"
                             data-testid="@($"ipqc-material-row-{row.BomLineIdx}")">
                            <span class="ipqc-mat-cell" role="cell">
                                <span class="ipqc-mat-sys-code scan-mono">@row.MaterialCode</span>
                                @if (!string.IsNullOrWhiteSpace(row.MaterialDescription))
                                {
                                    <span class="ipqc-mat-sys-desc">@row.MaterialDescription</span>
                                }
                                @if (row.IsDivergent)
                                {
                                    <span class="ipqc-mat-divtag" data-testid="@($"ipqc-material-row-{row.BomLineIdx}-divtag")">@T("ipqc.material.divergent.tag")</span>
                                }
                            </span>
                            <span class="ipqc-mat-cell scan-mono" role="cell">@row.MaterialCode</span>
                            <span class="ipqc-mat-cell scan-mono" role="cell">@(string.IsNullOrWhiteSpace(row.SourceIqcReceiptNo) ? T("ipqc.material.none") : row.SourceIqcReceiptNo)</span>
                            <span class="ipqc-mat-cell scan-mono" role="cell">@(string.IsNullOrWhiteSpace(row.ActualAtMachine) ? T("ipqc.material.none") : row.ActualAtMachine)</span>
                            <span class="ipqc-mat-cell ipqc-mat-confirm" role="cell">
                                @* L52 — shared OK/NG segmented toggle *@
                                <ConfirmToggle Status="@row.Status"
                                               Disabled="@_busy"
                                               NgDisabled="@(ScrapReasons.Count == 0)"
                                               OnOk="@(() => OnMaterialOkAsync(row.BomLineIdx))"
                                               OnNg="@(() => OpenMaterialNgForm(row))"
                                               TestIdPrefix="@($"ipqc-material-row-{row.BomLineIdx}")" />
                            </span>

                            @* NG sub-form for the material row (spans full width). *@
                            @if (_openMaterialNgFor == row.BomLineIdx)
                            {
                                <div class="ipqc-mat-subrow" role="cell">
                                    <div class="ipqc-ng-form" data-testid="@($"ipqc-material-row-{row.BomLineIdx}-ng-form")">
                                        <div class="ipqc-ng-field">
                                            <label class="rs-modal-label">@T("ipqc.ng.code")</label>
                                            <select class="ipqc-input" value="@_ngReasonCode"
                                                    @onchange="@(e => _ngReasonCode = e.Value?.ToString() ?? "")"
                                                    data-testid="@($"ipqc-material-row-{row.BomLineIdx}-ng-reason")">
                                                <option value="">@T("ipqc.ng.select")</option>
                                                @foreach (var r in ScrapReasons)
                                                {
                                                    <option value="@r.Code">@r.Code — @r.LabelVi</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="ipqc-ng-field ipqc-ng-field-wide">
                                            <label class="rs-modal-label">@T("ipqc.ng.note.short")</label>
                                            <input type="text" class="ipqc-input" maxlength="500" value="@_ngNote"
                                                   @oninput="@(e => _ngNote = e.Value?.ToString() ?? "")"
                                                   data-testid="@($"ipqc-material-row-{row.BomLineIdx}-ng-note")" />
                                        </div>
                                        <div class="ipqc-ng-actions">
                                            <button type="button" class="op-btn op-btn-secondary"
                                                    @onclick="CloseNgForm"
                                                    data-testid="@($"ipqc-material-row-{row.BomLineIdx}-ng-cancel")">@T("ipqc.btn.cancel")</button>
                                            <button type="button" class="op-btn op-btn-danger"
                                                    disabled="@(!CanSubmitNg() || _busy)"
                                                    @onclick="@(() => OnMaterialNgAsync(row.BomLineIdx))"
                                                    data-testid="@($"ipqc-material-row-{row.BomLineIdx}-ng-submit")">@T("ipqc.btn.savng")</button>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Divergence waiver — Engineer decision (RBAC-by-omission). *@
                            @if (row.IsDivergent && row.DivergenceApprovalStatus == "PendingEngineer")
                            {
                                <div class="ipqc-mat-waiver" role="cell"
                                     data-testid="@($"ipqc-material-row-{row.BomLineIdx}-waiver")">
                                    @if (CanWaive)
                                    {
                                        <div class="ipqc-ng-field ipqc-ng-field-wide">
                                            <label class="rs-modal-label">@T("ipqc.material.waiver.reason")</label>
                                            <input type="text" class="ipqc-input" maxlength="500" value="@_waiverReason"
                                                   @oninput="@(e => _waiverReason = e.Value?.ToString() ?? "")"
                                                   data-testid="@($"ipqc-material-row-{row.BomLineIdx}-waiver-reason")" />
                                        </div>
                                        <div class="ipqc-mat-waiver-actions">
                                            <button type="button" class="op-btn op-btn-success ipqc-judgment-btn"
                                                    disabled="@(!CanWaiveSubmit() || _busy)"
                                                    @onclick="@(() => OnWaiveAsync(row.BomLineIdx, "Approve"))"
                                                    data-testid="@($"ipqc-material-row-{row.BomLineIdx}-waiver-approve")">@T("ipqc.material.waiver.approve")</button>
                                            <button type="button" class="op-btn op-btn-danger ipqc-judgment-btn"
                                                    disabled="@(!CanWaiveSubmit() || _busy)"
                                                    @onclick="@(() => OnWaiveAsync(row.BomLineIdx, "Reject"))"
                                                    data-testid="@($"ipqc-material-row-{row.BomLineIdx}-waiver-reject")">@T("ipqc.material.waiver.reject")</button>
                                        </div>
                                    }
                                    else
                                    {
                                        @* QC/Operator: no button, but they SEE the pending state. *@
                                        <div class="ipqc-mat-waiver-pending" data-testid="@($"ipqc-material-row-{row.BomLineIdx}-waiver-norole")">
                                            @T("ipqc.material.waiver.norole")
                                        </div>
                                    }
                                </div>
                            }
                            else if (row.DivergenceApprovalStatus is "Approved" or "Rejected")
                            {
                                <div class="ipqc-mat-waiver-done" role="cell"
                                     data-testid="@($"ipqc-material-row-{row.BomLineIdx}-waiver-done")">
                                    <span class="@(row.DivergenceApprovalStatus == "Approved" ? "ipqc-mat-approved" : "ipqc-mat-rejected")">
                                        @(row.DivergenceApprovalStatus == "Approved" ? T("ipqc.material.waiver.approved") : T("ipqc.material.waiver.rejected"))
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(row.ApprovedBy))
                                    {
                                        <span class="ipqc-mat-approver">@T("ipqc.material.waiver.approvedby") <span class="scan-mono">@row.ApprovedBy</span></span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.ApprovalReason))
                                    {
                                        <span class="ipqc-mat-approve-reason">@T("ipqc.material.waiver.reasonlabel") @row.ApprovalReason</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* ── Phương án C: data-driven items (auto-sync) ───────────── *@
        @if (ItemsMode)
        {
            <div class="ipqc-resolved-banner" data-testid="ipqc-resolved-lines">
                <span class="ipqc-resolved-label">@T("ipqc.resolved.label")</span>
                <span class="ipqc-resolved-value scan-mono">@_view!.ResolvedLines</span>
                <span class="ipqc-resolved-count">@T("ipqc.resolved.count", _view!.Items.Count)</span>
            </div>

            @* First-article stepper — 3 tab chips (Visual / Dimension /
               Function) + a fallback "Other" tab that never swallows an
               item with an unrecognised CheckType. Chip-buttons, NOT a
               <select> (WKWebView freeze — see MEMORY). *@
            <div class="ipqc-tabs" role="tablist" data-testid="ipqc-tabs">
                @foreach (var tab in ActiveTabs)
                {
                    <button type="button"
                            class="ipqc-tab-chip @(_activeTab == tab.Key ? "is-active" : "")"
                            role="tab"
                            aria-selected="@(_activeTab == tab.Key ? "true" : "false")"
                            @onclick="@(() => _activeTab = tab.Key)"
                            data-testid="@($"ipqc-tab-{tab.Key}")">
                        <span class="ipqc-tab-label">@T(tab.LabelKey)</span>
                        <span class="ipqc-tab-count">@T("ipqc.tab.count", tab.Count)</span>
                    </button>
                }
            </div>

            @foreach (var grp in ItemsInActiveTab.GroupBy(i => (i.ProcessLine, i.GroupLabel)))
            {
                <div class="ipqc-item-group" data-testid="@($"ipqc-group-{grp.Key.ProcessLine}-{Slug(grp.Key.GroupLabel)}")">
                    <div class="ipqc-item-group-head">
                        <span class="ipqc-line-chip">@grp.Key.ProcessLine</span>
                        <span class="ipqc-group-title">@grp.Key.GroupLabel</span>
                    </div>
                    @foreach (var item in grp)
                    {
                        <div class="rs-card ipqc-item @ItemCssClass(item)" data-testid="@($"ipqc-item-{item.ItemKey}")">
                            <div class="rs-card-head">
                                <div class="rs-card-title">@item.Label</div>
                                <div class="ipqc-status-pill @StatusPillCss(item.Status)"
                                     data-testid="@($"ipqc-item-{item.ItemKey}-status")">@StatusDisplay(item.Status)</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.AcceptanceCriteria))
                            {
                                <div class="ipqc-slot-subtitle">@item.AcceptanceCriteria</div>
                            }
                            <div class="ipqc-slot-actions">
                                @* L52 — shared OK/NG segmented toggle *@
                                <ConfirmToggle Status="@item.Status"
                                               Disabled="@_busy"
                                               OnOk="@(() => OnItemOkAsync(item.ItemKey))"
                                               OnNg="@(() => OpenItemNgForm(item))"
                                               TestIdPrefix="@($"ipqc-item-{item.ItemKey}")" />
                            </div>

                            @* First-article — measured value input (Dimension / Function).
                               Sent alongside the item PUT; not part of readiness. *@
                            <div class="ipqc-measured-field">
                                <label class="rs-modal-label" for="@($"ipqc-measured-{item.ItemKey}")">@T("ipqc.item.measured.label")</label>
                                <div class="ipqc-measured-row">
                                    <input id="@($"ipqc-measured-{item.ItemKey}")"
                                           type="text" class="ipqc-input" maxlength="128"
                                           placeholder="@T("ipqc.item.measured.placeholder")"
                                           value="@MeasuredDraft(item)"
                                           @oninput="@(e => SetMeasuredDraft(item.ItemKey, e.Value?.ToString() ?? ""))"
                                           data-testid="@($"ipqc-item-{item.ItemKey}-measured")" />
                                    <button type="button" class="op-btn op-btn-secondary"
                                            disabled="@_busy"
                                            @onclick="@(() => OnSaveMeasuredAsync(item))"
                                            data-testid="@($"ipqc-item-{item.ItemKey}-measured-save")">@T("ipqc.item.measured.save")</button>
                                </div>
                            </div>

                            @if (item.Status == "Ng" && !string.IsNullOrWhiteSpace(item.NgReasonCode))
                            {
                                <div class="ipqc-slot-ng-summary">
                                    <span class="ipqc-slot-ng-label">@T("ipqc.ng.code.label")</span>
                                    <span class="ipqc-slot-ng-value scan-mono">@item.NgReasonCode</span>
                                    @if (!string.IsNullOrWhiteSpace(item.NgNote))
                                    {
                                        <div class="ipqc-slot-ng-note">@item.NgNote</div>
                                    }
                                </div>
                            }

                            @if (_openNgFor == item.ItemKey)
                            {
                                <div class="ipqc-ng-form" data-testid="@($"ipqc-item-{item.ItemKey}-ng-form")">
                                    <div class="ipqc-ng-field">
                                        <label class="rs-modal-label">@T("ipqc.ng.code")</label>
                                        <select class="ipqc-input" value="@_ngReasonCode"
                                                @onchange="@(e => _ngReasonCode = e.Value?.ToString() ?? "")"
                                                data-testid="@($"ipqc-item-{item.ItemKey}-ng-reason")">
                                            <option value="">@T("ipqc.ng.select")</option>
                                            @foreach (var r in ScopedScrapReasons)
                                            {
                                                <option value="@r.Code">@r.Code — @r.LabelVi</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="ipqc-ng-field ipqc-ng-field-wide">
                                        <label class="rs-modal-label">@T("ipqc.ng.note.short")</label>
                                        <input type="text" class="ipqc-input" maxlength="500" value="@_ngNote"
                                               @oninput="@(e => _ngNote = e.Value?.ToString() ?? "")"
                                               data-testid="@($"ipqc-item-{item.ItemKey}-ng-note")" />
                                    </div>
                                    <div class="ipqc-ng-actions">
                                        <button type="button" class="op-btn op-btn-secondary"
                                                @onclick="CloseNgForm"
                                                data-testid="@($"ipqc-item-{item.ItemKey}-ng-cancel")">@T("ipqc.btn.cancel")</button>
                                        <button type="button" class="op-btn op-btn-danger"
                                                disabled="@(!CanSubmitNg() || _busy)"
                                                @onclick="@(() => OnItemNgAsync(item.ItemKey))"
                                                data-testid="@($"ipqc-item-{item.ItemKey}-ng-submit")">@T("ipqc.btn.savng")</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
        @* ── 4 slot cards (legacy fallback) ───────────────────────── *@
        <div class="ipqc-slot-grid">
            @foreach (var slot in _slots)
            {
                <div class="rs-card ipqc-slot @SlotCssClass(slot)"
                     data-testid="@($"ipqc-slot-{slot.Key}")">
                    <div class="rs-card-head">
                        <div class="rs-card-title">@T($"ipqc.slot.{slot.Key}.title")</div>
                        <div class="ipqc-status-pill @StatusPillCss(SlotStatus(slot))"
                             data-testid="@($"ipqc-slot-{slot.Key}-status")">@StatusDisplay(SlotStatus(slot))</div>
                    </div>
                    <div class="ipqc-slot-subtitle">@T($"ipqc.slot.{slot.Key}.subtitle")</div>

                    <div class="ipqc-slot-actions">
                        @* L52 — shared OK/NG segmented toggle *@
                        <ConfirmToggle Status="@SlotStatus(slot)"
                                       Disabled="@_busy"
                                       OnOk="@(() => OnSlotOkAsync(slot))"
                                       OnNg="@(() => OpenNgForm(slot.Key))"
                                       TestIdPrefix="@($"ipqc-slot-{slot.Key}")" />
                    </div>

                    @if (SlotStatus(slot) == "Ng" && SlotNgReason(slot) is { } persistedReason)
                    {
                        <div class="ipqc-slot-ng-summary" data-testid="@($"ipqc-slot-{slot.Key}-ng-summary")">
                            <span class="ipqc-slot-ng-label">@T("ipqc.ng.code.label")</span>
                            <span class="ipqc-slot-ng-value scan-mono">@persistedReason</span>
                            @if (SlotNgNote(slot) is { Length: > 0 } persistedNote)
                            {
                                <div class="ipqc-slot-ng-note">@persistedNote</div>
                            }
                        </div>
                    }

                    @if (_openNgFor == slot.Key)
                    {
                        <div class="ipqc-ng-form" data-testid="@($"ipqc-slot-{slot.Key}-ng-form")">
                            <div class="ipqc-ng-field">
                                <label class="rs-modal-label" for="@($"ipqc-{slot.Key}-reason")">@T("ipqc.ng.code")</label>
                                <select id="@($"ipqc-{slot.Key}-reason")"
                                        class="ipqc-input"
                                        value="@_ngReasonCode"
                                        @onchange="@(e => _ngReasonCode = e.Value?.ToString() ?? "")"
                                        data-testid="@($"ipqc-slot-{slot.Key}-ng-reason")">
                                    <option value="">@T("ipqc.ng.select")</option>
                                    @foreach (var r in ScrapReasons)
                                    {
                                        <option value="@r.Code">@r.Code — @r.LabelVi</option>
                                    }
                                </select>
                                @if (ScrapReasons.Count == 0)
                                {
                                    <div class="ipqc-hint ipqc-hint-warn">
                                        @T("ipqc.ng.catalog.empty")
                                    </div>
                                }
                            </div>
                            <div class="ipqc-ng-field ipqc-ng-field-wide">
                                <label class="rs-modal-label" for="@($"ipqc-{slot.Key}-note")">@T("ipqc.ng.note.long")</label>
                                <input id="@($"ipqc-{slot.Key}-note")"
                                       type="text"
                                       class="ipqc-input"
                                       maxlength="500"
                                       value="@_ngNote"
                                       @oninput="@(e => _ngNote = e.Value?.ToString() ?? "")"
                                       data-testid="@($"ipqc-slot-{slot.Key}-ng-note")" />
                                <div class="ipqc-char-count">@_ngNote.Length/500</div>
                            </div>
                            <div class="ipqc-ng-actions">
                                <button type="button"
                                        class="op-btn op-btn-secondary"
                                        @onclick="CloseNgForm"
                                        data-testid="@($"ipqc-slot-{slot.Key}-ng-cancel")">@T("ipqc.btn.cancel")</button>
                                <button type="button"
                                        class="op-btn op-btn-danger"
                                        disabled="@(!CanSubmitNg() || _busy)"
                                        @onclick="@(() => OnSlotNgAsync(slot))"
                                        data-testid="@($"ipqc-slot-{slot.Key}-ng-submit")">
                                    @T("ipqc.btn.savng")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        }

        @* ── Judgment row (WO-level only; per-leg legs advance via the
             LegsDashboard leg card once their IPQC items are all OK) ── *@
        @if (WoLegId is null)
        {
        <div class="rs-card ipqc-judgment" data-testid="ipqc-judgment">
            <div class="rs-card-head">
                <div class="rs-card-title">@T("ipqc.judgment.title")</div>
                @if (_view.IsReadyForJudgment)
                {
                    <div class="ipqc-rollup-pill @(_view.AnyNg ? "ipqc-rollup-warn" : "ipqc-rollup-ok")"
                         data-testid="ipqc-rollup-pill">
                        @if (_view.AllOk)
                        {
                            <span>@T("ipqc.rollup.allok")</span>
                        }
                        else
                        {
                            <span>@T("ipqc.rollup.anyng")</span>
                        }
                    </div>
                }
                else
                {
                    <div class="ipqc-rollup-pill ipqc-rollup-pending"
                         data-testid="ipqc-rollup-pill">
                        @T("ipqc.rollup.pending", 4 - ConfirmedCount)
                    </div>
                }
            </div>

            <div class="ipqc-judgment-actions rs-action-bar-multi" data-testid="ipqc-judgment-buttons">
                <button type="button"
                        class="op-btn op-btn-success ipqc-judgment-btn"
                        disabled="@(!CanGoRun() || _busy)"
                        @onclick="@(() => OnSubmitJudgmentAsync(JudgmentGoRun))"
                        data-testid="ipqc-judgment-gorun">
                    @T("ipqc.judgment.gorun")
                </button>
                <button type="button"
                        class="op-btn op-btn-warning ipqc-judgment-btn"
                        disabled="@(!CanStopLine() || _busy)"
                        @onclick="@(() => OnSubmitJudgmentAsync(JudgmentStopLine))"
                        data-testid="ipqc-judgment-stopline">
                    @T("ipqc.judgment.stopline")
                </button>
                <button type="button"
                        class="op-btn op-btn-danger ipqc-judgment-btn"
                        disabled="@(!CanSpecialAccept() || _busy)"
                        @onclick="@(() => OnSubmitJudgmentAsync(JudgmentSpecialAccept))"
                        data-testid="ipqc-judgment-specialaccept">
                    @T("ipqc.judgment.specialaccept")
                </button>
            </div>

            @if (_view.IsReadyForJudgment && _view.AnyNg)
            {
                <div class="ipqc-judgment-reason">
                    <label class="rs-modal-label" for="ipqc-sa-reason">
                        @T("ipqc.sa.reason.label")
                    </label>
                    <input id="ipqc-sa-reason"
                           type="text"
                           class="ipqc-input"
                           maxlength="500"
                           value="@_specialAcceptReason"
                           @oninput="@(e => _specialAcceptReason = e.Value?.ToString() ?? "")"
                           data-testid="ipqc-special-accept-reason" />
                    <div class="ipqc-char-count">@_specialAcceptReason.Length/500</div>
                </div>
            }

            @if (!_view.IsReadyForJudgment)
            {
                <div class="rs-action-hint" data-testid="ipqc-judgment-hint">
                    @T("ipqc.hint.notready")
                </div>
            }
            else if (!_view.AnyNg)
            {
                <div class="rs-action-hint" data-testid="ipqc-judgment-hint">
                    @T("ipqc.hint.allok")
                </div>
            }
            else
            {
                <div class="rs-action-hint" data-testid="ipqc-judgment-hint">
                    @T("ipqc.hint.anyng")
                </div>
            }
        </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public long WorkOrderId { get; set; }

    /// <summary>P11 per-leg: when set, this dashboard reads/writes THAT leg's
    /// own IPQC surface (scoped WoLegId, by leg.ProcessLine). Null = WO-level
    /// (1-leg / legacy) — unchanged.</summary>
    [Parameter] public long? WoLegId { get; set; }

    /// <summary>Scrap reason codes for the NG dropdowns. Loaded by the
    /// parent (WorkOrders.razor) once on init + handed in so the
    /// dashboard never re-fetches per render. Empty list surfaces as
    /// "danh mục NG trống" hint inline.</summary>
    [Parameter] public IReadOnlyList<ReasonCodeOption> ScrapReasons { get; set; } = Array.Empty<ReasonCodeOption>();

    /// <summary>P10.7d-3 BUG-FIX (Henry RCA on PR #119) — invoked
    /// after a successful action that changes the WO's MesPhase
    /// (judgment submit). Parent (WorkOrders.razor) re-fetches the
    /// summary so the chip + dispatch see the canonical post-transition
    /// state without the operator tapping "Tìm" again. See Lesson L21.</summary>
    [Parameter] public EventCallback OnPhaseChanged { get; set; }

    // Judgment constants — match server-side enum (Domain/StateMachine).
    private const string JudgmentGoRun = "GoRun";
    private const string JudgmentStopLine = "StopLine";
    private const string JudgmentSpecialAccept = "SpecialAccept";

    private IpqcView? _view;
    private string? _initialError;
    private string? _setError;
    private bool _busy;
    private bool _invalidPhase;
    private long _lastLoadedWoId;
    private long? _lastLoadedLegId;

    // NG-form local state — single open at a time (one of the 4 slot keys).
    // Plain string keys ("material" / "print-a" / "print-b" / "print-c") so
    // bUnit can target by data-testid without enum noise.
    private string? _openNgFor;
    private string _ngReasonCode = "";
    private string _ngNote = "";

    private string _specialAcceptReason = "";

    // ── IPQC first-article (h-3) — MATERIAL (SYSTEM) reconciliation ──
    private IpqcMaterialSystemView? _material;
    private int? _openMaterialNgFor;     // BomLineIdx of the open material NG form
    private string _waiverReason = "";   // Engineer waiver reason draft

    // First-article stepper — active tab (Visual/Dimension/Function/Other).
    private string _activeTab = TabVisual;
    private const string TabVisual = "visual";
    private const string TabDimension = "dimension";
    private const string TabFunction = "function";
    private const string TabOther = "other";

    // Per-item measured-value drafts (edited before the item PUT persists them).
    private readonly Dictionary<string, string> _measuredDrafts = new();

    private static readonly SlotDef[] _slots =
    {
        new("material", "Material recheck", "Correct roll, lot, code, cleaned after setting"),
        new("print-a",  "Print A — Color (ΔE)", "Measure ΔE ≤ spec threshold (default ≤ 2)"),
        new("print-b",  "Print B — Registration", "Color overlay / alignment within tolerance"),
        new("print-c",  "Print C — Content", "Text content + barcode match spec"),
    };

    /// <summary>Phương án C — data-driven khi server trả về Items (auto-sync
    /// đã materialize từ thư viện). Rỗng → mode 4-slot legacy.</summary>
    private bool ItemsMode => _view is not null && _view.Items.Count > 0;

    /// <summary>F2 — câu cảnh báo khi auto-sync KHÔNG nạp được bộ item (null = không cảnh báo).</summary>
    private string? AutoSyncWarning => _view?.AutoSyncStatus switch
    {
        "SkippedUnmapped" => T("ipqc.autosync.skipped.unmapped"),
        "SkippedNoLibrary" => T("ipqc.autosync.skipped.nolibrary"),
        _ => null,
    };

    private int TotalCount => ItemsMode ? _view!.Items.Count : 4;

    private int ConfirmedCount => _view is null ? 0
        : ItemsMode
            ? _view.Items.Count(i => i.Status != "Pending")
            : (_view.MaterialStatus != "Pending" ? 1 : 0)
              + (_view.PrintAStatus != "Pending" ? 1 : 0)
              + (_view.PrintBStatus != "Pending" ? 1 : 0)
              + (_view.PrintCStatus != "Pending" ? 1 : 0);

    private static string Slug(string? s) =>
        new string((s ?? "").Where(char.IsLetterOrDigit).ToArray());

    /// <summary>Phương án C — Bước 5: mã lỗi NG SCOPE theo process line. Lọc
    /// catalog Scrap về đúng những DefectCode của bộ item đã materialize (vốn
    /// đã line-scoped). Rỗng → lùi về full catalog (an toàn, không chặn cứng).</summary>
    private IReadOnlyList<ReasonCodeOption> ScopedScrapReasons
    {
        get
        {
            if (!ItemsMode) return ScrapReasons;
            var allow = _view!.Items
                .Where(i => !string.IsNullOrWhiteSpace(i.DefectCode))
                .Select(i => i.DefectCode!)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            if (allow.Count == 0) return ScrapReasons;
            var scoped = ScrapReasons.Where(r => allow.Contains(r.Code)).ToList();
            return scoped.Count > 0 ? scoped : ScrapReasons;
        }
    }

    private static string ItemCssClass(IpqcViewItem item) => item.Status switch
    {
        "Ok" => "ipqc-slot-ok",
        "Ng" => "ipqc-slot-ng",
        _    => "ipqc-slot-pending",
    };

    // ── First-article stepper (Visual / Dimension / Function / Other) ─

    /// <summary>Map an item's <see cref="IpqcViewItem.CheckType"/> to a stepper
    /// tab key. "Measure"→dimension, "Functional"→function, "Visual"→visual.
    /// Null / anything else → "other" (fallback tab — never swallowed).</summary>
    private static string TabForItem(IpqcViewItem item) => (item.CheckType ?? "").Trim().ToLowerInvariant() switch
    {
        "visual" => TabVisual,
        "measure" or "dimension" => TabDimension,
        "functional" or "function" => TabFunction,
        _ => TabOther,
    };

    private sealed record TabDef(string Key, string LabelKey, int Count);

    /// <summary>Tabs that actually have items — Visual/Dimension/Function
    /// always shown (order fixed); "Other" appears ONLY when a fallback item
    /// exists so it doesn't clutter the common case.</summary>
    private IReadOnlyList<TabDef> ActiveTabs
    {
        get
        {
            if (_view is null) return Array.Empty<TabDef>();
            int Count(string key) => _view.Items.Count(i => TabForItem(i) == key);
            var tabs = new List<TabDef>
            {
                new(TabVisual, "ipqc.tab.visual", Count(TabVisual)),
                new(TabDimension, "ipqc.tab.dimension", Count(TabDimension)),
                new(TabFunction, "ipqc.tab.function", Count(TabFunction)),
            };
            var other = Count(TabOther);
            if (other > 0) tabs.Add(new(TabOther, "ipqc.tab.other", other));
            return tabs;
        }
    }

    private IEnumerable<IpqcViewItem> ItemsInActiveTab =>
        _view is null ? Enumerable.Empty<IpqcViewItem>()
                      : _view.Items.Where(i => TabForItem(i) == _activeTab);

    // ── Measured-value draft (per item) ─────────────────────────────

    private string MeasuredDraft(IpqcViewItem item) =>
        _measuredDrafts.TryGetValue(item.ItemKey, out var v) ? v : (item.MeasuredValue ?? "");

    private void SetMeasuredDraft(string itemKey, string value) => _measuredDrafts[itemKey] = value;

    /// <summary>Persist the measured value WITHOUT changing the OK/NG verdict —
    /// re-sends the item's current status + reason + note so the server keeps
    /// them, adding the measured value.</summary>
    private Task OnSaveMeasuredAsync(IpqcViewItem item) =>
        SubmitItemAsync(item.ItemKey, new SetIpqcItemRequest
        {
            Status = item.Status,
            NgReasonCode = item.Status == "Ng" ? item.NgReasonCode : null,
            NgNote = item.Status == "Ng" ? item.NgNote : null,
            MeasuredValue = MeasuredDraft(item),
        });

    // ── Item (data-driven) mutation calls ───────────────────────────

    private Task OnItemOkAsync(string itemKey) =>
        SubmitItemAsync(itemKey, new SetIpqcItemRequest
        {
            Status = "Ok",
            MeasuredValue = MeasuredForKey(itemKey),
        });

    private string? MeasuredForKey(string itemKey)
    {
        if (_measuredDrafts.TryGetValue(itemKey, out var v) && !string.IsNullOrWhiteSpace(v)) return v;
        return _view?.Items.FirstOrDefault(i => i.ItemKey == itemKey)?.MeasuredValue;
    }

    private void OpenItemNgForm(IpqcViewItem item)
    {
        if (_busy) return;
        _openNgFor = item.ItemKey;
        // Gợi ý mã lỗi mặc định của hạng mục (từ thư viện) nếu hợp lệ trong catalog.
        _ngReasonCode = (!string.IsNullOrWhiteSpace(item.NgReasonCode)
            ? item.NgReasonCode
            : (ScrapReasons.Any(r => r.Code == item.DefectCode) ? item.DefectCode : "")) ?? "";
        _ngNote = item.NgNote ?? "";
    }

    private async Task OnItemNgAsync(string itemKey)
    {
        if (!CanSubmitNg()) return;
        await SubmitItemAsync(itemKey, new SetIpqcItemRequest
        {
            Status = "Ng",
            NgReasonCode = _ngReasonCode,
            NgNote = _ngNote,
            MeasuredValue = MeasuredForKey(itemKey),
        });
    }

    private async Task SubmitItemAsync(string itemKey, SetIpqcItemRequest req)
    {
        if (_view is null || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var resp = await Api.PutIpqcItemAsync(WorkOrderId, _view.ETag, itemKey, req, WoLegId);
            await HandleSetResponseAsync(resp);
            if (resp.Ok) CloseNgForm();
        }
        catch (ApiException apiEx)
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = T("ipqc.error.connect", ex.Message);
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (WorkOrderId != _lastLoadedWoId || WoLegId != _lastLoadedLegId)
        {
            _lastLoadedWoId = WorkOrderId;
            _lastLoadedLegId = WoLegId;
            _view = null;
            _initialError = null;
            _setError = null;
            _invalidPhase = false;
            _openNgFor = null;
            _openMaterialNgFor = null;
            _ngReasonCode = "";
            _ngNote = "";
            _specialAcceptReason = "";
            _waiverReason = "";
            _material = null;
            _measuredDrafts.Clear();
            _activeTab = TabVisual;
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _view = await Api.GetIpqcViewAsync(WorkOrderId, WoLegId);
            // Per-leg: the WO stays SPLIT while the LEG sits at IPQC_WAIT, so the
            // WO-phase guard must not fire (the leg phase is enforced server-side).
            _invalidPhase = WoLegId is null && _view.MesPhase != "IPQC_WAIT";

            // First-article: default the stepper to the first tab that has items.
            _activeTab = FirstNonEmptyTab();

            // MATERIAL (SYSTEM) reconciliation — WO-level, IPQC_WAIT only.
            await ReloadMaterialAsync();
        }
        catch (ApiException apiEx)
        {
            _initialError = IpqcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (HttpRequestException ex)
        {
            _initialError = T("ipqc.error.connect", ex.Message);
        }
        catch (Exception ex)
        {
            _initialError = T("ipqc.error.loading", $"{ex.GetType().Name}: {ex.Message}");
        }
    }

    /// <summary>Load the MATERIAL (SYSTEM) grid. Best-effort + non-fatal — a
    /// missing grid must NOT blank the judgment/items surface; the error rides
    /// its own inline banner. Only WO-level (WoLegId null) + IPQC_WAIT.</summary>
    private async Task ReloadMaterialAsync()
    {
        if (WoLegId is not null || _invalidPhase)
        {
            _material = null;
            return;
        }
        try
        {
            _material = await Api.GetIpqcMaterialSystemAsync(WorkOrderId);
        }
        catch (ApiException apiEx)
        {
            _material = null;
            _setError = IpqcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
        }
        catch (Exception)
        {
            _material = null;
        }
    }

    private string FirstNonEmptyTab()
    {
        var tabs = ActiveTabs;
        return tabs.FirstOrDefault(t => t.Count > 0)?.Key ?? TabVisual;
    }

    // ── MATERIAL (SYSTEM) — role gate + mutation calls (h-3) ────────

    /// <summary>RBAC-by-omission — the waiver Approve/Reject buttons are BUILT
    /// only for Engineer/Supervisor/Admin. The server still enforces the
    /// EngineerWaive policy (403 otherwise); this is defence-in-depth so a
    /// QC/Operator never even sees the control.</summary>
    private bool CanWaive =>
        Session.CurrentUserInfo?.Role is { Length: > 0 } role
        && (string.Equals(role, "Engineer", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "Supervisor", StringComparison.OrdinalIgnoreCase)
            || string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase));

    private bool CanWaiveSubmit() =>
        !string.IsNullOrWhiteSpace(_waiverReason) && _waiverReason.Length <= 500;

    private void OpenMaterialNgForm(IpqcMaterialRow row)
    {
        if (_busy) return;
        _openMaterialNgFor = row.BomLineIdx;
        _ngReasonCode = row.NgReasonCode ?? "";
        _ngNote = row.NgNote ?? "";
    }

    private Task OnMaterialOkAsync(int bomLineIdx) =>
        SubmitMaterialAsync(bomLineIdx, new SetIpqcMaterialRequest { Status = "Ok" });

    private async Task OnMaterialNgAsync(int bomLineIdx)
    {
        if (!CanSubmitNg()) return;
        await SubmitMaterialAsync(bomLineIdx, new SetIpqcMaterialRequest
        {
            Status = "Ng",
            NgReasonCode = _ngReasonCode,
            NgNote = _ngNote,
        });
    }

    private async Task SubmitMaterialAsync(int bomLineIdx, SetIpqcMaterialRequest req)
    {
        if (_material is null || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var resp = await Api.PutIpqcMaterialSystemAsync(WorkOrderId, _material.ETag, bomLineIdx, req);
            await HandleMaterialResponseAsync(resp);
            if (resp.Ok) CloseNgForm();
        }
        catch (ApiException apiEx)
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadMaterialAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = T("ipqc.error.connect", ex.Message);
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnWaiveAsync(int bomLineIdx, string outcome)
    {
        if (_material is null || _busy || !CanWaiveSubmit()) return;
        _busy = true;
        _setError = null;
        try
        {
            var resp = await Api.PostIpqcMaterialApproveDivergenceAsync(
                WorkOrderId, _material.ETag, bomLineIdx,
                new ApproveDivergenceRequest { Outcome = outcome, Reason = _waiverReason });
            await HandleMaterialResponseAsync(resp);
            if (resp.Ok) _waiverReason = "";
        }
        catch (ApiException apiEx)
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadMaterialAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = T("ipqc.error.connect", ex.Message);
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Handle the <see cref="IpqcMaterialSetResponse"/>. Mirrors
    /// <see cref="HandleSetResponseAsync"/>: 200 → reload the grid to capture
    /// server-computed rollup/approval fields; non-ok → banner + reload. The
    /// material panel + waiver never bubble OnPhaseChanged — they don't change
    /// MesPhase (only judgment does), so the parent dispatch stays put.</summary>
    private async Task HandleMaterialResponseAsync(IpqcMaterialSetResponse resp)
    {
        if (resp.Ok)
        {
            await ReloadMaterialAsync();
            return;
        }
        if (!string.IsNullOrEmpty(resp.ErrorCode))
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseSetError(resp.ErrorCode);
            await ReloadMaterialAsync();
            return;
        }
        _setError = T("ipqc.error.no_code");
    }

    // ── Slot helpers ────────────────────────────────────────────────

    private string SlotStatus(SlotDef slot) => slot.Key switch
    {
        "material" => _view?.MaterialStatus ?? "Pending",
        "print-a"  => _view?.PrintAStatus ?? "Pending",
        "print-b"  => _view?.PrintBStatus ?? "Pending",
        "print-c"  => _view?.PrintCStatus ?? "Pending",
        _          => "Pending",
    };

    private string? SlotNgReason(SlotDef slot) => slot.Key switch
    {
        "material" => _view?.MaterialNgReasonCode,
        "print-a"  => _view?.PrintANgReasonCode,
        "print-b"  => _view?.PrintBNgReasonCode,
        "print-c"  => _view?.PrintCNgReasonCode,
        _          => null,
    };

    private string? SlotNgNote(SlotDef slot) => slot.Key switch
    {
        "material" => _view?.MaterialNgNote,
        "print-a"  => _view?.PrintANgNote,
        "print-b"  => _view?.PrintBNgNote,
        "print-c"  => _view?.PrintCNgNote,
        _          => null,
    };

    private string SlotCssClass(SlotDef slot) => SlotStatus(slot) switch
    {
        "Ok"  => "ipqc-slot-ok",
        "Ng"  => "ipqc-slot-ng",
        _     => "ipqc-slot-pending",
    };

    private string StatusDisplay(string status) => status switch
    {
        "Ok" => T("ipqc.status.ok"),
        "Ng" => T("ipqc.status.ng"),
        _    => T("ipqc.status.pending"),
    };

    private static string StatusPillCss(string status) => status switch
    {
        "Ok" => "ipqc-status-ok",
        "Ng" => "ipqc-status-ng",
        _    => "ipqc-status-pending",
    };

    // ── NG-form lifecycle ───────────────────────────────────────────

    private void OpenNgForm(string slotKey)
    {
        if (_busy) return;
        _openNgFor = slotKey;
        // Pre-populate with existing NG values if the slot was already NG —
        // operator might be editing the reason/note without flipping back to OK first.
        var slot = _slots.First(s => s.Key == slotKey);
        _ngReasonCode = SlotNgReason(slot) ?? "";
        _ngNote = SlotNgNote(slot) ?? "";
    }

    private void CloseNgForm()
    {
        _openNgFor = null;
        _openMaterialNgFor = null;
        _ngReasonCode = "";
        _ngNote = "";
    }

    private bool CanSubmitNg() =>
        !string.IsNullOrWhiteSpace(_ngReasonCode)
        && ScrapReasons.Any(r => r.Code == _ngReasonCode)
        && !string.IsNullOrWhiteSpace(_ngNote)
        && _ngNote.Length <= 500;

    private void DismissSetError() => _setError = null;

    // ── Slot mutation calls ─────────────────────────────────────────

    private Task OnSlotOkAsync(SlotDef slot) =>
        SubmitSlotAsync(slot, new SetIpqcSlotRequest { Status = "Ok" });

    private async Task OnSlotNgAsync(SlotDef slot)
    {
        if (!CanSubmitNg()) return;
        await SubmitSlotAsync(slot, new SetIpqcSlotRequest
        {
            Status = "Ng",
            NgReasonCode = _ngReasonCode,
            NgNote = _ngNote,
        });
        // Form auto-closes on success in HandleSetResponse.
    }

    private async Task SubmitSlotAsync(SlotDef slot, SetIpqcSlotRequest req)
    {
        if (_view is null || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var task = slot.Key switch
            {
                "material" => Api.PutIpqcMaterialAsync(WorkOrderId, _view.ETag, req),
                "print-a"  => Api.PutIpqcPrintAAsync(WorkOrderId, _view.ETag, req),
                "print-b"  => Api.PutIpqcPrintBAsync(WorkOrderId, _view.ETag, req),
                "print-c"  => Api.PutIpqcPrintCAsync(WorkOrderId, _view.ETag, req),
                _          => Task.FromResult(new IpqcSetResponse { Ok = false, ErrorCode = "client.unknown_slot" }),
            };
            var resp = await task;
            await HandleSetResponseAsync(resp);
            // Close NG form on success — operator sees the persisted state
            // via the slot summary block below the buttons.
            if (resp.Ok) CloseNgForm();
        }
        catch (ApiException apiEx)
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = T("ipqc.error.connect", ex.Message);
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Judgment helpers ────────────────────────────────────────────

    private bool CanGoRun() =>
        _view is not null && _view.IsReadyForJudgment && _view.AllOk && !_view.AnyNg;

    private bool CanStopLine() =>
        _view is not null && _view.IsReadyForJudgment && _view.AnyNg;

    private bool CanSpecialAccept() =>
        _view is not null
        && _view.IsReadyForJudgment
        && _view.AnyNg
        && !string.IsNullOrWhiteSpace(_specialAcceptReason)
        && _specialAcceptReason.Length <= 500;

    private async Task OnSubmitJudgmentAsync(string judgment)
    {
        if (_view is null || _busy) return;
        _busy = true;
        _setError = null;
        try
        {
            var req = new SubmitIpqcJudgmentRequest
            {
                Judgment = judgment,
                SpecialAcceptReason = judgment == JudgmentSpecialAccept ? _specialAcceptReason : null,
            };
            var resp = await Api.PostIpqcJudgmentAsync(WorkOrderId, _view.ETag, req);
            await HandleSetResponseAsync(resp);
            // After a successful judgment the WO leaves IPQC_WAIT:
            //   GoRun         → IPQC_APPROVED  (RunningDashboard takes over)
            //   StopLine      → PREPRESS       (PrepressDashboard takes over)
            //   SpecialAccept → QA_PENDING     (QaApprovalDashboard takes over)
            // P10.7d-3 BUG-FIX — bubble the phase change up so the parent
            // re-fetches the summary + re-dispatches WITHOUT the operator
            // tapping "Tìm" again. See Lesson L21.
            if (resp.Ok)
            {
                await OnPhaseChanged.InvokeAsync();
            }
        }
        catch (ApiException apiEx)
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseApiError(apiEx.StatusCode, apiEx.ApiError);
            if (apiEx.ApiError.Code == "wo.invalid_phase") _invalidPhase = true;
            await ReloadAsync();
        }
        catch (HttpRequestException ex)
        {
            _setError = T("ipqc.error.connect", ex.Message);
        }
        catch (Exception ex)
        {
            _setError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Shared response handler ─────────────────────────────────────

    /// <summary>Centralised handling of <see cref="IpqcSetResponse"/>
    /// for all 5 mutation endpoints. Mirrors the SettingDashboard /
    /// RunningDashboard contract: 200 → reload to capture audit-side
    /// fields; 409 / 422 → set-error banner + reload (the response
    /// carries the fresh ETag so the next attempt can retry without
    /// an extra GET, but reload is cheap + simpler).</summary>
    private async Task HandleSetResponseAsync(IpqcSetResponse resp)
    {
        if (resp.Ok)
        {
            await ReloadAsync();
            return;
        }

        if (!string.IsNullOrEmpty(resp.ErrorCode))
        {
            _setError = IpqcReviewErrorLocaliser.LocaliseSetError(resp.ErrorCode);
            // ALWAYS reload on a non-ok response — the server may have
            // moved past us (state_conflict) so the canonical state must
            // become source-of-truth. This implements the "optimistic
            // revert on 409" pattern: the slot button click ran without
            // local UI flip, server rejected, we re-sync to truth.
            await ReloadAsync();
            return;
        }

        _setError = T("ipqc.error.no_code");
    }

    private sealed record SlotDef(string Key, string Title, string Subtitle);
}
