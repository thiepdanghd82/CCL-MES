@inject ICclApiClient Api
@inject IFilePickerService FilePicker
@using CCL.MES.Hybrid.Client.Files
@using CCL.MES.Hybrid.Client.Specs
@using CCL.MES.Shared.Specs

@*
    P10.5c-2 — Import Spec from xlsx flow.

    Stages:
      1. Choose       — operator picks planner category + clicks "Chọn file" → opens native picker.
      2. Uploading    — multipart STREAM upload → /import/preview.
      3. PreviewOk    — render showcard preview + dup-handling buttons.
      4. PreviewError — banner + Thử lại.
      5. Saving       — /import/save in flight.
      6. SaveOk       — success message → close + parent refresh.
      7. SaveError    — banner + Thử lại.

    Dup-handling decision tree:
      - DuplicateRefNo = false       → single button "Lưu vào hệ thống".
      - DuplicateStatus = "Draft"    → reject inline; only Hủy.
      - DuplicateStatus = other      → 3 options:
          * "Thay thế (Upgrade Rev)" → SaveAsync mode = UpgradeRev (soft-trash existing).
          * "Lưu thành bản sao mới"   → SaveAsync mode = SaveAsCopy + operator types new SpecCode.
          * "Hủy"                    → close.

    _submitting mandatory per Q11 — gates Cancel + close + button clicks
    during any in-flight network call so a fast double-tap can't fire two
    requests. Online-only per Q4 — no outbox; failure shows inline VN
    error + Thử lại.
*@

<Modal Open="@Open" OnClose="@RequestCloseAsync" Size="ModalSize.Lg"
       Severity="@HeaderSeverity" ClickOutsideToClose="false">
    <Header>@StageTitle</Header>
    <Body>
        @switch (_stage)
        {
            case Stage.Choose:
                @RenderChooseStage()
                break;
            case Stage.Uploading:
            case Stage.Saving:
                <p class="grid-status import-busy">
                    @(_stage == Stage.Uploading ? "Uploading + reading file…" : "Saving to the system…")
                </p>
                break;
            case Stage.PreviewError:
                <div class="modal-banner modal-banner-error" role="alert">
                    <strong>Could not read the xlsx file.</strong>
                    <div>@_error</div>
                </div>
                @if (_warnings.Count > 0)
                {
                    <ul class="import-warnings">
                        @foreach (var w in _warnings) { <li>@w</li> }
                    </ul>
                }
                break;
            case Stage.SaveError:
                <div class="modal-banner modal-banner-error" role="alert">
                    <strong>Save failed.</strong>
                    <div>@_error</div>
                </div>
                @if (_preview is not null)
                {
                    @RenderPreviewBody()
                }
                break;
            case Stage.PreviewOk:
                @RenderPreviewBody()
                break;
            case Stage.SaveOk:
                <div class="modal-banner modal-banner-success" role="status">
                    <strong>New Spec saved.</strong>
                    <div>Spec <code>@_saveResponse?.SpecCode</code> — @_saveResponse?.RowsParsed data rows.</div>
                </div>
                break;
        }
    </Body>
    <Footer>
        @switch (_stage)
        {
            case Stage.Choose:
                <button type="button" class="op-btn op-btn-secondary"
                        disabled="@_submitting" @onclick="RequestCloseAsync">Cancel</button>
                <button type="button" class="op-btn op-btn-primary"
                        disabled="@(!CanUpload())" @onclick="StartUploadAsync">
                    @(_submitting ? "Loading…" : "Choose file + preview")
                </button>
                break;

            case Stage.Uploading:
            case Stage.Saving:
                <button type="button" class="op-btn op-btn-secondary" disabled="true">Processing…</button>
                break;

            case Stage.PreviewError:
                <button type="button" class="op-btn op-btn-secondary"
                        @onclick="ResetToChooseAsync">Choose another file</button>
                <button type="button" class="op-btn op-btn-primary"
                        @onclick="StartUploadAsync">Retry</button>
                break;

            case Stage.PreviewOk:
                @RenderPreviewFooter()
                break;

            case Stage.SaveError:
                <button type="button" class="op-btn op-btn-secondary"
                        @onclick="ResetToChooseAsync">Choose another file</button>
                <button type="button" class="op-btn op-btn-primary"
                        @onclick="() => SaveAsync(_lastMode)">Retry</button>
                break;

            case Stage.SaveOk:
                <button type="button" class="op-btn op-btn-primary" @onclick="RequestCloseAsync">Close</button>
                break;
        }
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SpecImportSaveResponse> OnImported { get; set; }

    private enum Stage { Choose, Uploading, PreviewOk, PreviewError, Saving, SaveOk, SaveError }

    private static readonly (string Code, string Label)[] CategoryOptions = new[]
    {
        ("silkscreen", "Silkscreen"),
        ("flexo",       "Flexo"),
        ("letterpress", "Letterpress"),
        ("indigo",      "Indigo"),
        ("diecut",      "Diecut"),
    };

    private Stage _stage = Stage.Choose;
    private string _category = "silkscreen";
    private PickedFile? _pickedFile;
    private SpecImportPreviewResponse? _preview;
    private SpecImportSaveResponse? _saveResponse;
    private List<string> _warnings = new();
    private string? _error;
    private bool _submitting;

    // SaveAsCopy needs an operator-typed SpecCode. Bound on the preview
    // stage when dup is non-Draft.
    private string _copySpecCode = "";

    // Last mode attempted — used by "Thử lại" on SaveError to re-fire the
    // same path the operator chose.
    private string _lastMode = SpecImportSaveMode.SaveNew;

    private ModalSeverity HeaderSeverity => _stage switch
    {
        Stage.PreviewError or Stage.SaveError => ModalSeverity.Warning,
        Stage.SaveOk                          => ModalSeverity.Success,
        _                                     => ModalSeverity.Info,
    };

    private string StageTitle => _stage switch
    {
        Stage.Choose       => "Import Spec from xlsx file",
        Stage.Uploading    => "Uploading file…",
        Stage.PreviewOk    => "Spec preview",
        Stage.PreviewError => "File read error",
        Stage.Saving       => "Saving…",
        Stage.SaveOk       => "Complete",
        Stage.SaveError    => "Save error",
        _                  => "Import Spec",
    };

    protected override void OnParametersSet()
    {
        if (!Open) ResetState();
    }

    private bool CanUpload() => !_submitting && !string.IsNullOrWhiteSpace(_category);

    private RenderFragment RenderChooseStage() => __builder =>
    {
        <text>
        <p class="import-help">Select the Spec's process type, then click <strong>Choose file</strong> to open the system dialog.</p>
        <div class="modal-field">
            <label>Process type <span class="modal-req">*</span></label>
            <div class="import-category-row" role="radiogroup" aria-label="Planner category">
                @foreach (var opt in CategoryOptions)
                {
                    var isSel = string.Equals(_category, opt.Code, StringComparison.OrdinalIgnoreCase);
                    <button type="button" role="radio" aria-checked="@(isSel ? "true" : "false")"
                            class="import-category-chip @(isSel ? "is-active" : "")"
                            disabled="@_submitting"
                            @onclick="() => { _category = opt.Code; StateHasChanged(); }">@opt.Label</button>
                }
            </div>
        </div>
        <p class="import-help-note">
            The file must be a valid <code>.xlsx</code>, size ≤ 10 MB. When the
            dialog opens, the operating system will only allow files of the correct format.
        </p>
        @if (_error is not null)
        {
            <div class="modal-banner modal-banner-error" role="alert">@_error</div>
        }
        </text>
    };

    private RenderFragment RenderPreviewBody() => __builder =>
    {
        if (_preview is null) return;
        <text>
        @if (_preview.Summary is not null)
        {
            var vm = SpecShowcardVm.FromImportSummary(_preview.Summary, _preview.FileName);
            <div class="import-preview-meta">
                <span><strong>File:</strong> <code>@_preview.FileName</code></span>
                <span><strong>Size:</strong> @FormatBytes(_preview.FileSizeBytes)</span>
                <span><strong>Process:</strong> @ResolveCategoryLabel(_preview.PlannerCategory)</span>
            </div>
            <SpecShowcardCompact Vm="vm" />
        }
        @if (_preview.Warnings.Count > 0)
        {
            <details class="import-warnings-block" open>
                <summary>Warnings while reading the file (@_preview.Warnings.Count)</summary>
                <ul class="import-warnings">
                    @foreach (var w in _preview.Warnings) { <li>@w</li> }
                </ul>
            </details>
        }
        @if (_preview.DuplicateRefNo)
        {
            @RenderDupNotice()
        }
        </text>
    };

    private RenderFragment RenderDupNotice() => __builder =>
    {
        var isDraft = string.Equals(_preview?.DuplicateStatus, "Draft", StringComparison.OrdinalIgnoreCase);
        <text>
        @if (isDraft)
        {
            <div class="modal-banner modal-banner-error" role="alert">
                <strong>Duplicate Spec is in Draft status.</strong>
                <div>
                    Spec code <code>@_preview!.DuplicateSpecCode</code> (id @_preview.DuplicateRevisionId)
                    already has this REF NO. The system does not allow replacing a draft —
                    edit that draft directly or change the REF NO in the file and import again.
                </div>
            </div>
        }
        else
        {
            <div class="modal-banner modal-banner-warning" role="alert">
                <strong>A Spec @ResolveDupStatusLabel(_preview!.DuplicateStatus) with the same REF NO already exists.</strong>
                <div>
                    Existing Spec code: <code>@_preview.DuplicateSpecCode</code>.
                    Choose an action below.
                </div>
            </div>
            <div class="modal-field">
                <label for="import-copy-code">New Spec code (if "Save as copy")</label>
                <input id="import-copy-code" type="text" class="modal-input" maxlength="64"
                       placeholder="@($"e.g. {_preview.DuplicateSpecCode}-COPY")"
                       @bind="_copySpecCode" @bind:event="oninput" disabled="@_submitting" />
            </div>
        }
        </text>
    };

    private RenderFragment RenderPreviewFooter() => __builder =>
    {
        if (_preview is null) return;
        var isDraftDup = _preview.DuplicateRefNo && string.Equals(_preview.DuplicateStatus, "Draft", StringComparison.OrdinalIgnoreCase);
        <text>
        @if (isDraftDup)
        {
            <button type="button" class="op-btn op-btn-secondary"
                    @onclick="RequestCloseAsync">Cancel</button>
        }
        else if (_preview.DuplicateRefNo)
        {
            <button type="button" class="op-btn op-btn-secondary"
                    disabled="@_submitting" @onclick="RequestCloseAsync">Cancel</button>
            <button type="button" class="op-btn op-btn-secondary"
                    disabled="@_submitting" @onclick="() => SaveAsync(SpecImportSaveMode.SaveAsCopy)">
                @(_submitting && _lastMode == SpecImportSaveMode.SaveAsCopy ? "Saving…" : "Save as copy")
            </button>
            <button type="button" class="op-btn op-btn-warning"
                    disabled="@_submitting" @onclick="() => SaveAsync(SpecImportSaveMode.UpgradeRev)">
                @(_submitting && _lastMode == SpecImportSaveMode.UpgradeRev ? "Saving…" : "Supersede (Upgrade Rev)")
            </button>
        }
        else
        {
            <button type="button" class="op-btn op-btn-secondary"
                    disabled="@_submitting" @onclick="RequestCloseAsync">Cancel</button>
            <button type="button" class="op-btn op-btn-primary"
                    disabled="@_submitting" @onclick="() => SaveAsync(SpecImportSaveMode.SaveNew)">
                @(_submitting ? "Saving…" : "Save to system")
            </button>
        }
        </text>
    };

    private async Task StartUploadAsync()
    {
        if (_submitting) return;
        _submitting = true;
        _error = null;
        StateHasChanged();
        try
        {
            // Re-pick whenever the operator clicks "Chọn file" so a retry
            // after a parse error doesn't reuse a stale stream.
            await DisposePickedFileAsync();
            _pickedFile = await FilePicker.PickXlsxAsync();
            if (_pickedFile is null)
            {
                // Operator cancelled the OS picker — stay on Choose with
                // no error banner (cancel ≠ failure).
                _submitting = false;
                StateHasChanged();
                return;
            }
            _stage = Stage.Uploading;
            StateHasChanged();
            // Stream the file content directly to the multipart upload;
            // CclApiClient wraps with StreamContent so no full-file buffer.
            _preview = await Api.ImportPreviewSpecAsync(_pickedFile.Content, _pickedFile.FileName, _category);
            // Stream is consumed at this point — close it.
            await DisposePickedFileAsync();
            if (!_preview.ParseOk)
            {
                _error = string.IsNullOrWhiteSpace(_preview.ParseError) ? "Could not read the xlsx file." : _preview.ParseError;
                _warnings = _preview.Warnings;
                _stage = Stage.PreviewError;
            }
            else
            {
                _stage = Stage.PreviewOk;
            }
        }
        catch (ApiException apiEx)
        {
            _error = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _stage = Stage.PreviewError;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not connect to the server: {ex.Message}";
            _stage = Stage.PreviewError;
        }
        catch (TaskCanceledException)
        {
            _error = "The file upload took too long (over 90 seconds). Check your network and try again.";
            _stage = Stage.PreviewError;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
            _stage = Stage.PreviewError;
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync(string mode)
    {
        if (_submitting) return;
        if (_preview is null || string.IsNullOrWhiteSpace(_preview.ParsedJson))
        {
            _error = "The preview session has expired — choose the file again.";
            _stage = Stage.PreviewError;
            StateHasChanged();
            return;
        }
        if (mode == SpecImportSaveMode.SaveAsCopy && string.IsNullOrWhiteSpace(_copySpecCode))
        {
            _error = "You must enter a new Spec code when choosing Save as copy.";
            _stage = Stage.SaveError;
            StateHasChanged();
            return;
        }

        _submitting = true;
        _lastMode = mode;
        _error = null;
        _stage = Stage.Saving;
        StateHasChanged();
        try
        {
            var req = new SpecImportSaveRequest
            {
                ParsedJson = _preview.ParsedJson!,
                FileName = _preview.FileName,
                PlannerCategory = _preview.PlannerCategory,
                Mode = mode,
                SpecCodeOverride = mode == SpecImportSaveMode.SaveAsCopy ? _copySpecCode.Trim() : null,
            };
            _saveResponse = await Api.ImportSaveSpecAsync(req);
            _stage = Stage.SaveOk;
            if (OnImported.HasDelegate) await OnImported.InvokeAsync(_saveResponse);
        }
        catch (ApiException apiEx)
        {
            _error = SpecMutationErrorMapper.ToVietnameseMessage(apiEx);
            _stage = Stage.SaveError;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Could not connect to the server: {ex.Message}";
            _stage = Stage.SaveError;
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
            _stage = Stage.SaveError;
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    private Task ResetToChooseAsync()
    {
        if (_submitting) return Task.CompletedTask;
        _preview = null;
        _saveResponse = null;
        _error = null;
        _warnings.Clear();
        _copySpecCode = "";
        _stage = Stage.Choose;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RequestCloseAsync()
    {
        if (_submitting) return;
        await DisposePickedFileAsync();
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private void ResetState()
    {
        _ = DisposePickedFileAsync().AsTask();
        _stage = Stage.Choose;
        _category = "silkscreen";
        _preview = null;
        _saveResponse = null;
        _error = null;
        _warnings = new();
        _copySpecCode = "";
        _submitting = false;
        _lastMode = SpecImportSaveMode.SaveNew;
    }

    private async ValueTask DisposePickedFileAsync()
    {
        if (_pickedFile is not null)
        {
            try { await _pickedFile.DisposeAsync(); }
            catch { /* swallow — stream may already be consumed */ }
            _pickedFile = null;
        }
    }

    private static string ResolveCategoryLabel(string code) =>
        CategoryOptions.FirstOrDefault(o => string.Equals(o.Code, code, StringComparison.OrdinalIgnoreCase)).Label
        ?? code;

    private static string ResolveDupStatusLabel(string? raw) => (raw ?? "") switch
    {
        "Draft"      => "Draft",
        "InReview"   => "In Review",
        "Approved"   => "Approved",
        "Released"   => "Released",
        "Superseded" => "Superseded",
        _            => raw ?? "(unknown)",
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "—";
        const long kb = 1024;
        const long mb = kb * 1024;
        if (bytes >= mb) return $"{bytes / (double)mb:0.##} MB";
        if (bytes >= kb) return $"{bytes / (double)kb:0.#} KB";
        return $"{bytes} B";
    }
}
