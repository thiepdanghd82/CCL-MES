@*
  CCL iX — bộ icon đơn sắc (D6.1).

  Vì sao bỏ emoji: emoji là ẢNH MÀU do hệ điều hành vẽ. Chúng đổi hình theo
  macOS/Windows/phiên bản, mang bảng màu riêng không theo token của app, không
  chỉnh được độ dày nét, và không đổi màu theo ngữ cảnh (nền tối / trạng thái
  lỗi). Trong một sản phẩm công nghiệp, icon phải là NÉT vẽ nhận currentColor —
  đó là lý do Siemens iX dùng bộ line-icon đơn sắc.

  Quy ước: khung 24×24 · nét 1.5 · không tô đặc · thừa hưởng currentColor và cỡ
  chữ nơi đặt nó. Muốn đổi màu thì đổi màu chữ của phần tử cha, không đụng icon.
*@
<svg class="ix-icon @Class" viewBox="0 0 24 24" width="1em" height="1em"
     fill="none" stroke="currentColor" stroke-width="1.5"
     stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(string.IsNullOrEmpty(Title) ? "true" : "false")"
     role="@(string.IsNullOrEmpty(Title) ? "presentation" : "img")"
     focusable="false">
    @if (!string.IsNullOrEmpty(Title))
    {
        <title>@Title</title>
    }
    @((MarkupString)Path(Name))
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    /// <summary>Đặt khi icon MANG NGHĨA (không có nhãn chữ đi kèm). Bỏ trống ⇒ icon là trang trí, ẩn khỏi screen reader.</summary>
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }

    private static string Path(string n) => n switch
    {
        "clipboard" => @"<rect x='7' y='4' width='10' height='3' rx='1'/><path d='M9 4H6a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-3'/><path d='M8 11h8M8 15h5'/>",
