@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@inject IAuthSession Session
@using CCL.MES.Hybrid.Client.Specs
@using CCL.MES.Shared.QcSpecs

@*
    P10.5f — QC Capture tab (write). Per stage / per criterion:
      · Latest-result pill (color-coded PASS/FAIL/N-A) + actor + time
      · History expander (chronological list of prior captures)
      · "Ghi nhận" button → opens QcCaptureModal

    Capture write goes through Api.CreateQcCaptureAsync from the modal;
    parent reload via OnReloadRequested fires after success so the
    latest pill re-renders from the canonical server state (Q4).
*@

@if (Windows is null || Windows.Count == 0)
{
    <p class="grid-status">@T("specqccap.empty")</p>
}
else
{
    var canEdit = QcCaptureGateVm.IsEditor(Session.CurrentUserInfo?.Role);
    var latest = QcCaptureGateVm.LatestPerCriterion(Captures ?? Array.Empty<QcCaptureItem>());
    var allCapturesByCriterion = (Captures ?? Array.Empty<QcCaptureItem>())
        .GroupBy(c => c.QcCriterionId)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.CapturedAt).ToList());

    @if (!canEdit)
    {
        <div class="modal-banner modal-banner-warning" role="note">
            @T("specqccap.readonly.banner")
        </div>
    }

    @foreach (var stage in Stages)
    {
        var key = stage.ToString();
        var window = Windows.TryGetValue(key, out var w) ? w : null;
        if (window is null || window.Criteria.Count == 0)
        {
            continue;
        }

        <div class="qc-cap-stage-card">
            <div class="qc-stage-card-head">
                <strong>@StageLabel(stage)</strong>
                <span class="qc-stage-count">@T("specqccap.criteria.count", window.Criteria.Count)</span>
            </div>

            <table class="qc-capture-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@T("specqccap.col.criterion")</th>
                        <th>@T("specqccap.col.latest")</th>
                        <th>@T("specqccap.col.measurement")</th>
                        <th>@T("specqccap.col.reason")</th>
                        <th>@T("specqccap.col.recordedby")</th>
                        <th>@T("specqccap.col.time")</th>
                        @if (canEdit) { <th class="qc-col-narrow">@T("specqccap.col.record")</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var crit in window.Criteria.OrderBy(c => c.Seq))
                    {
                        latest.TryGetValue(crit.Id, out var last);
                        var hasHistory = allCapturesByCriterion.TryGetValue(crit.Id, out var historyList)
                                         && historyList.Count > 1;
                        <tr>
                            <td class="qc-col-narrow">@(crit.Seq + 1)</td>
                            <td>
                                <strong>@crit.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(crit.PassCriteria))
                                {
                                    <div class="qc-criterion-hint">@T("specqccap.target"): @crit.PassCriteria</div>
                                }
                            </td>
                            <td>
                                @if (last is null)
                                {
                                    <span class="qc-capture-pill qc-capture-pending">@T("specqccap.none")</span>
                                }
                                else
                                {
                                    <span class="qc-capture-pill qc-capture-@last.Result.ToString().ToLowerInvariant()">@ResultLabel(last.Result)</span>
                                }
                            </td>
                            <td>@(last?.Measurement ?? "—")</td>
                            <td>@(last?.NgReasonCode ?? "—")</td>
                            <td>@(last?.CapturedBy ?? "—")</td>
                            <td>@(last?.CapturedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            @if (canEdit)
                            {
                                <td>
                                    <button type="button" class="grid-btn grid-btn-primary qc-cap-btn"
                                            @onclick="() => OpenCaptureModal(crit, stage)">
                                        @T("specqccap.btn.record")
                                    </button>
                                </td>
                            }
                        </tr>
                        @if (hasHistory)
                        {
                            <tr class="qc-history-row">
                                <td colspan="@(canEdit ? 8 : 7)">
                                    <details class="qc-history-details">
                                        <summary>@T("specqccap.history.summary", historyList.Count)</summary>
                                        <table class="qc-history-table">
                                            <thead>
                                                <tr>
                                                    <th>@T("specqccap.col.time")</th><th>@T("specqccap.hist.result")</th>
                                                    <th>@T("specqccap.col.measurement")</th><th>@T("specqccap.col.reason")</th>
                                                    <th>@T("specqccap.hist.by")</th><th>@T("specqccap.hist.comment")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var h in historyList)
                                                {
                                                    <tr>
                                                        <td>@h.CapturedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                                        <td><span class="qc-capture-pill qc-capture-@h.Result.ToString().ToLowerInvariant()">@ResultLabel(h.Result)</span></td>
                                                        <td>@(h.Measurement ?? "—")</td>
                                                        <td>@(h.NgReasonCode ?? "—")</td>
                                                        <td>@(h.CapturedBy ?? "—")</td>
                                                        <td>@(h.Comment ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </details>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

<QcCaptureModal Open="_modalOpen"
                RevisionId="@RevisionId"
                Criterion="@_modalCriterion"
                StageLabel="@_modalStageLabel"
                ScrapReasons="@_scrapReasons"
                OnCaptured="OnCapturedAsync"
                OnClose="OnModalClosedAsync" />

@code {
    [Parameter] public long RevisionId { get; set; }
    [Parameter] public IReadOnlyDictionary<string, QcWindowItem?>? Windows { get; set; }
    [Parameter] public IReadOnlyList<QcCaptureItem>? Captures { get; set; }
    [Parameter] public IReadOnlyList<QcReasonCode>? ReasonCodes { get; set; }
    [Parameter] public EventCallback OnReloadRequested { get; set; }

    private static readonly QcStage[] Stages = new[]
    {
        QcStage.IpqcPrint, QcStage.IpqcCut, QcStage.Fqc, QcStage.Oqc,
    };

    private bool _modalOpen;
    private QcCriterionItem? _modalCriterion;
    private string _modalStageLabel = "";

    private IReadOnlyList<QcReasonCode> _scrapReasons = Array.Empty<QcReasonCode>();

    protected override void OnParametersSet()
    {
        _scrapReasons = ReasonCodes is null
            ? Array.Empty<QcReasonCode>()
            : QcCaptureGateVm.ScrapKindOnly(ReasonCodes);
    }

    private void OpenCaptureModal(QcCriterionItem crit, QcStage stage)
    {
        _modalCriterion = crit;
        _modalStageLabel = StageLabel(stage);
        _modalOpen = true;
        StateHasChanged();
    }

    private async Task OnCapturedAsync(QcCaptureItem _)
    {
        if (OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
    }

    private async Task OnModalClosedAsync()
    {
        _modalOpen = false;
        _modalCriterion = null;
        _modalStageLabel = "";
        await Task.CompletedTask;
        StateHasChanged();
    }

    private static string StageLabel(QcStage stage) => stage switch
    {
        QcStage.IpqcPrint => "IPQC · Print",
        QcStage.IpqcCut   => "IPQC · Cut",
        QcStage.Fqc       => "FQC · Final",
        QcStage.Oqc       => "OQC · Outgoing",
        _                 => stage.ToString(),
    };

    private static string ResultLabel(QcCaptureResult r) => r switch
    {
        QcCaptureResult.Pass => "PASS",
        QcCaptureResult.Fail => "FAIL",
        QcCaptureResult.Na   => "N/A",
        _                    => r.ToString(),
    };
}
