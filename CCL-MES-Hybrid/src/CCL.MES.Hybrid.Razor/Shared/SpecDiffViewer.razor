@*
    P10.5d — Renders the result of SpecDiffVm.Compare(current, parent)
    as a grouped diff list. Each section shows fields + row diffs with
    colour badges (Added / Removed / Changed).

    Reused by the Spec detail page's "So sánh với rev trước" toggle —
    operator clicks the button, viewer swaps in. Pure presentation; the
    comparison is computed up-front by the pure helper SpecDiffVm.
*@

@inherits CCL.MES.Hybrid.Razor.Localization.LocalizedComponentBase
@using CCL.MES.Hybrid.Client.Specs

@if (Result is null)
{
    <p class="spec-diff-empty">@T("specdiff.empty")</p>
}
else if (!Result.HasDiff)
{
    <div class="spec-diff-banner">
        <strong>@T("specdiff.nodiff.title")</strong> @T("specdiff.nodiff.between", Result.CurrentRev ?? "", Result.ParentRev ?? "")
    </div>
}
else
{
    <div class="spec-diff-viewer">
        <div class="spec-diff-banner">
            @T("specdiff.comparing.prefix") <strong>@Result.CurrentRev</strong>
            @T("specdiff.comparing.current.with") <strong>@Result.ParentRev</strong> @T("specdiff.comparing.previous") —
            <strong>@Result.Entries.Count</strong> @T("specdiff.comparing.changes").
        </div>

        @foreach (var group in Result.Entries.GroupBy(e => e.Section))
        {
            <div class="spec-diff-section">
                <div class="spec-diff-section-title">@SectionLabel(group.Key)</div>
                <table class="spec-diff-table">
                    <thead>
                        <tr>
                            <th>@T("specdiff.col.field")</th>
                            <th>@T("specdiff.col.before", Result.ParentRev ?? "")</th>
                            <th>@T("specdiff.col.after", Result.CurrentRev ?? "")</th>
                            <th>@T("specdiff.col.type")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in group)
                        {
                            <tr class="spec-diff-row spec-diff-row-@KindCssSlug(entry.Kind)">
                                <td class="spec-diff-field">@entry.FieldLabel</td>
                                <td class="spec-diff-old">@RenderValue(entry.OldValue, entry.Kind, before: true)</td>
                                <td class="spec-diff-new">@RenderValue(entry.NewValue, entry.Kind, before: false)</td>
                                <td>
                                    <span class="spec-diff-badge spec-diff-badge-@KindCssSlug(entry.Kind)">@KindLabel(entry.Kind)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter] public SpecDiffVm.SpecDiffResult? Result { get; set; }

    private string SectionLabel(SpecDiffVm.DiffSection section) => section switch
    {
        SpecDiffVm.DiffSection.Identity     => T("specdiff.section.identity"),
        SpecDiffVm.DiffSection.PrintParams  => T("specdiff.section.printparams"),
        SpecDiffVm.DiffSection.Material     => T("specdiff.section.material"),
        SpecDiffVm.DiffSection.Remarks      => T("specdiff.section.remarks"),
        SpecDiffVm.DiffSection.PrintColors  => T("specdiff.section.printcolors"),
        SpecDiffVm.DiffSection.FlexoPrint   => T("specdiff.section.flexoprint"),
        SpecDiffVm.DiffSection.FlexoCutting => T("specdiff.section.flexocutting"),
        SpecDiffVm.DiffSection.FlexoInk     => T("specdiff.section.flexoink"),
        _                                   => section.ToString(),
    };

    private string KindLabel(SpecDiffVm.ChangeType kind) => kind switch
    {
        SpecDiffVm.ChangeType.Added   => T("specdiff.kind.added"),
        SpecDiffVm.ChangeType.Removed => T("specdiff.kind.removed"),
        SpecDiffVm.ChangeType.Changed => T("specdiff.kind.changed"),
        _                             => kind.ToString(),
    };

    private static string KindCssSlug(SpecDiffVm.ChangeType kind) => kind switch
    {
        SpecDiffVm.ChangeType.Added   => "added",
        SpecDiffVm.ChangeType.Removed => "removed",
        SpecDiffVm.ChangeType.Changed => "changed",
        _                             => "unknown",
    };

    private static RenderFragment RenderValue(string? value, SpecDiffVm.ChangeType kind, bool before) => __builder =>
    {
        if (string.IsNullOrEmpty(value))
        {
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "class", "spec-diff-empty-cell");
            __builder.AddContent(2, "—");
            __builder.CloseElement();
            return;
        }
        var tag = (before && kind == SpecDiffVm.ChangeType.Removed) ? "del" : "span";
        __builder.OpenElement(0, tag);
        __builder.AddContent(1, value);
        __builder.CloseElement();
    };
}
