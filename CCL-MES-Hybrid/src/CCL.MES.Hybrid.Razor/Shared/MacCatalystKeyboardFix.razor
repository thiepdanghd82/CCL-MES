@*
  Tab + Enter focus-trap workaround for Mac Catalyst BlazorWebView.

  Background — dotnet/maui#13934 (open since 2023, Apple Feedback
  FB12076485 unresolved): the WKWebView under Mac Catalyst traps
  keyboard focus inside any <input> element. Tab does not move focus
  to the next focusable element, and Enter does not submit the
  containing form, even though the JS-level keydown event fires
  correctly. Native Mac apps, iOS, and Windows BlazorWebView are
  unaffected.

  The workaround listens at document keydown bubble-phase:
    - Tab  → preventDefault + .focus() on the next focusable element
             (sibling-source order, respecting tabindex / disabled /
             hidden via offsetWidth/Height zero check). Shift+Tab
             walks backwards.
    - Enter inside an <input> → preventDefault + .click() the form's
             submit button so Blazor's @onclick delegate fires.

  Platform detection is done in JS via two independent signals:
    1. The classic UA token combo (Mobile/ + Mac OS X) which the
       original P10.2 patch shipped against.
    2. A WKWebView surface probe (window.webkit.messageHandlers)
       which is present in every WKWebView-backed runtime (Mac
       Catalyst BlazorWebView, iOS) but ABSENT from regular macOS
       Safari and every non-Apple browser engine. macOS / Catalyst
       SDK bumps occasionally drop the "Mobile/" UA token on the
       WebView side, so the WKWebView probe is the resilient
       fallback — without it the fix evaporates on a Catalyst
       SDK rev and the symptom (#13934) reappears.

  A single console.log line fires at boot so the regression is
  observable from Safari Web Inspector (and from the cclLog bridge
  in DEBUG MAUI builds — see MainPage.xaml.cs) when the script is
  active. Removing the workaround once Apple ships a fix is a
  one-line edit (drop the component from the layouts).
*@
<script type="text/javascript">
    // P10.5g hotfix — production-safe JS-side error capture. Always-on
    // (NOT gated on Catalyst), idempotent. Forwards window.onerror +
    // unhandledrejection to console.error so the Web Inspector tail +
    // the Catalyst cclLog bridge (DEBUG) + any future JS log shipper
    // see the same line. Sentinel "[js-uncaught]" matches the regex
    // tests use to assert observability.
    (function () {
        if (window.__cclJsErrorLogger) return;
        window.__cclJsErrorLogger = true;
        window.addEventListener('error', function (ev) {
            try {
                console.error('[js-uncaught] ' +
                    (ev && ev.message ? ev.message : '(no message)') +
                    ' at ' + ((ev && ev.filename) || '?') + ':' +
                    ((ev && ev.lineno) || '?'));
            } catch (e) { /* console may be wrapped */ }
        });
        window.addEventListener('unhandledrejection', function (ev) {
            try {
                var reason = ev && ev.reason ? String(ev.reason) : '(no reason)';
                console.error('[js-unhandled-rejection] ' + reason);
            } catch (e) { /* swallow */ }
        });
    })();

    (function () {
        // Idempotency guard — both MainLayout + EmptyLayout inject
        // this component, and SPA navigation between them may run
        // the script twice. We attach the listener once per window.
        if (window.__cclMacCatalystKbdFix) return;

        var ua = navigator.userAgent || '';

        // Signal 1 — original UA combo. Mac Catalyst BlazorWebView
        // historically reports both tokens; regular Safari macOS lacks
        // "Mobile/" and iOS lacks "Mac OS X".
        var uaMatchesCatalyst = (ua.indexOf('Mobile/') !== -1 && ua.indexOf('Mac OS X') !== -1);

        // Signal 2 — WKWebView message-handler surface probe.
        // Present in every Catalyst/iOS BlazorWebView; absent from
        // regular macOS Safari + every non-Apple browser. Guards the
        // patch against UA-token regressions on future Catalyst
        // SDKs (the symptom mode this comment block warns about).
        var wkMatchesCatalyst = (
            typeof window.webkit === 'object' &&
            window.webkit !== null &&
            window.webkit.messageHandlers !== undefined &&
            (ua.indexOf('Mac OS X') !== -1 || ua.indexOf('Macintosh') !== -1)
        );

        var isCatalyst = uaMatchesCatalyst || wkMatchesCatalyst;

        // Boot log line — visible in Safari Web Inspector + cclLog
        // bridge. The "[keyboard-fix]" prefix is the same string the
        // regression-guard unit test greps for.
        try {
            console.log('[keyboard-fix] ua=' + (uaMatchesCatalyst ? '1' : '0') +
                        ' wk=' + (wkMatchesCatalyst ? '1' : '0') +
                        ' active=' + (isCatalyst ? '1' : '0'));
        } catch (e) { /* console may be wrapped */ }

        if (!isCatalyst) return;

        window.__cclMacCatalystKbdFix = {
            attached: true,
            ua: uaMatchesCatalyst,
            wk: wkMatchesCatalyst,
        };

        function focusables() {
            var sel = 'a:not([disabled]):not([tabindex="-1"]),' +
                      'button:not([disabled]):not([tabindex="-1"]),' +
                      'input:not([disabled]):not([tabindex="-1"]),' +
                      'select:not([disabled]):not([tabindex="-1"]),' +
                      'textarea:not([disabled]):not([tabindex="-1"]),' +
                      '[tabindex]:not([disabled]):not([tabindex="-1"])';
            return Array.prototype.filter.call(
                document.querySelectorAll(sel),
                function (el) {
                    return el.offsetWidth > 0 ||
                           el.offsetHeight > 0 ||
                           el === document.activeElement;
                });
        }

        document.addEventListener('keydown', function (ev) {
            if (ev.code === 'Tab') {
                var list = focusables();
                var idx = list.indexOf(document.activeElement);
                if (idx > -1) {
                    ev.preventDefault();
                    var nextIdx = idx + (ev.shiftKey ? -1 : 1);
                    var next = list[nextIdx] ||
                               list[ev.shiftKey ? list.length - 1 : 0];
                    if (next) next.focus();
                }
                return;
            }
            if (ev.code === 'Enter') {
                var ae = document.activeElement;
                if (ae && ae.tagName === 'INPUT' && ae.form) {
                    var submit = ae.form.querySelector('button[type="submit"]');
                    if (submit && !submit.disabled) {
                        ev.preventDefault();
                        submit.click();
                    }
                }
            }
        }, true);
    })();
</script>
