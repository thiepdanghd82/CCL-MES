{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "Jwt": {
    "Issuer": "ccl-mes-api",
    "Audience": "ccl-mes-hybrid",
    "SigningKey": "REPLACE-IN-PROD-Jwt__SigningKey-must-be-at-least-32-bytes-of-utf8-content",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "ClockSkew": "00:00:30"
  },
  "Ops": {
    "Backup": {
      "Enabled": false,
      "Hour": 2,
      "RetentionDays": 30,
      "MinKeep": 10,
      "Blobs": true
    }
  },
  "Urls": "http://localhost:5100"
}
