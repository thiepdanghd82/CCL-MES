<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 10 P10.2 — xUnit suite for the Client lib. Covers the
    AuthorizationDelegatingHandler 401-refresh flow + JwtClaims decoder
    + InMemoryTokenStore + AuthSession state transitions. Pure unit
    tests (no MAUI workload, no live server) so this runs identically
    on CI Win + Mac.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CCL.MES.Shared\CCL.MES.Shared.csproj" />
    <ProjectReference Include="..\..\src\CCL.MES.Hybrid.Client\CCL.MES.Hybrid.Client.csproj" />
  </ItemGroup>

</Project>
