bin/
obj/
# Phase 6 Bước 6.5 — SQLite data folder lives at repo-root level data/
# (mirror of Ops Control v1.2's server/data/). Live DB + snapshots are
# ignored; only .gitkeep marker files commit so the folder structure
# survives a fresh clone.
*.db
*.db-shm
*.db-wal
*.db.bak*
data/Backup/SQLite/*
!data/Backup/SQLite/.gitkeep
.vs/
.DS_Store
*.db.testcopy*

# Operational archive tarballs — manifest + sha256 in MANIFEST.md is the record
_archive/**/*.tar.gz

# Runtime uploads (drawings PDF) — not source code
data/blobs/
scripts/RecoverAdmin/recover.audit.log
scripts/RotateSeedPasswords/rotate-seed.audit.log

# JWT / secrets máy cục bộ — không bao giờ commit (kiểm định R2).
**/appsettings.Production.json
**/appsettings.*.local.json

# Bằng chứng migration Phase A/B (bài học L65: KHÔNG để ở /tmp — macOS quét
# sạch, và bằng chứng mất là không chứng minh được gì nữa). Giữ lại file .txt
# rowcount/sha; loại bản sao DB nhị phân — tên nó KHÔNG khớp `*.db` ở trên vì
# đuôi là timestamp, nên phải khai riêng.
CCL-MES-Hybrid/docs/*-migration-evidence/*.db.before-*
CCL-MES-Hybrid/docs/*-migration-evidence/*.db.after-*
