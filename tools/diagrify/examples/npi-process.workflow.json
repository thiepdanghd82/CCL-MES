      {"id": "exceptions", "label": "Rework loops", "focus": ["fai", "ncr", "sample", "feasibility"], "note": "Where a failed FAI sends the job back for a new sample or a design change."},
      {"id": "records", "label": "Records and specs", "focus": ["costing", "spec", "bom", "release"], "note": "The documents that must exist before release."}
    ]
  },
  "lanes": [
    {"id": "customer", "label": "Customer"},
    {"id": "sales", "label": "Sales"},
