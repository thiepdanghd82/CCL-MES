    {"dot": "rose", "title": "Exceptions", "items": ["FAI fail opens an NCR with root cause", "Re-run the sample, or return to feasibility for a design change"]},
    {"dot": "emerald", "title": "Release package", "items": ["Approved process spec and BOM", "Signed FAI report", "Routing released to production"]}
  ]
