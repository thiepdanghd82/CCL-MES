    {"id": "production", "label": "Production"}
  ],
  "phases": [
    {"id": "p-inquiry", "label": "Inquiry", "fromCol": 0, "toCol": 1},
    {"id": "p-develop", "label": "Development", "fromCol": 2, "toCol": 4, "variant": "emphasis"},
