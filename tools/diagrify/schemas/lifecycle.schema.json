{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagrify/lifecycle",
  "title": "Diagrify lifecycle / state diagram (grid placement, automatic routing)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "states", "transitions"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "lifecycle" },
    "meta": { "$ref": "#/$defs/meta" },
    "states": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "col"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["start", "active", "waiting", "success", "failure", "neutral"] },
          "label": { "$ref": "#/$defs/shortText" },
          "sublabel": { "$ref": "#/$defs/shortText" },
          "tag": { "type": "string", "minLength": 1, "maxLength": 24 },
          "col": { "type": "integer", "minimum": 0, "maximum": 12 },
          "row": { "type": "integer", "minimum": 0, "maximum": 4 }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/shortText" },
          "variant": { "$ref": "#/$defs/edgeVariant" },
          "route": { "enum": ["auto", "above", "below"] },
          "labelAt": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
          "labelDx": { "type": "number" },
          "labelDy": { "type": "number" }
        }
      }
    },
    "cards": { "$ref": "#/$defs/cards" }
  }
}
