{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagrify/architecture",
  "title": "Diagrify architecture diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "components", "connections"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "architecture" },
    "meta": { "$ref": "#/$defs/meta" },
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "pos"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "$ref": "#/$defs/nodeType" },
          "label": { "$ref": "#/$defs/shortText" },
          "sublabel": { "$ref": "#/$defs/shortText" },
          "tag": { "type": "string", "minLength": 1, "maxLength": 24 },
          "pos": { "$ref": "#/$defs/point" },
          "size": { "$ref": "#/$defs/point" },
          "variant": { "$ref": "#/$defs/nodeVariant" }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "wraps"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["region", "zone", "security-group", "site", "department"] },
          "label": { "$ref": "#/$defs/shortText" },
          "wraps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
          "padding": { "type": "number", "minimum": 8, "maximum": 80 }
        }
      }
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/shortText" },
          "variant": { "$ref": "#/$defs/edgeVariant" },
          "fromSide": { "$ref": "#/$defs/side" },
          "toSide": { "$ref": "#/$defs/side" },
          "via": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/point" } },
          "labelAt": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
          "labelDx": { "type": "number" },
          "labelDy": { "type": "number" }
        }
      }
    },
    "cards": { "$ref": "#/$defs/cards" }
  }
}
