{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagrify/workflow",
  "title": "Diagrify workflow diagram (swim lanes × columns, automatic layout)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "lanes", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "workflow" },
    "meta": { "$ref": "#/$defs/meta" },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/shortText" },
          "variant": { "enum": ["default", "emphasis", "exception"] }
        }
      }
    },
    "phases": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "fromCol", "toCol"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/shortText" },
          "fromCol": { "type": "integer", "minimum": 0 },
          "toCol": { "type": "integer", "minimum": 0 },
          "variant": { "$ref": "#/$defs/nodeVariant" }
        }
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "lane", "fromCol", "toCol"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/shortText" },
          "lane": { "$ref": "#/$defs/id" },
          "fromCol": { "type": "integer", "minimum": 0 },
          "toCol": { "type": "integer", "minimum": 0 },
          "variant": { "$ref": "#/$defs/nodeVariant" }
        }
      }
    },
    "mainPath": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" } },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lane", "col", "type", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "lane": { "$ref": "#/$defs/id" },
          "col": { "type": "integer", "minimum": 0, "maximum": 15 },
          "type": { "$ref": "#/$defs/nodeType" },
          "shape": { "enum": ["rect", "pill", "diamond"] },
          "label": { "$ref": "#/$defs/shortText" },
          "sublabel": { "$ref": "#/$defs/shortText" },
          "tag": { "type": "string", "minLength": 1, "maxLength": 24 },
          "variant": { "$ref": "#/$defs/nodeVariant" }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/shortText" },
          "variant": { "$ref": "#/$defs/edgeVariant" },
          "role": { "enum": ["main", "branch", "return", "error"] },
          "route": { "enum": ["auto", "above", "below"] },
          "labelAt": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
          "labelDx": { "type": "number" },
          "labelDy": { "type": "number" }
        }
      }
    },
    "cards": { "$ref": "#/$defs/cards" }
  }
}
