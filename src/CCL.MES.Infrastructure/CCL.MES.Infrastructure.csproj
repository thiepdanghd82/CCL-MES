<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <!-- Phase 8 PR #31a — xlsx parser dep (MIT). Exception to the "CSV-only"
         rule because SpecHub spec sheets use positional cell layouts that
         survive only in native xlsx (merged headers, multi-row sub-headers).
         Pin patch version để rebuild deterministic. Pure .NET, no native
         deps, cross-platform; pulls DocumentFormat.OpenXml + ExcelNumberFormat
         + SixLabors.Fonts transitively (~12 MB packages, ~4 MB gzipped). See
         docs/HOW-TO-UPGRADE-TO-SQLSERVER.md + LESSONS_LEARNED.md. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- Phase 8 PR #31c — server-side PDF gen dep (MIT). Cross-platform via
         the no-GDI variant `PDFsharp-MigraDoc` (vs `-GDI` Windows-only). Bundle
         brings in PdfSharp core + MigraDoc.DocumentObjectModel +
         MigraDoc.Rendering. Pin patch version để rebuild deterministic. Pure
         .NET (no native deps; runs on Linux/macOS/Windows server). Lý do chọn
         vs QuestPDF Community License: QuestPDF Community free chỉ ≤ $1M USD
         revenue — CCL Vietnam business revenue có thể vượt ngưỡng → MIT safer
         legally. PDF layer thiết kế reusable (SpecPdfDocumentBuilder) cho
         single-spec detail sheet PR #33 — KHÔNG hard-code riêng list export.
         See docs/HOW-TO-UPGRADE-TO-SQLSERVER.md + LESSONS_LEARNED.md. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CCL.MES.Domain\CCL.MES.Domain.csproj" />
    <ProjectReference Include="..\CCL.MES.Application\CCL.MES.Application.csproj" />
  </ItemGroup>
</Project>
