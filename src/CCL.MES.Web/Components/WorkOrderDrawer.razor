@*  Phase 8 WO-Consolidation — Per-WO drawer is now the SINGLE action
    surface for /workorders. Renders 6 sections from a pre-flattened DTO:
    Header / Production / Materials / QC History / History / Action.

    PR #32c added "History" section (read-only audit timeline of this WO:
    WO_ADVANCE + WO_FLAGS_UPDATE events DESC top-50). QC events stay in
    their dedicated section; OEE service does not emit audit so OEE
    transitions do not appear in History (acceptable per plan).

    The Action section MOVES the 9 buttons VERBATIM from Phase 6
    /workorders row markup (Advance / Unlock step / QC IPQC|FQC|OQC Pass /
    Start / Pause / Resume / Finish). Same AuthorizeView Context names,
    same NeedsQc / CurrentStep guards, same service calls
    (Wo.AdvanceAsync, Wo.UpdateFlagsAsync, Qc.CreateAsync + ApproveAsync,
    Oee.{Start,Pause,Resume,Finish}Async). Same Notifier reason strings
    ("advance" / "flags" / "qc" / "oee"). Same audit. Only thing that
    changed: where the buttons render. Server-side state-machine guard
    in WorkOrderStateMachine is untouched.

    Hotfix #27: try-catch wraps every mutation; error banner inline. *@

@using CCL.MES.Application
@using CCL.MES.Application.Services
@using CCL.MES.Domain
@using CCL.MES.Domain.Audit
@using CCL.MES.Domain.Entities
@using CCL.MES.Domain.StateMachine
@using CCL.MES.Web.Hubs
@using CCL.MES.Web.Services
@inject WorkOrderService Wo
@inject QcService Qc
@inject OeeService Oee
@inject ShopfloorNotifier Notifier
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

@if (Open && View is not null)
{
    <div class="wo-drawer-scrim" @onclick="OnCloseAsync"></div>
    <aside class="wo-drawer" role="dialog" aria-modal="true">
        <header class="wo-drawer-head">
            <div class="wo-drawer-title">
                <h2>@View.WoNo</h2>
                <p class="wo-drawer-subtitle">@OrDash(View.CustomerName) · @OrDash(View.ProductCode)</p>
                <span class="shop-pill @View.BadgeCssClass" title="@Loc[View.BadgeLabelKey]">
                    <span class="shop-pill-icon">@View.BadgeIcon</span>
                    @Loc[View.BadgeLabelKey]
                </span>
            </div>
            <button type="button" class="wo-drawer-close"
                    @onclick="OnCloseAsync"
                    aria-label="Close">×</button>
        </header>

        <div class="wo-drawer-body">

            @* ── Section 1: Header (Customer / Product / Spec) ─────────── *@
            <section class="wo-drawer-section">
                <h3>@Loc["shop_order.drawer.section.header"]</h3>
                <dl>
                    <div class="wo-drawer-row">
                        <dt>@Loc["shop_order.field.customer"]</dt>
                        <dd>@OrDash(View.CustomerName)</dd>
                    </div>
                    <div class="wo-drawer-row">
                        <dt>@Loc["shop_order.field.product"]</dt>
                        <dd>@OrDash(View.ProductCode)@(string.IsNullOrWhiteSpace(View.ProductName) ? "" : $" · {View.ProductName}")</dd>
                    </div>
                    <div class="wo-drawer-row">
                        <dt>@Loc["shop_order.drawer.field.spec_rev"]</dt>
                        <dd>
                            @if (string.IsNullOrWhiteSpace(View.SpecCode) && string.IsNullOrWhiteSpace(View.RevisionCode))
                            {
                                <span class="muted">—</span>
                            }
                            else
                            {
                                @($"{OrDash(View.SpecCode)} · Rev {OrDash(View.RevisionCode)}")
                            }
                        </dd>
                    </div>
                </dl>
            </section>

            @* ── Section 2: Production ────────────────────────────────── *@
            <section class="wo-drawer-section">
                <h3>@Loc["shop_order.drawer.section.production"]</h3>
                <dl>
                    <div class="wo-drawer-row">
                        <dt>@Loc["shop_order.field.machine"]</dt>
                        <dd>
                            @if (string.IsNullOrWhiteSpace(View.MachineCode) && string.IsNullOrWhiteSpace(View.MachineName))
                            {
                                <span class="muted">—</span>
                            }
                            else
                            {
                                @(View.MachineCode + (string.IsNullOrWhiteSpace(View.MachineName) ? "" : $" · {View.MachineName}"))
                            }
                        </dd>
                    </div>
                    <div class="wo-drawer-row">
                        <dt>@Loc["shop_order.field.process"]</dt>
                        <dd>@OrDash(View.ProcessLabel)</dd>
                    </div>
                    <div class="wo-drawer-row">
                        <dt>@Loc["shop_order.drawer.field.target"]</dt>
                        <dd>@FormatQty(View.TargetQty, View.Uom)</dd>
                    </div>
                    <div class="wo-drawer-row">
                        <dt>@Loc["shop_order.drawer.field.produced"]</dt>
                        <dd>@FormatQty(View.ProducedQty, View.Uom)</dd>
                    </div>
                    <div class="wo-drawer-row">
                        <dt>@Loc["shop_order.drawer.field.planned_start"]</dt>
                        <dd>@FormatDate(View.PlannedStart)</dd>
                    </div>
                    <div class="wo-drawer-row">
                        <dt>@Loc["shop_order.drawer.field.planned_end"]</dt>
                        <dd>@FormatDate(View.PlannedEnd)</dd>
                    </div>
                </dl>
            </section>

            @* ── Section 3: Materials (BOM read-only) ─────────────────── *@
            <section class="wo-drawer-section">
                <h3>@Loc["shop_order.drawer.section.materials"] <span class="wo-drawer-count">(@View.Materials.Count)</span></h3>
                @if (View.Materials.Count == 0)
                {
                    <p class="wo-drawer-empty">@Loc["shop_order.drawer.materials.empty"]</p>
                }
                else
                {
                    <ul class="wo-drawer-list">
                        @foreach (var m in View.Materials)
                        {
                            <li>
                                <span class="wo-drawer-list-key">@m.PartNo</span>
                                @if (!string.IsNullOrWhiteSpace(m.Description))
                                {
                                    <span class="wo-drawer-list-sub">@m.Description</span>
                                }
                                <span class="wo-drawer-list-meta">@FormatQty((int)Math.Round(m.QtyAssembly), m.Uom ?? "")</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* ── Section 4: QC History (5 latest, read-only) ──────────── *@
            <section class="wo-drawer-section">
                <h3>@Loc["shop_order.drawer.section.qc"] <span class="wo-drawer-count">(@View.QcInspections.Count)</span></h3>
                @if (View.QcInspections.Count == 0)
                {
                    <p class="wo-drawer-empty">@Loc["shop_order.drawer.qc.empty"]</p>
                }
                else
                {
                    <ul class="wo-drawer-list wo-drawer-qc-list">
                        @foreach (var q in View.QcInspections)
                        {
                            <li>
                                <span class="wo-drawer-qc-type">@q.Type</span>
                                <span class="wo-drawer-qc-result wo-drawer-qc-@QcResultClass(q.Result)">@q.Result</span>
                                @if (q.ApprovedAt is not null)
                                {
                                    <span class="wo-drawer-list-meta">@FormatDate(q.ApprovedAt)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(q.InspectorId))
                                {
                                    <span class="wo-drawer-list-sub">@Loc["shop_order.drawer.qc.inspector"]: @q.InspectorId</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            @* ── Section 5: History (audit timeline per-WO, top 50, read-only).
                 PR #32c. Reads AuditLog WHERE TargetType="WorkOrder" AND
                 TargetId=woId. Pretty-renders WO_ADVANCE (Step from→to) and
                 WO_FLAGS_UPDATE (per-flag ✓ summary); unknown action codes
                 fall back to a truncated JSON one-liner. ──────────────── *@
            <section class="wo-drawer-section">
                <h3>@Loc["workorders.drawer.section.history"] <span class="wo-drawer-count">(@View.History.Count)</span></h3>
                @if (View.History.Count == 0)
                {
                    <p class="wo-drawer-empty">@Loc["workorders.drawer.history.empty"]</p>
                }
                else
                {
                    <ul class="wo-drawer-list wo-drawer-history-list">
                        @foreach (var h in View.History)
                        {
                            <li>
                                <div class="wo-drawer-history-row">
                                    <span class="wo-drawer-history-when">@FormatHistoryWhen(h.Timestamp)</span>
                                    <span class="wo-drawer-history-who">@h.ActorUsername</span>
                                    <span class="wo-drawer-history-action @HistoryActionClass(h.Action)">@HistoryActionLabel(h.Action)</span>
                                </div>
                                <div class="wo-drawer-history-detail">@RenderHistoryDetail(h.Action, h.Detail)</div>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* ── Section 6: Action (state-machine button grid, RBAC gated).
                 9 buttons MOVED VERBATIM from Phase 6 WorkOrders.razor row
                 (see PHASE8-WO-CONSOLIDATION-PLAN §4). Same AuthorizeView
                 Context names (advanceCtx / qcCtx / runCtx) + same NeedsQc
                 helper + same CurrentStep == Running guard + same service
                 calls. Q3 default: always render, disabled handled by
                 AuthorizeView (hides for insufficient role) plus the
                 server-side state-machine guard (returns localized error
                 banner on guard miss). *@
            <section class="wo-drawer-section wo-drawer-actions">
                <h3>@Loc["workorders.drawer.section.actions"]</h3>
                @if (_actionMessage is not null)
                {
                    <div class="alert @(_actionOk ? "ok" : "err")">@_actionMessage</div>
                }
                <div class="wo-drawer-action-grid">
                    <AuthorizeView Roles="Admin,Supervisor" Context="advanceCtx">
                        <button type="button" class="btn"
                                disabled="@_busy"
                                @onclick="AdvanceAsync">@Loc["workorders.btn.advance"]</button>
                        <button type="button" class="btn ghost"
                                disabled="@_busy"
                                @onclick="UnlockStepAsync">@Loc["workorders.btn.unlock_step"]</button>
                    </AuthorizeView>
                    @if (NeedsQc(View.CurrentStep) is { } qct)
                    {
                        <AuthorizeView Roles="Admin,Supervisor,QC" Context="qcCtx">
                            <button type="button" class="btn pass"
                                    disabled="@_busy"
                                    @onclick="@(() => QuickPassAsync(qct))">QC @qct Pass</button>
                        </AuthorizeView>
                    }
                    @if (View.CurrentStep == ProcessStepCode.Running)
                    {
                        <AuthorizeView Roles="Admin,Supervisor,Operator" Context="runCtx">
                            <span class="sep"></span>
                            <button type="button" class="btn run"
                                    disabled="@_busy"
                                    @onclick="StartAsync">Start</button>
                            <button type="button" class="btn warn"
                                    disabled="@_busy"
                                    @onclick="PauseAsync">Pause</button>
                            <button type="button" class="btn run"
                                    disabled="@_busy"
                                    @onclick="ResumeAsync">Resume</button>
                            <button type="button" class="btn finish"
                                    disabled="@_busy"
                                    @onclick="FinishAsync">Finish (+@View.TargetQty)</button>
                        </AuthorizeView>
                    }
                </div>
            </section>
        </div>

        @* Q7 — drawer footer is just Close (drawer IS the WO surface). *@
        <footer class="wo-drawer-foot">
            <button type="button" class="rt-btn wo-drawer-cta"
                    @onclick="OnCloseAsync">@Loc["workorders.drawer.action.close"]</button>
        </footer>
    </aside>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public WorkOrderDrawerView? View { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>
    /// Phase 8 WO-Consolidation — fired after every mutation so the parent
    /// page can refresh the card list + re-fetch the drawer DTO. Parent
    /// also subscribes to SignalR for cross-session push; this callback
    /// handles the local-session response within the same Blazor circuit.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _busy;
    private bool _actionOk;
    private string? _actionMessage;

    private Task OnCloseAsync() => OnClose.InvokeAsync();

    // ── Action handlers — copied VERBATIM from Phase 6 WorkOrders.razor.
    // Only difference: no Reload() call here (parent OnChanged owns the
    // refresh). Service calls + Notifier.NotifyChangedAsync(reason) +
    // error code i18n mapping all unchanged.

    private async Task AdvanceAsync()
    {
        if (View is null) return;
        await RunAsync(async () =>
        {
            var res = await Wo.AdvanceAsync(View.Id, "shopfloor");
            _actionOk = res.Ok;
            var errorText = res.ErrorCode is null
                ? ""
                : Loc[WoErrorKeys.KeyFor(res.ErrorCode.Value)].Value;
            _actionMessage = res.Ok
                ? Loc["workorders.msg.advance_ok", res.CurrentStep ?? ""].Value
                : Loc["workorders.msg.advance_fail", errorText].Value;
            await Notifier.NotifyChangedAsync("advance");
        });
    }

    private async Task UnlockStepAsync()
    {
        if (View is null) return;
        await RunAsync(async () =>
        {
            await Wo.UpdateFlagsAsync(View.Id, new UpdateFlagsRequest
            {
                MaterialsReady = true,
                SetupConfirmed = true,
                RohsOk = true,
                ProducedQty = View.ProducedQty > 0 ? View.ProducedQty : 0,
            }, "shopfloor");
            _actionOk = true;
            _actionMessage = Loc["workorders.msg.unlocked", View.WoNo].Value;
            await Notifier.NotifyChangedAsync("flags");
        });
    }

    private async Task QuickPassAsync(QcType t)
    {
        if (View is null) return;
        await RunAsync(async () =>
        {
            var insp = await Qc.CreateAsync(new CreateQcRequest
            {
                WorkOrderId = View.Id,
                Type = t,
                InspectorId = "demo",
                SampleSize = 20,
                Details = new() { new QcDetailDto { ItemName = "Visual", Pass = true, Qty = 20 } },
            });
            await Qc.ApproveAsync(insp.Id, true, "qc.lead");
            _actionOk = true;
            _actionMessage = Loc["workorders.msg.qc_passed", t.ToString()].Value;
            await Notifier.NotifyChangedAsync("qc");
        });
    }

    private async Task StartAsync()
    {
        if (View is null) return;
        await RunAsync(async () =>
        {
            await Oee.StartAsync(View.Id, "op01");
            _actionOk = true;
            _actionMessage = Loc["workorders.msg.start"].Value;
            await Notifier.NotifyChangedAsync("oee");
        });
    }

    private async Task PauseAsync()
    {
        if (View is null) return;
        await RunAsync(async () =>
        {
            await Oee.PauseAsync(View.Id, new PauseRequest { OperatorId = "op01" });
            _actionOk = true;
            _actionMessage = Loc["workorders.msg.pause"].Value;
            await Notifier.NotifyChangedAsync("oee");
        });
    }

    private async Task ResumeAsync()
    {
        if (View is null) return;
        await RunAsync(async () =>
        {
            await Oee.ResumeAsync(View.Id, "op01");
            _actionOk = true;
            _actionMessage = Loc["workorders.msg.resume"].Value;
            await Notifier.NotifyChangedAsync("oee");
        });
    }

    private async Task FinishAsync()
    {
        if (View is null) return;
        await RunAsync(async () =>
        {
            await Oee.FinishAsync(View.Id,
                new FinishRunRequest { GoodQty = View.TargetQty, RejectQty = 0, OperatorId = "op01" });
            _actionOk = true;
            _actionMessage = Loc["workorders.msg.finish", View.TargetQty].Value;
            await Notifier.NotifyChangedAsync("oee");
        });
    }

    /// <summary>Single try/catch + busy-flag wrapper around mutations.
    /// Surfaces unexpected errors via the action banner (hotfix #27).</summary>
    private async Task RunAsync(Func<Task> body)
    {
        if (_busy) return;
        _busy = true;
        _actionMessage = null;
        try
        {
            await body();
        }
        catch (Exception ex)
        {
            _actionOk = false;
            _actionMessage = ex.GetType().Name + ": " + ex.Message;
        }
        finally
        {
            _busy = false;
            await OnChanged.InvokeAsync();
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────

    private static QcType? NeedsQc(ProcessStepCode step) => step switch
    {
        ProcessStepCode.IpqcApproval => QcType.IPQC,
        ProcessStepCode.Fqc          => QcType.FQC,
        ProcessStepCode.Oqc          => QcType.OQC,
        _                            => null,
    };

    private static string OrDash(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private string FormatQty(int qty, string uom)
    {
        var formatted = qty.ToString("N0", System.Globalization.CultureInfo.CurrentCulture);
        return string.IsNullOrWhiteSpace(uom) ? formatted : $"{formatted} {uom}";
    }

    private string FormatDate(DateTime? d)
        => d is null ? "—" : d.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string QcResultClass(QcResult r) => r switch
    {
        QcResult.Pass    => "pass",
        QcResult.Fail    => "fail",
        _                => "pending",
    };

    // ── History pretty-rendering (PR #32c) ──────────────────────────────

    private string FormatHistoryWhen(DateTime utc)
        => utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private string HistoryActionLabel(string action) => action switch
    {
        AuditAction.WoAdvance      => Loc["workorders.drawer.history.action.advance"].Value,
        AuditAction.WoFlagsUpdate  => Loc["workorders.drawer.history.action.flags_update"].Value,
        _                          => action,
    };

    private static string HistoryActionClass(string action) => action switch
    {
        AuditAction.WoAdvance     => "advance",
        AuditAction.WoFlagsUpdate => "flags",
        _                         => "other",
    };

    /// <summary>
    /// Pretty-render audit detail JSON per Q4. WO_ADVANCE → "Step from → to".
    /// WO_FLAGS_UPDATE → "Materials ✓ · Setup ✓ · RoHS ✓ · Produced 1200".
    /// Unknown action codes truncate to 200 chars + show raw JSON one-liner.
    /// Defensive: any JSON parse failure falls through to the truncation path
    /// so a malformed historic row never crashes the drawer.
    /// </summary>
    private string RenderHistoryDetail(string action, string? detail)
    {
        if (string.IsNullOrWhiteSpace(detail)) return "—";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(detail);
            var root = doc.RootElement;
            if (action == AuditAction.WoAdvance)
            {
                var from = root.TryGetProperty("from", out var f) ? f.GetString() : null;
                var to   = root.TryGetProperty("to",   out var t) ? t.GetString() : null;
                if (!string.IsNullOrEmpty(from) && !string.IsNullOrEmpty(to))
                    return $"{StepShort(from)} → {StepShort(to)}";
            }
            else if (action == AuditAction.WoFlagsUpdate)
            {
                var parts = new List<string>();
                if (root.TryGetProperty("materials_ready", out var mr) && mr.ValueKind != System.Text.Json.JsonValueKind.Null)
                    parts.Add(FlagPart(Loc["workorders.drawer.history.flag.materials"].Value, mr));
                if (root.TryGetProperty("setup_confirmed", out var sc) && sc.ValueKind != System.Text.Json.JsonValueKind.Null)
                    parts.Add(FlagPart(Loc["workorders.drawer.history.flag.setup"].Value, sc));
                if (root.TryGetProperty("rohs_ok", out var ro) && ro.ValueKind != System.Text.Json.JsonValueKind.Null)
                    parts.Add(FlagPart(Loc["workorders.drawer.history.flag.rohs"].Value, ro));
                if (root.TryGetProperty("produced_qty", out var pq) && pq.ValueKind == System.Text.Json.JsonValueKind.Number)
                    parts.Add($"{Loc["workorders.drawer.history.flag.produced"].Value} {pq.GetInt32()}");
                return parts.Count == 0 ? "—" : string.Join(" · ", parts);
            }
        }
        catch
        {
            /* Fall through to truncation below. */
        }
        return detail.Length > 200 ? detail.Substring(0, 200) + "…" : detail;
    }

    private static string FlagPart(string label, System.Text.Json.JsonElement el)
    {
        if (el.ValueKind == System.Text.Json.JsonValueKind.True)  return $"{label} ✓";
        if (el.ValueKind == System.Text.Json.JsonValueKind.False) return $"{label} ✗";
        return label;
    }

    /// <summary>Short label for WO_ADVANCE from/to enum strings.</summary>
    private static string StepShort(string raw) => raw switch
    {
        "PrePressCheck" => "Pre-Press",
        "OpSetting"     => "Setting",
        "IpqcApproval"  => "IPQC",
        "ReadyToRun"    => "Ready",
        "Running"       => "Running",
        "Fqc"           => "FQC",
        "Oqc"           => "OQC",
        _               => raw,
    };
}
