@* Phase 8 PR #31a — Create Spec modal v2 (planner picker + xlsx import +
   preview + Save).

   Port pattern UX SpecHub `openCreateOneCModal` (HTML:11865-11882) +
   `handleOneCFileSelected` (HTML:11884-11903) + `showOneCPreview`
   (HTML:11905-11952).

   Public surface giữ giống Phase 7 CreateSpecModal cho EngineerSpec caller:
     - @ref + OpenAsync() + OnCreated callback
   Internal flow:
     1. Operator chọn planner (5 categories — SILK mặc định)
     2. Upload xlsx → InputFile streams → SpecImportService.PreviewAsync
     3. Preview hiển thị summary + warnings + dup detection
     4. Click Save → SpecImportService.SaveAsync (transaction Q13)
     5. Success → OnCreated → close modal → grid refresh

   Bài học hotfix PR #27: KHÔNG re-fetch by id; bind trực tiếp PreviewDto
   trả về từ service.
   Bài học PR #28-#30 try-catch wrap mọi async handler — error gắn vào
   _errorMessage state, KHÔNG freeze circuit. *@

@using System.Globalization
@using System.Text.Json
@using CCL.MES.Application.SpecDetail
@using CCL.MES.Application.SpecImport
@using CCL.MES.Domain
@using Microsoft.AspNetCore.Components.Forms
@inject SpecImportService SpecImport
@inject IStringLocalizer<SharedResource> Loc
@inject AuthenticationStateProvider AuthState

@if (_open)
{
    <div class="modal-scrim" @onclick="CancelClick">
        <div class="modal-card spec-create-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="modal-head">
                <h2>@Loc["npi.spec.create_v2.title"]</h2>
                <button type="button" class="modal-close" @onclick="CancelClick" aria-label="Close">×</button>
            </div>

            <div class="modal-body">
                <!-- Step 1 — Planner picker -->
                <section class="spec-create-step">
                    <h3>@Loc["npi.spec.create_v2.step1"]</h3>
                    <div class="planner-grid">
                        @foreach (var p in _planners)
                        {
                            var key = p.Key;
                            var isSelected = _selectedPlanner == key;
                            <button type="button"
                                    class="planner-opt @(isSelected ? "selected" : "") spec-planner-@key"
                                    @onclick="@(() => SelectPlanner(key))"
                                    disabled="@_busy">
                                @Loc[p.LabelKey]
                            </button>
                        }
                    </div>
                    <small class="spec-hint">@Loc["npi.spec.create_v2.step1_hint"]</small>
                </section>

                <!-- Step 2 — Upload xlsx -->
                <section class="spec-create-step">
                    <h3>@Loc["npi.spec.create_v2.step2"]</h3>
                    <label class="spec-file-drop @(_preview is not null ? "has-file" : "")">
                        <InputFile OnChange="OnFileChangedAsync" accept=".xlsx" disabled="@_busy" />
                        <span class="spec-file-drop-label">
                            @if (_preview is null && string.IsNullOrEmpty(_fileName))
                            {
                                @Loc["npi.spec.create_v2.upload_label"]
                            }
                            else if (_busy)
                            {
                                <strong>@Loc["npi.spec.create_v2.parsing"]</strong>
                            }
                            else if (_preview is not null && _preview.ParseOk)
                            {
                                <strong>@_fileName</strong>
                                <br />
                                <small class="muted">✓ Parsed — @(_preview.Parsed?.PrintRows.Count ?? 0) print rows</small>
                            }
                            else
                            {
                                <strong>@_fileName</strong>
                                <br />
                                <small class="err">@Loc["npi.spec.create_v2.parse_error"]: @_preview?.ParseError</small>
                            }
                        </span>
                    </label>
                </section>

                <!-- Preview (after parse OK) -->
                @if (_preview is not null && _preview.ParseOk && _preview.Parsed is not null)
                {
                    var parsed = _preview.Parsed;
                    <section class="spec-create-step spec-preview-section">
                        <h3>@Loc["npi.spec.create_v2.preview_header"]</h3>

                        @if (_preview.DuplicateRefNo)
                        {
                            <div class="alert err" role="alert">
                                ⚠ @Loc["npi.spec.create_v2.dup_banner"]
                                <br />
                                <small class="muted">RefNo: <code>@parsed.RefNo</code> · existing spec: <code>@_preview.DuplicateSpecCode</code> (id=@_preview.DuplicateRevisionId)</small>
                            </div>
                        }

                        @* PR-C — Live showcard preview replaces the legacy <dl> text summary.
                           Mode=Preview renders the navy showcard directly from the parsed DTO
                           (no DB / no Id / no SpecDetailAsync call) so operator sees the same
                           layout that will land in the grid + full-page detail after Save. *@
                        <SpecShowcard Detail="@BuildPreviewDto(parsed)" Mode="SpecShowcardMode.Preview" />

                        @if (_preview.Warnings.Count > 0)
                        {
                            <details class="spec-warnings" open="@(_preview.Warnings.Count <= 3)">
                                <summary>@Loc["npi.spec.create_v2.warnings_header"] (@_preview.Warnings.Count)</summary>
                                <ul>
                                    @foreach (var w in _preview.Warnings)
                                    {
                                        <li>@w</li>
                                    }
                                </ul>
                            </details>
                        }
                    </section>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert err" role="alert">
                        @_errorMessage
                    </div>
                }

                <div class="modal-foot">
                    <button type="button" class="btn" @onclick="CancelClick" disabled="@_busy">
                        @Loc["npi.spec.create_v2.btn_cancel"]
                    </button>
                    <button type="button" class="btn"
                            @onclick="OnManualEntryAsync" disabled="@_busy"
                            title="@Loc["npi.spec.create_v2.btn_manual"]">
                        @Loc["npi.spec.create_v2.btn_manual"]
                    </button>
                    <button type="button" class="btn btn-primary"
                            @onclick="OnSaveAsync" disabled="@(_busy || !CanSave)">
                        @if (_busy) { @Loc["npi.spec.create_v2.saving"] }
                        else        { @Loc["npi.spec.create_v2.btn_save"] }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnCreated { get; set; }

    private bool _open;
    private bool _busy;
    private string _selectedPlanner = "silkscreen";
    private string _fileName = "";
    private string? _errorMessage;
    private SpecImportPreviewDto? _preview;

    private sealed record PlannerOpt(string Key, string LabelKey);

    private static readonly PlannerOpt[] _planners = new[]
    {
        new PlannerOpt("silkscreen",  "npi.spec.create_v2.planner.silkscreen"),
        new PlannerOpt("flexo",       "npi.spec.create_v2.planner.flexo"),
        new PlannerOpt("letterpress", "npi.spec.create_v2.planner.letterpress"),
        new PlannerOpt("indigo",      "npi.spec.create_v2.planner.indigo"),
        new PlannerOpt("diecut",      "npi.spec.create_v2.planner.diecut"),
    };

    public Task OpenAsync()
    {
        _open = true;
        _busy = false;
        _selectedPlanner = "silkscreen";
        _fileName = "";
        _errorMessage = null;
        _preview = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void CancelClick()
    {
        if (_busy) return;
        _open = false;
        _preview = null;
        _fileName = "";
        _errorMessage = null;
    }

    private void SelectPlanner(string planner)
    {
        if (_busy) return;
        _selectedPlanner = planner;
        // Re-parse hint: keep current preview if any; user may want to re-upload
        // sau khi đổi planner. Để đơn giản clear preview để khỏi mismatch.
        if (_preview is not null)
        {
            _preview = null;
            _fileName = "";
        }
    }

    private bool CanSave => _preview is not null
                            && _preview.ParseOk
                            && !_preview.DuplicateRefNo
                            && _preview.Parsed is not null
                            && !string.IsNullOrWhiteSpace(_preview.Parsed.Customer)
                            && !string.IsNullOrWhiteSpace(_preview.Parsed.PartNo);

    private async Task OnFileChangedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _busy = true;
        _errorMessage = null;
        _preview = null;
        _fileName = file.Name;
        StateHasChanged();

        try
        {
            if (file.Size > SpecImportService.MaxFileSizeBytes)
            {
                _errorMessage = Loc["npi.spec.create_v2.file_too_large"].Value;
                _preview = new SpecImportPreviewDto
                {
                    FileName = file.Name,
                    FileSizeBytes = file.Size,
                    PlannerCategory = _selectedPlanner,
                    ParseOk = false,
                    ParseError = _errorMessage,
                };
                return;
            }

            // Copy stream to MemoryStream — Blazor InputFile stream cap default
            // 500KB; pass through OpenReadStream với maxAllowedSize.
            await using var src = file.OpenReadStream(SpecImportService.MaxFileSizeBytes);
            using var ms = new MemoryStream();
            await src.CopyToAsync(ms);
            ms.Position = 0;

            _preview = await SpecImport.PreviewAsync(ms, file.Name, file.Size, _selectedPlanner);
            if (!_preview.ParseOk)
            {
                _errorMessage = _preview.ParseError;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"{Loc["npi.spec.create_v2.parse_error"].Value}: {ex.Message}";
            _preview = new SpecImportPreviewDto
            {
                FileName = file.Name,
                FileSizeBytes = file.Size,
                PlannerCategory = _selectedPlanner,
                ParseOk = false,
                ParseError = ex.Message,
            };
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task OnSaveAsync()
    {
        if (_busy || !CanSave || _preview?.Parsed is null) return;
        _busy = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User?.Identity?.Name;
            await SpecImport.SaveAsync(_preview.Parsed, source: "create_modal", fileName: _fileName, user: user);
            _open = false;
            _preview = null;
            _fileName = "";
            if (OnCreated.HasDelegate) await OnCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"{Loc["npi.spec.create_v2.save_err"].Value}: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// PR #31a Q5 — Manual entry placeholder. Reuse Phase 7 form đơn giản đã
    /// có không khả thi (form đó vẫn yêu cầu Parameters non-empty + Product
    /// dropdown selection — ràng buộc cho create-from-scratch không phù hợp
    /// với planner picker flow). Em chọn "minimal Draft + Edit later" pattern:
    /// đóng modal + show advisory để operator dùng SpecHub-style Edit flow
    /// (defer PR #32+).
    /// </summary>
    private void OnManualEntryAsync()
    {
        if (_busy) return;
        // PR #31a: just close — Manual entry full form đẩy PR sau (cần Edit modal trước).
        _errorMessage = "Manual entry form sẽ ship cùng Edit modal (PR sau). PR #31a chỉ hỗ trợ xlsx import.";
        StateHasChanged();
    }

    /// <summary>
    /// PR-C — Build an in-memory <see cref="SpecDetailDto"/> from the parsed xlsx
    /// payload. NO DB call, NO SpecDetailAsync, NO Id (preview happens BEFORE
    /// the spec is persisted) — just structural mapping so <SpecShowcard
    /// Mode="Preview" /> can render the same navy showcard layout it uses for
    /// saved specs (Full + Compact in PR-B).
    ///
    /// Category → Planner mapping mirrors SpecService.PlannerFromProcessCode
    /// reverse direction; LETTER / INDIGO / DIECUT route via the GENERIC
    /// template (warning chip + only sections with data) per PR-B Q5 honest
    /// fallback. Bài học hotfix PR #27: pure mapping, no async, no exception
    /// surface beyond the JSON serializer for MaterialExtraJson.
    /// </summary>
    private static SpecDetailDto BuildPreviewDto(ParsedSpecDto p)
    {
        var (planner, processCode, isSilkscreen, isFlexo) = MapCategory(p.Category);

        // Material extra JSON — same shape SpecImportService writes on Save so
        // the showcard's ParseMaterialExtra helper resolves Material Size /
        // Lamination Tape / Lamination Size / Lamination Cavity columns.
        string? materialExtraJson = null;
        if (!string.IsNullOrWhiteSpace(p.MaterialSize)
         || !string.IsNullOrWhiteSpace(p.LaminationTape)
         || !string.IsNullOrWhiteSpace(p.LaminationSize)
         || !string.IsNullOrWhiteSpace(p.LaminationCavity))
        {
            materialExtraJson = JsonSerializer.Serialize(new
            {
                material_size     = p.MaterialSize ?? "",
                lamination_tape   = p.LaminationTape ?? "",
                lamination_size   = p.LaminationSize ?? "",
                lamination_cavity = p.LaminationCavity ?? "",
            });
        }

        return new SpecDetailDto
        {
            Id           = 0,                          // unsaved — Mode=Preview must never key off Id
            SpecCode     = string.IsNullOrWhiteSpace(p.PartNo) ? "(preview)" : p.PartNo,
            Title        = p.PartName ?? "",
            RevisionCode = "A",
            Status       = ProductRevisionStatus.Draft,
            RefNo        = p.RefNo,
            InspectionLevel = p.InspectionLevel,
            Planner      = planner,
            ProcessCode  = processCode,
            IsSilkscreen = isSilkscreen,
            IsFlexo      = isFlexo,
            ProductCode  = p.PartNo ?? "",
            ProductName  = p.PartName ?? "",
            CustomerName = p.Customer,
            SubstrateType = p.MaterialType,
            MaterialExtraJson = materialExtraJson,
            PrintingCavity   = p.PrintingCavity,
            LengthPitchMm    = p.LengthPitchMm,
            ProductSizeWmm   = p.ProductSizeW,
            ProductSizeHmm   = p.ProductSizeH,
            RemarksText      = p.RemarksLeft ?? p.Remarks,
            RemarksCutText   = p.RemarksRight,
            CreatedAt        = DateTime.Now,
            // PrintColors / FlexoPrintRows / FlexoCuttingRows / FlexoInkRows mapped below.
            PrintColors      = MapPrintColors(p.PrintRows),
            FlexoPrintRows   = MapFlexoPrintRows(p.FlexoPrintRows),
            FlexoCuttingRows = MapFlexoCuttingRows(p.FlexoCuttingRows),
            FlexoInkRows     = MapFlexoInkRows(p.FlexoInkRows),
            // Lineage + AuditEntries left empty — Mode=Preview never renders them.
        };
    }

    /// <summary>
    /// Reverse of SpecService.PlannerFromProcessCode for the 5 planner keys the
    /// modal picker emits. Tuple = (Planner, ProcessCode, IsSilkscreen, IsFlexo).
    /// Matches SpecService.SpecDetailAsync's IsSilkscreen logic (silkscreen +
    /// indigo + indigo_primer all flag silk for downstream readers).
    /// </summary>
    private static (string planner, string processCode, bool isSilkscreen, bool isFlexo) MapCategory(string category)
        => (category ?? "silkscreen").Trim().ToLowerInvariant() switch
        {
            "silkscreen"    => ("SILK",   "SILKSCREEN",    true,  false),
            "flexo"         => ("FLEXO",  "FLEXO",         false, true),
            "letterpress"   => ("LETTER", "LETTERPRESS",   false, false),
            "indigo"        => ("INDIGO", "INDIGO",        true,  false),
            "indigo_primer" => ("INDIGO", "INDIGO_PRIMER", true,  false),
            "diecut"        => ("DIECUT", "FLATBED_CUT",   false, false),
            _               => ("UNKNOWN", category ?? "", false, false),
        };

    private static List<SpecPrintColorRow> MapPrintColors(List<ParsedPrintColorDto> rows)
        => rows.Select(r => new SpecPrintColorRow(
            Seq:          r.Seq,
            Surface:      r.Surface,
            Color:        r.Color,
            InkName:      r.InkName,
            InkCode:      r.InkCode,
            Maker:        r.Maker,
            Retarder:     r.Retarder,
            Viscosity:    r.Viscosity,
            Speed:        r.Speed,
            Squeegee:     r.Squeegee,
            Dry:          r.Dry,
            TemperatureC: r.TemperatureC,
            TimeMin:      r.TimeMin,
            Uv:           r.Uv,
            EmulsionUm:   r.EmulsionUm,
            PlateSize:    r.PlateSize,
            Mesh:         r.Mesh,
            AngleDeg:     r.AngleDeg,
            PlateCode:    r.PlateCode,
            ControlNo:    r.ControlNo,
            Remark:       r.Remark)).ToList();

    private static List<FlexoPrintRow> MapFlexoPrintRows(List<ParsedFlexoPrintRowDto> rows)
        => rows.Select(r => new FlexoPrintRow(
            Seq:         r.Seq,
            Process:     r.Process,
            Material:    r.Material,
            Thickness:   r.Thickness,
            Size:        r.Size,
            Cylinders:   r.Cylinders,
            PitchMm:     r.PitchMm,
            Speed:       r.Speed,
            TensionHead: r.TensionHead,
            TensionEnd:  r.TensionEnd,
            TensionRoll: r.TensionRoll,
            PlateCavity: r.PlateCavity,
            Tension:     r.Tension)).ToList();

    private static List<FlexoCuttingRow> MapFlexoCuttingRows(List<ParsedFlexoCuttingRowDto> rows)
        => rows.Select(r => new FlexoCuttingRow(
            Seq:             r.Seq,
            Process:         r.Process,
            Lamination:      r.Lamination,
            Size:            r.Size,
            CutterLot:       r.CutterLot,
            CutterName:      r.CutterName,
            PcsPerSheet:     r.PcsPerSheet,
            CuttingCavity:   r.CuttingCavity,
            PitchMm:         r.PitchMm,
            Packing:         r.Packing,
            PaperSpeed:      r.PaperSpeed,
            CuttingSpeed:    r.CuttingSpeed,
            CuttingPressure: r.CuttingPressure,
            HeadTension:     r.HeadTension,
            RollTension:     r.RollTension)).ToList();

    private static List<FlexoInkRow> MapFlexoInkRows(List<ParsedFlexoInkRowDto> rows)
        => rows.Select(r => new FlexoInkRow(
            Seq:            r.Seq,
            Color:          r.Color,
            InkCode:        r.InkCode,
            InkDescription: r.InkDescription,
            Brand:          r.Brand,
            Anilox:         r.Anilox,
            PlateCode:      r.PlateCode,
            Pressure:       r.Pressure,
            UvPowerW:       r.UvPowerW,
            IrPowerW:       r.IrPowerW)).ToList();
}
