@*  Phase 8 PR-L2 — Spec lifecycle Mark Superseded modal.

    Per Q2 — semi-irreversible action: operator must type the spec's
    SpecCode exactly to confirm. Server re-validates (defence in depth) so
    a curl bypass can't skip the confirm step.

    Gate UI-side on Status ∈ {Approved, Released}. Server enforces same
    gate via 422 invalid_status. *@

@using CCL.MES.Application
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Loc

@if (_open && _row is not null)
{
    <div class="modal-scrim" @onclick="Close">
        <div class="modal-card spec-supersede-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="modal-head">
                <h2>@string.Format(Loc["npi.spec.supersede.title_fmt"].Value, _row.SpecCode, _row.RevisionCode)</h2>
                <button type="button" class="modal-close" @onclick="Close" aria-label="Close">×</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert err">@_errorMessage</div>
                }

                <div class="alert err spec-supersede-warn">
                    <strong>@Loc["npi.spec.supersede.warn.title"]</strong>
                    <p>@Loc["npi.spec.supersede.warn.body"]</p>
                </div>

                <p class="muted">@Loc["npi.spec.supersede.intro"]</p>

                <div class="form-row">
                    <label for="supersede-confirm">
                        @string.Format(Loc["npi.spec.supersede.field.confirm_fmt"].Value, _row.SpecCode)
                    </label>
                    <input id="supersede-confirm" type="text" value="@_confirmCode"
                           @oninput="@(e => _confirmCode = e.Value?.ToString() ?? "")"
                           autocomplete="off"
                           placeholder="@_row.SpecCode" />
                    <small class="muted">@Loc["npi.spec.supersede.field.confirm_hint"]</small>
                </div>
            </div>

            <div class="modal-foot">
                <button type="button" class="rt-btn" @onclick="Close" disabled="@_busy">
                    @Loc["common.cancel"]
                </button>
                <button type="button" class="rt-btn rt-btn-danger"
                        disabled="@(!CanSubmit())"
                        @onclick="SubmitAsync">
                    @(_busy ? Loc["npi.spec.supersede.btn.flipping"].Value : Loc["npi.spec.supersede.btn.confirm"].Value)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSuperseded { get; set; }

    private bool _open;
    private ProductRevisionListItem? _row;
    private string _confirmCode = "";
    private bool _busy;
    private string? _errorMessage;

    public void Open(ProductRevisionListItem row)
    {
        _row = row;
        _confirmCode = "";
        _errorMessage = null;
        _busy = false;
        _open = true;
        StateHasChanged();
    }

    public void Close()
    {
        _open = false;
        _row = null;
        StateHasChanged();
    }

    private bool CanSubmit() => !_busy
        && _row is not null
        // Client-side match check; server re-validates as defence in depth.
        && string.Equals(_confirmCode.Trim(), _row.SpecCode, StringComparison.Ordinal);

    private async Task SubmitAsync()
    {
        if (_row is null || _busy) return;
        _busy = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var payload = new { confirmSpecCode = _confirmCode.Trim() };
            var result = await JS.InvokeAsync<SupersedeMutationResult>(
                "cclmes.specs.supersede", _row.Id, payload);
            if (!result.Ok)
            {
                _errorMessage = result.Code switch
                {
                    "invalid_status"    => string.Format(
                        Loc["npi.spec.supersede.err.invalid_status_fmt"].Value,
                        result.CurrentStatus ?? "?"),
                    "trashed"           => Loc["npi.spec.supersede.err.trashed"].Value,
                    "confirm_mismatch"  => Loc["npi.spec.supersede.err.mismatch"].Value,
                    _                   => $"{result.Status}: {Truncate(result.Body, 240)}",
                };
            }
            else
            {
                Close();
                await OnSuperseded.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.GetType().Name + ": " + ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private static string Truncate(string? s, int n) =>
        string.IsNullOrEmpty(s) ? "" : (s.Length > n ? s.Substring(0, n) + "…" : s);

    public sealed class SupersedeMutationResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public long? Id { get; set; }
        public string? SpecCode { get; set; }
        public string? Status_after { get; set; }
        public string? Code { get; set; }
        public string? CurrentStatus { get; set; }
        public string? Body { get; set; }
    }
}
