@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> Loc

<div class="page">
    <header class="topbar">
        <div class="brand">@Loc["app.brand"] <span>@Loc["app.brand_short"]</span></div>
        <nav>
            <a href="/">@Loc["nav.home"]</a>
            <a href="/dashboard">@Loc["nav.dashboard"]</a>
            <a href="/workorders">@Loc["nav.workorders"]</a>
            <a href="/workinstructions">@Loc["nav.workinstructions"]</a>

            <div class="dropdown">
                <span class="dropbtn">@Loc["nav.npidata"] &#9662;</span>
                <div class="dropdown-menu">
                    <a href="/npi/engineer-routine">@Loc["nav.npi.routine"]</a>
                    <a href="/npi/engineer-structure">@Loc["nav.npi.structure"]</a>
                    <a href="/npi/engineer-spec">@Loc["nav.npi.spec"]</a>
                    <a href="/npi/raw-materials">@Loc["nav.npi.rawmaterials"]</a>
                    <a href="/npi/workcenter">@Loc["nav.npi.workcenter"]</a>
                </div>
            </div>

            <div class="dropdown">
                <span class="dropbtn">@Loc["nav.qcqadata"] &#9662;</span>
                <div class="dropdown-menu">
                    <a href="/qcqa/iqc">@Loc["nav.qcqa.iqc"]</a>
                    <a href="/qcqa/ipqc">@Loc["nav.qcqa.ipqc"]</a>
                    <a href="/qcqa/oqc">@Loc["nav.qcqa.oqc"]</a>
                </div>
            </div>

            @* Phase 3 — Settings dropdown. The 10 sub-tabs are a verbatim
               copy of the MENU_SECTIONS catalogue in Ops Control v1.2
               (3 groups × 10 items), kept in the same order so operators
               coming from Ops Control v1.2 find each setting in the same
               position. Items flagged "admin only" in the source are
               currently visible to every signed-in user — RBAC enforcement
               is deferred to Phase 4+ (see TODO notes inside each page). *@
            <div class="dropdown">
                <span class="dropbtn">@Loc["nav.settings"] &#9662;</span>
                <div class="dropdown-menu">
                    <a href="/settings/profile">@Loc["nav.settings.profile"]</a>
                    <a href="/settings/mypwd">@Loc["nav.settings.mypwd"]</a>
                    <a href="/settings/appearance">@Loc["nav.settings.appearance"]</a>
                    <a href="/settings/hardware">@Loc["nav.settings.hardware"]</a>
                    <a href="/settings/mode">@Loc["nav.settings.mode"]</a>
                    <a href="/settings/account">@Loc["nav.settings.account"]</a>
                    <a href="/settings/about">@Loc["nav.settings.about"]</a>
                    <a href="/settings/data">@Loc["nav.settings.data"]</a>
                    <a href="/settings/syslog">@Loc["nav.settings.syslog"]</a>
                    <a href="/settings/import-legacy">@Loc["nav.settings.importlegacy"]</a>
                </div>
            </div>

            <a href="/swagger" target="_blank">@Loc["nav.api_swagger"]</a>
        </nav>

        <div class="topbar-right">
            <LangFlagPicker CssClass="topbar-lang" />
            <AuthorizeView>
                <Authorized>
                    <span class="topbar-user" title="@context.User.Identity?.Name">
                        @(context.User.FindFirst("display_name")?.Value ?? context.User.Identity?.Name)
                    </span>
                    @* GET-based logout link — keeps the link styled inline with
                       the nav. The Logout Razor Page only mutates auth state on
                       POST; the GET path just bounces to /login, so a stray
                       link click does not leave the session in a bad state. *@
                    <form method="post" action="/logout" class="topbar-logout-form">
                        <button type="submit" class="topbar-logout-btn">@Loc["nav.logout"]</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <main>
        @Body
    </main>
</div>
