@*  Phase 8 PR-B — Modal peek refactor to delegate layout to <SpecShowcard Mode="Compact" />.

    PR-A history: dropped legacy `_params` / `TryParseParams` (binding bug fix —
    JSON shape mismatch SpecParameter vs SpecPrintColor) → switched modal to
    SpecDetailDto via SpecService.SpecDetailAsync (single source of truth).

    PR-B: extract the section layout (Compliance + Product Info mini + first N
    rows + audit subset) into <SpecShowcard /> so EngineerSpecDetail (Full),
    SpecDetailModal (Compact), CreateSpecModal preview (Preview, PR-C) share
    one renderer. Modal here keeps responsibility for: dialog frame, Identity
    table (row data fetched cheap before detail loads), loading/error banner,
    and "Open full spec sheet →" CTA.

    Compact mode rendering side-effects bằng PR-A: same DOM structure for
    silk + flexo samples → CSS từ PR-A apply 1:1.
*@

@using System.Globalization
@using CCL.MES.Application
@using CCL.MES.Application.Services
@using CCL.MES.Application.SpecDetail
@using CCL.MES.Domain
@inject SpecService Specs
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

@if (_open && _row is not null)
{
    <div class="modal-scrim" @onclick="Close">
        <div class="modal-card spec-detail-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="modal-head">
                <h2>@string.Format(Loc["npi.spec.detail.title"].Value, _row.SpecCode, _row.RevisionCode)</h2>
                <button type="button" class="modal-close" @onclick="Close" aria-label="Close">×</button>
            </div>

            <div class="modal-body">
                @{ var row = _row; }

                @* ── Identity (instant render từ DTO row, KHÔNG đợi SpecDetailAsync) ── *@
                <section class="spec-detail-section">
                    <h3>📋 @Loc["npi.spec.detail.section.identity"]</h3>
                    <table class="spec-detail-table">
                        <tr><th>@Loc["npi.spec.detail.field.spec_code"]</th>
                            <td><b>@row.SpecCode</b></td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.title"]</th>
                            <td>@row.Title</td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.product"]</th>
                            <td>@row.ProductCode — @row.ProductName</td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.revision_code"]</th>
                            <td><b>Rev @row.RevisionCode</b></td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.status"]</th>
                            <td>@RenderStatusBadge(row.Status)</td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.effective_from"]</th>
                            <td>@(row.EffectiveFrom?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td></tr>
                    </table>
                </section>

                @* ── Spec showcard peek (delegated to SpecShowcard Mode=Compact) ── *@
                <section class="spec-detail-section">
                    <h3>📝 @Loc["npi.spec.detail.section.content"]</h3>
                    @if (_detailLoading)
                    {
                        <p class="muted">@Loc["npi.spec.detail.loading"]</p>
                    }
                    else if (_detailError is not null)
                    {
                        <div class="alert err">@_detailError</div>
                    }
                    else if (_detail is null)
                    {
                        <p class="muted">@Loc["npi.spec.detail.content.not_found"]</p>
                    }
                    else
                    {
                        <SpecShowcard Detail="_detail" Mode="SpecShowcardMode.Compact" />
                    }
                </section>
            </div>

            <div class="modal-foot">
                <button type="button" class="btn" @onclick="Close">@Loc["npi.spec.detail.btn_close"]</button>
                <button type="button" class="btn btn-primary" @onclick="OpenFullSheet">
                    @Loc["npi.spec.detail.btn_open_full"] →
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _open;
    private ProductRevisionListItem? _row;

    private bool _detailLoading;
    private string? _detailError;
    private SpecDetailDto? _detail;

    /// <summary>
    /// Modal nhận row entity TRỰC TIẾP từ grid (DTO). Identity render NGAY.
    /// Detail query phụ qua <see cref="SpecService.SpecDetailAsync"/> (PR
    /// #31d single source of truth) — try-catch inline để KHÔNG freeze
    /// circuit (bài học hotfix #27).
    /// </summary>
    public async Task OpenAsync(ProductRevisionListItem row)
    {
        _row = row;
        _open = true;

        _detailLoading = true;
        _detailError = null;
        _detail = null;

        StateHasChanged();

        try
        {
            _detail = await Specs.SpecDetailAsync(row.Id, auditMax: 5, lineageMax: 3);
        }
        catch (Exception ex)
        {
            _detailError = ex.GetType().Name + ": " + ex.Message;
        }
        finally
        {
            _detailLoading = false;
            StateHasChanged();
        }
    }

    public void Close()
    {
        _open = false;
        _row = null;
        _detail = null;
        _detailError = null;
        StateHasChanged();
    }

    private void OpenFullSheet()
    {
        if (_row is null) return;
        var id = _row.Id;
        Close();
        Nav.NavigateTo($"/npi/engineer-spec/{id}");
    }

    private RenderFragment RenderStatusBadge(ProductRevisionStatus st) => __builder =>
    {
        var (cls, labelKey) = st switch
        {
            ProductRevisionStatus.Draft       => ("rm-status rm-status--draft",      "npi.spec.status.draft"),
            ProductRevisionStatus.InReview    => ("rm-status rm-status--review",     "npi.spec.status.in_review"),
            ProductRevisionStatus.Approved    => ("rm-status rm-status--approved",   "npi.spec.status.approved"),
            ProductRevisionStatus.Released    => ("rm-status rm-status--released",   "npi.spec.status.released"),
            ProductRevisionStatus.Superseded  => ("rm-status rm-status--obsolete",   "npi.spec.status.superseded"),
            _                                 => ("rm-status",                       "npi.spec.status.draft"),
        };
        __builder.OpenElement(1, "span");
        __builder.AddAttribute(2, "class", cls);
        __builder.AddContent(3, Loc[labelKey].Value);
        __builder.CloseElement();
    };
}
