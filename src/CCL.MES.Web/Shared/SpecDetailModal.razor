@*  Phase 8 PR-A (showcard parity) — Compact peek modal cho ProductRevision.

    Bug fix: PR #29 modal `TryParseParams` đọc JSON keys
    `param_name/nominal/tol_min/tol_max/uom/is_critical` (legacy SpecParameter
    shape Phase 6) nhưng PR #31a `SerializeColorsForLegacy` ghi shape silk
    print row `color/ink_name/ink_code/...`. Mismatch → 10 ParamRow null →
    10 cell "—". 100% bug binding (KHÔNG bug schema).

    Fix: drop _params + TryParseParams + ParamRow hoàn toàn. Modal load
    `SpecService.SpecDetailAsync` (PR #31d) — single source of truth chung
    với full-page route `/npi/engineer-spec/{id}` + PDF spec sheet exporter.

    UX Q2 C2: compact peek subset của showcard (KHÔNG full showcard trong
    modal — modal cho quick check; full layout ở route `/npi/engineer-spec/{id}`).
    Sections render:
      1. Identity (instant từ row + StatusDisplay 5→3)
      2. Compliance strip (3 chip derive)
      3. Product Info mini-table (silk 8-col / flexo 6-col)
      4. Silk first 5 PrintColors OR Flexo first 3 each subsection
      5. Audit stamps + first 5 timeline entries
      6. Button "Open full spec sheet →" navigate `/npi/engineer-spec/{id}`

    Bài học hotfix #27: render trực tiếp từ entity grid + try-catch wrap
    query phụ + error banner inline (KHÔNG freeze Blazor circuit).
*@

@using System.Globalization
@using CCL.MES.Application
@using CCL.MES.Application.Services
@using CCL.MES.Application.SpecDetail
@using CCL.MES.Domain
@inject SpecService Specs
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

@if (_open && _row is not null)
{
    <div class="modal-scrim" @onclick="Close">
        <div class="modal-card spec-detail-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="modal-head">
                <h2>@string.Format(Loc["npi.spec.detail.title"].Value, _row.SpecCode, _row.RevisionCode)</h2>
                <button type="button" class="modal-close" @onclick="Close" aria-label="Close">×</button>
            </div>

            <div class="modal-body">
                @{ var row = _row; }

                @* ── 1. Identity (instant render từ DTO row) ─────────────── *@
                <section class="spec-detail-section">
                    <h3>📋 @Loc["npi.spec.detail.section.identity"]</h3>
                    <table class="spec-detail-table">
                        <tr><th>@Loc["npi.spec.detail.field.spec_code"]</th>
                            <td><b>@row.SpecCode</b></td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.title"]</th>
                            <td>@row.Title</td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.product"]</th>
                            <td>@row.ProductCode — @row.ProductName</td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.revision_code"]</th>
                            <td><b>Rev @row.RevisionCode</b></td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.status"]</th>
                            <td>@RenderStatusBadge(row.Status)</td></tr>
                        <tr><th>@Loc["npi.spec.detail.field.effective_from"]</th>
                            <td>@(row.EffectiveFrom?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td></tr>
                    </table>
                </section>

                @* ── 2-4. Spec showcard peek (SpecDetailDto single source) ── *@
                <section class="spec-detail-section">
                    <h3>📝 @Loc["npi.spec.detail.section.content"]</h3>
                    @if (_detailLoading)
                    {
                        <p class="muted">@Loc["npi.spec.detail.loading"]</p>
                    }
                    else if (_detailError is not null)
                    {
                        <div class="alert err">@_detailError</div>
                    }
                    else if (_detail is null)
                    {
                        <p class="muted">@Loc["npi.spec.detail.content.not_found"]</p>
                    }
                    else
                    {
                        var d = _detail;

                        @* Compliance strip mini (3 chip derive) *@
                        <div class="spec-cert-row spec-cert-row-compact">
                            <span>Compliance:</span>
                            @foreach (var chip in d.ComplianceChips)
                            {
                                <span class="cert-chip">@chip</span>
                            }
                        </div>

                        @* Product Info mini (5 row dl/dt for peek) *@
                        <table class="spec-detail-table">
                            <tr><th>@Loc["npi.spec.detail.field.process_code"]</th>
                                <td>@(d.ProcessCode ?? "—")
                                    <span class="spec-planner-tag spec-planner-@(d.Planner.ToLowerInvariant())">@d.Planner</span>
                                </td></tr>
                            <tr><th>@Loc["npi.spec.detail.peek.size"]</th>
                                <td>@d.ProductSizeDisplay</td></tr>
                            <tr><th>@Loc["npi.spec.detail.peek.cavity_pitch"]</th>
                                <td>
                                    Cavity: <b>@(d.PrintingCavity?.ToString(CultureInfo.InvariantCulture) ?? "—")</b>
                                    · Pitch: <b>@(d.LengthPitchMm?.ToString("N1", CultureInfo.InvariantCulture) ?? "—") mm</b>
                                </td></tr>
                            <tr><th>@Loc["npi.spec.detail.peek.substrate"]</th>
                                <td>@(d.SubstrateType ?? "—")</td></tr>
                            @if (d.IsSilkscreen)
                            {
                                <tr><th>@Loc["npi.spec.detail.peek.colors"]</th>
                                    <td><b>@d.PrintColors.Count</b> colors</td></tr>
                            }
                            else if (d.IsFlexo)
                            {
                                <tr><th>@Loc["npi.spec.detail.peek.flexo_rows"]</th>
                                    <td>
                                        Print: <b>@d.FlexoPrintRows.Count</b>
                                        · Cut: <b>@d.FlexoCuttingRows.Count</b>
                                        · Ink: <b>@d.FlexoInkRows.Count</b>
                                    </td></tr>
                            }
                        </table>

                        @* Mini print rows table (silk first 5 / flexo first 3 cut + 3 ink) *@
                        @if (d.IsSilkscreen && d.PrintColors.Count > 0)
                        {
                            <h4 class="spec-detail-subhead">
                                @Loc["npi.spec.detail.peek.silk_colors"]
                                @if (d.PrintColors.Count > 5)
                                {
                                    <span class="muted">(first 5 of @d.PrintColors.Count — open full sheet for all)</span>
                                }
                            </h4>
                            <table class="spec-detail-table spec-peek-color-table">
                                <thead>
                                    <tr>
                                        <th>No</th>
                                        <th>Surf</th>
                                        <th>Color</th>
                                        <th>Ink Code</th>
                                        <th>Maker</th>
                                        <th>Mesh</th>
                                        <th>Plate Code</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in d.PrintColors.Take(5))
                                    {
                                        var hex = SpecDetailColors.SwatchHex(c.Color);
                                        var isTransparent = SpecDetailColors.IsTransparent(c.Color);
                                        <tr>
                                            <td class="col-no">@c.Seq</td>
                                            <td>@(c.Surface ?? "—")</td>
                                            <td class="col-color">
                                                @if (hex is not null)
                                                {
                                                    <span class="pantone-swatch @(isTransparent ? "swatch-transparent" : "")" style="@(isTransparent ? "" : $"background:{hex};")"></span>
                                                }
                                                @(c.Color ?? "—")
                                            </td>
                                            <td class="col-code">@(c.InkCode ?? "—")</td>
                                            <td>@(c.Maker ?? "—")</td>
                                            <td>@(c.Mesh ?? "—")</td>
                                            <td class="col-code">@(c.PlateCode ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else if (d.IsFlexo)
                        {
                            @if (d.FlexoCuttingRows.Count > 0)
                            {
                                <h4 class="spec-detail-subhead">
                                    @Loc["npi.spec.detail.peek.flexo_cut"]
                                    @if (d.FlexoCuttingRows.Count > 3)
                                    {
                                        <span class="muted">(first 3 of @d.FlexoCuttingRows.Count)</span>
                                    }
                                </h4>
                                <table class="spec-detail-table">
                                    <thead>
                                        <tr><th>No</th><th>Process</th><th>Cutter Name</th><th>Cavity</th><th>Pitch (mm)</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in d.FlexoCuttingRows.Take(3))
                                        {
                                            <tr>
                                                <td class="col-no">@c.Seq</td>
                                                <td>@(c.Process ?? "—")</td>
                                                <td class="col-code">@(c.CutterName ?? "—")</td>
                                                <td>@(c.CuttingCavity?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                                                <td>@(c.PitchMm?.ToString("N1", CultureInfo.InvariantCulture) ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (d.FlexoInkRows.Count > 0)
                            {
                                <h4 class="spec-detail-subhead">
                                    @Loc["npi.spec.detail.peek.flexo_ink"]
                                    @if (d.FlexoInkRows.Count > 3)
                                    {
                                        <span class="muted">(first 3 of @d.FlexoInkRows.Count)</span>
                                    }
                                </h4>
                                <table class="spec-detail-table">
                                    <thead>
                                        <tr><th>No</th><th>Color</th><th>Ink Code</th><th>Brand</th><th>Anilox</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var i in d.FlexoInkRows.Take(3))
                                        {
                                            <tr>
                                                <td class="col-no">@i.Seq</td>
                                                <td class="col-color">@(i.Color ?? "—")</td>
                                                <td class="col-code">@(i.InkCode ?? "—")</td>
                                                <td>@(i.Brand ?? "—")</td>
                                                <td>@(i.Anilox ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                        else
                        {
                            <p class="muted">@Loc["npi.spec.detail.peek.no_print_rows"]</p>
                        }

                        @* Audit stamps mini *@
                        <h4 class="spec-detail-subhead">@Loc["npi.spec.detail.peek.audit_stamps"]</h4>
                        <table class="spec-detail-table">
                            <tr><th>@Loc["npi.spec.detail.field.created"]</th>
                                <td>@d.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                    <span class="muted">@(d.CreatedBy is null ? "" : "· " + d.CreatedBy)</span></td></tr>
                            <tr><th>@Loc["npi.spec.detail.field.updated"]</th>
                                <td>@(d.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                    <span class="muted">@(d.UpdatedBy is null ? "" : "· " + d.UpdatedBy)</span></td></tr>
                            <tr><th>@Loc["npi.spec.detail.field.approved"]</th>
                                <td>@(d.ApprovedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                    <span class="muted">@(d.ApprovedBy is null ? "" : "· " + d.ApprovedBy)</span></td></tr>
                        </table>

                        @* Audit timeline (first 5 entries) *@
                        @if (d.AuditEntries.Count > 0)
                        {
                            <h4 class="spec-detail-subhead">
                                @Loc["npi.spec.detail.audit.timeline"]
                                @if (d.AuditEntries.Count > 5)
                                {
                                    <span class="muted">(first 5 of @d.AuditEntries.Count)</span>
                                }
                            </h4>
                            <ul class="spec-detail-audit-list">
                                @foreach (var a in d.AuditEntries.Take(5))
                                {
                                    <li>
                                        <span class="spec-detail-audit-time">@a.Timestamp.ToString("yyyy-MM-dd HH:mm")</span>
                                        <span class="spec-detail-audit-action">@a.Action</span>
                                        <span class="muted">· @a.ActorUsername</span>
                                        @if (!string.IsNullOrWhiteSpace(a.ActorRole))
                                        {
                                            <span class="muted">(@a.ActorRole)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    }
                </section>
            </div>

            <div class="modal-foot">
                <button type="button" class="btn" @onclick="Close">@Loc["npi.spec.detail.btn_close"]</button>
                <button type="button" class="btn btn-primary" @onclick="OpenFullSheet">
                    @Loc["npi.spec.detail.btn_open_full"] →
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _open;
    private ProductRevisionListItem? _row;

    private bool _detailLoading;
    private string? _detailError;
    private SpecDetailDto? _detail;

    /// <summary>
    /// Modal nhận row entity TRỰC TIẾP từ grid (DTO). Identity render NGAY.
    /// Detail query phụ qua <see cref="SpecService.SpecDetailAsync"/> (PR
    /// #31d single source of truth) — try-catch inline để KHÔNG freeze
    /// circuit (bài học hotfix #27).
    /// </summary>
    public async Task OpenAsync(ProductRevisionListItem row)
    {
        _row = row;
        _open = true;

        _detailLoading = true;
        _detailError = null;
        _detail = null;

        StateHasChanged();

        try
        {
            _detail = await Specs.SpecDetailAsync(row.Id, auditMax: 5, lineageMax: 3);
        }
        catch (Exception ex)
        {
            _detailError = ex.GetType().Name + ": " + ex.Message;
        }
        finally
        {
            _detailLoading = false;
            StateHasChanged();
        }
    }

    public void Close()
    {
        _open = false;
        _row = null;
        _detail = null;
        _detailError = null;
        StateHasChanged();
    }

    private void OpenFullSheet()
    {
        if (_row is null) return;
        var id = _row.Id;
        Close();
        Nav.NavigateTo($"/npi/engineer-spec/{id}");
    }

    private RenderFragment RenderStatusBadge(ProductRevisionStatus st) => __builder =>
    {
        var (cls, labelKey) = st switch
        {
            ProductRevisionStatus.Draft       => ("rm-status rm-status--draft",      "npi.spec.status.draft"),
            ProductRevisionStatus.InReview    => ("rm-status rm-status--review",     "npi.spec.status.in_review"),
            ProductRevisionStatus.Approved    => ("rm-status rm-status--approved",   "npi.spec.status.approved"),
            ProductRevisionStatus.Released    => ("rm-status rm-status--released",   "npi.spec.status.released"),
            ProductRevisionStatus.Superseded  => ("rm-status rm-status--obsolete",   "npi.spec.status.superseded"),
            _                                 => ("rm-status",                       "npi.spec.status.draft"),
        };
        __builder.OpenElement(1, "span");
        __builder.AddAttribute(2, "class", cls);
        __builder.AddContent(3, Loc[labelKey].Value);
        __builder.CloseElement();
    };
}
