{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=ccl_mes.db"
  },
  "Ops": {
    "Backup": {
      "Enabled": false,
      "Hour": 2,
      "RetentionDays": 30,
      "MinKeep": 10,
      "Blobs": true,
      "WebhookUrl": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
