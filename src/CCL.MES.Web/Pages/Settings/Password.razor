@page "/settings/mypwd"
@using CCL.MES.Web.Services
@inject UserProfileService ProfileSvc
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

@*  Phase 6 Bước 2A — My Password.
    Self-service password change. PBKDF2 verify of old + hash new via
    PasswordHasher<User> (same scheme as Phase 2 login). After a
    successful change, the cookie is still valid for the rest of its
    sliding window — show a hint asking the user to sign out + back in
    on other devices. Login on next request still works because the
    cookie identifier (NameIdentifier claim) is unchanged. *@

<h1>@Loc["settings.mypwd.title"]</h1>

<div class="settings-card">
    <EditForm Model="@_form" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="field-row">
            <label for="pw-old">@Loc["settings.mypwd.field.old"]</label>
            <InputText id="pw-old" type="password" @bind-Value="_form.Old" class="form-input" autocomplete="current-password" />
        </div>

        <div class="field-row">
            <label for="pw-new">@Loc["settings.mypwd.field.new"]</label>
            <InputText id="pw-new" type="password" @bind-Value="_form.New" class="form-input" autocomplete="new-password" />
        </div>

        <div class="field-row">
            <label for="pw-confirm">@Loc["settings.mypwd.field.confirm"]</label>
            <InputText id="pw-confirm" type="password" @bind-Value="_form.Confirm" class="form-input" autocomplete="new-password" />
        </div>

        <p class="muted">@Loc["settings.mypwd.hint_minlength"]</p>

        <button type="submit" class="btn btn-primary">@Loc["settings.mypwd.btn.change"]</button>
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_ok ? "ok" : "err")">@_message</div>
        }
    </EditForm>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private PasswordForm _form = new();
    private string? _message;
    private bool _ok;

    private async Task Save()
    {
        _message = null;
        _ok = false;

        if (string.IsNullOrEmpty(_form.Old) || string.IsNullOrEmpty(_form.New) || string.IsNullOrEmpty(_form.Confirm))
        {
            _message = Loc["settings.mypwd.msg.missing"].Value;
            return;
        }
        if (_form.New != _form.Confirm)
        {
            _message = Loc["settings.mypwd.msg.mismatch"].Value;
            return;
        }
        if (AuthState is null)
        {
            _message = Loc["settings.mypwd.msg.user_not_found"].Value;
            return;
        }

        var auth = await AuthState;
        var result = await ProfileSvc.ChangePasswordAsync(auth.User, _form.Old, _form.New);
        switch (result)
        {
            case PasswordChangeResult.Success:
                _ok = true;
                _message = Loc["settings.mypwd.msg.success"].Value;
                _form = new PasswordForm();
                break;
            case PasswordChangeResult.WrongCurrent:
                _message = Loc["settings.mypwd.msg.wrong_current"].Value;
                break;
            case PasswordChangeResult.NewTooShort:
                _message = Loc["settings.mypwd.msg.too_short"].Value;
                break;
            case PasswordChangeResult.UserNotFound:
                _message = Loc["settings.mypwd.msg.user_not_found"].Value;
                break;
        }
    }

    private class PasswordForm
    {
        public string Old { get; set; } = "";
        public string New { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
