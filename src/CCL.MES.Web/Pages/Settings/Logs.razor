@page "/settings/syslog"
@attribute [Authorize(Policy = "AdminOnly")]
@inject IStringLocalizer<SharedResource> Loc

@*  Phase 5 — RBAC enforced. Non-admin users hitting this URL get the
    <AccessDenied /> panel from App.razor's NotAuthorized branch;
    the topbar Settings dropdown also hides this item via
    <AuthorizeView Roles="Admin"> in MainLayout.razor. *@

<h1>@Loc["settings.syslog.title"]</h1>

<div class="npi-placeholder">
    <p class="muted">@Loc["settings.syslog.placeholder_lead"]</p>
    <ul>
        <li>@Loc["settings.syslog.placeholder_li1"]</li>
        <li>@Loc["settings.syslog.placeholder_li2"]</li>
        <li>@Loc["settings.syslog.placeholder_li3"]</li>
    </ul>
</div>
