@page "/settings/about"
@using System.Reflection
@using System.Runtime.InteropServices
@using CCL.MES.Application
@using CCL.MES.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IMesDbContext Db
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@inject BackupService BackupSvc
@inject IStringLocalizer<SharedResource> Loc

@*  Phase 6 Bước 2B — About / Diagnostics.
    Read-only system info: app version, .NET runtime, DB provider, env,
    table row counts, latest backup. No admin gate — every signed-in user
    can view (per Phase 6 plan §3 — only the 4 admin-only sub-tabs gate). *@

<h1>@Loc["settings.about.title"]</h1>

<div class="settings-card">
    <h2 class="settings-section">@Loc["settings.about.section.app"]</h2>
    <table class="diag-table">
        <tbody>
            <tr><th>@Loc["settings.about.field.app_name"]</th><td>@_appName</td></tr>
            <tr><th>@Loc["settings.about.field.version"]</th><td>@_version</td></tr>
            <tr><th>@Loc["settings.about.field.runtime"]</th><td>@_runtime</td></tr>
            <tr><th>@Loc["settings.about.field.environment"]</th><td>@Env.EnvironmentName</td></tr>
        </tbody>
    </table>
</div>

<div class="settings-card">
    <h2 class="settings-section">@Loc["settings.about.section.db"]</h2>
    <table class="diag-table">
        <tbody>
            <tr><th>@Loc["settings.about.field.provider"]</th><td>@BackupSvc.Provider</td></tr>
            <tr><th>@Loc["settings.about.field.last_backup"]</th><td>@(_lastBackup ?? "-")</td></tr>
        </tbody>
    </table>
</div>

<div class="settings-card">
    <h2 class="settings-section">@Loc["settings.about.section.counts"]</h2>
    @if (_counts is null)
    {
        <p>@Loc["common.loading"]</p>
    }
    else
    {
        <table class="diag-table">
            <tbody>
                @foreach (var (label, value) in _counts)
                {
                    <tr><th>@label</th><td class="num">@value.ToString("N0")</td></tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private const string _appName = "CCL Design MES";
    private static readonly string _version = typeof(Program).Assembly.GetName().Version?.ToString() ?? "0.0.0";
    private static readonly string _runtime = RuntimeInformation.FrameworkDescription;
    private string? _lastBackup;
    private List<(string Label, long Value)>? _counts;

    protected override async Task OnInitializedAsync()
    {
        // Latest backup (file mtime newest) for quick at-a-glance.
        var snapshots = BackupSvc.ListSnapshots();
        _lastBackup = snapshots.FirstOrDefault()?.Name;

        // Row counts for the tables operators most often want at a glance.
        _counts = new()
        {
            (Loc["settings.about.count.users"].Value,                  await Db.Users.CountAsync()),
            (Loc["settings.about.count.work_orders"].Value,            await Db.WorkOrders.CountAsync()),
            (Loc["settings.about.count.work_centers"].Value,           await Db.WorkCenters.CountAsync()),
            (Loc["settings.about.count.raw_materials"].Value,          await Db.RawMaterials.CountAsync()),
            (Loc["settings.about.count.routing_operations"].Value,     await Db.RoutingOperations.CountAsync()),
            (Loc["settings.about.count.mfg_structures"].Value,         await Db.ManufacturingStructures.CountAsync()),
            // Phase 8 PR #28 — Specs DbSet REMOVED; ProductRevisions thay thế (preserve PK 1:1 từ migration).
            (Loc["settings.about.count.specs"].Value,                  await Db.ProductRevisions.CountAsync()),
        };
    }

}
