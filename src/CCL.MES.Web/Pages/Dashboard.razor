@page "/dashboard"
@using Microsoft.AspNetCore.SignalR.Client
@using CCL.MES.Web.Services
@inject OeeService Oee
@inject WorkOrderService Wo
@inject NavigationManager Nav
@inject HubCookieAccessor HubCookie
@inject IStringLocalizer<SharedResource> Loc
@implements IAsyncDisposable

<h1>@Loc["dashboard.title"] <span class="live">● @Loc["common.live"]</span></h1>

@* Phase 9 hub-reconnect — 4-state session banner. Hidden when Connected;
   surfaces Reconnecting / Reconnected toast / SessionExpired sticky reload.
   Wiring lives in OnInitializedAsync via WireSessionHandlers. *@
<HubSessionBanner @ref="_sessionBanner" />

@if (_loading)
{
    <p>@Loc["common.loading_dots"]</p>
}
else
{
    <div class="kpi-row">
        <div class="kpi"><div class="kpi-val">@_woCount</div><div class="kpi-lbl">@Loc["dashboard.kpi.total_wo"]</div></div>
        <div class="kpi"><div class="kpi-val">@_inProgress</div><div class="kpi-lbl">@Loc["dashboard.kpi.in_production"]</div></div>
        <div class="kpi"><div class="kpi-val">@_onHold</div><div class="kpi-lbl">@Loc["dashboard.kpi.on_hold"]</div></div>
        <div class="kpi"><div class="kpi-val">@_closed</div><div class="kpi-lbl">@Loc["dashboard.kpi.closed"]</div></div>
    </div>

    <h2>@Loc["dashboard.oee_section"]</h2>
    <table class="wo">
        <thead>
            <tr><th>@Loc["dashboard.col.machine"]</th><th>@Loc["dashboard.col.status"]</th><th>@Loc["dashboard.col.run_minutes"]</th><th>@Loc["dashboard.col.down_minutes"]</th>
                <th>@Loc["dashboard.col.good"]</th><th>@Loc["dashboard.col.reject"]</th><th>@Loc["dashboard.col.availability"]</th><th>@Loc["dashboard.col.performance"]</th><th>@Loc["dashboard.col.quality"]</th><th>@Loc["dashboard.col.oee"]</th></tr>
        </thead>
        <tbody>
            @foreach (var o in _oee)
            {
                <tr>
                    <td><b>@o.MachineCode</b> - @o.MachineName</td>
                    <td><span class="badge @StateCls(o.CurrentState)">@o.CurrentState</span></td>
                    <td>@o.RunMinutes</td>
                    <td>@o.DownMinutes</td>
                    <td>@o.GoodQty</td>
                    <td>@o.RejectQty</td>
                    <td>@Pct(o.Availability)</td>
                    <td>@Pct(o.Performance)</td>
                    <td>@Pct(o.Quality)</td>
                    <td><span class="oee @OeeCls(o.Oee)">@Pct(o.Oee)</span></td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted">@Loc["dashboard.oee_footer"]</p>

    <h2>@Loc["dashboard.wo_by_step"]</h2>
    <div class="flow-count">
        @foreach (var kv in _byStep)
        {
            <div class="fc"><div class="fc-n">@kv.Value</div><div class="fc-l">@kv.Key</div></div>
        }
    </div>
}

@code {
    private bool _loading = true;
    private int _woCount, _inProgress, _onHold, _closed;
    private List<OeeResult> _oee = new();
    private Dictionary<string,int> _byStep = new();
    private HubConnection? _hub;
    private HubSessionBanner? _sessionBanner;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // SignalR — auto-refresh whenever the shopfloor reports a change.
        // Phase 5 — forward ccl_mes_auth cookie so the negotiate request
        // authenticates against the same cookie scheme as Razor pages.
        var hubUri = Nav.ToAbsoluteUri("/hubs/shopfloor");
        _hub = new HubConnectionBuilder()
            .WithUrl(hubUri, options =>
            {
                if (!string.IsNullOrEmpty(HubCookie.AuthCookie))
                {
                    options.Cookies.Add(new System.Net.Cookie(
                        "ccl_mes_auth", HubCookie.AuthCookie, "/", hubUri.Host));
                }
            })
            .WithAutomaticReconnect()
            .Build();
        _hub.On<string>("shopfloorChanged", async _ =>
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        });

        // Phase 9 hub-reconnect — wire the 4-state UX banner. Helper
        // marshals SignalR worker-thread callbacks to the banner's
        // InvokeAsync so Blazor renders on the right thread.
        _hub.WireSessionHandlers(state =>
            _sessionBanner is null
                ? Task.CompletedTask
                : _sessionBanner.UpdateStateAsync(state));

        await _hub.StartAsync();
    }

    private async Task LoadAsync()
    {
        var wos = await Wo.GetAllAsync();
        _woCount = wos.Count;
        _inProgress = wos.Count(w => w.Status == WoStatus.InProgress);
        _onHold = wos.Count(w => w.Status == WoStatus.OnHold);
        _closed = wos.Count(w => w.Status == WoStatus.Closed);

        _byStep = wos.GroupBy(w => w.CurrentStep.ToString())
                     .ToDictionary(g => g.Key, g => g.Count());

        _oee = new();
        foreach (var m in await Oee.GetMachinesAsync())
        {
            var r = await Oee.ComputeAsync(m.Id);
            if (r is not null) _oee.Add(r);
        }
        _loading = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }

    private static string Pct(double v) => (v*100).ToString("0.0") + "%";
    private static string StateCls(string s) => s switch { "Run" => "ok", "Stop" => "err", _ => "step" };
    private static string OeeCls(double v) => v >= 0.75 ? "good" : v >= 0.5 ? "mid" : "low";
}
