@page "/workinstructions"
@inject WiService Wi
@inject IStringLocalizer<SharedResource> Loc

<h1>@Loc["workinstructions.title"]</h1>

@if (_items is null)
{
    <p>@Loc["common.loading_dots"]</p>
}
else if (_items.Count == 0)
{
    <p class="muted">@Loc["workinstructions.no_items"]</p>
}
else
{
    @foreach (var w in _items)
    {
        <div class="wi-card">
            <div class="wi-head">
                <h3>@w.Title</h3>
                <span class="badge @(w.Status == WiStatus.Approved ? "ok" : "step")">@w.Status</span>
            </div>
            <div class="wi-meta">
                @Loc["workinstructions.meta.product"]: <b>@w.Product?.ProductCode</b> &middot; @Loc["workinstructions.meta.step"]: <b>@w.ProcessStep</b>
                &middot; @Loc["workinstructions.meta.machine"]: <b>@w.MachineCode</b> &middot; @Loc["workinstructions.meta.version"]: v@w.VersionNo
            </div>
            <ol class="wi-steps">
                @foreach (var s in w.Steps.OrderBy(x => x.Sequence))
                {
                    <li>
                        @s.Description
                        @if (!string.IsNullOrEmpty(s.WarningNote))
                        {
                            <div class="wi-warn">⚠ @s.WarningNote</div>
                        }
                    </li>
                }
            </ol>
        </div>
    }
}

@code {
    private List<WorkInstruction>? _items;
    protected override async Task OnInitializedAsync() => _items = await Wi.GetAllAsync();
}
