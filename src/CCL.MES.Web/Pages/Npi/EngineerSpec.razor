@page "/npi/engineer-spec"
@attribute [Authorize(Policy = "NpiSpecRead")]
@using System.Globalization
@using CCL.MES.Application
@using CCL.MES.Application.Services
@using CCL.MES.Domain
@using CCL.MES.Domain.Entities
@using CCL.MES.Web.Shared
@using Microsoft.JSInterop
@inject SpecService SpecSvc
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Loc
@inject AuthenticationStateProvider AuthState

@*  Phase 8 PR #28 — EngineerSpec grid rewired sau Spec → ProductRevision
    clean rewrite. Backing model giờ là <see cref="ProductRevisionListItem"/>
    (pre-flattened DTO). 8 cột thay vì 7:
        spec_code · product_code · title · revision_code · status · process · effective_from · approved_by

    KHÔNG đụng RBAC policy NpiSpecRead. Mutation AuthorizeView Admin/Engineer
    cho Create + Approve unchanged. Audit codes SpecCreate/SpecApprove unchanged.
    Status badge mapping cập nhật theo ProductRevisionStatus 5-state enum.

    PR #29 sẽ ADD right-click context menu + detail view + revise/copy/trash.
*@

<section class="rt-page">
    <div class="rt-breadcrumb">
        @Loc["npi.spec.breadcrumb"]
        @if (_result is not null)
        {
            <span class="rt-breadcrumb-count">· @string.Format(Loc["npi.spec.rows_loaded"].Value, _result.Total.ToString("N0", CultureInfo.InvariantCulture))</span>
        }
    </div>

    <div class="rt-toolbar">
        <h2 class="rt-title">@Loc["npi.spec.title"]</h2>
        <span class="rt-count-chip">@RowCountLabel</span>
        <input type="search" class="rt-search" placeholder="@Loc["npi.spec.search_placeholder"]"
               @bind="_search" @bind:event="oninput" @onkeyup="OnKey" />
        <div class="rt-cols-wrap">
            <button type="button" class="rt-btn" @onclick="ToggleColsPop" aria-haspopup="true" aria-expanded="@_colsOpen">
                @string.Format(Loc["npi.spec.btn_columns"].Value, VisibleCols.Count, AllCols.Count)
            </button>
            @if (_colsOpen)
            {
                <div class="rt-cols-pop" role="menu">
                    @foreach (var c in AllCols)
                    {
                        <label>
                            <input type="checkbox" checked="@(!_hidden.Contains(c.Key))"
                                   @onchange="@(() => ToggleCol(c.Key))" />
                            @Loc[c.LabelKey]
                        </label>
                    }
                    <button type="button" class="rt-btn-link" @onclick="ShowAllCols">@Loc["npi.spec.btn_show_all"]</button>
                </div>
            }
        </div>
        <AuthorizeView Roles="Admin,Engineer">
            <button type="button" class="rt-btn" @onclick="OpenCreateAsync">+ @Loc["npi.spec.btn_create"]</button>
        </AuthorizeView>
    </div>

    <CreateSpecModal @ref="_createModal" OnCreated="OnCreatedAsync" />
    @* Phase 8 PR #29 — context menu + detail modal. KHÔNG re-fetch by id
       cho Identity (DTO grid đã có); SpecDetailModal query phụ trong section
       riêng try-catch + error banner. *@
    <SpecContextMenu @ref="_ctxMenu" OnAction="OnCtxActionAsync" />
    <SpecDetailModal @ref="_detailModal" />
    @if (!string.IsNullOrEmpty(_ctxError))
    {
        <div class="rt-ctx-error" role="alert">
            @_ctxError
            <button type="button" class="rt-ctx-error-close" @onclick="@(() => _ctxError = null)">×</button>
        </div>
    }

    <div class="rt-table-wrap">
        @if (_result is null)
        {
            <div class="rt-state">@Loc["common.loading"]</div>
        }
        else if (_result.Total == 0)
        {
            <div class="rt-state">@Loc[string.IsNullOrWhiteSpace(_search) ? "npi.spec.empty" : "npi.spec.empty_filter"]</div>
        }
        else
        {
            <table class="rt-table">
                <thead>
                    <tr>
                        <th class="rt-num">#</th>
                        @foreach (var c in VisibleCols)
                        {
                            <th style="@($"width:{c.Width}px; text-align:{(c.Align == ColAlign.Right ? "right" : "left")}")">@Loc[c.LabelKey]</th>
                        }
                        <AuthorizeView Roles="Admin,Engineer">
                            <th style="width:90px; text-align:center">@Loc["npi.spec.col.actions"]</th>
                        </AuthorizeView>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowIdx = (_result.Page - 1) * _pageSize; }
                    @foreach (var s in _result.Items)
                    {
                        rowIdx++;
                        var rowCapture = s; // capture closure để lambda async + ondblclick + oncontextmenu KHÔNG bị aliasing iterator
                        <tr @oncontextmenu="@(e => OnRowContextMenuAsync(e, rowCapture))"
                            @oncontextmenu:preventDefault="true"
                            @ondblclick="@(() => OpenDetailAsync(rowCapture))"
                            style="cursor:context-menu">
                            <td class="rt-num">@rowIdx</td>
                            @foreach (var c in VisibleCols)
                            {
                                <td class="@(c.Align == ColAlign.Right ? "rt-right" : "")" title="@RawValue(s, c.Key)">
                                    @if (c.Key == "status")
                                    {
                                        @StatusBadge(s.Status)
                                    }
                                    else
                                    {
                                        @FormatCell(s, c)
                                    }
                                </td>
                            }
                            <AuthorizeView Roles="Admin,Engineer">
                                <td style="text-align:center">
                                    @if (s.Status == ProductRevisionStatus.Draft || s.Status == ProductRevisionStatus.InReview)
                                    {
                                        <button type="button" class="spec-approve-btn"
                                                @onclick="@(() => ApproveAsync(s.Id, s.SpecCode, s.RevisionCode))"
                                                title="@Loc["npi.spec.btn_approve"]"
                                                disabled="@(_busyApproveId == s.Id)">
                                            ✓
                                        </button>
                                    }
                                </td>
                            </AuthorizeView>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_result is not null && _result.TotalPages > 1)
    {
        <Pager Result="@PagerInfo" OnPage="GoPage" />
    }
</section>

@code {
    private PagedResult<ProductRevisionListItem>? _result;
    private string? _search;
    private int _page = 1;
    private const int _pageSize = 50;
    private bool _colsOpen;
    private HashSet<string> _hidden = new();
    private const string _storageKey = "cclmes.engineer-spec.columns-hidden.v1";
    private bool _hiddenLoaded;

    private CreateSpecModal? _createModal;
    private SpecContextMenu? _ctxMenu;
    private SpecDetailModal? _detailModal;
    private string? _ctxError;
    private long _busyApproveId = 0;

    private async Task OpenCreateAsync()
    {
        if (_createModal is null) return;
        await _createModal.OpenAsync();
    }

    // ── Phase 8 PR #29 — context menu + detail modal handlers ────────────────
    // Bài học hotfix PR #27: try-catch wrap MỌI async handler, error banner
    // inline thay vì throw lên Blazor circuit (freeze SignalR connection).

    private Task OnRowContextMenuAsync(MouseEventArgs e, ProductRevisionListItem row)
    {
        try
        {
            _ctxError = null;
            _ctxMenu?.Open(e.ClientX, e.ClientY, row);
        }
        catch (Exception ex)
        {
            _ctxError = ex.GetType().Name + ": " + ex.Message;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task OnCtxActionAsync((string Action, ProductRevisionListItem Row) ev)
    {
        try
        {
            _ctxError = null;
            switch (ev.Action)
            {
                // Open + Get Info đều mở detail modal (mirror WC pattern).
                // Mutation items (edit/copy/revise/supersede) disabled cứng ở PR #29 —
                // KHÔNG cần case ở đây.
                case "open":
                case "info":
                    await OpenDetailAsync(ev.Row);
                    break;
            }
        }
        catch (Exception ex)
        {
            _ctxError = ex.GetType().Name + ": " + ex.Message;
            StateHasChanged();
        }
    }

    private async Task OpenDetailAsync(ProductRevisionListItem row)
    {
        if (_detailModal is null) return;
        try
        {
            await _detailModal.OpenAsync(row);
        }
        catch (Exception ex)
        {
            _ctxError = ex.GetType().Name + ": " + ex.Message;
            StateHasChanged();
        }
    }

    private async Task OnCreatedAsync()
    {
        _page = 1;
        _search = null;
        await Load();
    }

    private async Task ApproveAsync(long revisionId, string specCode, string revCode)
    {
        if (_busyApproveId != 0) return;
        bool confirmed;
        try
        {
            confirmed = await JS.InvokeAsync<bool>("confirm",
                string.Format(Loc["npi.spec.approve_confirm"].Value, specCode, "Rev " + revCode));
        }
        catch
        {
            confirmed = false;
        }
        if (!confirmed) return;

        _busyApproveId = revisionId;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User?.Identity?.Name;
            await SpecSvc.ApproveAsync(revisionId, user);
            await Load();
        }
        finally
        {
            _busyApproveId = 0;
        }
    }

    private enum ColAlign { Left, Right }

    private sealed record ColumnDef(string Key, string LabelKey, int Width, ColAlign Align);

    // Phase 8 PR #28 — 8 cột tổng. Default visible all 8. PR #29 sẽ ADD
    // process_code + effective_from là toggleable nếu operator muốn ẩn.
    private static readonly List<ColumnDef> AllCols = new()
    {
        new("spec_code",      "npi.spec.col.spec_code",      150, ColAlign.Left),
        new("product_code",   "npi.spec.col.product_code",   140, ColAlign.Left),
        new("title",          "npi.spec.col.title",          240, ColAlign.Left),
        new("revision_code",  "npi.spec.col.revision_code",   80, ColAlign.Left),
        new("status",         "npi.spec.col.status",         110, ColAlign.Left),
        new("process",        "npi.spec.col.process",        110, ColAlign.Left),
        new("effective_from", "npi.spec.col.effective_from", 120, ColAlign.Left),
        new("approved_by",    "npi.spec.col.approved_by",    130, ColAlign.Left),
    };

    private IReadOnlyList<ColumnDef> VisibleCols => AllCols.Where(c => !_hidden.Contains(c.Key)).ToList();

    private string RowCountLabel
    {
        get
        {
            if (_result is null) return "…";
            var totalStr = _result.Total.ToString("N0", CultureInfo.InvariantCulture);
            return string.Format(Loc["npi.spec.rows_count"].Value, totalStr);
        }
    }

    private RenderFragment StatusBadge(ProductRevisionStatus st) => __builder =>
    {
        var (cls, labelKey) = st switch
        {
            ProductRevisionStatus.Draft       => ("rm-status rm-status--draft",      "npi.spec.status.draft"),
            ProductRevisionStatus.InReview    => ("rm-status rm-status--review",     "npi.spec.status.in_review"),
            ProductRevisionStatus.Approved    => ("rm-status rm-status--approved",   "npi.spec.status.approved"),
            ProductRevisionStatus.Released    => ("rm-status rm-status--released",   "npi.spec.status.released"),
            ProductRevisionStatus.Superseded  => ("rm-status rm-status--obsolete",   "npi.spec.status.superseded"),
            _                                 => ("rm-status",                       "npi.spec.status.draft"),
        };
        __builder.OpenElement(1, "span");
        __builder.AddAttribute(2, "class", cls);
        __builder.AddContent(3, Loc[labelKey].Value);
        __builder.CloseElement();
    };

    protected override async Task OnInitializedAsync() => await Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hiddenLoaded) return;
        _hiddenLoaded = true;
        try
        {
            var stored = await JS.InvokeAsync<string?>("cclmes.storageGet", _storageKey);
            if (!string.IsNullOrWhiteSpace(stored))
            {
                var parts = stored.Split(',', StringSplitOptions.RemoveEmptyEntries);
                _hidden = parts.Where(p => AllCols.Any(c => c.Key == p)).ToHashSet();
                StateHasChanged();
            }
        }
        catch
        {
            // JS not available (SSR pre-circuit) — keep empty set.
        }
    }

    private async Task PersistHidden()
    {
        try
        {
            await JS.InvokeVoidAsync("cclmes.storageSet", _storageKey, string.Join(",", _hidden));
        }
        catch { /* localStorage unavailable — silent */ }
    }

    private async Task Load() => _result = await SpecSvc.SpecsAsync(_search, _page, _pageSize);
    private async Task DoSearch() { _page = 1; await Load(); }
    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoSearch(); }
    private async Task GoPage(int p) { _page = p; await Load(); }

    private void ToggleColsPop() => _colsOpen = !_colsOpen;
    private async Task ToggleCol(string key)
    {
        if (_hidden.Contains(key)) _hidden.Remove(key); else _hidden.Add(key);
        await PersistHidden();
    }
    private async Task ShowAllCols()
    {
        _hidden.Clear();
        await PersistHidden();
    }

    private (int Page, int TotalPages, int Total) PagerInfo =>
        _result is null ? (1, 1, 0) : (_result.Page, _result.TotalPages, _result.Total);

    private static string RawValue(ProductRevisionListItem s, string key) => key switch
    {
        "spec_code"      => s.SpecCode,
        "product_code"   => s.ProductCode,
        "title"          => s.Title,
        "revision_code"  => s.RevisionCode,
        "status"         => s.Status.ToString(),
        "process"        => s.ProcessCode ?? "",
        "effective_from" => s.EffectiveFrom?.ToString("yyyy-MM-dd") ?? "",
        "approved_by"    => s.ApprovedBy ?? "",
        _                => "",
    };

    private string FormatCell(ProductRevisionListItem s, ColumnDef col) => col.Key switch
    {
        "spec_code"      => s.SpecCode,
        "product_code"   => s.ProductCode,
        "title"          => s.Title,
        "revision_code"  => $"Rev {s.RevisionCode}",
        "process"        => s.ProcessCode ?? "—",
        "effective_from" => s.EffectiveFrom?.ToString("yyyy-MM-dd") ?? "—",
        "approved_by"    => s.ApprovedBy ?? "—",
        _                => "—",
    };
}
