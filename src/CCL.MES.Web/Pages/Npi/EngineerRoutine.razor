@page "/npi/engineer-routine"
@using CCL.MES.Application.Services
@inject NpiService Npi
@inject IStringLocalizer<SharedResource> Loc

<div class="grid-head">
    <h1>@Loc["npi.routine.title"] <span class="rowcount">@(_result?.Total.ToString("N0") ?? "…")</span></h1>
</div>

<div class="grid-toolbar">
    <input class="grid-search" placeholder="@Loc["npi.routine.search_placeholder"]" @bind="_search" @bind:event="oninput" @onkeyup="OnKey" />
    <button class="btn" @onclick="DoSearch">@Loc["common.search_button"]</button>
</div>

@if (_result is null)
{
    <p>@Loc["common.loading"]</p>
}
else
{
    <div class="table-scroll">
    <table class="wo data">
        <thead>
            <tr><th>Part No</th><th>Part Description</th><th>Op No</th><th>Operation</th>
                <th>Work Center</th><th>WC Description</th>
                <th class="num">Mach Setup</th><th class="num">Labor Setup</th><th class="num">Mach Run</th></tr>
        </thead>
        <tbody>
            @foreach (var r in _result.Items)
            {
                <tr>
                    <td><b>@r.PartNo</b></td>
                    <td>@r.PartDescription</td>
                    <td>@r.OpNo</td>
                    <td>@r.Operation</td>
                    <td><span class="badge step">@r.WorkCenterNo</span></td>
                    <td>@r.WorkCenterDescription</td>
                    <td class="num">@r.MachineSetupTime</td>
                    <td class="num">@r.LaborSetupTime</td>
                    <td class="num">@r.MachineRunTime</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <Pager Result="@PagerInfo" OnPage="GoPage" />
}

@code {
    private PagedResult<CCL.MES.Domain.Entities.RoutingOperation>? _result;
    private string? _search;
    private int _page = 1;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => _result = await Npi.RoutingAsync(_search, _page, 50);
    private async Task DoSearch() { _page = 1; await Load(); }
    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoSearch(); }
    private async Task GoPage(int p) { _page = p; await Load(); }
    private (int Page, int TotalPages, int Total) PagerInfo =>
        _result is null ? (1, 1, 0) : (_result.Page, _result.TotalPages, _result.Total);
}
