@page "/npi/engineer-routine"
@attribute [Authorize(Policy = "NpiRead")]
@using System.Globalization
@using CCL.MES.Application.Services
@using CCL.MES.Application.Services.NpiImport
@using CCL.MES.Domain.Entities
@using CCL.MES.Web.Shared
@using Microsoft.JSInterop
@inject NpiService Npi
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Loc

@*  Phase 7 hạng mục 2 — Engineer Routine UI khớp CMES tham chiếu:
    20 cột đầy đủ + freeze header (sticky thead) + Columns show/hide
    toggle (persist localStorage). RBAC NpiRead giữ nguyên. Pager 50/page.
    Pattern mirror EngineerStructure 100% — không phát sinh shared component
    cho hạng mục 2 (chỉ 2 sample patterns, trích shared sau khi 3-4 tab
    cùng dùng). *@

<section class="rt-page">
    <div class="rt-breadcrumb">
        @Loc["npi.routine.breadcrumb"]
        @if (_result is not null)
        {
            <span class="rt-breadcrumb-count">· @string.Format(Loc["npi.routine.rows_loaded"].Value, _result.Total.ToString("N0", CultureInfo.InvariantCulture))</span>
        }
    </div>

    <div class="rt-toolbar">
        <h2 class="rt-title">@Loc["npi.routine.title"]</h2>
        <span class="rt-count-chip">@RowCountLabel</span>
        <input type="search" class="rt-search" placeholder="@Loc["npi.routine.search_placeholder"]"
               @bind="_search" @bind:event="oninput" @onkeyup="OnKey" />
        <div class="rt-cols-wrap">
            <button type="button" class="rt-btn" @onclick="ToggleColsPop" aria-haspopup="true" aria-expanded="@_colsOpen">
                @string.Format(Loc["npi.routine.btn_columns"].Value, VisibleCols.Count, AllCols.Count)
            </button>
            @if (_colsOpen)
            {
                <div class="rt-cols-pop" role="menu">
                    @foreach (var c in AllCols)
                    {
                        <label>
                            <input type="checkbox" checked="@(!_hidden.Contains(c.Key))"
                                   @onchange="@(() => ToggleCol(c.Key))" />
                            @Loc[c.LabelKey]
                        </label>
                    }
                    <button type="button" class="rt-btn-link" @onclick="ShowAllCols">@Loc["npi.routine.btn_show_all"]</button>
                </div>
            }
        </div>
        @* Phase 7 hạng mục 2 — Import CSV. AuthorizeView gate Admin/Engineer
           khớp matrix Phase 6 Bước 4 §2.C (master data write). Defense-in-depth:
           NpiImportService.ApplyAsync validate role lần nữa server-side. *@
        <AuthorizeView Roles="Admin,Engineer">
            <button type="button" class="rt-btn" @onclick="OpenImportAsync">@Loc["npi.import.btn"]</button>
        </AuthorizeView>
    </div>

    <NpiImportModal TEntity="RoutingOperation"
                    @ref="_importModal"
                    Target="@_importTarget"
                    EntityLabel="@Loc["npi.routine.title"].Value"
                    OnImported="OnImportedAsync" />

    <div class="rt-table-wrap">
        @if (_result is null)
        {
            <div class="rt-state">@Loc["common.loading"]</div>
        }
        else if (_result.Total == 0)
        {
            <div class="rt-state">@Loc[string.IsNullOrWhiteSpace(_search) ? "npi.routine.empty" : "npi.routine.empty_filter"]</div>
        }
        else
        {
            <table class="rt-table">
                <thead>
                    <tr>
                        <th class="rt-num">#</th>
                        @foreach (var c in VisibleCols)
                        {
                            <th style="@($"width:{c.Width}px; text-align:{(c.Align == ColAlign.Right ? "right" : "left")}")">@Loc[c.LabelKey]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{ var rowIdx = (_result.Page - 1) * _pageSize; }
                    @foreach (var r in _result.Items)
                    {
                        rowIdx++;
                        <tr>
                            <td class="rt-num">@rowIdx</td>
                            @foreach (var c in VisibleCols)
                            {
                                <td class="@(c.Align == ColAlign.Right ? "rt-right" : "")" title="@RawValue(r, c.Key)">
                                    @FormatCell(r, c)
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_result is not null && _result.TotalPages > 1)
    {
        <Pager Result="@PagerInfo" OnPage="GoPage" />
    }
</section>

@code {
    private PagedResult<RoutingOperation>? _result;
    private string? _search;
    private int _page = 1;
    private const int _pageSize = 50;
    private bool _colsOpen;
    private HashSet<string> _hidden = new();
    private const string _storageKey = "cclmes.engineer-routine.columns-hidden.v1";
    private bool _hiddenLoaded;

    // Phase 7 hạng mục 2 — Import CSV wiring.
    private NpiImportModal<RoutingOperation>? _importModal;
    private readonly RoutineCsvTarget _importTarget = new();

    private async Task OpenImportAsync()
    {
        if (_importModal is null) return;
        await _importModal.OpenAsync(_result?.Total ?? 0);
    }

    private async Task OnImportedAsync()
    {
        // Reset to page 1 + reload grid for fresh data; user vẫn ở Step 3 modal.
        _page = 1;
        _search = null;
        await Load();
    }

    private enum ColAlign { Left, Right }

    private sealed record ColumnDef(string Key, string LabelKey, int Width, ColAlign Align,
        Func<RoutingOperation, object?> Get,
        Func<object?, string>? Format);

    // Format helpers (mirror Structure tab).
    private static string FmtNum(object? v, int digits)
    {
        if (v is null) return "—";
        if (v is double d) return d.ToString($"F{digits}", CultureInfo.InvariantCulture);
        return v.ToString() ?? "—";
    }
    private static string FmtStr(object? v)
    {
        var s = v?.ToString();
        return string.IsNullOrEmpty(s) ? "—" : s;
    }

    private static readonly List<ColumnDef> AllCols = new()
    {
        new("part_no",      "npi.routine.col.part_no",      110, ColAlign.Left,  r => r.PartNo,                null),
        new("part_desc",    "npi.routine.col.part_desc",    260, ColAlign.Left,  r => r.PartDescription,       null),
        new("op_no",        "npi.routine.col.op_no",         60, ColAlign.Left,  r => r.OpNo,                  null),
        new("operation",    "npi.routine.col.operation",    240, ColAlign.Left,  r => r.Operation,             null),
        new("work_center",  "npi.routine.col.work_center",   90, ColAlign.Left,  r => r.WorkCenterNo,          null),
        new("wc_desc",      "npi.routine.col.wc_desc",      160, ColAlign.Left,  r => r.WorkCenterDescription, null),
        new("mach_setup",   "npi.routine.col.mach_setup",    90, ColAlign.Right, r => r.MachineSetupTime,      v => FmtNum(v, 2)),
        new("labor_setup",  "npi.routine.col.labor_setup",   90, ColAlign.Right, r => r.LaborSetupTime,        v => FmtNum(v, 2)),
        new("mach_run",     "npi.routine.col.mach_run",      80, ColAlign.Right, r => r.MachineRunTime,        v => FmtNum(v, 2)),
        new("labor_run",    "npi.routine.col.labor_run",     80, ColAlign.Right, r => r.LaborRunTime,          v => FmtNum(v, 2)),
        new("unit",         "npi.routine.col.unit",          80, ColAlign.Left,  r => r.Unit,                  null),
        new("crew",         "npi.routine.col.crew",          50, ColAlign.Right, r => r.Crew,                  v => FmtNum(v, 0)),
        new("setup_crew",   "npi.routine.col.setup_crew",    80, ColAlign.Right, r => r.SetupCrew,             v => FmtNum(v, 0)),
        new("labor_class",  "npi.routine.col.labor_class",  100, ColAlign.Left,  r => r.LaborClass,            null),
        new("alt",          "npi.routine.col.alt",           50, ColAlign.Left,  r => r.Alt,                   null),
        new("effectivity",  "npi.routine.col.effectivity",   80, ColAlign.Left,  r => r.Effectivity,           null),
        new("efficiency",   "npi.routine.col.efficiency",    70, ColAlign.Right, r => r.Efficiency,            v => FmtNum(v, 2)),
        new("site",         "npi.routine.col.site",          50, ColAlign.Left,  r => r.Site,                  null),
        new("routing_type", "npi.routine.col.routing_type", 110, ColAlign.Left,  r => r.RoutingType,           null),
        new("planner",      "npi.routine.col.planner",      100, ColAlign.Left,  r => r.Planner,               null),
    };

    private IReadOnlyList<ColumnDef> VisibleCols => AllCols.Where(c => !_hidden.Contains(c.Key)).ToList();

    private string RowCountLabel
    {
        get
        {
            if (_result is null) return "…";
            var totalStr = _result.Total.ToString("N0", CultureInfo.InvariantCulture);
            return string.Format(Loc["npi.routine.rows_count"].Value, totalStr);
        }
    }

    protected override async Task OnInitializedAsync() => await Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hiddenLoaded) return;
        _hiddenLoaded = true;
        try
        {
            var stored = await JS.InvokeAsync<string?>("cclmes.storageGet", _storageKey);
            if (!string.IsNullOrWhiteSpace(stored))
            {
                var parts = stored.Split(',', StringSplitOptions.RemoveEmptyEntries);
                _hidden = parts.Where(p => AllCols.Any(c => c.Key == p)).ToHashSet();
                StateHasChanged();
            }
        }
        catch
        {
            // JS not available (SSR pre-circuit) — keep empty set, in-memory only.
        }
    }

    private async Task PersistHidden()
    {
        try
        {
            await JS.InvokeVoidAsync("cclmes.storageSet", _storageKey, string.Join(",", _hidden));
        }
        catch { /* localStorage unavailable — silent */ }
    }

    private async Task Load() => _result = await Npi.RoutingAsync(_search, _page, _pageSize);
    private async Task DoSearch() { _page = 1; await Load(); }
    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoSearch(); }
    private async Task GoPage(int p) { _page = p; await Load(); }

    private void ToggleColsPop() => _colsOpen = !_colsOpen;
    private async Task ToggleCol(string key)
    {
        if (_hidden.Contains(key)) _hidden.Remove(key); else _hidden.Add(key);
        await PersistHidden();
    }
    private async Task ShowAllCols()
    {
        _hidden.Clear();
        await PersistHidden();
    }

    private (int Page, int TotalPages, int Total) PagerInfo =>
        _result is null ? (1, 1, 0) : (_result.Page, _result.TotalPages, _result.Total);

    private static string RawValue(RoutingOperation r, string key)
    {
        var col = AllCols.FirstOrDefault(c => c.Key == key);
        if (col is null) return "";
        var v = col.Get(r);
        return v?.ToString() ?? "";
    }

    private static string FormatCell(RoutingOperation r, ColumnDef col)
    {
        var raw = col.Get(r);
        if (col.Format is not null) return col.Format(raw);
        return FmtStr(raw);
    }
}
