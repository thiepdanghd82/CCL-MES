    /// <summary>
    /// Promote = transition Draft / InReview → Approved (single click). CCL-MES's
    /// 5-state ProductRevisionStatus enum is simpler than CMES sibling's full
    /// state machine (draft → pending_npi → pending_qc → approved → obsolete);
    /// match the simpler semantics with the existing SpecSvc.ApproveAsync until
    /// a fuller state machine ships.
    /// </summary>
    private async Task PromoteAsync()
    {
        if (_busyAction || _detail is null || !CanPromote) return;
        _busyAction = true;
        _actionError = null;
        _actionMessage = null;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User?.Identity?.Name;
            bool confirmed = await JS.InvokeAsync<bool>("confirm",
                string.Format(Loc["npi.spec.approve_confirm"].Value,
                    _detail.SpecCode, "Rev " + _detail.RevisionCode));
            if (!confirmed)
            {
                _busyAction = false;
                return;
            }
            var updated = await SpecSvc.ApproveAsync(_detail.Id, user);
            if (updated is null)
            {
                _actionError = Loc["npi.spec.detail.action.promote_err"].Value;
            }
            else
            {
                _detail = await SpecSvc.SpecDetailAsync(RevisionId);
                _actionMessage = Loc["npi.spec.detail.action.promote_ok"].Value;
            }
        }
        catch (Exception ex)
        {
            _actionError = $"{Loc["npi.spec.detail.action.promote_err"].Value}: {ex.Message}";
        }
        finally
        {
            _busyAction = false;
        }
    }

