    /// <summary>Local editable row — mirrors <see cref="QcCriterionRow"/> DTO,
    /// mutable so input @oninput handlers can update in place.</summary>
    private sealed class QcRowEdit
    {
        public long? Id { get; set; }
        public string Name { get; set; } = "";
        public string? Target { get; set; }
        public string? Tolerance { get; set; }
        public string? Method { get; set; }
        public string? Frequency { get; set; }
    }

    private bool _qcPlansLoaded;
    private bool _qcPlansLoading;
    private string? _qcPlansError;
    private readonly Dictionary<QcStage, List<QcRowEdit>> _qcDraft = new()
    {
        { QcStage.IpqcPrint, new() },
        { QcStage.IpqcCut,   new() },
        { QcStage.Fqc,       new() },
        { QcStage.Oqc,       new() },
    };
    private readonly HashSet<QcStage> _qcDirty = new();
    private readonly HashSet<QcStage> _qcSaving = new();
    private readonly Dictionary<QcStage, string> _qcSaveMessages = new();
    private readonly Dictionary<QcStage, string> _qcSaveErrors = new();

    private async Task EnsureQcPlansLoadedAsync()
    {
        if (_qcPlansLoaded || _qcPlansLoading || _detail is null) return;
        _qcPlansLoading = true;
        _qcPlansError = null;
        try
        {
            var windows = await QcWindowSvc.ListByRevisionAsync(_detail.Id);
            foreach (var def in _qcStageDefs)
            {
                var rows = new List<QcRowEdit>();
                if (windows.TryGetValue(def.Stage, out var w) && w is not null)
                {
                    foreach (var c in w.Criteria.OrderBy(x => x.Seq))
                    {
                        rows.Add(new QcRowEdit
                        {
                            Id = c.Id,
                            Name = c.Name,
                            Target = c.PassCriteria,
                            Tolerance = c.MeasureMethod,
                            Method = c.Method,
                            Frequency = c.Frequency,
                        });
                    }
                }
                _qcDraft[def.Stage] = rows;
            }
            _qcDirty.Clear();
            _qcPlansLoaded = true;
        }
        catch (Exception ex)
        {
            _qcPlansError = ex.GetType().Name + ": " + ex.Message;
        }
        finally
        {
            _qcPlansLoading = false;
        }
    }

    private void AddQcRow(QcStage stage)
    {
        _qcDraft[stage].Add(new QcRowEdit { Name = "" });
        _qcDirty.Add(stage);
        _qcSaveMessages.Remove(stage);
        _qcSaveErrors.Remove(stage);
    }

    private void RemoveQcRow(QcStage stage, int idx)
    {
        if (idx < 0 || idx >= _qcDraft[stage].Count) return;
        _qcDraft[stage].RemoveAt(idx);
        _qcDirty.Add(stage);
        _qcSaveMessages.Remove(stage);
        _qcSaveErrors.Remove(stage);
    }

    private void UpdateQcField(QcStage stage, int idx, string field, string? value)
    {
        if (idx < 0 || idx >= _qcDraft[stage].Count) return;
        var row = _qcDraft[stage][idx];
        switch (field)
        {
            case "name":      row.Name      = value ?? ""; break;
            case "target":    row.Target    = value;       break;
            case "tolerance": row.Tolerance = value;       break;
            case "method":    row.Method    = value;       break;
            case "frequency": row.Frequency = value;       break;
        }
        _qcDirty.Add(stage);
        _qcSaveMessages.Remove(stage);
        _qcSaveErrors.Remove(stage);
    }

    private async Task SaveQcStageAsync(QcStage stage)
    {
        if (_detail is null || _qcSaving.Contains(stage)) return;
        // UI guards: every row must have non-empty Name. Caught server-side too.
        var rows = _qcDraft[stage];
        var blankRow = rows.FirstOrDefault(r => string.IsNullOrWhiteSpace(r.Name));
        if (blankRow is not null)
        {
            _qcSaveErrors[stage] = Loc["npi.spec.detail.qcplans.col.criterion"].Value + " — required.";
            return;
        }

        _qcSaving.Add(stage);
        _qcSaveMessages.Remove(stage);
        _qcSaveErrors.Remove(stage);
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var user = auth.User?.Identity?.Name ?? "anonymous";
            var role = ResolveRole(auth);
            var payload = rows
                .Select(r => new QcCriterionRow(
                    r.Id,
                    r.Name.Trim(),
                    r.Target,
                    r.Tolerance,
                    r.Method,
                    r.Frequency))
                .ToList();
            var saved = await QcWindowSvc.UpsertStageAsync(_detail.Id, stage, payload, user, role);

            // Rebind from authoritative response — picks up new Ids on freshly-inserted rows.
            var rebound = new List<QcRowEdit>();
            foreach (var c in saved.Criteria.OrderBy(x => x.Seq))
            {
                rebound.Add(new QcRowEdit
                {
                    Id = c.Id,
                    Name = c.Name,
                    Target = c.PassCriteria,
                    Tolerance = c.MeasureMethod,
                    Method = c.Method,
                    Frequency = c.Frequency,
                });
            }
            _qcDraft[stage] = rebound;
            _qcDirty.Remove(stage);
            _qcSaveMessages[stage] = Loc["npi.spec.detail.qcplans.save_ok"].Value;
        }
        catch (UnauthorizedAccessException)
        {
            _qcSaveErrors[stage] = Loc["npi.spec.detail.qcplans.forbidden"].Value;
        }
        catch (Exception ex)
        {
            _qcSaveErrors[stage] = ex.Message;
        }
        finally
        {
            _qcSaving.Remove(stage);
        }
    }

    private static string ResolveRole(Microsoft.AspNetCore.Components.Authorization.AuthenticationState auth)
    {
        var user = auth?.User;
        if (user is null) return "";
        if (user.IsInRole("Admin")) return "Admin";
        if (user.IsInRole("Engineer")) return "Engineer";
        if (user.IsInRole("QC")) return "QC";
        if (user.IsInRole("Operator")) return "Operator";
        return user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _detail = null;
        _activeTab = "spec";
        _artworkTemplateUserChosen = false;
        // PR-D-3 — reset QC plan state on revision change.
        _qcPlansLoaded = false;
        _qcPlansError = null;
        _qcDirty.Clear();
        _qcSaving.Clear();
        _qcSaveMessages.Clear();
        _qcSaveErrors.Clear();
        // PR-D-4 — reset QC capture state on revision change.
        _qcCapturesLoaded = false;
        _qcCapturesError = null;
        _qcLatestByCriterion.Clear();
        _captureModalOpen = false;
        _captureModalCriterion = null;
        _captureModalError = null;
        // PR-D-5b — reset Drawings tab state on revision change.
        _drawingsLoaded = false;
        _drawingsError = null;
        _drawingViews = new();
        _expandedDrawings.Clear();
        _uploadModalOpen = false;
        _uploadModalFile = null;
        _uploadModalError = null;
        try
        {
            _detail = await SpecSvc.SpecDetailAsync(RevisionId);
            ApplyArtworkTemplateFromPlanner();
        }
        catch (Exception ex)
        {
            _error = ex.GetType().Name + ": " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

