                <g>
                    <ellipse cx="200" cy="160" rx="150" ry="125" fill="#FAF6F2" />
                    <ellipse cx="200" cy="160" rx="135" ry="110" fill="none" stroke="#C0C0C0" stroke-width="1" />
                    <text x="200" y="155" font-family="serif" font-weight="300" font-size="38"
                          text-anchor="middle" fill="#9E2B5C" letter-spacing="2">Lumière</text>
                    <text x="200" y="180" font-family="serif" font-style="italic" font-size="11"
