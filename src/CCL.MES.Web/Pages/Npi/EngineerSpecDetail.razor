@page "/npi/engineer-spec/{revisionId:long}"
@attribute [Authorize(Policy = "NpiSpecRead")]

@*  Phase 8 PR-B — Full-page detail route refactored to delegate the 9-section
    showcard layout to <SpecShowcard Mode="Full" />.

    PR #31d shipped the 9 sections inline; PR-B extracts them into a shared
    component used by EngineerSpecDetail (Full), SpecDetailModal (Compact), and
    CreateSpecModal preview (Preview, PR-C). Loader + toolbar (back + print
    PDF) stay here (route-level concerns).

    Bài học hotfix #27: load via try-catch + inline error banner — KHÔNG
    freeze Blazor circuit khi SpecDetailAsync throw.
*@

@using System.Globalization
@using CCL.MES.Application
@using CCL.MES.Application.Services
@using CCL.MES.Application.SpecDetail
@using CCL.MES.Domain
@inject SpecService SpecSvc
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Loc

<section class="spec-sheet-page">
    @if (_loading)
    {
        <div class="spec-sheet-state">@Loc["common.loading"]</div>
    }
    else if (_error is not null)
    {
        <div class="alert err spec-sheet-error" role="alert">
            <strong>@Loc["npi.spec.detail.load_err"]</strong>
            <pre>@_error</pre>
            <button type="button" class="rt-btn" @onclick="GoBack">← @Loc["npi.spec.detail.btn_back"]</button>
        </div>
    }
    else if (_detail is null)
    {
        <div class="spec-sheet-state">
            <p>@Loc["npi.spec.detail.not_found"]</p>
            <button type="button" class="rt-btn" @onclick="GoBack">← @Loc["npi.spec.detail.btn_back"]</button>
        </div>
    }
    else
    {
        @* ── Toolbar (Back + Print PDF) ──────────────────────────────────── *@
        <div class="spec-sheet-toolbar">
            <button type="button" class="rt-btn" @onclick="GoBack">← @Loc["npi.spec.detail.btn_back"]</button>
            <h2 class="spec-sheet-title">@_detail.SpecCode <span class="muted">Rev @_detail.RevisionCode</span></h2>
            <button type="button" class="rt-btn rt-btn-primary" @onclick="PrintAsync">
                🖨 @Loc["npi.spec.detail.btn_print_pdf"]
            </button>
        </div>

        @* ── Showcard body (9 section — delegated to <SpecShowcard />) ───── *@
        <SpecShowcard Detail="_detail" Mode="SpecShowcardMode.Full" />
    }
</section>

@code {
    [Parameter] public long RevisionId { get; set; }

    private bool _loading = true;
    private string? _error;
    private SpecDetailDto? _detail;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _detail = null;
        try
        {
            _detail = await SpecSvc.SpecDetailAsync(RevisionId);
        }
        catch (Exception ex)
        {
            _error = ex.GetType().Name + ": " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/npi/engineer-spec");

    /// <summary>
    /// Phase 8 follow-up — open the browser's native Print dialog. macOS / Win /
    /// Linux print dialogs all offer "Save as PDF" so we no longer need to round-
    /// trip through the server PdfSpecSheetExporter for the operator's day-to-day
    /// "I want a PDF of this sheet" workflow. Server endpoint /api/specs/export/
    /// sheet/{id} stays available for API/programmatic consumers.
    /// </summary>
    private async Task PrintAsync()
    {
        if (_detail is null) return;
        await JS.InvokeVoidAsync("window.print");
    }
}
