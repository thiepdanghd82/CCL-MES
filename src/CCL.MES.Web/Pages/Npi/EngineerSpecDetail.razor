@page "/npi/engineer-spec/{revisionId:long}"
@attribute [Authorize(Policy = "NpiSpecRead")]

@*  Phase 8 follow-up — port CMES sibling's spec-detail UI chrome:
      1. Header card  (part_no · spec_kind / part_name · Rev X · status · _version)
      2. Actions bar  (History / Export / Copy / Promote / Trash)
      3. Tab bar      (Specification / Drawings / QC Plans / QC Capture / Artwork / Setup)
      4. Edit button  (inside Specification tab, top-left)

    Specification tab keeps PR-B <SpecShowcard Mode="Full"/> body.

    Stub tabs (Drawings / QC Plans / QC Capture / Artwork / Setup) render a
    placeholder card — backend tables don't exist yet on this side
    (Phase 6 IqcInspections covers a different surface; CMES sibling has
    `spec_drawings` / `spec_qc_plans` / `spec_qc_captures` / `spec_artwork`
    schema that hasn't been ported into CCL-MES).

    Actions wired this PR:
      • History  → modal showing full audit timeline (data already in DTO)
      • Export   → window.print() (keeps PR #37 + PR #41 print stylesheet flow)
      • Promote  → existing SpecSvc.ApproveAsync (Draft/InReview → Approved
                   single transition; full state machine deferred)
      • Copy     → stub (server CopySpecAsync doesn't exist yet)
      • Trash    → stub (server TrashSpecAsync doesn't exist yet)
      • Edit     → stub (Edit modal deferred — PR #31a Q5 note)

    Bài học hotfix #27: every action wraps try-catch + inline error banner.
*@

@using System.Globalization
@using CCL.MES.Application
@using CCL.MES.Application.Services
@using CCL.MES.Application.SpecDetail
@using CCL.MES.Domain
@inject SpecService SpecSvc
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Loc
@inject AuthenticationStateProvider AuthState

<section class="spec-sheet-page">
    @if (_loading)
    {
        <div class="spec-sheet-state">@Loc["common.loading"]</div>
    }
    else if (_error is not null)
    {
        <div class="alert err spec-sheet-error" role="alert">
            <strong>@Loc["npi.spec.detail.load_err"]</strong>
            <pre>@_error</pre>
            <button type="button" class="rt-btn" @onclick="GoBack">← @Loc["npi.spec.detail.btn_back"]</button>
        </div>
    }
    else if (_detail is null)
    {
        <div class="spec-sheet-state">
            <p>@Loc["npi.spec.detail.not_found"]</p>
            <button type="button" class="rt-btn" @onclick="GoBack">← @Loc["npi.spec.detail.btn_back"]</button>
        </div>
    }
    else
    {
        @* ── Back-to-list link (small, top-left) ─────────────────────────── *@
        <div class="spec-detail-back-row">
            <button type="button" class="spec-detail-back-link" @onclick="GoBack">
                ← @Loc["npi.spec.detail.btn_back"]
            </button>
        </div>

        @* ── 1. Header card (part_no · spec_kind / part_name · Rev · status) ── *@
        <div class="spec-detail-header-card">
            <h1 class="spec-detail-title">
                @_detail.SpecCode
                <span class="spec-detail-kind">· @ProcessKindLabel(_detail.Planner)</span>
            </h1>
            <p class="spec-detail-meta">
                @(string.IsNullOrWhiteSpace(_detail.ProductName) ? "—" : _detail.ProductName)
                · Rev @_detail.RevisionCode
                · <span class="rm-status @StatusBadgeClass(_detail.Status)">@_detail.StatusDisplay.ToLowerInvariant()</span>
                · @Loc["npi.spec.detail.version_label"] <code>0</code>
            </p>
        </div>

        @* ── 2. Actions bar (History / Export / Copy / Promote / Trash) ─── *@
        <div class="spec-detail-actions-bar">
            <button type="button" class="rt-btn spec-action-btn"
                    @onclick="OpenHistory" disabled="@_busyAction">
                ⟲ @Loc["npi.spec.detail.action.history"]
            </button>
            <button type="button" class="rt-btn spec-action-btn"
                    @onclick="ExportPrintAsync" disabled="@_busyAction">
                ⬇ @Loc["npi.spec.detail.action.export"]
            </button>
            <AuthorizeView Roles="Admin,Engineer">
                @* Copy / Trash / Edit are stubs until server lifecycle ops land
                   (CopySpecAsync / TrashSpecAsync / Edit modal — deferred per
                   PR #30 plan). Render as TRULY DISABLED so operators can't
                   click into a red-alert dead end — only the tooltip + "soon"
                   subtitle communicates intent. Promote stays interactive
                   (real SpecSvc.ApproveAsync wired with server-side audit). *@
                <button type="button" class="rt-btn spec-action-btn spec-action-btn-stub"
                        disabled
                        title="@Loc["npi.spec.detail.action.copy_unimpl"]">
                    ⎘ @Loc["npi.spec.detail.action.copy"]
                    <span class="spec-action-soon">soon</span>
                </button>
                <button type="button" class="rt-btn spec-action-btn"
                        @onclick="PromoteAsync"
                        disabled="@(_busyAction || !CanPromote)"
                        title="@PromoteTooltip">
                    ↗ @Loc["npi.spec.detail.action.promote"]
                </button>
                <button type="button" class="rt-btn spec-action-btn spec-action-btn-danger spec-action-btn-stub"
                        disabled
                        title="@Loc["npi.spec.detail.action.trash_unimpl"]">
                    🗑 @Loc["npi.spec.detail.action.trash"]
                    <span class="spec-action-soon">soon</span>
                </button>
            </AuthorizeView>

            @if (!string.IsNullOrEmpty(_actionError))
            {
                <span class="alert err inline">@_actionError</span>
            }
            @if (!string.IsNullOrEmpty(_actionMessage))
            {
                <span class="alert ok inline">@_actionMessage</span>
            }
        </div>

        @* ── 3. Tab bar (6 tabs) ────────────────────────────────────────── *@
        <div class="spec-detail-tabs" role="tablist" aria-label="Spec sections">
            @foreach (var tab in _tabs)
            {
                var isActive = _activeTab == tab.Key;
                <button type="button"
                        role="tab"
                        aria-selected="@isActive"
                        class="spec-detail-tab @(isActive ? "active" : "")"
                        @onclick="@(() => SetActiveTab(tab.Key))">
                    @Loc[tab.LabelKey]
                </button>
            }
        </div>

        @* ── 4. Tab content panel ───────────────────────────────────────── *@
        <div class="spec-detail-tab-panel" role="tabpanel">
            @if (_activeTab == "spec")
            {
                <div class="spec-detail-tab-toolbar">
                    <AuthorizeView Roles="Admin,Engineer">
                        @* Edit modal stub — deferred per PR #31a Q5. Render
                           truly disabled so click is a no-op (no red-alert
                           dead end). Will wire to Edit modal in a future PR. *@
                        <button type="button" class="rt-btn spec-edit-btn spec-action-btn-stub"
                                disabled
                                title="@Loc["npi.spec.detail.action.edit_unimpl"]">
                            ✎ @Loc["npi.spec.detail.action.edit"]
                            <span class="spec-action-soon">soon</span>
                        </button>
                    </AuthorizeView>
                </div>
                <SpecShowcard Detail="_detail" Mode="SpecShowcardMode.Full" />
            }
            else if (_activeTab == "setup")
            {
                @* ── Phase 8 PR-D-1 — Setup tab (read-only).
                     2 cards from SpecDetailDto.Material + Print (no new entity,
                     no new query, no mutation). Category-aware: silk vs flexo
                     surface different process counts (colors / print+cut+ink
                     rows). Empty fields render "—" per CMES pattern. *@
                <div class="spec-setup-grid">
                    @* Card 1 — Press Settings (operational params from SpecPrint) *@
                    <section class="spec-setup-card">
                        <header class="spec-setup-card-head">
                            <h3>⚙ @Loc["npi.spec.detail.setup.press.title"]</h3>
                            <span class="spec-setup-card-sub">@Loc["npi.spec.detail.setup.press.sub"]</span>
                        </header>
                        <dl class="spec-setup-rows">
                            <dt>@Loc["npi.spec.detail.setup.field.process"]</dt>
                            <dd>@OrDash(_detail.ProcessCode)
                                <span class="spec-planner-tag spec-planner-@(_detail.Planner.ToLowerInvariant())">@_detail.Planner</span>
                            </dd>

                            <dt>@Loc["npi.spec.detail.setup.field.inspection_level"]</dt>
                            <dd>@OrDash(_detail.InspectionLevel)</dd>

                            <dt>@Loc["npi.spec.detail.setup.field.printing_cavity"]</dt>
                            <dd>@OrDash(_detail.PrintingCavity?.ToString(CultureInfo.InvariantCulture))</dd>

                            <dt>@Loc["npi.spec.detail.setup.field.length_pitch"]</dt>
                            <dd>@(_detail.LengthPitchMm is null ? "—" : _detail.LengthPitchMm.Value.ToString("N1", CultureInfo.InvariantCulture) + " mm")</dd>

                            <dt>@Loc["npi.spec.detail.setup.field.product_size"]</dt>
                            <dd>@_detail.ProductSizeDisplay</dd>

                            <dt>@Loc["npi.spec.detail.setup.field.adhesive"]</dt>
                            <dd>@OrDash(_detail.AdhesiveType)</dd>

                            <dt class="spec-setup-divider" colspan="2"></dt>

                            @* Per-category process count surface *@
                            @if (_detail.Planner == "FLEXO")
                            {
                                <dt>@Loc["npi.spec.detail.setup.field.flexo_print_rows"]</dt>
                                <dd><strong>@_detail.FlexoPrintRows.Count</strong> @Loc["npi.spec.detail.setup.unit.processes"]</dd>

                                <dt>@Loc["npi.spec.detail.setup.field.flexo_cut_rows"]</dt>
                                <dd><strong>@_detail.FlexoCuttingRows.Count</strong> @Loc["npi.spec.detail.setup.unit.processes"]</dd>

                                <dt>@Loc["npi.spec.detail.setup.field.flexo_ink_rows"]</dt>
                                <dd><strong>@_detail.FlexoInkRows.Count</strong> @Loc["npi.spec.detail.setup.unit.inks"]</dd>
                            }
                            else
                            {
                                @* Silk + Indigo + Letter + Diecut + Unknown all surface PrintColors count
                                   (PR-B Q5 honest fallback: 0 colors if no data — render literal 0). *@
                                <dt>@Loc["npi.spec.detail.setup.field.print_colors"]</dt>
                                <dd><strong>@_detail.PrintColors.Count</strong> @Loc["npi.spec.detail.setup.unit.colors"]</dd>
                            }
                        </dl>
                    </section>

                    @* Card 2 — Tolerances (Critical) — placeholder pointer to QC Plans tab.
                       Per PR-D-1 Q2 default + plan §3.2: tolerance bands live in
                       SpecQcWindow + QcCriterion (shipping in PR-D-3 QC Plans).
                       Until then, this card stays a transparent placeholder with
                       a click-to-pivot button to the QC Plans tab. *@
                    <section class="spec-setup-card spec-setup-card-pending">
                        <header class="spec-setup-card-head">
                            <h3>📐 @Loc["npi.spec.detail.setup.tolerance.title"]</h3>
                            <span class="spec-setup-card-sub">@Loc["npi.spec.detail.setup.tolerance.sub"]</span>
                        </header>
                        <div class="spec-setup-pending-body">
                            <p class="spec-setup-pending-text">@Loc["npi.spec.detail.setup.tolerance.pending"]</p>
                            <button type="button" class="rt-btn spec-setup-pivot-btn"
                                    @onclick="@(() => SetActiveTab("qc-plans"))">
                                @Loc["npi.spec.detail.setup.tolerance.pivot"] →
                            </button>
                        </div>
                    </section>
                </div>
            }
            else if (_activeTab == "artwork")
            {
                @* ── Phase 8 PR-D-2 — Artwork tab (client-only SVG shell).
                     Port pattern from CMES sibling ArtworkTab.tsx (READ-ONLY
                     copy of SVG markup structure). NO API, NO entity, NO
                     mutation — client state only. CCL-MES has no per-spec
                     artwork data yet; this is a PREVIEW TEMPLATE so operator
                     understands the future surface, NOT a render of real
                     artwork (banner makes that explicit). Q3 default: template
                     auto-selected from Planner (SILK → panel-face; FLEXO →
                     brady-safety; INDIGO/LETTER/DIECUT/UNKNOWN → manual pick
                     via button row). *@
                <div class="spec-artwork-area">
                    <div class="spec-artwork-preview-banner" role="note">
                        <span class="spec-artwork-preview-icon">ℹ</span>
                        <span class="spec-artwork-preview-text">@Loc["npi.spec.detail.artwork.preview_banner"]</span>
                    </div>

                    <div class="spec-artwork-controls">
                        @* Layer toggles — 4 buttons. Mirrors CMES LAYER_DEFS:
                           Print yellow / Die-cut red / Register marks blue /
                           Bleed area light blue. Default: print + die ON,
                           reg + bleed OFF. *@
                        <div class="spec-artwork-control-group" role="group" aria-label="Layer toggles">
                            <span class="spec-artwork-control-label">@Loc["npi.spec.detail.artwork.layers_label"]:</span>
                            @foreach (var layer in _artworkLayerDefs)
                            {
                                var isOn = _artworkLayers[layer.Key];
                                <button type="button"
                                        class="spec-artwork-toggle @(isOn ? "active" : "")"
                                        aria-pressed="@isOn"
                                        @onclick="@(() => ToggleArtworkLayer(layer.Key))">
                                    <span class="spec-artwork-toggle-dot" style="background:@layer.Tint"></span>
                                    @Loc[layer.LabelKey]
                                </button>
                            }
                        </div>

                        @* Template picker — 3 buttons + auto-from-planner hint. *@
                        <div class="spec-artwork-control-group" role="group" aria-label="Template picker">
                            <span class="spec-artwork-control-label">@Loc["npi.spec.detail.artwork.template_label"]:</span>
                            @foreach (var tpl in _artworkTemplateDefs)
                            {
                                var isSelected = _artworkTemplate == tpl.Key;
                                <button type="button"
                                        class="spec-artwork-template-btn @(isSelected ? "active" : "")"
                                        @onclick="@(() => SetArtworkTemplate(tpl.Key))">
                                    @Loc[tpl.LabelKey]
                                </button>
                            }
                            <span class="spec-artwork-template-hint">@ArtworkTemplateHint()</span>
                        </div>
                    </div>

                    <div class="spec-artwork-canvas">
                        @switch (_artworkTemplate)
                        {
                            case "ccl-cosmetic":
                                @RenderCosmeticSvg();
                                break;
                            case "panel-face":
                                @RenderPanelFaceSvg();
                                break;
                            case "brady-safety":
                            default:
                                @RenderBradySafetySvg();
                                break;
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="spec-detail-coming-soon">
                    <div class="spec-detail-coming-soon-icon">@ComingSoonIcon(_activeTab)</div>
                    <h3>@Loc[$"npi.spec.detail.tab.{_activeTab}"]</h3>
                    <p>@Loc["npi.spec.detail.coming_soon_body"]</p>
                </div>
            }
        </div>

        @* ── History modal (full audit timeline) ────────────────────────── *@
        @if (_historyOpen)
        {
            <div class="modal-scrim" @onclick="CloseHistory">
                <div class="modal-card spec-history-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                    <div class="modal-head">
                        <h2>⟲ @Loc["npi.spec.detail.action.history"] — @_detail.SpecCode Rev @_detail.RevisionCode</h2>
                        <button type="button" class="modal-close" @onclick="CloseHistory" aria-label="Close">×</button>
                    </div>
                    <div class="modal-body">
                        @if (_detail.AuditEntries.Count == 0)
                        {
                            <p class="muted">@Loc["npi.spec.detail.audit.empty"]</p>
                        }
                        else
                        {
                            <ul class="spec-audit-log spec-history-modal-list">
                                @foreach (var a in _detail.AuditEntries)
                                {
                                    <li>
                                        <span class="audit-time">@a.Timestamp.ToString("yyyy-MM-dd HH:mm")</span>
                                        <span class="audit-action">@a.Action</span>
                                        <span class="muted">· @a.ActorUsername</span>
                                        @if (!string.IsNullOrWhiteSpace(a.ActorRole))
                                        {
                                            <span class="muted">(@a.ActorRole)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="modal-foot">
                        <button type="button" class="btn" @onclick="CloseHistory">@Loc["npi.spec.detail.btn_close"]</button>
                    </div>
                </div>
            </div>
        }
    }
</section>

@code {
    [Parameter] public long RevisionId { get; set; }

    private bool _loading = true;
    private string? _error;
    private SpecDetailDto? _detail;

    // Tab state
    private string _activeTab = "spec";
    private sealed record TabDef(string Key, string LabelKey);
    private static readonly TabDef[] _tabs = new[]
    {
        new TabDef("spec",       "npi.spec.detail.tab.spec"),
        new TabDef("drawings",   "npi.spec.detail.tab.drawings"),
        new TabDef("qc-plans",   "npi.spec.detail.tab.qc-plans"),
        new TabDef("qc-capture", "npi.spec.detail.tab.qc-capture"),
        new TabDef("artwork",    "npi.spec.detail.tab.artwork"),
        new TabDef("setup",      "npi.spec.detail.tab.setup"),
    };

    // Action state
    private bool _busyAction;
    private string? _actionError;
    private string? _actionMessage;
    private bool _historyOpen;

    // ── Phase 8 PR-D-2 — Artwork tab state (client-only).
    private sealed record ArtworkLayerDef(string Key, string LabelKey, string Tint);
    private sealed record ArtworkTemplateDef(string Key, string LabelKey);

    private static readonly ArtworkLayerDef[] _artworkLayerDefs = new[]
    {
        new ArtworkLayerDef("print", "npi.spec.detail.artwork.layer.print", "#FFCD00"),
        new ArtworkLayerDef("die",   "npi.spec.detail.artwork.layer.die",   "#ef4444"),
        new ArtworkLayerDef("reg",   "npi.spec.detail.artwork.layer.reg",   "#00b4d8"),
        new ArtworkLayerDef("bleed", "npi.spec.detail.artwork.layer.bleed", "#60a5fa"),
    };

    private static readonly ArtworkTemplateDef[] _artworkTemplateDefs = new[]
    {
        new ArtworkTemplateDef("brady-safety", "npi.spec.detail.artwork.template.brady_safety"),
        new ArtworkTemplateDef("ccl-cosmetic", "npi.spec.detail.artwork.template.ccl_cosmetic"),
        new ArtworkTemplateDef("panel-face",   "npi.spec.detail.artwork.template.panel_face"),
    };

    /// <summary>Layer visibility state — defaults per CMES sibling: print+die ON, reg+bleed OFF.</summary>
    private Dictionary<string, bool> _artworkLayers = new()
    {
        ["print"] = true,
        ["die"]   = true,
        ["reg"]   = false,
        ["bleed"] = false,
    };

    /// <summary>Selected template — auto from Planner per Q3, manual override allowed.</summary>
    private string _artworkTemplate = "brady-safety";

    /// <summary>Track whether operator has manually picked a template (suppresses auto-from-planner reset).</summary>
    private bool _artworkTemplateUserChosen;

    private void ToggleArtworkLayer(string key)
    {
        if (_artworkLayers.ContainsKey(key)) _artworkLayers[key] = !_artworkLayers[key];
    }

    private void SetArtworkTemplate(string template)
    {
        _artworkTemplate = template;
        _artworkTemplateUserChosen = true;
    }

    /// <summary>
    /// Q3 default — auto-select template from Planner when operator hasn't manually
    /// picked one. SILK → panel-face (rectangular black panel matches dashboard labels).
    /// FLEXO → brady-safety (rectangular warning label matches roll output).
    /// Others (INDIGO / LETTER / DIECUT / UNKNOWN) → brady-safety as universal fallback.
    /// </summary>
    private void ApplyArtworkTemplateFromPlanner()
    {
        if (_artworkTemplateUserChosen || _detail is null) return;
        _artworkTemplate = (_detail.Planner ?? "UNKNOWN").Trim().ToUpperInvariant() switch
        {
            "SILK"  => "panel-face",
            "FLEXO" => "brady-safety",
            _       => "brady-safety",
        };
    }

    private string ArtworkTemplateHint()
    {
        if (_artworkTemplateUserChosen) return "";
        var hint = (_detail?.Planner ?? "UNKNOWN").Trim().ToUpperInvariant() switch
        {
            "SILK"  => Loc["npi.spec.detail.artwork.template_hint.silk"].Value,
            "FLEXO" => Loc["npi.spec.detail.artwork.template_hint.flexo"].Value,
            _       => Loc["npi.spec.detail.artwork.template_hint.other"].Value,
        };
        return hint;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _detail = null;
        _activeTab = "spec";
        _artworkTemplateUserChosen = false;
        try
        {
            _detail = await SpecSvc.SpecDetailAsync(RevisionId);
            ApplyArtworkTemplateFromPlanner();
        }
        catch (Exception ex)
        {
            _error = ex.GetType().Name + ": " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/npi/engineer-spec");

    private void SetActiveTab(string key)
    {
        _activeTab = key;
        _actionError = null;
        _actionMessage = null;
    }

    /// <summary>
    /// Phase 8 follow-up — Export action uses the browser's native Print
    /// dialog (window.print()) honoring the A4 landscape + 2-page stylesheet
    /// shipped in PR #37 / #39 / #41. Server endpoint /api/specs/export/
    /// sheet/{id} remains available for API consumers.
    /// </summary>
    private async Task ExportPrintAsync()
    {
        if (_busyAction || _detail is null) return;
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            _actionError = ex.GetType().Name + ": " + ex.Message;
        }
    }

    private void OpenHistory()
    {
        _actionError = null;
        _actionMessage = null;
        _historyOpen = true;
    }

    private void CloseHistory() => _historyOpen = false;

    /// <summary>
    /// Promote = transition Draft / InReview → Approved (single click). CCL-MES's
    /// 5-state ProductRevisionStatus enum is simpler than CMES sibling's full
    /// state machine (draft → pending_npi → pending_qc → approved → obsolete);
    /// match the simpler semantics with the existing SpecSvc.ApproveAsync until
    /// a fuller state machine ships.
    /// </summary>
    private async Task PromoteAsync()
    {
        if (_busyAction || _detail is null || !CanPromote) return;
        _busyAction = true;
        _actionError = null;
        _actionMessage = null;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User?.Identity?.Name;
            bool confirmed = await JS.InvokeAsync<bool>("confirm",
                string.Format(Loc["npi.spec.approve_confirm"].Value,
                    _detail.SpecCode, "Rev " + _detail.RevisionCode));
            if (!confirmed)
            {
                _busyAction = false;
                return;
            }
            var updated = await SpecSvc.ApproveAsync(_detail.Id, user);
            if (updated is null)
            {
                _actionError = Loc["npi.spec.detail.action.promote_err"].Value;
            }
            else
            {
                _detail = await SpecSvc.SpecDetailAsync(RevisionId);
                _actionMessage = Loc["npi.spec.detail.action.promote_ok"].Value;
            }
        }
        catch (Exception ex)
        {
            _actionError = $"{Loc["npi.spec.detail.action.promote_err"].Value}: {ex.Message}";
        }
        finally
        {
            _busyAction = false;
        }
    }

    private bool CanPromote => _detail is not null
        && (_detail.Status == ProductRevisionStatus.Draft
            || _detail.Status == ProductRevisionStatus.InReview);

    private string PromoteTooltip
        => CanPromote
            ? Loc["npi.spec.detail.action.promote_tooltip"].Value
            : Loc["npi.spec.detail.action.promote_blocked"].Value;

    // Copy / Trash / Edit handlers removed — buttons now render as truly
    // disabled stubs (no click event reaches Blazor). Will be re-added when
    // the server-side lifecycle ops (CopySpecAsync / TrashSpecAsync / Edit
    // modal) ship in a future PR.

    private static string ProcessKindLabel(string planner) => (planner ?? "UNKNOWN").Trim().ToUpperInvariant() switch
    {
        "SILK"   => "PRINT",
        "FLEXO"  => "PRINT",
        "INDIGO" => "PRINT",
        "LETTER" => "PRINT",
        "DIECUT" => "DIE-CUT",
        _        => "SPEC",
    };

    private static string StatusBadgeClass(ProductRevisionStatus s) => s switch
    {
        ProductRevisionStatus.Draft      => "rm-status--draft",
        ProductRevisionStatus.InReview   => "rm-status--review",
        ProductRevisionStatus.Approved   => "rm-status--approved",
        ProductRevisionStatus.Released   => "rm-status--released",
        ProductRevisionStatus.Superseded => "rm-status--obsolete",
        _                                 => "",
    };

    private static string ComingSoonIcon(string tab) => tab switch
    {
        "drawings"   => "📐",
        "qc-plans"   => "📋",
        "qc-capture" => "✅",
        "artwork"    => "🎨",
        "setup"      => "⚙",
        _            => "📦",
    };

    /// <summary>Render "—" for null/whitespace strings — Setup tab uses this on
    /// every read-only field per PR-D-1 plan ("field rỗng render '—' gọn").</summary>
    private static string OrDash(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;

    // ── Phase 8 PR-D-2 — Artwork SVG renderers (port from CMES sibling).
    //    Layers conditionally rendered via @if; SVG markup straight C-port of
    //    BradySafetySvg / CosmeticSvg / PanelFaceSvg JSX. RenderFragment so
    //    Razor compiler treats SVG nested tags correctly.

    private RenderFragment RenderBradySafetySvg() => __builder =>
    {
        <svg class="spec-artwork-svg" viewBox="0 0 400 280" xmlns="http://www.w3.org/2000/svg"
             aria-label="Brady safety label artwork preview">
            @if (_artworkLayers["bleed"])
            {
                <rect x="10" y="10" width="380" height="260" fill="none" stroke="#60a5fa"
                      stroke-width="1" stroke-dasharray="2,4" opacity="0.6" />
            }
            @if (_artworkLayers["print"])
            {
                <g>
                    <rect x="30" y="30" width="340" height="220" rx="12" fill="#FFCD00" />
                    <polygon points="200,55 250,140 150,140" fill="none" stroke="#101820" stroke-width="6" />
                    <text x="200" y="125" font-family="system-ui, sans-serif" font-weight="700"
                          font-size="32" text-anchor="middle" fill="#101820">!</text>
                    <text x="200" y="175" font-family="system-ui, sans-serif" font-weight="700"
                          font-size="22" text-anchor="middle" fill="#101820" letter-spacing="2">WARNING</text>
                    <text x="200" y="200" font-family="system-ui, sans-serif" font-weight="500"
                          font-size="11" text-anchor="middle" fill="#101820">HIGH VOLTAGE · KEEP OUT</text>
                </g>
            }
            @if (_artworkLayers["die"])
            {
                <rect x="30" y="30" width="340" height="220" rx="12" fill="none" stroke="#ef4444"
                      stroke-width="1.5" stroke-dasharray="6,3" />
            }
            @if (_artworkLayers["reg"])
            {
                <g stroke="#00b4d8" stroke-width="1" fill="none">
                    <circle cx="20" cy="20" r="5" />
                    <line x1="15" y1="20" x2="25" y2="20" />
                    <line x1="20" y1="15" x2="20" y2="25" />
                    <circle cx="380" cy="20" r="5" />
                    <line x1="375" y1="20" x2="385" y2="20" />
                    <line x1="380" y1="15" x2="380" y2="25" />
                    <circle cx="20" cy="260" r="5" />
                    <line x1="15" y1="260" x2="25" y2="260" />
                    <line x1="20" y1="255" x2="20" y2="265" />
                    <circle cx="380" cy="260" r="5" />
                    <line x1="375" y1="260" x2="385" y2="260" />
                    <line x1="380" y1="255" x2="380" y2="265" />
                </g>
            }
        </svg>
    };

    private RenderFragment RenderCosmeticSvg() => __builder =>
