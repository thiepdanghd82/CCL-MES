        }
        // PR-D-4 — QC Capture needs plans (criteria list) + captures (latest pill)
        // + reason codes (modal dropdown). Plans-load is shared with PR-D-3.
        if (key == "qc-capture")
        {
            await EnsureQcPlansLoadedAsync();
            await EnsureQcCapturesLoadedAsync();
        }
        // PR-D-5b — Drawings tab lazy-load.
        if (key == "drawings")
        {
            await EnsureDrawingsLoadedAsync();
