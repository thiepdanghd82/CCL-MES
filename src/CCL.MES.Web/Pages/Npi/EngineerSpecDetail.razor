                _captureMeasurement,
                _captureReasonCode,
                _captureComment);
            var saved = await QcCaptureSvc.CaptureAsync(_detail!.Id, request, user, role);
            // Update latest-by-criterion in place — no full reload needed.
            _qcLatestByCriterion[saved.QcCriterionId] = saved;
            _captureModalOpen = false;
