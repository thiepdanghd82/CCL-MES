    private async Task SubmitUploadAsync()
    {
        if (_uploadModalBusy || _detail is null) return;
        if (_uploadModalFile is null)
        {
            _uploadModalError = Loc["npi.spec.detail.drawings.modal.err_no_file"].Value;
            return;
        }

        _uploadModalBusy = true;
        _uploadModalError = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var user = auth.User?.Identity?.Name ?? "anonymous";
            var role = ResolveRole(auth);

            // Stream straight into the blob store — never buffer full into memory.
            // maxAllowedSize MUST be set to match server cap (Blazor default is
            // 512 KB; size-cap rejection then happens client-side instead of
            // surfacing the server's clearer "exceeds MaxBytes" message).
            await using var stream = _uploadModalFile.OpenReadStream(BlobOpts.MaxBytes);
            await DrawingsSvc.UploadAsync(
                _detail.Id,
                _uploadModalKind,
                _uploadModalFile.Name,
                _uploadModalFile.ContentType ?? "application/octet-stream",
                stream,
                _uploadModalChangeReason,
                user,
                role);

            // Reload list so the new version surfaces with server-assigned Id.
            _drawingViews = await DrawingsSvc.ListByRevisionAsync(_detail.Id);
            _uploadModalOpen = false;
            _uploadModalFile = null;
            _uploadModalChangeReason = null;
        }
        catch (UnauthorizedAccessException)
        {
            _uploadModalError = Loc["npi.spec.detail.drawings.forbidden"].Value;
        }
        catch (Exception ex)
        {
            _uploadModalError = ex.Message;
        }
        finally
        {
            _uploadModalBusy = false;
        }
    }

