@page "/npi/engineer-spec/{revisionId:long}"
@attribute [Authorize(Policy = "NpiSpecRead")]

@*  Phase 8 follow-up — port CMES sibling's spec-detail UI chrome:
      1. Header card  (part_no · spec_kind / part_name · Rev X · status · _version)
      2. Actions bar  (History / Export / Copy / Promote / Trash)
      3. Tab bar      (Specification / Drawings / QC Plans / QC Capture / Artwork / Setup)
      4. Edit button  (inside Specification tab, top-left)

    Specification tab keeps PR-B <SpecShowcard Mode="Full"/> body.

    Stub tabs (Drawings / QC Plans / QC Capture / Artwork / Setup) render a
    placeholder card — backend tables don't exist yet on this side
    (Phase 6 IqcInspections covers a different surface; CMES sibling has
    `spec_drawings` / `spec_qc_plans` / `spec_qc_captures` / `spec_artwork`
    schema that hasn't been ported into CCL-MES).

    Actions wired this PR:
      • History  → modal showing full audit timeline (data already in DTO)
      • Export   → window.print() (keeps PR #37 + PR #41 print stylesheet flow)
      • Promote  → existing SpecSvc.ApproveAsync (Draft/InReview → Approved
                   single transition; full state machine deferred)
      • Copy     → stub (server CopySpecAsync doesn't exist yet)
      • Trash    → stub (server TrashSpecAsync doesn't exist yet)
      • Edit     → stub (Edit modal deferred — PR #31a Q5 note)

    Bài học hotfix #27: every action wraps try-catch + inline error banner.
*@

@using System.Globalization
@using CCL.MES.Application
@using CCL.MES.Application.Services
@using CCL.MES.Application.SpecDetail
@using CCL.MES.Domain
@using CCL.MES.Domain.Entities
@using CCL.MES.Infrastructure.Storage
@using Microsoft.AspNetCore.Components.Forms
@inject SpecService SpecSvc
@inject SpecQcWindowService QcWindowSvc
@inject SpecQcCaptureService QcCaptureSvc
@inject DrawingsService DrawingsSvc
@inject BlobStoreOptions BlobOpts
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Loc
@inject AuthenticationStateProvider AuthState

<section class="spec-sheet-page">
    @if (_loading)
    {
        <div class="spec-sheet-state">@Loc["common.loading"]</div>
    }
    else if (_error is not null)
    {
        <div class="alert err spec-sheet-error" role="alert">
            <strong>@Loc["npi.spec.detail.load_err"]</strong>
            <pre>@_error</pre>
            <button type="button" class="rt-btn" @onclick="GoBack">← @Loc["npi.spec.detail.btn_back"]</button>
        </div>
    }
    else if (_detail is null)
    {
        <div class="spec-sheet-state">
            <p>@Loc["npi.spec.detail.not_found"]</p>
            <button type="button" class="rt-btn" @onclick="GoBack">← @Loc["npi.spec.detail.btn_back"]</button>
        </div>
    }
    else
    {
        @* ── Back-to-list link (small, top-left) ─────────────────────────── *@
        <div class="spec-detail-back-row">
            <button type="button" class="spec-detail-back-link" @onclick="GoBack">
                ← @Loc["npi.spec.detail.btn_back"]
            </button>
        </div>

        @* ── 1. Header card (part_no · spec_kind / part_name · Rev · status) ── *@
        <div class="spec-detail-header-card">
            <h1 class="spec-detail-title">
                @_detail.SpecCode
                <span class="spec-detail-kind">· @ProcessKindLabel(_detail.Planner)</span>
            </h1>
            <p class="spec-detail-meta">
                @(string.IsNullOrWhiteSpace(_detail.ProductName) ? "—" : _detail.ProductName)
                · Rev @_detail.RevisionCode
                · <span class="rm-status @StatusBadgeClass(_detail.Status)">@_detail.StatusDisplay.ToLowerInvariant()</span>
                · @Loc["npi.spec.detail.version_label"] <code>0</code>
            </p>
        </div>

        @* ── 2. Actions bar (History / Export / Copy / Promote / Trash) ─── *@
        <div class="spec-detail-actions-bar">
            <button type="button" class="rt-btn spec-action-btn"
                    @onclick="OpenHistory" disabled="@_busyAction">
                ⟲ @Loc["npi.spec.detail.action.history"]
            </button>
            <button type="button" class="rt-btn spec-action-btn"
                    @onclick="ExportPrintAsync" disabled="@_busyAction">
                ⬇ @Loc["npi.spec.detail.action.export"]
            </button>
            <AuthorizeView Roles="Admin,Engineer">
                @* Copy / Trash / Edit are stubs until server lifecycle ops land
                   (CopySpecAsync / TrashSpecAsync / Edit modal — deferred per
                   PR #30 plan). Render as TRULY DISABLED so operators can't
                   click into a red-alert dead end — only the tooltip + "soon"
                   subtitle communicates intent. Promote stays interactive
                   (real SpecSvc.ApproveAsync wired with server-side audit). *@
                <button type="button" class="rt-btn spec-action-btn spec-action-btn-stub"
                        disabled
                        title="@Loc["npi.spec.detail.action.copy_unimpl"]">
                    ⎘ @Loc["npi.spec.detail.action.copy"]
                    <span class="spec-action-soon">soon</span>
                </button>
                <button type="button" class="rt-btn spec-action-btn"
                        @onclick="PromoteAsync"
                        disabled="@(_busyAction || !CanPromote)"
                        title="@PromoteTooltip">
                    ↗ @Loc["npi.spec.detail.action.promote"]
                </button>
                <button type="button" class="rt-btn spec-action-btn spec-action-btn-danger spec-action-btn-stub"
                        disabled
                        title="@Loc["npi.spec.detail.action.trash_unimpl"]">
                    🗑 @Loc["npi.spec.detail.action.trash"]
                    <span class="spec-action-soon">soon</span>
                </button>
            </AuthorizeView>

            @if (!string.IsNullOrEmpty(_actionError))
            {
                <span class="alert err inline">@_actionError</span>
            }
            @if (!string.IsNullOrEmpty(_actionMessage))
            {
                <span class="alert ok inline">@_actionMessage</span>
            }
        </div>

        @* ── 3. Tab bar (6 tabs) ────────────────────────────────────────── *@
        <div class="spec-detail-tabs" role="tablist" aria-label="Spec sections">
            @foreach (var tab in _tabs)
            {
                var isActive = _activeTab == tab.Key;
                <button type="button"
                        role="tab"
                        aria-selected="@isActive"
                        class="spec-detail-tab @(isActive ? "active" : "")"
                        @onclick="@(() => SetActiveTab(tab.Key))">
                    @Loc[tab.LabelKey]
                </button>
            }
        </div>

        @* ── 4. Tab content panel ───────────────────────────────────────── *@
        <div class="spec-detail-tab-panel" role="tabpanel">
            @if (_activeTab == "spec")
            {
                <div class="spec-detail-tab-toolbar">
                    <AuthorizeView Roles="Admin,Engineer">
                        @* Edit modal stub — deferred per PR #31a Q5. Render
                           truly disabled so click is a no-op (no red-alert
                           dead end). Will wire to Edit modal in a future PR. *@
                        <button type="button" class="rt-btn spec-edit-btn spec-action-btn-stub"
                                disabled
                                title="@Loc["npi.spec.detail.action.edit_unimpl"]">
                            ✎ @Loc["npi.spec.detail.action.edit"]
                            <span class="spec-action-soon">soon</span>
                        </button>
                    </AuthorizeView>
                </div>
                <SpecShowcard Detail="_detail" Mode="SpecShowcardMode.Full" />
            }
            else if (_activeTab == "setup")
            {
                @* ── Phase 8 PR-D-1 — Setup tab (read-only).
                     2 cards from SpecDetailDto.Material + Print (no new entity,
                     no new query, no mutation). Category-aware: silk vs flexo
                     surface different process counts (colors / print+cut+ink
                     rows). Empty fields render "—" per CMES pattern. *@
                <div class="spec-setup-grid">
                    @* Card 1 — Press Settings (operational params from SpecPrint) *@
                    <section class="spec-setup-card">
                        <header class="spec-setup-card-head">
                            <h3>⚙ @Loc["npi.spec.detail.setup.press.title"]</h3>
                            <span class="spec-setup-card-sub">@Loc["npi.spec.detail.setup.press.sub"]</span>
                        </header>
                        <dl class="spec-setup-rows">
                            <dt>@Loc["npi.spec.detail.setup.field.process"]</dt>
                            <dd>@OrDash(_detail.ProcessCode)
                                <span class="spec-planner-tag spec-planner-@(_detail.Planner.ToLowerInvariant())">@_detail.Planner</span>
                            </dd>

                            <dt>@Loc["npi.spec.detail.setup.field.inspection_level"]</dt>
                            <dd>@OrDash(_detail.InspectionLevel)</dd>

                            <dt>@Loc["npi.spec.detail.setup.field.printing_cavity"]</dt>
                            <dd>@OrDash(_detail.PrintingCavity?.ToString(CultureInfo.InvariantCulture))</dd>

                            <dt>@Loc["npi.spec.detail.setup.field.length_pitch"]</dt>
                            <dd>@(_detail.LengthPitchMm is null ? "—" : _detail.LengthPitchMm.Value.ToString("N1", CultureInfo.InvariantCulture) + " mm")</dd>

                            <dt>@Loc["npi.spec.detail.setup.field.product_size"]</dt>
                            <dd>@_detail.ProductSizeDisplay</dd>

                            <dt>@Loc["npi.spec.detail.setup.field.adhesive"]</dt>
                            <dd>@OrDash(_detail.AdhesiveType)</dd>

                            <dt class="spec-setup-divider" colspan="2"></dt>

                            @* Per-category process count surface *@
                            @if (_detail.Planner == "FLEXO")
                            {
                                <dt>@Loc["npi.spec.detail.setup.field.flexo_print_rows"]</dt>
                                <dd><strong>@_detail.FlexoPrintRows.Count</strong> @Loc["npi.spec.detail.setup.unit.processes"]</dd>

                                <dt>@Loc["npi.spec.detail.setup.field.flexo_cut_rows"]</dt>
                                <dd><strong>@_detail.FlexoCuttingRows.Count</strong> @Loc["npi.spec.detail.setup.unit.processes"]</dd>

                                <dt>@Loc["npi.spec.detail.setup.field.flexo_ink_rows"]</dt>
                                <dd><strong>@_detail.FlexoInkRows.Count</strong> @Loc["npi.spec.detail.setup.unit.inks"]</dd>
                            }
                            else
                            {
                                @* Silk + Indigo + Letter + Diecut + Unknown all surface PrintColors count
                                   (PR-B Q5 honest fallback: 0 colors if no data — render literal 0). *@
                                <dt>@Loc["npi.spec.detail.setup.field.print_colors"]</dt>
                                <dd><strong>@_detail.PrintColors.Count</strong> @Loc["npi.spec.detail.setup.unit.colors"]</dd>
                            }
                        </dl>
                    </section>

                    @* Card 2 — Tolerances (Critical) — placeholder pointer to QC Plans tab.
                       Per PR-D-1 Q2 default + plan §3.2: tolerance bands live in
                       SpecQcWindow + QcCriterion (shipping in PR-D-3 QC Plans).
                       Until then, this card stays a transparent placeholder with
                       a click-to-pivot button to the QC Plans tab. *@
                    <section class="spec-setup-card spec-setup-card-pending">
                        <header class="spec-setup-card-head">
                            <h3>📐 @Loc["npi.spec.detail.setup.tolerance.title"]</h3>
                            <span class="spec-setup-card-sub">@Loc["npi.spec.detail.setup.tolerance.sub"]</span>
                        </header>
                        <div class="spec-setup-pending-body">
                            <p class="spec-setup-pending-text">@Loc["npi.spec.detail.setup.tolerance.pending"]</p>
                            <button type="button" class="rt-btn spec-setup-pivot-btn"
                                    @onclick="@(() => SetActiveTab("qc-plans"))">
                                @Loc["npi.spec.detail.setup.tolerance.pivot"] →
                            </button>
                        </div>
                    </section>
                </div>
            }
            else if (_activeTab == "artwork")
            {
                @* ── Phase 8 PR-D-2 — Artwork tab (client-only SVG shell).
                     Port pattern from CMES sibling ArtworkTab.tsx (READ-ONLY
                     copy of SVG markup structure). NO API, NO entity, NO
                     mutation — client state only. CCL-MES has no per-spec
                     artwork data yet; this is a PREVIEW TEMPLATE so operator
                     understands the future surface, NOT a render of real
                     artwork (banner makes that explicit). Q3 default: template
                     auto-selected from Planner (SILK → panel-face; FLEXO →
                     brady-safety; INDIGO/LETTER/DIECUT/UNKNOWN → manual pick
                     via button row). *@
                <div class="spec-artwork-area">
                    <div class="spec-artwork-preview-banner" role="note">
                        <span class="spec-artwork-preview-icon">ℹ</span>
                        <span class="spec-artwork-preview-text">@Loc["npi.spec.detail.artwork.preview_banner"]</span>
                    </div>

                    <div class="spec-artwork-controls">
                        @* Layer toggles — 4 buttons. Mirrors CMES LAYER_DEFS:
                           Print yellow / Die-cut red / Register marks blue /
                           Bleed area light blue. Default: print + die ON,
                           reg + bleed OFF. *@
                        <div class="spec-artwork-control-group" role="group" aria-label="Layer toggles">
                            <span class="spec-artwork-control-label">@Loc["npi.spec.detail.artwork.layers_label"]:</span>
                            @foreach (var layer in _artworkLayerDefs)
                            {
                                var isOn = _artworkLayers[layer.Key];
                                <button type="button"
                                        class="spec-artwork-toggle @(isOn ? "active" : "")"
                                        aria-pressed="@isOn"
                                        @onclick="@(() => ToggleArtworkLayer(layer.Key))">
                                    <span class="spec-artwork-toggle-dot" style="background:@layer.Tint"></span>
                                    @Loc[layer.LabelKey]
                                </button>
                            }
                        </div>

                        @* Template picker — 3 buttons + auto-from-planner hint. *@
                        <div class="spec-artwork-control-group" role="group" aria-label="Template picker">
                            <span class="spec-artwork-control-label">@Loc["npi.spec.detail.artwork.template_label"]:</span>
                            @foreach (var tpl in _artworkTemplateDefs)
                            {
                                var isSelected = _artworkTemplate == tpl.Key;
                                <button type="button"
                                        class="spec-artwork-template-btn @(isSelected ? "active" : "")"
                                        @onclick="@(() => SetArtworkTemplate(tpl.Key))">
                                    @Loc[tpl.LabelKey]
                                </button>
                            }
                            <span class="spec-artwork-template-hint">@ArtworkTemplateHint()</span>
                        </div>
                    </div>

                    <div class="spec-artwork-canvas">
                        @switch (_artworkTemplate)
                        {
                            case "ccl-cosmetic":
                                @RenderCosmeticSvg();
                                break;
                            case "panel-face":
                                @RenderPanelFaceSvg();
                                break;
                            case "brady-safety":
                            default:
                                @RenderBradySafetySvg();
                                break;
                        }
                    </div>
                </div>
            }
            else if (_activeTab == "qc-plans")
            {
                @* ── Phase 8 PR-D-3 — QC Plans tab. CMES sibling parity:
                     4 stage sections (IPQC-Print / IPQC-Cut / FQC / OQC),
                     each editable table with 6 cols (Criterion / Target /
                     Tolerance / Method / Frequency / Delete). Per-stage
                     dirty flag + atomic per-stage save via
                     SpecQcWindowService.UpsertStageAsync. RBAC: View =
                     route NpiSpecRead; Edit = Admin or Engineer (AuthorizeView +
                     server-side role check inside the service). Hotfix #27:
                     render from entity + try-catch + inline error banner. *@
                <div class="spec-qcplans-area">
                    <p class="spec-qcplans-intro">@Loc["npi.spec.detail.qcplans.intro"]</p>

                    @if (_qcPlansLoading)
                    {
                        <div class="spec-qcplans-state">@Loc["common.loading"]</div>
                    }
                    else if (_qcPlansError is not null)
                    {
                        <div class="alert err spec-qcplans-error" role="alert">
                            <strong>@Loc["npi.spec.detail.qcplans.load_err"]</strong>
                            <pre>@_qcPlansError</pre>
                        </div>
                    }
                    else
                    {
                        @foreach (var stageDef in _qcStageDefs)
                        {
                            var rows = _qcDraft[stageDef.Stage];
                            var isDirty = _qcDirty.Contains(stageDef.Stage);
                            var isSaving = _qcSaving.Contains(stageDef.Stage);
                            var saveMsg = _qcSaveMessages.TryGetValue(stageDef.Stage, out var msg) ? msg : null;
                            var saveErr = _qcSaveErrors.TryGetValue(stageDef.Stage, out var err) ? err : null;

                            <section class="spec-qcplans-stage">
                                <header class="spec-qcplans-stage-head">
                                    <div class="spec-qcplans-stage-title">
                                        <h3>@Loc[stageDef.LabelKey]</h3>
                                        <p class="spec-qcplans-stage-desc">@Loc[stageDef.DescKey]</p>
                                    </div>
                                    <div class="spec-qcplans-stage-actions">
                                        <AuthorizeView Roles="Admin,Engineer">
                                            <Authorized>
                                                <button type="button"
                                                        class="rt-btn spec-qcplans-add-btn"
                                                        disabled="@isSaving"
                                                        @onclick="@(() => AddQcRow(stageDef.Stage))">
                                                    @Loc["npi.spec.detail.qcplans.btn_add"]
                                                </button>
                                                <button type="button"
                                                        class="rt-btn rt-btn-primary spec-qcplans-save-btn"
                                                        disabled="@(!isDirty || isSaving)"
                                                        @onclick="@(() => SaveQcStageAsync(stageDef.Stage))">
                                                    @(isSaving
                                                        ? Loc["npi.spec.detail.qcplans.btn_saving"]
                                                        : isDirty
                                                            ? Loc["npi.spec.detail.qcplans.btn_save"]
                                                            : Loc["npi.spec.detail.qcplans.btn_saved"])
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </header>

                                @if (saveErr is not null)
                                {
                                    <div class="alert err spec-qcplans-stage-err" role="alert">
                                        <strong>@Loc["npi.spec.detail.qcplans.save_err"]</strong>: @saveErr
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(saveMsg))
                                {
                                    <div class="alert ok spec-qcplans-stage-ok" role="status">@saveMsg</div>
                                }

                                @if (rows.Count == 0)
                                {
                                    <div class="spec-qcplans-empty">@Loc["npi.spec.detail.qcplans.empty"]</div>
                                }
                                else
                                {
                                    <div class="spec-qcplans-table-wrap">
                                        <table class="spec-qcplans-table">
                                            <thead>
                                                <tr>
                                                    <th class="col-criterion">@Loc["npi.spec.detail.qcplans.col.criterion"]</th>
                                                    <th class="col-target">@Loc["npi.spec.detail.qcplans.col.target"]</th>
                                                    <th class="col-tolerance">@Loc["npi.spec.detail.qcplans.col.tolerance"]</th>
                                                    <th class="col-method">@Loc["npi.spec.detail.qcplans.col.method"]</th>
                                                    <th class="col-frequency">@Loc["npi.spec.detail.qcplans.col.frequency"]</th>
                                                    <AuthorizeView Roles="Admin,Engineer">
                                                        <Authorized>
                                                            <th class="col-delete" aria-label="@Loc["npi.spec.detail.qcplans.col.delete"]"></th>
                                                        </Authorized>
                                                    </AuthorizeView>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (var i = 0; i < rows.Count; i++)
                                                {
                                                    var idx = i;
                                                    var row = rows[idx];
                                                    <tr>
                                                        <td class="col-criterion">
                                                            <AuthorizeView Roles="Admin,Engineer">
                                                                <Authorized>
                                                                    <input type="text"
                                                                           class="spec-qcplans-input"
                                                                           value="@row.Name"
                                                                           placeholder="@Loc["npi.spec.detail.qcplans.ph.criterion"]"
                                                                           @oninput="@(e => UpdateQcField(stageDef.Stage, idx, "name", e.Value?.ToString()))" />
                                                                </Authorized>
                                                                <NotAuthorized>
                                                                    <span class="spec-qcplans-readcell">@OrDash(row.Name)</span>
                                                                </NotAuthorized>
                                                            </AuthorizeView>
                                                        </td>
                                                        <td class="col-target">
                                                            <AuthorizeView Roles="Admin,Engineer">
                                                                <Authorized>
                                                                    <input type="text"
                                                                           class="spec-qcplans-input"
                                                                           value="@row.Target"
                                                                           placeholder="@Loc["npi.spec.detail.qcplans.ph.target"]"
                                                                           @oninput="@(e => UpdateQcField(stageDef.Stage, idx, "target", e.Value?.ToString()))" />
                                                                </Authorized>
                                                                <NotAuthorized>
                                                                    <span class="spec-qcplans-readcell">@OrDash(row.Target)</span>
                                                                </NotAuthorized>
                                                            </AuthorizeView>
                                                        </td>
                                                        <td class="col-tolerance">
                                                            <AuthorizeView Roles="Admin,Engineer">
                                                                <Authorized>
                                                                    <input type="text"
                                                                           class="spec-qcplans-input"
                                                                           value="@row.Tolerance"
                                                                           placeholder="@Loc["npi.spec.detail.qcplans.ph.tolerance"]"
                                                                           @oninput="@(e => UpdateQcField(stageDef.Stage, idx, "tolerance", e.Value?.ToString()))" />
                                                                </Authorized>
                                                                <NotAuthorized>
                                                                    <span class="spec-qcplans-readcell">@OrDash(row.Tolerance)</span>
                                                                </NotAuthorized>
                                                            </AuthorizeView>
                                                        </td>
                                                        <td class="col-method">
                                                            <AuthorizeView Roles="Admin,Engineer">
                                                                <Authorized>
                                                                    <input type="text"
                                                                           class="spec-qcplans-input"
                                                                           value="@row.Method"
                                                                           placeholder="@Loc["npi.spec.detail.qcplans.ph.method"]"
                                                                           @oninput="@(e => UpdateQcField(stageDef.Stage, idx, "method", e.Value?.ToString()))" />
                                                                </Authorized>
                                                                <NotAuthorized>
                                                                    <span class="spec-qcplans-readcell">@OrDash(row.Method)</span>
                                                                </NotAuthorized>
                                                            </AuthorizeView>
                                                        </td>
                                                        <td class="col-frequency">
                                                            <AuthorizeView Roles="Admin,Engineer">
                                                                <Authorized>
                                                                    <input type="text"
                                                                           class="spec-qcplans-input"
                                                                           value="@row.Frequency"
                                                                           placeholder="@Loc["npi.spec.detail.qcplans.ph.frequency"]"
                                                                           @oninput="@(e => UpdateQcField(stageDef.Stage, idx, "frequency", e.Value?.ToString()))" />
                                                                </Authorized>
                                                                <NotAuthorized>
                                                                    <span class="spec-qcplans-readcell">@OrDash(row.Frequency)</span>
                                                                </NotAuthorized>
                                                            </AuthorizeView>
                                                        </td>
                                                        <AuthorizeView Roles="Admin,Engineer">
                                                            <Authorized>
                                                                <td class="col-delete">
                                                                    <button type="button"
                                                                            class="spec-qcplans-delete-btn"
                                                                            disabled="@isSaving"
                                                                            aria-label="@Loc["npi.spec.detail.qcplans.col.delete"]"
                                                                            @onclick="@(() => RemoveQcRow(stageDef.Stage, idx))">
                                                                        @Loc["npi.spec.detail.qcplans.btn_delete"]
                                                                    </button>
                                                                </td>
                                                            </Authorized>
                                                        </AuthorizeView>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </section>
                        }
                    }
                </div>
            }
            else if (_activeTab == "qc-capture")
            {
                @* ── Phase 8 PR-D-4 — QC Capture tab. Mirrors QC Plans 4-stage
                     structure but shows latest capture pill + Capture button
                     per criterion. Capture button opens a single-column modal
                     (PASS/FAIL/N-A result + measurement + conditional NG
                     reason + optional comment). Lazy-loads plans + captures +
                     reason codes on first switch to the tab.

                     RBAC: View = route NpiSpecRead policy (Admin/Supervisor/
                     Engineer). Edit = Admin/Engineer enforced both client
                     (AuthorizeView) + server (SpecQcCaptureService role
                     check). Hotfix #27: render from entity + try-catch +
                     inline error banner. *@
                <div class="spec-qccapture-area">
                    <p class="spec-qccapture-intro">@Loc["npi.spec.detail.qccapture.intro"]</p>

                    @if (_qcCapturesLoading || _qcPlansLoading)
                    {
                        <div class="spec-qcplans-state">@Loc["common.loading"]</div>
                    }
                    else if (_qcCapturesError is not null)
                    {
                        <div class="alert err spec-qcplans-error" role="alert">
                            <strong>@Loc["npi.spec.detail.qccapture.load_err"]</strong>
                            <pre>@_qcCapturesError</pre>
                        </div>
                    }
                    else if (_qcPlansError is not null)
                    {
                        <div class="alert err spec-qcplans-error" role="alert">
                            <strong>@Loc["npi.spec.detail.qcplans.load_err"]</strong>
                            <pre>@_qcPlansError</pre>
                        </div>
                    }
                    else if (_qcStageDefs.All(s => _qcDraft[s.Stage].Count == 0))
                    {
                        <div class="spec-qcplans-empty">@Loc["npi.spec.detail.qccapture.empty_plans"]</div>
                    }
                    else
                    {
                        @foreach (var stageDef in _qcStageDefs)
                        {
                            var rows = _qcDraft[stageDef.Stage];

                            <section class="spec-qcplans-stage">
                                <header class="spec-qcplans-stage-head">
                                    <div class="spec-qcplans-stage-title">
                                        <h3>@Loc[stageDef.LabelKey]</h3>
                                        <p class="spec-qcplans-stage-desc">@Loc[stageDef.DescKey]</p>
                                    </div>
                                </header>

                                @if (rows.Count == 0)
                                {
                                    <div class="spec-qcplans-empty">@Loc["npi.spec.detail.qccapture.stage.empty"]</div>
                                }
                                else
                                {
                                    <div class="spec-qcplans-table-wrap">
                                        <table class="spec-qcplans-table spec-qccapture-table">
                                            <thead>
                                                <tr>
                                                    <th class="col-criterion">@Loc["npi.spec.detail.qccapture.col.criterion"]</th>
                                                    <th class="col-target">@Loc["npi.spec.detail.qccapture.col.target"]</th>
                                                    <th class="col-latest">@Loc["npi.spec.detail.qccapture.col.latest"]</th>
                                                    <th class="col-captured-by">@Loc["npi.spec.detail.qccapture.col.captured_by"]</th>
                                                    <AuthorizeView Roles="Admin,Engineer">
                                                        <Authorized>
                                                            <th class="col-action" aria-label="@Loc["npi.spec.detail.qccapture.col.action"]"></th>
                                                        </Authorized>
                                                    </AuthorizeView>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in rows)
                                                {
                                                    var critId = row.Id;
                                                    var latest = critId.HasValue ? GetLatestCapture(stageDef.Stage, critId.Value) : null;
                                                    <tr>
                                                        <td class="col-criterion">
                                                            <span class="spec-qcplans-readcell">@OrDash(row.Name)</span>
                                                        </td>
                                                        <td class="col-target">
                                                            <span class="spec-qcplans-readcell">@OrDash(row.Target)</span>
                                                        </td>
                                                        <td class="col-latest">
                                                            @if (latest is null)
                                                            {
                                                                <span class="spec-qccapture-pill spec-qccapture-pill-none">@Loc["npi.spec.detail.qccapture.pill.none"]</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="spec-qccapture-pill @CapturePillClass(latest.Result)">@CapturePillLabel(latest.Result)</span>
                                                                @if (!string.IsNullOrWhiteSpace(latest.Measurement))
                                                                {
                                                                    <div class="spec-qccapture-pill-sub">@latest.Measurement</div>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(latest.NgReasonCode))
                                                                {
                                                                    <div class="spec-qccapture-pill-reason">@latest.NgReasonCode</div>
                                                                }
                                                            }
                                                        </td>
                                                        <td class="col-captured-by">
                                                            @if (latest is null)
                                                            {
                                                                <span class="muted">—</span>
                                                            }
                                                            else
                                                            {
                                                                <div>@latest.CapturedBy</div>
                                                                <div class="spec-qccapture-time">@latest.CapturedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                                            }
                                                        </td>
                                                        <AuthorizeView Roles="Admin,Engineer">
                                                            <Authorized>
                                                                <td class="col-action">
                                                                    @if (critId.HasValue)
                                                                    {
                                                                        <button type="button"
                                                                                class="rt-btn rt-btn-primary spec-qccapture-btn"
                                                                                @onclick="@(() => OpenCaptureModal(stageDef.Stage, row))">
                                                                            @Loc["npi.spec.detail.qccapture.btn_capture"]
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </Authorized>
                                                        </AuthorizeView>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </section>
                        }
                    }
                </div>

                @* ── Capture modal — only renders when a row is picked. ───── *@
                @if (_captureModalOpen && _captureModalCriterion is not null)
                {
                    <div class="modal-scrim" @onclick="CloseCaptureModal">
                        <div class="modal-card spec-qccapture-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                            <div class="modal-head">
                                <h2>@Loc["npi.spec.detail.qccapture.modal.title"]</h2>
                                <button type="button" class="modal-close" @onclick="CloseCaptureModal" aria-label="Close" disabled="@_captureModalBusy">×</button>
                            </div>
                            <div class="modal-body">
                                <div class="spec-qccapture-modal-subtitle">
                                    @string.Format(
                                        Loc["npi.spec.detail.qccapture.modal.subtitle"].Value,
                                        Loc[_captureModalStageLabelKey ?? ""].Value,
                                        _captureModalCriterion.Name)
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_captureModalCriterion.Target))
                                {
                                    <div class="spec-qccapture-modal-meta">
                                        <span class="spec-qccapture-modal-meta-label">@Loc["npi.spec.detail.qccapture.modal.label_target"]:</span>
                                        <span>@_captureModalCriterion.Target</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_captureModalCriterion.Tolerance))
                                {
                                    <div class="spec-qccapture-modal-meta">
                                        <span class="spec-qccapture-modal-meta-label">@Loc["npi.spec.detail.qccapture.modal.label_tolerance"]:</span>
                                        <span>@_captureModalCriterion.Tolerance</span>
                                    </div>
                                }

                                <div class="spec-qccapture-modal-section">
                                    <label class="spec-qccapture-modal-label">@Loc["npi.spec.detail.qccapture.modal.label_result"]</label>
                                    <div class="spec-qccapture-modal-result-row" role="radiogroup">
                                        <button type="button"
                                                class="spec-qccapture-result-btn pass @(_captureResult == QcCaptureResult.Pass ? "active" : "")"
                                                disabled="@_captureModalBusy"
                                                role="radio"
                                                aria-checked="@(_captureResult == QcCaptureResult.Pass)"
                                                @onclick="@(() => SetCaptureResult(QcCaptureResult.Pass))">
                                            @Loc["npi.spec.detail.qccapture.pill.pass"]
                                        </button>
                                        <button type="button"
                                                class="spec-qccapture-result-btn fail @(_captureResult == QcCaptureResult.Fail ? "active" : "")"
                                                disabled="@_captureModalBusy"
                                                role="radio"
                                                aria-checked="@(_captureResult == QcCaptureResult.Fail)"
                                                @onclick="@(() => SetCaptureResult(QcCaptureResult.Fail))">
                                            @Loc["npi.spec.detail.qccapture.pill.fail"]
                                        </button>
                                        <button type="button"
                                                class="spec-qccapture-result-btn na @(_captureResult == QcCaptureResult.Na ? "active" : "")"
                                                disabled="@_captureModalBusy"
                                                role="radio"
                                                aria-checked="@(_captureResult == QcCaptureResult.Na)"
                                                @onclick="@(() => SetCaptureResult(QcCaptureResult.Na))">
                                            @Loc["npi.spec.detail.qccapture.pill.na"]
                                        </button>
                                    </div>
                                </div>

                                <div class="spec-qccapture-modal-section">
                                    <label class="spec-qccapture-modal-label" for="capture-measurement">@Loc["npi.spec.detail.qccapture.modal.label_measurement"]</label>
                                    <input id="capture-measurement"
                                           type="text"
                                           class="spec-qcplans-input"
                                           maxlength="200"
                                           placeholder="@Loc["npi.spec.detail.qccapture.modal.ph_measurement"]"
                                           disabled="@_captureModalBusy"
                                           value="@_captureMeasurement"
                                           @oninput="@(e => _captureMeasurement = e.Value?.ToString())" />
                                </div>

                                @if (_captureResult == QcCaptureResult.Fail)
                                {
                                    <div class="spec-qccapture-modal-section">
                                        <label class="spec-qccapture-modal-label" for="capture-reason">@Loc["npi.spec.detail.qccapture.modal.label_reason"] <span class="required">*</span></label>
                                        <select id="capture-reason"
                                                class="spec-qcplans-input"
                                                disabled="@_captureModalBusy"
                                                value="@_captureReasonCode"
                                                @onchange="@(e => _captureReasonCode = e.Value?.ToString())">
                                            <option value="">@Loc["npi.spec.detail.qccapture.modal.ph_reason"]</option>
                                            @foreach (var rc in _reasonCodes.Where(r => r.Kind == ReasonCodeKind.Scrap))
                                            {
                                                <option value="@rc.Code">@rc.Code — @LabelForReasonCode(rc)</option>
                                            }
                                        </select>
                                    </div>
                                }

                                <div class="spec-qccapture-modal-section">
                                    <label class="spec-qccapture-modal-label" for="capture-comment">@Loc["npi.spec.detail.qccapture.modal.label_comment"]</label>
                                    <textarea id="capture-comment"
                                              class="spec-qcplans-input spec-qccapture-textarea"
                                              rows="3"
                                              maxlength="500"
                                              placeholder="@Loc["npi.spec.detail.qccapture.modal.ph_comment"]"
                                              disabled="@_captureModalBusy"
                                              @oninput="@(e => _captureComment = e.Value?.ToString())">@_captureComment</textarea>
                                </div>

                                @if (!string.IsNullOrEmpty(_captureModalError))
                                {
                                    <div class="alert err" role="alert">@_captureModalError</div>
                                }
                            </div>
                            <div class="modal-foot">
                                <button type="button" class="btn" @onclick="CloseCaptureModal" disabled="@_captureModalBusy">@Loc["npi.spec.detail.qccapture.modal.btn_cancel"]</button>
                                <button type="button" class="rt-btn rt-btn-primary"
                                        disabled="@(_captureResult == null || _captureModalBusy)"
                                        @onclick="SubmitCaptureAsync">
                                    @(_captureModalBusy
                                        ? Loc["npi.spec.detail.qccapture.modal.btn_saving"]
                                        : Loc["npi.spec.detail.qccapture.modal.btn_save"])
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (_activeTab == "drawings")
            {
                @* ── Phase 8 PR-D-5b — Drawings tab. 9 kind sections (one per
                     DrawingKind enum value) each showing the current
                     DrawingVersion as a card + collapsible version chain.
                     Upload via Blazor InputFile streamed straight to
                     IBlobStore.PutAsync (no full-memory buffer per Lesson
                     PR-D-5a caller guidance). 3-role approval chips
                     DEFERRED to PR-D-5c — status pill renders the basic
                     Draft/Pending state from the persisted version row.

                     RBAC: View = route NpiSpecRead policy. Upload = Admin/
                     Engineer enforced both client (AuthorizeView) and server
                     (DrawingsService.UploadAsync role check). Hotfix #27:
                     render from entity + try-catch + inline error banner. *@
                <div class="spec-drawings-area">
                    <p class="spec-drawings-intro">@Loc["npi.spec.detail.drawings.intro"]</p>

                    @if (_drawingsLoading)
                    {
                        <div class="spec-qcplans-state">@Loc["common.loading"]</div>
                    }
                    else if (_drawingsError is not null)
                    {
                        <div class="alert err spec-qcplans-error" role="alert">
                            <strong>@Loc["npi.spec.detail.drawings.load_err"]</strong>
                            <pre>@_drawingsError</pre>
                        </div>
                    }
                    else
                    {
                        @foreach (var kv in _drawingViews)
                        {
                            var kind = kv.Kind;
                            var label = Loc[$"npi.spec.detail.drawings.kind.{kind}"].Value;
                            var hasCurrent = kv.CurrentVersionId.HasValue;
                            var current = hasCurrent
                                ? kv.Versions.FirstOrDefault(v => v.Id == kv.CurrentVersionId)
                                : null;
                            var versionCount = kv.Versions.Count;
                            var expanded = kv.DrawingId.HasValue && _expandedDrawings.Contains(kv.DrawingId.Value);

                            <section class="spec-drawings-section">
                                <header class="spec-drawings-section-head">
                                    <h3>@label</h3>
                                    <AuthorizeView Roles="Admin,Engineer">
                                        <Authorized>
                                            <button type="button" class="rt-btn spec-drawings-upload-btn"
                                                    @onclick="@(() => OpenUploadModal(kind, versionCount))">
                                                @(hasCurrent
                                                    ? Loc["npi.spec.detail.drawings.btn_upload_new"]
                                                    : Loc["npi.spec.detail.drawings.btn_upload_first"])
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </header>

                                @if (current is null)
                                {
                                    <div class="spec-drawings-empty">@Loc["npi.spec.detail.drawings.section.empty"]</div>
                                }
                                else
                                {
                                    <article class="spec-drawings-card">
                                        <div class="spec-drawings-thumb">
                                            <span class="spec-drawings-thumb-ext">@FileExt(current.FileName)</span>
                                            <span class="spec-drawings-thumb-ver">v@current.VersionNo</span>
                                        </div>
                                        <div class="spec-drawings-info">
                                            <div class="spec-drawings-title">
                                                @current.FileName
                                                <span class="spec-drawings-meta">· v@current.VersionNo</span>
                                            </div>
                                            <div class="spec-drawings-meta">
                                                @string.Format(Loc["npi.spec.detail.drawings.size_kb"].Value, FmtKb(current.FileSize))
                                                ·
                                                @string.Format(Loc["npi.spec.detail.drawings.uploaded_by"].Value,
                                                    current.UploadedBy ?? "—",
                                                    current.UploadedAt.ToLocalTime())
                                            </div>
                                            <div class="spec-drawings-status-line">
                                                <span class="spec-drawings-status-pill @StatusPillClass(current.Status)">@StatusPillLabel(current.Status)</span>
                                                @if (!string.IsNullOrWhiteSpace(current.ChangeReason))
                                                {
                                                    <span class="spec-drawings-reason"
                                                          title="@Loc["npi.spec.detail.drawings.change_reason_label"].Value">
                                                        "@current.ChangeReason"
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="spec-drawings-actions">
                                            <a class="rt-btn rt-btn-primary spec-drawings-view-btn"
                                               href="@DownloadUrl(current.Id)"
                                               target="_blank" rel="noreferrer">
                                                @Loc["npi.spec.detail.drawings.btn_view"]
                                            </a>
                                            @if (versionCount > 1 && kv.DrawingId.HasValue)
                                            {
                                                <button type="button" class="rt-btn spec-drawings-toggle-btn"
                                                        @onclick="@(() => ToggleVersions(kv.DrawingId.Value))">
                                                    @(expanded
                                                        ? Loc["npi.spec.detail.drawings.btn_versions_hide"].Value
                                                        : string.Format(Loc["npi.spec.detail.drawings.btn_versions_show"].Value, versionCount))
                                                </button>
                                            }
                                        </div>
                                    </article>

                                    @if (expanded && versionCount > 1)
                                    {
                                        <ul class="spec-drawings-timeline">
                                            @foreach (var v in kv.Versions)
                                            {
                                                var isCurrent = v.Id == kv.CurrentVersionId;
                                                <li class="spec-drawings-timeline-row @(isCurrent ? "is-current" : "")">
                                                    <span class="spec-drawings-version-tag">v@v.VersionNo</span>
                                                    <div class="spec-drawings-timeline-body">
                                                        <div class="spec-drawings-timeline-filename">@v.FileName · @string.Format(Loc["npi.spec.detail.drawings.size_kb"].Value, FmtKb(v.FileSize))</div>
                                                        @if (!string.IsNullOrWhiteSpace(v.ChangeReason))
                                                        {
                                                            <div class="spec-drawings-timeline-reason">"@v.ChangeReason"</div>
                                                        }
                                                        <div class="spec-drawings-timeline-meta">
                                                            @string.Format(Loc["npi.spec.detail.drawings.uploaded_by"].Value,
                                                                v.UploadedBy ?? "—",
                                                                v.UploadedAt.ToLocalTime())
                                                        </div>
                                                    </div>
                                                    <span class="spec-drawings-status-pill @StatusPillClass(v.Status)">@StatusPillLabel(v.Status)</span>
                                                    <a class="rt-btn spec-drawings-timeline-view-btn"
                                                       href="@DownloadUrl(v.Id)"
                                                       target="_blank" rel="noreferrer">
                                                        @Loc["npi.spec.detail.drawings.btn_view"]
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                }
                            </section>
                        }
                    }
                </div>

                @* ── Upload modal — single column. ────────────────────── *@
                @if (_uploadModalOpen)
                {
                    <div class="modal-scrim" @onclick="CloseUploadModal">
                        <div class="modal-card spec-drawings-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                            <div class="modal-head">
                                <h2>@Loc["npi.spec.detail.drawings.modal.title"]</h2>
                                <button type="button" class="modal-close" @onclick="CloseUploadModal" aria-label="Close" disabled="@_uploadModalBusy">×</button>
                            </div>
                            <div class="modal-body">
                                <div class="spec-qccapture-modal-subtitle">
                                    @string.Format(
                                        Loc["npi.spec.detail.drawings.modal.subtitle"].Value,
                                        Loc[$"npi.spec.detail.drawings.kind.{_uploadModalKind}"].Value,
                                        _uploadModalNextVersion)
                                </div>

                                <div class="spec-qccapture-modal-section">
                                    <label class="spec-qccapture-modal-label">@Loc["npi.spec.detail.drawings.modal.label_file"] <span class="required">*</span></label>
                                    <InputFile OnChange="OnUploadFileChange"
                                               accept=".pdf,.png,.jpg,.jpeg,.svg,.gif,.webp,.dwg,.dxf,.ai"
                                               disabled="@_uploadModalBusy" />
                                    <div class="spec-drawings-modal-hint">@string.Format(Loc["npi.spec.detail.drawings.modal.hint_file"].Value, BlobOpts.MaxBytes / (1024 * 1024))</div>
                                    @if (_uploadModalFile is not null)
                                    {
                                        <div class="spec-drawings-modal-picked">
                                            @_uploadModalFile.Name (@FmtKb(_uploadModalFile.Size) KB)
                                        </div>
                                    }
                                </div>

                                <div class="spec-qccapture-modal-section">
                                    <label class="spec-qccapture-modal-label" for="upload-reason">@Loc["npi.spec.detail.drawings.modal.label_change_reason"]</label>
                                    <textarea id="upload-reason"
                                              class="spec-qcplans-input spec-qccapture-textarea"
                                              rows="2"
                                              maxlength="500"
                                              placeholder="@Loc["npi.spec.detail.drawings.modal.ph_change_reason"]"
                                              disabled="@_uploadModalBusy"
                                              @oninput="@(e => _uploadModalChangeReason = e.Value?.ToString())">@_uploadModalChangeReason</textarea>
                                </div>

                                @if (!string.IsNullOrEmpty(_uploadModalError))
                                {
                                    <div class="alert err" role="alert">@_uploadModalError</div>
                                }
                            </div>
                            <div class="modal-foot">
                                <button type="button" class="btn" @onclick="CloseUploadModal" disabled="@_uploadModalBusy">@Loc["npi.spec.detail.drawings.modal.btn_cancel"]</button>
                                <button type="button" class="rt-btn rt-btn-primary"
                                        disabled="@(_uploadModalFile is null || _uploadModalBusy)"
                                        @onclick="SubmitUploadAsync">
                                    @(_uploadModalBusy
                                        ? Loc["npi.spec.detail.drawings.modal.btn_uploading"]
                                        : Loc["npi.spec.detail.drawings.modal.btn_upload"])
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="spec-detail-coming-soon">
                    <div class="spec-detail-coming-soon-icon">@ComingSoonIcon(_activeTab)</div>
                    <h3>@Loc[$"npi.spec.detail.tab.{_activeTab}"]</h3>
                    <p>@Loc["npi.spec.detail.coming_soon_body"]</p>
                </div>
            }
        </div>

        @* ── History modal (full audit timeline) ────────────────────────── *@
        @if (_historyOpen)
        {
            <div class="modal-scrim" @onclick="CloseHistory">
                <div class="modal-card spec-history-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                    <div class="modal-head">
                        <h2>⟲ @Loc["npi.spec.detail.action.history"] — @_detail.SpecCode Rev @_detail.RevisionCode</h2>
                        <button type="button" class="modal-close" @onclick="CloseHistory" aria-label="Close">×</button>
                    </div>
                    <div class="modal-body">
                        @if (_detail.AuditEntries.Count == 0)
                        {
                            <p class="muted">@Loc["npi.spec.detail.audit.empty"]</p>
                        }
                        else
                        {
                            <ul class="spec-audit-log spec-history-modal-list">
                                @foreach (var a in _detail.AuditEntries)
                                {
                                    <li>
                                        <span class="audit-time">@a.Timestamp.ToString("yyyy-MM-dd HH:mm")</span>
                                        <span class="audit-action">@a.Action</span>
                                        <span class="muted">· @a.ActorUsername</span>
                                        @if (!string.IsNullOrWhiteSpace(a.ActorRole))
                                        {
                                            <span class="muted">(@a.ActorRole)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="modal-foot">
                        <button type="button" class="btn" @onclick="CloseHistory">@Loc["npi.spec.detail.btn_close"]</button>
                    </div>
                </div>
            </div>
        }
    }
</section>

@code {
    [Parameter] public long RevisionId { get; set; }

    private bool _loading = true;
    private string? _error;
    private SpecDetailDto? _detail;

    // Tab state
    private string _activeTab = "spec";
    private sealed record TabDef(string Key, string LabelKey);
    private static readonly TabDef[] _tabs = new[]
    {
        new TabDef("spec",       "npi.spec.detail.tab.spec"),
        new TabDef("drawings",   "npi.spec.detail.tab.drawings"),
        new TabDef("qc-plans",   "npi.spec.detail.tab.qc-plans"),
        new TabDef("qc-capture", "npi.spec.detail.tab.qc-capture"),
        new TabDef("artwork",    "npi.spec.detail.tab.artwork"),
        new TabDef("setup",      "npi.spec.detail.tab.setup"),
    };

    // Action state
    private bool _busyAction;
    private string? _actionError;
    private string? _actionMessage;
    private bool _historyOpen;

    // ── Phase 8 PR-D-2 — Artwork tab state (client-only).
    private sealed record ArtworkLayerDef(string Key, string LabelKey, string Tint);
    private sealed record ArtworkTemplateDef(string Key, string LabelKey);

    private static readonly ArtworkLayerDef[] _artworkLayerDefs = new[]
    {
        new ArtworkLayerDef("print", "npi.spec.detail.artwork.layer.print", "#FFCD00"),
        new ArtworkLayerDef("die",   "npi.spec.detail.artwork.layer.die",   "#ef4444"),
        new ArtworkLayerDef("reg",   "npi.spec.detail.artwork.layer.reg",   "#00b4d8"),
        new ArtworkLayerDef("bleed", "npi.spec.detail.artwork.layer.bleed", "#60a5fa"),
    };

    private static readonly ArtworkTemplateDef[] _artworkTemplateDefs = new[]
    {
        new ArtworkTemplateDef("brady-safety", "npi.spec.detail.artwork.template.brady_safety"),
        new ArtworkTemplateDef("ccl-cosmetic", "npi.spec.detail.artwork.template.ccl_cosmetic"),
        new ArtworkTemplateDef("panel-face",   "npi.spec.detail.artwork.template.panel_face"),
    };

    /// <summary>Layer visibility state — defaults per CMES sibling: print+die ON, reg+bleed OFF.</summary>
    private Dictionary<string, bool> _artworkLayers = new()
    {
        ["print"] = true,
        ["die"]   = true,
        ["reg"]   = false,
        ["bleed"] = false,
    };

    /// <summary>Selected template — auto from Planner per Q3, manual override allowed.</summary>
    private string _artworkTemplate = "brady-safety";

    /// <summary>Track whether operator has manually picked a template (suppresses auto-from-planner reset).</summary>
    private bool _artworkTemplateUserChosen;

    private void ToggleArtworkLayer(string key)
    {
        if (_artworkLayers.ContainsKey(key)) _artworkLayers[key] = !_artworkLayers[key];
