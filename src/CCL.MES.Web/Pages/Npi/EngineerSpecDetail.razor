                <g stroke="#00b4d8" stroke-width="1" fill="none">
                    <circle cx="200" cy="20" r="4" />
                    <line x1="195" y1="20" x2="205" y2="20" />
                    <line x1="200" y1="15" x2="200" y2="25" />
