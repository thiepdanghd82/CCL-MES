@page "/qcqa/oqc"
@attribute [Authorize(Policy = "QcRead")]
@inject IStringLocalizer<SharedResource> Loc

<h1>@Loc["qcqa.oqc.title"]</h1>

<div class="npi-placeholder">
    <p class="muted">@Loc["qcqa.oqc.placeholder_lead"]</p>
    <ul>
        <li>@Loc["qcqa.oqc.placeholder_li1"]</li>
        <li>@Loc["qcqa.oqc.placeholder_li2"]</li>
        <li>@Loc["qcqa.oqc.placeholder_li3"]</li>
    </ul>
</div>
