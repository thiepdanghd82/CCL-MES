@page "/"
@inject IStringLocalizer<SharedResource> Loc

<h1>@Loc["index.title"]</h1>
<p>@Loc["index.intro"]</p>

<div class="cards">
    <a class="card" href="/dashboard">
        <h3>@Loc["index.card.dashboard.title"]</h3>
        <p>@Loc["index.card.dashboard.desc"]</p>
    </a>
    <a class="card" href="/workorders">
        <h3>@Loc["index.card.workorders.title"]</h3>
        <p>@Loc["index.card.workorders.desc"]</p>
    </a>
    <a class="card" href="/workinstructions">
        <h3>@Loc["index.card.workinstructions.title"]</h3>
        <p>@Loc["index.card.workinstructions.desc"]</p>
    </a>
    <a class="card" href="/swagger" target="_blank">
        <h3>@Loc["index.card.api.title"]</h3>
        <p>@Loc["index.card.api.desc"]</p>
    </a>
</div>

<p class="muted">@Loc["index.footer_modules"]</p>
