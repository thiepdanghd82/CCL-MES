@page "/workorders"

@*  Phase 8 WO-Consolidation — single /workorders page that hosts BOTH
    the kiosk-first Shop Order experience (card grid + scan + camera +
    per-WO drawer) AND a Phase 6 planner-overview Table view. Toggle via
    a segmented control top-right; choice persists in sessionStorage
    (`workorders.view`).

    Phase 6 ACTIONS PRESERVED 100%. The 9 buttons that used to live in
    each table row (Advance / Unlock step / QC IPQC|FQC|OQC Pass / Start /
    Pause / Resume / Finish) MOVED VERBATIM into the drawer's Action
    section — same AuthorizeView Context names, same NeedsQc + Running
    guards, same service calls (Wo.AdvanceAsync / Wo.UpdateFlagsAsync /
    Qc.CreateAsync + ApproveAsync / Oee.{Start,Pause,Resume,Finish}Async),
    same ShopfloorNotifier reason strings ("advance" / "flags" / "qc" /
    "oee"). Server-side state-machine in WorkOrderStateMachine.cs is
    UNTOUCHED.

    Table view is now DISPLAY-ONLY: 9 cols (WoNo / Customer / Product /
    Machine / Target / Produced / CurrentStep badge / 7-dot flow / "open
    drawer" affordance). Row click → opens drawer (single source of
    action UI, Q4 default). No inline buttons in row.

    SignalR ShopfloorNotifier contract UNCHANGED — page subscribes
    "shopfloorChanged" once and triggers RefreshAllAsync() which reloads
    both the card list (Wo.ShopOrderListAsync) and the open drawer DTO
    (Wo.GetDrawerAsync). *@

@using System.Net
@using CCL.MES.Application
@using CCL.MES.Application.Services
@using CCL.MES.Domain
@using CCL.MES.Domain.Entities
@using CCL.MES.Web.Components
@using CCL.MES.Web.Hubs
@using CCL.MES.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject WorkOrderService Wo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HubCookieAccessor HubCookie
@inject IStringLocalizer<SharedResource> Loc

<section class="workorders-page">

    @* ── Header (scan + camera + lookup + view toggle) ──────────────── *@
    <div class="shop-order-header">
        <div class="shop-order-scan-wrap">
            <span class="shop-order-scan-icon" aria-hidden="true">📱</span>
            <input type="text"
                   class="shop-order-scan-input"
                   placeholder="@Loc["shop_order.scan_placeholder"]"
                   value="@_scanQuery"
                   @oninput="@(e => _scanQuery = e.Value?.ToString())"
                   @onkeydown="@OnScanKeyDownAsync" />
            <button type="button"
                    class="rt-btn shop-order-camera-btn"
                    disabled="@(!_cameraAvailable || _scannerOpen)"
                    title="@(_cameraAvailable ? Loc["shop_order.scan.camera_ready"].Value : Loc["shop_order.scan.camera_unavailable"].Value)"
                    @onclick="OpenScannerAsync">
                📷 @Loc["shop_order.scan.btn_camera"]
            </button>
            <button type="button"
                    class="rt-btn rt-btn-primary shop-order-lookup-btn"
                    disabled="@string.IsNullOrWhiteSpace(_scanQuery)"
                    @onclick="LookupAsync">
                @Loc["shop_order.btn_lookup"]
            </button>
            <div class="workorders-view-toggle" role="group" aria-label="View toggle">
                <button type="button"
                        class="workorders-view-toggle-btn @(_view == "card" ? "active" : "")"
                        @onclick="@(() => SetViewAsync("card"))">
                    @Loc["workorders.view.card"]
                </button>
                <button type="button"
                        class="workorders-view-toggle-btn @(_view == "table" ? "active" : "")"
                        @onclick="@(() => SetViewAsync("table"))">
                    @Loc["workorders.view.table"]
                </button>
            </div>
            @* PR #32c — Export CSV/Excel. Native <a> so browser handles
               the Content-Disposition download without JSInterop. The
               server endpoint streams Active + Closed combined. *@
            <div class="workorders-export" role="group" aria-label="@Loc["workorders.export.aria"]">
                <a class="rt-btn workorders-export-btn"
                   href="/api/workorders/export/csv"
                   target="_blank" rel="noopener"
                   title="@Loc["workorders.export.csv.title"]">
                    @Loc["workorders.export.csv"]
                </a>
                <a class="rt-btn workorders-export-btn"
                   href="/api/workorders/export/xlsx"
                   target="_blank" rel="noopener"
                   title="@Loc["workorders.export.xlsx.title"]">
                    @Loc["workorders.export.xlsx"]
                </a>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_toastMessage))
        {
            <div class="shop-order-toast @(_toastIsError ? "err" : "info")" role="status">
                @_toastMessage
            </div>
        }
        @if (_loading && _result is null)
        {
            <p class="shop-order-empty-hint">@Loc["common.loading"]</p>
        }
        else if (_result is not null && _result.Active.Count == 0 && _result.Closed.Count == 0)
        {
            <p class="shop-order-empty-hint">@Loc["shop_order.empty_hint"]</p>
        }
        else
        {
            <p class="shop-order-hint">
                @Loc["shop_order.scan_hint"]
                <span class="shop-order-demo">@DemoCodes()</span>
            </p>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert err shop-order-error" role="alert">
            <strong>@Loc["shop_order.load_err"]</strong>
            <pre>@_error</pre>
        </div>
    }
    else if (_result is not null)
    {
        @* ── Card view (default per Q1) ─────────────────────────────── *@
        @if (_view == "card")
        {
            <section class="shop-order-section">
                <header class="shop-order-section-head">
                    <span class="shop-order-section-icon" aria-hidden="true">⚡</span>
                    <h2>@Loc["shop_order.section.active"] <span class="shop-order-count">(@_result.Active.Count)</span></h2>
                </header>
                @if (_result.Active.Count == 0)
                {
                    <div class="shop-order-empty">@Loc["shop_order.empty.active"]</div>
                }
                else
                {
                    <div class="mes-wo-cards">
                        @foreach (var wo in _result.Active)
                        {
                            <article class="mes-wo-card mes-wo-card-clickable" data-wo="@wo.WoNo"
                                     role="button" tabindex="0"
                                     @onclick="@(() => OpenDrawerByWoNoAsync(wo.WoNo))"
                                     @onkeydown="@(e => OnCardKeyAsync(e, wo.WoNo))">
                                <header class="mes-wo-card-head">
                                    <span class="mes-wo-card-no">@wo.WoNo</span>
                                    <span class="shop-pill @wo.BadgeCssClass" title="@Loc[wo.BadgeLabelKey]">
                                        <span class="shop-pill-icon">@wo.BadgeIcon</span>
                                        @Loc[wo.BadgeLabelKey]
                                    </span>
                                </header>
                                <dl class="mes-wo-card-body">
                                    <div class="mes-wo-row"><dt>@Loc["shop_order.field.customer"]</dt><dd>@OrDash(wo.CustomerName)</dd></div>
                                    <div class="mes-wo-row"><dt>@Loc["shop_order.field.product"]</dt><dd>@OrDash(wo.ProductCode)</dd></div>
                                    <div class="mes-wo-row"><dt>@Loc["shop_order.field.machine"]</dt><dd>@OrDash(wo.MachineCode)</dd></div>
                                    <div class="mes-wo-row"><dt>@Loc["shop_order.field.process"]</dt><dd>@OrDash(wo.ProcessLabel)</dd></div>
                                    <div class="mes-wo-row"><dt>@Loc["shop_order.field.progress"]</dt><dd>@FormatProgress(wo)</dd></div>
                                    @* PR #32d Q3 — luôn hiện Reject (kể cả 0) cho at-a-glance consistency. *@
                                    <div class="mes-wo-row"><dt>@Loc["shop_order.field.reject"]</dt><dd>@FormatReject(wo)</dd></div>
                                </dl>
                            </article>
                        }
                    </div>
                }
            </section>

            @* PR #32d — Demo Work Orders section. Per Q7: between Active and
                 Closed so it doesn't displace either of the operational lists.
                 Hidden from anyone outside Admin / Supervisor (RBAC Q9 — but
                 we also gate server-side at the controller). *@
            <AuthorizeView Roles="Admin,Supervisor" Context="demoCtx">
                <DemoWoTemplates OnCreated="OnDemoCreatedAsync" />
            </AuthorizeView>

            <section class="shop-order-section">
                <header class="shop-order-section-head">
                    <span class="shop-order-section-icon" aria-hidden="true">✔</span>
                    <h2>@Loc["shop_order.section.closed"] <span class="shop-order-count">(@_result.Closed.Count)</span></h2>
                </header>
                @if (_result.Closed.Count == 0)
                {
                    <div class="shop-order-empty">@Loc["shop_order.empty.closed"]</div>
                }
                else
                {
                    <div class="mes-wo-cards">
                        @foreach (var wo in _result.Closed)
                        {
                            <article class="mes-wo-card mes-wo-card-closed mes-wo-card-clickable" data-wo="@wo.WoNo"
                                     role="button" tabindex="0"
                                     @onclick="@(() => OpenDrawerByWoNoAsync(wo.WoNo))"
                                     @onkeydown="@(e => OnCardKeyAsync(e, wo.WoNo))">
                                <header class="mes-wo-card-head">
                                    <span class="mes-wo-card-no">@wo.WoNo</span>
                                    <span class="shop-pill @wo.BadgeCssClass" title="@Loc[wo.BadgeLabelKey]">
                                        <span class="shop-pill-icon">@wo.BadgeIcon</span>
                                        @Loc[wo.BadgeLabelKey]
                                    </span>
                                </header>
                                <dl class="mes-wo-card-body">
                                    <div class="mes-wo-row"><dt>@Loc["shop_order.field.customer"]</dt><dd>@OrDash(wo.CustomerName)</dd></div>
                                    <div class="mes-wo-row"><dt>@Loc["shop_order.field.output"]</dt><dd>@FormatProgress(wo)</dd></div>
                                    @* PR #32d — real reject count from ProductionLog (replaces "—"). *@
                                    <div class="mes-wo-row"><dt>@Loc["shop_order.field.reject"]</dt><dd>@FormatReject(wo)</dd></div>
                                </dl>
                            </article>
                        }
                    </div>
                }
            </section>
        }
        @* ── Table view (Phase 6 9-cols, DISPLAY ONLY per Q4) ───────── *@
        else
        {
            <section class="shop-order-section">
                <h2 class="visually-hidden">@Loc["workorders.title"]</h2>
                <table class="wo">
                    <thead>
                        <tr>
                            <th>@Loc["workorders.col.wo_no"]</th>
                            <th>@Loc["workorders.col.customer"]</th>
                            <th>@Loc["workorders.col.product"]</th>
                            <th>@Loc["workorders.col.machine"]</th>
                            <th>@Loc["workorders.col.target"]</th>
                            <th>@Loc["workorders.col.produced"]</th>
                            <th>@Loc["workorders.col.current_step"]</th>
                            <th>@Loc["workorders.col.progress"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var wo in _result.Active.Concat(_result.Closed))
                        {
                            <tr class="wo-row-clickable" tabindex="0"
                                @onclick="@(() => OpenDrawerByWoNoAsync(wo.WoNo))"
                                @onkeydown="@(e => OnCardKeyAsync(e, wo.WoNo))">
                                <td><b>@wo.WoNo</b></td>
                                <td>@OrDash(wo.CustomerName)</td>
                                <td>@OrDash(wo.ProductName)</td>
                                <td>@OrDash(wo.MachineCode)</td>
                                <td>@wo.TargetQty @wo.Uom</td>
                                <td>@wo.ProducedQty</td>
                                <td><span class="badge step">@StepName(wo.CurrentStep)</span></td>
                                <td>
                                    <div class="flow">
                                        @foreach (var s in Steps)
                                        {
                                            var cls = (int)wo.CurrentStep > (int)s ? "done"
                                                      : wo.CurrentStep == s ? "current" : "todo";
                                            <span class="dot @cls" title="@StepName(s)">@((int)s)</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="muted">@Loc["workorders.demo_note"]</p>
            </section>
        }
    }

    @* ── Scanner modal (only mounted when open) ─────────────────────── *@
    @if (_scannerOpen)
    {
        <div class="qr-scanner-scrim" @onclick="CloseScannerAsync">
            <div class="qr-scanner-modal" @onclick:stopPropagation="true">
                <header class="qr-scanner-head">
                    <h3>@Loc["shop_order.scan.modal.title"]</h3>
                    <button type="button" class="qr-scanner-close" @onclick="CloseScannerAsync" aria-label="Close">×</button>
                </header>
                <div id="@_scannerElementId" class="qr-scanner-viewport"></div>
                <p class="qr-scanner-hint">@Loc["shop_order.scan.modal.hint"]</p>
            </div>
        </div>
    }

    <WorkOrderDrawer Open="@_drawerOpen"
                     View="@_drawerView"
                     OnClose="CloseDrawerAsync"
                     OnChanged="OnDrawerChangedAsync" />
</section>

@code {
    private bool _loading = true;
    private string? _error;
    private ShopOrderListResult? _result;
    private string? _scanQuery;
    private string _view = "card"; // Q1 default

    // ── Drawer state ──────────────────────────────────────────────────
    private bool _drawerOpen;
    private WorkOrderDrawerView? _drawerView;
    private string? _drawerWoNo;

    // ── Scanner state ─────────────────────────────────────────────────
    private bool _cameraAvailable;
    private bool _scannerOpen;
    private const string _scannerElementId = "qr-reader";
    private DotNetObjectReference<WorkOrders>? _selfRef;

    // ── Toast (5s auto-dismiss) ───────────────────────────────────────
    private string? _toastMessage;
    private bool _toastIsError;
    private CancellationTokenSource? _toastCts;

    // ── SignalR push ──────────────────────────────────────────────────
    private HubConnection? _hub;

    private static readonly ProcessStepCode[] Steps =
    {
        ProcessStepCode.PrePressCheck, ProcessStepCode.OpSetting,
        ProcessStepCode.IpqcApproval,  ProcessStepCode.ReadyToRun,
        ProcessStepCode.Running,       ProcessStepCode.Fqc,
        ProcessStepCode.Oqc,
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // Reuse Phase 6 SignalR plumbing verbatim — ShopfloorNotifier
        // contract unchanged; we just refresh both surfaces on push.
        var hubUri = Nav.ToAbsoluteUri("/hubs/shopfloor");
        _hub = new HubConnectionBuilder()
            .WithUrl(hubUri, options =>
            {
                if (!string.IsNullOrEmpty(HubCookie.AuthCookie))
                {
                    options.Cookies.Add(new System.Net.Cookie(
                        "ccl_mes_auth", HubCookie.AuthCookie, "/", hubUri.Host));
                }
            })
            .WithAutomaticReconnect()
            .Build();
        _hub.On<string>("shopfloorChanged", async _ =>
        {
            await RefreshAllAsync();
            await InvokeAsync(StateHasChanged);
        });
        await _hub.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _cameraAvailable = await JS.InvokeAsync<bool>("ccl.qr.isAvailable");
            }
            catch { _cameraAvailable = false; }
            // Restore view preference from sessionStorage (Q12).
            try
            {
                var saved = await JS.InvokeAsync<string?>("sessionStorage.getItem", "workorders.view");
                if (saved == "table" || saved == "card") _view = saved;
            }
            catch { /* sessionStorage may not be available */ }
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _result = await Wo.ShopOrderListAsync();
        }
        catch (Exception ex)
        {
            _error = ex.GetType().Name + ": " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Refresh card list + re-fetch open drawer DTO.</summary>
    private async Task RefreshAllAsync()
    {
        await LoadAsync();
        if (_drawerOpen && _drawerWoNo is not null)
        {
            try
            {
                _drawerView = await Wo.GetDrawerAsync(_drawerWoNo);
            }
            catch (Exception ex)
            {
                ShowToast(ex.Message, isError: true);
            }
        }
    }

    private async Task SetViewAsync(string view)
    {
        if (view != "card" && view != "table") return;
        _view = view;
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", "workorders.view", view);
        }
        catch { /* tolerate older browsers */ }
    }

    // ── Drawer open/close/refresh ────────────────────────────────────

    private async Task OpenDrawerByWoNoAsync(string woNo, bool fromManual = false)
    {
        try
        {
            var view = await Wo.GetDrawerAsync(woNo);
            if (view is null)
            {
                if (fromManual)
                {
                    ShowToast(string.Format(Loc["shop_order.scan.not_found_fmt"].Value, woNo), isError: true);
                }
                return;
            }
            _drawerView = view;
            _drawerWoNo = view.WoNo;
            _drawerOpen = true;
            if (fromManual) _scanQuery = "";
        }
        catch (Exception ex)
        {
            ShowToast(ex.GetType().Name + ": " + ex.Message, isError: true);
        }
    }

    private Task CloseDrawerAsync()
    {
        _drawerOpen = false;
        _drawerView = null;
        _drawerWoNo = null;
        return Task.CompletedTask;
    }

    /// <summary>Drawer raised OnChanged after a mutation. Refresh both
    /// surfaces from local context (SignalR push covers cross-session).</summary>
    private async Task OnDrawerChangedAsync()
    {
        await RefreshAllAsync();
    }

    private async Task OnCardKeyAsync(KeyboardEventArgs e, string woNo)
    {
        if (e.Key == "Enter" || e.Key == " ") await OpenDrawerByWoNoAsync(woNo);
    }

    // ── Manual LOOKUP ────────────────────────────────────────────────

    private void OnScanKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = LookupAsync();
    }

    private async Task LookupAsync()
    {
        var code = _scanQuery?.Trim();
        if (string.IsNullOrWhiteSpace(code)) return;
        await OpenDrawerByWoNoAsync(code, fromManual: true);
    }

    // ── Camera scanner ───────────────────────────────────────────────

    private async Task OpenScannerAsync()
    {
        if (!_cameraAvailable || _scannerOpen) return;
        _scannerOpen = true;
        StateHasChanged();
        await Task.Yield();

        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            var result = await JS.InvokeAsync<ScannerResult>(
                "ccl.qr.start", _scannerElementId, _selfRef, nameof(OnScanResultAsync));
            if (result is not null && !result.Ok)
            {
                ShowToast(LocalizeScannerError(result.Error), isError: true);
                await CloseScannerAsync();
            }
        }
        catch (Exception ex)
        {
            ShowToast(ex.Message, isError: true);
            await CloseScannerAsync();
        }
    }

    private async Task CloseScannerAsync()
    {
        if (!_scannerOpen) return;
        _scannerOpen = false;
        try { await JS.InvokeVoidAsync("ccl.qr.stop", _scannerElementId); }
        catch { /* swallow */ }
    }

    [JSInvokable]
    public async Task OnScanResultAsync(string code)
    {
        await CloseScannerAsync();
        if (string.IsNullOrWhiteSpace(code)) return;
        await OpenDrawerByWoNoAsync(code, fromManual: false);
        StateHasChanged();
    }

    private string LocalizeScannerError(string? code) => code switch
    {
        "permission_denied" => Loc["shop_order.scan.err.permission"].Value,
        "no_camera"         => Loc["shop_order.scan.err.no_camera"].Value,
        "no_secure"         => Loc["shop_order.scan.err.no_secure"].Value,
        "library_missing"   => Loc["shop_order.scan.err.lib_missing"].Value,
        _                   => Loc["shop_order.scan.err.other"].Value,
    };

    private void ShowToast(string message, bool isError)
    {
        _toastMessage = message;
        _toastIsError = isError;
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(5), token);
                if (!token.IsCancellationRequested)
                {
                    _toastMessage = null;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { /* cancelled */ }
        });
    }

    public async ValueTask DisposeAsync()
    {
        // Tear down camera stream + DotNetObjectReference + SignalR hub.
        try { await CloseScannerAsync(); } catch { }
        _selfRef?.Dispose();
        _selfRef = null;
        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); } catch { }
            _hub = null;
        }
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = null;
    }

    // ── Render helpers ───────────────────────────────────────────────

    private static string OrDash(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private string FormatProgress(WorkOrderCardItem wo)
    {
        var produced = wo.ProducedQty.ToString("N0", System.Globalization.CultureInfo.CurrentCulture);
        var target = wo.TargetQty.ToString("N0", System.Globalization.CultureInfo.CurrentCulture);
        return string.Format(Loc["shop_order.progress_fmt"].Value, produced, target, wo.Uom);
    }

    private string DemoCodes()
    {
        if (_result is null) return "";
        var sample = _result.Active.Take(3).Select(w => w.WoNo).ToList();
        if (sample.Count == 0) return "";
        return string.Format(Loc["shop_order.demo_codes_fmt"].Value, string.Join(", ", sample));
    }

    /// <summary>
    /// Phase 8 PR #32d — Format reject for card row.
    /// Q2: count + rate% when (produced+reject) > 0, else just count.
    /// Rate = reject / (produced + reject) × 100, 1 decimal.
    /// </summary>
    private string FormatReject(WorkOrderCardItem wo)
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        var reject = wo.RejectQty.ToString("N0", culture);
        var denom = wo.ProducedQty + wo.RejectQty;
        if (denom > 0 && wo.RejectQty > 0)
        {
            var rate = ((double)wo.RejectQty / denom * 100.0).ToString("0.0", culture);
            return string.Format(Loc["shop_order.reject_fmt"].Value, reject, wo.Uom, rate);
        }
        return string.Format(Loc["shop_order.reject_count_fmt"].Value, reject, wo.Uom);
    }

    /// <summary>
    /// Phase 8 PR #32d — Demo template "Start Demo" success handler.
    /// Refresh list + toast confirmation. SignalR also pushes from the
    /// controller via ShopfloorNotifier so other circuits update too.
    /// </summary>
    private async Task OnDemoCreatedAsync(string newWoNo)
    {
        await RefreshAllAsync();
        ShowToast(string.Format(Loc["workorders.demo.created_fmt"].Value, newWoNo), isError: false);
        await InvokeAsync(StateHasChanged);
    }

    private static string StepName(ProcessStepCode s) => s switch
    {
        ProcessStepCode.PrePressCheck => "1. Pre-press Check",
        ProcessStepCode.OpSetting     => "2. OP Setting",
        ProcessStepCode.IpqcApproval  => "3. IPQC Approval",
        ProcessStepCode.ReadyToRun    => "4. Ready to Run",
        ProcessStepCode.Running       => "5. Running",
        ProcessStepCode.Fqc           => "6. FQC",
        ProcessStepCode.Oqc           => "7. OQC",
        ProcessStepCode.Closed        => "Closed",
        _                             => s.ToString(),
    };

    private sealed record ScannerResult(bool Ok, string? Code, string? Error, string? Detail);
}
