@page "/workorders"
@using CCL.MES.Web.Hubs
@using CCL.MES.Web.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject WorkOrderService Wo
@inject QcService Qc
@inject OeeService Oee
@inject ShopfloorNotifier Notifier
@inject NavigationManager Nav
@inject HubCookieAccessor HubCookie
@inject IStringLocalizer<SharedResource> Loc
@implements IAsyncDisposable

<h1>@Loc["workorders.title"]</h1>

@if (_items is null)
{
    <p>@Loc["common.loading_dots"]</p>
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_ok ? "ok" : "err")">@_message</div>
    }

    <table class="wo">
        <thead>
            <tr>
                <th>@Loc["workorders.col.wo_no"]</th><th>@Loc["workorders.col.customer"]</th><th>@Loc["workorders.col.product"]</th><th>@Loc["workorders.col.machine"]</th>
                <th>@Loc["workorders.col.target"]</th><th>@Loc["workorders.col.produced"]</th><th>@Loc["workorders.col.current_step"]</th><th>@Loc["workorders.col.progress"]</th><th>@Loc["workorders.col.actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in _items)
            {
                <tr>
                    <td><b>@w.WoNo</b></td>
                    <td>@w.Customer?.Name</td>
                    <td>@w.ProductName</td>
                    <td>@w.MachineCode</td>
                    <td>@w.TargetQty @w.Uom</td>
                    <td>@w.ProducedQty</td>
                    <td><span class="badge step">@StepName(w.CurrentStep)</span></td>
                    <td>
                        <div class="flow">
                            @foreach (var s in Steps)
                            {
                                var cls = (int)w.CurrentStep > (int)s ? "done"
                                          : w.CurrentStep == s ? "current" : "todo";
                                <span class="dot @cls" title="@StepName(s)">@((int)s)</span>
                            }
                        </div>
                    </td>
                    <td class="actions">
                        <button class="btn" @onclick="() => Advance(w.Id)">@Loc["workorders.btn.advance"]</button>
                        <button class="btn ghost" @onclick="() => Helpers(w)">@Loc["workorders.btn.unlock_step"]</button>
                        @if (NeedsQc(w.CurrentStep) is { } t)
                        {
                            <button class="btn pass" @onclick="() => QuickPass(w.Id, t)">QC @t Pass</button>
                        }
                        @if (w.CurrentStep == ProcessStepCode.Running)
                        {
                            <span class="sep"></span>
                            <button class="btn run" @onclick="() => Start(w.Id)">Start</button>
                            <button class="btn warn" @onclick="() => Pause(w.Id)">Pause</button>
                            <button class="btn run" @onclick="() => Resume(w.Id)">Resume</button>
                            <button class="btn finish" @onclick="() => Finish(w)">Finish (+@(w.TargetQty))</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="muted">@Loc["workorders.demo_note"]</p>
}

@code {
    private List<WorkOrder>? _items;
    private string? _message;
    private bool _ok;

    private HubConnection? _hub;

    private static readonly ProcessStepCode[] Steps =
    {
        ProcessStepCode.PrePressCheck, ProcessStepCode.OpSetting, ProcessStepCode.IpqcApproval,
        ProcessStepCode.ReadyToRun, ProcessStepCode.Running, ProcessStepCode.Fqc, ProcessStepCode.Oqc
    };

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        // SignalR — when another client posts a change, reload.
        // Phase 5 — forward ccl_mes_auth cookie so the negotiate request
        // authenticates against the same cookie scheme as Razor pages.
        var hubUri = Nav.ToAbsoluteUri("/hubs/shopfloor");
        _hub = new HubConnectionBuilder()
            .WithUrl(hubUri, options =>
            {
                if (!string.IsNullOrEmpty(HubCookie.AuthCookie))
                {
                    options.Cookies.Add(new System.Net.Cookie(
                        "ccl_mes_auth", HubCookie.AuthCookie, "/", hubUri.Host));
                }
            })
            .WithAutomaticReconnect()
            .Build();
        _hub.On<string>("shopfloorChanged", async _ =>
        {
            await Reload();
            await InvokeAsync(StateHasChanged);
        });
        await _hub.StartAsync();
    }

    private async Task Reload() => _items = await Wo.GetAllAsync();

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }

    private async Task Advance(long id)
    {
        var res = await Wo.AdvanceAsync(id, "shopfloor");
        _ok = res.Ok;
        // Phase 5 — dynamic error portion now runs through WoErrorKeys so it
        // localises along with the surrounding wrapper text.
        var errorText = res.ErrorCode is null
            ? ""
            : Loc[WoErrorKeys.KeyFor(res.ErrorCode)].Value;
        _message = res.Ok
            ? Loc["workorders.msg.advance_ok", res.CurrentStep ?? ""].Value
            : Loc["workorders.msg.advance_fail", errorText].Value;
        await Reload();
        await Notifier.NotifyChangedAsync("advance");
    }

    private async Task Helpers(WorkOrder w)
    {
        await Wo.UpdateFlagsAsync(w.Id, new UpdateFlagsRequest
        {
            MaterialsReady = true, SetupConfirmed = true, RohsOk = true,
            ProducedQty = w.ProducedQty > 0 ? w.ProducedQty : 0
        });
        _ok = true;
        _message = Loc["workorders.msg.unlocked", w.WoNo].Value;
        await Reload();
        await Notifier.NotifyChangedAsync("flags");
    }

    private async Task QuickPass(long id, QcType t)
    {
        var insp = await Qc.CreateAsync(new CreateQcRequest
        {
            WorkOrderId = id, Type = t, InspectorId = "demo", SampleSize = 20,
            Details = new() { new QcDetailDto { ItemName = "Visual", Pass = true, Qty = 20 } }
        });
        await Qc.ApproveAsync(insp.Id, true, "qc.lead");
        _ok = true;
        _message = Loc["workorders.msg.qc_passed", t.ToString()].Value;
        await Reload();
        await Notifier.NotifyChangedAsync("qc");
    }

    private async Task Start(long id)
    {
        await Oee.StartAsync(id, "op01");
        _ok = true; _message = Loc["workorders.msg.start"].Value;
        await Reload(); await Notifier.NotifyChangedAsync("oee");
    }

    private async Task Pause(long id)
    {
        await Oee.PauseAsync(id, new PauseRequest { OperatorId = "op01" });
        _ok = true; _message = Loc["workorders.msg.pause"].Value;
        await Reload(); await Notifier.NotifyChangedAsync("oee");
    }

    private async Task Resume(long id)
    {
        await Oee.ResumeAsync(id, "op01");
        _ok = true; _message = Loc["workorders.msg.resume"].Value;
        await Reload(); await Notifier.NotifyChangedAsync("oee");
    }

    private async Task Finish(WorkOrder w)
    {
        await Oee.FinishAsync(w.Id, new FinishRunRequest { GoodQty = w.TargetQty, RejectQty = 0, OperatorId = "op01" });
        _ok = true;
        _message = Loc["workorders.msg.finish", w.TargetQty].Value;
        await Reload();
        await Notifier.NotifyChangedAsync("oee");
    }

    private static QcType? NeedsQc(ProcessStepCode step) => step switch
    {
        ProcessStepCode.IpqcApproval => QcType.IPQC,
        ProcessStepCode.Fqc => QcType.FQC,
        ProcessStepCode.Oqc => QcType.OQC,
        _ => null
    };

    private static string StepName(ProcessStepCode s) => s switch
    {
        ProcessStepCode.PrePressCheck => "1. Pre-press Check",
        ProcessStepCode.OpSetting => "2. OP Setting",
        ProcessStepCode.IpqcApproval => "3. IPQC Approval",
        ProcessStepCode.ReadyToRun => "4. Ready to Run",
        ProcessStepCode.Running => "5. Running",
        ProcessStepCode.Fqc => "6. FQC",
        ProcessStepCode.Oqc => "7. OQC",
        ProcessStepCode.Closed => "Closed",
        _ => s.ToString()
    };
}
