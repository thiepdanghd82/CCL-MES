@page
@namespace CCL.MES.Web.Pages
@inject CCL.MES.Web.Services.HubCookieAccessor HubCookie
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    // Phase 5 — capture ccl_mes_auth cookie into the circuit-scoped accessor
    // so Dashboard/WorkOrders HubConnections can forward it on negotiate.
    // HttpContext is alive here (Razor Page render) but not safely accessible
    // from inside the Blazor circuit afterwards. See docs/PHASE5-STEP2-PLAN.md.
    HubCookie.AuthCookie = Request.Cookies["ccl_mes_auth"];
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>CCL Design MES</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/flags.css" />
</head>
<body>
    <component type="typeof(CCL.MES.Web.App)" render-mode="ServerPrerendered" />
    <script src="_framework/blazor.server.js"></script>
    <script src="~/js/ccl-mes.js"></script>
</body>
</html>
