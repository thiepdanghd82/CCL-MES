<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CCL.MES.Web</RootNamespace>
    <!-- EN is the default UI culture (Phase 1 mandate). With NeutralLanguage=en,
         the compiler embeds SharedResource.en.resx into the MAIN assembly as the
         neutral fallback (no en/ satellite needed). VI gets its own satellite. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CCL.MES.Application\CCL.MES.Application.csproj" />
    <ProjectReference Include="..\CCL.MES.Infrastructure\CCL.MES.Infrastructure.csproj" />
  </ItemGroup>
</Project>
