@* Phase 2 — wraps the Blazor router in a CascadingAuthenticationState so
   downstream components can use AuthorizeView / AuthenticationStateProvider.
   AuthorizeRouteView pairs with the FallbackPolicy in Program.cs to make
   every Blazor page authenticated-by-default; an unauthenticated visit
   renders <RedirectToLogin>, which force-loads /login with the current
   URL as returnUrl so post-login they land back where they meant to go. *@
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @*  Phase 5 — split the unauthorized branch in two:
                        anonymous visitors still bounce to /login (the
                        FallbackPolicy case), but authenticated users
                        who lack the required role see a localized
                        access-denied panel instead of being kicked
                        back to the login form. *@
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <AccessDenied />
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Page not found.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
